<?xml version="1.0" encoding="utf-8"?>
<!-- The Swap screen: buy or sell an amount of XMZ with a coin, one button (see dex/DexSwapActivity) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dex_swap_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- What is not ready yet, and the button that fixes it -->
        <TextView
            android:id="@+id/swapReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/swapReadyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- The form -->
        <LinearLayout
            android:id="@+id/swapForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/swapSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/swapBuy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/dex_swap_buy"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/swapSell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dex_swap_sell"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/swapCoinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dex_swap_pay_with"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/swapCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dex_swap_how_much"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/swapAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dex_swap_amount_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/swapQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/swapFees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/swapTakeAvailable"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#1E8C80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/swapButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/dex_swap_button"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Waiting for coin (a buy) or XMZ (a sell), or started -->
        <LinearLayout
            android:id="@+id/swapWait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/swapWaitText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/swapQr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/dex_swap_qr"
                android:visibility="gone" />

            <TextView
                android:id="@+id/swapAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/swapWaitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/swapWaitNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/swapCancel"
                style="?android:attr/borderlessButtonStyle"
            android:textColor="#1E8C80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dex_swap_cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/swapNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E5A54B"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- The trades, one row each with a tick per step -->
        <TextView
            android:id="@+id/swapTradesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dex_swap_trades"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/swapTrades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swapAutoApprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dex_swap_auto_approve"
            android:textSize="14sp" />

        <Button
            android:id="@+id/swapApproveAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/swapMore"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#1E8C80"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dex_swap_more" />
    </LinearLayout>
</ScrollView>
