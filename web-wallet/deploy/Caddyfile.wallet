# wallet.monzero.org on monzero-eu: the web wallet's static files and a node gateway limited to
# the calls a wallet needs. Appended to /etc/caddy/Caddyfile; pool.monzero.org is unchanged.
wallet.monzero.org {
	encode gzip

	# Node gateway (same origin as the wallet): only these paths reach the local node, which runs
	# restricted RPC; JSON-RPC methods are limited by the node's restricted mode. They sit at the site
	# root because Monzero's wallet code cannot reach a node behind a path prefix; none of them can
	# clash with the wallet's files (index.html, app.js, style.css, monero.worker.js, SHA256SUMS).
	@node_allowed {
		method GET POST
		path /json_rpc /get_info /getinfo /get_height /getheight
		path /getblocks.bin /get_blocks.bin /gethashes.bin /get_hashes.bin
		path /get_o_indexes.bin /get_outs.bin /get_output_distribution.bin /get_transaction_pool_hashes.bin
		path /gettransactions /get_transactions /get_transaction_pool
		path /sendrawtransaction /send_raw_transaction
	}
	handle @node_allowed {
		# In order: per-visitor limit, body size, then the node (needs the caddy-ratelimit plugin)
		route {
			rate_limit {
				zone wallet_node {
					key {remote_host}
					events 120
					window 10s
				}
			}
			request_body {
				max_size 1MB
			}
			reverse_proxy 127.0.0.1:6175 {
				header_up -Cookie
				header_up -Authorization
				# The node refuses requests with an Origin it does not know; the page and this gateway
				# are the same site, so the browser's Origin/Referer are dropped here
				header_up -Origin
				header_up -Referer
				header_down -Server
			}
		}
	}

	# The wallet: static files only
	handle {
		root * /srv/monzero-wallet
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
