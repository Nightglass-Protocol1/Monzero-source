          "[*]\n" + ("wallpaper_mode=color\n" if wp == "colour" else f"wallpaper_mode={s['fit']}\nwallpaper={wp}\n")
          + f"wallpaper_common=1\ndesktop_bg={bg}\ndesktop_fg={label}\ndesktop_shadow={shadow}\n"
          "desktop_font=DejaVu Sans 11\nshow_wm_menu=0\nsort=mtime;ascending;\nshow_documents=0\n"
          "show_trash=0\nshow_mounts=0\n")
    big = 72 if s["icons"] == "large" else 48
