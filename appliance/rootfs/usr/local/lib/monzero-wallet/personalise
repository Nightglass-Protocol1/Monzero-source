def reload():
    run = lambda *c: subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    run("openbox", "--reconfigure")
    run("pkill", "-USR1", "-x", "tint2")      # tint2 reloads its config
    # the desktop reads wallpaper, colours and icon size only when it starts
    run("pkill", "-u", str(os.getuid()), "-x", "pcmanfm")
    subprocess.Popen(["pcmanfm", "--desktop", "--profile", "default"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def thumb(path):
    from PIL import Image
    THUMBS.mkdir(parents=True, exist_ok=True)
    st = Path(path).stat()
    import hashlib
    t = THUMBS / (hashlib.sha256(f"{path}|{st.st_mtime}|{st.st_size}".encode()).hexdigest()[:20] + ".png")
    if not t.exists():
        im = Image.open(path).convert("RGB")
        im = im.resize((192, 108), Image.LANCZOS) if abs(im.width / im.height - 16 / 9) < 0.02 else _cover(im, 192, 108)
        im.save(t)
    return t


def _cover(im, w, h):
    from PIL import Image
    k = max(w / im.width, h / im.height)
    im = im.resize((max(1, round(im.width * k)), max(1, round(im.height * k))), Image.LANCZOS)
    l, t = (im.width - w) // 2, (im.height - h) // 2
    return im.crop((l, t, l + w, t + h))


def wallpapers():
    out = sorted(p for p in WALLS.glob("*") if p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp"))
    if OWN.exists():
        out += sorted(p for p in OWN.glob("*") if p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp"))
    return out


def window():
    import tkinter as tk
    from tkinter import filedialog, messagebox
    from PIL import Image, ImageTk

    root = tk.Tk(className="monzero-personalise")
    root.title("Personalise")
    try:
        root.iconphoto(True, tk.PhotoImage(file=f"{ICONS}/personalise.png"))
    except tk.TclError:
        pass
    state = {"s": load(), "imgs": []}

    def change(**kw):
        state["s"].update(kw)
        save(state["s"])
        files(state["s"])
        reload()
        draw()

    def add_own():
        f = filedialog.askopenfilename(parent=root, title="Choose a picture", initialdir=str(HOME),
                                       filetypes=[("Pictures", "*.jpg *.jpeg *.png *.webp"), ("All files", "*")])
        if not f:
            return
        try:
            with Image.open(f) as im:
                im.verify()
        except Exception:
            messagebox.showerror("Personalise", "That file is not a picture this box can show.", parent=root)
            return
        OWN.mkdir(parents=True, exist_ok=True)
        dest = OWN / Path(f).name
        if Path(f).resolve() != dest.resolve():
            shutil.copyfile(f, dest)
        change(wallpaper=str(dest))

    def remove_own(p):
        if messagebox.askyesno("Personalise", f"Remove {p.name} from your wallpapers?", parent=root):
            p.unlink(missing_ok=True)
            change(wallpaper=DEFAULTS["wallpaper"]) if state["s"]["wallpaper"] == str(p) else draw()

    def draw():
        for w in root.winfo_children():
            w.destroy()
        state["imgs"].clear()
        s = state["s"]
        acc = ACCENTS[s["accent"]][1]
        bg, surf, fg, dim, line = MODES[s["mode"]]
        root.configure(bg=bg)
        F = lambda size=10, bold=False: ("DejaVu Sans", size, "bold" if bold else "normal")

        def heading(parent, text):
            tk.Label(parent, text=text, bg=bg, fg=acc, font=F(11, True), anchor="w").pack(fill="x", pady=(14, 6))

        def choice_row(parent, options, current, key):
            row = tk.Frame(parent, bg=bg)
            row.pack(fill="x")
            for value, label in options.items():
                on = value == current
                b = tk.Label(row, text=label, font=F(10, on), padx=14, pady=6, cursor="hand2",
                             bg=acc if on else surf, fg=bg if on else fg,
                             highlightthickness=1, highlightbackground=acc if on else line)
                b.pack(side="left", padx=(0, 8))
                b.bind("<Button-1>", lambda e, v=value: change(**{key: v}))

        body = tk.Frame(root, bg=bg, padx=22, pady=12)
        body.pack(fill="both", expand=True)
        top = tk.Frame(body, bg=bg)
        top.pack(fill="x")
        tk.Label(top, text="Personalise your Monzero Box", bg=bg, fg=fg, font=F(15, True)).pack(side="left")

        heading(body, "Wallpaper")
        grid = tk.Frame(body, bg=bg)
        grid.pack(fill="x")
        tiles = [(p, ImageTk.PhotoImage(Image.open(thumb(p)))) for p in wallpapers()]
        col = 0
        for i, (p, img) in enumerate(tiles + [("colour", None), ("add", None)]):
            on = str(p) == s["wallpaper"]
            cell = tk.Frame(grid, bg=acc if on else line, padx=3 if on else 1, pady=3 if on else 1, cursor="hand2")
            cell.grid(row=i // 4, column=i % 4, padx=(0, 10), pady=(0, 10), sticky="n")
            if img is not None:
                state["imgs"].append(img)
                w = tk.Label(cell, image=img, bd=0, bg=bg)
                w.bind("<Button-1>", lambda e, p=p: change(wallpaper=str(p)))
                if OWN in Path(p).parents:
                    w.bind("<Button-3>", lambda e, p=p: remove_own(p))
            else:
                colour = p == "colour"
                w = tk.Frame(cell, width=192, height=108, bg=bg if colour else surf, cursor="hand2")
                inner = tk.Label(w, text="Plain colour" if colour else "＋  Your own picture…", bg=bg if colour else surf,
                                 fg=dim if colour else fg, font=F(9, not colour), cursor="hand2")
                inner.place(relx=.5, rely=.5, anchor="center")
                act = (lambda e: change(wallpaper="colour")) if colour else (lambda e: add_own())
                w.bind("<Button-1>", act)
                inner.bind("<Button-1>", act)
                w.pack_propagate(False)
            w.pack()
        tk.Label(body, text="Right-click one of your own pictures to remove it.", bg=bg, fg=dim, font=F(9),
                 anchor="w").pack(fill="x")
        heading(body, "Picture size")
        choice_row(body, FITS, s["fit"], "fit")

        heading(body, "Theme colour")
        sw = tk.Frame(body, bg=bg)
        sw.pack(fill="x")
        for key, (name, colour) in ACCENTS.items():
            on = key == s["accent"]
            c = tk.Canvas(sw, width=92, height=64, bg=bg, highlightthickness=0, cursor="hand2")
            c.create_oval(30, 4, 62, 36, fill=colour, outline=fg if on else colour, width=3 if on else 1)
            c.create_text(46, 52, text=name, fill=fg if on else dim, font=F(9, on))
            c.pack(side="left")
            c.bind("<Button-1>", lambda e, k=key: change(accent=k))

        heading(body, "Look")
        choice_row(body, {"dark": "Dark", "light": "Light"}, s["mode"], "mode")
        heading(body, "Panel")
        choice_row(body, {"bottom": "Bottom of the screen", "top": "Top of the screen"}, s["panel"], "panel")
        heading(body, "Desktop icons")
        choice_row(body, {"large": "Large", "small": "Small"}, s["icons"], "icons")

        foot = tk.Frame(body, bg=bg)
        foot.pack(fill="x", side="bottom", pady=(18, 0))
        tk.Label(foot, text="The wallet has its own dark/light switch: the moon button at its top.",
                 bg=bg, fg=dim, font=F(9)).pack(side="left")
        close = tk.Label(foot, text="Done", bg=acc, fg=bg, font=F(10, True), padx=22, pady=6, cursor="hand2")
        close.pack(side="right")
        close.bind("<Button-1>", lambda e: root.destroy())

    draw()
    root.update_idletasks()
    root.geometry(f"+{max(0, (root.winfo_screenwidth() - root.winfo_reqwidth()) // 2)}+40")
    root.mainloop()


def main():
    if "--setup" in sys.argv[1:] or "--apply" in sys.argv[1:]:
        files(load())
        if "--apply" in sys.argv[1:]:
            reload()
        return
    window()


if __name__ == "__main__":
    main()
