DOCKER = os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")


def language(s):
    if s.get("language") in LANGS:
        return s["language"]
    if DOCKER or not os.path.exists("/etc/monzero/appliance.json"):
        return norm(os.environ.get("MONZERO_LANG", "en"))
    return box_language()


def keyboard(s):
    if s.get("keyboard") in KEYBOARDS:
        return s["keyboard"]
    if DOCKER or not os.path.exists("/etc/monzero/appliance.json"):
        return LANGS[language(s)][3]
    return box_keyboard()


def load():
    s = dict(DEFAULTS)
    try:
        s.update({k: v for k, v in json.loads(SETTINGS.read_text()).items() if k in DEFAULTS})
    except (OSError, ValueError):
        pass
    if s["accent"] not in ACCENTS: s["accent"] = "cyan"
    if s["mode"] not in MODES: s["mode"] = "dark"
    if s["fit"] not in FITS: s["fit"] = "crop"
    if s["language"] not in LANGS: s["language"] = ""
    if s["keyboard"] not in KEYBOARDS: s["keyboard"] = ""
    if s["wallpaper"] != "colour" and not Path(s["wallpaper"]).exists():
        s["wallpaper"] = DEFAULTS["wallpaper"]
    return s


def save(s):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(s, indent=1))


def write(path, text, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".new")
    tmp.write_text(text)
    tmp.chmod(mode)
    tmp.replace(path)


def desktop_entry(key, name, comment, icon):
    """A launcher with its name in every language (the desktop and panel pick the session's)."""
    loc = lambda k: "".join(f"{k}[{LANGS[c][1].split('.')[0]}]={tr(c, v)}\n" for c, v in ((c, name if k == "Name" else comment) for c in LANGS if c != "en"))
    return (f"[Desktop Entry]\nType=Application\nName={tr('en', name)}\n{loc('Name')}Comment={tr('en', comment)}\n{loc('Comment')}"
            f"Exec={LIB}/{key}\nIcon={ICONS}/{icon}.png\nTerminal=false\n")


def sync_wallet_language(s):
    """When the desktop's language changes, the wallet follows (its own setting, read when it
    opens). A language picked inside the wallet stays until the desktop's changes again."""
    lang = language(s)
    mark = HOME / ".config/monzero-desktop/wallet-language"
    try:
        if mark.read_text().strip() == lang:
            return
    except OSError:
        pass
    set_wallet_language(str(WALLET_CONF), lang)
    write(mark, lang + "\n")


def files(s):
    acc = ACCENTS[s["accent"]][1]
    bg, surf, fg, dim, line = MODES[s["mode"]]
    dark = s["mode"] == "dark"
    # Launchers: panel and desktop (desktop icons are made once, so the user may delete them)
    for i, (key, name, comment, icon) in enumerate(APPS):
        write(HOME / f".local/share/monzero-desktop/apps/{key}.desktop", desktop_entry(key, name, comment, icon))
        d = HOME / "Desktop" / f"{key}.desktop"
        if not (HOME / ".config/monzero-desktop/icons-made").exists() or (d.exists() and "Name[" not in d.read_text()):
            write(d, desktop_entry(key, name, comment, icon), 0o755)
            os.utime(d, (1_000_000_000 + i, 1_000_000_000 + i))   # keeps this order on the desktop
    (HOME / ".config/monzero-desktop").mkdir(parents=True, exist_ok=True)
    (HOME / ".config/monzero-desktop/icons-made").touch()
    sync_wallet_language(s)

    # Desktop (pcmanfm): wallpaper, label colours, no file-manager clutter
