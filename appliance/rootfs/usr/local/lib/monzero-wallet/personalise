#!/usr/bin/python3 -I
"""Personalise the Monzero desktop: wallpaper, theme colour, dark or light, panel position,
language and keyboard.
  personalise            the settings window (changes apply at once)
  personalise --apply    write the desktop's config files from the saved settings, then reload
  personalise --setup    session start: write the config files and desktop icons, no reload
  personalise --env      print LANG and the keyboard layout for the session (shell assignments)"""
import json, os, shutil, subprocess, sys
from pathlib import Path

from monzero_i18n import KEYBOARDS, LANGS, box_keyboard, box_language, norm, set_wallet_language, tr

