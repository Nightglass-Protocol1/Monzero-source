#!/usr/bin/python3 -I
"""Personalise the Monzero desktop: wallpaper, theme colour, dark or light, panel position.
  personalise            the settings window (changes apply at once)
  personalise --apply    write the desktop's config files from the saved settings, then reload
  personalise --setup    session start: write the config files and desktop icons, no reload"""
import json, os, shutil, subprocess, sys
from pathlib import Path

HOME = Path.home()
SETTINGS = HOME / ".config/monzero-desktop/settings.json"
WALLS = Path("/usr/share/monzero/wallpapers")
OWN = HOME / ".local/share/monzero/wallpapers"
THUMBS = HOME / ".cache/monzero-desktop/thumbs"
LIB = Path("/usr/local/lib/monzero-wallet")
ICONS = "/usr/share/monzero/branding/icons"
ACCENTS = {"cyan": ("Cyan", "#19d6e6"), "emerald": ("Emerald", "#2fd57a"), "violet": ("Violet", "#9b7bff"),
           "amber": ("Amber", "#ffb020"), "rose": ("Rose", "#ff5c8a")}
MODES = {   # background, raised surface, text, dimmed text, line
    "dark": ("#0b1418", "#13222a", "#e8eef2", "#8a9aa3", "#1f3038"),
    "light": ("#eef3f6", "#ffffff", "#10181c", "#5b6b73", "#c9d4da"),
}
DEFAULTS = {"wallpaper": str(WALLS / "01-monzero.jpg"), "fit": "crop", "accent": "cyan", "mode": "dark",
            "panel": "bottom", "icons": "large"}
FITS = {"crop": "Fill the screen", "fit": "Whole picture", "stretch": "Stretch"}
APPS = [("wallet", "Monzero Wallet", "Your XMZ wallet and the exchange", "wallet"),
        ("personalise", "Personalise", "Wallpaper, colours and the panel", "personalise"),
        ("about", "About this box", "Address, node and relay status", "about")]


def load():
    s = dict(DEFAULTS)
    try:
        s.update({k: v for k, v in json.loads(SETTINGS.read_text()).items() if k in DEFAULTS})
    except (OSError, ValueError):
        pass
    if s["accent"] not in ACCENTS: s["accent"] = "cyan"
    if s["mode"] not in MODES: s["mode"] = "dark"
    if s["fit"] not in FITS: s["fit"] = "crop"
    if s["wallpaper"] != "colour" and not Path(s["wallpaper"]).exists():
        s["wallpaper"] = DEFAULTS["wallpaper"]
    return s


def save(s):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(s, indent=1))


def write(path, text, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".new")
    tmp.write_text(text)
    tmp.chmod(mode)
    tmp.replace(path)


def desktop_entry(key, name, comment, icon):
    return (f"[Desktop Entry]\nType=Application\nName={name}\nComment={comment}\n"
            f"Exec={LIB}/{key}\nIcon={ICONS}/{icon}.png\nTerminal=false\n")


def files(s):
    acc = ACCENTS[s["accent"]][1]
    bg, surf, fg, dim, line = MODES[s["mode"]]
    dark = s["mode"] == "dark"
    # Launchers: panel and desktop (desktop icons are made once, so the user may delete them)
    for i, (key, name, comment, icon) in enumerate(APPS):
        write(HOME / f".local/share/monzero-desktop/apps/{key}.desktop", desktop_entry(key, name, comment, icon))
        d = HOME / "Desktop" / f"{key}.desktop"
        if not (HOME / ".config/monzero-desktop/icons-made").exists():
            write(d, desktop_entry(key, name, comment, icon), 0o755)
            os.utime(d, (1_000_000_000 + i, 1_000_000_000 + i))   # keeps this order on the desktop
    (HOME / ".config/monzero-desktop").mkdir(parents=True, exist_ok=True)
    (HOME / ".config/monzero-desktop/icons-made").touch()

    # Desktop (pcmanfm): wallpaper, label colours, no file-manager clutter
    wp = s["wallpaper"]
    # labels follow what is behind them: every built-in picture is dark, a plain colour follows the look
