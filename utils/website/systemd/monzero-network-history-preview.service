[Unit]
Description=Collect Monzero mainnet observations for the local website preview
After=monzero-website-preview.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/Monzero-App/core-wt-website-ecosystem
ExecStart=/usr/bin/python3 -I utils/website/network_history.py --source preview --database %h/.local/state/monzero-website-history/observations.sqlite --output-directory website/network/data
TimeoutStartSec=60
UMask=0077
Nice=10
NoNewPrivileges=yes
