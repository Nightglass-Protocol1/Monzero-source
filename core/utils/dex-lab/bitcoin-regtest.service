[Unit]
Description=Bitcoin Core isolated regtest node
After=network.target

[Service]
Type=simple
User=monzero
Group=monzero
ExecStart=/srv/monzero-dex/bin/bitcoind -conf=/srv/monzero-dex/config/bitcoin-regtest.conf -datadir=/srv/monzero-dex/data/bitcoin-regtest
ExecStop=/srv/monzero-dex/bin/bitcoin-cli -conf=/srv/monzero-dex/config/bitcoin-regtest.conf -datadir=/srv/monzero-dex/data/bitcoin-regtest stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/monzero-dex/data/bitcoin-regtest /srv/monzero-dex/logs
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
