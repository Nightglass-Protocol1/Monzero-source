+    /// MONZERO_ELECTRUM_PINS = "host:port=<64-hex sha256>,...": the recorded SHA256 (DER) of the
+    /// server certificate to pin for this endpoint, or None to use the platform CA trust store.
+    fn pinned_cert(&self) -> Result<Option<[u8; 32]>> {
+        let key = format!("{}:{}", self.host, self.port);
+        let raw = match std::env::var("MONZERO_ELECTRUM_PINS") { Ok(value) => value, Err(_) => return Ok(None) };
+        for item in raw.split(',') {
+            if let Some((hostport, sha)) = item.trim().rsplit_once('=') {
+                if hostport.trim() == key {
+                    let sha = sha.trim();
+                    ensure!(sha.len() == 64, "Electrum pin must be 32-byte hex");
+                    let mut pin = [0u8; 32];
+                    for (i, byte) in pin.iter_mut().enumerate() {
+                        *byte = u8::from_str_radix(&sha[i * 2..i * 2 + 2], 16).context("invalid Electrum pin hex")?;
+                    }
+                    return Ok(Some(pin));
+                }
+            }
+        }
+        Ok(None)
+    }
