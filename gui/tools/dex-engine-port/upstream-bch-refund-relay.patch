+use super::*;
+use agreement::execution::funding::recovery::refund::relay::RefundRelayState;
+
+pub(super) async fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: &Server,rpc: &BchRpc) -> Result<()> {
+    let block=Some(BlockHash::from_byte_array([6;32]));
+    for mode in [0,1,2] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {
+            let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+        }
+        let mut execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let recovery=execution.retained_bch_recovery()?.context("missing refund fixture")?;
+        let transaction: Transaction=bitcoin::consensus::deserialize(recovery.refund_bytes())?;
+        let txid=transaction.compute_txid();
+        let intent=copied.0.join(format!("{}.bch-refund-relay-intent",setup.quote.terms()["swapId"]));
+        let ack=copied.0.join(format!("{}.bch-refund-relay-ack",setup.quote.terms()["swapId"]));
+        {
+            let mut state=server.state.lock().unwrap();state.refund=Some(transaction);
+            state.relay_mode=mode;state.relay_intent=Some(intent.clone());
+        }
+        let calls=server.state.lock().unwrap().refund_relay_calls;
+        let review=execution.review_bch_refund_relay(rpc,2042,5)?;
+        assert!(execution.bch_refund_relay_state()?.is_none());
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_bch_refund(rpc,block,&bad,2043,5).await.is_err());
+        assert!(execution.relay_bch_refund(rpc,block,&review.commitment,2043,6).await.is_err());
+        assert!(!intent.exists());
+        if mode==0 {
+            server.state.lock().unwrap().recovery_output_spent=true;
+            let result=execution.relay_bch_refund(rpc,block,&review.commitment,2043,5).await;
+            server.state.lock().unwrap().recovery_output_spent=false;
+            assert!(result.is_err());assert!(!intent.exists());
+            for invalid in [1,2,3] {
+                server.state.lock().unwrap().redemption_confirmation_mode=invalid;
+                assert!(execution.relay_bch_refund(rpc,block,&review.commitment,2043,5).await.is_err());
+                assert!(!intent.exists());
+            }
+            server.state.lock().unwrap().redemption_confirmation_mode=0;
+        }
+        assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls);
+        let result=execution.relay_bch_refund(rpc,block,&review.commitment,2043,5).await;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls+1);
+        let expected=if mode==0 {
+            assert_eq!(result?,txid);assert!(ack.exists());RefundRelayState::Acknowledged {txid}
+        } else {assert!(result.is_err());assert!(!ack.exists());RefundRelayState::Attempted {txid}};
+        assert_eq!(execution.bch_refund_relay_state()?,Some(expected));drop(execution);
+        let mut restored=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        assert_eq!(restored.bch_refund_relay_state()?,Some(expected));
+        assert!(restored.relay_bch_refund(rpc,block,&review.commitment,2042,5).await.is_err());
+        let result=restored.relay_bch_refund(rpc,None,&review.commitment,2044,5).await;
+        if mode==0 {assert_eq!(result?,txid);} else {assert!(result.is_err());}
+        assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls+1);
+        if mode==0 {
+            let saved=std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;
+            assert!(restored.bch_refund_relay_state().is_err());std::fs::write(&ack,saved)?;
+            let held=copied.0.join("held-refund-intent");std::fs::rename(&intent,&held)?;
+            assert!(restored.bch_refund_relay_state().is_err());std::fs::rename(&held,&intent)?;
+        }
+    }
+    let mut state=server.state.lock().unwrap();state.refund=None;state.relay_mode=0;state.relay_intent=None;
+    Ok(())
+}
