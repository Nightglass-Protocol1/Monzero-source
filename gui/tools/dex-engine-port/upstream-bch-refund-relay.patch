+//! Explicit one-shot publication of the retained private refund. The native
+//! peer can recover its share after publication; no raw refund reaches review/UI.
+use super::*;
+use bitcoin::BlockHash;
+
+const ATTEMPT: &str="monzero-bch-refund-relay-intent-v1";
+const ACK: &str="monzero-bch-refund-relay-ack-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt {schema: String,review: [u8;32],safety_blocks: u32,approved_at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack {schema: String,attempt: [u8;32],txid: Txid}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum RefundRelayState {
+    /// Includes interruption before dispatch; not permission to retry.
+    Attempted {txid: Txid},
+    /// Exact node acknowledgement only, not current confirmation.
+    Acknowledged {txid: Txid},
+}
+fn slot(quote: &VerifiedBchQuote,part: &str) -> String {format!("{}.bch-refund-relay-{part}",quote.terms()["swapId"])}
+impl AdmittedExecution<'_> {
+    fn refund_attempt(&self) -> Result<Option<(Attempt,[u8;32])>> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH refund relay role");self.read_admission()?;
+        let Some(bytes)=optional(&self.metadata,&slot(self.quote,"intent"))? else {return Ok(None)};
+        ensure!(bytes.len()<=4096,"oversized BCH refund intent");let attempt: Attempt=serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema==ATTEMPT && serde_json::to_vec(&attempt)?==bytes,"BCH refund intent changed");
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+    fn refund_state(&self,review: &RefundRelayReview,recovery: &PrivateRecovery,margin: u32) -> Result<Option<RefundRelayState>> {
+        let ack=optional(&self.metadata,&slot(self.quote,"ack"))?;
+        let Some((attempt,digest))=self.refund_attempt()? else {
+            ensure!(ack.is_none(),"BCH refund acknowledgement lacks intent");return Ok(None)
+        };
+        ensure!(attempt.review==review.commitment && attempt.safety_blocks==margin && attempt.approved_at>=recovery.prepared_at(),
+            "BCH refund attempt differs from original approval");
+        let txid=recovery.refund_txid()?;
+        let Some(bytes)=ack else {return Ok(Some(RefundRelayState::Attempted {txid}))};
+        ensure!(bytes.len()<=4096,"oversized BCH refund acknowledgement");let ack: Ack=serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema==ACK && ack.attempt==digest && ack.txid==txid && serde_json::to_vec(&ack)?==bytes,"BCH refund acknowledgement changed");
+        Ok(Some(RefundRelayState::Acknowledged {txid}))
+    }
+    /// Restore the original safety margin from the immutable attempt.
+    pub fn bch_refund_relay_state(&self) -> Result<Option<RefundRelayState>> {
+        let Some((attempt,_))=self.refund_attempt()? else {
+            ensure!(optional(&self.metadata,&slot(self.quote,"ack"))?.is_none(),"BCH refund acknowledgement lacks intent");return Ok(None)
+        };
+        let (review,recovery,_)=self.refund_relay_materials(attempt.safety_blocks)?;
+        self.refund_state(&review,&recovery,attempt.safety_blocks)
+    }
+    /// Confirmed cancellation removes the original success branch. Refund can
+    /// therefore return BCH even when no native payment was made. The exact
+    /// recovery output must still be unspent and safely before punishment.
+    pub async fn relay_bch_refund(&mut self,bch: &BchRpc,block: Option<BlockHash>,approved: &[u8;32],
+        now: u64,safety_blocks: u32) -> Result<Txid> {
+        let (review,recovery,deployment)=self.refund_relay_materials(safety_blocks)?;
+        ensure!(*approved==review.commitment,"BCH refund approval is stale or mismatched");
+        ensure!(now>=recovery.prepared_at() && bch.deployment_commitment()?==deployment,"BCH refund predates preparation or changes observer");
+        if let Some((attempt,_))=self.refund_attempt()? {ensure!(now>=attempt.approved_at,"BCH refund time moved backwards");}
+        match self.refund_state(&review,&recovery,safety_blocks)? {
+            Some(RefundRelayState::Acknowledged {txid})=>return Ok(txid),
+            Some(RefundRelayState::Attempted {..})=>anyhow::bail!("BCH refund result is uncertain; reconcile without retransmitting"),
+            None=>(),
+        }
+        self.bch_cancel_relay_state()?; // Validate any local cancellation history before live checks.
+        let refund: Transaction=deserialize(recovery.refund_bytes())?;
+        let cancel=recovery.cancel();let minimum=u64::from(self.policy.bch_confirmations);
+        let deadline=std::time::Instant::now().checked_add(std::time::Duration::from_secs(30)).context("BCH refund deadline overflow")?;
+        tokio::time::timeout_at(deadline.into(),async {
+            let confirmed=match block {
+                Some(block)=>bch.confirmed_transaction(cancel.compute_txid(),block,minimum).await?,
+                None=>bch.indexed_confirmed_transaction(cancel.compute_txid(),minimum).await?,
+            };
+            ensure!(confirmed.deployment()==&deployment && serialize(confirmed.transaction())==serialize(cancel),"BCH refund cancellation changed");
+            let output=bch.confirmed_unspent_output(&confirmed,0).await?;
+            ensure!(output.outpoint()==refund.input[0].previous_output,"BCH refund source changed");
+            output.require_refund_window(minimum,u32::from(self.policy.punish_blocks),safety_blocks)
+        }).await.context("BCH refund observation timed out")??;
+        ensure!(std::time::Instant::now()<deadline,"BCH refund evidence expired before intent");
+        let bytes=serde_json::to_vec(&Attempt {schema:ATTEMPT.into(),review:*approved,safety_blocks,approved_at:now})?;
+        self.metadata.retain(&slot(self.quote,"intent"),&bytes)?;
+        let txid=bch.relay_refund(&refund,deadline).await?;
+        self.metadata.retain(&slot(self.quote,"ack"),&serde_json::to_vec(&Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid})?)?;
+        Ok(txid)
+    }
+}
