+/// Trusted operator policy, never inferred from the peer's proposed terms.
+/// Exact matching does not prove that a timeout policy is safe across chains.
+#[derive(Clone)]
+pub struct DeploymentPolicy {
+    pub btc_genesis: String,
+    pub xmz_genesis: String,
+    pub btc_network: String,
+    pub xmz_network: String,
+    pub btc_confirmations: u32,
+    pub xmz_confirmations: u32,
+    pub cancel_blocks: u32,
+    pub punish_blocks: u32,
+    pub maximum_btc_principal: u64,
+    pub maximum_xmz_principal: u64,
+    pub maximum_btc_native_fee: u64,
+    pub maximum_xmz_native_fee: u64,
+}
+
 /// Immutable validated terms. Callers must additionally enforce deployment policy,
 /// durable approval/replay protection and binding to the negotiated protocol state.
 pub struct VerifiedQuote {
@@ -82,6 +100,36 @@ impl VerifiedQuote {
     pub fn terms(&self) -> &BTreeMap<String, String> { &self.terms }
     pub fn commitment(&self) -> &[u8; 32] { &self.commitment }
     pub fn destinations(&self) -> &QuoteDestinations { &self.destinations }
+
+    /// Recheck at the point of use. Does not attest the connected daemons' chains,
+    /// reserve funds, persist approval, or authorize any transaction.
+    pub fn check_deployment(&self, policy: &DeploymentPolicy, now: u64) -> Result<()> {
+        let number = |key: &str| -> Result<u64> { Ok(self.terms[key].parse()?) };
+        let expiry = number("expiresAt")?;
+        ensure!(expiry > now && expiry - now <= 3600, "quote outside validity window");
+        for (field, expected) in [
+            ("btcGenesis", &policy.btc_genesis), ("xmzGenesis", &policy.xmz_genesis),
+            ("btcNetwork", &policy.btc_network), ("xmzNetwork", &policy.xmz_network),
+        ] {
+            ensure!(&self.terms[field] == expected, "quote deployment identity mismatch");
+        }
+        for (field, expected) in [
+            ("btcConfirmations", policy.btc_confirmations),
+            ("xmzConfirmations", policy.xmz_confirmations),
+            ("cancelBlocks", policy.cancel_blocks), ("punishBlocks", policy.punish_blocks),
+        ] {
+            ensure!(number(field)? == u64::from(expected), "quote deployment timing mismatch");
+        }
+        for (field, maximum) in [
+            ("btcSatoshis", policy.maximum_btc_principal),
+            ("xmzAtoms", policy.maximum_xmz_principal),
+            ("btcNativeFeeMaxSatoshis", policy.maximum_btc_native_fee),
+            ("xmzNativeFeeMaxAtoms", policy.maximum_xmz_native_fee),
+        ] {
+            ensure!(maximum > 0 && number(field)? <= maximum, "quote exceeds deployment limits");
+        }
+        Ok(())
+    }
 }
 
