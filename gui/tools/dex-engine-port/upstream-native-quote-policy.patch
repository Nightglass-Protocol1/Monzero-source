+    #[test]
+    fn deployment_policy_is_exact_and_rechecked_at_use() {
+        let quote = verify(&fixture(), 1000).unwrap();
+        let policy = DeploymentPolicy {
+            btc_genesis: "a".repeat(64), xmz_genesis: "b".repeat(64),
+            btc_network: "btc-regtest".into(), xmz_network: "xmz-fakechain".into(),
+            btc_confirmations: 1, xmz_confirmations: 1, cancel_blocks: 10, punish_blocks: 20,
+            maximum_btc_principal: 500000, maximum_xmz_principal: 200000000000,
+            maximum_btc_native_fee: 10000, maximum_xmz_native_fee: 1000000000,
+        };
+        quote.check_deployment(&policy, 1000).unwrap();
+        assert!(quote.check_deployment(&policy, 1100).is_err());
+        assert!(quote.check_deployment(&policy, u64::MAX).is_err());
+        for field in 0..12 {
+            let mut changed = policy.clone();
+            match field {
+                0 => changed.btc_genesis = "c".repeat(64),
+                1 => changed.xmz_genesis = "c".repeat(64),
+                2 => changed.btc_network = "btc-mainnet".into(),
+                // Same address encoding, different deployment: must still fail.
+                3 => changed.xmz_network = "xmz-mainnet".into(),
+                4 => changed.btc_confirmations += 1,
+                5 => changed.xmz_confirmations += 1,
+                6 => changed.cancel_blocks += 1,
+                7 => changed.punish_blocks += 1,
+                8 => changed.maximum_btc_principal -= 1,
+                9 => changed.maximum_xmz_principal -= 1,
+                10 => changed.maximum_btc_native_fee -= 1,
+                11 => changed.maximum_xmz_native_fee -= 1,
+                _ => unreachable!(),
+            }
+            assert!(quote.check_deployment(&changed, 1000).is_err(), "policy field {field}");
+        }
+        let mut disabled = policy.clone();
+        disabled.maximum_btc_principal = 0;
+        assert!(quote.check_deployment(&disabled, 1000).is_err());
+        let mut larger = policy;
+        larger.maximum_btc_principal += 1;
+        larger.maximum_xmz_principal += 1;
+        larger.maximum_btc_native_fee += 1;
+        larger.maximum_xmz_native_fee += 1;
+        quote.check_deployment(&larger, 1000).unwrap();
+    }
 }
