+/// Shared identity across fixed-principal and exact-net modes. Changing the
+/// top-up, destination or mode must never obtain another reservation of a lock.
+#[cfg(unix)]
+pub(super) fn reserve_intent(directory: &Path, genesis: &str, wallet: &str,
+    lock: &str, intent: &serde_json::Value) -> Result<(File, String)> {
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+    ensure!(directory.is_absolute() && directory.canonicalize()? == directory,
+        "journal directory must be canonical and absolute");
+    let parent = OpenOptions::new().read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC).open(directory)?;
+    let metadata = parent.metadata()?;
+    ensure!(metadata.is_dir() && metadata.uid() == unsafe { libc::geteuid() }
+        && metadata.mode() & 0o077 == 0, "journal directory must be private and owned");
+    ensure!(canonical_hash(genesis) && canonical_hash(lock), "invalid journal chain or lock");
+    let mut digest = Sha256::new();
+    digest.update(b"monzero-native-spend-journal-v1\0");
+    for field in [genesis, wallet, lock] {
+        digest.update((field.len() as u64).to_be_bytes());
+        digest.update(field.as_bytes());
+    }
+    let identity = format!("{:x}", digest.finalize());
+    // Existing, malformed and truncated files occupy the identity permanently.
+    let mut file = create_record(&parent, &format!("{identity}.intent"))?;
+    file.write_all(&serde_json::to_vec(intent)?)?;
+    file.sync_all()?;
+    parent.sync_all()?;
+    Ok((parent, identity))
+}
