+//! Write-once exact-net accounting. No relay authority or secret persistence.
+//! Caller owns the canonical private directory and reserves before construction.
+use anyhow::{ensure, Result};
+use serde_json::{json, Value};
+use std::{fs::File, path::Path};
+#[cfg(unix)]
+use std::io::Write;
+use super::full_proceeds::{ExactNetRequest, PreparedExactNet};
+
+pub struct ExactNetJournal {
+    directory: File,
+    identity: String,
+    intent: Value,
+}
+
+impl ExactNetJournal {
+    #[cfg(unix)]
+    pub fn reserve(directory: &Path, genesis: &str, request: &ExactNetRequest,
+        top_up: &str) -> Result<Self> {
+        super::full_proceeds::exact_net_params(request)?;
+        let source = &request.source;
+        ensure!(top_up.len() == 64 && top_up.bytes().all(|b| b.is_ascii_digit()
+            || (b'a'..=b'f').contains(&b)) && top_up != "0".repeat(64)
+            && top_up != source.lock_txid, "invalid exact-net journal top-up");
+        let wallet = source.wallet.to_string();
+        let intent = json!({"schema":"monzero-exact-net-spend-intent-v1", "genesis":genesis,
+            "wallet":wallet,"lockTxid":source.lock_txid,"topUpTxid":top_up,
+            "totalAtoms":source.locked.atom_string(),"principalAtoms":request.principal.atom_string(),
+            "destination":source.destination.to_string(),
+            "reserveReturnDestination":request.reserve_return.to_string(),
+            "maximumFeeAtoms":source.maximum_fee.atom_string(),"account":source.account,"priority":source.priority});
+        let (directory,identity) = super::spend_journal::reserve_intent(
+            directory,genesis,&wallet,&source.lock_txid,&intent)?;
+        Ok(Self { directory,identity,intent })
+    }
+
+    #[cfg(not(unix))]
+    pub fn reserve(_: &Path, _: &str, _: &ExactNetRequest, _: &str) -> Result<Self> {
+        anyhow::bail!("exact-net journal not implemented on this platform")
+    }
+
+    /// Persist validated public transaction/accounting data before any future
+    /// relay. Missing or torn records do not authorize retry or reconstruction.
+    #[cfg(unix)]
+    pub fn record_prepared(&self, prepared: &PreparedExactNet) -> Result<()> {
+        let terms = prepared.terms();
+        check_terms(&self.intent,terms)?;
+        let mut file = super::spend_journal::create_record(&self.directory,
+            &format!("{}.prepared",self.identity))?;
+        file.write_all(&serde_json::to_vec(terms)?)?;
+        file.sync_all()?;
+        self.directory.sync_all()?;
+        Ok(())
+    }
+
+    #[cfg(not(unix))]
+    pub fn record_prepared(&self, _: &PreparedExactNet) -> Result<()> {
+        anyhow::bail!("exact-net journal not implemented on this platform")
+    }
+}
+
+fn check_terms(intent: &Value, terms: &Value) -> Result<()> {
+    for (field,value) in intent.as_object().expect("internal intent object") {
+        if field != "schema" {
+            ensure!(terms.get(field) == Some(value), "exact-net prepared terms differ from intent");
+        }
+    }
+    Ok(())
+}
+
+#[cfg(all(test,unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{DirBuilderExt,PermissionsExt};
+    use swap_core::{xmz::XmzAmount,xmz_address::{XmzAddress,XmzNetwork}};
+    struct Directory(std::path::PathBuf);
+    impl Directory {
+        fn new() -> Self {
+            let path=std::env::temp_dir().canonicalize().unwrap()
+                .join(format!("exact-net-journal-{}",uuid::Uuid::new_v4()));
+            std::fs::DirBuilder::new().mode(0o700).create(&path).unwrap();Self(path)
+        }
+    }
+    impl Drop for Directory { fn drop(&mut self) { let _=std::fs::remove_dir_all(&self.0); } }
+    fn request() -> ExactNetRequest {
+        let addresses:Vec<_>=include_str!("../../../swap-core/src/xmz_address_vectors.txt").lines()
+            .take(3).map(|s| XmzAddress::parse(XmzNetwork::Mainnet,s).unwrap()).collect();
+        ExactNetRequest { source:super::super::full_proceeds::FullProceedsRequest {
+            wallet:addresses[0].clone(),destination:addresses[1].clone(),lock_txid:"a".repeat(64),
+            locked:XmzAmount::from_atoms(110),maximum_fee:XmzAmount::from_atoms(2),account:0,priority:1 },
+            principal:XmzAmount::from_atoms(100),reserve_return:addresses[2].clone() }
+    }
+    #[test]
+    fn every_reserved_term_is_bound_except_distinct_schema() -> Result<()> {
+        let directory=Directory::new();
+        let journal=ExactNetJournal::reserve(&directory.0,&"b".repeat(64),&request(),&"c".repeat(64))?;
+        let mut terms=journal.intent.clone();terms["schema"]=json!("monzero-exact-net-prepared-accounting-v1");
+        check_terms(&journal.intent,&terms)?;
+        for field in journal.intent.as_object().unwrap().keys().filter(|key| *key != "schema") {
+            let mut altered=terms.clone();altered[field]=json!(null);
+            assert!(check_terms(&journal.intent,&altered).is_err(),"accepted changed {field}");
+            altered.as_object_mut().unwrap().remove(field);
+            assert!(check_terms(&journal.intent,&altered).is_err(),"accepted absent {field}");
+        }
+        Ok(())
+    }
+    #[test]
+    fn malformed_top_up_never_creates_intent() {
+        let directory=Directory::new();let request=request();
+        for top_up in ["".into(),"c".repeat(63),"C".repeat(64),"0".repeat(64),request.source.lock_txid.clone()] {
+            assert!(ExactNetJournal::reserve(&directory.0,&"b".repeat(64),&request,&top_up).is_err());
+            assert_eq!(std::fs::read_dir(&directory.0).unwrap().count(),0);
+        }
+    }
+    #[test]
+    fn private_directory_and_torn_intent_block_retry() -> Result<()> {
+        let directory=Directory::new();let request=request();let genesis="b".repeat(64);let top_up="c".repeat(64);
+        std::fs::set_permissions(&directory.0,std::fs::Permissions::from_mode(0o755))?;
+        assert!(ExactNetJournal::reserve(&directory.0,&genesis,&request,&top_up).is_err());
+        std::fs::set_permissions(&directory.0,std::fs::Permissions::from_mode(0o700))?;
+        let journal=ExactNetJournal::reserve(&directory.0,&genesis,&request,&top_up)?;
+        let path=directory.0.join(format!("{}.intent",journal.identity));
+        assert_eq!(std::fs::metadata(&path)?.permissions().mode() & 0o777,0o600);
+        drop(journal);std::fs::write(&path,b"")?;
+        assert!(ExactNetJournal::reserve(&directory.0,&genesis,&request,&top_up).is_err());
+        assert_eq!(std::fs::metadata(path)?.len(),0);
+        Ok(())
+    }
+}
