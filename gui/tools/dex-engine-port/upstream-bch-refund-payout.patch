+//! Refund accounting sends both portions to the signed refund address.
+//! The recipient receives the original lock minus the actual bounded refund fee.
+use super::*;
+use crate::native_funding_rpc::full_proceeds::{ExactNetRequest,FullProceedsRequest};
+use swap_core::xmz::XmzAmount;
+
+pub(super) struct BoundRefund {pub(super) request: ExactNetRequest,pub(super) genesis: String}
+impl BoundRefund {
+    pub(super) fn from_quote(quote: &VerifiedBchQuote,refund: &NativeRefund,priority: u32) -> Result<Self> {
+        ensure!(refund.quote==*quote.commitment(),"native payout refund belongs to another BCH quote");
+        Self::from_parts(quote,&refund.address,&refund.native_txid,priority)
+    }
+    fn from_parts(quote: &VerifiedBchQuote,wallet: &XmzAddress,txid: &str,priority: u32) -> Result<Self> {
+        ensure!((1..=4).contains(&priority),"invalid BCH native payout priority");
+        ensure!(wallet.network()==quote.xmz_payout().network()
+            && wallet!=quote.xmz_payout() && wallet!=quote.xmz_refund(),"invalid BCH native payout wallet or destinations");
+        ensure!(txid.len()==64 && txid!="0".repeat(64)
+            && txid.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid BCH native payout funding identity");
+        let amount=|field:&str| -> Result<XmzAmount> {Ok(XmzAmount::from_atoms(quote.terms()[field].parse()?))};
+        Ok(Self {genesis:quote.terms()["xmzGenesis"].clone(),request:ExactNetRequest {
+            source:FullProceedsRequest {wallet:wallet.clone(),destination:quote.xmz_refund().clone(),
+                lock_txid:txid.to_owned(),locked:amount("xmzAtoms")?,maximum_fee:amount("xmzRefundFeeMaxAtoms")?,account:0,priority},
+            principal:XmzAmount::from_atoms(amount("xmzAtoms")?.atoms().checked_sub(amount("xmzRefundFeeMaxAtoms")?.atoms()).context("refund fee consumes lock")?),reserve_return:quote.xmz_refund().clone()}})
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::hashes::Hash;
+    fn refund(quote: &VerifiedBchQuote) -> Result<NativeRefund> {
+        let mut bytes=[0;32];bytes[0]=2;
+        let scalar=monero_oxide_wallet::ed25519::Scalar::read(&mut bytes.as_slice())?;
+        let point=monero_oxide_ext::PublicKey::from_private_key(&monero_oxide_ext::PrivateKey::from_scalar(scalar)).decompress();
+        let address=XmzAddress::new(quote.xmz_payout().network(),monero_address::AddressType::Legacy,point.clone(),point)?;
+        Ok(NativeRefund {quote:*quote.commitment(),admission:[3;32],payment:[7;32],observed_at:std::time::Instant::now(),spend:Zeroizing::new([2;32]),view:Zeroizing::new([2;32]),
+            address,native_txid:"ab".repeat(32),refund:Txid::from_byte_array([4;32]),block:BlockHash::from_byte_array([5;32]),commitment:[6;32]})
+    }
+    #[test]
+    fn bch_native_refund_payout_preserves_signed_principal_reserve_and_destinations() -> Result<()> {
+        let (policy,mut terms)=crate::bch_quote::tests::fixture();terms.insert("xmzRefundFeeMaxAtoms".into(),"700".into());let quote=crate::bch_quote::tests::signed(&terms,&policy,1000)?;
+        let refund=refund(&quote)?;
+        for priority in 1..=4 {
+            let bound=BoundRefund::from_quote(&quote,&refund,priority)?;let source=&bound.request.source;
+            assert_eq!(source.wallet,refund.address);assert_eq!(source.lock_txid,refund.native_txid);
+            assert_eq!(source.locked.atoms(),101000);assert_eq!(source.maximum_fee.atoms(),700);
+            assert_eq!(bound.request.principal.atoms(),100300);assert_eq!(source.account,0);assert_eq!(source.priority,priority);
+            assert_eq!(&source.destination,quote.xmz_refund());assert_eq!(&bound.request.reserve_return,quote.xmz_refund());
+            assert_eq!(bound.genesis,policy.xmz_genesis);
+        }
+        Ok(())
+    }
+    #[test]
+    fn bch_native_refund_payout_rejects_mismatched_refund_and_invalid_inputs() -> Result<()> {
+        let (policy,mut terms)=crate::bch_quote::tests::fixture();terms.insert("xmzRefundFeeMaxAtoms".into(),"700".into());let quote=crate::bch_quote::tests::signed(&terms,&policy,1000)?;
+        let mut refund=refund(&quote)?;
+        for priority in [0,5,u32::MAX] {assert!(BoundRefund::from_quote(&quote,&refund,priority).is_err());}
+        for txid in ["0".repeat(64),"AB".repeat(32),"ab".repeat(31)] {
+            refund.native_txid=txid;assert!(BoundRefund::from_quote(&quote,&refund,1).is_err());
+        }
+        refund.native_txid="ab".repeat(32);refund.quote=[0;32];assert!(BoundRefund::from_quote(&quote,&refund,1).is_err());
+        refund.quote=*quote.commitment();refund.address=quote.xmz_payout().clone();
+        assert!(BoundRefund::from_quote(&quote,&refund,1).is_err());
+        Ok(())
+    }
+}
+
