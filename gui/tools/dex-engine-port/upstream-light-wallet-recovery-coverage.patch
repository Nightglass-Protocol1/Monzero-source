+use super::*;
+use crate::litecoin_light::{network::{BtcNetwork,BchNetwork,DogeNetwork},session::tests::{reply,server}};
+use bitcoin::{bip32::Xpriv,NetworkKind};
+use std::{fs,path::PathBuf,os::unix::fs::PermissionsExt};
+use uuid::Uuid;
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().join(format!("recovery-coverage-{}",Uuid::new_v4()));
+    fs::create_dir(&path)?;fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))}}
+impl Drop for Directory {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
+fn account(network:LightNetwork,seed:u8)->Result<PublicAccount> {
+    PublicAccount::from_master(&Xpriv::new_master(NetworkKind::Test,&[seed;32])?,network,0)
+}
+async fn empty_scan(network:LightNetwork,minimum:[u32;2])->Result<(HeaderSequence,WalletObservation)> {
+    let mut responses=vec![reply(1,json!(["fixture","1.4"])),reply(2,json!({"genesis_hash":network.genesis(),
+        "hash_function":"sha256","server_version":"fixture","protocol_min":"1.4","protocol_max":"1.4.3","hosts":{}}))];
+    for id in 3..3+minimum[0]+minimum[1]+4 {responses.push(reply(id as u64,json!([])));}
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,network).await?;
+    let chain=HeaderSequence::new(network)?;
+    let observation=session.refresh_wallet(&chain,&account(network,1)?,minimum,
+        &RefreshLimits {gap:2,addresses_per_branch:10,history_entries_per_branch:10}).await?;
+    drop(session);task.await?;Ok((chain,observation))
+}
+#[tokio::test]
+async fn approved_recovery_reserves_empty_scanned_ranges_and_preserves_existing_requests()->Result<()> {
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        let directory=Directory::new()?;let mut book=AddressBook::create(&directory.0,account(network,1)?)?;
+        let existing=Uuid::new_v4();let first=book.reserve(existing,Branch::Receive)?.address().to_string();
+        let (chain,observation)=empty_scan(network,[2,1]).await?;
+        assert!(observation.review_recovery_coverage(&chain,&book,[3,1]).is_err());
+        let review=observation.review_recovery_coverage(&chain,&book,[2,1])?;
+        assert_eq!(review.allocated_after(),[4,3]);
+        assert_eq!(review.review()["historyCompleteness"],"unproven");
+        assert_eq!(review.review()["backupRefreshRequired"],true);
+        let before=fs::read(directory.0.join("litecoin-address-book.json"))?;
+        assert!(review.retain_on(&chain,&mut book,sha256::Hash::hash(b"wrong approval")).is_err());
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,before);
+        let wrong_chain=HeaderSequence::new(if network==LightNetwork::Litecoin(LtcNetwork::Regtest) {
+            LightNetwork::Bitcoin(BtcNetwork::Regtest)}else{LightNetwork::Litecoin(LtcNetwork::Regtest)})?;
+        assert!(review.retain_on(&wrong_chain,&mut book,review.commitment()).is_err());
+        let other=Directory::new()?;let mut other_book=AddressBook::create(&other.0,account(network,2)?)?;
+        assert!(review.retain_on(&chain,&mut other_book,review.commitment()).is_err());
+        review.retain_on(&chain,&mut book,review.commitment())?;
+        assert_eq!(book.reserved(existing,Branch::Receive)?.unwrap().address().to_string(),first);
+        let retained=fs::read(directory.0.join("litecoin-address-book.json"))?;drop(book);
+        let mut reopened=AddressBook::open(&directory.0,account(network,1)?)?;
+        review.retain_on(&chain,&mut reopened,review.commitment())?;
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,retained);
+        assert!(reopened.reserve(Uuid::new_v4(),Branch::Receive)?.path().to_string().ends_with("/0/4"));
+        assert!(reopened.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string().ends_with("/1/3"));
+        let later=fs::read(directory.0.join("litecoin-address-book.json"))?;
+        assert!(review.retain_on(&chain,&mut reopened,review.commitment()).is_err());
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,later);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn recovery_review_rejects_book_allocations_not_covered_before_gap()->Result<()> {
+    let network=LightNetwork::Litecoin(LtcNetwork::Regtest);
+    let directory=Directory::new()?;let mut book=AddressBook::create(&directory.0,account(network,1)?)?;
+    let (chain,observation)=empty_scan(network,[0,0]).await?;
+    let review=observation.review_recovery_coverage(&chain,&book,[0,0])?;
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;
+    assert!(observation.review_recovery_coverage(&chain,&book,[0,0]).is_err());
+    let before=fs::read(directory.0.join("litecoin-address-book.json"))?;
+    assert!(review.retain_on(&chain,&mut book,review.commitment()).is_err());
+    assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,before);
+    Ok(())
+}
