+//! Reviewed, bounded recovery of address allocations from a wallet observation.
+//! A server-reported gap never proves complete history or absence of funds.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,account::allocation::AddressBook};
+use bitcoin::hashes::{Hash,sha256};
+use serde_json::{Value,json};
+
+/// Constructed only from a successful two-branch observation. No deserialization
+/// or public constructor: caller-supplied scan claims cannot become coverage.
+pub struct RecoveryCoverage {
+    review:Value,
+    commitment:sha256::Hash,
+    before:sha256::Hash,
+    target:[u32;2],
+    account:PublicAccount,
+    height:u32,
+    tip:bitcoin::BlockHash,
+}
+impl RecoveryCoverage {
+    pub fn review(&self)->&Value {&self.review}
+    pub fn commitment(&self)->sha256::Hash {self.commitment}
+    pub fn allocated_after(&self)->[u32;2] {self.target}
+
+    /// Requires exact approval and the unchanged selected chain. Existing
+    /// allocation identities survive. An exact completed retry is a no-op;
+    /// unrelated allocation changes require a fresh scan/review. This neither
+    /// activates an imported wallet nor refreshes its encrypted backup.
+    pub fn retain_on(&self,chain:&HeaderSequence,book:&mut AddressBook,approved:sha256::Hash)->Result<()> {
+        ensure!(approved==self.commitment,"recovery coverage differs from approval");
+        ensure!(chain.network()==self.account.network() && chain.height()==self.height
+            && chain.contains(self.height,self.tip),"recovery coverage chain changed");
+        let (descriptor,bytes)=book.backup_parts()?;
+        ensure!(serde_json::to_vec(&descriptor)?==serde_json::to_vec(&self.account.descriptor())?,
+            "recovery coverage account changed");
+        let current=[book.allocated_count(Branch::Receive)?,book.allocated_count(Branch::Change)?];
+        if sha256::Hash::hash(&bytes)!=self.before {
+            ensure!(current==self.target,"recovery allocations changed since review");
+            return Ok(());
+        }
+        book.retain_discovered(self.target)
+    }
+}
+impl WalletObservation {
+    /// Recover all scanned indices, including apparently unused addresses.
+    /// `known_minimum` is an explicit prior allocation bound, not a balance or
+    /// completeness assertion. Both scans must have covered that bound and the
+    /// existing book before counting their reported gap.
+    pub fn review_recovery_coverage(&self,chain:&HeaderSequence,book:&AddressBook,known_minimum:[u32;2])->Result<RecoveryCoverage> {
+        ensure!(chain.network()==self.account.network() && chain.height()==self.accounting.height()
+            && chain.contains(self.accounting.height(),self.accounting.tip()),"recovery discovery chain changed");
+        let (descriptor,bytes)=book.backup_parts()?;
+        ensure!(serde_json::to_vec(&descriptor)?==serde_json::to_vec(&self.account.descriptor())?,
+            "recovery discovery account mismatch");
+        let current=[book.allocated_count(Branch::Receive)?,book.allocated_count(Branch::Change)?];
+        let scans=[&self.receive,&self.change];
+        let target=[self.receive.scanned(),self.change.scanned()];
+        ensure!(target[0].checked_add(target[1]).is_some_and(|total|total<=10_000),"recovery allocation capacity exceeded");
+        for branch in 0..2 {
+            ensure!(self.allocated[branch]>=known_minimum[branch] && self.allocated[branch]>=current[branch]
+                && scans[branch].stop()==ScanStop::ReportedGap
+                && self.allocated[branch].checked_add(self.gap).is_some_and(|end|target[branch]>=end),
+                "recovery scan does not cover required allocations and gap");
+        }
+        let before=sha256::Hash::hash(&bytes);
+        let review=json!({"schema":format!("monzero-{}-recovery-coverage-v1",self.account.network().tag()),
+            "network":self.account.network().name(),"account":descriptor,
+            "height":self.accounting.height(),"tip":self.accounting.tip().to_string(),
+            "allocationDigest":before.to_string(),"allocatedBefore":current,"knownMinimum":known_minimum,
+            "scanAllocatedMinimum":self.allocated,"reportedGap":self.gap,"allocatedAfter":target,
+            "historyCompleteness":"unproven","activeSwapRecovery":false,"backupRefreshRequired":true});
+        let commitment=sha256::Hash::hash(&serde_json::to_vec(&review)?);
+        Ok(RecoveryCoverage {review,commitment,before,target,
+            account:PublicAccount::from_descriptor(&self.account.descriptor(),self.account.network())?,
+            height:self.accounting.height(),tip:self.accounting.tip()})
+    }
+}
