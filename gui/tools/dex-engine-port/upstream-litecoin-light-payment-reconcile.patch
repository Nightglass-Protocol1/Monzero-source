+//! Read-only reconciliation of the original signed payment, without a vault or
+//! new send intent. Inclusion does not free claims or authorize another payment.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,session::{ReadSession,reconciliation::PaymentObservation}};
+use tokio::io::{AsyncRead,AsyncWrite};
+impl ClaimedSpend {
+    pub async fn observe_payment_on<S:AsyncRead+AsyncWrite+Unpin>(&self,session:&mut ReadSession<S>,
+        chain:&HeaderSequence,maximum_history:usize)->Result<PaymentObservation> {
+        ensure!(chain.network()==self.review.account.network(),"Litecoin payment observation account network mismatch");
+        let signed=self.load_signed()?;
+        let observation=session.observe_retained(chain,&signed,maximum_history).await?;
+        ensure!(self.load_signed()?==signed,"Litecoin retained payment changed during observation");
+        Ok(observation)
+    }
+}
