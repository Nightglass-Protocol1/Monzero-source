+//! A bounded observation of one retained transaction. History omissions and
+//! pending membership remain untrusted; inclusion is relative to selected work.
+use super::*;
+use super::history::ReportedPosition;
+use crate::litecoin_light::headers::HeaderSequence;
+
+#[derive(Debug,PartialEq,Eq)]
+pub enum PaymentPosition {
+    NotReported,
+    ReportedPending,
+    Included {height:u32,block_hash:BlockHash,confirmations:u64},
+}
+pub struct PaymentObservation {
+    txid:Txid,network:LtcNetwork,height:u32,tip:BlockHash,position:PaymentPosition,
+}
+impl PaymentObservation {
+    pub fn txid(&self)->Txid {self.txid}
+    pub fn selected_height(&self)->u32 {self.height}
+    pub fn selected_tip(&self)->BlockHash {self.tip}
+    /// Reject reuse after the caller changes branches or extends the chain.
+    /// An unchanged tip still does not establish wall-clock/network freshness.
+    pub fn position_on(&self,chain:&HeaderSequence)->Result<&PaymentPosition> {
+        ensure!(chain.network()==self.network && chain.height()==self.height && chain.contains(self.height,self.tip),
+            "Litecoin payment observation requires a new chain check");
+        Ok(&self.position)
+    }
+}
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    // The public claimed-payment API verifies ownership/signatures before this
+    // transport step. Query only the exact payment script, never scan/select.
+    pub(in crate::litecoin_light) async fn observe_retained(&mut self,chain:&HeaderSequence,
+        transaction:&Transaction,maximum_history:usize)->Result<PaymentObservation> {
+        ensure!(chain.network()==self.network,"Litecoin payment observation network mismatch");
+        let outcome=self.observe_retained_inner(chain,transaction,maximum_history).await;
+        if outcome.is_err() {self.usable=false;}outcome
+    }
+    async fn observe_retained_inner(&mut self,chain:&HeaderSequence,transaction:&Transaction,
+        maximum_history:usize)->Result<PaymentObservation> {
+        let output=transaction.output.first().context("missing Litecoin payment output")?;
+        let txid=transaction.compute_txid();
+        let history=self.reported_history(&output.script_pubkey,maximum_history).await?;
+        let position=if let Some(report)=history.iter().find(|report|report.txid()==txid) {
+            let raw=serialize(transaction);ensure!(raw.len()<=MAX_TRANSACTION,"oversized Litecoin retained payment");
+            let (_,bytes)=self.exchange("blockchain.transaction.get",json!([txid.to_string(),false]),MAX_TRANSACTION*2+1024).await?;
+            ensure!(decode_hex(&result::<String>(&bytes)?,MAX_TRANSACTION)?==raw,"Litecoin reported payment bytes differ from retained signatures");
+            match report.position() {
+                ReportedPosition::Mempool | ReportedPosition::MempoolWithUnconfirmedParents=>PaymentPosition::ReportedPending,
+                ReportedPosition::Block(height)=>{
+                    let header=chain.header(height).context("Litecoin reported payment is outside the selected chain")?;
+                    let (id,bytes)=self.exchange("blockchain.transaction.get_merkle",json!([txid.to_string(),height]),MAX_RESPONSE).await?;
+                    let proof=match_merkle_proof(&InclusionRequest {id,height,block_hash:header.block_hash(),txid},&serialize(&header),&raw,&bytes)?;
+                    let confirmations=proof.confirmations_on(chain).context("Litecoin payment inclusion is orphaned")?;
+                    PaymentPosition::Included {height,block_hash:header.block_hash(),confirmations}
+                },
+            }
+        } else {PaymentPosition::NotReported};
+        let height=chain.height();let tip=chain.header(height).context("missing Litecoin selected tip")?.block_hash();
+        Ok(PaymentObservation {txid,network:self.network,height,tip,position})
+    }
+}
