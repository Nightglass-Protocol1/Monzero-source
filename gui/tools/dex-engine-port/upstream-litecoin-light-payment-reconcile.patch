+use super::*;
+use crate::litecoin_light::session::tests::{server,reply,regtest_handshake,hex};
+
+fn fixture()->Result<(HeaderSequence,Transaction,Value)> {
+    let fixture:Value=serde_json::from_str(include_str!("../wallet/fixture.json"))?;
+    let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    for block in fixture["blocks"].as_array().unwrap() {
+        chain.append(&decode_hex(block["header"].as_str().unwrap(),80)?,1296689052)?;
+    }
+    let block=fixture["blocks"][1].clone();
+    let tx=deserialize(&decode_hex(block["transaction"].as_str().unwrap(),MAX_TRANSACTION)?)?;
+    Ok((chain,tx,block))
+}
+#[tokio::test]
+async fn payment_observation_verifies_exact_bytes_and_selected_inclusion()->Result<()> {
+    let (chain,tx,block)=fixture()?;
+    let mut responses=regtest_handshake();
+    responses.extend([reply(3,json!([{"tx_hash":tx.compute_txid().to_string(),"height":2}])),
+        reply(4,block["transaction"].clone()),reply(5,json!({"block_height":2,"pos":0,"merkle":[]}))]);
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let observation=session.observe_retained(&chain,&tx,10).await?;
+    assert_eq!(observation.txid(),tx.compute_txid());assert_eq!(observation.selected_height(),2);
+    assert_eq!(observation.selected_tip(),chain.header(2).unwrap().block_hash());
+    assert_eq!(observation.position_on(&chain)?,&PaymentPosition::Included {height:2,
+        block_hash:chain.header(2).unwrap().block_hash(),confirmations:1});
+    assert!(observation.position_on(&chain.fork(1)?).is_err());
+    drop(session);let requests=task.await?;assert_eq!(requests.len(),5);
+    assert_eq!(requests[2]["params"],json!([script_hash(&tx.output[0].script_pubkey)]));
+    assert_eq!(requests[3]["params"],json!([tx.compute_txid().to_string(),false]));
+    assert_eq!(requests[4]["params"],json!([tx.compute_txid().to_string(),2]));Ok(())
+}
+#[tokio::test]
+async fn payment_observation_keeps_absence_and_pending_as_untrusted_reports()->Result<()> {
+    let (chain,tx,block)=fixture()?;
+    for height in [None,Some(0),Some(-1)] {
+        let mut responses=regtest_handshake();
+        responses.push(reply(3,height.map(|h|json!([{"tx_hash":tx.compute_txid().to_string(),"height":h}])).unwrap_or(json!([]))));
+        if height.is_some() {responses.push(reply(4,block["transaction"].clone()));}
+        let expected=responses.len();let (stream,task)=server(responses);
+        let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        let observation=session.observe_retained(&chain,&tx,10).await?;
+        assert_eq!(observation.position_on(&chain)?,if height.is_some() {&PaymentPosition::ReportedPending}else{&PaymentPosition::NotReported});
+        drop(session);assert_eq!(task.await?.len(),expected);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn payment_observation_rejects_changed_witness_height_and_merkle_branch()->Result<()> {
+    let (chain,tx,block)=fixture()?;
+    for case in 0..5 {
+        let mut responses=regtest_handshake();
+        responses.push(reply(3,json!([{"tx_hash":tx.compute_txid().to_string(),"height":if case==1 {3}else{2}}])));
+        let mut altered=tx.clone();altered.input[0].witness=bitcoin::Witness::from_slice(&[vec![1u8]]);
+        assert_eq!(altered.compute_txid(),tx.compute_txid());
+        responses.push(reply(4,if case==0 {json!(hex(&serialize(&altered)))} else {block["transaction"].clone()}));
+        if case>=2 {responses.push(reply(5,match case {
+            2=>json!({"block_height":1,"pos":0,"merkle":[]}),
+            3=>json!({"block_height":2,"pos":1,"merkle":[]}),
+            _=>json!({"block_height":2,"pos":0,"merkle":["00".repeat(32)]}),
+        }));}
+        let count=responses.len();let (stream,task)=server(responses);
+        let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        assert!(session.observe_retained(&chain,&tx,10).await.is_err());assert!(!session.usable);
+        assert!(session.observe_retained(&chain,&tx,10).await.is_err());drop(session);assert_eq!(task.await?.len(),count);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn payment_observation_recomputes_after_selected_branch_removes_inclusion()->Result<()> {
+    let (chain,tx,_)=fixture()?;let shorter=chain.fork(1)?;
+    let mut responses=regtest_handshake();responses.push(reply(3,json!([])));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let observation=session.observe_retained(&shorter,&tx,10).await?;
+    assert_eq!(observation.position_on(&shorter)?,&PaymentPosition::NotReported);
+    assert!(observation.position_on(&chain).is_err());drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
