     pub fn terms(&self) -> &Value { &self.terms }
+
+    /// Dedicated trusted RPC evidence only. No wallet lifecycle changes, refresh,
+    /// signing, broadcast or writes. Errors and pending/absent transfers remain
+    /// unresolved; they must never trigger an automatic retry.
+    pub async fn reconcile(&self, client: &NativeFundingRpc, wallet: &XmzAddress,
+        minimum_confirmations: u64) -> Result<super::spend_recovery::ConfirmedSpend> {
+        ensure!(minimum_confirmations>0 && self.terms["wallet"]==wallet.to_string(),
+            "invalid exact-net reconciliation context");
+        let before=client.snapshot().await?;
+        ensure!(self.terms["genesis"]==before.genesis && before.tip_hash.len()==64
+            && before.tip_hash.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+            "unexpected exact-net reconciliation chain");
+        ensure!(client.opened_wallet(wallet.network()).await?.as_ref()==Some(wallet),
+            "unexpected exact-net reconciliation wallet");
+        let txid=string(&self.terms,"txid")?;
+        let response=client.rpc(client.wallet,"get_transfer_by_txid",
+            json!({"txid":txid,"account_index":self.terms["account"]})).await?;
+        let confirmations=self.verify_transfer(&response["transfer"],&before,minimum_confirmations)?;
+        ensure!(client.opened_wallet(wallet.network()).await?.as_ref()==Some(wallet),
+            "exact-net reconciliation wallet changed");
+        ensure!(client.snapshot().await?==before,"exact-net reconciliation chain changed");
+        Ok(super::spend_recovery::ConfirmedSpend { txid,confirmations })
+    }
+
+    fn verify_transfer(&self, transfer: &Value, tip: &ChainSnapshot, minimum: u64) -> Result<u64> {
+        let atoms=|field| -> Result<u64> { Ok(string(&self.terms,field)?.parse()?) };
+        let principal=atoms("principalAtoms")?;
+        let reserve=atoms("reserveReturnAtoms")?;
+        ensure!(minimum>0 && self.terms["genesis"]==tip.genesis
+            && transfer["txid"]==self.terms["txid"] && transfer["type"]=="out"
+            && Some(number(transfer,"amount")?)==principal.checked_add(reserve)
+            && number(transfer,"fee")?==atoms("feeAtoms")?
+            && number(transfer,"unlock_time")?==0
+            && transfer["subaddr_index"]["major"]==self.terms["account"],
+            "observed exact-net transfer differs from preparation");
+        let destinations=transfer["destinations"].as_array().context("missing exact-net destinations")?;
+        ensure!(destinations.len()==2,"unexpected exact-net destination count");
+        let mut actual=std::collections::BTreeMap::new();
+        for destination in destinations {
+            ensure!(actual.insert(string(destination,"address")?,number(destination,"amount")?).is_none(),
+                "duplicate exact-net destination");
+        }
+        let expected=std::collections::BTreeMap::from([
+            (string(&self.terms,"destination")?,principal),
+            (string(&self.terms,"reserveReturnDestination")?,reserve)]);
+        ensure!(actual==expected,"observed exact-net destinations differ from preparation");
+        let height=number(transfer,"height")?;
+        let confirmations=number(transfer,"confirmations")?;
+        ensure!(height>0 && height<=tip.tip_height && confirmations>=minimum
+            && tip.tip_height.checked_sub(height).and_then(|h| h.checked_add(1))==Some(confirmations),
+            "exact-net transfer not confirmed at observed tip");
+        Ok(confirmations)
+    }
 }
