+//! Cooperative local claims only. Every BCH trade controlling these inputs must
+//! use the same metadata store. These records neither lock node/wallet coins nor
+//! prove ownership, chain identity or live unspent status. Never auto-release.
+use super::*;
+
+fn records(quote: &VerifiedBchQuote, preview: &FundingPreview, preparation: &[u8;32]) -> Result<Vec<(String,Vec<u8>)>> {
+    preview.transaction().input.iter().map(|input| {
+        let scope = serde_json::to_vec(&serde_json::json!({"network":quote.terms()["bchNetwork"],
+            "genesis":quote.terms()["bchGenesis"],"outpoint":input.previous_output.to_string()}))?;
+        let id = hash("monzero-bch-input-scope-v1",&scope);
+        let name = format!("bch-input-{}.claim",hex(&id));
+        let bytes = serde_json::to_vec(&serde_json::json!({"schema":"monzero-bch-input-claim-v1",
+            "scope":scope,"trade":quote.terms()["swapId"],"quote":quote.commitment(),"preparation":preparation}))?;
+        Ok((name,bytes))
+    }).collect()
+}
+
+pub(super) fn retain(journal: &Journal, quote: &VerifiedBchQuote, preview: &FundingPreview,
+    preparation: &[u8;32]) -> Result<()> {
+    let claims = records(quote,preview,preparation)?;
+    // Preflight all inputs under the caller's metadata lease. An ordinary
+    // conflict must not claim unrelated inputs before it is discovered.
+    for (name,bytes) in &claims {
+        match journal.read(name) {
+            Ok(existing)=>ensure!(existing == *bytes,"BCH input is claimed by another preparation"),
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+            Err(error)=>return Err(error),
+        }
+    }
+    // An I/O failure can retain a subset. Identical retry completes that subset;
+    // no failed preparation may clear claims or transfer them to another trade.
+    for (name,bytes) in claims { journal.retain(&name,&bytes)?; }
+    Ok(())
+}
+pub(super) fn require(journal: &Journal, quote: &VerifiedBchQuote, preview: &FundingPreview,
+    preparation: &[u8;32]) -> Result<()> {
+    for (name,bytes) in records(quote,preview,preparation)? {
+        ensure!(journal.read(&name)? == bytes,"BCH funding input claim mismatch");
+    }
+    Ok(())
+}
