+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::bch_quote::tests::{fixture,signed};
+    use bitcoin::{absolute,consensus::serialize,hashes::Hash,transaction::Version,Amount,
+        OutPoint,Sequence,Transaction,Txid,TxIn,TxOut,ScriptBuf,Witness};
+    use std::os::unix::fs::DirBuilderExt;
+    struct Directory(PathBuf);
+    impl Drop for Directory {fn drop(&mut self) {let _=std::fs::remove_dir_all(&self.0);}}
+    fn preview(quote: &VerifiedBchQuote, ids: &[u8]) -> Result<FundingPreview> {
+        let change = quote.recovery_plan().recovery().terms().redeem_destination.clone();
+        let mut parents = Vec::new(); let mut inputs = Vec::new();
+        for id in ids {
+            let parent = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+                input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([*id;32]),vout:0},
+                    script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+                output:vec![TxOut {value:Amount::from_sat(120_000),script_pubkey:change.clone()}]};
+            inputs.push(TxIn {previous_output:OutPoint {txid:parent.compute_txid(),vout:0},
+                script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()});
+            parents.push(serialize(&parent));
+        }
+        let tx = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,input:inputs,
+            output:vec![TxOut {value:Amount::from_sat(100_000),script_pubkey:quote.recovery_plan().lock().script_pubkey()},
+                TxOut {value:Amount::from_sat(120_000*ids.len() as u64-101_000),script_pubkey:change.clone()}]};
+        let sources: Vec<&[u8]> = parents.iter().map(Vec::as_slice).collect();
+        FundingPreview::verify(&serialize(&tx),&sources,quote.recovery_plan().lock(),100_000,&change,1000,546)
+    }
+    #[test]
+    fn different_trades_cannot_claim_the_same_input_or_partially_claim_on_conflict() -> Result<()> {
+        let (policy,mut terms) = fixture();let first = signed(&terms,&policy,1000)?;
+        terms.insert("swapId".into(),uuid::Uuid::new_v4().to_string());
+        let second = signed(&terms,&policy,1000)?;
+        let directory = Directory(std::env::temp_dir().canonicalize()?.join(format!("bch-claims-{}",uuid::Uuid::new_v4())));
+        std::fs::DirBuilder::new().mode(0o700).create(&directory.0)?;
+        let journal = Journal::open(&directory.0)?;
+        let a = preview(&first,&[9])?;let b = preview(&second,&[10,9])?;
+        retain(&journal,&first,&a,&[1;32])?;
+        retain(&journal,&first,&a,&[1;32])?;
+        require(&journal,&first,&a,&[1;32])?;
+        assert!(retain(&journal,&first,&a,&[2;32]).is_err());
+        assert!(retain(&journal,&second,&b,&[2;32]).is_err());
+        assert_eq!(std::fs::read_dir(&directory.0)?.count(),1);
+        let disjoint = preview(&second,&[10])?;
+        retain(&journal,&second,&disjoint,&[2;32])?;
+        drop(journal);
+        let journal = Journal::open(&directory.0)?;
+        require(&journal,&first,&a,&[1;32])?;
+        require(&journal,&second,&disjoint,&[2;32])?;
+        let record = records(&first,&a,&[1;32])?.remove(0).0;
+        std::fs::write(directory.0.join(&record),b"{")?;
+        assert!(require(&journal,&first,&a,&[1;32]).is_err());
+        assert!(retain(&journal,&first,&a,&[1;32]).is_err());
+        std::fs::remove_file(directory.0.join(record))?;
+        assert!(require(&journal,&first,&a,&[1;32]).is_err());
+        Ok(())
+    }
+}
