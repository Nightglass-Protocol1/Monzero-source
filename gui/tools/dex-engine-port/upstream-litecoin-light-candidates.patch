+//! Inclusion-checked candidates from server unspent claims. Omitted spends
+//! remain possible; these are not spendable coins or signing authorization.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,transaction::IncludedTransaction};
+use std::{collections::BTreeMap,sync::Arc};
+pub struct IncludedCandidate {report:ReportedOutput,transaction:Arc<IncludedTransaction>}
+impl IncludedCandidate {
+    pub fn outpoint(&self)->OutPoint {self.report.outpoint()}
+    pub fn value(&self)->Amount {self.report.value()}
+    pub fn transaction(&self)->&IncludedTransaction {&self.transaction}
+}
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    pub async fn included_unspent_candidates(&mut self,chain:&HeaderSequence,script:&Script,
+        maximum:usize,minimum_confirmations:u64)->Result<Vec<IncludedCandidate>> {
+        ensure!(chain.network()==self.network && minimum_confirmations>0,"invalid Litecoin candidate context");
+        ensure!(!script.is_empty() && script.len()<=10000 && (1..=1000).contains(&maximum),"invalid Litecoin candidate limits");
+        let result=self.candidates_inner(chain,script,maximum,minimum_confirmations).await;
+        if result.is_err() {self.usable=false;}result
+    }
+    async fn candidates_inner(&mut self,chain:&HeaderSequence,script:&Script,maximum:usize,
+        minimum_confirmations:u64)->Result<Vec<IncludedCandidate>> {
+        let reports=self.reported_unspent(script,maximum).await?;
+        let mut transactions:BTreeMap<Txid,Arc<IncludedTransaction>>=BTreeMap::new();
+        let mut candidates=Vec::new();let mut effects=0usize;
+        for report in reports {
+            if report.height()==0 {continue;}
+            ensure!(report.height()<=chain.height(),"Litecoin candidate height exceeds selected chain");
+            let txid=report.outpoint().txid;
+            let transaction=if let Some(existing)=transactions.get(&txid) {
+                ensure!(existing.height()==report.height(),"inconsistent Litecoin candidate heights");existing.clone()
+            } else {
+                let included=self.transaction_on(chain,report.height(),txid).await?;
+                effects=effects.checked_add(included.inputs().len()).and_then(|n|n.checked_add(included.outputs().len()))
+                    .context("Litecoin candidate effect overflow")?;
+                ensure!(effects<=100000,"Litecoin candidate effect budget exceeded");
+                let included=Arc::new(included);transactions.insert(txid,included.clone());included
+            };
+            let output=transaction.outputs().get(report.outpoint().vout as usize).context("missing Litecoin candidate output")?;
+            ensure!(output.value==report.value() && output.script_pubkey.as_script()==script,"Litecoin candidate output mismatch");
+            let depth=transaction.confirmations_on(chain).context("orphaned Litecoin candidate")?;
+            if depth<minimum_confirmations || (transaction.is_coinbase() && depth<100) {continue;}
+            candidates.push(IncludedCandidate {report,transaction});
+        }
+        Ok(candidates)
+    }
+}
