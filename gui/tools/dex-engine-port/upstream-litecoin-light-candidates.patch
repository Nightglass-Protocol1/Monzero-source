+use super::*;
+use crate::litecoin_light::session::tests::{server,reply,regtest_handshake};
+use bitcoin::hex::FromHex;
+fn fixture()->Result<(HeaderSequence,Value,bitcoin::ScriptBuf)> {
+    let fixture:Value=serde_json::from_str(include_str!("../../wallet/fixture.json"))?;
+    let block=fixture["blocks"][0].clone();let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    chain.append(&Vec::from_hex(block["header"].as_str().unwrap())?,2_000_000_000)?;
+    let tx:Transaction=deserialize(&Vec::from_hex(block["transaction"].as_str().unwrap())?)?;
+    Ok((chain,block,tx.output[0].script_pubkey.clone()))
+}
+#[tokio::test]
+async fn candidates_match_real_inclusion_and_filter_depth()->Result<()> {
+    for minimum in [1,2] {
+        let (chain,block,script)=fixture()?;let mut responses=regtest_handshake();
+        responses.push(reply(3,json!([{"tx_hash":block["txid"],"tx_pos":0,"height":1,"value":100000}])));
+        responses.push(reply(4,block["transaction"].clone()));responses.push(reply(5,json!({"block_height":1,"pos":0,"merkle":[]})));
+        let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        let candidates=session.included_unspent_candidates(&chain,&script,2,minimum).await?;
+        assert_eq!(candidates.len(),if minimum==1 {1}else{0});
+        if let Some(candidate)=candidates.first() {
+            assert_eq!(candidate.value().to_sat(),100000);assert_eq!(candidate.outpoint().vout,0);
+            assert_eq!(candidate.transaction().confirmations_on(&chain),Some(1));
+        }
+        drop(session);assert_eq!(task.await?.len(),5);
+    }Ok(())
+}
+#[tokio::test]
+async fn candidates_reject_value_index_and_script_substitution()->Result<()> {
+    for mode in 0..3 {
+        let (chain,block,mut script)=fixture()?;let mut responses=regtest_handshake();
+        if mode==2 {script=bitcoin::ScriptBuf::from_bytes(vec![0x51]);}
+        responses.push(reply(3,json!([{"tx_hash":block["txid"],"tx_pos":if mode==1 {1}else{0},"height":1,"value":if mode==0 {99999}else{100000}}])));
+        responses.push(reply(4,block["transaction"].clone()));responses.push(reply(5,json!({"block_height":1,"pos":0,"merkle":[]})));
+        let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        assert!(session.included_unspent_candidates(&chain,&script,2,1).await.is_err());assert!(!session.usable);
+        drop(session);assert_eq!(task.await?.len(),5);
+    }Ok(())
+}
+#[tokio::test]
+async fn mempool_candidates_do_not_trigger_inclusion_queries()->Result<()> {
+    let (chain,block,script)=fixture()?;let mut responses=regtest_handshake();
+    responses.push(reply(3,json!([{"tx_hash":block["txid"],"tx_pos":0,"height":0,"value":100000}])));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    assert!(session.included_unspent_candidates(&chain,&script,2,1).await?.is_empty());
+    drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
