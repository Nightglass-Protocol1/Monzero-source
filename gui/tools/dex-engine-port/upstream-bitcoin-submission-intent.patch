+++ b/swap-machine/src/native_execution_claim/checkpoint/submission.rs
@@ -0,0 +1,116 @@
+//! Exact Bitcoin lock submission intent. No RPC, signature validation, broadcast
+//! authority or acceptance receipt. Never infer rejection from a missing receipt.
+use super::*;
+
+const SUBMISSION_DOMAIN: &[u8] = b"monzero-native-bitcoin-submission-v1\0";
+
+/// Retained transaction bytes, not proof of script validity or chain acceptance.
+pub struct RecordedBitcoinSubmission {
+    transaction: bitcoin::Transaction,
+}
+
+impl RecordedBitcoinSubmission {
+    pub fn transaction(&self) -> &bitcoin::Transaction { &self.transaction }
+}
+
+fn check_transaction(expected: &bitcoin::Transaction, transaction: &bitcoin::Transaction) -> Result<()> {
+    ensure!(!transaction.input.is_empty() && transaction.input.iter()
+        .all(|input|input.script_sig.is_empty() && !input.witness.is_empty()),
+        "Bitcoin submission requires native witness inputs");
+    let mut unsigned=transaction.clone();
+    for input in &mut unsigned.input {input.witness.clear();}
+    ensure!(&unsigned==expected,"Bitcoin submission differs from negotiated lock");
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn read_record(directory: &std::fs::File, store: &CheckpointPinStore,
+    quote: &crate::native_trade_quote::RecordedQuote, suffix: &str, domain: &[u8]) -> Result<Zeroizing<Vec<u8>>> {
+    store.separate_from(directory)?;
+    let name=format!("{}.{suffix}",filename(quote)?);
+    let pin_bytes=read_private(&store.directory,&format!("{name}.pin"))?;
+    let pin=decode_pin(&pin_bytes,quote.terms()["swapId"].parse()?,quote.commitment())?;
+    let bytes=read_pinned(directory,&name,&pin)?;
+    ensure!(bytes.len()>domain.len()+32 && bytes.starts_with(domain)
+        && &bytes[domain.len()..domain.len()+32]==quote.commitment(),
+        "Bitcoin submission checkpoint envelope mismatch");
+    Ok(bytes)
+}
+
+impl ExecutionClaim {
+    /// Require the persisted pre-lock state and preserve exact wallet-produced
+    /// bytes before the caller submits. Does not validate witness signatures.
+    #[cfg(target_os = "linux")]
+    pub fn prepare_bitcoin_submission(&self, store: &CheckpointPinStore,
+        transaction: &bitcoin::Transaction) -> Result<PreparedCheckpoint<'_>> {
+        let quote=self.checkpoint_quote.as_ref().context("missing checkpoint quote")?;
+        let bytes=read_record(&self.directory,store,quote,"bitcoin-lock",LOCK_DOMAIN)?;
+        let state:crate::bob::State3=serde_json::from_slice(&bytes[LOCK_DOMAIN.len()+32..])
+            .map_err(|_|anyhow::anyhow!("invalid pre-lock checkpoint"))?;
+        state.check_recorded_quote(quote)?;
+        ensure!(transaction.compute_txid()==state.tx_lock.txid(),"Bitcoin submission lock identity mismatch");
+        let psbt:bitcoin::psbt::Psbt=state.tx_lock.into();
+        check_transaction(&psbt.unsigned_tx,transaction)?;
+        self.prepare_record(SUBMISSION_DOMAIN,format!("{}.bitcoin-submission",filename(quote)?),
+            Zeroizing::new(bitcoin::consensus::serialize(transaction)))
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn prepare_bitcoin_submission(&self, _: &CheckpointPinStore,
+        _: &bitcoin::Transaction) -> Result<PreparedCheckpoint<'_>> {
+        anyhow::bail!("Bitcoin submission storage is not implemented on this platform")
+    }
+}
+
+impl RecoveryLease {
+    /// Restore intended bytes while owning recovery. Reconcile with the chain
+    /// before any decision; a stored intent does not authorize resubmission.
+    #[cfg(target_os = "linux")]
+    pub fn load_bitcoin_submission(&self, store: &CheckpointPinStore, expected_lock: bitcoin::Txid)
+        -> Result<RecordedBitcoinSubmission> {
+        let state=self.load_bitcoin_lock(store,expected_lock)?;
+        let bytes=read_record(&self.directory,store,self.record.quote(),"bitcoin-submission",SUBMISSION_DOMAIN)?;
+        let transaction:bitcoin::Transaction=bitcoin::consensus::deserialize(&bytes[SUBMISSION_DOMAIN.len()+32..])
+            .map_err(|_|anyhow::anyhow!("invalid Bitcoin submission transaction"))?;
+        ensure!(transaction.compute_txid()==expected_lock,"retained Bitcoin submission lock identity mismatch");
+        let psbt:bitcoin::psbt::Psbt=state.tx_lock.into();
+        check_transaction(&psbt.unsigned_tx,&transaction)?;
+        Ok(RecordedBitcoinSubmission {transaction})
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn load_bitcoin_submission(&self, _: &CheckpointPinStore, _: bitcoin::Txid)
+        -> Result<RecordedBitcoinSubmission> {
+        anyhow::bail!("Bitcoin submission recovery is not implemented on this platform")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn submission_preserves_every_non_witness_field() -> Result<()> {
+        let unsigned=bitcoin::Transaction {
+            version:bitcoin::transaction::Version::TWO,lock_time:bitcoin::absolute::LockTime::ZERO,
+            input:vec![bitcoin::TxIn {previous_output:bitcoin::OutPoint::null(),
+                script_sig:bitcoin::ScriptBuf::new(),sequence:bitcoin::Sequence::MAX,witness:bitcoin::Witness::new()}],
+            output:vec![bitcoin::TxOut {value:bitcoin::Amount::from_sat(42),script_pubkey:bitcoin::ScriptBuf::new()}],
+        };
+        assert!(check_transaction(&unsigned,&unsigned).is_err());
+        let mut signed=unsigned.clone();signed.input[0].witness.push([1]);
+        // Synthetic witness tests structural binding only, NOT script validity.
+        check_transaction(&unsigned,&signed)?;
+        for field in 0..5 {
+            let mut changed=signed.clone();
+            match field {
+                0=>changed.output[0].value=bitcoin::Amount::from_sat(43),
+                1=>changed.input[0].previous_output.vout=1,
+                2=>changed.input[0].sequence=bitcoin::Sequence::ZERO,
+                3=>changed.lock_time=bitcoin::absolute::LockTime::from_consensus(1),
+                _=>changed.version=bitcoin::transaction::Version::ONE,
+            }
+            assert!(check_transaction(&unsigned,&changed).is_err());
+        }
+        Ok(())
+    }
+}
