+#[cfg(target_os="linux")]
+fn selected_with_outgoing(setup: &Setup, directory: &PrivateStore, index: usize)
+    -> Result<(super::super::local_keys::peer::RetainedPeer,super::super::local_keys::peer::OutgoingPrivateView,[u8;32])> {
+    use super::super::local_keys::RetainedLocalKeys;
+    let role = if index == 0 {Role::BchFunder} else {Role::NativeFunder};
+    let local = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,role,
+        bitcoin::secp256k1::SecretKey::from_slice(&[3+index as u8;32])?,setup.spend[index],setup.view[index],
+        &setup.frames[index],&setup.signatures[index])?;
+    let pin = *local.commitment();
+    let selected = local.select_peer(&directory.0,&setup.quote,&setup.policy,1001,
+        &setup.frames[1-index],&setup.signatures[1-index])?;
+    let signature = SigningKey::from_bytes(&[1+index as u8;32])
+        .sign(&selected.view_signing_bytes(&setup.quote,&setup.policy,1002)?).to_bytes();
+    let outgoing = selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,&signature)?;
+    Ok((selected,outgoing,pin))
+}
