+//! Durable admission of the peer's private view. Reconstructs the exact wallet
+//! for acknowledgement; does not establish mutual agreement or funding rights.
+use super::*;
+
+const SCHEMA: &str = "monzero-bch-received-private-view-v1";
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReceivedView {
+    schema: String, selection: [u8;32], outgoing: [u8;32], peer: SignedFrame,
+}
+
+impl RetainedPeer {
+    /// Revalidate the exact stored outgoing message and incoming signed view,
+    /// then publish a write-once receipt before exposing the derived wallet.
+    /// The returned digest must be independently pinned before acknowledging.
+    pub fn retain_received_view(&self, directory: &Path, quote: &VerifiedBchQuote,
+        policy: &Policy, now: u64, outgoing: &[u8;32], frame: &[u8], signature: &[u8])
+        -> Result<(OwnedNativeWallet,[u8;32])> {
+        let journal = Journal::open(directory)?;
+        let own = self.read_signed_view(&journal,quote,policy,outgoing)?;
+        let wallet = self.finish(quote,policy,now,&own,frame,signature)?;
+        let state = ReceivedView {schema:SCHEMA.into(),selection:self.commitment,outgoing:*outgoing,
+            peer:SignedFrame {bytes:frame.to_vec(),signature:signature.to_vec(),admitted_at:now}};
+        let bytes = Zeroizing::new(serde_json::to_vec(&state)?);
+        let digest = commitment(SCHEMA,&bytes)?;
+        journal.retain(&record_name(quote,self.local.state.role,"received-view"),&bytes)?;
+        Ok((wallet,digest))
+    }
+
+    /// Historical replay is for wallet recovery, not renewed quote validity.
+    /// Verify the independently pinned receipt, every predecessor and both view
+    /// signatures. Missing/corrupt predecessors never select a replacement.
+    pub fn restore_received_view(&self, directory: &Path, quote: &VerifiedBchQuote,
+        policy: &Policy, expected: &[u8;32]) -> Result<OwnedNativeWallet> {
+        let journal = Journal::open(directory)?;
+        let bytes = Zeroizing::new(journal.read(&record_name(quote,self.local.state.role,"received-view"))?);
+        ensure!(&commitment(SCHEMA,&bytes)? == expected,"BCH received view digest mismatch");
+        let state: ReceivedView = serde_json::from_slice(&bytes)
+            .map_err(|_|anyhow::anyhow!("invalid BCH received view encoding"))?;
+        ensure!(state.schema == SCHEMA && state.selection == self.commitment
+            && Zeroizing::new(serde_json::to_vec(&state)?).as_slice() == bytes.as_slice(),
+            "BCH received view admission mismatch");
+        let own = self.read_signed_view(&journal,quote,policy,&state.outgoing)?;
+        self.finish(quote,policy,state.peer.admitted_at,&own,&state.peer.bytes,&state.peer.signature)
+    }
+}
