+#[cfg(target_os="linux")]
+#[test]
+fn received_views_reject_equivocation_and_missing_predecessors() -> Result<()> {
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let (b,bv,_) = selected_with_outgoing(&setup,&directory,0)?;
+    let (_n,nv,_) = selected_with_outgoing(&setup,&directory,1)?;
+    let accept = |now,frame: &[u8],signature: &[u8]| b.retain_received_view(&directory.0,&setup.quote,
+        &setup.policy,now,bv.commitment(),frame,signature);
+    assert!(accept(1001,nv.frame(),nv.signature()).is_err());
+    assert!(accept(2000,nv.frame(),nv.signature()).is_err());
+    assert!(accept(1003,nv.frame(),bv.signature()).is_err());
+    let (_,pin) = accept(1003,nv.frame(),nv.signature())?;
+    let original = b.restore_received_view(&directory.0,&setup.quote,&setup.policy,&pin)?.acknowledgement(&setup.quote)?;
+    // The selected peer signs a different, valid view share for the same pair.
+    let mut changed: ViewFrame = serde_json::from_slice(nv.frame())?;
+    changed.view_share = monero::PrivateViewKey::new_random(&mut rand::thread_rng()).0.as_bytes();
+    let changed = encode(&changed)?; let signature = sign(&changed,Role::NativeFunder,true);
+    assert!(accept(1003,&changed,&signature).is_err());
+    assert_eq!(b.restore_received_view(&directory.0,&setup.quote,&setup.policy,&pin)?.acknowledgement(&setup.quote)?,original);
+    let mut wrong = pin; wrong[0] ^= 1;
+    assert!(b.restore_received_view(&directory.0,&setup.quote,&setup.policy,&wrong).is_err());
+    let receipt = std::fs::read_dir(&directory.0)?.map(|e|e.unwrap().path())
+        .find(|p|p.file_name().unwrap().to_string_lossy().contains("received-view")).unwrap();
+    let original_bytes = zeroize::Zeroizing::new(std::fs::read(&receipt)?);
+    std::fs::write(&receipt,b"{")?;
+    assert!(b.restore_received_view(&directory.0,&setup.quote,&setup.policy,&pin).is_err());
+    assert!(accept(1003,nv.frame(),nv.signature()).is_err());
+    std::fs::write(&receipt,&*original_bytes)?;
+    let outgoing = std::fs::read_dir(&directory.0)?.map(|e|e.unwrap().path())
+        .find(|p|p.file_name().unwrap().to_string_lossy().ends_with("outgoing-view-bch-funder")).unwrap();
+    std::fs::remove_file(outgoing)?;
+    assert!(b.restore_received_view(&directory.0,&setup.quote,&setup.policy,&pin).is_err());
+    assert!(accept(1003,nv.frame(),nv.signature()).is_err());
+    Ok(())
+}
