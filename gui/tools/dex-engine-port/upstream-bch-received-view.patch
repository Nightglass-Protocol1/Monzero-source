+#[cfg(target_os="linux")]
+#[test]
+fn received_views_restore_exact_wallet_before_acknowledgement() -> Result<()> {
+    use super::super::local_keys::{RetainedLocalKeys,peer::RetainedPeer};
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let (b,bv,bpin) = selected_with_outgoing(&setup,&directory,0)?;
+    let (n,nv,npin) = selected_with_outgoing(&setup,&directory,1)?;
+    let mut receipts = Vec::new();
+    for (selected,own,peer) in [(&b,&bv,&nv),(&n,&nv,&bv)] {
+        let (wallet,pin) = selected.retain_received_view(&directory.0,&setup.quote,&setup.policy,1003,
+            own.commitment(),peer.frame(),peer.signature())?;
+        assert_eq!(selected.retain_received_view(&directory.0,&setup.quote,&setup.policy,1003,
+            own.commitment(),peer.frame(),peer.signature())?.1,pin);
+        receipts.push((pin,wallet.acknowledgement(&setup.quote)?));
+    }
+    assert_eq!(receipts[0].1,receipts[1].1);
+    let selections = [*b.commitment(),*n.commitment()];
+    drop(b); drop(n); drop(bv); drop(nv);
+    for (index,role,local_pin) in [(0,Role::BchFunder,bpin),(1,Role::NativeFunder,npin)] {
+        let local = RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,role,&local_pin)?;
+        let selected = RetainedPeer::restore(&directory.0,&setup.quote,&setup.policy,local,&selections[index])?;
+        let wallet = selected.restore_received_view(&directory.0,&setup.quote,&setup.policy,&receipts[index].0)?;
+        let ack = wallet.acknowledgement(&setup.quote)?;
+        assert_eq!(ack,receipts[index].1);
+        assert!(selected.restore_received_view(&directory.0,&setup.quote,&setup.policy,&receipts[index].0)?
+            .accept_agreement(&setup.quote,&setup.policy,2000,&ack,&ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder)).is_err());
+        let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+        agreement::storage::persist(&directory.0,&setup.quote,&setup.policy,role,&agreed)?;
+    }
+    Ok(())
+}
