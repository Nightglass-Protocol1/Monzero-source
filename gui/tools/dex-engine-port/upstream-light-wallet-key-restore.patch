diff --git a/swap-machine/src/bin/native-ltc-light/recovery.rs b/swap-machine/src/bin/native-ltc-light/recovery.rs
--- a/swap-machine/src/bin/native-ltc-light/recovery.rs
+++ b/swap-machine/src/bin/native-ltc-light/recovery.rs
@@ -69,3 +69,50 @@
     std::io::stdout().write_all(&output)?;
     Ok(())
 }
+
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct RestoreRequest {
+    schema: String,
+    request_id: uuid::Uuid,
+    approved_config_digest: String,
+    restore_approved: bool,
+    password: Password,
+    seed_encoding: String,
+    seed_hex: Password,
+}
+
+/// Restore only the missing vault for the account already pinned in the local
+/// configuration. Address allocations, backups and trade journals are untouched.
+pub(super) fn restore(path: &Path) -> Result<()> {
+    let mut input = Zeroizing::new(Vec::with_capacity(8193));
+    std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len() <= 8192, "invalid recovery restore request size");
+    let request: RestoreRequest = serde_json::from_slice(&input)?;
+    let tag = ["ltc", "btc", "bch", "doge"].into_iter()
+        .find(|tag| request.schema == format!("monzero-{tag}-light-wallet-key-restore-request-v1"))
+        .context("invalid recovery restore schema")?;
+    ensure!(!request.request_id.is_nil() && request.restore_approved, "missing recovery restore approval");
+    ensure!(request.seed_encoding == RecoverySeed::ENCODING, "unsupported recovery seed format");
+    let (_lease, raw) = private_config(path)?;
+    let approved: sha256::Hash = request.approved_config_digest.parse()?;
+    ensure!(approved.to_string() == request.approved_config_digest && sha256::Hash::hash(&raw) == approved,
+        "recovery configuration differs from approval");
+    let config: Config = serde_json::from_slice(&raw)?;
+    ensure!(config.schema == format!("monzero-private-{tag}-light-v1"), "wrong recovery chain");
+    let network = network_for(tag, &config.network)?;
+    let wallet = config.wallet.as_ref().context("missing recovery wallet")?;
+    let public = PublicAccount::from_descriptor(&wallet.account, network)?;
+    let vault_config = wallet.vault.as_ref().context("missing recovery vault")?;
+    let seed = RecoverySeed::from_hex(&request.seed_hex.0)?;
+    let vault = seed.restore_vault(&vault_config.directory, network, vault_config.wallet_id,
+        request.password.0.as_bytes(), &wallet.account)?;
+    drop(vault.unlock_for_account(request.password.0.as_bytes(), &wallet.account)?);
+    let response = json!({"schema":format!("monzero-{tag}-light-wallet-key-restore-response-v1"),
+        "requestId":request.request_id,"coin":tag,"network":config.network,
+        "walletId":vault_config.wallet_id,"account":public.account_index(),
+        "restored":true,"activeSwapRecovery":false,"addressRecordsRestored":false});
+    std::io::stdout().write_all(&serde_json::to_vec(&response)?)?;
+    Ok(())
+}
