+    /// Restore a missing encrypted vault for a previously saved public account.
+    /// This does not create/reset address allocations or recover trade records.
+    /// Existing ciphertext is never replaced. Identical retries authenticate the
+    /// existing vault with the supplied password and preserve its exact bytes.
+    pub fn restore_vault(
+        &self,
+        directory: &Path,
+        network: impl Into<LightNetwork>,
+        wallet: Uuid,
+        password: &[u8],
+        expected: &PublicAccountDescriptor,
+    ) -> Result<SeedVault> {
+        let network = network.into();
+        ensure!(!wallet.is_nil(), "missing recovery wallet identity");
+        ensure!(!password.is_empty() && password.len() <= 1024, "invalid recovery password length");
+        let expected_account = PublicAccount::from_descriptor(expected, network)?;
+        let actual = self.public_account(network, expected_account.account_index())?;
+        ensure!(serde_json::to_vec(&actual.descriptor())? == serde_json::to_vec(expected)?,
+            "recovery seed does not match saved public account");
+        let journal = Journal::open(directory)?;
+        let bytes = match journal.read(NAME) {
+            Ok(bytes) => {
+                let existing = unlock(&bytes, password, network, wallet)?;
+                ensure!(*existing.0 == *self.0, "existing vault has different recovery material");
+                bytes
+            }
+            Err(error) if error.downcast_ref::<std::io::Error>()
+                .is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => {
+                let seed = SecretSeed::from_bytes(Zeroizing::new(*self.0));
+                seal_random(&seed, password, network, wallet)?
+            }
+            Err(error) => return Err(error),
+        };
+        journal.retain(NAME, &bytes)?;
+        Ok(SeedVault { journal, network, wallet, bytes, usable: true })
+    }
+
 }
 
