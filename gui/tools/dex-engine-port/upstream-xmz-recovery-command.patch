+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct RecoveryCommand {
+    schema: String,
+    request_id: String,
+    genesis: String,
+    wallet: String,
+    lock_txid: String,
+    txid: String,
+    minimum_confirmations: String,
+}
+
+impl RecoveryCommand {
+    fn decode(bytes: &[u8], genesis: &str) -> Result<Self> {
+        ensure!(bytes.len() <= 2048, "oversized recovery command");
+        let request: Self = serde_json::from_slice(bytes)?;
+        let id = uuid::Uuid::parse_str(&request.request_id)?;
+        ensure!(!id.is_nil() && id.to_string() == request.request_id
+            && request.schema == "monzero-native-recovery-request-v1"
+            && canonical_hash(genesis) && request.genesis == genesis
+            && canonical_hash(&request.lock_txid) && canonical_hash(&request.txid),
+            "invalid recovery command identity");
+        let minimum: u64 = request.minimum_confirmations.parse()?;
+        ensure!(minimum > 0 && minimum.to_string() == request.minimum_confirmations,
+            "invalid recovery confirmation policy");
+        Ok(request)
+    }
+}
+
+/// Directory and genesis are launcher-owned configuration, not request authority.
+/// Caller must bound the entire operation with a deadline and own the RPC service.
+pub async fn execute_recovery(client: &NativeFundingRpc, directory: &Path,
+    network: swap_core::xmz_address::XmzNetwork, genesis: &str, bytes: &[u8]) -> Result<Value> {
+    let request = RecoveryCommand::decode(bytes, genesis)?;
+    let wallet = XmzAddress::parse(network, &request.wallet)?;
+    let record = RecoveryRecord::load(directory, genesis, wallet, &request.lock_txid)?;
+    ensure!(record.txid() == request.txid, "unexpected prepared recovery transaction");
+    let confirmed = record.reconcile(client, request.minimum_confirmations.parse()?).await?;
+    Ok(json!({"schema":"monzero-native-recovery-v1", "requestId":request.request_id,
+        "source":"local-wallet-reconciliation", "status":"confirmed", "genesis":genesis,
+        "wallet":request.wallet, "lockTxid":request.lock_txid, "txid":confirmed.txid,
+        "confirmations":confirmed.confirmations.to_string(), "retryAllowed":false, "executable":false}))
+}
+
