+#[test]
+fn vault_backup_restore_authenticates_before_publication_and_binds_account()->Result<()> {
+    let original=Directory::new()?;let restored=Directory::new()?;let (seed,_,password,wallet)=fixture();
+    let vault=SeedVault::create(&original.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+    let backup=vault.encrypted_backup(&password)?;assert!(vault.encrypted_backup(b"wrong").is_err());
+    assert!(SeedVault::restore_encrypted(&restored.0,LtcNetwork::Regtest,wallet,b"wrong",&backup).is_err());
+    assert!(!restored.0.join(NAME).exists());
+    let mut bad=backup.clone();bad[LENGTH-1]^=1;
+    assert!(SeedVault::restore_encrypted(&restored.0,LtcNetwork::Regtest,wallet,&password,&bad).is_err());
+    assert!(!restored.0.join(NAME).exists());
+    let recovered=SeedVault::restore_encrypted(&restored.0,LtcNetwork::Regtest,wallet,&password,&backup)?;
+    let descriptor=seed.public_account(LtcNetwork::Regtest,7)?.descriptor();
+    assert_eq!(*recovered.unlock_for_account(&password,&descriptor)?.0,*seed.0);
+    let other=SecretSeed::from_bytes(Zeroizing::new([42;32])).public_account(LtcNetwork::Regtest,7)?.descriptor();
+    assert!(recovered.unlock_for_account(&password,&other).is_err());
+    drop(recovered);
+    let retry=SeedVault::restore_encrypted(&restored.0,LtcNetwork::Regtest,wallet,&password,&backup)?;
+    assert_eq!(retry.encrypted_backup(&password)?,backup);Ok(())
+}
+#[test]
+fn vault_password_change_preserves_seed_and_old_backup_without_overwriting_restore()->Result<()> {
+    let dir=Directory::new()?;let (seed,_,password,wallet)=fixture();
+    let mut vault=SeedVault::create(&dir.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+    let before=vault.encrypted_backup(&password)?;
+    assert!(vault.change_password(b"wrong",b"new password").is_err());
+    assert!(vault.change_password(&password,b"").is_err());assert_eq!(vault.encrypted_backup(&password)?,before);
+    vault.change_password(&password,b"new password")?;
+    assert!(vault.unlock(&password).is_err());assert_eq!(*vault.unlock(b"new password")?.0,*seed.0);
+    let after=vault.encrypted_backup(b"new password")?;assert_ne!(before,after);drop(vault);
+    let reopened=SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet)?;
+    assert_eq!(*reopened.unlock(b"new password")?.0,*seed.0);drop(reopened);
+    assert!(SeedVault::restore_encrypted(&dir.0,LtcNetwork::Regtest,wallet,&password,&before).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,after);
+    let backup_dir=Directory::new()?;
+    let old=SeedVault::restore_encrypted(&backup_dir.0,LtcNetwork::Regtest,wallet,&password,&before)?;
+    assert_eq!(*old.unlock(&password)?.0,*seed.0);Ok(())
+}
+#[test]
+fn vault_uncertain_password_publication_requires_reopen()->Result<()> {
+    for published in [false,true] {
+        let dir=Directory::new()?;let (seed,_,password,wallet)=fixture();
+        let mut vault=SeedVault::create(&dir.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+        assert!(vault.change_password_with(&password,b"new password",|journal,before,after| {
+            if published {journal.replace_record(NAME,before,after)?;}
+            anyhow::bail!("injected publication outcome failure")
+        }).is_err());
+        assert!(vault.unlock(&password).is_err());assert!(vault.unlock(b"new password").is_err());
+        assert!(vault.encrypted_backup(&password).is_err());drop(vault);
+        let recovered=SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet)?;
+        let working=if published {b"new password".as_slice()}else{password.as_slice()};
+        assert_eq!(*recovered.unlock(working)?.0,*seed.0);
+    }
+    Ok(())
+}
