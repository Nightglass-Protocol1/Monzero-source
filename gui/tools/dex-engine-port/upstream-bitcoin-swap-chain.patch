+#[tokio::test]
+async fn one_honest_server_exposes_a_spend_another_hides()->Result<()> {
+    let trade=trade(4);
+    let hiding=Faults {hide_spends:true,..Faults::default()};
+    trade.world.lock().unwrap().mempool.push(trade.cancel.clone());
+    assert!(trade.verify(&trade.chain([hiding,Faults::default()])).await.is_err());
+    assert!(trade.verify(&trade.chain([Faults::default(),hiding])).await.is_err());
+    // Two colluding servers can hide a spend: the documented residual risk,
+    // bounded by releasing only before the cancel timelock.
+    assert!(trade.verify(&trade.chain([hiding,hiding])).await.is_ok());
+    Ok(())
+}
