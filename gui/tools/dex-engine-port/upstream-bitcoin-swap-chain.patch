+//! Chain observations and transport the XMZ seller needs to redeem a lock.
+//! `LitecoinRpc` (a caller-owned full node) is the only implementation today;
+//! a light-wallet implementation must meet the same contracts
+//! (see tools/dex-engine-port/SELLER_LIGHT_REDEEM.md).
+use super::{LitecoinRpc,VerifiedLiveLock,confirmed::ConfirmedTransaction};
+use anyhow::Result;
+use bitcoin::{Amount,BlockHash,OutPoint,ScriptBuf,Transaction,Txid};
+use std::future::Future;
+use swap_core::litecoin_address::LtcNetwork;
+
+pub trait RedeemChain: Sync {
+    fn network(&self)->LtcNetwork;
+    /// Lock unspent (pending spends included), agreed script and amount, deep
+    /// enough, and at least `safety_blocks` before cancellation is possible.
+    fn verify_live_lock(&self,outpoint:OutPoint,script:&ScriptBuf,amount:Amount,
+        confirmations:u64,cancel_blocks:u32,safety_blocks:u32)->impl Future<Output=Result<VerifiedLiveLock>>+Send;
+    /// The completed redemption would be accepted now; nothing is sent.
+    fn preflight_contract_spend(&self,transaction:&Transaction)->impl Future<Output=Result<()>>+Send;
+    /// Send the exact bytes. False means the outcome is uncertain, never refused.
+    fn dispatch_contract_spend(&self,transaction:&Transaction)->impl Future<Output=bool>+Send;
+    /// Read-only reconciliation; absence grants no send authority.
+    fn contract_spend_in_mempool(&self,transaction:&Transaction)->impl Future<Output=Result<bool>>+Send;
+    fn confirmed_transaction(&self,txid:Txid,block:BlockHash,minimum:u64)
+        ->impl Future<Output=Result<ConfirmedTransaction>>+Send;
+    fn indexed_confirmed_transaction(&self,txid:Txid,minimum:u64)
+        ->impl Future<Output=Result<ConfirmedTransaction>>+Send;
+}
+
+impl RedeemChain for LitecoinRpc {
+    fn network(&self)->LtcNetwork {LitecoinRpc::network(self)}
+    fn verify_live_lock(&self,outpoint:OutPoint,script:&ScriptBuf,amount:Amount,
+        confirmations:u64,cancel_blocks:u32,safety_blocks:u32)->impl Future<Output=Result<VerifiedLiveLock>>+Send {
+        LitecoinRpc::verify_live_lock(self,outpoint,script,amount,confirmations,cancel_blocks,safety_blocks)
+    }
+    fn preflight_contract_spend(&self,transaction:&Transaction)->impl Future<Output=Result<()>>+Send {
+        LitecoinRpc::preflight_contract_spend(self,transaction)
+    }
+    fn dispatch_contract_spend(&self,transaction:&Transaction)->impl Future<Output=bool>+Send {
+        LitecoinRpc::dispatch_contract_spend(self,transaction)
+    }
+    fn contract_spend_in_mempool(&self,transaction:&Transaction)->impl Future<Output=Result<bool>>+Send {
+        LitecoinRpc::contract_spend_in_mempool(self,transaction)
+    }
+    fn confirmed_transaction(&self,txid:Txid,block:BlockHash,minimum:u64)
+        ->impl Future<Output=Result<ConfirmedTransaction>>+Send {
+        LitecoinRpc::confirmed_transaction(self,txid,block,minimum)
+    }
+    fn indexed_confirmed_transaction(&self,txid:Txid,minimum:u64)
+        ->impl Future<Output=Result<ConfirmedTransaction>>+Send {
+        LitecoinRpc::indexed_confirmed_transaction(self,txid,minimum)
+    }
+}
+
+pub mod light_rules;
+pub mod light;
