index 000000000..872c2cdc5
--- /dev/null
+++ b/swap-machine/src/litecoin_light/headers/tests/signet.rs
@@ -0,0 +1,114 @@
+//! Bitcoin signet header rules: identity, the non-power-of-two proof-of-work
+//! limit, no minimum-difficulty exception, and an ignored full-chain check
+//! against headers exported from a synced Bitcoin Core.
+use super::*;
+use crate::litecoin_light::network::BtcNetwork;
+
+const SIGNET: LightNetwork = LightNetwork::Bitcoin(BtcNetwork::Signet);
+
+fn header(bits: u32, time: u32) -> Header {
+    Header { version: Version::from_consensus(0x20000000), prev_blockhash: BlockHash::all_zeros(),
+        merkle_root: bitcoin::TxMerkleNode::all_zeros(), time, bits: CompactTarget::from_consensus(bits), nonce: 0 }
+}
+
+#[test]
+fn signet_genesis_and_identity() -> Result<()> {
+    let chain = HeaderSequence::from_genesis(SIGNET)?;
+    assert_eq!(chain.header(0).unwrap().block_hash().to_string(), SIGNET.genesis());
+    assert_eq!((SIGNET.name(), SIGNET.hrp(), SIGNET.coin_type()), ("signet", "tb", 1));
+    assert_eq!(LightNetwork::from(LtcNetwork::BitcoinSignet), SIGNET);
+    assert_ne!(SIGNET, LightNetwork::Bitcoin(BtcNetwork::Testnet4));
+    assert!(LightNetwork::Litecoin(LtcNetwork::BitcoinSignet).ensure_header_rules().is_err());
+    Ok(())
+}
+
+#[test]
+fn signet_limit_is_its_genesis_target() -> Result<()> {
+    // Bitcoin Core: consensus.powLimit = 00000377ae000000…00, genesis nBits 0x1e0377ae.
+    assert_eq!(compact(&SIGNET.limit()), 0x1e0377ae);
+    assert_eq!(SIGNET.target(0x1e0377ae)?, SIGNET.limit());
+    assert!(SIGNET.target(0x1e0377af).is_err());
+    assert!(SIGNET.target(0x1d00ffff).is_ok());
+    // A slow period cannot ease past the limit.
+    assert_eq!(SIGNET.retarget(0x1e0377ae, 1_209_600 * 4, 1_209_600)?, 0x1e0377ae);
+    Ok(())
+}
+
+#[test]
+fn signet_has_no_minimum_difficulty_exception() -> Result<()> {
+    let bits = 0x1e012345u32;
+    let headers: Vec<Header> = (0..2000u32).map(|i| header(bits, 1_000_000 + i * 600)).collect();
+    // An hour after its parent, testnet would allow the easiest target; signet keeps the period's.
+    let late = headers[1999].time + 3600;
+    assert_eq!(SIGNET.next_bits(&headers, 0, late)?, bits);
+    assert_eq!(LightNetwork::Bitcoin(BtcNetwork::Testnet).next_bits(&headers, 0, late)?, 0x1d00ffff);
+    // At a boundary it retargets like mainnet: a period twice as slow halves the difficulty.
+    let period: Vec<Header> = (0..2016u32).map(|i| header(bits, 1_000_000 + i * 1200)).collect();
+    let expected = SIGNET.retarget(bits, i64::from(period[2015].time - period[0].time), 1_209_600)?;
+    assert_eq!(SIGNET.next_bits(&period, 0, period[2015].time + 600)?, expected);
+    assert!(SIGNET.target(expected)? > SIGNET.target(bits)?);
+    Ok(())
+}
+
+/// Signet blocks 326,593–326,595, the first three after the pinned checkpoint.
+const AFTER_CHECKPOINT: [&str; 3] = [
+    "00000020b453909904d5436e31ecb2a041b2ebf6ca41ec687dec16e596061c7d06000000c2da66d9da33dcbdc61418491d5544e7c748bef1a70f3126bea1f51d98327e4e7dfad16a9b4f151debfdbf01",
+    "000000203d17630835cb40f2512c496eeb37a157d5df6618ce9cef75c512e6a811000000d73fc6317b043dd9d76d4d5409ac9064d295d78284971387ddd645fb216dfb0992fad16a9b4f151db366af06",
+    "00000020ed1b76b748328d6c760276f41d7bfbc67f244b7b34936cc18b5a4748040000005a9aa9f7c675c2a18a4ed1f8e069805d4f99160b86b6e886c12023e448bc45cbb1fdd16a9b4f151d6da48809",
+];
+
+#[test]
+fn signet_starts_at_its_checkpoint_and_validates_real_headers_on_top() -> Result<()> {
+    let mut chain = HeaderSequence::new(SIGNET)?;
+    assert_eq!((chain.height(), chain.root_height()), (326592, 326592));
+    assert_eq!(chain.header(326592).unwrap().block_hash().to_string(),
+        "000000067d1c0696e516ec7d68ec41caf6ebb241a0b2ec316e43d504999053b4");
+    let raw = |hex: &str| -> Vec<u8> { (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i+2], 16).unwrap()).collect() };
+    let now = 1792146865u64;
+    for (offset, header) in AFTER_CHECKPOINT.iter().enumerate() {
+        chain.append(&raw(header), now)?;
+        assert_eq!(chain.height(), 326593 + offset as u32);
+    }
+    // Real SHA256d work is required on top of the checkpoint.
+    let mut forged = HeaderSequence::new(SIGNET)?;
+    let mut bytes = raw(AFTER_CHECKPOINT[0]); bytes[76] ^= 1;
+    assert!(forged.append(&bytes, now).is_err());
+    assert!(chain.adopt(HeaderSequence::from_genesis(SIGNET)?).is_err());
+    Ok(())
+}
+
+/// `MONZERO_BTC_SIGNET_HEADERS`: flat 80-byte headers from height 0, as written by
+/// `tools/dex-engine-port/fetch_ltc_headers.py` against a synced signet node.
+#[test]
+#[ignore = "requires exported Bitcoin signet headers"]
+fn signet_real_headers_validate_from_genesis() -> Result<()> {
+    let path = std::env::var_os("MONZERO_BTC_SIGNET_HEADERS").context("missing MONZERO_BTC_SIGNET_HEADERS")?;
+    let bytes = std::fs::read(path)?;
+    ensure!(bytes.len() % 80 == 0 && bytes.len() >= 80 * 4033, "need at least two difficulty periods");
+    let mut chain = HeaderSequence::from_genesis(SIGNET)?;
+    assert_eq!(bytes[..80], serialize(&chain.header(0).unwrap())[..]);
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    for batch in bytes[80..].chunks(2016 * 80) { chain.append_batch(batch, now)?; }
+    assert_eq!(chain.height() as usize, bytes.len() / 80 - 1);
+    // The real chain has retargeted, so boundary rules were exercised.
+    let changes = (2016..=chain.height()).step_by(2016)
+        .filter(|height| chain.header(*height).unwrap().bits != chain.header(height - 1).unwrap().bits).count();
+    assert!(changes > 0, "no signet retarget in the exported headers");
+    // Real SHA256d work is required: a header with one changed nonce bit is refused.
+    let tip = chain.height();
+    let mut prefix = HeaderSequence::from_genesis(SIGNET)?;
+    for batch in bytes[80..80 * tip as usize].chunks(2016 * 80) { prefix.append_batch(batch, now)?; }
+    let mut forged = serialize(&chain.header(tip).unwrap()); forged[76] ^= 1;
+    assert!(prefix.append(&forged, now).is_err());
+    // The pinned checkpoint, when present, lies on this chain with the same cumulative work.
+    if let Some(root) = SIGNET.checkpoint().map(|checkpoint| checkpoint.height) {
+        let mut rooted = HeaderSequence::new(SIGNET)?;
+        assert_eq!(rooted.header(root).unwrap().block_hash(), chain.header(root).unwrap().block_hash());
+        let mut upto = HeaderSequence::from_genesis(SIGNET)?;
+        for batch in bytes[80..80 * (root as usize + 1)].chunks(2016 * 80) { upto.append_batch(batch, now)?; }
+        assert_eq!(rooted.chain_work(), upto.chain_work());
+        for batch in bytes[80 * (root as usize + 1)..].chunks(2016 * 80) { rooted.append_batch(batch, now)?; }
+        assert_eq!(rooted.height(), chain.height());
+    }
+    Ok(())
+}
