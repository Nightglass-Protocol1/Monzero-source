+    // Lock depth 2: the three-block cancel path is not yet open.
+    assert!(refusal(chain.preflight_contract_spend(&trade.cancel).await).contains("timelock"));
+    trade.world.lock().unwrap().mine(vec![]);
+    chain.preflight_contract_spend(&trade.cancel).await?;
