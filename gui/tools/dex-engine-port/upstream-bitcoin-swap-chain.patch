+//! Bitcoin testnet4 (BIP94) header rules: synthetic difficulty vectors, and an
+//! ignored full-chain check against headers exported from a synced Bitcoin Core.
+use super::*;
+use crate::litecoin_light::network::BtcNetwork;
+
+fn header(bits: u32, time: u32) -> Header {
+    Header { version: Version::from_consensus(0x20000000), prev_blockhash: BlockHash::all_zeros(),
+        merkle_root: bitcoin::TxMerkleNode::all_zeros(), time, bits: CompactTarget::from_consensus(bits), nonce: 0 }
+}
+
+#[test]
+fn testnet4_genesis_and_identity() -> Result<()> {
+    let network = LightNetwork::Bitcoin(BtcNetwork::Testnet4);
+    let chain = HeaderSequence::from_genesis(network)?;
+    assert_eq!(chain.header(0).unwrap().block_hash().to_string(), network.genesis());
+    assert_eq!((network.name(), network.hrp(), network.coin_type()), ("testnet4", "tb", 1));
+    assert_eq!(LightNetwork::from(LtcNetwork::BitcoinTestnet4), network);
+    assert!(LightNetwork::Litecoin(LtcNetwork::BitcoinTestnet4).ensure_header_rules().is_err());
+    Ok(())
+}
+
+#[test]
+fn testnet4_retargets_from_first_block_of_the_period() -> Result<()> {
+    // A full period on schedule whose last block used the minimum-difficulty
+    // exception. BIP94 keeps the period's real difficulty; testnet3 resets it.
+    let (hard, easiest) = (0x1c7fffffu32, 0x1d00ffffu32);
+    let mut headers = vec![header(hard, 1_000_000)];
+    for i in 1..2015u32 { headers.push(header(hard, 1_000_000 + i * 600)); }
+    headers.push(header(easiest, 1_000_000 + 1_209_600));
+    assert_eq!(headers.len(), 2016);
+    let time = 1_000_000 + 1_209_600 + 600;
+    assert_eq!(LightNetwork::Bitcoin(BtcNetwork::Testnet4).next_bits(&headers, 0, time)?, hard);
+    assert_eq!(LightNetwork::Bitcoin(BtcNetwork::Testnet).next_bits(&headers, 0, time)?, easiest);
+    // Inside a period the 20-minute minimum-difficulty exception still applies.
+    let inner = &headers[..2000];
+    assert_eq!(LightNetwork::Bitcoin(BtcNetwork::Testnet4).next_bits(inner, 0, inner[1999].time + 1201)?, easiest);
+    assert_eq!(LightNetwork::Bitcoin(BtcNetwork::Testnet4).next_bits(inner, 0, inner[1999].time + 1200)?, hard);
+    Ok(())
+}
+
