+/// `MONZERO_BTC_TESTNET4_HEADERS`: flat 80-byte headers from height 0, as written by
+/// `tools/dex-engine-port/fetch_ltc_headers.py` against a synced testnet4 node.
+#[test]
+#[ignore = "requires exported Bitcoin testnet4 headers"]
+fn testnet4_real_headers_validate_from_genesis() -> Result<()> {
+    let path = std::env::var_os("MONZERO_BTC_TESTNET4_HEADERS").context("missing MONZERO_BTC_TESTNET4_HEADERS")?;
+    let bytes = std::fs::read(path)?;
+    ensure!(bytes.len() % 80 == 0 && bytes.len() >= 80 * 4033, "need at least two difficulty periods");
+    let network = LightNetwork::Bitcoin(BtcNetwork::Testnet4);
+    let mut chain = HeaderSequence::from_genesis(network)?;
+    assert_eq!(bytes[..80], serialize(&chain.header(0).unwrap())[..]);
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    for batch in bytes[80..].chunks(2016 * 80) { chain.append_batch(batch, now)?; }
+    assert_eq!(chain.height() as usize, bytes.len() / 80 - 1);
+    // BIP94 must matter on the real chain: at some boundary the last block of the
+    // period was minimum difficulty while the real difficulty was retained.
+    let boundaries = (2016..=chain.height()).step_by(2016).filter(|height| {
+        let last = chain.header(height - 1).unwrap().bits; let first = chain.header(height - 2016).unwrap().bits;
+        last != first
+    }).count();
+    assert!(boundaries > 0, "no boundary distinguishes BIP94 from testnet3 rules");
+    // A boundary header may not predate its parent by more than 600 seconds;
+    // the timewarp rule rejects it before proof of work is examined.
+    let boundary = (chain.height() / 2016) * 2016;
+    let mut prefix = HeaderSequence::from_genesis(network)?;
+    for batch in bytes[80..80 * boundary as usize].chunks(2016 * 80) { prefix.append_batch(batch, now)?; }
+    let mut warped = chain.header(boundary).unwrap();
+    warped.time = prefix.header(boundary - 1).unwrap().time - 601;
+    let error = prefix.append(&serialize(&warped), now).unwrap_err().to_string();
+    assert!(error.contains("timewarp") || error.contains("median past"), "{error}");
+    let real = serialize(&chain.header(boundary).unwrap());
+    assert_eq!(prefix.append(&real, now)?, chain.header(boundary).unwrap().block_hash());
+    // The pinned checkpoint lies on this chain and the remaining tail validates on top of it.
+    let mut rooted = HeaderSequence::new(network)?;
+    let root = rooted.root_height();
+    assert_eq!(rooted.header(root).unwrap().block_hash(), chain.header(root).unwrap().block_hash());
+    assert_eq!(rooted.chain_work(), &{ let mut c = HeaderSequence::from_genesis(network)?;
+        for batch in bytes[80..80 * (root as usize + 1)].chunks(2016 * 80) { c.append_batch(batch, now)?; } c.chain_work().clone() });
+    for batch in bytes[80 * (root as usize + 1)..].chunks(2016 * 80) { rooted.append_batch(batch, now)?; }
+    assert_eq!(rooted.height(), chain.height());
+    Ok(())
+}
