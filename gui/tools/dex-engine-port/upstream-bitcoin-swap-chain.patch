+//! A semantic Electrum fake: real headers and merkle proofs over a small regtest
+//! chain, with history and unspent reports derived from the transactions.
+//! Faults model the servers SELLER_LIGHT_REDEEM.md worries about.
+use super::*;
+use crate::litecoin_light::network::LightNetwork;
+use bitcoin::{Sequence,TxIn,TxOut,Witness,block::{Header,Version},consensus::encode::deserialize,
+    hashes::{Hash,sha256d},transaction};
+use serde_json::{Value,json};
+use std::{cell::Cell,sync::{Arc,Mutex as Shared}};
+use tokio::io::{AsyncBufReadExt,AsyncWriteExt,BufReader};
+
+const NETWORK:LtcNetwork=LtcNetwork::BitcoinRegtest;
+const LOCK:Amount=Amount::from_sat(200_000);
+
+thread_local!(static NOW:Cell<u64>=const {Cell::new(0)});
+fn clock()->Result<u64> {Ok(NOW.with(Cell::get))}
+
+struct World {headers:Vec<Header>,blocks:Vec<Vec<Transaction>>,mempool:Vec<Transaction>}
+impl World {
+    fn new()->Self {
+        let genesis=HeaderSequence::from_genesis(NETWORK).unwrap().header(0).unwrap();
+        Self {headers:vec![genesis],blocks:vec![vec![]],mempool:vec![]}
+    }
+    fn height(&self)->u32 {(self.headers.len()-1) as u32}
+    /// Mine the mempool plus `extra` into one block and move the clock to it.
+    fn mine(&mut self,extra:Vec<Transaction>) {
+        let height=self.headers.len() as u32;
+        let coinbase=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+            input:vec![TxIn {script_sig:ScriptBuf::from_bytes([&height.to_le_bytes()[..],&[0;8]].concat()),..TxIn::default()}],
+            output:vec![TxOut {value:Amount::from_sat(50),script_pubkey:ScriptBuf::new_op_return([7;20])}]};
+        let mut txs=vec![coinbase];txs.append(&mut self.mempool);txs.extend(extra);
+        let previous=*self.headers.last().unwrap();
+        let root=merkle(&txs.iter().map(|t|t.compute_txid().to_byte_array()).collect::<Vec<_>>(),0).0;
+        let header=(0u32..).map(|nonce|Header {version:Version::from_consensus(0x2000_0000),prev_blockhash:previous.block_hash(),
+            merkle_root:bitcoin::TxMerkleNode::from_byte_array(root),time:previous.time+600,bits:previous.bits,nonce})
+            .find(|h|h.validate_pow(h.target()).is_ok()).unwrap();
+        self.headers.push(header);self.blocks.push(txs);
+        NOW.with(|now|now.set(u64::from(header.time)+60));
+    }
+    fn mine_empty(&mut self,count:u32) {for _ in 0..count {self.mine(vec![]);}}
+    fn located(&self,txid:Txid)->Option<(u32,usize,&Transaction)> {
+        self.blocks.iter().enumerate().find_map(|(h,txs)|txs.iter().position(|t|t.compute_txid()==txid)
+            .map(|i|(h as u32,i,&txs[i])))
+    }
+}
+
+/// Merkle root of `leaves` and the branch for `index`.
+fn merkle(leaves:&[[u8;32]],mut index:usize)->([u8;32],Vec<[u8;32]>) {
+    let mut level=leaves.to_vec();let mut branch=vec![];
+    while level.len()>1 {
+        if level.len()%2==1 {level.push(*level.last().unwrap());}
+        branch.push(level[index^1]);
+        level=level.chunks(2).map(|pair|sha256d::Hash::hash(&[pair[0],pair[1]].concat()).to_byte_array()).collect();
+        index/=2;
+    }
+    (level[0],branch)
+}
+
+#[derive(Clone,Copy,Default)]
+struct Faults {
+    /// Serve a chain this many blocks short of the real tip.
+    withhold:u32,
+    /// Omit spends: history drops spending transactions, spent outputs stay listed.
+    hide_spends:bool,
+    /// Return transactions with an altered witness.
+    tamper_witness:bool,
+}
+struct FakeServer {world:Arc<Shared<World>>,faults:Faults}
+
+fn hex(bytes:&[u8])->String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+fn raw(bytes:&str)->Vec<u8> {(0..bytes.len()).step_by(2).map(|i|u8::from_str_radix(&bytes[i..i+2],16).unwrap()).collect()}
+
+impl FakeServer {
+    fn answer(&self,method:&str,params:&Value)->Value {
+        let mut world=self.world.lock().unwrap();
+        let visible=world.height()-self.faults.withhold;
+        let hidden:Vec<Transaction>=world.blocks[visible as usize+1..].iter().flat_map(|b|b[1..].to_vec()).collect();
+        let pool:Vec<Transaction>=hidden.into_iter().chain(world.mempool.iter().cloned()).collect();
+        let confirmed=|world:&World|world.blocks[..=visible as usize].iter().enumerate()
+            .flat_map(|(h,b)|b.iter().map(move |t|(h as u32,t.clone()))).collect::<Vec<_>>();
+        let header=|h:u64|json!(hex(&serialize(&world.headers[h as usize])));
+        let txid=|v:&Value|v.as_str().unwrap().parse::<Txid>().unwrap();
+        match method {
+            "server.version"=>json!(["fake","1.4"]),
+            "server.features"=>json!({"genesis_hash":LightNetwork::from(NETWORK).genesis(),"hash_function":"sha256"}),
+            "blockchain.headers.subscribe"=>json!({"height":visible,"hex":header(u64::from(visible))}),
+            "blockchain.block.header"=>header(params[0].as_u64().unwrap()),
+            "blockchain.block.headers"=>{
+                let start=params[0].as_u64().unwrap() as u32;
+                let end=(start+params[1].as_u64().unwrap() as u32).min(visible+1);
+                let hex=(start..end).map(|h|hex(&serialize(&world.headers[h as usize]))).collect::<String>();
+                json!({"count":end.saturating_sub(start),"hex":hex,"max":2016})
+            }
+            "blockchain.transaction.get"=>{
+                let id=txid(&params[0]);
+                let mut tx=world.located(id).map(|(_,_,t)|t.clone())
+                    .or_else(|| world.mempool.iter().find(|t|t.compute_txid()==id).cloned()).unwrap();
+                if self.faults.tamper_witness && !tx.input[0].witness.is_empty() {
+                    let mut items:Vec<Vec<u8>>=tx.input[0].witness.iter().map(<[u8]>::to_vec).collect();
+                    items[0][0]^=1;tx.input[0].witness=Witness::from_slice(&items);
+                }
+                json!(hex(&serialize(&tx)))
+            }
+            "blockchain.transaction.get_merkle"=>{
+                let (height,index,_)=world.located(txid(&params[0])).unwrap();
+                let leaves:Vec<_>=world.blocks[height as usize].iter().map(|t|t.compute_txid().to_byte_array()).collect();
+                let branch=merkle(&leaves,index).1.into_iter().map(|h|Txid::from_byte_array(h).to_string()).collect::<Vec<_>>();
+                json!({"block_height":height,"merkle":branch,"pos":index})
+            }
+            "blockchain.scripthash.get_history"|"blockchain.scripthash.listunspent"=>{
+                let wanted=params[0].as_str().unwrap();
+                let all:Vec<(u32,Transaction)>=confirmed(&world).into_iter().chain(pool.iter().map(|t|(0,t.clone()))).collect();
+                let pays=|t:&Transaction|t.output.iter().any(|o|crate::litecoin_light::script_hash(&o.script_pubkey)==wanted);
+                let spends=|t:&Transaction|t.input.iter().any(|i|all.iter().any(|(_,p)|p.compute_txid()==i.previous_output.txid
+                    && p.output.get(i.previous_output.vout as usize).is_some_and(|o|crate::litecoin_light::script_hash(&o.script_pubkey)==wanted)));
+                if method.ends_with("get_history") {
+                    json!(all.iter().filter(|(_,t)|pays(t) || (!self.faults.hide_spends && spends(t)))
+                        .map(|(h,t)|json!({"tx_hash":t.compute_txid().to_string(),"height":h})).collect::<Vec<_>>())
+                } else {
+                    json!(all.iter().flat_map(|(h,t)|t.output.iter().enumerate()
+                        .filter(|(_,o)|crate::litecoin_light::script_hash(&o.script_pubkey)==wanted)
+                        .map(move |(vout,o)|(*h,OutPoint {txid:t.compute_txid(),vout:vout as u32},o.value)))
+                        .filter(|(_,outpoint,_)|self.faults.hide_spends
+                            || !all.iter().any(|(_,t)|t.input.iter().any(|i|i.previous_output==*outpoint)))
+                        .map(|(h,outpoint,value)|json!({"tx_hash":outpoint.txid.to_string(),"tx_pos":outpoint.vout,"height":h,"value":value.to_sat()}))
+                        .collect::<Vec<_>>())
+                }
+            }
+            "blockchain.transaction.broadcast"=>{
+                let tx:Transaction=deserialize(&raw(params[0].as_str().unwrap())).unwrap();
+                let id=tx.compute_txid();
+                if world.located(id).is_none() && !world.mempool.iter().any(|t|t.compute_txid()==id) {world.mempool.push(tx);}
+                json!(id.to_string())
+            }
+            other=>panic!("unexpected Electrum method {other}"),
+        }
+    }
+}
+
+impl LightServer for Arc<FakeServer> {
+    type Stream=tokio::io::DuplexStream;
+    async fn connect(&self)->Result<ReadSession<Self::Stream>> {
+        let (client,stream)=tokio::io::duplex(1<<20);
+        let server=self.clone();
+        tokio::spawn(async move {
+            let mut stream=BufReader::new(stream);
+            let mut line=String::new();
+            while stream.read_line(&mut line).await.unwrap_or(0)>0 {
+                let request:Value=serde_json::from_str(&line).unwrap();line.clear();
+                let result=server.answer(request["method"].as_str().unwrap(),&request["params"]);
+                let mut reply=serde_json::to_vec(&json!({"jsonrpc":"2.0","id":request["id"],"result":result})).unwrap();
+                reply.push(b'\n');
+                if stream.get_mut().write_all(&reply).await.is_err() {return;}
+            }
+        });
+        ReadSession::negotiate(client,NETWORK).await
+    }
+}
+
+struct Trade {
+    world:Arc<Shared<World>>,
+    lock:OutPoint,
+    contract:ScriptBuf,
+    redeem:Transaction,
+    /// Spends the lock after a three-block relative timelock.
+    cancel:Transaction,
+}
+fn spend(lock:OutPoint,sequence:Sequence,witness_script:&ScriptBuf,payout:u8)->Transaction {
+    Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:lock,sequence,witness:Witness::from_slice(&[vec![payout;72],witness_script.to_bytes()]),
+            ..TxIn::default()}],
+        output:vec![TxOut {value:Amount::from_sat(199_000),script_pubkey:ScriptBuf::new_p2wsh(&bitcoin::WScriptHash::from_byte_array([payout;32]))}]}
+}
+/// Ten blocks, the lock at height 11, then `after` more blocks.
+fn trade(after:u32)->Trade {
+    let mut world=World::new();
+    world.mine_empty(10);
+    let witness_script=ScriptBuf::from_bytes(vec![0x51]);
+    let contract=ScriptBuf::new_p2wsh(&witness_script.wscript_hash());
+    let funding=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},..TxIn::default()}],
+        output:vec![TxOut {value:LOCK,script_pubkey:contract.clone()}]};
+    let lock=OutPoint {txid:funding.compute_txid(),vout:0};
+    world.mine(vec![funding]);
+    world.mine_empty(after);
+    Trade {redeem:spend(lock,Sequence::MAX,&witness_script,1),cancel:spend(lock,Sequence::from_height(3),&witness_script,2),
+        world:Arc::new(Shared::new(world)),lock,contract}
+}
+fn policy()->LightLockPolicy {LightLockPolicy {minimum_servers:2,maximum_tip_age:5400}}
+impl Trade {
+    fn chain(&self,faults:[Faults;2])->LightRedeemChain<Arc<FakeServer>> {
+        let servers=faults.map(|faults|Arc::new(FakeServer {world:self.world.clone(),faults})).to_vec();
+        LightRedeemChain::new(NETWORK,servers,HeaderSequence::from_genesis(NETWORK).unwrap(),policy(),clock).unwrap()
+    }
+    async fn verify(&self,chain:&LightRedeemChain<Arc<FakeServer>>)->Result<VerifiedLiveLock> {
+        chain.verify_live_lock(self.lock,&self.contract,LOCK,1,36,4).await
+    }
+}
+/// The refusal message; panics if the call was accepted.
+fn refusal<T>(result:Result<T>)->String {
+    match result {Ok(_)=>panic!("accepted"),Err(error)=>format!("{error:#}")}
+}
+const HONEST:[Faults;2]=[Faults {withhold:0,hide_spends:false,tamper_witness:false};2];
+
+#[tokio::test]
+async fn honest_servers_carry_a_redemption_from_lock_check_to_confirmation()->Result<()> {
+    let trade=trade(2);
+    let chain=trade.chain(HONEST);
+    let live=trade.verify(&chain).await?;
+    assert_eq!(live.observation().confirmations,3);
+    assert_eq!(chain.height().await,13);
+
+    chain.preflight_contract_spend(&trade.redeem).await?;
+    assert!(!chain.contract_spend_in_mempool(&trade.redeem).await?);
+    assert!(chain.dispatch_contract_spend(&trade.redeem).await);
+    assert!(chain.contract_spend_in_mempool(&trade.redeem).await?);
+    assert!(trade.verify(&chain).await.is_err(),"a pending spend must end the lock check");
+    assert!(chain.preflight_contract_spend(&trade.redeem).await.is_err(),"already sent");
+
+    trade.world.lock().unwrap().mine(vec![]);
+    let block=trade.world.lock().unwrap().headers[14].block_hash();
+    let txid=trade.redeem.compute_txid();
+    assert!(!chain.contract_spend_in_mempool(&trade.redeem).await?);
+    let confirmed=chain.confirmed_transaction(txid,block,1).await?;
+    assert_eq!((confirmed.block(),confirmed.confirmations(),confirmed.network()),(block,1,NETWORK));
+    assert_eq!(serialize(confirmed.transaction()),serialize(&trade.redeem));
+    assert!(chain.confirmed_transaction(txid,block,2).await.is_err(),"too shallow");
+    let earlier=trade.world.lock().unwrap().headers[13].block_hash();
+    assert!(chain.confirmed_transaction(txid,earlier,1).await.is_err(),"wrong block");
+    trade.world.lock().unwrap().mine_empty(2);
+    assert_eq!(chain.indexed_confirmed_transaction(txid,3).await?.confirmations(),3);
+    Ok(())
+}
