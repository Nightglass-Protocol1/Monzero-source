+#[tokio::test]
+async fn withheld_blocks_fail_closed()->Result<()> {
+    let trade=trade(20);
+    // Every server hides the last twelve blocks: two hours of Bitcoin time.
+    let stale=Faults {withhold:12,..Faults::default()};
+    let error=refusal(trade.verify(&trade.chain([stale,stale])).await);
+    assert!(error.contains("too old"),"{error}");
+    assert!(trade.chain([stale,stale]).preflight_contract_spend(&trade.redeem).await.is_err());
+    // One server one block behind: disagreement, not a silently shorter chain.
+    let lagging=Faults {withhold:1,..Faults::default()};
+    let error=refusal(trade.verify(&trade.chain([Faults::default(),lagging])).await);
+    assert!(error.contains("disagree"),"{error}");
+    assert!(trade.verify(&trade.chain(HONEST)).await.is_ok());
+    Ok(())
+}
