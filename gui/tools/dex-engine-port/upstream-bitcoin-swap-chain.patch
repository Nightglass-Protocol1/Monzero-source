@@ -0,0 +1,64 @@
+//! Bitcoin mainnet header rules from a pinned checkpoint, and an ignored full-chain check
+//! against headers exported from a Bitcoin Core node.
+use super::*;
+use crate::litecoin_light::network::BtcNetwork;
+
+const MAINNET: LightNetwork = LightNetwork::Bitcoin(BtcNetwork::Mainnet);
+
+/// Mainnet blocks 971,713–971,715, the first three after the pinned checkpoint.
+const AFTER_CHECKPOINT: [&str; 3] = [
+    "0000ef2567e4170256d588a8822684fed6628da0906690f085c100000000000000000000d6e633674f15bec73fdcfde3988851ccfb27d0179554262223b661a04c251e97d81ad26a9300021742b69e2c",
+    "00a07c2e276b669a42ef2e5f0aef7241f7b8f9f21bb53cb824110000000000000000000002ea23e0d23ac2050c5b1b2b8e68f8f224a880496dabdcd0cf628b663e772d45b220d26a93000217e5a12c44",
+    "00a000205b090090043163711ee9fc29529691a251e3625e4838010000000000000000009db18e48ba18ba6bd4f8933cbd616091629c78adaf5863d7b40d90e5665ad1701728d26a93000217f1788f0a",
+];
+
+#[test]
+fn mainnet_starts_at_its_checkpoint_and_validates_real_headers_on_top() -> Result<()> {
+    let mut chain = HeaderSequence::new(MAINNET)?;
+    assert_eq!((chain.height(), chain.root_height()), (971712, 971712));
+    assert_eq!(chain.header(971712).unwrap().block_hash().to_string(),
+        "00000000000000000000c185f0906690a08d62d6fe842682a888d5560217e467");
+    let raw = |hex: &str| -> Vec<u8> { (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i+2], 16).unwrap()).collect() };
+    let now = 1792158319u64;
+    for (offset, header) in AFTER_CHECKPOINT.iter().enumerate() {
+        chain.append(&raw(header), now)?;
+        assert_eq!(chain.height(), 971713 + offset as u32);
+    }
+    // Real SHA256d work is required on top of the checkpoint.
+    let mut forged = HeaderSequence::new(MAINNET)?;
+    let mut bytes = raw(AFTER_CHECKPOINT[0]); bytes[76] ^= 1;
+    assert!(forged.append(&bytes, now).is_err());
+    assert!(chain.adopt(HeaderSequence::from_genesis(MAINNET)?).is_err());
+    Ok(())
+}
+
+/// `MONZERO_BTC_MAINNET_HEADERS`: flat 80-byte headers from height 0, exported from a Bitcoin
+/// Core node (any node whose best header chain is mainnet).
+#[test]
+#[ignore = "requires exported Bitcoin mainnet headers"]
+fn mainnet_real_headers_validate_from_genesis() -> Result<()> {
+    let path = std::env::var_os("MONZERO_BTC_MAINNET_HEADERS").context("missing MONZERO_BTC_MAINNET_HEADERS")?;
+    let bytes = std::fs::read(path)?;
+    ensure!(bytes.len() % 80 == 0 && bytes.len() >= 80 * 971716, "need headers past the checkpoint");
+    let mut chain = HeaderSequence::from_genesis(MAINNET)?;
+    assert_eq!(bytes[..80], serialize(&chain.header(0).unwrap())[..]);
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    for batch in bytes[80..].chunks(2016 * 80) { chain.append_batch(batch, now)?; }
+    assert_eq!(chain.height() as usize, bytes.len() / 80 - 1);
+    // Real SHA256d work is required: a header with one changed nonce bit is refused.
+    let tip = chain.height();
+    let mut prefix = HeaderSequence::from_genesis(MAINNET)?;
+    for batch in bytes[80..80 * tip as usize].chunks(2016 * 80) { prefix.append_batch(batch, now)?; }
+    let mut forged = serialize(&chain.header(tip).unwrap()); forged[76] ^= 1;
+    assert!(prefix.append(&forged, now).is_err());
+    // The pinned checkpoint lies on this chain with the same cumulative work, and syncs to the same tip.
+    let root = MAINNET.checkpoint().context("mainnet checkpoint")?.height;
+    let mut rooted = HeaderSequence::new(MAINNET)?;
+    assert_eq!(rooted.header(root).unwrap().block_hash(), chain.header(root).unwrap().block_hash());
+    let mut upto = HeaderSequence::from_genesis(MAINNET)?;
