+    let pending=self::trade(0);
+    let funding=pending.world.lock().unwrap().blocks.pop().unwrap().remove(1);
+    {let mut world=pending.world.lock().unwrap();world.headers.pop();world.mempool.push(funding);}
+    assert!(pending.verify(&pending.chain(HONEST)).await.is_err(),"unconfirmed lock");
