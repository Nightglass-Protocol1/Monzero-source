+#[tokio::test]
+async fn transactions_must_be_byte_identical_on_every_server()->Result<()> {
+    let trade=trade(2);
+    trade.world.lock().unwrap().mine(vec![trade.redeem.clone()]);
+    let txid=trade.redeem.compute_txid();
+    let tampering=Faults {tamper_witness:true,..Faults::default()};
+    let error=refusal(trade.chain([Faults::default(),tampering]).indexed_confirmed_transaction(txid,1).await);
+    assert!(error.contains("different transaction bytes"),"{error}");
+    assert!(trade.chain(HONEST).indexed_confirmed_transaction(txid,1).await.is_ok());
+    Ok(())
+}
+
+#[test]
+fn needs_two_servers_on_the_same_network() {
+    let trade=trade(0);
+    let one=vec![Arc::new(FakeServer {world:trade.world.clone(),faults:Faults::default()})];
+    assert!(LightRedeemChain::new(NETWORK,one,HeaderSequence::from_genesis(NETWORK).unwrap(),policy(),clock).is_err());
+    let two=(0..2).map(|_|Arc::new(FakeServer {world:trade.world.clone(),faults:Faults::default()})).collect();
+    assert!(LightRedeemChain::new(LtcNetwork::BitcoinSignet,two,HeaderSequence::from_genesis(NETWORK).unwrap(),policy(),clock).is_err());
+}
+
+#[tokio::test]
+async fn a_cancel_paying_the_lock_script_leaves_its_output_spendable()->Result<()> {
+    // As in the swap, the cancel pays the lock's own 2-of-2 script, so that
+    // script's history holds both the lock and the cancel.
+    let trade=trade(3);
+    let witness_script=ScriptBuf::from_bytes(vec![0x51]);
+    let mut cancel=trade.cancel.clone();cancel.output[0].script_pubkey=trade.contract.clone();
+    trade.world.lock().unwrap().mine(vec![cancel.clone()]);
+    let chain=trade.chain(HONEST);
+    assert!(trade.verify(&chain).await.is_err(),"the lock is spent by the cancel");
+    let mut punish=spend(OutPoint {txid:cancel.compute_txid(),vout:0},Sequence::from_height(2),&witness_script,3);
+    punish.output[0].value=Amount::from_sat(198_000);
+    assert!(refusal(chain.preflight_contract_spend(&punish).await).contains("timelock"));
+    trade.world.lock().unwrap().mine(vec![]);
+    chain.preflight_contract_spend(&punish).await?;
+    // A real spend of the cancel output is still seen, by either server.
+    let refund=spend(OutPoint {txid:cancel.compute_txid(),vout:0},Sequence::MAX,&witness_script,4);
+    trade.world.lock().unwrap().mine(vec![refund]);
+    let error=refusal(chain.preflight_contract_spend(&punish).await);
+    assert!(error.contains("spent"),"{error}");
+    let hiding=Faults {hide_spends:true,..Faults::default()};
+    assert!(trade.chain([Faults::default(),hiding]).preflight_contract_spend(&punish).await.is_err());
+    Ok(())
+}
diff --git a/swap-machine/src/litecoin_rpc/redeem_chain/light_rules.rs b/swap-machine/src/litecoin_rpc/redeem_chain/light_rules.rs
new file mode 100644
index 000000000..2a5f2971e
--- /dev/null
+++ b/swap-machine/src/litecoin_rpc/redeem_chain/light_rules.rs
@@ -0,0 +1,110 @@
+//! Light-wallet rules for the XMZ seller's lock check (SELLER_LIGHT_REDEEM.md).
+//! Proven locally: the lock's inclusion and depth on validated headers.
+//! Not provable from headers: that the lock is unspent and that no newer
+//! headers are being withheld. Both are cross-checked across independent
+//! servers, and the best header must be recent; every doubt fails closed.
+use super::super::{ObservedOutput,VerifiedLiveLock,validate_live_lock};
+use crate::litecoin_light::headers::HeaderSequence;
+use anyhow::{Context,Result,ensure};
+use bitcoin::{Amount,BlockHash,OutPoint,ScriptBuf};
+use swap_core::litecoin_address::LtcNetwork;
+
+/// One server's report, taken while the caller's chain was at this tip.
+pub struct ServerLockReport { pub tip_height:u32, pub tip:BlockHash, pub lock_unspent:bool }
+
+pub struct LightLockPolicy {
+    /// Independently operated servers that must agree; at least two.
+    pub minimum_servers:usize,
+    /// Oldest acceptable best-header time, in seconds behind `now`.
+    pub maximum_tip_age:u64,
+}
+
+/// `lock_outputs` are the lock transaction's outputs paying `script`, taken
+/// from a transaction proven included at `lock_height`/`lock_block`.
+#[allow(clippy::too_many_arguments)]
+pub fn light_live_lock(chain:&HeaderSequence,network:LtcNetwork,lock_height:u32,lock_block:BlockHash,
+    lock_outputs:&[(OutPoint,Amount)],outpoint:OutPoint,script:&ScriptBuf,amount:Amount,confirmations:u64,
+    cancel_blocks:u32,safety_blocks:u32,reports:&[ServerLockReport],policy:&LightLockPolicy,now:u64)
+    ->Result<VerifiedLiveLock> {
+    ensure!(chain.network()==network,"light lock chain is for another network");
+    ensure!(!outpoint.is_null() && script.is_p2wsh() && amount>Amount::ZERO,"invalid lock expectation");
+    ensure!(policy.minimum_servers>=2 && (1..=3*3600).contains(&policy.maximum_tip_age),
+        "light lock policy needs two servers and a tip age of at most three hours");
+    let height=chain.height();
+    let tip=chain.header(height).context("light chain has no tip")?;
+    ensure!(u64::from(tip.time).saturating_add(policy.maximum_tip_age)>=now,
+        "best header is too old; newer blocks may be withheld");
+    ensure!(reports.len()>=policy.minimum_servers,"too few servers reported on the lock");
+    ensure!(reports.iter().all(|r|r.tip_height==height && r.tip==tip.block_hash()),
+        "servers disagree with the local tip; resynchronise and check again");
+    ensure!(reports.iter().all(|r|r.lock_unspent),"a server reports the lock as spent");
+    ensure!(chain.contains(lock_height,lock_block),"lock block is not on the validated chain");
+    let mut matching=lock_outputs.iter().filter(|(o,_)|*o==outpoint);
+    let (_,observed_amount)=matching.next().context("lock transaction does not pay the contract at this outpoint")?;
+    ensure!(matching.next().is_none(),"duplicate lock outpoint");
+    let observed=ObservedOutput {tip:tip.block_hash(),confirmations:u64::from(height-lock_height)+1,
+        amount:*observed_amount,script:script.clone()};
+    validate_live_lock(&observed,script,amount,confirmations,cancel_blocks,safety_blocks)?;
+    Ok(VerifiedLiveLock {network,outpoint,observed})
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::{block::Header,consensus::serialize,hashes::Hash};
+
+    const NETWORK:LtcNetwork=LtcNetwork::BitcoinRegtest;
+    fn chain(length:u32)->Result<HeaderSequence> {
+        let mut chain=HeaderSequence::from_genesis(NETWORK)?;
+        while chain.height()<length {
+            let previous=chain.header(chain.height()).unwrap();
+            let header=(0u32..).map(|nonce|Header {version:bitcoin::block::Version::from_consensus(0x2000_0000),prev_blockhash:previous.block_hash(),
+                merkle_root:previous.merkle_root,time:previous.time+600,bits:previous.bits,nonce})
+                .find(|h|h.validate_pow(h.target()).is_ok()).unwrap();
+            chain.append(&serialize(&header),u64::from(header.time))?;
+        }
+        Ok(chain)
+    }
+
+    #[test]
+    fn light_lock_needs_proof_fresh_tip_and_agreeing_servers()->Result<()> {
+        let chain=chain(12)?;
+        let tip=chain.header(12).unwrap();let now=u64::from(tip.time)+60;
+        let script=ScriptBuf::new_p2wsh(&bitcoin::WScriptHash::from_byte_array([3;32]));
+        let outpoint=OutPoint {txid:bitcoin::Txid::from_byte_array([5;32]),vout:1};
+        let amount=Amount::from_sat(200_000);
+        let lock_block=chain.header(10).unwrap().block_hash();
+        let report=|unspent|ServerLockReport {tip_height:12,tip:tip.block_hash(),lock_unspent:unspent};
+        let policy=LightLockPolicy {minimum_servers:2,maximum_tip_age:5400};
+        let check=|height,block,outputs:&[(OutPoint,Amount)],reports:&[ServerLockReport],policy:&LightLockPolicy,now,conf,cancel|
+            light_live_lock(&chain,NETWORK,height,block,outputs,outpoint,&script,amount,conf,cancel,4,reports,policy,now);
+        let good=[(outpoint,amount)];
+
+        // Lock at height 10 on a 12-block chain: three confirmations.
+        let live=check(10,lock_block,&good,&[report(true),report(true)],&policy,now,1,36)?;
+        assert_eq!(live.observation().confirmations,3);
+        assert_eq!(live.outpoint(),outpoint);assert_eq!(live.network(),NETWORK);
+
+        let refused=[
+            ("one server",check(10,lock_block,&good,&[report(true)],&policy,now,1,36)),
+            ("one-server policy",check(10,lock_block,&good,&[report(true),report(true)],
+                &LightLockPolicy {minimum_servers:1,maximum_tip_age:5400},now,1,36)),
+            ("stale tip",check(10,lock_block,&good,&[report(true),report(true)],&policy,now+5400,1,36)),
+            ("unbounded tip age",check(10,lock_block,&good,&[report(true),report(true)],
+                &LightLockPolicy {minimum_servers:2,maximum_tip_age:u64::MAX},now,1,36)),
+            ("spent on one server",check(10,lock_block,&good,&[report(true),report(false)],&policy,now,1,36)),
+            ("server on another tip",check(10,lock_block,&good,&[report(true),
+                ServerLockReport {tip_height:13,tip:BlockHash::from_byte_array([9;32]),lock_unspent:true}],&policy,now,1,36)),
+            ("block off chain",check(10,BlockHash::from_byte_array([1;32]),&good,&[report(true),report(true)],&policy,now,1,36)),
+            ("wrong amount",check(10,lock_block,&[(outpoint,Amount::from_sat(199_999))],&[report(true),report(true)],&policy,now,1,36)),
+            ("other outpoint",check(10,lock_block,&[(OutPoint {vout:0,..outpoint},amount)],&[report(true),report(true)],&policy,now,1,36)),
+            ("duplicate outpoint",check(10,lock_block,&[(outpoint,amount),(outpoint,amount)],&[report(true),report(true)],&policy,now,1,36)),
+            ("shallow",check(10,lock_block,&good,&[report(true),report(true)],&policy,now,4,36)),
+            ("near cancellation",check(10,lock_block,&good,&[report(true),report(true)],&policy,now,1,7)),
+        ];
+        for (case,result) in refused {assert!(result.is_err(),"{case} was accepted");}
+        assert!(light_live_lock(&chain,LtcNetwork::BitcoinSignet,10,lock_block,&good,outpoint,&script,amount,1,36,4,
+            &[report(true),report(true)],&policy,now).is_err());
+        Ok(())
+    }
+}
