new file mode 100644
index 000000000..79d35c9e7
--- /dev/null
+++ b/swap-machine/src/litecoin_rpc/redeem_chain/light.rs
@@ -0,0 +1,312 @@
+//! Light-wallet `RedeemChain` for the XMZ seller (SELLER_LIGHT_REDEEM.md).
+//! Inclusion and depth are proven against headers this process validated.
+//! Unspentness, mempool state and witness bytes are server claims: every
+//! configured server must agree with each other and with the local tip, the
+//! tip must be recent, and any doubt fails closed. A server that lies can stall
+//! a trade; it cannot make the seller release before the cancel margin.
+use super::{RedeemChain,light_rules::{LightLockPolicy,ServerLockReport,light_live_lock}};
+use super::super::{VerifiedLiveLock,confirmed::ConfirmedTransaction};
+use crate::litecoin_light::{headers::HeaderSequence,tls::TlsEndpoint,
+    session::{ReadSession,history::ReportedPosition}};
+use anyhow::{Context,Result,bail,ensure};
+use bitcoin::{Amount,BlockHash,OutPoint,ScriptBuf,Transaction,Txid,absolute,relative,consensus::encode::serialize};
+use std::future::Future;
+use swap_core::litecoin_address::LtcNetwork;
+use tokio::{io::{AsyncRead,AsyncWrite},sync::Mutex};
+
+/// One independently operated Electrum server. Each call opens a new session.
+pub trait LightServer: Sync {
+    type Stream: AsyncRead+AsyncWrite+Unpin+Send;
+    fn connect(&self)->impl Future<Output=Result<ReadSession<Self::Stream>>>+Send;
+}
+impl LightServer for TlsEndpoint {
+    type Stream=tokio_rustls::client::TlsStream<tokio::net::TcpStream>;
+    fn connect(&self)->impl Future<Output=Result<ReadSession<Self::Stream>>>+Send {TlsEndpoint::connect(self)}
+}
+
+/// Contract scripts receive one lock and are spent once, so short histories suffice.
+const CONTRACT_HISTORY:usize=16;
+/// Payout and refund addresses are fresh per trade; a little room for reuse.
+const OUTPUT_HISTORY:usize=64;
+/// Headers one call may download (about a year of Bitcoin blocks).
+const MAXIMUM_DOWNLOAD:u32=60_000;
+/// Smallest output any supported chain relays as standard.
+const DUST:Amount=Amount::from_sat(546);
+
+pub struct LightRedeemChain<S> {
+    network:LtcNetwork,
+    servers:Vec<S>,
+    chain:Mutex<HeaderSequence>,
+    policy:LightLockPolicy,
+    clock:fn()->Result<u64>,
+}
+
+/// What every server reported about one contract output, with the lock proven.
+struct ContractObservation {
+    height:u32,
+    block:BlockHash,
+    outputs:Vec<(OutPoint,Amount)>,
+    reports:Vec<ServerLockReport>,
+}
+
+pub fn system_clock()->Result<u64> {
+    Ok(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs())
+}
+
+impl<S:LightServer> LightRedeemChain<S> {
+    /// `chain` is the caller's validated header cache (from a checkpoint or
+    /// genesis). It is extended in memory; callers persist it separately.
+    pub fn new(network:LtcNetwork,servers:Vec<S>,chain:HeaderSequence,policy:LightLockPolicy,
+        clock:fn()->Result<u64>)->Result<Self> {
+        ensure!(chain.network()==network,"light redeem chain is for another network");
+        ensure!(policy.minimum_servers>=2 && servers.len()>=policy.minimum_servers,
+            "light redemption needs at least two independent servers");
+        Ok(Self {network,servers,chain:Mutex::new(chain),policy,clock})
+    }
+
+    pub async fn height(&self)->u32 {self.chain.lock().await.height()}
+
+    /// Extend the local chain with every server's headers. The heaviest valid
+    /// branch wins; servers that report a lighter branch are caught later by the
+    /// tip agreement check, never adopted.
+    async fn synchronize(&self,chain:&mut HeaderSequence)->Result<()> {
+        let now=(self.clock)()?;
+        for server in &self.servers {
+            let tip=server.connect().await?.reported_tip().await?;
+            let mut session=server.connect().await?;
+            let mut candidate=session.begin_sync(chain,tip).await?;
+            ensure!(candidate.target_height().saturating_sub(candidate.height())<=MAXIMUM_DOWNLOAD,
+                "light chain is too far behind; synchronise the wallet first");
+            while !candidate.complete() {candidate.advance(&mut session,2016,now).await?;}
+            candidate.finish(chain)?;
+        }
+        Ok(())
+    }
+
+    fn fresh_tip(&self,chain:&HeaderSequence)->Result<()> {
+        let tip=chain.header(chain.height()).context("light chain has no tip")?;
+        ensure!(u64::from(tip.time).saturating_add(self.policy.maximum_tip_age)>=(self.clock)()?,
+            "best header is too old; newer blocks may be withheld");
+        Ok(())
+    }
+
+    /// Ask every server about one contract output, then prove the funding
+    /// transaction's inclusion. Reports carry each server's tip taken after
+    /// its answers, so a block found mid-query shows up as disagreement.
+    async fn observe_contract(&self,chain:&HeaderSequence,outpoint:OutPoint,script:&ScriptBuf)
+        ->Result<ContractObservation> {
+        let mut reports=Vec::with_capacity(self.servers.len());
+        let mut height=None;
+        for server in &self.servers {
+            let mut session=server.connect().await?;
+            let history=session.reported_history(script,CONTRACT_HISTORY).await?;
+            let unspent=session.reported_unspent(script,CONTRACT_HISTORY).await?;
+            // A cancel pays the lock's own script, so other history entries
+            // are spends only if one consumes this outpoint. Inputs are
+            // committed by the txid, which the session checks.
+            let mut untouched=true;
+            for entry in history.iter().filter(|entry|entry.txid()!=outpoint.txid) {
+                let other=session.reported_transaction(entry.txid()).await?;
+                if other.input.iter().any(|input|input.previous_output==outpoint) {untouched=false;break;}
+            }
+            drop(session);
+            let tip=server.connect().await?.reported_tip().await?;
+            let funded=history.iter().find(|entry|entry.txid()==outpoint.txid).and_then(|entry|match entry.position() {
+                ReportedPosition::Block(height)=>Some(height),_=>None});
+            let funded=funded.context("a server does not report the contract funding as confirmed")?;
+            ensure!(*height.get_or_insert(funded)==funded,"servers disagree on the contract funding block");
+            let listed=unspent.iter().any(|output|output.outpoint()==outpoint && output.height()==funded);
+            reports.push(ServerLockReport {tip_height:tip.height(),tip:tip.hash(),lock_unspent:untouched && listed});
+        }
+        let height=height.context("no servers configured")?;
+        ensure!(height<=chain.height(),"contract funding is above the validated chain");
+        let block=chain.header(height).context("contract funding block is outside the validated chain")?.block_hash();
+        let included=self.servers[0].connect().await?.transaction_on(chain,height,outpoint.txid).await?;
+        let outputs=included.outputs_to(script).collect();
+        Ok(ContractObservation {height,block,outputs,reports})
+    }
+
+    /// Every server must return the same bytes: a txid commits to everything
+    /// except the witness, and callers recover keys from witnesses.
+    async fn agreed_transaction(&self,txid:Txid)->Result<Transaction> {
+        let mut agreed:Option<Transaction>=None;
+        for server in &self.servers {
+            let transaction=server.connect().await?.reported_transaction(txid).await?;
+            match &agreed {
+                Some(first)=>ensure!(serialize(first)==serialize(&transaction),"servers return different transaction bytes"),
+                None=>agreed=Some(transaction),
+            }
+        }
+        agreed.context("no servers configured")
+    }
+
+    /// Confirmed height of a transaction, found through its first output's
+    /// script history on every server, then proven against local headers.
+    async fn confirmed_location(&self,chain:&HeaderSequence,transaction:&Transaction)->Result<u32> {
+        let txid=transaction.compute_txid();
+        let script=&transaction.output.first().context("transaction has no outputs")?.script_pubkey;
+        let mut height=None;
+        for server in &self.servers {
+            let history=server.connect().await?.reported_history(script,OUTPUT_HISTORY).await?;
+            let found=history.iter().find(|entry|entry.txid()==txid).and_then(|entry|match entry.position() {
+                ReportedPosition::Block(height)=>Some(height),_=>None}).context("transaction is not confirmed")?;
+            ensure!(*height.get_or_insert(found)==found,"servers disagree on the transaction block");
+        }
+        let height=height.context("no servers configured")?;
+        let included=self.servers[0].connect().await?.transaction_on(chain,height,txid).await?;
+        ensure!(included.txid()==txid,"proof is for another transaction");
+        Ok(height)
+    }
+
+    async fn confirmed(&self,txid:Txid,block:Option<BlockHash>,minimum:u64)->Result<ConfirmedTransaction> {
+        ensure!(minimum>0,"zero transaction confirmation requirement");
+        let mut chain=self.chain.lock().await;
+        self.synchronize(&mut chain).await?;
+        let transaction=self.agreed_transaction(txid).await?;
+        let height=self.confirmed_location(&chain,&transaction).await?;
+        let found=chain.header(height).context("transaction block outside the validated chain")?.block_hash();
+        if let Some(block)=block {
+            ensure!(found==block,"transaction is not confirmed in the requested active block");
+        }
+        let confirmations=u64::from(chain.height()-height)+1;
+        ensure!(confirmations>=minimum,"transaction is not confirmed in the requested active block");
+        let tip=chain.header(chain.height()).context("light chain has no tip")?.block_hash();
+        Ok(ConfirmedTransaction::from_light(self.network,tip,found,confirmations,transaction))
+    }
+}
+
+/// The P2WSH script a completed contract spend draws from.
+fn spent_contract(transaction:&Transaction)->Result<(OutPoint,ScriptBuf)> {
+    ensure!(transaction.input.len()==1 && transaction.output.len()==1
+        && transaction.input[0].script_sig.is_empty(),"invalid completed redemption shape");
+    let input=&transaction.input[0];
+    let witness_script=ScriptBuf::from_bytes(input.witness.last().context("invalid completed redemption shape")?.to_vec());
+    Ok((input.previous_output,ScriptBuf::new_p2wsh(&witness_script.wscript_hash())))
+}
+
+impl<S:LightServer> RedeemChain for LightRedeemChain<S> {
+    fn network(&self)->LtcNetwork {self.network}
+
+    async fn verify_live_lock(&self,outpoint:OutPoint,script:&ScriptBuf,amount:Amount,
+        confirmations:u64,cancel_blocks:u32,safety_blocks:u32)->Result<VerifiedLiveLock> {
+        ensure!(!outpoint.is_null() && script.is_p2wsh() && amount>Amount::ZERO,"invalid lock expectation");
+        let mut chain=self.chain.lock().await;
+        self.synchronize(&mut chain).await?;
+        let observed=self.observe_contract(&chain,outpoint,script).await?;
+        light_live_lock(&chain,self.network,observed.height,observed.block,&observed.outputs,outpoint,script,amount,
+            confirmations,cancel_blocks,safety_blocks,&observed.reports,&self.policy,(self.clock)()?)
+    }
+
+    /// No mempool acceptance test exists over Electrum; check what a node would:
+    /// the input is the proven, unspent contract output, timelocks are met now,
+    /// and the fee is positive with a standard output. Broadcast refusal leaves
+    /// the retained bytes untouched for a later retry, as with a node.
+    async fn preflight_contract_spend(&self,transaction:&Transaction)->Result<()> {
+        let (outpoint,contract)=spent_contract(transaction)?;
+        let mut chain=self.chain.lock().await;
+        self.synchronize(&mut chain).await?;
+        self.fresh_tip(&chain)?;
+        let observed=self.observe_contract(&chain,outpoint,&contract).await?;
+        let tip=chain.header(chain.height()).context("light chain has no tip")?.block_hash();
+        ensure!(observed.reports.iter().all(|r|r.tip_height==chain.height() && r.tip==tip),
+            "servers disagree with the local tip; resynchronise and check again");
+        ensure!(observed.reports.iter().all(|r|r.lock_unspent),"contract output is spent or unknown to a server");
+        let mut matching=observed.outputs.iter().filter(|(o,_)|*o==outpoint);
+        let (_,value)=matching.next().context("spent output does not pay the contract")?;
+        ensure!(matching.next().is_none(),"duplicate contract outpoint");
+        let output=transaction.output[0].value;
+        ensure!(output>=DUST && output<*value,"contract spend pays dust or has no fee");
+        let depth=chain.height()-observed.height+1;
+        if let Some(lock)=transaction.input[0].sequence.to_relative_lock_time() {
+            ensure!(transaction.version.0>=2,"relative timelock needs version 2");
+            match lock {
+                relative::LockTime::Blocks(blocks)=>ensure!(depth>=u32::from(blocks.value()),
+                    "contract spend timelock is not yet satisfied"),
+                relative::LockTime::Time(_)=>bail!("time-based contract timelocks are not supported"),
+            }
+        }
+        match transaction.lock_time {
+            absolute::LockTime::Blocks(height)=>ensure!(height.to_consensus_u32()<=chain.height(),
+                "contract spend lock time is not yet satisfied"),
+            absolute::LockTime::Seconds(_)=>bail!("time-based contract lock times are not supported"),
+        }
+        Ok(())
+    }
+
+    /// Send to every server; any matching acknowledgement counts as sent.
+    async fn dispatch_contract_spend(&self,transaction:&Transaction)->bool {
+        let mut acknowledged=false;
+        for server in &self.servers {
+            if let Ok(session)=server.connect().await {
+                acknowledged|=session.broadcast_contract_spend(transaction).await.ok()==Some(transaction.compute_txid());
+            }
+        }
+        acknowledged
+    }
+
+    async fn contract_spend_in_mempool(&self,transaction:&Transaction)->Result<bool> {
+        let (_,contract)=spent_contract(transaction)?;
+        let txid=transaction.compute_txid();
+        let mut found=false;
+        for server in &self.servers {
+            let mut session=server.connect().await?;
+            let pending=session.reported_history(&contract,CONTRACT_HISTORY).await?.iter().any(|entry|entry.txid()==txid
+                && matches!(entry.position(),ReportedPosition::Mempool|ReportedPosition::MempoolWithUnconfirmedParents));
+            if pending {
+                let reported=session.reported_transaction(txid).await?;
+                ensure!(serialize(&reported)==serialize(transaction),"mempool recovery differs from retained signed bytes");
+                found=true;
+            }
+        }
+        Ok(found)
+    }
+
+    async fn confirmed_transaction(&self,txid:Txid,block:BlockHash,minimum:u64)->Result<ConfirmedTransaction> {
+        self.confirmed(txid,Some(block),minimum).await
+    }
+
+    async fn indexed_confirmed_transaction(&self,txid:Txid,minimum:u64)->Result<ConfirmedTransaction> {
+        self.confirmed(txid,None,minimum).await
+    }
+}
