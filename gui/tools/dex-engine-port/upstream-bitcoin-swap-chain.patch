+    assert!(chain.preflight_contract_spend(&free).await.is_err());
+    let mut future=trade.redeem.clone();future.lock_time=absolute::LockTime::from_height(100).unwrap();
+    assert!(chain.preflight_contract_spend(&future).await.is_err());
+    let mut other=trade.redeem.clone();other.input[0].previous_output.vout=1;
+    assert!(chain.preflight_contract_spend(&other).await.is_err());
