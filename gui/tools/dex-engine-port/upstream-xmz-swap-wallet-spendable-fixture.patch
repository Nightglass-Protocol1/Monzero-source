+++ b/swap-machine/tests/native_rpc.rs
@@ -66,20 +66,29 @@ impl swap_machine::xmz_funding::BitcoinLockObserver for BitcoinRpc {
 
 pub use swap_machine::native_funding_rpc::NativeFundingRpc as NativeRpc;
 
+/// Raw connection pieces for fixtures that construct several independent
+/// `NativeFundingRpc` clients themselves (e.g. `spendable::swap_wallet_spendable`,
+/// which needs one per composed primitive) rather than a single shared one.
+#[cfg(unix)]
+pub fn fixture_connection() -> Result<(u16, u16, String, String)> {
+    use std::io::Read;
+    use std::os::unix::fs::PermissionsExt;
+    let path = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_WALLET_RPC_LOGIN")
+        .context("missing private fixture credential path")?);
+    let metadata = std::fs::symlink_metadata(&path)?;
+    ensure!(metadata.is_file() && metadata.permissions().mode() & 0o077 == 0,
+        "nonprivate fixture credentials");
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)?.take(1025).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() <= 1024, "oversized fixture credentials");
+    let text = std::str::from_utf8(&bytes)?;
+    let (username, password) = text.split_once(':').context("invalid fixture credentials")?;
+    Ok((std::env::var("MONZERO_TEST_DAEMON_RPC_PORT")?.parse()?,
+        std::env::var("MONZERO_TEST_WALLET_RPC_PORT")?.parse()?, username.into(), password.into()))
+}
