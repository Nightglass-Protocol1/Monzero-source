+//! Early wallet-source selection under the admitted execution's metadata lease.
+//! No input reservation, signature, relay or secret material is retained here.
+use super::*;
+use crate::litecoin_light::network::LightNetwork;
+use bitcoin::hashes::{Hash,sha256};
+const SCHEMA:&str="monzero-bch-light-funding-source-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Source {schema:String,admission:[u8;32],network:String,wallet:sha256::Hash,selected_at:u64}
+impl AdmittedExecution<'_> {
+    pub(in crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding)
+    fn light_source_bytes(&self)->Result<Option<Vec<u8>>> {
+        match self.metadata.read(&record_name(self.quote,"light-source")) {
+            Ok(bytes)=>{ensure!(bytes.len()<=4096,"oversized BCH light source");Ok(Some(bytes))},
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(None),
+            Err(e)=>Err(e),
+        }
+    }
+    fn light_source(&self,network:LightNetwork,wallet:sha256::Hash)->Result<Source> {
+        self.require_no_node_funding_records()?;
+        let bytes=self.light_source_bytes()?.context("select the BCH local wallet before funding")?;
+        let source:Source=serde_json::from_slice(&bytes)?;
+        ensure!(source.schema==SCHEMA && source.admission==self.admission_digest()?
+            && source.network==network.storage_identity() && source.wallet==wallet
+            && serde_json::to_vec(&source)?==bytes,"BCH local wallet selection changed");
+        self.quote.check_policy(self.policy,source.selected_at)?;
+        ensure!(source.selected_at>=self.read_admission()?.admitted_at,"BCH source predates admission");
+        Ok(source)
+    }
+    /// The caller commits to the validated account descriptor and canonical
+    /// wallet storage locations. Exact retry only; this is not spend consent.
+    pub fn select_light_funding_source(&self,network:LightNetwork,wallet:sha256::Hash,now:u64)->Result<()> {
+        ensure!(self.role==Role::BchFunder && network==LightNetwork::from(crate::litecoin_light::network::BchNetwork::Regtest)
+            && self.quote.terms()["bchNetwork"]=="bch-regtest" && self.quote.terms()["bchGenesis"]==network.genesis(),
+            "wrong BCH light source role or network");
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(now>=self.read_admission()?.admitted_at,"BCH source selection predates admission");
+        self.require_no_node_funding_records()?;
+        if self.light_source_bytes()?.is_some() {
+            ensure!(now>=self.light_source(network,wallet)?.selected_at,"BCH source time moved backwards");
+            return Ok(())
+        }
+        ensure!(self.local_record_bytes()?.is_none() && self.prepared_bch_funding()?.is_none(),
+            "existing BCH funding cannot select another source");
+        match Journal::open(&self.snapshots)?.read(&record_name(self.quote,"template")) {
+            Ok(_)=>anyhow::bail!("partial BCH preparation cannot select another source"),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+            Err(e)=>return Err(e),
+        }
+        let source=Source {schema:SCHEMA.into(),admission:self.admission_digest()?,network:network.storage_identity(),wallet,selected_at:now};
+        self.metadata.retain(&record_name(self.quote,"light-source"),&serde_json::to_vec(&source)?)
+    }
+    /// Every fresh local prepare/sign/send review requires the same selected
+    /// wallet. The metadata lease remains held through async work and signing.
+    pub fn require_light_funding_source(&self,network:LightNetwork,wallet:sha256::Hash,now:u64)->Result<()> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH light source role");
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(now>=self.light_source(network,wallet)?.selected_at,"BCH operation predates wallet selection");
+        Ok(())
+    }
+}
