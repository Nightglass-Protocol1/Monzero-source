+fn wallet_source(wallet:&WalletConfig,network:LightNetwork)->Result<sha256::Hash> {
+    let account=PublicAccount::from_descriptor(&wallet.account,network)?;
+    let spends=wallet.spend_directory.as_ref().context("missing BCH source spend directory")?;
+    for path in [&wallet.address_book_directory,spends] {
+        ensure!(path.is_absolute() && path.canonicalize()?==*path,"noncanonical BCH wallet storage");
+    }
+    Ok(sha256::Hash::hash(&serde_json::to_vec(&json!({"schema":"monzero-bch-light-wallet-identity-v1",
+        "network":network.storage_identity(),"account":account.descriptor(),
+        "addressBookDirectory":wallet.address_book_directory,"spendDirectory":spends}))?))
+}
