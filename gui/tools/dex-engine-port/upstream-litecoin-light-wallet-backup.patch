+//! Encrypted single-account recovery bundle: seed vault plus allocated indices.
+//! Not a swap-recovery backup: it excludes active trades and transaction state.
+//! A valid older backup cannot reveal allocations made after it was exported.
+use super::*;
+use crate::litecoin_light::account::allocation::AddressBook;
+const BUNDLE_MAGIC:&[u8;8]=b"MZLTCB01";
+const MAX_RECORD:usize=2_000_000;
+const PREFIX:usize=LENGTH+8;
+const MAX_BUNDLE:usize=HEADER+PREFIX+MAX_RECORD+16;
+
+/// Authenticate account ownership and both retained records under their leases.
+/// The returned bytes are encrypted; the caller must save and verify them at
+/// the chosen backup destination before claiming that a backup exists.
+pub fn export(vault:&SeedVault,book:&AddressBook,password:&[u8])->Result<Vec<u8>> {
+    let (descriptor,record)=book.backup_parts()?;
+    let account=PublicAccount::from_descriptor(&descriptor,vault.network)?;
+    drop(vault.unlock_for_account(password,&descriptor)?);
+    let seed_vault=vault.encrypted_backup(password)?;
+    let mut payload=Zeroizing::new(Vec::with_capacity(PREFIX+record.len()));
+    payload.extend_from_slice(&seed_vault);payload.extend_from_slice(&account.account_index().to_be_bytes());
+    payload.extend_from_slice(&(record.len() as u32).to_be_bytes());payload.extend_from_slice(&record);
+    encrypt(&payload,password,vault.network,vault.wallet)
+}
+/// Preflight both destinations before writing either. Publication spans two
+/// private directories, so errors can leave the vault alone published. Retrying
+/// the identical bundle completes it without overwriting different records.
+/// Callers must not activate the wallet unless this whole operation succeeds.
+pub fn restore(vault_directory:&Path,book_directory:&Path,network:LtcNetwork,wallet:Uuid,
+    password:&[u8],bundle:&[u8])->Result<(SeedVault,AddressBook)> {
+    let payload=decrypt(bundle,password,network,wallet)?;
+    ensure!(payload.len()>PREFIX,"truncated Litecoin wallet backup");
+    let account_index=u32::from_be_bytes(payload[LENGTH..LENGTH+4].try_into()?);
+    let length=u32::from_be_bytes(payload[LENGTH+4..PREFIX].try_into()?) as usize;
+    ensure!(length<=MAX_RECORD && payload.len()==PREFIX+length,"invalid address backup length");
+    let seed=unlock(&payload[..LENGTH],password,network,wallet)?;
+    let account=seed.public_account(network,account_index)?;drop(seed);
+    let vault_journal=Journal::open(vault_directory)?;
+    let book_journal=Journal::open(book_directory)?;
+    vault_journal.compatible(NAME,&payload[..LENGTH])?;
+    AddressBook::restore_preflight(&book_journal,&account,&payload[PREFIX..])?;
+    vault_journal.retain(NAME,&payload[..LENGTH])?;
+    let book=AddressBook::restore_record(book_journal,account,payload[PREFIX..].to_vec())?;
+    let vault=SeedVault {journal:vault_journal,network,wallet,bytes:payload[..LENGTH].to_vec(),usable:true};
+    Ok((vault,book))
+}
+fn encrypt(payload:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<Vec<u8>> {
+    ensure!(!wallet.is_nil() && payload.len()>PREFIX && payload.len()<=PREFIX+MAX_RECORD,"invalid wallet backup payload");
+    let mut salt=[0u8;16];let mut nonce=[0u8;24];
+    OsRng.try_fill_bytes(&mut salt).context("backup entropy unavailable")?;
+    OsRng.try_fill_bytes(&mut nonce).context("backup entropy unavailable")?;
+    let mut header=Vec::with_capacity(HEADER+payload.len()+16);
+    header.extend_from_slice(BUNDLE_MAGIC);header.extend_from_slice(network.genesis().as_bytes());header.extend_from_slice(wallet.as_bytes());
+    header.extend_from_slice(&salt);header.extend_from_slice(&nonce);
+    let key=key(password,&salt)?;let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid backup key"))?;
+    let mut encrypted=Zeroizing::new(Vec::with_capacity(payload.len()+16));encrypted.extend_from_slice(payload);
+    cipher.encrypt_in_place(XNonce::from_slice(&nonce),&header,&mut *encrypted).map_err(|_|anyhow::anyhow!("backup encryption failed"))?;
+    header.extend_from_slice(&encrypted);Ok(header)
+}
+fn decrypt(bundle:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<Zeroizing<Vec<u8>>> {
+    ensure!(!wallet.is_nil() && bundle.len()>HEADER+PREFIX+16 && bundle.len()<=MAX_BUNDLE
+        && &bundle[..8]==BUNDLE_MAGIC && &bundle[8..72]==network.genesis().as_bytes()
+        && &bundle[72..88]==wallet.as_bytes(),"invalid wallet backup context or length");
+    let key=key(password,&bundle[88..104])?;
+    let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid backup key"))?;
+    let mut payload=Zeroizing::new(bundle[HEADER..].to_vec());
+    cipher.decrypt_in_place(XNonce::from_slice(&bundle[104..128]),&bundle[..HEADER],&mut *payload)
+        .map_err(|_|anyhow::anyhow!("wallet backup authentication failed"))?;Ok(payload)
+}
