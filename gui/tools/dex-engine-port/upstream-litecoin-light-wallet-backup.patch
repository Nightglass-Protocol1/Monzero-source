+use super::*;
+use crate::litecoin_light::account::Branch;
+use std::{fs,os::unix::fs::PermissionsExt,path::PathBuf};
+const PASSWORD:&[u8]=b"PUBLIC TEST PASSWORD";
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {
+    let path=std::env::temp_dir().join(format!("monzero-wallet-backup-{}",Uuid::new_v4()));fs::create_dir(&path)?;
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))
+}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn seed()->SecretSeed {SecretSeed::from_bytes(Zeroizing::new(std::array::from_fn(|i|i as u8)))}
+#[test]
+fn wallet_backup_restores_seed_account_and_allocation_retry_identities()->Result<()> {
+    let source=Directory::new()?;let allocations=Directory::new()?;let wallet=Uuid::new_v4();let seed=seed();
+    let vault=SeedVault::create(&source.0,LtcNetwork::Regtest,wallet,PASSWORD,&seed)?;
+    let mut book=AddressBook::create(&allocations.0,seed.public_account(LtcNetwork::Regtest,2)?)?;
+    let request=Uuid::new_v4();let address=book.reserve(request,Branch::Receive)?.address().to_string();
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;book.reserve(Uuid::new_v4(),Branch::Change)?;
+    let bundle=export(&vault,&book,PASSWORD)?;
+    let destination=Directory::new()?;let destination_book=Directory::new()?;
+    let (restored,mut restored_book)=restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&bundle)?;
+    assert_eq!(*restored.unlock(PASSWORD)?.0,*seed.0);
+    assert_eq!(restored_book.allocated_count(Branch::Receive)?,2);assert_eq!(restored_book.allocated_count(Branch::Change)?,1);
+    assert_eq!(restored_book.reserve(request,Branch::Receive)?.address().to_string(),address);
+    assert_eq!(restored_book.reserve(Uuid::new_v4(),Branch::Receive)?.path().to_string(),"84'/1'/2'/0/2");
+    assert_eq!(restored_book.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string(),"84'/1'/2'/1/1");
+    drop(restored);drop(restored_book);
+    // A now-older backup cannot overwrite allocations made after this restore.
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&bundle).is_err());Ok(())
+}
+#[test]
+fn wallet_backup_rejects_mismatch_tampering_and_invalid_metadata_before_publication()->Result<()> {
+    let source=Directory::new()?;let allocations=Directory::new()?;let wallet=Uuid::new_v4();let seed=seed();
+    let vault=SeedVault::create(&source.0,LtcNetwork::Regtest,wallet,PASSWORD,&seed)?;
+    let book=AddressBook::create(&allocations.0,seed.public_account(LtcNetwork::Regtest,0)?)?;
+    let bundle=export(&vault,&book,PASSWORD)?;
+    let destination=Directory::new()?;let destination_book=Directory::new()?;
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,b"wrong",&bundle).is_err());
+    let mut changed=bundle.clone();*changed.last_mut().unwrap()^=1;
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&changed).is_err());
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Testnet,wallet,PASSWORD,&bundle).is_err());
+    let mut payload=decrypt(&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    payload[LENGTH+3]=1; // Account 1 cannot authenticate account 0's allocation record.
+    let invalid=encrypt(&payload,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&invalid).is_err());
+    assert!(!destination.0.join(NAME).exists());assert!(!destination_book.0.join("litecoin-address-book.json").exists());
+    let unrelated=Directory::new()?;
+    let other=SecretSeed::from_bytes(Zeroizing::new([42;32]));
+    let wrong_book=AddressBook::create(&unrelated.0,other.public_account(LtcNetwork::Regtest,0)?)?;
+    assert!(export(&vault,&wrong_book,PASSWORD).is_err());Ok(())
+}
+#[test]
+fn wallet_backup_restore_is_retryable_after_only_vault_record_exists()->Result<()> {
+    let source=Directory::new()?;let allocations=Directory::new()?;let wallet=Uuid::new_v4();let seed=seed();
+    let vault=SeedVault::create(&source.0,LtcNetwork::Regtest,wallet,PASSWORD,&seed)?;
+    let book=AddressBook::create(&allocations.0,seed.public_account(LtcNetwork::Regtest,0)?)?;
+    let bundle=export(&vault,&book,PASSWORD)?;
+    let destination=Directory::new()?;let destination_book=Directory::new()?;
+    // Simulate interruption after publication of the first of the two records.
+    drop(SeedVault::restore_encrypted(&destination.0,LtcNetwork::Regtest,wallet,PASSWORD,&vault.encrypted_backup(PASSWORD)?)?);
+    let (restored,restored_book)=restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&bundle)?;
+    let first=export(&restored,&restored_book,PASSWORD)?;assert_ne!(first,bundle);drop(restored);drop(restored_book);
+    let (_,book)=restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&bundle)?;
+    assert_eq!(book.allocated_count(Branch::Receive)?,0);Ok(())
+}
+#[test]
+fn wallet_backup_preflights_conflicting_address_record_before_seed_write()->Result<()> {
+    let source=Directory::new()?;let allocations=Directory::new()?;let wallet=Uuid::new_v4();let seed=seed();
+    let vault=SeedVault::create(&source.0,LtcNetwork::Regtest,wallet,PASSWORD,&seed)?;
+    let book=AddressBook::create(&allocations.0,seed.public_account(LtcNetwork::Regtest,0)?)?;
+    let bundle=export(&vault,&book,PASSWORD)?;
+    let destination=Directory::new()?;let destination_book=Directory::new()?;
+    let mut occupied=AddressBook::create(&destination_book.0,seed.public_account(LtcNetwork::Regtest,0)?)?;
+    occupied.reserve(Uuid::new_v4(),Branch::Receive)?;drop(occupied);
+    let record=fs::read(destination_book.0.join("litecoin-address-book.json"))?;
+    assert!(restore(&destination.0,&destination_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&bundle).is_err());
+    assert!(!destination.0.join(NAME).exists());assert_eq!(fs::read(destination_book.0.join("litecoin-address-book.json"))?,record);Ok(())
+}
