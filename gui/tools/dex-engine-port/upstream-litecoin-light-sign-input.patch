+//! Low-level owned-input signing. No coin selection, fee/consent policy,
+//! unspentness proof, transaction publication or live-trading authority.
+use super::*;
+use crate::litecoin_light::account::Branch;
+use bitcoin::{Transaction,TxOut,Witness,EcdsaSighashType,sighash::SighashCache,
+    secp256k1::{Secp256k1,Message},ecdsa};
+
+impl SecretSeed {
+    /// Sign exactly one native P2WPKH input, committing to all outputs. The
+    /// caller must authenticate the supplied prevout, review the entire spend
+    /// and enforce reservation/fee/recovery policy before using the witness.
+    pub fn sign_p2wpkh_input(&self,account:&PublicAccount,branch:Branch,index:u32,
+        transaction:&Transaction,input:usize,prevout:&TxOut)->Result<Witness> {
+        ensure!(!transaction.input.is_empty() && transaction.input.len()<=1000
+            && !transaction.output.is_empty() && transaction.output.len()<=1000,
+            "invalid Litecoin signing transaction size");
+        ensure!(transaction.input.iter().all(|i|!i.previous_output.is_null() && i.script_sig.is_empty()),
+            "Litecoin signing requires native witness inputs");
+        let target=transaction.input.get(input).context("missing Litecoin signing input")?;
+        ensure!(target.witness.is_empty(),"Litecoin input already has a witness");
+        let mut seen=std::collections::HashSet::new();
+        ensure!(transaction.input.iter().all(|i|seen.insert(i.previous_output)),"duplicate Litecoin signing input");
+        let actual=self.public_account(account.network(),account.account_index())?;
+        ensure!(serde_json::to_vec(&actual.descriptor())?==serde_json::to_vec(&account.descriptor())?,
+            "Litecoin signing seed does not match account");
+        let address=account.derive(branch,index)?;
+        ensure!(prevout.value.to_sat()>0 && &prevout.script_pubkey==address.address().script_pubkey(),
+            "Litecoin signing prevout does not match derived address");
+        let sighash=SighashCache::new(transaction).p2wpkh_signature_hash(input,&prevout.script_pubkey,
+            prevout.value,EcdsaSighashType::All)?;
+        let secp=Secp256k1::new();
+        let mut root=Xpriv::new_master(if account.network()==LtcNetwork::Mainnet {NetworkKind::Main}else{NetworkKind::Test},&*self.0)?;
+        let child=root.derive_priv(&secp,address.path());
+        root.private_key.non_secure_erase();root.chain_code=[0u8;32].into();
+        let mut child=child?;
+        let signature=secp.sign_ecdsa(&Message::from(sighash),&child.private_key);
+        child.private_key.non_secure_erase();child.chain_code=[0u8;32].into();
+        secp.verify_ecdsa(&Message::from(sighash),&signature,&address.public_key().0)?;
+        Ok(Witness::p2wpkh(&ecdsa::Signature {signature,sighash_type:EcdsaSighashType::All},&address.public_key().0))
+    }
+}
+#[cfg(test)]
+mod tests;
diff --git a/swap-machine/src/litecoin_light/vault/signing/tests.rs b/swap-machine/src/litecoin_light/vault/signing/tests.rs
