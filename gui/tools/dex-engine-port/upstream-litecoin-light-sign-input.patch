+use super::*;
+use bitcoin::{absolute,transaction,TxIn,OutPoint,ScriptBuf,Sequence,Amount,Txid,hashes::Hash};
+fn fixture()->Result<(SecretSeed,PublicAccount,Transaction,TxOut)> {
+    let seed=SecretSeed::from_bytes(Zeroizing::new([42;32]));
+    let account=seed.public_account(LtcNetwork::Regtest,2)?;
+    let prevout=TxOut {value:Amount::from_sat(100000),script_pubkey:account.derive(Branch::Receive,3)?.address().script_pubkey().clone()};
+    let tx=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([1;32]),vout:0},
+            script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(99000),script_pubkey:account.derive(Branch::Change,0)?.address().script_pubkey().clone()}]};
+    Ok((seed,account,tx,prevout))
+}
+#[test]
+fn owned_input_signature_commits_to_outputs_and_prevout_amount()->Result<()> {
+    let (seed,account,tx,prevout)=fixture()?;
+    let witness=seed.sign_p2wpkh_input(&account,Branch::Receive,3,&tx,0,&prevout)?;
+    assert_eq!(witness.len(),2);let signature=ecdsa::Signature::from_slice(witness.iter().next().unwrap())?;
+    assert_eq!(signature.sighash_type,EcdsaSighashType::All);
+    let key=account.derive(Branch::Receive,3)?.public_key();
+    assert_eq!(witness.iter().nth(1).unwrap(),key.0.serialize());
+    let verify=|tx:&Transaction,value:Amount|->Result<bool> {
+        let hash=SighashCache::new(tx).p2wpkh_signature_hash(0,&prevout.script_pubkey,value,EcdsaSighashType::All)?;
+        Ok(Secp256k1::verification_only().verify_ecdsa(&Message::from(hash),&signature.signature,&key.0).is_ok())
+    };
+    assert!(verify(&tx,prevout.value)?);
+    assert!(!verify(&tx,Amount::from_sat(99999))?);
+    let mut changed=tx.clone();changed.output[0].value=Amount::from_sat(98000);assert!(!verify(&changed,prevout.value)?);
+    changed=tx.clone();changed.input[0].previous_output.vout=1;assert!(!verify(&changed,prevout.value)?);
+    let mut signed=tx.clone();signed.input[0].witness=witness;
+    assert_eq!(signed.compute_txid(),tx.compute_txid());assert_ne!(signed.compute_wtxid(),tx.compute_wtxid());Ok(())
+}
+#[test]
+fn signing_refuses_wrong_ownership_and_invalid_inputs()->Result<()> {
+    let (seed,account,tx,prevout)=fixture()?;
+    assert!(seed.sign_p2wpkh_input(&account,Branch::Change,3,&tx,0,&prevout).is_err());
+    assert!(seed.sign_p2wpkh_input(&account,Branch::Receive,4,&tx,0,&prevout).is_err());
+    assert!(seed.sign_p2wpkh_input(&account,Branch::Receive,3,&tx,1,&prevout).is_err());
+    let other=SecretSeed::from_bytes(Zeroizing::new([43;32]));
+    assert!(other.sign_p2wpkh_input(&account,Branch::Receive,3,&tx,0,&prevout).is_err());
+    for mode in 0..4 {
+        let mut bad=tx.clone();
+        match mode {0=>bad.input.push(bad.input[0].clone()),1=>bad.input[0].previous_output=OutPoint::null(),
+            2=>bad.input[0].witness.push([1]),_=>bad.output.clear()}
+        assert!(seed.sign_p2wpkh_input(&account,Branch::Receive,3,&bad,0,&prevout).is_err());
+    }
+    Ok(())
+}
