+    /// Extend this branch from its next height. A short/empty response is only
+    /// a server report, never a declaration of current-chain synchronization.
+    pub async fn advance(&mut self,sequence: &mut super::headers::HeaderSequence,count: u32,now: u64) -> Result<u32> {
+        ensure!(sequence.network()==self.network && (1..=2016).contains(&count),
+            "invalid Litecoin header synchronization request");
+        let outcome=self.advance_inner(sequence,count,now).await;
+        if outcome.is_err() {self.usable=false;}
+        outcome
+    }
+    async fn advance_inner(&mut self,sequence: &mut super::headers::HeaderSequence,count: u32,now: u64) -> Result<u32> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Batch {count:u32,hex:String,max:u32}
+        let start=sequence.height().checked_add(1).context("Litecoin height exhausted")?;
+        let (_,bytes)=self.exchange("blockchain.block.headers",json!([start,count]),count as usize*160+1024).await?;
+        let batch: Batch=result(&bytes)?;
+        ensure!(batch.count<=count && batch.max>0 && batch.count<=batch.max
+            && batch.hex.len()==batch.count as usize*160,"invalid Electrum header batch");
+        if batch.count==0 {return Ok(0)}
+        let raw=decode_hex(&batch.hex,count as usize*80)?;
+        sequence.append_batch(&raw,now)
     }
 
