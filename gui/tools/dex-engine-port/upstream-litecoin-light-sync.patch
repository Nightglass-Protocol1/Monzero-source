+#[test]
+fn headers_batch_rejection_restores_prefix_and_work() -> Result<()> {
+    let mut sequence=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let original=sequence.header(0); let work=sequence.chain_work().clone();
+    let header=child(); let raw=serialize(&header); let mut invalid=raw.clone();invalid.extend(&raw);
+    assert!(sequence.append_batch(&invalid,u64::from(header.time)).is_err());
+    assert_eq!(sequence.height(),0);assert_eq!(sequence.header(0),original);assert_eq!(sequence.chain_work(),&work);
+    for bytes in [vec![],vec![0;81],vec![0;2017*80]] {
+        assert!(sequence.append_batch(&bytes,u64::from(header.time)).is_err());
+        assert_eq!(sequence.height(),0);assert_eq!(sequence.chain_work(),&work);
+    }
+    assert_eq!(sequence.append_batch(&raw,u64::from(header.time))?,1);
+    assert_eq!(sequence.chain_work(),&BigUint::from(4u8));
+    Ok(())
+}
