+#[tokio::test]
+async fn session_advances_validated_headers_and_does_not_claim_empty_reply_is_current() -> Result<()> {
+    let header=super::super::headers::tests::child();
+    let mut responses=regtest_handshake();
+    responses.push(reply(3,json!({"count":1,"hex":hex(&serialize(&header)),"max":2016})));
+    responses.push(reply(4,json!({"count":0,"hex":"","max":2016})));
+    let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut sequence=super::super::headers::HeaderSequence::new(LtcNetwork::Regtest)?;
+    assert_eq!(session.advance(&mut sequence,2,u64::from(header.time)).await?,1);
+    assert_eq!(sequence.header(1),Some(header));let work=sequence.chain_work().clone();
+    assert_eq!(session.advance(&mut sequence,2,u64::from(header.time)).await?,0);
+    assert_eq!(sequence.height(),1);assert_eq!(sequence.chain_work(),&work);
+    drop(session);let requests=task.await?;
+    assert_eq!(requests[2]["method"],"blockchain.block.headers");
+    assert_eq!(requests[2]["params"],json!([1,2]));assert_eq!(requests[3]["params"],json!([2,2]));
+    Ok(())
+}
+#[tokio::test]
+async fn session_bad_header_suffix_rolls_back_and_poisoned_session_sends_no_retry() -> Result<()> {
+    let header=super::super::headers::tests::child();let raw=hex(&serialize(&header));
+    let mut responses=regtest_handshake();responses.push(reply(3,json!({"count":2,"hex":raw.clone()+&raw,"max":2016})));
+    let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut sequence=super::super::headers::HeaderSequence::new(LtcNetwork::Regtest)?;
+    let work=sequence.chain_work().clone();
+    assert!(session.advance(&mut sequence,2,u64::from(header.time)).await.is_err());
+    assert_eq!(sequence.height(),0);assert_eq!(sequence.chain_work(),&work);
+    assert!(session.advance(&mut sequence,2,u64::from(header.time)).await.is_err());
+    drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
+#[tokio::test]
+async fn session_sync_refuses_wrong_network_and_request_limits_without_io() -> Result<()> {
+    let (stream,task)=server(handshake());
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Mainnet).await?;
+    let mut sequence=super::super::headers::HeaderSequence::new(LtcNetwork::Regtest)?;
