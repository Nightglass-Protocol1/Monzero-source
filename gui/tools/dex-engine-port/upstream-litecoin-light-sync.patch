+    /// Atomic bounded extension. A bad suffix cannot leave a trusted prefix
+    /// installed from a rejected response. No async work occurs during mutation.
+    pub fn append_batch(&mut self,bytes: &[u8],now: u64) -> Result<u32> {
+        ensure!(!bytes.is_empty() && bytes.len()%80==0 && bytes.len()<=2016*80,
+            "invalid Litecoin header batch size");
+        let length = self.headers.len(); let work = self.work.clone();
+        for header in bytes.chunks_exact(80) {
+            if let Err(error) = self.append(header,now) {
+                self.headers.truncate(length); self.work=work;
+                return Err(error);
+            }
+        }
+        Ok((bytes.len()/80) as u32)
     }
     pub fn network(&self) -> LtcNetwork { self.network }
