+fn testnet_starts_at_its_checkpoint_and_validates_real_headers_on_top() -> Result<()> {
+    let mut chain = HeaderSequence::new(LtcNetwork::Testnet)?;
+    assert_eq!((chain.height(),chain.root_height()),(4923072,4923072));
+    assert_eq!(chain.header(4923072).unwrap().block_hash().to_string(),
+        "23a8c6f649085d82f31b225ec6c77e76d446cda796001842daeaab0f55f70f27");
+    assert_eq!(chain.chain_work(),&BigUint::parse_bytes(b"06a86ddaf7625419",16).unwrap());
+    assert!(chain.header(0).is_none() && chain.header(4923061).is_none() && chain.header(4923062).is_some());
+    let start = chain.chain_work().clone();
+    for (offset,raw) in TESTNET_AFTER_CHECKPOINT.iter().enumerate() {
+        chain.append(&bytes(raw),TESTNET_AFTER_CHECKPOINT_TIME)?;
+        assert_eq!(chain.height(),4923073+offset as u32);
+    }
+    assert!(chain.chain_work()>&start);
+    // Real Scrypt work is required on top of the checkpoint.
+    let mut forged = HeaderSequence::new(LtcNetwork::Testnet)?;
+    let mut raw = bytes(TESTNET_AFTER_CHECKPOINT[0]); raw[76]^=1;
+    assert!(forged.append(&raw,TESTNET_AFTER_CHECKPOINT_TIME).is_err());
+    // A fork is only possible at or above the trusted root.
+    assert!(chain.fork(4923071).is_err());
+    let fork = chain.fork(4923080)?;
+    assert_eq!(fork.height(),4923080);assert!(fork.chain_work()<chain.chain_work());
+    // A branch rooted at genesis cannot replace a checkpoint-rooted one, or the reverse.
+    assert!(chain.adopt(HeaderSequence::from_genesis(LtcNetwork::Testnet)?).is_err());
+    assert!(HeaderSequence::from_genesis(LtcNetwork::Testnet)?.adopt(fork).is_err());
+    // Networks without a checkpoint still start at genesis.
+    assert_eq!(HeaderSequence::new(LtcNetwork::Mainnet)?.root_height(),0);
+    assert_eq!(HeaderSequence::new(LtcNetwork::Regtest)?.root_height(),0);
+    Ok(())
+}
