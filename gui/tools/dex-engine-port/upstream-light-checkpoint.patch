+#[test]
+fn checkpoint_cache_round_trip_and_older_format_is_refused() -> Result<()> {
+    use super::super::tests::{TESTNET_AFTER_CHECKPOINT,TESTNET_AFTER_CHECKPOINT_TIME};
+    let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,LtcNetwork::Testnet)?;
+    let mut chain=HeaderSequence::new(LtcNetwork::Testnet)?;
+    for raw in TESTNET_AFTER_CHECKPOINT {
+        chain.append(&(0..raw.len()).step_by(2).map(|i|u8::from_str_radix(&raw[i..i+2],16).unwrap()).collect::<Vec<_>>(),
+            TESTNET_AFTER_CHECKPOINT_TIME)?;
+    }
+    cache.save(&chain)?;
+    let path=dir.0.join(NAME);let saved=fs::read(&path)?;
+    assert_eq!(&saved[..8],MAGIC_CHECKPOINT);assert_eq!(saved.len() as u64,PREFIX_CHECKPOINT+20*80);
+    // Only the cap on height matters: the root counts toward it.
+    assert!(cache.load(4923091,TESTNET_AFTER_CHECKPOINT_TIME).is_err());
+    let restored=cache.load(4923092,TESTNET_AFTER_CHECKPOINT_TIME)?.unwrap();
+    assert_eq!(restored.height(),chain.height());assert_eq!(restored.chain_work(),chain.chain_work());
+    assert_eq!(restored.root_height(),4923072);
+    // A genesis-format cache on a checkpoint network is an error, not genesis.
+    let mut old=saved.clone();old[..8].copy_from_slice(MAGIC);old.drain(40..44);
+    fs::write(&path,&old)?;assert!(cache.load(10_000_000,TESTNET_AFTER_CHECKPOINT_TIME).is_err());
+    // The stored checkpoint height must be the pinned one.
+    let mut moved=saved.clone();moved[40]^=1;
+    fs::write(&path,&moved)?;assert!(cache.load(10_000_000,TESTNET_AFTER_CHECKPOINT_TIME).is_err());
+    Ok(())
+}
