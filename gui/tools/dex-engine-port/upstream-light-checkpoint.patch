+/// A regtest header on `previous`, mined until its work check gives `valid`.
+fn mined(previous: &Header,valid: bool) -> Result<Header> {
+    let network=LightNetwork::from(LtcNetwork::Regtest);
+    let target=network.target(0x207fffff)?;
+    for nonce in 0u32.. {
+        let header=Header {version:previous.version,prev_blockhash:previous.block_hash(),
+            merkle_root:previous.merkle_root,time:previous.time+10,bits:previous.bits,nonce};
+        if (network.pow_value(&serialize(&header))?<=target)==valid {return Ok(header)}
+    }
+    unreachable!()
+}
+#[test]
+fn cache_reload_rechecks_work_on_the_tail_and_linkage_everywhere() -> Result<()> {
+    // Heights 1..=4; height 2 carries no valid work but every other rule holds.
+    let mut chain=chain()?;
+    for valid in [false,true,true] {
+        let header=mined(&chain.header(chain.height()).unwrap(),valid)?;
+        chain.append_cached(&serialize(&header),1296688902,false)?;
+    }
+    let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,LtcNetwork::Regtest)?;
+    cache.save(&chain)?;let path=dir.0.join(NAME);let original=fs::read(&path)?;
+    // Work below a two-header tail is fixed by the hash chain, not rechecked.
+    assert_eq!(cache.load_checking(4,1296688902,2)?.unwrap().height(),4);
+    // Once the bad header is inside the rechecked tail, the load fails.
+    assert!(cache.load_checking(4,1296688902,3).is_err());
+    // Short chains are always rechecked in full by the public load.
+    assert!(cache.load(4,1296688902).is_err());
+    // Changing an old header breaks its child's link even without a work check.
+    let mut tampered=original.clone();
+    tampered[PREFIX as usize+80+76]^=1; // nonce of height 2
+    fs::write(&path,&tampered)?;
+    assert!(cache.load_checking(4,1296688902,2).is_err());
+    Ok(())
+}
