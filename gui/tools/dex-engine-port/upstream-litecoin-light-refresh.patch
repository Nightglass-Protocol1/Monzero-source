+//! One bounded refresh against a borrowed, unchanged selected header chain.
+//! Returned amounts remain provisional: peer omissions, mempool effects and
+//! freshness are not resolved. This module grants no spend/sign capability.
+use super::*;
+use super::{history::ReportedPosition,scan::{BranchScan,ScanStop}};
+use crate::litecoin_light::{account::{PublicAccount,Branch},accounting::ObservedWallet};
+use bitcoin::{OutPoint,ScriptBuf};
+use std::collections::{BTreeMap,BTreeSet};
+
+pub struct RefreshLimits {
+    pub gap:u32,
+    pub addresses_per_branch:u32,
+    pub history_entries_per_branch:usize,
+}
+pub struct WalletObservation {
+    receive:BranchScan,
+    change:BranchScan,
+    accounting:ObservedWallet,
+    pending_reports:usize,
+}
+impl WalletObservation {
+    pub fn receive(&self)->&BranchScan {&self.receive}
+    pub fn change(&self)->&BranchScan {&self.change}
+    pub fn accounting(&self)->&ObservedWallet {&self.accounting}
+    /// Distinct unverified mempool reports, excluded from confirmed accounting.
+    /// Their spending effects have NOT been subtracted from returned amounts.
+    pub fn pending_reports(&self)->usize {self.pending_reports}
+}
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    /// Allocated counts are receive/change high-water marks from retained state.
+    /// Both branches must reach their reported gap; otherwise no snapshot returns.
+    pub async fn refresh_wallet(&mut self,chain:&super::super::headers::HeaderSequence,
+        account:&PublicAccount,allocated:[u32;2],limits:&RefreshLimits)->Result<WalletObservation> {
+        ensure!(chain.network()==self.network && account.network()==self.network
+            && allocated.iter().all(|count|*count<=10_000)
+            && (1..=500).contains(&limits.addresses_per_branch)
+            && (1..=500).contains(&limits.gap)
+            && (1..=1000).contains(&limits.history_entries_per_branch),"invalid Litecoin wallet refresh request");
+        let result=self.refresh_inner(chain,account,allocated,limits).await;
+        if result.is_err() {self.usable=false;}
+        result
+    }
+    async fn refresh_inner(&mut self,chain:&super::super::headers::HeaderSequence,
+        account:&PublicAccount,allocated:[u32;2],limits:&RefreshLimits)->Result<WalletObservation> {
+        let receive=self.scan_branch(account,Branch::Receive,allocated[0],limits.gap,
+            limits.addresses_per_branch,limits.history_entries_per_branch).await?;
+        ensure!(receive.stop()==ScanStop::ReportedGap,"incomplete Litecoin receiving scan");
+        let change=self.scan_branch(account,Branch::Change,allocated[1],limits.gap,
+            limits.addresses_per_branch,limits.history_entries_per_branch).await?;
+        ensure!(change.stop()==ScanStop::ReportedGap,"incomplete Litecoin change scan");
+        let mut scripts=Vec::new();
+        let mut reports:BTreeMap<Txid,(ReportedPosition,BTreeSet<ScriptBuf>)>=BTreeMap::new();
+        for (branch,scan) in [(Branch::Receive,&receive),(Branch::Change,&change)] {
+            for index in 0..scan.scanned() {scripts.push(account.derive(branch,index)?.address().script_pubkey().clone());}
+            for address in scan.reported() {
+                let script=account.derive(branch,address.index())?.address().script_pubkey().clone();
+                for report in address.history() {
+                    let entry=reports.entry(report.txid()).or_insert_with(||(report.position(),BTreeSet::new()));
+                    ensure!(entry.0==report.position(),"inconsistent Litecoin history positions");
+                    entry.1.insert(script.clone());
+                }
+            }
+        }
+        let mut transactions=Vec::new();let mut pending_reports=0;let mut effects=0usize;
+        for (txid,(position,_)) in &reports {
+            if let ReportedPosition::Block(height)=position {
+                let transaction=self.transaction_on(chain,*height,*txid).await?;
+                effects=effects.checked_add(transaction.inputs().len()+transaction.outputs().len())
+                    .context("Litecoin refresh effect count overflow")?;
+                ensure!(effects<=100_000,"Litecoin refresh effect budget exhausted");
+                transactions.push(transaction);
+            } else {pending_reports+=1;}
+        }
+        let mut previous=BTreeMap::new();
+        for transaction in &transactions {
+            for (index,output) in transaction.outputs().iter().enumerate() {
+                previous.insert(OutPoint {txid:transaction.txid(),vout:index as u32},&output.script_pubkey);
+            }
+        }
+        for transaction in &transactions {
+            for script in &reports.get(&transaction.txid()).context("missing Litecoin history claim")?.1 {
+                let pays=transaction.outputs_to(script).next().is_some();
+                let spends=transaction.inputs().iter().any(|input|previous.get(input).is_some_and(|parent|*parent==script));
+                ensure!(pays || spends,"Litecoin history transaction has no proven script relation");
+            }
+        }
+        let accounting=ObservedWallet::reconcile(chain,&scripts,&transactions)?;
+        Ok(WalletObservation {receive,change,accounting,pending_reports})
+    }
+}
