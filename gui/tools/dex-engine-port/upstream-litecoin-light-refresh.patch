+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,session::tests::{server,reply,regtest_handshake}};
+use bitcoin::{bip32::Xpriv,NetworkKind};
+fn account()->PublicAccount {
+    PublicAccount::from_master(&Xpriv::new_master(NetworkKind::Test,&[1;32]).unwrap(),LtcNetwork::Regtest,0).unwrap()
+}
+fn limits()->RefreshLimits {RefreshLimits {gap:1,addresses_per_branch:3,history_entries_per_branch:10}}
+fn report(height:i32)->Value {json!([{"tx_hash":"11".repeat(32),"height":height}])}
+#[tokio::test]
+async fn refresh_empty_wallet_queries_both_branches_and_records_tip()->Result<()> {
+    let mut responses=regtest_handshake();responses.extend([reply(3,json!([])),reply(4,json!([]))]);
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let chain=HeaderSequence::new(LtcNetwork::Regtest)?;let account=account();
+    let result=session.refresh_wallet(&chain,&account,[0,0],&limits()).await?;
+    assert_eq!(result.accounting().observed_mature().to_sat(),0);assert_eq!(result.accounting().tip(),chain.header(0).unwrap().block_hash());
+    assert_eq!(result.pending_reports(),0);assert_eq!(result.receive().scanned(),1);assert_eq!(result.change().scanned(),1);
+    drop(session);let requests=task.await?;
+    for (index,branch) in [(2,Branch::Receive),(3,Branch::Change)] {
+        assert_eq!(requests[index]["params"],json!([script_hash(account.derive(branch,0)?.address().script_pubkey())]));
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn refresh_incomplete_scan_returns_no_snapshot()->Result<()> {
+    let mut responses=regtest_handshake();responses.push(reply(3,json!([])));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut limits=limits();limits.addresses_per_branch=1;
+    assert!(session.refresh_wallet(&HeaderSequence::new(LtcNetwork::Regtest)?,&account(),[2,0],&limits).await.is_err());
+    assert!(!session.usable);drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
+#[tokio::test]
+async fn refresh_rejects_inconsistent_positions_before_transaction_fetch()->Result<()> {
+    let mut responses=regtest_handshake();responses.extend([reply(3,report(1)),reply(4,json!([])),reply(5,report(2)),reply(6,json!([]))]);
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    assert!(session.refresh_wallet(&HeaderSequence::new(LtcNetwork::Regtest)?,&account(),[0,0],&limits()).await.is_err());
+    drop(session);assert_eq!(task.await?.len(),6);Ok(())
+}
+#[tokio::test]
+async fn refresh_mempool_reports_remain_explicitly_unverified()->Result<()> {
+    let mut responses=regtest_handshake();responses.extend([reply(3,report(0)),reply(4,json!([])),reply(5,report(0)),reply(6,json!([]))]);
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let result=session.refresh_wallet(&HeaderSequence::new(LtcNetwork::Regtest)?,&account(),[0,0],&limits()).await?;
+    assert_eq!(result.pending_reports(),1);assert_eq!(result.accounting().coins().len(),0);
+    drop(session);assert_eq!(task.await?.len(),6);Ok(())
+}
+#[tokio::test]
+async fn refresh_height_beyond_selected_chain_is_not_assumed_confirmed()->Result<()> {
+    let mut responses=regtest_handshake();responses.extend([reply(3,report(1)),reply(4,json!([])),reply(5,json!([]))]);
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    assert!(session.refresh_wallet(&HeaderSequence::new(LtcNetwork::Regtest)?,&account(),[0,0],&limits()).await.is_err());
+    drop(session);assert_eq!(task.await?.len(),5);Ok(())
+}
