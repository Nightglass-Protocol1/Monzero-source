+    let chain=chain()?;let credit=included(&chain,0,external(),100);
+    let pending=Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:credit.txid(),vout:0},..Default::default()}],
+        output:vec![TxOut {value:Amount::from_sat(60),script_pubkey:script()}]};
+    let mut child=pending.clone();child.input[0].previous_output=OutPoint {txid:pending.compute_txid(),vout:0};child.output[0].value=Amount::from_sat(30);
+    let confirmed=[credit];
