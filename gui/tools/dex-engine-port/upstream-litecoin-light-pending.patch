--- /dev/null
+++ b/swap-machine/src/litecoin_light/accounting/pending.rs
@@ -0,0 +1,60 @@
+use super::*;
+impl ObservedWallet {
+    /// Apply unauthenticated mempool effects conservatively. Reported spends
+    /// remove coins; reported receipts never enter confirmed amounts.
+    /// Conflicting reports fail rather than guessing replacement ordering.
+    pub fn reconcile_with_pending(chain:&headers::HeaderSequence,scripts:&[ScriptBuf],
+        confirmed:&[IncludedTransaction],pending:&[Transaction])->Result<Self> {
+        ensure!(pending.len()<=10_000,"Litecoin pending transaction limit exceeded");
+        let mut result=Self::reconcile(chain,scripts,confirmed)?;
+        let active=confirmed.iter().filter(|tx|tx.confirmations_on(chain).is_some())
+            .map(|tx|(tx.txid(),tx)).collect::<BTreeMap<_,_>>();
+        let mut reported=BTreeMap::new();let mut count=0usize;
+        for tx in pending {
+            count=count.checked_add(tx.input.len()+tx.output.len()).context("Litecoin pending effect overflow")?;
+            ensure!(count<=100_000 && !tx.is_coinbase() && !tx.input.is_empty() && !tx.output.is_empty(),
+                "invalid Litecoin pending transaction effects");
+            let txid=tx.compute_txid();
+            ensure!(!active.contains_key(&txid) && reported.insert(txid,tx).is_none(),
+                "duplicate Litecoin pending transaction identity");
+        }
+        let confirmed_spends=active.values().filter(|tx|!tx.is_coinbase())
+            .flat_map(|tx|tx.inputs().iter().copied()).collect::<BTreeSet<_>>();
+        ensure!(confirmed_spends.iter().all(|input|!reported.contains_key(&input.txid)),
+            "confirmed Litecoin spend has a reported pending parent");
+        let mut spends=BTreeSet::new();
+        for (txid,tx) in &reported {
+            for input in &tx.input {
+                let outpoint=input.previous_output;
+                ensure!(!outpoint.is_null() && outpoint.txid!=*txid && !confirmed_spends.contains(&outpoint)
+                    && spends.insert(outpoint),"conflicting Litecoin pending spend");
+                if let Some(parent)=active.get(&outpoint.txid) {
+                    ensure!((outpoint.vout as usize)<parent.outputs().len(),"invalid pending parent output");
+                    ensure!(!parent.is_coinbase() || parent.confirmations_on(chain).context("missing pending parent depth")?>=100,
+                        "pending spend of immature coinbase");
+                }
+                if let Some(parent)=reported.get(&outpoint.txid) {
+                    ensure!((outpoint.vout as usize)<parent.output.len(),"invalid pending parent output");
+                }
+            }
+        }
+        let mut retained=Vec::new();let mut removed=0u64;
+        for coin in result.coins {
+            if spends.contains(&coin.outpoint) {
+                removed=removed.checked_add(coin.amount.to_sat()).context("Litecoin pending spent overflow")?;
+                let total=if coin.maturity_satisfied() {&mut result.mature}else{&mut result.immature};
+                *total=Amount::from_sat(total.to_sat().checked_sub(coin.amount.to_sat()).context("Litecoin pending subtraction failed")?);
+            } else {retained.push(coin);}
+        }
+        let scripts=scripts.iter().collect::<BTreeSet<_>>();let mut received=0u64;
+        for (txid,tx) in &reported {
+            for (index,output) in tx.output.iter().enumerate() {
+                if scripts.contains(&output.script_pubkey) && !spends.contains(&OutPoint {txid:*txid,vout:index as u32}) {
+                    received=received.checked_add(output.value.to_sat()).context("Litecoin pending receipt overflow")?;
+                }
+            }
+        }
+        result.coins=retained;result.pending_spent=Amount::from_sat(removed);
+        result.pending_received=Amount::from_sat(received);Ok(result)
+    }
+}
