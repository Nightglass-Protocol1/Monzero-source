+async fn funded_refresh_subtracts_pending_spend_and_separates_change()->Result<()> {
+    let (fixture,account,chain)=fixture()?;let chain=chain.fork(1)?;
+    let credit=&fixture.blocks[0];let spend=&fixture.blocks[1];
+    let pending=json!({"tx_hash":spend.txid.to_string(),"height":0});
+    let mut responses=regtest_handshake();
+    responses.extend([reply(3,json!([{"tx_hash":credit.txid.to_string(),"height":1},pending])),
+        reply(4,json!([])),reply(5,json!([pending])),reply(6,json!([]))]);
+    let mut id=7;
+    for block in fixture.blocks.iter().map(|block|(block.txid,block)).collect::<BTreeMap<_,_>>().values() {
+        responses.push(reply(id,json!(block.transaction)));id+=1;
+        if block.height==1 {responses.push(reply(id,json!({"block_height":1,"pos":0,"merkle":[]})));id+=1;}
+    }
+    let expected=responses.len();let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let result=session.refresh_wallet(&chain,&account,[1,1],&limits()).await?;
+    assert_eq!(result.pending_reports(),1);let accounting=result.accounting();
+    assert_eq!(accounting.observed_mature().to_sat(),0);assert!(accounting.coins().is_empty());
+    assert_eq!(accounting.reported_pending_spent().to_sat(),100000);
+    assert_eq!(accounting.reported_pending_received().to_sat(),60000);
+    drop(session);let requests=task.await?;assert_eq!(requests.len(),expected);
