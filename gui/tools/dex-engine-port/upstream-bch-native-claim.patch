+use super::*;
+
+pub(super) async fn exercise(bch: &mut AdmittedExecution<'_>,native: &mut AdmittedExecution<'_>,
+    bch_metadata: &std::path::Path,setup: &Setup,snapshots: &PrivateStore,fixture: &Fixture,
+    rpc: &BchRpc,server: &Server,txid: Txid) -> Result<()> {
+    let observer=fixture.funding_client()?;
+    let block=Some(BlockHash::from_byte_array([6;32]));
+    assert!(native.recover_bch_native_claim(&observer,rpc,txid,block,2040).await.is_err());
+    assert!(bch.recover_bch_native_claim(&observer,rpc,txid,block,2029).await.is_err());
+    let expected_spend=setup.spend[0]+setup.spend[1];
+    let expected_view=setup.view[0].0+setup.view[1].0;
+    let claim=bch.recover_bch_native_claim(&observer,rpc,txid,block,2040).await?;
+    assert_eq!(claim.spend_key(),&expected_spend.as_bytes());
+    assert_eq!(claim.view_key(),&expected_view.as_bytes());
+    assert_eq!(claim.native_txid(),"ab".repeat(32));assert_eq!(claim.redemption_txid(),txid);
+    assert_eq!(claim.address(),bch.restore_agreement()?.owned().wallet().address());
+    fixture.confirmed.store(false,Ordering::SeqCst);
+    assert!(bch.recover_bch_native_claim(&observer,rpc,txid,block,2040).await.is_err());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    fixture.incoming_unlock.store(500,Ordering::SeqCst);
+    assert!(bch.recover_bch_native_claim(&observer,rpc,txid,block,2040).await.is_err());
+    fixture.incoming_unlock.store(0,Ordering::SeqCst);
+    for mode in [1,2,3] {
+        server.state.lock().unwrap().redemption_confirmation_mode=mode;
+        assert!(bch.recover_bch_native_claim(&observer,rpc,txid,block,2040).await.is_err());
+    }
+    server.state.lock().unwrap().redemption_confirmation_mode=0;
+    // A prepared adaptor was already exposed before external identity signing.
+    // Restore a separate metadata history where the signed envelope was never saved.
+    let copied=PrivateStore::new()?;
+    for entry in std::fs::read_dir(bch_metadata)? {
+        let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+    }
+    let signed=format!("{}.bch-success-signed",setup.quote.terms()["swapId"]);
+    std::fs::remove_file(copied.0.join(format!("{signed}-pin")))?;
+    let private=snapshots.0.join(&signed);let held=snapshots.0.join("held-signed-success-for-claim-test");
+    std::fs::rename(&private,&held)?;
+    let restored=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    let recovered=restored.recover_bch_native_claim(&observer,rpc,txid,None,2041).await;
+    std::fs::rename(&held,&private)?;
+    let recovered=recovered?;
+    assert_eq!(recovered.spend_key(),claim.spend_key());assert_eq!(recovered.view_key(),claim.view_key());
+    assert_eq!(recovered.commitment(),claim.commitment());
+    Ok(())
+}
