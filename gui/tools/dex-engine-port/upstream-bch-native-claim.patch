+//! Private native-key recovery from an exact confirmed BCH covenant spend.
+//! This capability is not approval to import a wallet or prepare/relay a payout.
+use super::*;
+use bitcoin::{BlockHash,Txid,consensus::serialize};
+use serde_json::json;
+
+/// No Debug, Clone, Serialize or key getters. Future wallet operations must use
+/// an exclusively owned local session and separate durable execution intent.
+pub struct NativeClaim {
+    spend: Zeroizing<[u8;32]>,view: Zeroizing<[u8;32]>,address: XmzAddress,
+    native_txid: String,redemption: Txid,block: BlockHash,commitment: [u8;32],
+}
+impl NativeClaim {
+    #[cfg(test)]
+    pub(crate) fn spend_key(&self) -> &[u8;32] {&self.spend}
+    #[cfg(test)]
+    pub(crate) fn view_key(&self) -> &[u8;32] {&self.view}
+
+    pub fn address(&self) -> &XmzAddress {&self.address}
+    pub fn native_txid(&self) -> &str {&self.native_txid}
+    pub fn redemption_txid(&self) -> Txid {self.redemption}
+    pub fn block(&self) -> BlockHash {self.block}
+    pub fn commitment(&self) -> &[u8;32] {&self.commitment}
+}
+impl AdmittedExecution<'_> {
+    /// The peer-supplied txid/block are search hints only. The complete confirmed
+    /// transaction must satisfy this quote's exact funding and success covenant.
+    /// Recovered keys stay private; later wallet/payout actions need fresh checks.
+    pub async fn recover_bch_native_claim(&self,native: &impl FundingObserver,bch: &BchRpc,
+        redemption: Txid,block: Option<BlockHash>,now: u64) -> Result<NativeClaim> {
+        let context=self.success_context(bch,now)?;
+        let prepared=self.load_success("prepared",&context)?.context("missing original BCH success preparation")?;
+        ensure!(now>=prepared.at,"native claim predates success preparation");
+        if let Some(signed)=self.load_success("signed",&context)? {
+            ensure!(signed.frame==prepared.frame && signed.at>=prepared.at && now>=signed.at,
+                "native claim success signature differs from original preparation or time");
+        }
+        let native_txid=context.request.proof.tx_hash.0.clone();
+        let encrypted=context.agreement.check_success_frame(self.quote,context.funding.lock_outpoint(),
+            &native_txid,&prepared.frame)?;
+        let release=hash(RECORD,&encode(&prepared)?);
+        // All historical restoration precedes the final live observations.
+        let native_evidence=xmz_funding::verify(native,context.request,&self.policy.xmz_genesis,
+            u64::from(self.policy.xmz_confirmations)).await?;
+        let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmed=match block {
+            Some(block)=>bch.confirmed_transaction(redemption,block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(redemption,minimum).await?,
+        };
+        ensure!(confirmed.deployment()==&bch.deployment_commitment()?,"BCH native recovery deployment changed");
+        ensure!(native.snapshot().await?==*native_evidence.snapshot(),"native chain changed during BCH claim recovery");
+        let raw=Zeroizing::new(serialize(confirmed.transaction()));
+        let spend=context.agreement.owned().recover_spend_key(self.quote,
+            &serialize(context.funding.transaction()),context.funding.lock_outpoint(),&raw,&encrypted)?;
+        let wallet=context.agreement.owned().wallet();
+        let address=wallet.address().clone();
+        let commitment=hash("monzero-bch-native-claim-v1",&serde_json::to_vec(&json!({
+            "quote":self.quote.commitment(),"admission":context.admission,"successPreparation":release,
+            "nativePayment":native_txid,"nativeProof":context.receipt,"address":address.to_string(),
+            "redemption":redemption,"redemptionBlock":confirmed.block(),
+            "bchDeployment":confirmed.deployment()}))?);
+        Ok(NativeClaim {spend:Zeroizing::new(spend.as_bytes()),
+            view:Zeroizing::new(wallet.private_view_key().0.as_bytes()),address,native_txid,
+            redemption,block:confirmed.block(),commitment})
+    }
+}
