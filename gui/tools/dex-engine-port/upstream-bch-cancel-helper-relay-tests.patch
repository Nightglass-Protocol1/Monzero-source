+//! Real helper cancellation relay against the owned loopback RPC fixture.
+use super::*;
+use swap_core::bch::funding::SignedFunding;
+fn invoke(helper: &std::path::Path,path: &std::path::Path,action: &str,
+    commitment: Option<&str>,success: bool) -> Result<Value> {
+    let id=uuid::Uuid::new_v4();
+    let mut request=json!({"schema":format!("monzero-bch-cancel-{action}-request-v1"),"requestId":id});
+    if let Some(commitment)=commitment {request["commitment"]=json!(commitment);}
+    let mut child=Command::new(helper).arg(format!("--cancel-{action}-stdio-v1")).arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert_eq!(output.status.success(),success,"unexpected cancellation {action}: {}",String::from_utf8_lossy(&output.stderr));
+    if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+    assert!(output.stderr.is_empty());assert!(output.stdout.len()<=16384);
+    let response:Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response.as_object().unwrap().len(),8);
+    assert_eq!(response["schema"],format!("monzero-bch-cancel-{action}-response-v1"));
+    assert_eq!(response["requestId"],id.to_string());assert_eq!(response["executable"],false);
+    assert_eq!(response["chainObserved"],action=="observe");
+    Ok(response)
+}
+pub(super) fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: &Server,rpc: &BchRpc,signed: &SignedFunding,helper: &std::path::Path,
+    admission: &std::path::Path,script: &bitcoin::Script) -> Result<()> {
+    let secrets=contents(&snapshots.0)?;
+    let original:Value=serde_json::from_slice(&std::fs::read(admission)?)?;
+    for mode in [0,1] {
+        let copied=PrivateStore::new()?;let config=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {
+            let entry=entry?;std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;
+        }
+        let mut value=original.clone();value["metadataDirectory"]=json!(copied.0);
+        let admission=config.0.join("admission.json");save(&admission,&serde_json::to_vec(&value)?)?;
+        let wrapper=config.0.join("cancel.json");
+        save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-cancel-v1",
+            "admissionConfigFile":admission,"deploymentCommitment":hex(&rpc.deployment_commitment()?)}))?)?;
+        let cookie=config.0.join("cookie");save(&cookie,b"user:pass\n")?;
+        let rpc_path=config.0.join("rpc.json");
+        save(&rpc_path,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-funding-rpc-v1",
+            "port":server.port,"wallet":"test","anchor":"bchreg:qanchor","anchorScript":script.to_hex_string(),
+            "cookieFile":cookie,"checkpointHeight":1,"checkpoint":"07".repeat(32),"subversion":"/Bitcoin Cash Node:29.0.0/"}))?)?;
+        let submission=config.0.join("submission.json");
+        save(&submission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-cancel-submission-v1",
+            "cancelConfigFile":wrapper,"rpcFile":rpc_path}))?)?;
+        let execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let recovery=execution.retained_bch_recovery()?.context("missing recovery")?;
+        let cancel=recovery.cancel().clone();drop(execution);
+        let txid=cancel.compute_txid().to_string();let trade=&setup.quote.terms()["swapId"];
+        let intent=copied.0.join(format!("{trade}.bch-cancel-relay-intent"));
+        {
+            let mut state=server.state.lock().unwrap();state.cancel=Some(cancel);state.relay_mode=mode;
+            state.observed=Some(signed.transaction().clone());state.observed_vout=signed.lock_outpoint().vout;
+            state.observation_mode=23;state.observation_chain_calls=0;state.relay_intent=Some(intent.clone());state.locked=true;
+        }
+        let calls=server.state.lock().unwrap().cancel_relay_calls;
+        let before=contents(&copied.0)?;
+        let reviewed=invoke(helper,&wrapper,"review",None,true)?;
+        let approval=reviewed["review"]["commitment"].as_str().context("missing commitment")?;
+        assert_eq!(reviewed["review"]["details"]["txid"],txid);
+        assert_eq!(invoke(helper,&wrapper,"status",None,true)?["relay"]["state"],"not-attempted");
+        invoke(helper,&submission,"submit",Some(&"00".repeat(32)),false)?;
+        assert_eq!(contents(&copied.0)?,before);
+        server.state.lock().unwrap().observation_mode=0;
+        invoke(helper,&submission,"submit",Some(approval),false)?;
+        assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls);
+        server.state.lock().unwrap().observation_mode=23;
+        invoke(helper,&submission,"submit",Some(approval),mode==0)?;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        let state=if mode==0 {"acknowledged"} else {"attempted"};
+        assert_eq!(invoke(helper,&wrapper,"status",None,true)?["relay"],json!({"state":state,"txid":txid,"confirmed":false}));
+        invoke(helper,&submission,"submit",Some(approval),mode==0)?;
+        assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        let observed=invoke(helper,&submission,"observe",None,true)?;
+        assert_eq!(observed["observation"]["txid"],txid);assert_eq!(observed["observation"]["confirmations"],"3");
+        assert_eq!(observed["relay"]["state"],state);
+        server.state.lock().unwrap().redemption_confirmation_mode=1;
+        invoke(helper,&submission,"observe",None,false)?;
+        server.state.lock().unwrap().redemption_confirmation_mode=0;
+        assert_eq!(invoke(helper,&wrapper,"status",None,true)?["relay"]["state"],state);
+        assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        assert_eq!(contents(&snapshots.0)?,secrets);
+    }
+    Ok(())
+}
