+#[cfg(target_os="linux")]
+fn verify_scan_preparation(observation:&WalletObservation,account:&PublicAccount,chain:&HeaderSequence)->Result<()> {
+    use crate::litecoin_light::{account::allocation::AddressBook,
+        vault::signing::review::confirmed::selection::preparation::PreparationPolicy};
+    use bitcoin::{Amount,TxOut};
+    use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+    struct Directory(PathBuf);
+    impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("ltc-scan-prepare-{}",uuid::Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+    impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+    let addresses=Directory::new()?;let claims=Directory::new()?;
+    let mut book=AddressBook::create(&addresses.0,PublicAccount::from_descriptor(&account.descriptor(),account.network())?)?;
+    let payment=TxOut {value:Amount::from_sat(40000),script_pubkey:account.derive(Branch::Receive,5)?.address().script_pubkey().clone()};
+    let policy=PreparationPolicy {fee:Amount::from_sat(1000),minimum_change:Amount::from_sat(1000),minimum_confirmations:1};
+    let genesis=HeaderSequence::new(LtcNetwork::Regtest)?;
+    assert!(observation.prepare_payment(&genesis,&payment,&policy,&mut book,&claims.0,uuid::Uuid::new_v4()).is_err());
+    assert_eq!(book.allocated_count(Branch::Change)?,0);
+    let operation=uuid::Uuid::new_v4();
+    let prepared=observation.prepare_payment(chain,&payment,&policy,&mut book,&claims.0,operation)?;
+    assert_eq!(prepared.transaction().input.len(),1);
+    assert_eq!(prepared.transaction().input[0].previous_output,observation.accounting().coins()[0].outpoint());
+    assert_eq!(prepared.transaction().output[0],payment);assert_eq!(prepared.fee().to_sat(),1000);
+    assert_eq!(prepared.transaction().output[1].value.to_sat(),observation.accounting().observed_mature().to_sat()-41000);
+    let commitment=prepared.signing_commitment();drop(prepared);drop(book);
+    let mut book=AddressBook::open(&addresses.0,PublicAccount::from_descriptor(&account.descriptor(),account.network())?)?;
+    let resumed=observation.prepare_payment(chain,&payment,&policy,&mut book,&claims.0,operation)?;
+    assert_eq!(resumed.signing_commitment(),commitment);assert_eq!(book.allocated_count(Branch::Change)?,1);Ok(())
+}
