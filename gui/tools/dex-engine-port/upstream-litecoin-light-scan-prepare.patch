+//! Payment preparation from the exact retained scan evidence. The server can
+//! still omit spends/history; observations do not prove complete unspentness.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,account::allocation::AddressBook,
+    vault::signing::review::confirmed::{IncludedInput,claimed::ObservedClaimedSpend,
+        selection::preparation::{PreparationPolicy,prepare_payment}}};
+use bitcoin::TxOut;
+use std::path::Path;
+use uuid::Uuid;
+impl WalletObservation {
+    /// No caller-created prevouts or derivation metadata enter this path.
+    /// Reuses inclusion evidence and ownership paths from this account's scan;
+    /// pending receipts and observed spent outputs cannot enter selection.
+    /// Requires a separately reviewed fee policy and an initialized address book.
+    pub fn prepare_payment(&self,chain:&HeaderSequence,payment:&TxOut,policy:&PreparationPolicy,
+        book:&mut AddressBook,directory:&Path,operation:Uuid)->Result<ObservedClaimedSpend> {
+        ensure!(self.accounting.coins().len()<=1000,"Litecoin payment candidate limit exceeded");
+        let transactions=self.transactions.iter().map(|tx|(tx.txid(),tx)).collect::<BTreeMap<_,_>>();
+        let mut inputs=Vec::new();
+        for coin in self.accounting.coins() {
+            let outpoint=coin.outpoint();
+            let transaction=*transactions.get(&outpoint.txid).context("missing Litecoin scanned input transaction")?;
+            let output=transaction.outputs().get(outpoint.vout as usize).context("missing Litecoin scanned output")?;
+            let (branch,index)=*self.origins.get(&output.script_pubkey).context("missing Litecoin scanned derivation")?;
+            inputs.push(IncludedInput {transaction,vout:outpoint.vout,branch,index});
+        }
+        prepare_payment(chain,&self.accounting,&self.account,&inputs,payment,policy,book,directory,operation)
+    }
+}
