+//! Dedicated wallet lifecycle for recovered native keys. No transaction
+//! construction or payout authority. Restore attempt is durable before RPC.
+use super::*;
+use crate::native_funding_rpc::wallet_session::{NativeWalletSession,SwapWalletId};
+
+const INTENT: &str = "monzero-bch-native-refund-wallet-intent-v1";
+const READY: &str = "monzero-bch-native-refund-wallet-ready-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {schema: String,binding: [u8;32],at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ready {schema: String,intent: [u8;32]}
+fn name(quote: &VerifiedBchQuote,suffix: &str) -> String {
+    format!("{}.bch-native-refund-wallet-{suffix}",quote.terms()["swapId"])
+}
+fn key_hex(bytes: &[u8;32]) -> String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+impl NativeRefund {
+    async fn check_wallet(&self,session: &mut NativeWalletSession) -> Result<()> {
+        session.verify_spend_key(&self.spend,&self.address).await?;
+        session.import_transaction(&self.native_txid,&self.address).await
+    }
+}
+impl AdmittedExecution<'_> {
+    fn refund_wallet_binding(&self,refund: &NativeRefund,id: &SwapWalletId) -> Result<[u8;32]> {
+        ensure!(refund.quote==*self.quote.commitment() && refund.admission==self.admission_digest()?,"BCH refund belongs to another execution");
+        self.refund_wallet_binding_values(&refund.address,&refund.native_txid,refund.refund,id)
+    }
+    fn refund_wallet_binding_values(&self,address: &XmzAddress,native_txid: &str,refund: Txid,id: &SwapWalletId) -> Result<[u8;32]> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH refund wallet binding role");
+        // Stable when the same spend is reconfirmed in a different block.
+        Ok(hash(INTENT,&serde_json::to_vec(&json!({"quote":self.quote.commitment(),
+            "admission":self.admission_digest()?,"wallet":id.filename(),"address":address.to_string(),
+            "nativePayment":native_txid,"refund":refund}))?))
+    }
+    fn required_refund_wallet_intent(&self,binding: &[u8;32],now: u64) -> Result<[u8;32]> {
+        let intent=self.refund_wallet_intent(binding,now)?.context("missing BCH refund wallet intent")?;
+        ensure!(optional(&self.metadata,&name(self.quote,"ready"))?.is_some(),"BCH refund wallet is not recorded ready");
+        Ok(intent)
+    }
+
+    fn refund_wallet_intent(&self,binding: &[u8;32],now: u64) -> Result<Option<[u8;32]>> {
+        let Some(bytes)=optional(&self.metadata,&name(self.quote,"intent"))? else {
+            ensure!(optional(&self.metadata,&name(self.quote,"ready"))?.is_none(),
+                "BCH refund wallet readiness lacks original intent");return Ok(None)
+        };
+        ensure!(bytes.len()<=4096,"oversized BCH refund wallet intent");
+        let intent: Intent=serde_json::from_slice(&bytes)?;
+        ensure!(intent.schema==INTENT && intent.binding==*binding && now>=intent.at
+            && serde_json::to_vec(&intent)?==bytes,"BCH refund wallet intent changed or time moved backwards");
+        let digest=hash(INTENT,&bytes);
+        if let Some(bytes)=optional(&self.metadata,&name(self.quote,"ready"))? {
+            ensure!(bytes.len()<=4096,"oversized BCH refund wallet readiness");
+            let ready: Ready=serde_json::from_slice(&bytes)?;
+            ensure!(ready.schema==READY && ready.intent==digest && serde_json::to_vec(&ready)?==bytes,
+                "BCH refund wallet readiness changed");
+        }
+        Ok(Some(digest))
+    }
+    fn retain_refund_wallet_ready(&self,intent: [u8;32]) -> Result<()> {
+        self.metadata.retain(&name(self.quote,"ready"),&serde_json::to_vec(&Ready {schema:READY.into(),intent})?)
+    }
+    /// One restore attempt only. Errors may have created/opened the wallet.
+    /// Reconcile through explicit open/check; never fall back to restoration.
+    pub async fn restore_bch_refund_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        refund: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession,password: String) -> Result<()> {
+        let password=Zeroizing::new(password);
+        let refund=self.recover_bch_native_refund(native,bch,refund,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.refund_wallet_binding(&refund,&id)?;
+        ensure!(self.refund_wallet_intent(&binding,now)?.is_none(),"BCH refund wallet restore was already attempted; open/check explicitly");
+        session.preflight_restore(&password,&refund.address).await?;
+        let bytes=serde_json::to_vec(&Intent {schema:INTENT.into(),binding,at:now})?;
+        self.metadata.retain(&name(self.quote,"intent"),&bytes)?;
+        session.restore(&id,key_hex(&refund.spend),key_hex(&refund.view),0,password.to_string(),&refund.address).await?;
+        refund.check_wallet(session).await?;
+        self.retain_refund_wallet_ready(hash(INTENT,&bytes))
+    }
+    /// Caller supplies an exclusively owned empty session. A failed open is not
+    /// permission to generate a replacement wallet or change recovered keys.
+    pub async fn open_bch_refund_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        refund: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession,password: String) -> Result<()> {
+        let password=Zeroizing::new(password);
+        let refund=self.recover_bch_native_refund(native,bch,refund,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.refund_wallet_binding(&refund,&id)?;
+        let intent=self.refund_wallet_intent(&binding,now)?.context("missing original BCH refund wallet intent")?;
+        session.open(&id,password.to_string(),&refund.address).await?;
+        refund.check_wallet(session).await?;self.retain_refund_wallet_ready(intent)
+    }
+    /// Reconcile an already-open wallet using an explicitly re-established
+    /// exclusive session. Same-session uncertainty remains an error in adapter.
+    pub async fn check_bch_refund_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        refund: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession) -> Result<()> {
+        let refund=self.recover_bch_native_refund(native,bch,refund,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.refund_wallet_binding(&refund,&id)?;
+        let intent=self.refund_wallet_intent(&binding,now)?.context("missing original BCH refund wallet intent")?;
+        refund.check_wallet(session).await?;self.retain_refund_wallet_ready(intent)
+    }
+}
+
