+use super::*;
+use crate::native_funding_rpc::wallet_session::{SwapWalletId,fixture::Fixture as WalletFixture};
+
+pub(super) async fn exercise(metadata: &std::path::Path,setup: &Setup,snapshots: &PrivateStore,
+    observer_fixture: &Fixture,rpc: &BchRpc,txid: Txid,address: &XmzAddress,spend: &[u8;32],view: &[u8;32]) -> Result<()> {
+    let observer=observer_fixture.funding_client()?;let block=Some(BlockHash::from_byte_array([6;32]));
+    let id=SwapWalletId::new(setup.quote.terms()["swapId"].parse()?)?;
+    for lost in [0,1,2] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(metadata)? {
+            let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+        }
+        let mut execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let intent=copied.0.join(format!("{}.bch-native-refund-wallet-intent",setup.quote.terms()["swapId"]));
+        let ready=copied.0.join(format!("{}.bch-native-refund-wallet-ready",setup.quote.terms()["swapId"]));
+        let wallet=WalletFixture::new(&id,address,spend,view,&"ab".repeat(32)).await?;
+        {
+            let mut state=wallet.state.lock().unwrap();state.intent=Some(intent.clone());
+            state.lose_restore=lost==1;state.lose_scan=lost==2;
+        }
+        let mut session=wallet.session()?;
+        let result=execution.restore_bch_refund_wallet(&observer,rpc,txid,block,2043,&mut session,"fixture".into()).await;
+        assert!(intent.exists());
+        if lost==0 {result?;assert!(ready.exists());} else {assert!(result.is_err());assert!(!ready.exists());}
+        assert_eq!(wallet.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="generate_from_keys").count(),1);
+        assert!(execution.restore_bch_refund_wallet(&observer,rpc,txid,block,2044,&mut wallet.session()?,"fixture".into()).await.is_err());
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let mut recovered=wallet.session()?;
+        execution.check_bch_refund_wallet(&observer,rpc,txid,block,2045,&mut recovered).await?;
+        assert!(ready.exists());
+        if lost==0 {
+            recovered.close(address).await?;
+            execution.open_bch_refund_wallet(&observer,rpc,txid,block,2046,&mut recovered,"fixture".into()).await?;
+            let saved=std::fs::read(&ready)?;std::fs::write(&ready,b"{}")?;
+            let calls=wallet.state.lock().unwrap().calls.len();
+            assert!(execution.check_bch_refund_wallet(&observer,rpc,txid,block,2047,&mut recovered).await.is_err());
+            assert_eq!(wallet.state.lock().unwrap().calls.len(),calls);
+            std::fs::write(&ready,saved)?;
+            let held=copied.0.join("held-refund-wallet-intent");std::fs::rename(&intent,&held)?;
+            assert!(execution.restore_bch_refund_wallet(&observer,rpc,txid,block,2047,&mut recovered,"fixture".into()).await.is_err());
+            assert_eq!(wallet.state.lock().unwrap().calls.len(),calls);
+            std::fs::rename(&held,&intent)?;
+        }
+        let state=wallet.state.lock().unwrap();
+        assert_eq!(state.calls.iter().filter(|m|m.as_str()=="generate_from_keys").count(),1);
+        assert!(state.calls.iter().all(|m|matches!(m.as_str(),"get_address"|"generate_from_keys"|"query_key"|"scan_tx"|"open_wallet"|"close_wallet")));
+        drop(state);
+    }
+    Ok(())
+}
