+use super::*;
+use bitcoin::{Amount,Transaction,TxIn,Txid,Sequence,Witness,absolute,transaction,consensus::encode::serialize_hex};
+use std::{io::{BufRead,BufReader,Read,Write},net::TcpListener,time::{Duration,Instant}};
+
+#[test]
+fn bch_recovery_output_enforces_refund_and_punishment_boundaries() {
+    let evidence=|confirmations|ConfirmedUnspentOutput {deployment:[1;32],outpoint:OutPoint::null(),tip:BlockHash::all_zeros(),
+        confirmations,output:TxOut {value:Amount::from_sat(10000),script_pubkey:ScriptBuf::new()}};
+    for depth in [2,3,24] {assert!(evidence(depth).require_refund_window(2,30,5).is_ok());}
+    for depth in [0,1,25,29,30,31,u64::MAX] {assert!(evidence(depth).require_refund_window(2,30,5).is_err());}
+    for depth in [0,1,29] {assert!(evidence(depth).require_punish_maturity(2,30).is_err());}
+    for depth in [30,31,65535] {assert!(evidence(depth).require_punish_maturity(2,30).is_ok());}
+    for (minimum,delay,margin) in [(0,30,5),(2,0,5),(2,65536,5),(2,30,0),(25,30,5),(u64::MAX,30,1)] {
+        assert!(evidence(3).require_refund_window(minimum,delay,margin).is_err());
+    }
+    for (minimum,delay) in [(0,30),(2,0),(2,65536)] {assert!(evidence(30).require_punish_maturity(minimum,delay).is_err());}
+    assert!(evidence(30).require_punish_maturity(31,30).is_err());
+}
+
+#[tokio::test]
+async fn bch_confirmed_output_rpc_rejects_spends_mismatches_and_tip_changes() -> Result<()> {
+    for mode in 0..=9 {
+        let tx=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+            input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([1;32]),vout:0},script_sig:ScriptBuf::new(),
+                sequence:Sequence::ZERO,witness:Witness::new()}],
+            output:vec![TxOut {value:Amount::from_sat(10000),script_pubkey:ScriptBuf::from_bytes(vec![0x51])}]};
+        let txid=tx.compute_txid();let block=BlockHash::from_byte_array([7;32]);let tip=BlockHash::from_byte_array([8;32]);
+        let checkpoint=BlockHash::from_byte_array([4;32]);let network=BchNetwork::Regtest {checkpoint_height:1,checkpoint};
+        let listener=TcpListener::bind("127.0.0.1:0")?;listener.set_nonblocking(true)?;let port=listener.local_addr()?.port();
+        let server=std::thread::spawn(move || -> Result<()> {
+            let mut methods=vec!["getnetworkinfo","getblockchaininfo","getblockhash","getblockhash","getrawtransaction","getblockheader",
+                "getnetworkinfo","getblockchaininfo","getblockhash","getblockhash",
+                "getnetworkinfo","getblockchaininfo","getblockhash","getblockhash","gettxout",
+                "getnetworkinfo","getblockchaininfo","getblockhash","getblockhash"];
+            if (1..=7).contains(&mode) {methods.truncate(15);} else if mode==8 {methods.truncate(14);}
+            for (i,method) in methods.iter().enumerate() {
+                let deadline=Instant::now()+Duration::from_secs(10);
+                let (mut socket,_)=loop {
+                    match listener.accept() {
+                        Ok(pair)=>break pair,
+                        Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>{
+                            ensure!(Instant::now()<deadline,"missing expected BCH output RPC");std::thread::sleep(Duration::from_millis(1));
+                        },
+                        Err(e)=>return Err(e.into()),
+                    }
+                };
+                socket.set_read_timeout(Some(Duration::from_secs(10)))?;
+                let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();let mut length=None;
+                loop {
+                    line.clear();ensure!(reader.read_line(&mut line)?>0,"missing BCH output fixture headers");
+                    if line=="\r\n" {break;}
+                    if let Some(value)=line.to_ascii_lowercase().strip_prefix("content-length:") {length=Some(value.trim().parse::<usize>()?);}
+                }
+                let length=length.context("missing BCH output request length")?;ensure!(length<4096,"oversized BCH output test request");
+                let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;let request:Value=serde_json::from_slice(&bytes)?;
+                ensure!(request["method"]==*method,"unexpected BCH output observation RPC order");
+                let result=match *method {
+                    "getnetworkinfo"=>json!({"subversion":"/Bitcoin Cash Node:29.0.0/","networkactive":true}),
+                    "getblockchaininfo"=>json!({"chain":"regtest","blocks":102,"headers":102,"initialblockdownload":false,
+                        "bestblockhash":if (mode==8 && i==11)||(mode==9 && i==16) {BlockHash::from_byte_array([9;32])} else {tip}}),
+                    "getblockhash"=>if request["params"]==json!([0]) {json!(network.genesis())}
+                        else {ensure!(request["params"]==json!([1]),"wrong BCH checkpoint");json!(checkpoint)},
+                    "getrawtransaction"=>{
+                        ensure!(request["params"]==json!([txid,true,block]),"wrong BCH parent lookup");
+                        json!({"in_active_chain":true,"hex":serialize_hex(&tx),"txid":txid,"blockhash":block,"confirmations":3})
+                    },
+                    "getblockheader"=>{ensure!(request["params"]==json!([block,true]),"wrong parent block");json!({"hash":block,"height":100,"confirmations":3})},
+                    _=>{
+                        ensure!(request["params"]==json!([txid,0,true]),"output lookup omitted mempool spends or changed outpoint");
+                        if mode==1 {Value::Null} else {
+                            let mut output=json!({"bestblock":tip,"confirmations":3,"value":0.0001,"coinbase":false,
+                                "scriptPubKey":{"hex":"51","addresses":[]}});
+                            match mode {
+                                2=>output["value"]=json!(0.0002),3=>output["scriptPubKey"]["hex"]=json!("52"),
+                                4=>output["coinbase"]=json!(true),5=>output["tokenData"]=json!({"category":"01".repeat(32)}),
+                                6=>output["bestblock"]=json!(BlockHash::from_byte_array([9;32])),7=>output["confirmations"]=json!(2),_=>(),
+                            }
+                            output
+                        }
+                    },
+                };
+                let body=serde_json::to_vec(&json!({"id":request["id"],"error":null,"result":result}))?;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;socket.write_all(&body)?;
+            }
+            Ok(())
+        });
+        let rpc=BchRpc::new(port,"fixture".into(),"fixture".into(),network,"fixture".into(),"bchreg:qanchor".into(),
+            ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+        let parent=rpc.confirmed_transaction(txid,block,3).await?;
+        assert!(rpc.confirmed_unspent_output(&parent,1).await.is_err());
+        let result=rpc.confirmed_unspent_output(&parent,0).await;
+        server.join().unwrap()?;
+        if mode==0 {
+            let output=result?;assert_eq!(output.outpoint(),OutPoint {txid,vout:0});assert_eq!(output.confirmations(),3);
+            assert_eq!(output.output(),&parent.transaction().output[0]);assert_eq!(output.tip(),parent.tip());
+            assert_eq!(output.deployment(),parent.deployment());output.require_refund_window(2,30,5)?;
+        } else {assert!(result.is_err(),"accepted invalid recovery output mode {mode}");}
+    }
+    Ok(())
+}
