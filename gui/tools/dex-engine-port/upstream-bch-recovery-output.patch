@@ -0,0 +1,52 @@
+//! Fresh exact-output evidence, including mempool spends, under the same tip
+//! as the independently verified parent transaction. No spending authority.
+use super::*;
+use super::confirmed::ConfirmedTransaction;
+use bitcoin::OutPoint;
+
+pub struct ConfirmedUnspentOutput {deployment: [u8;32],outpoint: OutPoint,tip: BlockHash,confirmations: u64,output: TxOut}
+impl ConfirmedUnspentOutput {
+    pub fn deployment(&self) -> &[u8;32] {&self.deployment}
+    pub fn outpoint(&self) -> OutPoint {self.outpoint}
+    pub fn tip(&self) -> BlockHash {self.tip}
+    pub fn confirmations(&self) -> u64 {self.confirmations}
+    pub fn output(&self) -> &TxOut {&self.output}
+    pub fn require_refund_window(&self,minimum: u64,punish_blocks: u32,safety_blocks: u32) -> Result<()> {
+        ensure!(minimum>0 && safety_blocks>0 && (1..=0xffff).contains(&punish_blocks)
+            && minimum.checked_add(u64::from(safety_blocks)).is_some_and(|v|v<u64::from(punish_blocks)),"invalid BCH refund safety policy");
+        ensure!(self.confirmations>=minimum && self.confirmations.checked_add(u64::from(safety_blocks))
+            .is_some_and(|v|v<u64::from(punish_blocks)),"BCH refund output is shallow or too close to punishment");
+        Ok(())
+    }
+    pub fn require_punish_maturity(&self,minimum: u64,punish_blocks: u32) -> Result<()> {
+        ensure!(minimum>0 && (1..=0xffff).contains(&punish_blocks),"invalid BCH punishment maturity policy");
+        ensure!(self.confirmations>=minimum && self.confirmations>=u64::from(punish_blocks),"BCH punishment is not mature");
+        Ok(())
+    }
+}
+impl BchRpc {
+    /// Reobserve after every tip change. Null includes both chain and mempool
+    /// spends; it never establishes who spent the output or a safe retry.
+    pub async fn confirmed_unspent_output(&self,parent: &ConfirmedTransaction,vout: u32) -> Result<ConfirmedUnspentOutput> {
+        ensure!(parent.deployment()==&self.deployment_commitment()?,"BCH output observer deployment changed");
+        let expected=parent.transaction().output.get(vout as usize).context("missing BCH parent output")?;
+        let chain=self.chain_state().await?;
+        ensure!(chain.bestblockhash==parent.tip() && chain.blocks.checked_sub(parent.height()).and_then(|v|v.checked_add(1))
+            ==Some(parent.confirmations()),"BCH parent confirmation is stale");
+        let outpoint=OutPoint {txid:parent.transaction().compute_txid(),vout};
+        let raw=self.rpc(false,"gettxout",json!([outpoint.txid,outpoint.vout,true])).await?;
+        let output: Option<Output>=serde_json::from_str(raw.get())?;
+        let output=output.context("BCH confirmed output is spent or unavailable")?;
+        ensure!(output.bestblock==chain.bestblockhash && output.confirmations==parent.confirmations()
+            && output.confirmations>0 && !output.coinbase && output.tokens.is_none()
+            && atoms(output.value.get())?==expected.value.to_sat()
+            && ScriptBuf::from_hex(&output.script.hex)?==expected.script_pubkey,"BCH confirmed output differs from exact parent");
+        let after=self.chain_state().await?;
+        ensure!(after.bestblockhash==chain.bestblockhash && after.blocks==chain.blocks,"BCH tip changed during output observation");
+        Ok(ConfirmedUnspentOutput {deployment:*parent.deployment(),outpoint,tip:chain.bestblockhash,
+            confirmations:output.confirmations,output:expected.clone()})
+    }
+}
+
+#[cfg(test)]
+mod tests;
