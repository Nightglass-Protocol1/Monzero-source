+//! Fresh confirmation of this native funder's exact retained BCH redemption.
+//! Observation does not rewrite relay history or authorize native payout.
+use super::*;
+use crate::bch_rpc::{BchRpc,confirmed::ConfirmedTransaction};
+use bitcoin::BlockHash;
+
+pub struct ConfirmedRedemption {
+    quote: [u8;32],admission: [u8;32],redemption: [u8;32],confirmation: ConfirmedTransaction,
+}
+impl ConfirmedRedemption {
+    pub fn quote(&self) -> &[u8;32] {&self.quote}
+    pub fn admission(&self) -> &[u8;32] {&self.admission}
+    pub fn redemption(&self) -> &[u8;32] {&self.redemption}
+    pub fn confirmation(&self) -> &ConfirmedTransaction {&self.confirmation}
+}
+impl AdmittedExecution<'_> {
+    /// The block is only a search hint. None requires the owned node's index.
+    /// Every call obtains fresh evidence, including after an uncertain relay.
+    pub async fn observe_bch_redemption(&self,bch: &BchRpc,block: Option<BlockHash>) -> Result<ConfirmedRedemption> {
+        let record=self.load_private_redemption()?.context("missing private BCH redemption")?;
+        let retained=summary(&record)?;
+        let (deployment,_)=self.native_bch_observation_policy()?;
+        ensure!(bch.deployment_commitment()?==deployment,"BCH redemption confirmation observer changed");
+        let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmation=match block {
+            Some(block)=>bch.confirmed_transaction(retained.txid(),block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(retained.txid(),minimum).await?,
+        };
+        ensure!(confirmation.deployment()==&deployment
+            && serialize(confirmation.transaction())==record.transaction,
+            "confirmed BCH spend differs from retained redemption");
+        Ok(ConfirmedRedemption {quote:*self.quote.commitment(),admission:record.admission,
+            redemption:*retained.commitment(),confirmation})
+    }
+}
