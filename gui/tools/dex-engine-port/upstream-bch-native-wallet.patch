+//! Shared native wallet key material, not funding or relay authority.
+//! View frames contain private view-key shares: use private authenticated
+//! transport/storage, never public order-book messages or diagnostic logs.
+use super::*;
+use curve25519_dalek_ng::{edwards::{CompressedEdwardsY,EdwardsPoint},traits::Identity};
+use sha2::{Digest,Sha256};
+use swap_core::xmz_address::XmzAddress;
+
+const VIEW_DOMAIN: &str = "monzero-bch-xmz-private-view-v1";
+const MAX_VIEW_FRAME: usize = 2048;
+
+pub struct NativePair {
+    bch: AuthenticatedNativeAdaptor, native: AuthenticatedNativeAdaptor,
+    pair_commitment: [u8;32], spend_public: [u8;32],
+}
+
+/// No Debug or implicit serialization: this includes a private view key.
+/// Local secret ownership, transcript acknowledgement, durable state and both
+/// chain observations must still be checked before funding the derived address.
+pub struct NativeWalletKeys {
+    pair: NativePair, address: XmzAddress, view: monero::PrivateViewKey,
+    transcript: [u8;32],
+}
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct ViewFrame { schema: String, pair_commitment: String, role: Role, view_share: [u8;32] }
+fn encode(frame: &ViewFrame) -> Result<Vec<u8>> {
+    Ok(serde_json::to_vec(&serde_json::to_value(frame)?)?)
+}
+fn view_key(bytes: &[u8;32]) -> Result<monero::PrivateKey> {
+    let key = monero::PrivateKey::from_slice(bytes).map_err(|_|anyhow::anyhow!("invalid BCH native view share"))?;
+    ensure!(key.as_bytes() == *bytes && *bytes != [0;32], "noncanonical or zero BCH native view share");
+    Ok(key)
+}
+
+pub fn view_signing_bytes(frame: &[u8], role: Role) -> Result<Vec<u8>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX_VIEW_FRAME,"invalid BCH private view frame size");
+    let domain = format!("{VIEW_DOMAIN}-{}",role.domain());
+    let mut bytes = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",domain.len(),domain,frame.len()).into_bytes();
+    bytes.extend_from_slice(frame); Ok(bytes)
+}
+
+impl NativePair {
+    pub fn new(quote: &VerifiedBchQuote, bch: AuthenticatedNativeAdaptor,
+        native: AuthenticatedNativeAdaptor) -> Result<Self> {
+        ensure!(bch.role == Role::BchFunder && native.role == Role::NativeFunder
+            && bch.quote_commitment == *quote.commitment() && native.quote_commitment == *quote.commitment(),
+            "BCH native pair quote or role mismatch");
+        ensure!(bch.binding.adaptor != native.binding.adaptor && bch.binding.native != native.binding.native,
+            "BCH participants reused native adaptor keys");
+        let left = CompressedEdwardsY(bch.binding.native).decompress().context("invalid BCH native pair key")?;
+        let right = CompressedEdwardsY(native.binding.native).decompress().context("invalid BCH native pair key")?;
+        let spend = left + right;
+        ensure!(spend != EdwardsPoint::identity(), "BCH native spend shares cancel");
+        let mut hash = Sha256::new(); hash.update(b"monzero-bch-xmz-native-pair-v1\0");
+        hash.update(quote.commitment()); hash.update(bch.proof_commitment); hash.update(native.proof_commitment);
+        Ok(Self { bch,native,pair_commitment:hash.finalize().into(),spend_public:spend.compress().to_bytes() })
+    }
+
+    /// This output contains a private scalar and must never be logged.
+    pub fn view_frame(&self, role: Role, share: &monero::PrivateViewKey) -> Result<Vec<u8>> {
+        view_key(&share.0.as_bytes())?;
+        encode(&ViewFrame { schema:VIEW_DOMAIN.into(),pair_commitment:hex(&self.pair_commitment),
+            role,view_share:share.0.as_bytes() })
+    }
+
+    fn verify_view(&self, quote: &VerifiedBchQuote, bytes: &[u8], signature: &[u8], role: Role)
+        -> Result<monero::PrivateKey> {
+        let message = view_signing_bytes(bytes,role)?;
+        // Suppress decoder diagnostics that could contain private material.
+        let frame: ViewFrame = serde_json::from_slice(bytes).map_err(|_|anyhow::anyhow!("invalid BCH private view frame"))?;
+        ensure!(frame.schema == VIEW_DOMAIN && frame.role == role
+            && frame.pair_commitment == hex(&self.pair_commitment), "BCH private view frame context mismatch");
+        ensure!(encode(&frame)? == bytes, "noncanonical BCH private view frame");
+        let identity = &quote.terms()[role.identity()]; let mut pin = [0;32];
+        for (i,byte) in pin.iter_mut().enumerate() { *byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?; }
+        VerifyingKey::from_bytes(&pin)?.verify_strict(&message,&Signature::from_slice(signature)?)?;
+        view_key(&frame.view_share)
+    }
+
+    /// Frames are ordered BCH funder, native funder. Both must be signed for this
+    /// exact proof pair; possession of a single participant's frame is insufficient.
+    pub fn finish(self, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        frames: [(&[u8],&[u8]);2]) -> Result<NativeWalletKeys> {
+        quote.check_policy(policy,now)?;
+        ensure!(self.bch.quote_commitment == *quote.commitment(), "BCH native wallet quote mismatch");
+        let bch = self.verify_view(quote,frames[0].0,frames[0].1,Role::BchFunder)?;
+        let native = self.verify_view(quote,frames[1].0,frames[1].1,Role::NativeFunder)?;
+        let view = bch + native;
+        ensure!(view.as_bytes() != [0;32], "BCH native view shares cancel");
+        let spend = monero::PublicKey::from_slice(&self.spend_public)?;
+        let public_view = monero::PublicKey::from_private_key(&view);
+        let address = XmzAddress::new(policy.xmz_network,monero_address::AddressType::Legacy,
+            spend.decompress(),public_view.decompress())?;
+        let mut hash = Sha256::new(); hash.update(b"monzero-bch-xmz-native-wallet-v1\0"); hash.update(self.pair_commitment);
+        for (frame,signature) in frames { hash.update((frame.len() as u64).to_be_bytes()); hash.update(frame); hash.update(signature); }
+        Ok(NativeWalletKeys { pair:self,address,view:monero::PrivateViewKey(view),transcript:hash.finalize().into() })
+    }
+}
+
+impl NativeWalletKeys {
+    pub fn address(&self) -> &XmzAddress { &self.address }
+    pub fn private_view_key(&self) -> &monero::PrivateViewKey { &self.view }
+    pub fn transcript_commitment(&self) -> &[u8;32] { &self.transcript }
+
+    /// Reconstruct the native spend key only when the local secret matches its
+    /// authenticated share and the exact peer-revealing BCH spend verifies.
+    /// Caller must independently establish confirmation/reorg and release policy.
+    pub fn recover_spend_key(&self, quote: &VerifiedBchQuote, local_role: Role, local: &monero::PrivateKey,
+        funding: &[u8], outpoint: OutPoint, spend: &[u8], encrypted: &EncryptedSignature) -> Result<monero::PrivateKey> {
+        let (own,peer) = match local_role { Role::BchFunder => (&self.pair.bch,&self.pair.native),
+            Role::NativeFunder => (&self.pair.native,&self.pair.bch) };
+        ensure!(monero::PublicKey::from_private_key(local).decompress().compress().to_bytes() == own.binding.native,
+            "BCH native local secret differs from authenticated share");
+        let recovered = peer.recover_from_spend(quote,funding,outpoint,spend,encrypted)?;
+        let combined = *local + recovered;
+        ensure!(monero::PublicKey::from_private_key(&combined).decompress().compress().to_bytes() == self.pair.spend_public,
+            "recovered BCH native wallet key differs from shared address");
+        Ok(combined)
+    }
+}
