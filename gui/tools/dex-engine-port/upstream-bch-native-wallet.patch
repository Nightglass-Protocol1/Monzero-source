+use super::*;
+use crate::{bch_quote::tests::{fixture,signed},common::CROSS_CURVE_PROOF_SYSTEM};
+use swap_core::compat::IntoDalekNg;
+use ed25519_dalek::{Signer,SigningKey};
+use ecdsa_fun::fun::Scalar;
+use bitcoin::{absolute,consensus::serialize,hashes::Hash,transaction::Version,
+    Amount,Sequence,Transaction,TxIn,TxOut,Txid,Witness};
+fn sign(bytes: &[u8], role: Role, view: bool) -> Vec<u8> {
+    let key = SigningKey::from_bytes(&[if role == Role::BchFunder {1} else {2};32]);
+    let message = if view { view_signing_bytes(bytes,role) } else { super::super::signing_bytes(bytes,role) }.unwrap();
+    key.sign(&message).to_bytes().to_vec()
+}
+struct Setup {
+    policy: Policy, quote: VerifiedBchQuote, spend: Vec<monero::PrivateKey>, view: Vec<monero::PrivateViewKey>,
+    frames: Vec<Vec<u8>>, signatures: Vec<Vec<u8>>,
+}
+impl Setup {
+    fn new() -> Result<Self> {
+        let (policy,terms) = fixture(); let quote = signed(&terms,&policy,1000)?;
+        let mut setup = Self {policy,quote,spend:vec![],view:vec![],frames:vec![],signatures:vec![]};
+        for role in [Role::BchFunder,Role::NativeFunder] {
+            let scalar = monero::Scalar::random(&mut rand::thread_rng());
+            let (proof,(secp,edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&scalar.into_dalek_ng(),&mut rand::thread_rng());
+            let frame = super::super::frame(&setup.quote,role,secp.into(),edwards.compress().to_bytes(),proof)?;
+            setup.signatures.push(sign(&frame,role,false)); setup.frames.push(frame);
+            setup.spend.push(monero::PrivateKey::from_scalar(scalar));
+            setup.view.push(monero::PrivateViewKey::new_random(&mut rand::thread_rng()));
+        }
+        Ok(setup)
+    }
+    fn pair(&self) -> Result<NativePair> {
+        NativePair::new(&self.quote,
+            AuthenticatedNativeAdaptor::verify(&self.frames[0],&self.signatures[0],&self.quote,&self.policy,1000,Role::BchFunder)?,
+            AuthenticatedNativeAdaptor::verify(&self.frames[1],&self.signatures[1],&self.quote,&self.policy,1000,Role::NativeFunder)?)
+    }
+}
+
+#[test]
+fn shared_wallet_matches_recovered_success_and_refund_spend_keys() -> Result<()> {
+    let setup = Setup::new()?; let pair = setup.pair()?;
+    let b = pair.view_frame(Role::BchFunder,&setup.view[0])?;
+    let n = pair.view_frame(Role::NativeFunder,&setup.view[1])?;
+    let bs = sign(&b,Role::BchFunder,true); let ns = sign(&n,Role::NativeFunder,true);
+    let wallet = pair.finish(&setup.quote,&setup.policy,1000,[(&b,&bs),(&n,&ns)])?;
+    let spend = setup.spend[0]+setup.spend[1]; let view = setup.view[0].0+setup.view[1].0;
+    let expected = XmzAddress::new(setup.policy.xmz_network,monero_address::AddressType::Legacy,
+        monero::PublicKey::from_private_key(&spend).decompress(),monero::PublicKey::from_private_key(&view).decompress())?;
+    assert_eq!(wallet.address(),&expected);
+    assert_eq!(wallet.private_view_key().0.as_bytes(),view.as_bytes());
+    assert_eq!(wallet.transcript_commitment(),setup.pair()?.finish(&setup.quote,&setup.policy,1000,[(&b,&bs),(&n,&ns)])?.transcript_commitment());
+    let plan = setup.quote.recovery_plan();
+    let funding = Transaction { version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([7;32]),vout:0},
+            script_sig:bitcoin::ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(plan.terms().locked_atoms),script_pubkey:plan.lock().script_pubkey()}] };
+    let first = OutPoint {txid:funding.compute_txid(),vout:0};
+    let cancel = plan.lock().prepare_timeout(&serialize(&funding),&plan.lock_spend_terms(first))?;
+    for (local_index,role) in [(0,Role::BchFunder),(1,Role::NativeFunder)] {
+        let peer_index = 1-local_index;
+        let peer: super::super::Frame = serde_json::from_slice(&setup.frames[peer_index])?;
+        let (covenant,raw,outpoint,tag) = if local_index == 0 {
+            (plan.lock(),serialize(&funding),first,3)
+        } else { (plan.recovery(),serialize(&cancel),OutPoint {txid:cancel.compute_txid(),vout:0},4) };
+        let secret = Scalar::from_bytes([tag;32]).unwrap().non_zero().unwrap();
+        let encrypted = covenant.data_message().encrypted_sign(&secret,&peer.adaptor_key.into());
+        let mut decrypt = setup.spend[peer_index].as_bytes(); decrypt.reverse();
+        let decrypt = Scalar::from_bytes(decrypt).unwrap().non_zero().unwrap();
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize()).unwrap();
+        let der = covenant.data_message().decrypt(&signer,&decrypt,encrypted.clone())?;
+        let terms = if local_index == 0 {plan.lock_spend_terms(outpoint)} else {plan.recovery_spend_terms(outpoint)};
+        let tx = covenant.prepare_redemption(&raw,&terms,&der)?;
+        assert_eq!(wallet.recover_spend_key(&setup.quote,role,&setup.spend[local_index],&raw,outpoint,&serialize(&tx),&encrypted)?.as_bytes(),spend.as_bytes());
+        assert!(wallet.recover_spend_key(&setup.quote,role,&setup.spend[peer_index],&raw,outpoint,&serialize(&tx),&encrypted).is_err());
+    }
+    Ok(())
+}
+
+#[test]
+fn private_view_frames_require_exact_pair_role_signatures_and_canonical_scalars() -> Result<()> {
+    let setup = Setup::new()?; let pair = setup.pair()?;
+    let b = pair.view_frame(Role::BchFunder,&setup.view[0])?;
+    let n = pair.view_frame(Role::NativeFunder,&setup.view[1])?;
+    let bs = sign(&b,Role::BchFunder,true); let ns = sign(&n,Role::NativeFunder,true);
+    assert!(setup.pair()?.finish(&setup.quote,&setup.policy,2000,[(&b,&bs),(&n,&ns)]).is_err());
+    assert!(setup.pair()?.finish(&setup.quote,&setup.policy,1000,[(&n,&ns),(&b,&bs)]).is_err());
+    assert!(setup.pair()?.finish(&setup.quote,&setup.policy,1000,[(&b,&ns),(&n,&bs)]).is_err());
+    let mut variants = vec![];
+    for scalar in [[0;32],[255;32]] {
+        let mut frame: ViewFrame = serde_json::from_slice(&b)?; frame.view_share = scalar;
+        variants.push(encode(&frame)?);
+    }
+    let mut wrong_pair: ViewFrame = serde_json::from_slice(&b)?;
+    wrong_pair.pair_commitment = "00".repeat(32); variants.push(encode(&wrong_pair)?);
+    let mut duplicate = b.clone(); duplicate.splice(1..1,b"\"schema\":\"ignored\",".iter().copied()); variants.push(duplicate);
+    for invalid in variants {
+        let signature = sign(&invalid,Role::BchFunder,true);
+        assert!(setup.pair()?.finish(&setup.quote,&setup.policy,1000,[(&invalid,&signature),(&n,&ns)]).is_err());
+    }
+    let mut cancelling: ViewFrame = serde_json::from_slice(&n)?;
+    let first = curve25519_dalek_ng::scalar::Scalar::from_canonical_bytes(setup.view[0].0.as_bytes()).unwrap();
+    cancelling.view_share = (-first).to_bytes();
+    let bytes = encode(&cancelling)?; let signature = sign(&bytes,Role::NativeFunder,true);
+    assert!(setup.pair()?.finish(&setup.quote,&setup.policy,1000,[(&b,&bs),(&bytes,&signature)]).is_err());
+    Ok(())
+}
+
+#[test]
+fn different_roles_cannot_reuse_the_same_native_share() -> Result<()> {
+    let setup = Setup::new()?;
+    let mut reused: super::super::Frame = serde_json::from_slice(&setup.frames[0])?;
+    reused.role = Role::NativeFunder;
+    let bytes = super::super::canonical(&reused)?; let signature = sign(&bytes,Role::NativeFunder,false);
+    let bch = AuthenticatedNativeAdaptor::verify(&setup.frames[0],&setup.signatures[0],&setup.quote,&setup.policy,1000,Role::BchFunder)?;
+    let native = AuthenticatedNativeAdaptor::verify(&bytes,&signature,&setup.quote,&setup.policy,1000,Role::NativeFunder)?;
+    assert!(NativePair::new(&setup.quote,bch,native).is_err());
+    Ok(())
+}
