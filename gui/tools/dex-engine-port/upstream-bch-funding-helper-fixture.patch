+//! Funding review through the production helper over retained signed funding.
+use super::*;
+use std::{path::PathBuf,process::{Command,Stdio}};
+use sha2::{Digest,Sha256};
+use std::os::unix::fs::PermissionsExt;
+fn hex(bytes: &[u8]) -> String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+fn save(path: &std::path::Path,bytes: &[u8]) -> Result<()> {
+    std::fs::write(path,bytes)?;
+    std::fs::set_permissions(path,std::fs::Permissions::from_mode(0o600))?;
+    Ok(())
+}
+fn contents(path: &std::path::Path) -> Result<std::collections::BTreeMap<std::ffi::OsString,Vec<u8>>> {
+    std::fs::read_dir(path)?.map(|entry| {let entry=entry?;
+        Ok((entry.file_name(),std::fs::read(entry.path())?))}).collect()
+}
+#[tokio::test]
+#[ignore = "requires a separately built and digest-pinned BCH helper"]
+async fn bch_funding_helper_reviews_retained_transaction_without_rpc_or_writes() -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let helper_digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==helper_digest,"invalid helper pin");
+    let clock=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    let base=clock.checked_sub(60).context("invalid fixture clock")?;
+    let network = BchNetwork::Regtest {checkpoint_height:1,checkpoint:BlockHash::from_byte_array([7;32])};
+    let setup = Setup::with_network_at(Some(network),base,base+3500)?;
+    let snapshots = PrivateStore::new()?; let metadata = PrivateStore::new()?;
+    let (selected,own,initial) = selected_with_outgoing_at(&setup,&snapshots.0,0,base)?;
+    let (native_selected,peer,native_initial) = selected_with_outgoing_at(&setup,&snapshots.0,1,base)?;
+    let (wallet,received) = selected.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+        base+3,own.commitment(),peer.frame(),peer.signature())?;
+    let ack = wallet.acknowledgement(&setup.quote)?;
+    let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,base+4,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder,&agreed)?;
+    let pins = NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+    let consent = agreement::execution::approval::review_admission(&setup.quote,&setup.policy,
+        Role::BchFunder,&pins,base+5)?;
+    let mut execution = AdmittedExecution::admit_reviewed(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,
+        Role::BchFunder,&consent.commitment,pins.clone(),base+5)?;
+    let secret = bitcoin::secp256k1::SecretKey::from_slice(&[5;32])?;
+    let public = bitcoin::PublicKey::new(bitcoin::secp256k1::PublicKey::from_secret_key(&bitcoin::secp256k1::Secp256k1::new(),&secret));
+    let script = bitcoin::ScriptBuf::new_p2pkh(&public.pubkey_hash());
+    let parent = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:bitcoin::ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(111_000),script_pubkey:script.clone()}]};
+    let outpoint = OutPoint {txid:parent.compute_txid(),vout:0};
+    let mut funding = parent.clone(); funding.input[0].previous_output = outpoint;
+    funding.output = vec![TxOut {value:Amount::from_sat(100_000),script_pubkey:setup.quote.recovery_plan().lock().script_pubkey()},
+        TxOut {value:Amount::from_sat(10_000),script_pubkey:script.clone()}];
+    execution.retain_bch_funding_preparation(base+6,&serialize(&funding),&[&serialize(&parent)],&script,1000,546)?;
+    let intent = metadata.0.join(format!("{}.bch-funding-wallet-lock-intent",setup.quote.terms()["swapId"]));
+    let server = Server::start(script.clone(),outpoint,intent.clone(),network)?;
+    let backend = |wallet: &str,password: &str| BchRpc::new(server.port,"user".into(),password.into(),network,
+        wallet.into(),"bchreg:qanchor".into(),script.clone(),"/Bitcoin Cash Node:29.0.0/".into());
+    let rpc = backend("test","pass")?;
+    execution.lock_bch_funding_inputs(&rpc,base+7,"bchreg:qchange",3).await?;
+    server.state.lock().unwrap().sign_intent=Some(metadata.0.join(
+        format!("{}.bch-funding-signing-intent",setup.quote.terms()["swapId"])));
+    let signing=execution.review_bch_funding_signing(&rpc,base+8)?;
+    let signed=execution.sign_bch_funding(&rpc,&signing.commitment,base+9).await?;
+    let (native_wallet,native_received)=native_selected.retain_received_view(&snapshots.0,
+        &setup.quote,&setup.policy,base+3,peer.commitment(),own.frame(),own.signature())?;
+    let ack=native_wallet.acknowledgement(&setup.quote)?;
+    let agreed=native_wallet.accept_agreement(&setup.quote,&setup.policy,base+4,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let native_agreement=agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder,&agreed)?;
+    let native_pins=NegotiationPins {initial:native_initial,selection:*native_selected.commitment(),
+        outgoing:*peer.commitment(),received:native_received,agreement:native_agreement};
+    let native_metadata=PrivateStore::new()?;
+    let mut native=AdmittedExecution::admit(&native_metadata.0,&snapshots.0,&setup.quote,&setup.policy,
+        Role::NativeFunder,setup.quote.commitment(),native_pins,base+5)?;
+    let frame=native.prepare_bch_refund_adaptor(base+6)?;
+    let signature=SigningKey::from_bytes(&[2;32]).sign(&agreement::refund::signing_bytes(&frame)?).to_bytes();
+    let refund=native.retain_outgoing_bch_refund(base+7,&signature)?;
+    execution.accept_bch_refund_adaptor(base+10,refund.frame(),refund.signature())?;
+    execution.retain_bch_recovery(base+11)?;
+    let expected=execution.review_bch_funding_relay(&rpc,clock)?;
+    let deployment=rpc.deployment_commitment()?;
+    assert_eq!(execution.review_bch_funding_relay_for_deployment(&deployment,clock)?.details,expected.details);
+    assert!(execution.review_bch_funding_relay_for_deployment(&[0;32],clock).is_err());
+    assert!(execution.review_bch_funding_relay_for_deployment(&deployment,base+3500).is_err());
+    drop(execution);
+    let config_store=PrivateStore::new()?;
+    let quote_path=config_store.0.join("quote.json");save(&quote_path,&setup.quote.record()?)?;
+    let config_path=config_store.0.join("admission.json");
+    save(&config_path,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":helper_digest,"quoteFile":quote_path,
+        "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"bch-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":snapshots.0,"negotiationPins":pins}))?)?;
+    let funding_path=config_store.0.join("funding.json");
+    let config=json!({"schema":"monzero-private-bch-funding-v1",
+        "admissionConfigFile":config_path,"deploymentCommitment":hex(&deployment)});
+    save(&funding_path,&serde_json::to_vec(&config)?)?;
+    // Stop the mock before review: successful helper execution cannot rely on RPC.
+    assert_eq!(server.state.lock().unwrap().relay_calls,0);
+    drop(server);
+    let invoke=|success: bool| -> Result<Value> {
+        let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+        let id=uuid::Uuid::new_v4();
+        let mut child=Command::new(&helper).arg("--funding-review-stdio-v1").arg(&funding_path)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("missing stdin")?.write_all(&serde_json::to_vec(&json!({
+            "schema":"monzero-bch-funding-review-request-v1","requestId":id}))?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty());assert!(output.stdout.len()<=16384);
+        let response:Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(response["schema"],"monzero-bch-funding-review-response-v1");
+        assert_eq!(response["requestId"],id.to_string());
+        assert_eq!(response["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(response["executable"],false);assert_eq!(response["chainObserved"],false);
+        Ok(response)
+    };
+    let response=invoke(true)?;
+    assert_eq!(response["review"]["details"],expected.details);
+    assert_eq!(response["review"]["commitment"],hex(&expected.commitment));
+    assert_eq!(response["review"]["details"]["fundingTxid"],signed.lock_outpoint().txid.to_string());
+    let mut wrong=config.clone();wrong["deploymentCommitment"]=json!("22".repeat(32));
+    save(&funding_path,&serde_json::to_vec(&wrong)?)?;invoke(false)?;
+    save(&funding_path,&serde_json::to_vec(&config)?)?;
+    let approval=metadata.0.join(format!("{}.bch-execution-approval-bch-funder",setup.quote.terms()["swapId"]));
+    let consent=std::fs::read(&approval)?;std::fs::remove_file(&approval)?;invoke(false)?;
+    save(&approval,&consent)?;
+    let recovery=metadata.0.join(format!("{}.bch-funding-recovery-pin",setup.quote.terms()["swapId"]));
+    let pin=std::fs::read(&recovery)?;save(&recovery,b"{}")?;invoke(false)?;
+    save(&recovery,&pin)?;invoke(true)?;
+    Ok(())
+}
