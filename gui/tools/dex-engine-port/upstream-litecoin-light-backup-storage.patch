+//! Private backup destination publication and authenticated read-back.
+//! A successful read does not prove a separate/offline copy or backup freshness.
+use super::*;
+use bitcoin::hashes::{Hash,sha256};
+const FILE:&str="litecoin-wallet.backup";
+
+/// Public recovery metadata only; no seed or password serialization.
+pub struct BackupInfo {
+    digest:sha256::Hash,
+    account:PublicAccount,
+    wallet:Uuid,
+    allocated:[u32;2],
+}
+impl BackupInfo {
+    pub fn digest(&self)->sha256::Hash {self.digest}
+    pub fn account(&self)->&PublicAccount {&self.account}
+    pub fn wallet_id(&self)->Uuid {self.wallet}
+    /// Receiving then change counts, authenticated against the recovered seed.
+    pub fn allocated(&self)->[u32;2] {self.allocated}
+}
+/// Authenticate encrypted data without restoring or writing wallet files.
+pub fn inspect(bundle:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<BackupInfo> {
+    let (_payload,account,allocated)=decode_checked(bundle,password,network,wallet)?;
+    Ok(BackupInfo {digest:sha256::Hash::hash(bundle),account,wallet,allocated})
+}
+/// The destination is an existing canonical private directory. The fixed file
+/// name prevents path traversal. Different backup contents are never replaced;
+/// use a new destination directory for a newer backup generation.
+pub fn save_verified(directory:&Path,bundle:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<BackupInfo> {
+    save_with(directory,bundle,password,network,wallet,|journal,bytes|journal.retain(FILE,bytes))
+}
+fn save_with(directory:&Path,bundle:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid,
+    publish:impl FnOnce(&Journal,&[u8])->Result<()>)->Result<BackupInfo> {
+    let info=inspect(bundle,password,network,wallet)?;
+    let journal=Journal::open(directory)?;publish(&journal,bundle)?;
+    ensure!(journal.read(FILE)?==bundle,"Litecoin backup read-back mismatch");Ok(info)
+}
+/// Read and authenticate an existing backup. No implicit creation or mutation.
+/// Returns encrypted bytes for the separately explicit restore operation.
+pub fn load_verified(directory:&Path,password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<(Vec<u8>,BackupInfo)> {
+    let journal=Journal::open(directory)?;let bundle=journal.read(FILE)?;
+    let info=inspect(&bundle,password,network,wallet)?;Ok((bundle,info))
+}
