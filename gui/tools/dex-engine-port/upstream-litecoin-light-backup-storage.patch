+use super::*;
+use crate::litecoin_light::account::Branch;
+use std::{fs,os::unix::fs::{PermissionsExt,symlink},path::PathBuf};
+const PASSWORD:&[u8]=b"PUBLIC TEST PASSWORD";
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {
+    let path=std::env::temp_dir().join(format!("monzero-backup-storage-{}",Uuid::new_v4()));fs::create_dir(&path)?;
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))
+}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn fixture()->Result<(Vec<u8>,Uuid)> {
+    let vault_dir=Directory::new()?;let book_dir=Directory::new()?;let wallet=Uuid::new_v4();
+    let seed=SecretSeed::from_bytes(Zeroizing::new([42;32]));
+    let vault=SeedVault::create(&vault_dir.0,LtcNetwork::Regtest,wallet,PASSWORD,&seed)?;
+    let mut book=AddressBook::create(&book_dir.0,seed.public_account(LtcNetwork::Regtest,3)?)?;
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;book.reserve(Uuid::new_v4(),Branch::Change)?;
+    Ok((export(&vault,&book,PASSWORD)?,wallet))
+}
+#[test]
+fn saved_backup_authenticates_readback_and_restores_allocation_metadata()->Result<()> {
+    let (bundle,wallet)=fixture()?;let destination=Directory::new()?;
+    let receipt=save_verified(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    assert_eq!(receipt.digest(),sha256::Hash::hash(&bundle));assert_eq!(receipt.allocated(),[1,1]);
+    assert_eq!(receipt.wallet_id(),wallet);assert_eq!(receipt.account().account_index(),3);
+    assert_eq!(fs::metadata(destination.0.join(FILE))?.permissions().mode()&0o777,0o600);
+    assert_eq!(save_verified(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?.digest(),receipt.digest());
+    let (loaded,info)=load_verified(&destination.0,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    assert_eq!(loaded,bundle);assert_eq!(info.digest(),receipt.digest());
+    let restored_vault=Directory::new()?;let restored_book=Directory::new()?;
+    let (_,book)=restore(&restored_vault.0,&restored_book.0,LtcNetwork::Regtest,wallet,PASSWORD,&loaded)?;
+    assert_eq!(book.allocated_count(Branch::Receive)?,1);assert_eq!(book.allocated_count(Branch::Change)?,1);Ok(())
+}
+#[test]
+fn backup_storage_refuses_bad_auth_conflicts_and_unsafe_files()->Result<()> {
+    let (bundle,wallet)=fixture()?;let destination=Directory::new()?;
+    assert!(save_verified(&destination.0,&bundle,b"wrong",LtcNetwork::Regtest,wallet).is_err());assert!(!destination.0.join(FILE).exists());
+    save_verified(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    let path=destination.0.join(FILE);let before=fs::read(&path)?;
+    let payload=decrypt(&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    let different=encrypt(&payload,PASSWORD,LtcNetwork::Regtest,wallet)?;
+    assert!(save_verified(&destination.0,&different,PASSWORD,LtcNetwork::Regtest,wallet).is_err());assert_eq!(fs::read(&path)?,before);
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o644))?;
+    assert!(load_verified(&destination.0,PASSWORD,LtcNetwork::Regtest,wallet).is_err());
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o600))?;
+    let mut tampered=before.clone();*tampered.last_mut().unwrap()^=1;fs::write(&path,tampered)?;
+    assert!(load_verified(&destination.0,PASSWORD,LtcNetwork::Regtest,wallet).is_err());
+    fs::remove_file(&path)?;let other=destination.0.join("target");fs::write(&other,&before)?;symlink(&other,&path)?;
+    assert!(save_verified(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet).is_err());assert_eq!(fs::read(other)?,before);Ok(())
+}
+#[test]
+fn backup_storage_retries_uncertain_publication_and_checks_readback()->Result<()> {
+    let (bundle,wallet)=fixture()?;let destination=Directory::new()?;
+    assert!(save_with(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet,|journal,bytes| {
+        journal.retain(FILE,bytes)?;anyhow::bail!("injected lost publication result")
+    }).is_err());
+    assert_eq!(save_verified(&destination.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet)?.digest(),sha256::Hash::hash(&bundle));
+    let absent=Directory::new()?;
+    assert!(save_with(&absent.0,&bundle,PASSWORD,LtcNetwork::Regtest,wallet,|_,_|Ok(())).is_err());
+    assert!(load_verified(&absent.0,PASSWORD,LtcNetwork::Regtest,wallet).is_err());Ok(())
+}
