+//! Recovery for both acknowledged and uncertain native payment relay.
+use super::*;
+pub(super) async fn exercise(sender:&AdmittedExecution<'_>,native:&AdmittedExecution<'_>,setup:&Setup,
+    fixture:&Fixture,rpc:&BchRpc,bch:&OwnedBchObserver,server:&Server)->Result<()> {
+    let recovery=sender.retained_bch_recovery()?.context("missing BCH refund fixture")?;
+    let transaction:Transaction=bitcoin::consensus::deserialize(recovery.refund_bytes())?;
+    let txid=transaction.compute_txid();let block=Some(BlockHash::from_byte_array([6;32]));
+    server.state.lock().unwrap().refund=Some(transaction);
+    let observer=fixture.funding_client()?;
+    let calls=fixture.calls.lock().unwrap().len();
+    assert!(sender.recover_light_bch_native_refund(&observer,bch,txid,block,2030).await.is_err());
+    assert!(native.recover_bch_native_refund(&observer,rpc,txid,block,2030).await.is_err());
+    assert_eq!(fixture.calls.lock().unwrap().len(),calls);
+    fixture.incoming.store(true,Ordering::SeqCst);fixture.confirmed.store(false,Ordering::SeqCst);
+    assert!(native.recover_light_bch_native_refund(&observer,bch,txid,block,2030).await.is_err());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    assert!(native.recover_light_bch_native_refund(&observer,bch,txid,block,1000).await.is_err());
+    let recovered=native.recover_light_bch_native_refund(&observer,bch,txid,block,2030).await?;
+    assert_eq!(recovered.spend_key(),&(setup.spend[0]+setup.spend[1]).as_bytes());
+    assert_eq!(recovered.view_key(),&native.restore_agreement()?.owned().wallet().private_view_key().0.as_bytes());
+    assert_eq!(recovered.address(),native.restore_agreement()?.owned().wallet().address());
+    assert_eq!(recovered.native_txid(),"ab".repeat(32));assert_eq!(recovered.refund_txid(),txid);
+    assert_eq!(native.recover_light_bch_native_refund(&observer,bch,txid,None,2031).await?.commitment(),recovered.commitment());
+    for mode in [1,2,3] {
+        server.state.lock().unwrap().redemption_confirmation_mode=mode;
+        assert!(native.recover_light_bch_native_refund(&observer,bch,txid,block,2031).await.is_err());
+    }
+    server.state.lock().unwrap().redemption_confirmation_mode=0;
+    fixture.incoming_unlock.store(500,Ordering::SeqCst);
+    assert!(native.recover_light_bch_native_refund(&observer,bch,txid,block,2031).await.is_err());
+    fixture.incoming_unlock.store(0,Ordering::SeqCst);
+    assert_eq!(native.recover_light_bch_native_refund(&observer,bch,txid,block,2031).await?.commitment(),recovered.commitment());
+    fixture.incoming.store(false,Ordering::SeqCst);fixture.confirmed.store(false,Ordering::SeqCst);
+    server.state.lock().unwrap().refund=None;
+    assert!(!fixture.calls.lock().unwrap()[calls..].iter().any(|v|v=="transfer" || v=="relay_tx"));
+    Ok(())
+}
