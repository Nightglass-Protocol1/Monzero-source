@@ -0,0 +1,66 @@
+use super::*;
+#[derive(Deserialize)]
+struct Fixture {seed:String,blocks:Vec<Block>}
+#[derive(Deserialize)]
+#[serde(rename_all="camelCase")]
+struct Block {height:u32,header:String,transaction:String,txid:Txid,block_hash:BlockHash}
+fn fixture()->Result<(Fixture,PublicAccount,HeaderSequence)> {
+    let fixture:Fixture=serde_json::from_str(include_str!("../fixture.json"))?;
+    let master=Xpriv::new_master(NetworkKind::Test,&decode_hex(&fixture.seed,32)?)?;
+    let account=PublicAccount::from_master(&master,LtcNetwork::Regtest,0)?;
+    let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    for block in &fixture.blocks {
+        assert_eq!(chain.append(&decode_hex(&block.header,80)?,1296689052)?,block.block_hash);
+    }
+    Ok((fixture,account,chain))
+}
+async fn run(short:bool,unrelated:bool,corrupt:bool)->Result<()> {
+    let (fixture,account,chain)=fixture()?;
+    let chain=if short {chain.fork(1)?} else {chain};
+    let credit=&fixture.blocks[0];let spend=&fixture.blocks[1];
+    let credit_report=json!({"tx_hash":credit.txid.to_string(),"height":1});
+    let spend_report=json!({"tx_hash":spend.txid.to_string(),"height":2});
+    let mut responses=regtest_handshake();
+    responses.push(reply(3,if short {json!([credit_report])} else {json!([credit_report,spend_report])}));
+    responses.push(reply(4,json!([])));
+    responses.push(reply(5,if short {json!([])} else if unrelated {json!([credit_report,spend_report])} else {json!([spend_report])}));
+    if !short {responses.push(reply(6,json!([])));}
+    let selected=fixture.blocks.iter().take(if short {1}else{2}).map(|block|(block.txid,block)).collect::<BTreeMap<_,_>>();
+    let first_id=responses.len() as u64+1;
+    for (offset,block) in selected.values().enumerate() {
+        let id=first_id+offset as u64*2;
+        responses.push(reply(id,json!(block.transaction)));
+        let pos=if corrupt && offset+1==selected.len() {1}else{0};
+        responses.push(reply(id+1,json!({"block_height":block.height,"pos":pos,"merkle":[]})));
+    }
+    let expected=responses.len();
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let result=session.refresh_wallet(&chain,&account,[1,if short {0}else{1}],&limits()).await;
+    if unrelated || corrupt {
+        assert!(result.is_err());assert!(!session.usable);
+    } else {
+        let result=result?;let accounting=result.accounting();
+        assert_eq!(accounting.observed_mature().to_sat(),if short {100000}else{60000});
+        assert_eq!(accounting.observed_immature().to_sat(),0);assert_eq!(result.pending_reports(),0);
+        assert_eq!(accounting.coins().len(),1);
+        assert_eq!(accounting.coins()[0].outpoint().txid,if short {credit.txid}else{spend.txid});
+        assert_eq!(accounting.coins()[0].confirmations(),1);
+    }
+    drop(session);let requests=task.await?;assert_eq!(requests.len(),expected);
+    for (offset,block) in selected.values().enumerate() {
+        let index=first_id as usize-1+offset*2;
+        assert_eq!(requests[index]["method"],"blockchain.transaction.get");
+        assert_eq!(requests[index]["params"],json!([block.txid.to_string(),false]));
+        assert_eq!(requests[index+1]["method"],"blockchain.transaction.get_merkle");
+        assert_eq!(requests[index+1]["params"],json!([block.txid.to_string(),block.height]));
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn funded_refresh_verifies_receipt_spend_and_change()->Result<()> {run(false,false,false).await}
+#[tokio::test]
+async fn funded_refresh_recomputes_on_branch_without_spend()->Result<()> {run(true,false,false).await}
+#[tokio::test]
+async fn funded_refresh_rejects_proven_but_unrelated_history_claim()->Result<()> {run(false,true,false).await}
+#[tokio::test]
+async fn funded_refresh_rejects_invalid_inclusion_without_snapshot()->Result<()> {run(false,false,true).await}
