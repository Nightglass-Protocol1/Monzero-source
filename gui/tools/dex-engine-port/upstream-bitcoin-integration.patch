@@ -17,6 +17,48 @@ pub struct TestEnv<'a> {
     pub electrs_port: u16,
     _bitcoind_container: Container<'a, bitcoind::Bitcoind>,
     _electrs_container: Container<'a, electrs::Electrs>,
+    // Drop containers before their owned network.
+    _network: IsolatedNetwork,
+}
+
+struct IsolatedNetwork(String);
+
+impl IsolatedNetwork {
+    fn new(name: String) -> Result<Self> {
+        let output = std::process::Command::new("docker").args([
+            "network", "create", "--internal", "--driver", "bridge", "--opt",
+            "com.docker.network.bridge.host_binding_ipv4=127.0.0.1", &name,
+        ]).output().context("create isolated test network")?;
+        if !output.status.success() { anyhow::bail!("Failed to create isolated test network"); }
+        let owned = Self(name);
+        let inspected = std::process::Command::new("docker")
+            .args(["network", "inspect", &owned.0]).output().context("inspect test network")?;
+        if !inspected.status.success() { anyhow::bail!("Failed to inspect test network"); }
+        let value: serde_json::Value = serde_json::from_slice(&inspected.stdout)?;
+        let network = &value[0];
+        if network["Internal"] != true || network["Driver"] != "bridge"
+            || network["Options"]["com.docker.network.bridge.host_binding_ipv4"] != "127.0.0.1" {
+            anyhow::bail!("Test network isolation settings did not match");
+        }
+        Ok(owned)
+    }
+}
+
+impl Drop for IsolatedNetwork {
+    fn drop(&mut self) {
+        let removed = std::process::Command::new("docker")
+            .args(["network", "rm", &self.0]).output();
+        if !removed.is_ok_and(|output| output.status.success()) {
+            eprintln!("Could not remove owned test network {}", self.0);
+        }
+    }
+}
+
+#[test]
+fn isolated_network_configuration() {
+    let name = format!("monzero-btc-it-{}", random_prefix());
+    let network = IsolatedNetwork::new(name).expect("isolated local Docker network");
+    drop(network);
 }
 
