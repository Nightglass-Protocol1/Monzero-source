--- /dev/null
+++ b/swap-machine/src/bch_key_recovery/authenticated/native_wallet/tests/wallet_locks/signing/relay/message/native/relay/proof.rs
@@ -0,0 +1,74 @@
+use super::*;
+use agreement::execution::funding::native::proof;
+
+pub(super) async fn exercise(bch: &mut AdmittedExecution<'_>,native: &mut AdmittedExecution<'_>,
+    setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,fixture: &Fixture) -> Result<()> {
+    let key = SigningKey::from_bytes(&[2;32]);let wrong = SigningKey::from_bytes(&[1;32]);
+    let before = fixture.calls.lock().unwrap().len();
+    assert!(bch.prepare_bch_native_proof(2025).is_err());
+    assert!(native.prepare_bch_native_proof(1024).is_err());
+    assert!(bch.received_bch_native_proof()?.is_none());
+    // Commercial expiry does not hide an already acknowledged payment's proof.
+    let frame = native.prepare_bch_native_proof(2025)?;
+    assert_eq!(*native.prepare_bch_native_proof(2026)?,*frame);
+    assert!(native.prepare_bch_native_proof(2024).is_err());
+    let sig = key.sign(&proof::signing_bytes(&frame)?).to_bytes();
+    assert!(native.retain_outgoing_bch_native_proof(2026,&wrong.sign(&proof::signing_bytes(&frame)?).to_bytes()).is_err());
+    let outgoing = native.retain_outgoing_bch_native_proof(2026,&sig)?;
+    assert_eq!(outgoing.frame(),&*frame);assert_eq!(outgoing.signature(),sig);
+    assert!(native.accept_bch_native_proof(2027,&frame,&sig).is_err());
+    assert!(bch.accept_bch_native_proof(2027,&frame,&wrong.sign(&proof::signing_bytes(&frame)?).to_bytes()).is_err());
+    assert!(bch.accept_bch_native_proof(1020,&frame,&sig).is_err());
+    let original: Value = serde_json::from_slice(&frame)?;
+    for (field,value) in [("schema",json!("changed")),("amount",json!(101001)),
+        ("genesis",json!("00".repeat(32))),("destination",json!(setup.quote.terms()["xmzPayout"])),
+        ("bch_txid",json!("00".repeat(32))),("bch_vout",json!(999)),("swap",json!("changed"))] {
+        // Preserve canonical field order so each rejection tests the binding.
+        let old = format!("\"{field}\":{}",serde_json::to_string(&original[field])?);
+        let new = format!("\"{field}\":{}",serde_json::to_string(&value)?);
+        let changed = zeroize::Zeroizing::new(std::str::from_utf8(&frame)?.replacen(&old,&new,1).into_bytes());
+        assert_ne!(*changed,*frame);
+        let signature = key.sign(&proof::signing_bytes(&changed)?).to_bytes();
+        assert!(bch.accept_bch_native_proof(2027,&changed,&signature).is_err(),"changed {field}");
+    }
+    let mut spaced = zeroize::Zeroizing::new(frame.to_vec());spaced.push(b' ');
+    assert!(bch.accept_bch_native_proof(2027,&spaced,&key.sign(&proof::signing_bytes(&spaced)?).to_bytes()).is_err());
+    bch.accept_bch_native_proof(2027,&frame,&sig)?;
+    bch.accept_bch_native_proof(2028,&frame,&sig)?;
+    assert!(bch.accept_bch_native_proof(2026,&frame,&sig).is_err());
+    let replacement = zeroize::Zeroizing::new(std::str::from_utf8(&frame)?.replacen(&"ab".repeat(32),&"cd".repeat(32),1).into_bytes());
+    assert!(bch.accept_bch_native_proof(2028,&replacement,&key.sign(&proof::signing_bytes(&replacement)?).to_bytes()).is_err());
+    assert_eq!(bch.received_bch_native_proof()?.unwrap().frame(),&*frame);
+    assert_eq!(fixture.calls.lock().unwrap().len(),before);
+
+    let restored_metadata = copy_store(metadata)?;
+    let restored = AdmittedExecution::resume(&restored_metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    assert_eq!(restored.outgoing_bch_native_proof()?.unwrap().frame(),&*frame);
+    let private = snapshots.0.join(format!("{}.bch-funding-native-proof-received",setup.quote.terms()["swapId"]));
+    let saved = zeroize::Zeroizing::new(std::fs::read(&private)?);std::fs::write(&private,b"{}")?;
+    assert!(bch.received_bch_native_proof().is_err());std::fs::write(&private,&*saved)?;
+    let pin = metadata.0.join(format!("{}.bch-funding-native-proof-outgoing-pin",setup.quote.terms()["swapId"]));
+    std::fs::rename(&pin,metadata.0.join("saved-proof-pin"))?;
+    assert!(native.outgoing_bch_native_proof().is_err());
+    std::fs::rename(metadata.0.join("saved-proof-pin"),&pin)?;
+
+    fixture.incoming.store(true,Ordering::SeqCst);
+    let observer = fixture.funding_client()?;
+    assert!(native.observe_bch_native_payment(&observer).await.is_err());
+    assert!(bch.observe_bch_native_payment(&observer).await.is_err());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    let evidence = bch.observe_bch_native_payment(&observer).await?;
+    assert_eq!(evidence.quote(),setup.quote.commitment());
+    assert_eq!(evidence.agreement(),bch.restore_agreement()?.commitment());
+    assert_eq!(evidence.funding().request().amount.atoms(),101_000);
+    assert_eq!(evidence.funding().height(),100);
+    fixture.incoming_unlock.store(500,Ordering::SeqCst);
+    assert!(bch.observe_bch_native_payment(&observer).await.is_err());
+    fixture.incoming_unlock.store(0,Ordering::SeqCst);
+    fixture.confirmed.store(false,Ordering::SeqCst);
+    assert!(bch.observe_bch_native_payment(&observer).await.is_err());
+    fixture.incoming.store(false,Ordering::SeqCst);
+    assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="transfer").count(),1);
+    assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="relay_tx").count(),1);
+    Ok(())
+}
