+++ b/swap-machine/src/bch_key_recovery/authenticated/native_wallet/agreement/execution/funding/native/proof.rs
@@ -0,0 +1,188 @@
+//! Authenticated private payment-proof handoff. Peer claims are not chain
+//! evidence; observation is fresh and cannot authorize success release alone.
+use super::*;
+use swap_core::monero::TransferProof;
+use bitcoin::OutPoint;
+use crate::xmz_funding::{self,FundingObserver,FundingRequest,VerifiedFunding};
+use zeroize::Zeroize;
+
+const FRAME: &str = "monzero-bch-native-payment-proof-v1";
+const RECORD: &str = "monzero-bch-native-payment-record-v1";
+const PIN: &str = "monzero-bch-native-payment-pin-v1";
+const MAX_FRAME: usize = 8192;
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    schema: String, quote: [u8;32], agreement: [u8;32], swap: String,
+    bch_txid: String, bch_vout: u32, genesis: String, destination: String,
+    amount: u64, proof: TransferProof,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record { schema: String, frame: Vec<u8>, signature: Option<Vec<u8>> }
+impl Drop for Record {fn drop(&mut self) {self.frame.zeroize();}}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin {schema: String, admission: [u8;32], at: u64, record: [u8;32]}
+/// Contains a private transaction key. Send only to the authenticated peer over
+/// protected transport; never expose in public status, logs or review details.
+pub struct NativePaymentMessage {frame: Zeroizing<Vec<u8>>,signature: Vec<u8>}
+impl NativePaymentMessage {
+    pub fn frame(&self) -> &[u8] {&self.frame}
+    pub fn signature(&self) -> &[u8] {&self.signature}
+}
+/// Point-in-time evidence only. Neither serializable nor a release approval.
+pub struct NativePaymentConfirmation {funding: VerifiedFunding,quote: [u8;32],agreement: [u8;32]}
+impl NativePaymentConfirmation {
+    pub fn funding(&self) -> &VerifiedFunding {&self.funding}
+    pub fn quote(&self) -> &[u8;32] {&self.quote}
+    pub fn agreement(&self) -> &[u8;32] {&self.agreement}
+}
+pub fn signing_bytes(frame: &[u8]) -> Result<Zeroizing<Vec<u8>>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX_FRAME,"invalid native proof frame size");
+    let mut bytes = Zeroizing::new(format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",FRAME.len(),FRAME,frame.len()).into_bytes());
+    bytes.extend_from_slice(frame);Ok(bytes)
+}
+fn encode(record: &Record) -> Result<Zeroizing<Vec<u8>>> {
+    let mut bytes = Zeroizing::new(Vec::with_capacity(65536));
+    serde_json::to_writer(&mut *bytes,record)?;
+    ensure!(bytes.len() <= 65536,"oversized native proof record");Ok(bytes)
+}
+fn slot(quote: &VerifiedBchQuote,stage: &str) -> String {record_name(quote,&format!("native-proof-{stage}"))}
+
+impl AdmittedExecution<'_> {
+    fn native_proof_context(&self) -> Result<(AgreedNativeWallet,OutPoint,u64)> {
+        let agreed = self.restore_agreement()?;
+        let (message,at) = match self.role {
+            Role::NativeFunder => (self.received_bch_funding_message()?.context("missing received BCH funding")?,
+                self.acknowledged_bch_native_at()?),
+            Role::BchFunder => (self.outgoing_bch_funding_message()?.context("missing outgoing BCH funding")?,
+                self.outgoing_bch_funding_at()?),
+        };
+        // The signed BCH bytes were independently revalidated by the handoff.
+        let signed = message.signed().lock_outpoint();
+        Ok((agreed,signed,at))
+    }
+    fn check_native_proof(&self,bytes: &[u8]) -> Result<Frame> {
+        ensure!(!bytes.is_empty() && bytes.len() <= MAX_FRAME,"invalid native proof size");
+        let frame: Frame = serde_json::from_slice(bytes)?;
+        let (agreed,bch,_) = self.native_proof_context()?;
+        ensure!(*Zeroizing::new(serde_json::to_vec(&frame)?) == bytes && frame.schema == FRAME
+            && frame.quote == *self.quote.commitment() && frame.agreement == *agreed.commitment()
+            && frame.swap == self.quote.terms()["swapId"] && frame.bch_txid == bch.txid.to_string()
+            && frame.bch_vout == bch.vout && frame.genesis == self.policy.xmz_genesis
+            && frame.destination == agreed.owned().wallet().address().to_string()
+            && frame.amount == self.quote.terms()["xmzAtoms"].parse::<u64>()?,"native proof differs from agreed trade");
+        let txid = &frame.proof.tx_hash.0;
+        ensure!(txid.len() == 64 && txid.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+            && txid != &"0".repeat(64) && frame.proof.tx_key.as_bytes() != [0;32],"invalid native payment proof");
+        if self.role == Role::NativeFunder {
+            ensure!(&frame.proof == self.load_bch_native_funding()?.proof(),"outgoing proof differs from retained payment");
+        }
+        Ok(frame)
+    }
+    fn authenticate_native_proof(&self,bytes: &[u8],signature: &[u8]) -> Result<Frame> {
+        let identity = &self.quote.terms()[Role::NativeFunder.identity()];let mut pin = [0;32];
+        for (i,byte) in pin.iter_mut().enumerate() {*byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?;}
+        VerifyingKey::from_bytes(&pin)?.verify_strict(&signing_bytes(bytes)?,&Signature::from_slice(signature)?)?;
+        self.check_native_proof(bytes)
+    }
+    fn retained_native_proof(&self,stage: &str) -> Result<Option<(Record,Pin)>> {
+        let name = slot(self.quote,stage);let pin_name = format!("{name}-pin");
+        let private = optional(&Journal::open(&self.snapshots)?,&name)?.map(Zeroizing::new);
+        let Some(pin_bytes) = optional(&self.metadata,&pin_name)? else {
+            ensure!(private.is_none(),"private native proof exists without trusted pin");return Ok(None)
+        };
+        ensure!(pin_bytes.len() <= 4096,"oversized native proof pin");
+        let pin: Pin = serde_json::from_slice(&pin_bytes)?;
+        let bytes = private.context("native proof private record is missing")?;
+        ensure!(bytes.len() <= 65536 && pin.schema == PIN && pin.admission == self.admission_digest()?
+            && pin.record == hash(RECORD,&bytes) && serde_json::to_vec(&pin)? == pin_bytes,"native proof pin changed");
+        let record: Record = serde_json::from_slice(&bytes)?;
+        ensure!(record.schema == RECORD && *encode(&record)? == *bytes,"native proof record changed");
+        let (_,_,earliest) = self.native_proof_context()?;
+        ensure!(pin.at >= earliest,"native proof predates funding handoff or payment relay");
+        if stage == "prepared" {
+            ensure!(self.role == Role::NativeFunder && record.signature.is_none(),"invalid proof preparation owner");
+            self.check_native_proof(&record.frame)?;
+        } else {
+            self.authenticate_native_proof(&record.frame,record.signature.as_deref().context("missing native proof identity signature")?)?;
+            if stage == "outgoing" {
+                ensure!(self.role == Role::NativeFunder,"wrong outgoing proof owner");
+                let (original,prepared) = self.retained_native_proof("prepared")?.context("missing native proof preparation")?;
+                ensure!(record.frame == original.frame && pin.at >= prepared.at,"native proof differs from preparation");
+            } else {ensure!(stage == "received" && self.role == Role::BchFunder,"wrong native proof receipt owner");}
+        }
+        Ok(Some((record,pin)))
+    }
+    fn retain_native_proof(&self,stage: &str,record: &Record,now: u64) -> Result<()> {
+        let (_,_,earliest) = self.native_proof_context()?;
+        ensure!(now >= earliest,"native proof predates funding handoff or payment relay");
+        if let Some((old,pin)) = self.retained_native_proof(stage)? {
+            ensure!(now >= pin.at && *encode(&old)? == *encode(record)?,"native proof already retained differently");return Ok(())
+        }
+        let bytes = encode(record)?;
+        let pin = Pin {schema:PIN.into(),admission:self.admission_digest()?,at:now,record:hash(RECORD,&bytes)};
+        let name = slot(self.quote,stage);
+        self.metadata.retain(&format!("{name}-pin"),&serde_json::to_vec(&pin)?)?;
+        Journal::open(&self.snapshots)?.retain(&name,&bytes)?;
+        Ok(())
+    }
+
+    /// Sending an already acknowledged payment proof may finish after quote
+    /// expiry. It neither constructs a payment nor renews commercial validity.
+    pub fn prepare_bch_native_proof(&mut self,now: u64) -> Result<Zeroizing<Vec<u8>>> {
+        ensure!(self.role == Role::NativeFunder,"wrong native proof sender");
+        let (agreed,bch,earliest) = self.native_proof_context()?;
+        ensure!(now >= earliest,"native proof predates acknowledged relay");
+        if let Some((record,pin)) = self.retained_native_proof("prepared")? {
+            ensure!(now >= pin.at,"native proof preparation time moved backwards");
+            return Ok(Zeroizing::new(record.frame.clone()))
+        }
+        let prepared = self.load_bch_native_funding()?;
+        let frame = Frame {schema:FRAME.into(),quote:*self.quote.commitment(),agreement:*agreed.commitment(),
+            swap:self.quote.terms()["swapId"].clone(),bch_txid:bch.txid.to_string(),
+            bch_vout:bch.vout,genesis:self.policy.xmz_genesis.clone(),
+            destination:agreed.owned().wallet().address().to_string(),amount:self.quote.terms()["xmzAtoms"].parse()?,
+            proof:prepared.proof().clone()};
+        let bytes = Zeroizing::new(serde_json::to_vec(&frame)?);self.check_native_proof(&bytes)?;
+        self.retain_native_proof("prepared",&Record {schema:RECORD.into(),frame:bytes.to_vec(),signature:None},now)?;
+        Ok(bytes)
+    }
+    pub fn retain_outgoing_bch_native_proof(&mut self,now: u64,signature: &[u8]) -> Result<NativePaymentMessage> {
+        ensure!(self.role == Role::NativeFunder,"wrong native proof sender");
+        let (mut record,pin) = self.retained_native_proof("prepared")?.context("missing native proof preparation")?;
+        ensure!(now >= pin.at,"native proof signature predates preparation");
+        self.authenticate_native_proof(&record.frame,signature)?;record.signature = Some(signature.to_vec());
+        self.retain_native_proof("outgoing",&record,now)?;
+        self.outgoing_bch_native_proof()?.context("native outgoing proof not retained")
+    }
+    pub fn outgoing_bch_native_proof(&self) -> Result<Option<NativePaymentMessage>> {
+        ensure!(self.role == Role::NativeFunder,"wrong native proof sender");
+        self.retained_native_proof("outgoing")?.map(|(r,_)|Ok(NativePaymentMessage {frame:Zeroizing::new(r.frame.clone()),
+            signature:r.signature.clone().context("missing outgoing signature")?})).transpose()
+    }
+    /// Authenticate and retain only. Current chain evidence is a separate step.
+    pub fn accept_bch_native_proof(&mut self,now: u64,bytes: &[u8],signature: &[u8]) -> Result<()> {
+        ensure!(self.role == Role::BchFunder,"wrong native proof receiver");
+        self.authenticate_native_proof(bytes,signature)?;
+        self.retain_native_proof("received",&Record {schema:RECORD.into(),frame:bytes.to_vec(),signature:Some(signature.to_vec())},now)
+    }
+    pub fn received_bch_native_proof(&self) -> Result<Option<NativePaymentMessage>> {
+        ensure!(self.role == Role::BchFunder,"wrong native proof receiver");
+        self.retained_native_proof("received")?.map(|(r,_)|Ok(NativePaymentMessage {frame:Zeroizing::new(r.frame.clone()),
+            signature:r.signature.clone().context("missing received signature")?})).transpose()
+    }
+    /// Use the independently configured shared-wallet observer. Every call
+    /// validates current chain state; saved peer claims never cache confirmation.
+    pub async fn observe_bch_native_payment(&self,observer: &impl FundingObserver) -> Result<NativePaymentConfirmation> {
+        ensure!(self.role == Role::BchFunder,"wrong native payment observer role");
+        let (record,_) = self.retained_native_proof("received")?.context("missing authenticated native payment proof")?;
+        let frame = self.check_native_proof(&record.frame)?;
+        let funding = xmz_funding::verify(observer,FundingRequest {
+            address:XmzAddress::parse(self.policy.xmz_network,&frame.destination)?,
+            amount:XmzAmount::from_atoms(frame.amount),proof:frame.proof},&self.policy.xmz_genesis,
+            u64::from(self.policy.xmz_confirmations)).await?;
+        Ok(NativePaymentConfirmation {funding,quote:frame.quote,agreement:frame.agreement})
+    }
+}
diff --git a/swap-machine/src/bch_key_recovery/authenticated/native_wallet/tests/wallet_locks/signing/relay/message/native/relay/proof.rs b/swap-machine/src/bch_key_recovery/authenticated/native_wallet/tests/wallet_locks/signing/relay/message/native/relay/proof.rs
