+/// In-memory secret checkpoint bound to the claim that validated it.
+/// Its digest is a content identity, NOT evidence of durable storage.
+/// Retain the digest in trusted durable metadata before calling `persist`.
+/// No Clone/Debug/serialization: preparation is not a recovery authority.
+/// The claim cannot be dropped while a preparation is still used:
+/// ```compile_fail
+/// use swap_machine::{native_execution_claim::ExecutionClaim, xmz_funding::PendingFunding};
+/// fn release_early(claim: ExecutionClaim, pending: &PendingFunding) {
+///     let prepared = claim.prepare_pending(pending).unwrap();
+///     drop(claim);
+///     let _ = prepared.persist();
+/// }
+/// ```
+pub struct PreparedCheckpoint<'a> {
+    claim: &'a ExecutionClaim,
+    name: String,
+    bytes: Zeroizing<Vec<u8>>,
+    digest: [u8; 32],
+}
+
+impl PreparedCheckpoint<'_> {
+    pub fn digest(&self) -> &[u8; 32] { &self.digest }
+
+    /// Write once under the original claim. Failure may leave a torn record;
+    /// never delete it to retry. Success does not persist caller metadata.
+    /// Persist the SAME preparation whose digest was retained, not a new one.
+    /// A crashed execution claim cannot be reopened to repeat this operation.
+    #[cfg(target_os = "linux")]
+    pub fn persist(self) -> Result<[u8; 32]> {
+        ensure!(<[u8; 32]>::from(Sha256::digest(self.bytes.as_slice()))==self.digest,
+            "prepared checkpoint digest changed");
+        write_once(&self.claim.directory, &self.name, &self.bytes)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn persist(self) -> Result<[u8; 32]> {
+        anyhow::bail!("pending checkpoint storage is not implemented on this platform")
+    }
+}
