+    fn recovery_retention_operation(path: &Path,bytes: &[u8],action: &str) -> Result<serde_json::Value> {
+        ensure!(!bytes.is_empty() && bytes.len()<=512,"invalid recovery retention request size");
+        let request: Request=serde_json::from_slice(bytes)?;
+        ensure!(!request.request_id.is_nil()
+            && request.schema==format!("monzero-bch-recovery-retention-{action}-request-v1"),
+            "invalid recovery retention request");
+        let approved=if action=="submit" {
+            Some(parse_digest(request.commitment.as_deref().context("missing recovery retention approval")?)?)
+        } else {
+            ensure!(request.commitment.is_none(),"unexpected recovery retention approval");None
+        };
+        let (_config_lease,config)=load(path)?;
+        ensure!(matches!(config.role,Role::BchFunder),"recovery retention requires BCH funder");
+        let (_quote_lease,bytes)=private_bytes(&config.quote_file)?;
+        let quote=VerifiedBchQuote::restore_record(&bytes,&config.policy,config.admitted_at,
+            &config.identity_pins[0],&config.identity_pins[1],&parse_digest(&config.quote_commitment)?)?;
+        ensure!(quote.terms()["swapId"].parse::<uuid::Uuid>()?==config.trade_id,"recovery retention trade changed");
+        let mut execution=AdmittedExecution::resume(&config.metadata_directory,&config.snapshot_directory,
+            &quote,&config.policy,config.role)?;
+        execution.saved_admission_review(&config.negotiation_pins)?;
+        let hex=|bytes: &[u8]| bytes.iter().map(|b|format!("{b:02x}")).collect::<String>();
+        let mut review=serde_json::Value::Null;
+        if action!="status" {
+            let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+            let checked=execution.review_bch_recovery(now)?;
+            if let Some(approved)=approved {
+                let dispatch=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+                execution.retain_reviewed_bch_recovery(dispatch,&approved)?;
+            }
+            review=serde_json::json!({"details":checked.details,"commitment":hex(&checked.commitment)});
+        }
+        let saved=execution.retained_bch_recovery()?.map(|value| -> Result<serde_json::Value> {
+            Ok(serde_json::json!({"commitment":hex(value.commitment()),"preparedAt":value.prepared_at().to_string(),
+                "cancelTxid":value.cancel().compute_txid().to_string(),"refundTxid":value.refund_txid()?.to_string(),
+                "punishTxid":value.punish().compute_txid().to_string()}))
+        }).transpose()?;
+        Ok(serde_json::json!({"schema":format!("monzero-bch-recovery-retention-{action}-response-v1"),
+            "requestId":request.request_id,"tradeId":config.trade_id,"executable":false,"chainObserved":false,
+            "review":review,"recovery":saved}))
+    }
