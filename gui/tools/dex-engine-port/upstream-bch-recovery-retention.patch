+const REVIEW: &str = "monzero-bch-recovery-retention-review-v1";
+/// Public identifiers only; never serializes the private refund transaction.
+pub struct RecoveryRetentionReview {
+    pub details: serde_json::Value,
+    pub commitment: [u8;32],
+}
 impl AdmittedExecution<'_> {
+    /// Reconstruct and verify exact recovery without persisting or releasing it.
+    /// Exclude preparation time so consent survives the review/dispatch interval.
+    pub fn review_bch_recovery(&self,now: u64) -> Result<RecoveryRetentionReview> {
+        let record=self.recovery_record(now)?;
+        let cancel: Transaction=deserialize(&record.cancel)?;
+        let refund: Transaction=deserialize(&record.refund)?;
+        let punish: Transaction=deserialize(&record.punish)?;
+        let hex=|bytes: &[u8]| bytes.iter().map(|b|format!("{b:02x}")).collect::<String>();
+        let details=serde_json::json!({"schema":REVIEW,"action":"retain-private-recovery-only",
+            "swapId":self.quote.terms()["swapId"],"quote":hex(self.quote.commitment()),
+            "admission":hex(&record.admission),"funding":hex(&record.funding),"receipt":hex(&record.receipt),
+            "fundingTxid":cancel.input.first().context("missing cancellation input")?.previous_output.txid.to_string(),
+            "cancelTxid":cancel.compute_txid().to_string(),"refundTxid":refund.compute_txid().to_string(),
+            "punishTxid":punish.compute_txid().to_string()});
+        Ok(RecoveryRetentionReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+
+    /// Explicit approval protects the existing exact-record retention boundary.
+    /// This does not grant funding relay or release any recovery transaction.
+    pub fn retain_reviewed_bch_recovery(&mut self,now: u64,approved: &[u8;32]) -> Result<PrivateRecovery> {
+        let review=self.review_bch_recovery(now)?;
+        ensure!(&review.commitment==approved,"BCH recovery retention approval changed");
+        self.retain_bch_recovery(now)
+    }
     fn recovery_record(&self,now: u64) -> Result<Record> {
         ensure!(self.role == Role::BchFunder,"only BCH funder prepares private BCH refund");
         self.quote.check_policy(self.policy,now)?;
