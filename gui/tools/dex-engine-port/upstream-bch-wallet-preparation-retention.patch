+//! Wallet preparation retained under the admitted trade's exclusive lease.
+//! The candidate snapshot and its metadata pin precede the existing template,
+//! input claims and preparation pin. No wallet locking, signing or relay.
+use super::*;
+use crate::bch_rpc::{BchRpc,preparation::FundingPreparationRequest};
+use bitcoin::ScriptBuf;
+
+const RECORD: &str="monzero-bch-wallet-preparation-record-v1";
+const PIN: &str="monzero-bch-wallet-preparation-pin-v1";
+#[derive(Clone,PartialEq,Eq,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct WalletPreparationPolicy {
+    pub change_address: String,
+    pub change_script: ScriptBuf,
+    pub fee_rate_atoms_per_kb: u64,
+    pub maximum_fee: u64,
+    pub minimum_change: u64,
+    pub minimum_confirmations: u64,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Candidate {
+    schema: String, admission: [u8;32], deployment: [u8;32], policy: WalletPreparationPolicy,
+    prepared_at: u64, unsigned: Vec<u8>, sources: Vec<Vec<u8>>,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CandidatePin {schema: String, admission: [u8;32], record: [u8;32]}
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes)=>Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(None),
+        Err(e)=>Err(e),
+    }
+}
+impl AdmittedExecution<'_> {
+    fn wallet_preparation_candidate(&self) -> Result<Option<Candidate>> {
+        let pin=optional(&self.metadata,&record_name(self.quote,"wallet-preparation-pin"))?;
+        let bytes=optional(&Journal::open(&self.snapshots)?,&record_name(self.quote,"wallet-preparation"))?;
+        let Some(pin)=pin else {
+            ensure!(bytes.is_none(),"unpinned BCH wallet candidate requires reconciliation; do not reselect");
+            return Ok(None)
+        };
+        let bytes=bytes.context("missing pinned BCH wallet candidate")?;
+        let parsed: CandidatePin=serde_json::from_slice(&pin)?;
+        let admission=self.admission_digest()?;
+        ensure!(parsed.schema==PIN && parsed.admission==admission && serde_json::to_vec(&parsed)?==pin
+            && parsed.record==hash(RECORD,&bytes),"BCH wallet candidate pin mismatch");
+        let candidate: Candidate=serde_json::from_slice(&bytes)?;
+        ensure!(candidate.schema==RECORD && candidate.admission==admission
+            && serde_json::to_vec(&candidate)?==bytes,"BCH wallet candidate context changed");
+        Ok(Some(candidate))
+    }
+
+    /// Explicit preparation only. An existing candidate is resumed without RPC;
+    /// it is not fresh chain evidence or permission to lock, sign or broadcast.
+    pub async fn prepare_bch_funding_from_wallet(&mut self,backend: &BchRpc,now: u64,
+        policy: &WalletPreparationPolicy) -> Result<PreparedBchFunding> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH wallet preparation role");
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(now>=self.read_admission()?.admitted_at && policy.minimum_confirmations>0
+            && policy.fee_rate_atoms_per_kb>0,"invalid BCH wallet preparation time or policy");
+        ensure!(backend.network().quote_name()==self.quote.terms()["bchNetwork"]
+            && backend.network().genesis()==self.quote.terms()["bchGenesis"],"BCH preparation backend chain mismatch");
+        let deployment=backend.deployment_commitment()?;
+        let candidate=if let Some(candidate)=self.wallet_preparation_candidate()? {
+            ensure!(candidate.deployment==deployment && candidate.policy==*policy && now>=candidate.prepared_at,
+                "BCH wallet preparation deployment, policy or time changed");
+            candidate
+        } else {
+            ensure!(self.prepared_bch_funding()?.is_none(),"existing BCH preparation must not select new inputs");
+            ensure!(optional(&Journal::open(&self.snapshots)?,&record_name(self.quote,"template"))?.is_none(),
+                "partial BCH preparation must not select new inputs");
+            let agreed=self.restore_agreement()?;let plan=self.quote.recovery_plan();
+            agreed.check_bch_funding(self.quote,self.policy,now,&plan.lock().script_pubkey(),plan.terms().locked_atoms,policy.maximum_fee)?;
+            let selected=backend.prepare_funding(FundingPreparationRequest {covenant:plan.lock(),principal:plan.terms().locked_atoms,
+                change_address:&policy.change_address,change_script:&policy.change_script,
+                fee_rate_atoms_per_kb:policy.fee_rate_atoms_per_kb,maximum_fee:policy.maximum_fee,
+                minimum_change:policy.minimum_change,minimum_confirmations:policy.minimum_confirmations}).await?;
+            let candidate=Candidate {schema:RECORD.into(),admission:self.admission_digest()?,deployment,policy:policy.clone(),
+                prepared_at:now,unsigned:selected.unsigned().to_vec(),sources:selected.sources().to_vec()};
+            let refs: Vec<&[u8]>=candidate.sources.iter().map(Vec::as_slice).collect();
+            self.validate_bch_funding_preview(now,&candidate.unsigned,&refs,&policy.change_script,policy.maximum_fee,policy.minimum_change)?;
+            let bytes=serde_json::to_vec(&candidate)?;
+            ensure!(bytes.len()<=2_000_000,"BCH wallet candidate exceeds durable record limit");
+            Journal::open(&self.snapshots)?.retain(&record_name(self.quote,"wallet-preparation"),&bytes)?;
+            let pin=CandidatePin {schema:PIN.into(),admission:candidate.admission,record:hash(RECORD,&bytes)};
+            self.metadata.retain(&record_name(self.quote,"wallet-preparation-pin"),&serde_json::to_vec(&pin)?)?;
+            candidate
+        };
+        let refs: Vec<&[u8]>=candidate.sources.iter().map(Vec::as_slice).collect();
+        self.retain_bch_funding_preparation(candidate.prepared_at,&candidate.unsigned,&refs,
+            &candidate.policy.change_script,candidate.policy.maximum_fee,candidate.policy.minimum_change)
+    }
+
+    pub(super) fn require_wallet_preparation_backend(&self,backend: &BchRpc,change: &str,minimum: u64) -> Result<()> {
+        if let Some(candidate)=self.wallet_preparation_candidate()? {
+            ensure!(candidate.deployment==backend.deployment_commitment()? && candidate.policy.change_address==change
+                && candidate.policy.minimum_confirmations==minimum,"wallet lock differs from pinned BCH preparation policy");
+        }
+        Ok(())
+    }
+}
