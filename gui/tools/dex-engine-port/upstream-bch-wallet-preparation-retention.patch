@@ -0,0 +1,42 @@
+use super::*;
+use agreement::execution::funding::preparation::WalletPreparationPolicy;
+
+pub(super) async fn exercise<'a>(mut execution: AdmittedExecution<'a>,setup: &'a Setup,
+    metadata: &PrivateStore,snapshots: &PrivateStore,server: &Server,rpc: &BchRpc,wrong: &BchRpc,
+    script: &bitcoin::Script,now: u64) -> Result<AdmittedExecution<'a>> {
+    let policy=WalletPreparationPolicy {change_address:"bchreg:qchange".into(),change_script:script.to_owned(),
+        fee_rate_atoms_per_kb:1000,maximum_fee:1000,minimum_change:546,minimum_confirmations:3};
+    let prepared=execution.prepare_bch_funding_from_wallet(rpc,now,&policy).await?;
+    let commitment=*prepared.commitment();assert_eq!(prepared.preview().fee().to_sat(),1000);
+    {let state=server.state.lock().unwrap();assert_eq!(state.preparation_calls,1);assert_eq!(state.calls,0);
+        assert_eq!(state.sign_calls,0);assert_eq!(state.relay_calls,0);assert!(!state.locked);}
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    drop(execution);
+    let mut execution=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    assert_eq!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&policy).await?.commitment(),&commitment);
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    let mut changed=policy.clone();changed.fee_rate_atoms_per_kb+=1;
+    assert!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&changed).await.is_err());
+    assert!(execution.prepare_bch_funding_from_wallet(wrong,now+1,&policy).await.is_err());
+    assert!(execution.prepare_bch_funding_from_wallet(rpc,now-1,&policy).await.is_err());
+    let expiry=setup.quote.terms()["expiresAt"].parse::<u64>()?;
+    assert!(execution.prepare_bch_funding_from_wallet(rpc,expiry,&policy).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(wrong,now+1,"bchreg:qchange",3).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(rpc,now+1,"bchreg:qchange",4).await.is_err());
+    let trade=&setup.quote.terms()["swapId"];
+    let record=snapshots.0.join(format!("{trade}.bch-funding-wallet-preparation"));
+    let pin=metadata.0.join(format!("{trade}.bch-funding-wallet-preparation-pin"));
+    let record_bytes=std::fs::read(&record)?;let pin_bytes=std::fs::read(&pin)?;
+    save(&record,b"{}")?;assert!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&policy).await.is_err());save(&record,&record_bytes)?;
+    std::fs::remove_file(&record)?;assert!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&policy).await.is_err());save(&record,&record_bytes)?;
+    std::fs::remove_file(&pin)?;assert!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&policy).await.is_err());save(&pin,&pin_bytes)?;
+    // A pinned candidate repairs interrupted publication using the original
+    // bytes and time; it never asks the wallet to select a replacement.
+    let preparation_pin=metadata.0.join(format!("{trade}.bch-funding-pin"));
+    std::fs::remove_file(&preparation_pin)?;
+    assert_eq!(execution.prepare_bch_funding_from_wallet(rpc,now+1,&policy).await?.commitment(),&commitment);
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    {let state=server.state.lock().unwrap();assert_eq!(state.preparation_calls,1);assert_eq!(state.calls,0);
+        assert_eq!(state.sign_calls,0);assert_eq!(state.relay_calls,0);assert!(!state.locked);}
+    Ok(execution)
+}
