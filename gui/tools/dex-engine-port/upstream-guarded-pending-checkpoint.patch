diff --git a/swap-machine/src/native_execution_claim/checkpoint.rs b/swap-machine/src/native_execution_claim/checkpoint.rs
new file mode 100644
index 000000000..23cba210b
--- /dev/null
+++ b/swap-machine/src/native_execution_claim/checkpoint.rs
@@ -0,0 +1,172 @@
+//! Write-once Bob pending-funding checkpoint, held under attempt ownership.
+//! Contains plaintext secrets: private local storage is REQUIRED. This is not
+//! encryption or a key-management system. Expected digests must be retained in
+//! trusted context separately, never adopted from the file being loaded.
+use super::{ExecutionClaim, RecoveryLease};
+use crate::xmz_funding::{FundingPolicy, PendingFunding};
+use anyhow::{ensure, Context, Result};
+use sha2::{Digest, Sha256};
+use zeroize::Zeroizing;
+
+const DOMAIN: &[u8] = b"monzero-native-bob-pending-checkpoint-v1\0";
+const MAX_BYTES: usize = 1_048_576 + DOMAIN.len() + 32;
+
+impl ExecutionClaim {
+    /// Return a digest only after file AND directory fsync. Any error may leave
+    /// a complete or torn record; never remove it or overwrite it to retry.
+    /// No signing, broadcast, checkpoint replacement or final-state assertion.
+    #[cfg(target_os = "linux")]
+    pub fn save_pending(&self, pending: &PendingFunding) -> Result<[u8;32]> {
+        let quote=self.checkpoint_quote.as_ref().context("legacy claim cannot store a guarded checkpoint")?;
+        pending.check_recorded_quote(quote)?;
+        let encoded=Zeroizing::new(pending.encode()?);
+        let mut bytes=Zeroizing::new(Vec::with_capacity(DOMAIN.len()+32+encoded.len()));
+        bytes.extend_from_slice(DOMAIN);
+        bytes.extend_from_slice(quote.commitment());
+        bytes.extend_from_slice(&encoded);
+        write_once(&self.directory,&filename(quote)?,&bytes)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn save_pending(&self, _: &PendingFunding) -> Result<[u8;32]> {
+        anyhow::bail!("pending checkpoint storage is not implemented on this platform")
+    }
+}
+
+impl RecoveryLease {
+    /// Verifies all bytes against an independently retained digest before
+    /// decoding secret protocol state. Does not prove latest state or authorize
+    /// resending anything; use fresh chain reconciliation under this lease.
+    #[cfg(target_os = "linux")]
+    pub fn load_pending(&self, expected_digest: &[u8;32], lock: bitcoin::Txid,
+        policy: &FundingPolicy) -> Result<PendingFunding> {
+        let quote=self.record.quote();
+        let bytes=read_pinned(&self.directory,&filename(quote)?,expected_digest)?;
+        ensure!(bytes.len()>DOMAIN.len()+32 && bytes.starts_with(DOMAIN)
+            && &bytes[DOMAIN.len()..DOMAIN.len()+32]==quote.commitment(),
+            "checkpoint envelope differs from retained execution");
+        let pending=PendingFunding::decode(&bytes[DOMAIN.len()+32..],
+            quote.terms()["swapId"].parse()?,lock,policy)
+            .map_err(|_|anyhow::anyhow!("invalid stored pending checkpoint"))?;
+        pending.check_recorded_quote(quote)?;
+        Ok(pending)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn load_pending(&self, _: &[u8;32], _: bitcoin::Txid, _: &FundingPolicy) -> Result<PendingFunding> {
+        anyhow::bail!("pending checkpoint storage is not implemented on this platform")
+    }
+}
+
+fn filename(quote:&crate::native_trade_quote::RecordedQuote) -> Result<String> {
+    let id:uuid::Uuid=quote.terms()["swapId"].parse()?;
+    ensure!(!id.is_nil(),"missing checkpoint swap identity");
+    Ok(format!("swap-{id}.pending"))
+}
+
+#[cfg(target_os = "linux")]
+fn directory_is_private(directory:&std::fs::File) -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata=directory.metadata()?;
+    ensure!(metadata.is_dir() && metadata.uid()==unsafe{libc::geteuid()}
+        && metadata.mode()&0o077==0,"checkpoint directory is not private and owned");
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn open(directory:&std::fs::File,name:&str,flags:i32) -> Result<std::fs::File> {
+    use std::os::fd::{AsRawFd,FromRawFd};
+    let name=std::ffi::CString::new(name)?;
+    let fd=unsafe{libc::openat(directory.as_raw_fd(),name.as_ptr(),flags|libc::O_NOFOLLOW|libc::O_CLOEXEC,0o600)};
+    if fd<0 {return Err(std::io::Error::last_os_error().into());}
+    Ok(unsafe{std::fs::File::from_raw_fd(fd)})
+}
+
+#[cfg(target_os = "linux")]
+fn write_once(directory:&std::fs::File,name:&str,bytes:&[u8]) -> Result<[u8;32]> {
+    use std::io::Write;
+    ensure!(!bytes.is_empty() && bytes.len()<=MAX_BYTES,"invalid checkpoint size");
+    directory_is_private(directory)?;
+    let mut file=open(directory,name,libc::O_WRONLY|libc::O_CREAT|libc::O_EXCL)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    directory.sync_all()?;
+    Ok(Sha256::digest(bytes).into())
+}
+
+#[cfg(target_os = "linux")]
+fn read_pinned(directory:&std::fs::File,name:&str,expected:&[u8;32]) -> Result<Zeroizing<Vec<u8>>> {
+    use std::{io::Read,os::unix::fs::MetadataExt};
+    directory_is_private(directory)?;
+    let mut file=open(directory,name,libc::O_RDONLY|libc::O_NONBLOCK)?;
+    let before=file.metadata()?;
+    ensure!(before.is_file() && before.uid()==unsafe{libc::geteuid()} && before.mode()&0o077==0
+        && before.nlink()==1 && before.len()>0 && before.len()<=MAX_BYTES as u64,"unsafe checkpoint record");
+    let mut bytes=Zeroizing::new(Vec::new());
+    (&mut file).take(MAX_BYTES as u64+1).read_to_end(&mut bytes)?;
+    let after=file.metadata()?;
+    let named=open(directory,name,libc::O_RDONLY|libc::O_NONBLOCK)?.metadata()?;
+    ensure!(bytes.len() as u64==before.len() && after.len()==before.len()
+        && after.uid()==before.uid() && after.mode()==before.mode() && after.nlink()==1
+        && (after.mtime(),after.mtime_nsec(),after.ctime(),after.ctime_nsec())
+            ==(before.mtime(),before.mtime_nsec(),before.ctime(),before.ctime_nsec())
+        && (named.dev(),named.ino())==(before.dev(),before.ino()),"checkpoint changed while reading");
+    ensure!(<[u8;32]>::from(Sha256::digest(bytes.as_slice()))==*expected,"checkpoint digest mismatch");
+    Ok(bytes)
+}
+
+#[cfg(all(test,target_os="linux"))]
+mod tests {
+    use super::*;
+    use std::{fs,os::unix::fs::{DirBuilderExt,PermissionsExt,symlink}};
+    struct Directory(std::path::PathBuf);
+    impl Drop for Directory {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
+    fn root() -> Result<(Directory,fs::File)> {
+        let path=std::env::temp_dir().canonicalize()?.join(format!("xmz-pending-store-{}",uuid::Uuid::new_v4()));
+        fs::DirBuilder::new().mode(0o700).create(&path)?;
+        let fd=fs::File::open(&path)?;
+        Ok((Directory(path),fd))
+    }
+    #[test]
+    fn checkpoint_is_write_once_pinned_and_directory_anchored() -> Result<()> {
+        let (root,fd)=root()?;let name="swap-fixture.pending";
+        let pin=write_once(&fd,name,b"synthetic-private-fixture")?;
+        assert_eq!(read_pinned(&fd,name,&pin)?.as_slice(),b"synthetic-private-fixture");
+        assert!(write_once(&fd,name,b"replacement").is_err());
+        assert!(read_pinned(&fd,name,&[0;32]).is_err());
+        let selected=root.0.join("selected");fs::DirBuilder::new().mode(0o700).create(&selected)?;
+        let selected_fd=fs::File::open(&selected)?;
+        let selected_pin=write_once(&selected_fd,name,b"original-directory")?;
+        fs::rename(&selected,root.0.join("moved"))?;
+        fs::DirBuilder::new().mode(0o700).create(&selected)?;
+        write_once(&fs::File::open(&selected)?,name,b"replacement-directory")?;
+        assert_eq!(read_pinned(&selected_fd,name,&selected_pin)?.as_slice(),b"original-directory");
+        assert_eq!(fs::metadata(root.0.join(name))?.permissions().mode()&0o777,0o600);
+        fs::write(root.0.join(name),b"altered")?;
+        assert!(read_pinned(&fd,name,&pin).is_err());
+        fs::write(root.0.join(name),b"")?;
+        assert!(read_pinned(&fd,name,&pin).is_err());
+        assert!(write_once(&fd,name,b"retry").is_err());
+        Ok(())
+    }
+    #[test]
+    fn checkpoint_rejects_aliases_permissions_and_oversize() -> Result<()> {
+        let (root,fd)=root()?;let name="swap-fixture.pending";let path=root.0.join(name);
+        let pin=write_once(&fd,name,b"synthetic-private-fixture")?;
+        symlink(&path,root.0.join("symlink"))?;
+        assert!(read_pinned(&fd,"symlink",&pin).is_err());
+        fs::hard_link(&path,root.0.join("hardlink"))?;
+        assert!(read_pinned(&fd,name,&pin).is_err());fs::remove_file(root.0.join("hardlink"))?;
+        fs::set_permissions(&path,fs::Permissions::from_mode(0o644))?;
+        assert!(read_pinned(&fd,name,&pin).is_err());
+        fs::set_permissions(&path,fs::Permissions::from_mode(0o600))?;
+        fs::OpenOptions::new().write(true).open(&path)?.set_len(MAX_BYTES as u64+1)?;
+        assert!(read_pinned(&fd,name,&pin).is_err());
+        assert!(write_once(&fd,"oversize",&vec![0;MAX_BYTES+1]).is_err());
+        assert!(!root.0.join("oversize").exists());
+        fs::set_permissions(&root.0,fs::Permissions::from_mode(0o755))?;
+        assert!(write_once(&fd,"public-directory",b"data").is_err());
+        assert!(read_pinned(&fd,name,&pin).is_err());
+        Ok(())
+    }
+}
