+#[tokio::test]
+async fn broadcast_requires_matching_durable_intent_before_wire_request()->Result<()> {
+    let directory=Directory::new()?;let (seed,review)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review)?;let expected=claim.signing_commitment();
+    let endpoint=endpoint()?;assert!(BroadcastRecord::new(&claim,&endpoint,expected).is_err());
+    claim.approve_and_sign(&seed,expected)?;
+    assert!(BroadcastRecord::new(&claim,&endpoint,sha256::Hash::hash(b"wrong")).is_err());
+    assert!(BroadcastRecord::new(&claim,&TlsEndpoint::new("localhost".into(),50002,LtcNetwork::Mainnet)?,expected).is_err());
+    let record=BroadcastRecord::new(&claim,&endpoint,expected)?;
+    let (stream,task)=server(regtest_handshake());
+    assert!(ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.submit_retained(&record).await.is_err());
+    assert_eq!(task.await?.len(),2);
+    record.retain_intent()?;
+    fs::write(directory.0.join(format!("{}-intent.json",record.name)),b"changed")?;
+    let (stream,task)=server(regtest_handshake());
+    assert!(ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.submit_retained(&record).await.is_err());
+    assert_eq!(task.await?.len(),2);
+    assert!(claim.broadcast_status(&endpoint,expected).is_err());Ok(())
+}
