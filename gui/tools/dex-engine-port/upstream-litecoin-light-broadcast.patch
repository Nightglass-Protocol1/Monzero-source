+//! Private submission path used only after endpoint-bound durable intent.
+use super::*;
+use crate::litecoin_light::vault::signing::review::claims::broadcast::BroadcastRecord;
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    // Consume the session: a cancelled, malformed or ambiguous response cannot
+    // leak into another request or trigger an implicit retry on this stream.
+    pub(in crate::litecoin_light) async fn submit_retained(mut self,record:&BroadcastRecord<'_>)->Result<Txid> {
+        ensure!(self.network==record.network(),"Litecoin broadcast session network mismatch");
+        record.check_intent()?;
+        let transaction=record.transaction();
+        let raw=serialize(transaction).iter().map(|byte|format!("{byte:02x}")).collect::<String>();
+        let (_,bytes)=self.exchange("blockchain.transaction.broadcast",json!([raw]),1024).await?;
+        let reported:String=result(&bytes)?;
+        let txid=transaction.compute_txid();
+        ensure!(reported==txid.to_string(),"Litecoin broadcast acknowledgement identity mismatch");
+        record.acknowledge()?;
+        Ok(txid)
+    }
+}
