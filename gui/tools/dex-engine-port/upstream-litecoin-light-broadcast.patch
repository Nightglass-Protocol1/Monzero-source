+use super::*;
+use super::super::tests::{Directory,review};
+use crate::litecoin_light::session::{ReadSession,tests::{server,reply,regtest_handshake,hex}};
+use serde_json::json;
+use std::{fs,time::Duration};
+use tokio::io::{AsyncBufReadExt,AsyncWriteExt,BufReader};
+
+fn endpoint()->Result<TlsEndpoint> {TlsEndpoint::new("localhost".into(),50002,LtcNetwork::Regtest)}
+
+#[tokio::test]
+async fn broadcast_retains_exact_intent_and_ack_across_restart_and_explicit_retry()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();let (seed,review)=review(&[0])?;
+    let account=seed.public_account(LtcNetwork::Regtest,2)?;let payment=review.transaction().output[0].clone();
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;let expected=claim.signing_commitment();
+    let signed=claim.approve_and_sign(&seed,expected)?;drop(seed);
+    let endpoint=endpoint()?;
+    assert_eq!(claim.broadcast_status(&endpoint,expected)?,BroadcastStatus::NoLocalAttempt);
+    for _ in 0..2 {
+        let record=BroadcastRecord::new(&claim,&endpoint,expected)?;record.retain_intent()?;
+        let mut responses=regtest_handshake();responses.push(reply(3,json!(signed.compute_txid().to_string())));
+        let (stream,task)=server(responses);
+        assert_eq!(ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.submit_retained(&record).await?,signed.compute_txid());
+        let requests=task.await?;assert_eq!(requests.len(),3);
+        assert_eq!(requests[2]["method"],"blockchain.transaction.broadcast");
+        assert_eq!(requests[2]["params"],json!([hex(&serialize(&signed))]));
+        assert_eq!(claim.broadcast_status(&endpoint,expected)?,BroadcastStatus::ServerAcknowledged);
+    }
+    drop(claim);
+    let reopened=ClaimedSpend::open(&directory.0,operation,&account,&payment,None,Amount::from_sat(1000),expected)?;
+    assert_eq!(reopened.load_signed()?,signed);
+    assert_eq!(reopened.broadcast_status(&endpoint,expected)?,BroadcastStatus::ServerAcknowledged);
+    assert_eq!(reopened.broadcast_status(&TlsEndpoint::new("localhost".into(),50003,LtcNetwork::Regtest)?,expected)?,BroadcastStatus::NoLocalAttempt);
+    Ok(())
+}
+
+#[tokio::test]
+async fn broadcast_bad_or_lost_ack_keeps_unknown_and_claims()->Result<()> {
+    for response in [reply(3,json!("00".repeat(32))),reply(3,json!(true)),reply(4,json!("wrong id")),
+        b"{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-1,\"message\":\"rejected\"}}\n".to_vec(),
+        b"not json\n".to_vec(),vec![b'x';1025]] {
+        let directory=Directory::new()?;let (seed,review)=review(&[0])?;
+        let claim=ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review)?;let expected=claim.signing_commitment();
+        let signed=claim.approve_and_sign(&seed,expected)?;let endpoint=endpoint()?;
+        let record=BroadcastRecord::new(&claim,&endpoint,expected)?;record.retain_intent()?;
+        let mut responses=regtest_handshake();responses.push(response);let (stream,task)=server(responses);
+        assert!(ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.submit_retained(&record).await.is_err());
+        assert_eq!(task.await?.len(),3);
+        assert_eq!(claim.broadcast_status(&endpoint,expected)?,BroadcastStatus::OutcomeUnknown);
+        assert_eq!(claim.load_signed()?,signed);
+    }
+    Ok(())
+}
