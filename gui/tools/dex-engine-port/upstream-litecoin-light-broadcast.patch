+#[tokio::test]
+async fn broadcast_cancelled_after_write_retains_unknown_after_reopen()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();let (seed,review)=review(&[0])?;
+    let account=seed.public_account(LtcNetwork::Regtest,2)?;let payment=review.transaction().output[0].clone();
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;let expected=claim.signing_commitment();
+    let signed=claim.approve_and_sign(&seed,expected)?;let endpoint=endpoint()?;
+    let record=BroadcastRecord::new(&claim,&endpoint,expected)?;record.retain_intent()?;
+    let (stream,peer)=tokio::io::duplex(4096);
+    let (sent,received)=tokio::sync::oneshot::channel();
+    let task=tokio::spawn(async move {
+        let mut peer=BufReader::new(peer);
+        for response in regtest_handshake() {
+            let mut line=String::new();peer.read_line(&mut line).await?;
+            peer.get_mut().write_all(&response).await?;
+        }
+        let mut line=String::new();peer.read_line(&mut line).await?;
+        sent.send(serde_json::from_str::<serde_json::Value>(&line)?).unwrap();
+        let mut end=String::new();assert_eq!(peer.read_line(&mut end).await?,0);
+        Ok::<_,anyhow::Error>(())
+    });
+    let session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut submission=Box::pin(session.submit_retained(&record));
+    tokio::select! {
+        value=received=>assert_eq!(value?["params"],json!([hex(&serialize(&signed))])),
+        _=&mut submission=>panic!("submission completed without acknowledgement"),
+        _=tokio::time::sleep(Duration::from_secs(2))=>panic!("submission was not written"),
+    }
+    drop(submission);task.await??;drop(record);drop(claim);
+    let reopened=ClaimedSpend::open(&directory.0,operation,&account,&payment,None,Amount::from_sat(1000),expected)?;
+    assert_eq!(reopened.broadcast_status(&endpoint,expected)?,BroadcastStatus::OutcomeUnknown);
+    assert_eq!(reopened.load_signed()?,signed);Ok(())
+}
