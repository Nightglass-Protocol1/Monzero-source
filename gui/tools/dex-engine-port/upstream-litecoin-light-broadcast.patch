+#[test]
+fn broadcast_recovery_rejects_orphan_ack_and_changed_signed_witness()->Result<()> {
+    let directory=Directory::new()?;let (seed,review)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review)?;let expected=claim.signing_commitment();
+    claim.approve_and_sign(&seed,expected)?;let endpoint=endpoint()?;
+    let record=BroadcastRecord::new(&claim,&endpoint,expected)?;record.retain_intent()?;record.acknowledge()?;
+    let path=directory.0.join(format!("{}-intent.json",record.name));
+    fs::remove_file(&path)?;assert!(claim.broadcast_status(&endpoint,expected).is_err());
+    claim.journal.retain(&format!("{}-intent.json",record.name),&record.intent)?;
+    let mut altered=record.signed.clone();altered.input[0].witness=Witness::new();
+    fs::write(directory.0.join(format!("ltc-signed-{expected}.tx")),serialize(&altered))?;
+    assert!(record.check_intent().is_err());assert!(claim.broadcast_status(&endpoint,expected).is_err());Ok(())
+}
