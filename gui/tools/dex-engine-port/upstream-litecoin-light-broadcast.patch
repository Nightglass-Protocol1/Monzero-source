+//! Durable, endpoint-specific submission evidence. No acknowledgement is a
+//! consensus, confirmation or mempool-membership proof. Claims are never freed.
+use super::*;
+use crate::litecoin_light::tls::TlsEndpoint;
+
+#[derive(Debug,PartialEq,Eq)]
+pub enum BroadcastStatus {
+    /// No matching local intent; this does not prove absence of other sends.
+    NoLocalAttempt,
+    /// Intent exists, but a matching acknowledgement was not durably retained.
+    OutcomeUnknown,
+    /// This endpoint returned the expected txid at some point in the past.
+    ServerAcknowledged,
+}
+
+pub(in crate::litecoin_light) struct BroadcastRecord<'a> {
+    claim:&'a ClaimedSpend,
+    signed:Transaction,
+    name:String,
+    intent:Vec<u8>,
+    acknowledgement:Vec<u8>,
+}
+impl ClaimedSpend {
+    /// Inspect only this endpoint's local evidence. No network access, vault
+    /// unlock, implicit intent creation or inference of current acceptance.
+    pub fn broadcast_status(&self,endpoint:&TlsEndpoint,expected:sha256::Hash)->Result<BroadcastStatus> {
+        BroadcastRecord::new(self,endpoint,expected)?.status()
+    }
+}
+impl<'a> BroadcastRecord<'a> {
+    pub(in crate::litecoin_light) fn new(claim:&'a ClaimedSpend,endpoint:&TlsEndpoint,
+        expected:sha256::Hash)->Result<Self> {
+        claim.check_signing_review(expected)?;
+        ensure!(claim.review.account.network()==endpoint.network(),"Litecoin broadcast network mismatch");
+        let signed=claim.load_signed()?;
+        let raw=serialize(&signed);
+        ensure!(raw.len()<=crate::litecoin_light::MAX_TRANSACTION,"oversized Litecoin broadcast transaction");
+        let scope=serde_json::to_vec(&serde_json::json!({"commitment":expected.to_string(),
+            "network":endpoint.network().genesis(),"host":endpoint.host(),"port":endpoint.port()}))?;
+        let name=format!("ltc-broadcast-{}",sha256::Hash::hash(&scope));
+        let intent=serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-broadcast-intent-v1",
+            "scope":serde_json::from_slice::<serde_json::Value>(&scope)?,
+            "txid":signed.compute_txid().to_string(),"signedHash":sha256::Hash::hash(&raw).to_string()}))?;
+        let acknowledgement=serde_json::to_vec(&serde_json::json!({
+            "schema":"monzero-ltc-broadcast-ack-v1","intentHash":sha256::Hash::hash(&intent).to_string(),
+            "txid":signed.compute_txid().to_string()}))?;
+        Ok(Self {claim,signed,name,intent,acknowledgement})
+    }
+    fn matching_record(&self,suffix:&str,expected:&[u8])->Result<bool> {
+        match self.claim.journal.read(&format!("{}-{suffix}.json",self.name)) {
+            Ok(bytes)=>{ensure!(bytes==expected,"Litecoin broadcast record mismatch");Ok(true)},
+            Err(error) if error.downcast_ref::<std::io::Error>()
+                .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(false),
+            Err(error)=>Err(error),
+        }
+    }
+    fn status(&self)->Result<BroadcastStatus> {
+        let intent=self.matching_record("intent",&self.intent)?;
+        let ack=self.matching_record("ack",&self.acknowledgement)?;
+        ensure!(!ack || intent,"Litecoin acknowledgement has no broadcast intent");
+        Ok(if ack {BroadcastStatus::ServerAcknowledged}
+            else if intent {BroadcastStatus::OutcomeUnknown} else {BroadcastStatus::NoLocalAttempt})
+    }
+    pub(in crate::litecoin_light) fn retain_intent(&self)->Result<()> {
+        self.status()?;
+        self.claim.journal.retain(&format!("{}-intent.json",self.name),&self.intent)
+    }
+    pub(in crate::litecoin_light) fn transaction(&self)->&Transaction {&self.signed}
+    pub(in crate::litecoin_light) fn network(&self)->LtcNetwork {self.claim.review.account.network()}
+    pub(in crate::litecoin_light) fn check_intent(&self)->Result<()> {
+        ensure!(self.claim.load_signed()?==self.signed,"Litecoin signed broadcast bytes changed");
+        ensure!(self.matching_record("intent",&self.intent)?,"missing Litecoin broadcast intent");
+        Ok(())
+    }
+    pub(in crate::litecoin_light) fn acknowledge(&self)->Result<()> {
+        self.check_intent()?;
+        self.claim.journal.retain(&format!("{}-ack.json",self.name),&self.acknowledgement)
+    }
+}
