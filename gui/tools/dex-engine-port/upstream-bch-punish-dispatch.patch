+use super::*;
+use agreement::execution::funding::recovery::punish::observation::relay::PunishRelayState;
+
+pub(super) async fn exercise(metadata: &PrivateStore,snapshots: &PrivateStore,setup: &Setup,
+    fixture: &Fixture,rpc: &BchRpc,server: &Server,transaction: &Transaction) -> Result<()> {
+    let observer=fixture.funding_client()?;let block=Some(BlockHash::from_byte_array([6;32]));let txid=transaction.compute_txid();
+    for mode in [0,1,2] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}}
+        let mut execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let intent=copied.0.join(format!("{}.bch-punish-relay-intent",setup.quote.terms()["swapId"]));
+        let ack=copied.0.join(format!("{}.bch-punish-relay-ack",setup.quote.terms()["swapId"]));
+        {let mut state=server.state.lock().unwrap();state.punish=Some(transaction.clone());state.relay_intent=Some(intent.clone());state.relay_mode=mode;}
+        let calls=server.state.lock().unwrap().punish_relay_calls;
+        let review=execution.review_bch_punish_relay(rpc,2031)?;
+        assert!(execution.observe_bch_punish(rpc,block).await.is_err());
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_bch_punish(&observer,rpc,block,&bad,2032).await.is_err());assert!(!intent.exists());
+        if mode==0 {
+            server.state.lock().unwrap().punishment_mature=false;
+            assert!(execution.relay_bch_punish(&observer,rpc,block,&review.commitment,2032).await.is_err());
+            server.state.lock().unwrap().punishment_mature=true;
+            server.state.lock().unwrap().recovery_output_spent=true;
+            assert!(execution.relay_bch_punish(&observer,rpc,block,&review.commitment,2032).await.is_err());
+            server.state.lock().unwrap().recovery_output_spent=false;
+            assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().punish_relay_calls,calls);
+        }
+        let result=execution.relay_bch_punish(&observer,rpc,block,&review.commitment,2032).await;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().punish_relay_calls,calls+1);
+        let expected=if mode==0 {assert_eq!(result?,txid);assert!(ack.exists());PunishRelayState::Acknowledged {txid}}
+            else {assert!(result.is_err());assert!(!ack.exists());PunishRelayState::Attempted {txid}};
+        drop(execution);
+        let mut restored=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        assert_eq!(restored.bch_punish_relay_state()?,Some(expected));
+        let result=restored.relay_bch_punish(&observer,rpc,None,&review.commitment,2033).await;
+        if mode==0 {assert_eq!(result?,txid);} else {assert!(result.is_err());}
+        assert_eq!(server.state.lock().unwrap().punish_relay_calls,calls+1);
+        assert_eq!(restored.observe_bch_punish(rpc,block).await?.confirmation().transaction(),transaction);
+        assert_eq!(restored.observe_bch_punish(rpc,None).await?.review(),&review.commitment);
+        assert_eq!(restored.bch_punish_relay_state()?,Some(expected));
+        if mode==0 {
+            for invalid in [1,2,3] {server.state.lock().unwrap().redemption_confirmation_mode=invalid;assert!(restored.observe_bch_punish(rpc,block).await.is_err());}
+            server.state.lock().unwrap().redemption_confirmation_mode=0;
+            let saved=std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;assert!(restored.bch_punish_relay_state().is_err());std::fs::write(&ack,saved)?;
+            let held=copied.0.join("held-punish-intent");std::fs::rename(&intent,&held)?;
+            assert!(restored.bch_punish_relay_state().is_err());std::fs::rename(&held,&intent)?;
+        }
+    }
+    let mut state=server.state.lock().unwrap();state.punish=None;state.relay_intent=None;state.relay_mode=0;
+    Ok(())
+}
