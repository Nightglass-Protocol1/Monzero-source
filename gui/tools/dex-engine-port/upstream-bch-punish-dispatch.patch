+//! Explicit one-shot BCH punishment dispatch. No automatic retransmission.
+use super::*;
+const ATTEMPT: &str="monzero-bch-punish-relay-intent-v1";
+const ACK: &str="monzero-bch-punish-relay-ack-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt {schema: String,review: [u8;32],approved_at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack {schema: String,attempt: [u8;32],txid: Txid}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum PunishRelayState {Attempted {txid: Txid},Acknowledged {txid: Txid}}
+fn slot(quote: &VerifiedBchQuote,part: &str) -> String {format!("{}.bch-punish-relay-{part}",quote.terms()["swapId"])}
+impl AdmittedExecution<'_> {
+    fn punish_attempt(&self,m: &PunishMaterials) -> Result<Option<(Attempt,[u8;32])>> {
+        let Some(bytes)=optional(&self.metadata,&slot(self.quote,"intent"))? else {return Ok(None)};
+        ensure!(bytes.len()<=4096,"oversized BCH punishment intent");let attempt: Attempt=serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema==ATTEMPT && attempt.review==m.review.commitment && attempt.approved_at>=m.prepared_at
+            && serde_json::to_vec(&attempt)?==bytes,"BCH punishment intent changed");
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+    fn punish_state(&self,m: &PunishMaterials) -> Result<Option<PunishRelayState>> {
+        let ack=optional(&self.metadata,&slot(self.quote,"ack"))?;
+        let Some((_,attempt))=self.punish_attempt(m)? else {
+            ensure!(ack.is_none(),"BCH punishment acknowledgement lacks intent");return Ok(None)
+        };
+        let txid=m.transaction.compute_txid();
+        let Some(bytes)=ack else {return Ok(Some(PunishRelayState::Attempted {txid}))};
+        ensure!(bytes.len()<=4096,"oversized BCH punishment acknowledgement");let ack: Ack=serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema==ACK && ack.attempt==attempt && ack.txid==txid && serde_json::to_vec(&ack)?==bytes,
+            "BCH punishment acknowledgement changed");
+        Ok(Some(PunishRelayState::Acknowledged {txid}))
+    }
+    pub fn bch_punish_relay_state(&self) -> Result<Option<PunishRelayState>> {
+        self.punish_state(&self.punish_relay_materials()?)
+    }
+    /// Approval is for exact saved terms. Recheck payment and mature unspent
+    /// recovery before retaining intent; a lost reply never authorizes a retry.
+    pub async fn relay_bch_punish(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        block: Option<BlockHash>,approved: &[u8;32],now: u64) -> Result<Txid> {
+        let m=self.punish_relay_materials()?;
+        ensure!(*approved==m.review.commitment,"BCH punishment approval changed");
+        ensure!(now>=m.prepared_at && bch.deployment_commitment()?==m.deployment,"BCH punishment predates preparation or changes observer");
+        if let Some((attempt,_))=self.punish_attempt(&m)? {ensure!(now>=attempt.approved_at,"BCH punishment time moved backwards");}
+        match self.punish_state(&m)? {
+            Some(PunishRelayState::Acknowledged {txid})=>return Ok(txid),
+            Some(PunishRelayState::Attempted {..})=>anyhow::bail!("BCH punishment outcome uncertain; reconcile without retransmitting"),
+            None=>(),
+        }
+        let transaction=m.transaction.clone();
+        let evidence=self.check_punish_window(native,bch,block,m).await?;
+        ensure!(std::time::Instant::now()<evidence.deadline,"BCH punishment evidence expired before intent");
+        let bytes=serde_json::to_vec(&Attempt {schema:ATTEMPT.into(),review:*approved,approved_at:now})?;
+        self.metadata.retain(&slot(self.quote,"intent"),&bytes)?;
+        let txid=bch.relay_punishment(&transaction,evidence.deadline).await?;
+        self.metadata.retain(&slot(self.quote,"ack"),&serde_json::to_vec(&Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid})?)?;
+        Ok(txid)
+    }
+}
+
+pub struct ConfirmedPunishment {review: [u8;32],confirmation: ConfirmedTransaction}
+impl ConfirmedPunishment {
+    pub fn review(&self) -> &[u8;32] {&self.review}
+    pub fn confirmation(&self) -> &ConfirmedTransaction {&self.confirmation}
+}
+impl AdmittedExecution<'_> {
+    /// Fresh exact BCH confirmation can reconcile a lost acknowledgement.
+    /// This neither rewrites dispatch history nor authorizes any native payment.
+    pub async fn observe_bch_punish(&self,bch: &BchRpc,block: Option<BlockHash>) -> Result<ConfirmedPunishment> {
+        let m=self.punish_relay_materials()?;
+        self.punish_state(&m)?.context("missing BCH punishment relay attempt")?;
+        ensure!(bch.deployment_commitment()?==m.deployment,"BCH punishment observer changed");
+        let minimum=u64::from(self.policy.bch_confirmations);let txid=m.transaction.compute_txid();
+        let confirmation=match block {
+            Some(block)=>bch.confirmed_transaction(txid,block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(txid,minimum).await?,
+        };
+        ensure!(confirmation.deployment()==&m.deployment && serialize(confirmation.transaction())==serialize(&m.transaction),
+            "confirmed BCH punishment differs from exact recovery");
+        Ok(ConfirmedPunishment {review:m.review.commitment,confirmation})
+    }
+}
