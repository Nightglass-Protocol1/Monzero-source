+/// The trusted settlement driver selects this from observed protocol outcome,
+/// never from an unauthenticated peer or a GUI-controlled destination string.
+#[derive(Clone, Copy)]
+pub enum RecoveryDestination { Payout, Refund }
+
+impl SpendRequest {
+    /// Conservative partial-recovery bounds, not proof of complete proceeds or
+    /// settlement outcome. The caller still binds wallet/lock/keys to engine state.
+    pub fn check_recorded_recovery_limits(&self,
+        quote: &crate::native_trade_quote::RecordedQuote, role: RecoveryDestination,
+        expected_genesis: &str,
+    ) -> Result<()> {
+        let expected=match role {
+            RecoveryDestination::Payout=>&quote.destinations().xmz_payout,
+            RecoveryDestination::Refund=>&quote.destinations().xmz_refund,
+        };
+        ensure!(&self.destination==expected && self.wallet.network()==expected.network()
+            && quote.terms()["xmzGenesis"]==expected_genesis,"recovery destination or chain differs from quote");
+        let cap:u64=quote.terms()["xmzNativeFeeMaxAtoms"].parse()?;
+        let principal:u64=quote.terms()["xmzAtoms"].parse()?;
+        ensure!(self.maximum_fee.atoms()>0 && self.maximum_fee.atoms()<=cap,
+            "recovery fee budget exceeds quote");
+        ensure!(self.amount.atoms()>0
+            && u128::from(self.amount.atoms())+u128::from(self.maximum_fee.atoms())<=u128::from(principal),
+            "recovery payment and fee budget exceed quoted lock principal");
+        Ok(())
+    }
+}
+
+/// Enforce retained quote limits before restoration, journal writes or RPC work.
+/// This does not establish user authorization or prove the caller-selected role.
+pub async fn swap_wallet_spendable_for_quote(
+    daemon: u16, wallet_port: u16, username: String, password: String,
+    network: XmzNetwork, expected_genesis: &str, request: SpendRequest,
+    quote: &crate::native_trade_quote::RecordedQuote, role: RecoveryDestination,
+) -> Result<SpendOutcome> {
+    request.check_recorded_recovery_limits(quote,role,expected_genesis)?;
+    swap_wallet_spendable(daemon,wallet_port,username,password,network,expected_genesis,request).await
+}
