+pub fn load_association(path: &std::path::Path, expected: [u8;32]) -> Result<Association> {
+    use std::{io::Read,os::unix::fs::{OpenOptionsExt,MetadataExt}};
+    let mut file=std::fs::OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW|libc::O_NONBLOCK).open(path)?;
+    let metadata=file.metadata()?;
+    ensure!(metadata.is_file() && metadata.uid()==unsafe {libc::geteuid()}
+        && metadata.mode()&0o077==0 && metadata.nlink()==1 && metadata.len()<=131072,
+        "invalid retained fixture quote file");
+    let mut bytes=Vec::new(); (&mut file).take(131073).read_to_end(&mut bytes)?;
+    ensure!(bytes.len()<=131072,"oversized retained fixture quote");
+    let association:Association=serde_json::from_slice(&bytes)?;
+    ensure!(association.fingerprint()?==expected,"retained fixture quote fingerprint mismatch");
+    Ok(association)
+}
