+use super::*;
+use agreement::execution::funding::relay::FundingRelayReview;
+use swap_core::bch::funding::SignedFunding;
+#[derive(Clone,Copy,PartialEq,Eq)]
+pub(super) enum Case {Acknowledged,Lost,Expired}
+
+fn invoke(helper: &std::path::Path,path: &std::path::Path,action: &str,
+    commitment: Option<&str>,success: bool) -> Result<Value> {
+    let id=uuid::Uuid::new_v4();
+    let mut request=json!({"schema":format!("monzero-bch-funding-{action}-request-v1"),"requestId":id});
+    if let Some(commitment)=commitment {request["commitment"]=json!(commitment);}
+    let mut child=Command::new(helper).arg(format!("--funding-{action}-stdio-v1")).arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert_eq!(output.status.success(),success,"unexpected funding {action} result");
+    if !success {
+        assert!(output.stdout.is_empty());
+        assert_eq!(output.stderr,b"BCH admission request failed; inspect retained state before retrying\n");
+        return Ok(Value::Null)
+    }
+    assert!(output.stderr.is_empty());assert!(output.stdout.len()<=16384);
+    let response:Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response["schema"],format!("monzero-bch-funding-{action}-response-v1"));
+    assert_eq!(response["requestId"],id.to_string());
+    assert_eq!(response["executable"],false);assert_eq!(response["chainObserved"],false);
+    Ok(response)
+}
+
+pub(super) async fn exercise(case: Case,setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: Server,rpc: &BchRpc,signed: &SignedFunding,review: &FundingRelayReview,
+    helper: &std::path::Path,funding_path: &std::path::Path,config_store: &PrivateStore,
+    historical_time: u64,script: &bitcoin::Script) -> Result<()> {
+    let approved=hex(&review.commitment);let txid=signed.lock_outpoint().txid.to_string();
+    let trade=&setup.quote.terms()["swapId"];
+    let intent=metadata.0.join(format!("{trade}.bch-funding-relay-intent"));
+    let ack=metadata.0.join(format!("{trade}.bch-funding-relay-ack"));
+    let cookie=config_store.0.join("cookie");save(&cookie,b"user:pass\n")?;
+    std::fs::set_permissions(&cookie,std::fs::Permissions::from_mode(0o400))?;
+    let rpc_path=config_store.0.join("rpc.json");
+    let descriptor=json!({"schema":"monzero-private-bch-funding-rpc-v1","port":server.port,
+        "wallet":"test","anchor":"bchreg:qanchor","anchorScript":script.to_hex_string(),
+        "cookieFile":cookie,"checkpointHeight":1,"checkpoint":"07".repeat(32),
+        "subversion":"/Bitcoin Cash Node:29.0.0/"});
+    save(&rpc_path,&serde_json::to_vec(&descriptor)?)?;
+    let submit_path=config_store.0.join("submit.json");
+    save(&submit_path,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-funding-submit-v1",
+        "fundingConfigFile":funding_path,"rpcFile":rpc_path}))?)?;
+    {
+        let mut state=server.state.lock().unwrap();
+        state.observed=Some(signed.transaction().clone());state.observed_vout=signed.lock_outpoint().vout;
+        state.observation_mode=2;state.observation_chain_calls=0;state.locked=true;
+        state.relay_intent=Some(intent.clone());state.relay_mode=if case==Case::Lost {1} else {0};
+    }
+    let secrets=contents(&snapshots.0)?;
+    let status=|expected: &str| -> Result<()> {
+        let before=contents(&metadata.0)?;
+        let response=invoke(helper,funding_path,"status",None,true)?;
+        assert_eq!(response["tradeId"],*trade);
+        assert_eq!(response["review"]["details"],review.details);
+        assert_eq!(response["review"]["commitment"],approved);
+        assert_eq!(response["relay"],json!({"state":expected,"txid":txid,"confirmed":false}));
+        assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+        Ok(())
+    };
+    status("not-attempted")?;
+    let before=contents(&metadata.0)?;
+    invoke(helper,&submit_path,"submit",None,false)?;
+    invoke(helper,&submit_path,"submit",Some(&"00".repeat(32)),false)?;
+    invoke(helper,funding_path,"status",Some(&approved),false)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(server.state.lock().unwrap().relay_calls,0);
+    if case==Case::Expired {
+        invoke(helper,&submit_path,"submit",Some(&approved),false)?;
+        invoke(helper,funding_path,"review",None,false)?;
+        assert_eq!(server.state.lock().unwrap().relay_calls,0);
+        let mut historical=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        historical.relay_bch_funding(rpc,&review.commitment,historical_time).await?;
+        drop(historical);
+        invoke(helper,&submit_path,"submit",Some(&approved),false)?;
+        assert_eq!(server.state.lock().unwrap().relay_calls,1);
+        drop(server);status("acknowledged")?;
+        return Ok(())
+    }
+    // Backend binding and original app consent are checked before relay.
+    let mut wrong=descriptor.clone();wrong["wallet"]=json!("other");
+    save(&rpc_path,&serde_json::to_vec(&wrong)?)?;
+    invoke(helper,&submit_path,"submit",Some(&approved),false)?;
+    save(&rpc_path,&serde_json::to_vec(&descriptor)?)?;
+    let consent_path=metadata.0.join(format!("{trade}.bch-execution-approval-bch-funder"));
+    let consent=std::fs::read(&consent_path)?;std::fs::remove_file(&consent_path)?;
+    invoke(helper,&submit_path,"submit",Some(&approved),false)?;save(&consent_path,&consent)?;
+    std::fs::set_permissions(&cookie,std::fs::Permissions::from_mode(0o644))?;
+    invoke(helper,&submit_path,"submit",Some(&approved),false)?;
+    std::fs::set_permissions(&cookie,std::fs::Permissions::from_mode(0o400))?;
+    assert_eq!(contents(&metadata.0)?,before);assert!(!intent.exists());assert!(!ack.exists());
+    assert_eq!(server.state.lock().unwrap().relay_calls,0);
+    let acknowledged=case==Case::Acknowledged;
+    let response=invoke(helper,&submit_path,"submit",Some(&approved),acknowledged)?;
+    let state=if acknowledged {"acknowledged"} else {"attempted"};
+    if acknowledged {
+        assert_eq!(response["review"]["details"],review.details);
+        assert_eq!(response["relay"],json!({"state":state,"txid":txid,"confirmed":false}));
+    }
+    assert!(intent.is_file());assert_eq!(ack.exists(),acknowledged);
+    assert_eq!(server.state.lock().unwrap().relay_calls,1);
+    let retained=contents(&metadata.0)?;
+    invoke(helper,&submit_path,"submit",Some(&approved),acknowledged)?;
+    assert_eq!(server.state.lock().unwrap().relay_calls,1);
+    assert_eq!(contents(&metadata.0)?,retained);assert_eq!(contents(&snapshots.0)?,secrets);
+    // Status cannot contact the node: even its descriptor and cookie are gone.
+    drop(server);std::fs::remove_file(&rpc_path)?;std::fs::remove_file(&cookie)?;
+    status(state)?;
+    let saved=std::fs::read(&intent)?;save(&intent,b"{}")?;
+    invoke(helper,funding_path,"status",None,false)?;
+    save(&intent,&saved)?;status(state)?;
+    Ok(())
+}
