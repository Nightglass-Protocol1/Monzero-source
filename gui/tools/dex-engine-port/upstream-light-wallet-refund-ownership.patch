+#[test]
+fn ownership_requires_retained_allocation_and_matching_account()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    let receive=standard().derive(Branch::Receive,0)?;
+    assert!(!book.contains_allocated_address(receive.address())?);
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;
+    let before=fs::read(dir.0.join(NAME))?;
+    assert!(book.contains_allocated_address(receive.address())?);
+    assert!(!book.contains_allocated_address(standard().derive(Branch::Receive,1)?.address())?);
+    assert!(!book.contains_allocated_address(account(LtcNetwork::Regtest,0,2).derive(Branch::Receive,0)?.address())?);
+    assert!(!book.contains_allocated_address(account(LtcNetwork::Testnet,0,1).derive(Branch::Receive,0)?.address())?);
+    assert_eq!(fs::read(dir.0.join(NAME))?,before);
+    book.retain_discovered([2,1])?;
+    assert!(book.contains_allocated_address(standard().derive(Branch::Receive,1)?.address())?);
+    assert!(book.contains_allocated_address(standard().derive(Branch::Change,0)?.address())?);
+    fs::write(dir.0.join(NAME),before)?;
+    assert!(book.contains_allocated_address(receive.address()).is_err());Ok(())
+}
