+    /// Match only retained allocations, including explicitly retained discovery.
+    /// This is public account membership, not proof of an unlocked signing key.
+    /// The validated journal bounds the search to MAX_ENTRIES and is rechecked.
+    pub fn contains_allocated_address(&self,address:&LightAddress)->Result<bool> {
+        ensure!(self.usable && self.journal.read(NAME)?==self.bytes,"address book changed before ownership check");
+        let mut found=false;
+        if address.network()==self.account.network() {
+            for entry in &self.record.entries {
+                let branch=if entry.branch==0 {Branch::Receive}else{Branch::Change};
+                if self.account.derive(branch,entry.index)?.address().script_pubkey()==address.script_pubkey() {found=true;break;}
+            }
+        }
+        ensure!(self.journal.read(NAME)?==self.bytes,"address book changed during ownership check");
+        Ok(found)
     }
