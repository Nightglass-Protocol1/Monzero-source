+fn top_up_inputs(incoming: &Value, request: &ExactNetRequest,
+    top_up_txid: &str) -> Result<BTreeSet<String>> {
+    let source = &request.source;
+    ensure!(hash(top_up_txid) && top_up_txid != "0".repeat(64)
+        && top_up_txid != source.lock_txid, "invalid or repeated top-up identity");
+    let reserve = source.locked.atoms().checked_sub(request.principal.atoms())
+        .context("top-up principal exceeds total")?;
+    ensure!(request.principal.atoms() > 0 && reserve > 0, "empty top-up or principal");
+    let bound = |txid: &str, amount| FullProceedsRequest {
+        wallet: source.wallet.clone(), destination: source.destination.clone(),
+        lock_txid: txid.into(), locked: XmzAmount::from_atoms(amount),
+        maximum_fee: source.maximum_fee, account: source.account, priority: source.priority,
+    };
+    let mut keys = lock_inputs(incoming, &bound(&source.lock_txid, request.principal.atoms()))?;
+    for key in lock_inputs(incoming, &bound(top_up_txid, reserve))? {
+        ensure!(keys.insert(key), "overlapping top-up inputs");
+    }
+    Ok(keys)
+}
