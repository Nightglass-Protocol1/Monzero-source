+//! Current evidence of the exact cancellation, including peer publication.
+//! No local dispatch is required, and observation never rewrites relay history.
+use super::*;
+use bitcoin::BlockHash;
+use crate::bch_rpc::confirmed::ConfirmedTransaction;
+
+pub struct ConfirmedCancellation {
+    quote: [u8;32],admission: [u8;32],review: [u8;32],confirmation: ConfirmedTransaction,
+}
+impl ConfirmedCancellation {
+    pub fn quote(&self) -> &[u8;32] {&self.quote}
+    pub fn admission(&self) -> &[u8;32] {&self.admission}
+    pub fn review(&self) -> &[u8;32] {&self.review}
+    pub fn confirmation(&self) -> &ConfirmedTransaction {&self.confirmation}
+}
+impl AdmittedExecution<'_> {
+    /// The exact cancellation can be published by either peer. Existing local
+    /// relay records must validate, but their absence is not an observation veto.
+    /// This does not establish that the recovery output remains unspent or that
+    /// its punishment timeout is distant; refund release requires fresh checks.
+    pub async fn observe_bch_cancel(&self,bch: &BchRpc,block: Option<BlockHash>) -> Result<ConfirmedCancellation> {
+        let (review,cancel,_,at,deployment)=self.cancel_relay_materials()?;
+        self.cancel_state(&review,at,cancel.compute_txid())?;
+        ensure!(bch.deployment_commitment()?==deployment,"BCH cancellation confirmation observer changed");
+        let admission=self.admission_digest()?;
+        let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmation=match block {
+            Some(block)=>bch.confirmed_transaction(cancel.compute_txid(),block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(cancel.compute_txid(),minimum).await?,
+        };
+        ensure!(confirmation.deployment()==&deployment && serialize(confirmation.transaction())==serialize(&cancel),
+            "confirmed BCH cancellation differs from retained recovery");
+        Ok(ConfirmedCancellation {quote:*self.quote.commitment(),admission,
+            review:review.commitment,confirmation})
+    }
+}
