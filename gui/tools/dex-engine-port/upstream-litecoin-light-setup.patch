+use super::*;
+use std::{fs,os::unix::fs::PermissionsExt};
+const PASSWORD:&[u8]=b"PUBLIC SETUP TEST PASSWORD";
+struct Fixture {root:PathBuf,setup:PathBuf,paths:SetupDirectories,wallet:Uuid}
+impl Fixture {
+    fn new()->Result<Self> {
+        let root=std::env::temp_dir().join(format!("monzero-ltc-setup-{}",Uuid::new_v4()));
+        fs::create_dir(&root)?;fs::set_permissions(&root,fs::Permissions::from_mode(0o700))?;
+        for name in ["setup","vault","addresses","backup"] {
+            let path=root.join(name);fs::create_dir(&path)?;fs::set_permissions(path,fs::Permissions::from_mode(0o700))?;
+        }
+        Ok(Self {setup:root.join("setup"),paths:SetupDirectories {vault:root.join("vault"),
+            addresses:root.join("addresses"),backup:root.join("backup")},root,wallet:Uuid::new_v4()})
+    }
+    fn initialize(&self)->Result<CreatedWallet> {initialize(&self.setup,&self.paths,LtcNetwork::Regtest,self.wallet,0,PASSWORD)}
+}
+impl Drop for Fixture {fn drop(&mut self) {let _=fs::remove_dir_all(&self.root);}}
+#[test]
+fn setup_reuses_seed_after_every_partial_publication_and_keeps_backup()->Result<()> {
+    for stage in [Publication::Intent,Publication::Vault,Publication::Addresses,Publication::Backup] {
+        let f=Fixture::new()?;
+        assert!(initialize_with(&f.setup,&f.paths,LtcNetwork::Regtest,f.wallet,0,PASSWORD,|at| {
+            if at==stage {anyhow::bail!("injected publication interruption")}Ok(())
+        }).is_err());
+        let original=fs::read(f.setup.join(INTENT))?;
+        assert!(!f.setup.join(COMPLETE).exists());
+        let ready=f.initialize()?;let digest=ready.backup().digest();
+        assert_eq!(fs::read(f.setup.join(INTENT))?,original);
+        let intent:Intent=serde_json::from_slice(&original)?;
+        assert_eq!(fs::read(f.paths.vault.join(NAME))?,intent.encrypted_seed);
+        assert_eq!(ready.backup().allocated(),[0,0]);
+        let completion=fs::read(f.setup.join(COMPLETE))?;
+        assert_eq!(f.initialize()?.backup().digest(),digest);
+        assert_eq!(fs::read(f.setup.join(COMPLETE))?,completion);
+        let destination=Fixture::new()?;
+        let (encrypted,_)=backup::storage::load_verified(&f.paths.backup,PASSWORD,LtcNetwork::Regtest,f.wallet)?;
+        let (vault,mut book)=backup::restore(&destination.paths.vault,&destination.paths.addresses,LtcNetwork::Regtest,f.wallet,PASSWORD,&encrypted)?;
+        let seed=vault.unlock_for_account(PASSWORD,&ready.account().descriptor())?;
+        assert_eq!(serde_json::to_vec(&seed.public_account(LtcNetwork::Regtest,0)?.descriptor())?,
+            serde_json::to_vec(&ready.account().descriptor())?);
+        assert_eq!(book.reserve(Uuid::new_v4(),Branch::Receive)?.path().to_string(),"84'/1'/0'/0/0");
+    }
+    Ok(())
+}
+#[test]
+fn setup_rejects_changed_context_credentials_corruption_and_existing_wallets()->Result<()> {
+    let f=Fixture::new()?;
+    assert!(initialize_with(&f.setup,&f.paths,LtcNetwork::Regtest,f.wallet,0,PASSWORD,|_|anyhow::bail!("stop after intent")).is_err());
+    let original=fs::read(f.setup.join(INTENT))?;
+    assert!(initialize(&f.setup,&f.paths,LtcNetwork::Regtest,f.wallet,0,b"wrong").is_err());
+    assert!(initialize(&f.setup,&f.paths,LtcNetwork::Regtest,Uuid::new_v4(),0,PASSWORD).is_err());
+    assert!(initialize(&f.setup,&f.paths,LtcNetwork::Testnet,f.wallet,0,PASSWORD).is_err());
+    assert!(initialize(&f.setup,&f.paths,LtcNetwork::Regtest,f.wallet,1,PASSWORD).is_err());
+    let other=Fixture::new()?;
+    assert!(initialize(&f.setup,&other.paths,LtcNetwork::Regtest,f.wallet,0,PASSWORD).is_err());
+    assert_eq!(fs::read(f.setup.join(INTENT))?,original);assert!(!f.paths.vault.join(NAME).exists());
+    fs::write(f.setup.join(INTENT),b"corrupt")?;assert!(f.initialize().is_err());
+    assert_eq!(fs::read(f.setup.join(INTENT))?,b"corrupt");
+    fs::write(other.paths.vault.join(NAME),b"existing")?;
+    fs::set_permissions(other.paths.vault.join(NAME),fs::Permissions::from_mode(0o600))?;
+    assert!(other.initialize().is_err());assert!(!other.setup.join(INTENT).exists());
+    assert_eq!(fs::read(other.paths.vault.join(NAME))?,b"existing");
+    Ok(())
+}
+#[test]
+fn setup_requires_distinct_private_directories_and_does_not_reset_allocations()->Result<()> {
+    let f=Fixture::new()?;let mut paths=f.paths.clone();paths.backup=paths.vault.clone();
+    assert!(initialize(&f.setup,&paths,LtcNetwork::Regtest,f.wallet,0,PASSWORD).is_err());
+    fs::set_permissions(&f.paths.backup,fs::Permissions::from_mode(0o755))?;
+    assert!(f.initialize().is_err());assert!(!f.setup.join(INTENT).exists());
+    fs::set_permissions(&f.paths.backup,fs::Permissions::from_mode(0o700))?;
+    let ready=f.initialize()?;let original=fs::read(f.setup.join(INTENT))?;
+    let mut book=AddressBook::open(&f.paths.addresses,PublicAccount::from_descriptor(&ready.account().descriptor(),LtcNetwork::Regtest)?)?;
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;drop(book);
+    let allocated=fs::read(f.paths.addresses.join(ADDRESSES))?;
+    assert!(f.initialize().is_err());assert_eq!(fs::read(f.paths.addresses.join(ADDRESSES))?,allocated);
+    assert_eq!(fs::read(f.setup.join(INTENT))?,original);
+    Ok(())
+}
