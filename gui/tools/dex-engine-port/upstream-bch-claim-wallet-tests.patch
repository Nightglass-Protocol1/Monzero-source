@@ -0,0 +1,126 @@
+//! Synthetic authenticated local wallet service; never a real daemon/wallet.
+use super::*;
+use std::sync::{Arc,Mutex};
+use tokio::io::{AsyncReadExt,AsyncWriteExt};
+
+#[derive(Default)]
+pub(crate) struct State {
+    pub calls: Vec<String>,pub opened: bool,pub exists: bool,
+    pub lose_restore: bool,pub lose_scan: bool,pub wrong_key: bool,pub fail_open: bool,
+    pub intent: Option<std::path::PathBuf>,
+}
+pub(crate) struct Fixture {
+    pub state: Arc<Mutex<State>>,daemon: tokio::net::TcpListener,wallet: u16,
+    network: XmzNetwork,task: tokio::task::JoinHandle<Result<()>>,
+}
+impl Drop for Fixture {fn drop(&mut self) {self.task.abort();}}
+impl Fixture {
+    pub fn session(&self) -> Result<NativeWalletSession> {
+        Ok(NativeWalletSession::new(NativeFundingRpc::new(self.daemon.local_addr()?.port(),self.wallet,
+            "fixture".into(),"fixture".into())?,self.network))
+    }
+    pub async fn new(id: &SwapWalletId,address: &XmzAddress,spend: &[u8;32],view: &[u8;32],txid: &str) -> Result<Self> {
+        let daemon=tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await?;let wallet=listener.local_addr()?.port();
+        let state=Arc::new(Mutex::new(State::default()));let shared=state.clone();
+        let filename=id.filename();let network=address.network();let address=address.to_string();let txid=txid.to_owned();
+        let hex=|bytes:&[u8;32]|bytes.iter().map(|b|format!("{b:02x}")).collect::<String>();
+        let spend=hex(spend);let view=hex(view);
+        let task=tokio::spawn(async move {
+            loop {
+                let (mut stream,_)=listener.accept().await?;let mut bytes=Vec::new();
+                let (headers,body)=loop {
+                    let mut buffer=[0;4096];
+                    let count=tokio::time::timeout(std::time::Duration::from_secs(3),stream.read(&mut buffer)).await??;
+                    ensure!(count>0 && bytes.len()+count<=16384,"invalid wallet fixture request");bytes.extend_from_slice(&buffer[..count]);
+                    if let Some(end)=bytes.windows(4).position(|v|v==b"\r\n\r\n") {
+                        let headers=String::from_utf8(bytes[..end].to_vec())?.to_ascii_lowercase();
+                        let length:usize=headers.lines().find_map(|s|s.strip_prefix("content-length:"))
+                            .context("missing wallet fixture length")?.trim().parse()?;
+                        if bytes.len()>=end+4+length {break (headers,bytes[end+4..end+4+length].to_vec());}
+                    }
+                };
+                if !headers.lines().any(|s|s.starts_with("authorization:")) {
+                    stream.write_all(b"HTTP/1.1 401 Unauthorized\r\nWWW-Authenticate: Digest realm=\"fixture\", nonce=\"fixture-nonce\", qop=\"auth\", algorithm=MD5\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").await?;continue;
+                }
+                let request:serde_json::Value=serde_json::from_slice(&body)?;
+                let method=request["method"].as_str().context("missing wallet fixture method")?;let p=&request["params"];
+                let (response,lost)={
+                    let mut state=shared.lock().unwrap();state.calls.push(method.into());let mut error=None;let mut lost=false;
+                    let result=match method {
+                        "get_address"=>{
+                            ensure!(p==&json!({"account_index":0}),"wrong wallet account");
+                            if !state.opened {error=Some(json!({"code":-13,"message":"not open"}));}
+                            json!({"address":address})
+                        },
+                        "generate_from_keys"=>{
+                            ensure!(!state.exists && !state.opened,"replacement wallet restoration");
+                            if let Some(path)=&state.intent {ensure!(path.is_file(),"restoration preceded durable intent");}
+                            ensure!(p["filename"]==filename && p["address"]==address && p["spendkey"]==spend && p["viewkey"]==view
+                                && p["restore_height"]==0 && p["password"]=="fixture" && p["autosave_current"]==true,"changed wallet restore terms");
+                            state.exists=true;state.opened=true;lost=std::mem::take(&mut state.lose_restore);json!({"address":address})
+                        },
+                        "open_wallet"=>{
+                            ensure!(!state.opened && p["filename"]==filename && p["password"]=="fixture","changed wallet open terms");
+                            if !state.exists || state.fail_open {error=Some(json!({"code":-1,"message":"open failed"}));}
+                            else {state.opened=true;}json!({})
+                        },
+                        "query_key"=>{
+                            ensure!(state.opened && p==&json!({"key_type":"spend_key"}),"wrong wallet key request");
+                            json!({"key":if state.wrong_key {"00".repeat(32)} else {spend.clone()}})
+                        },
+                        "scan_tx"=>{
+                            ensure!(state.opened && p==&json!({"txids":[txid]}),"changed wallet transaction import");
+                            lost=std::mem::take(&mut state.lose_scan);json!({})
+                        },
+                        "close_wallet"=>{ensure!(state.opened,"closing absent wallet");state.opened=false;json!({})},
+                        _=>anyhow::bail!("unexpected wallet fixture method: {method}"),
+                    };
+                    let response=match error {
+                        Some(error)=>json!({"jsonrpc":"2.0","id":"native-funding","error":error}),
+                        None=>json!({"jsonrpc":"2.0","id":"native-funding","result":result}),
+                    };(response,lost)
+                };
+                if lost {continue;}
+                let body=serde_json::to_vec(&response)?;
+                let header=format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len());
+                stream.write_all(header.as_bytes()).await?;stream.write_all(&body).await?;
+            }
+        });
+        Ok(Self {state,daemon,wallet,network,task})
+    }
+}
+
+#[tokio::test]
+async fn wallet_restore_scan_and_open_are_explicit() -> Result<()> {
+    let address=XmzAddress::parse(XmzNetwork::Mainnet,"FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H")?;
+    let id=SwapWalletId::new(uuid::Uuid::from_u128(1))?;let txid="ab".repeat(32);
+    let f=Fixture::new(&id,&address,&[1;32],&[2;32],&txid).await?;let mut session=f.session()?;
+    session.preflight_restore("fixture",&address).await?;
+    assert!(!f.state.lock().unwrap().exists);
+    session.restore(&id,"01".repeat(32),"02".repeat(32),0,"fixture".into(),&address).await?;
+    assert!(session.preflight_restore("fixture",&address).await.is_err());
+    session.verify_spend_key(&[1;32],&address).await?;
+    f.state.lock().unwrap().wrong_key=true;assert!(session.verify_spend_key(&[1;32],&address).await.is_err());
+    f.state.lock().unwrap().wrong_key=false;session.import_transaction(&txid,&address).await?;
+    session.close(&address).await?;session.open(&id,"fixture".into(),&address).await?;
+    assert_eq!(f.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="generate_from_keys").count(),1);
+    Ok(())
+}
+#[tokio::test]
+async fn wallet_lost_restore_and_scan_require_explicit_session_recovery() -> Result<()> {
+    let address=XmzAddress::parse(XmzNetwork::Mainnet,"FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H")?;
+    let id=SwapWalletId::new(uuid::Uuid::from_u128(2))?;let txid="ab".repeat(32);
+    let f=Fixture::new(&id,&address,&[1;32],&[2;32],&txid).await?;let mut session=f.session()?;
+    f.state.lock().unwrap().lose_restore=true;
+    assert!(session.restore(&id,"01".repeat(32),"02".repeat(32),0,"fixture".into(),&address).await.is_err());
+    assert!(session.preflight_restore("fixture",&address).await.is_err());
+    let mut recovered=f.session()?;recovered.verify_spend_key(&[1;32],&address).await?;
+    f.state.lock().unwrap().lose_scan=true;assert!(recovered.import_transaction(&txid,&address).await.is_err());
+    assert!(recovered.verify_spend_key(&[1;32],&address).await.is_err());
+    let mut recovered=f.session()?;recovered.verify_spend_key(&[1;32],&address).await?;
+    recovered.import_transaction(&txid,&address).await?;recovered.close(&address).await?;
+    f.state.lock().unwrap().fail_open=true;assert!(recovered.open(&id,"fixture".into(),&address).await.is_err());
+    assert_eq!(f.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="generate_from_keys").count(),1);
+    Ok(())
+}
