+    /// Read the fully published candidate without RPC or journal mutation, even
+    /// after quote expiry. Cross-check the candidate against the template and
+    /// cooperative claims; a partial publication is not a completed preparation.
+    pub fn saved_bch_wallet_preparation_review(&self,deployment: &[u8;32],
+        policy: &WalletPreparationPolicy) -> Result<WalletPreparationReview> {
+        let candidate=self.wallet_preparation_candidate()?.context("BCH wallet candidate is absent")?;
+        ensure!(&candidate.deployment==deployment && candidate.policy==*policy,
+            "BCH preparation review deployment or policy changed");
+        let prepared=self.prepared_bch_funding()?.context("BCH preparation publication is incomplete")?;
+        let template=Template {schema:TEMPLATE.into(),admission:candidate.admission,
+            prepared_at:candidate.prepared_at,unsigned:candidate.unsigned.clone(),sources:candidate.sources.clone(),
+            change:policy.change_script.as_bytes().to_vec(),maximum_fee:policy.maximum_fee,
+            minimum_change:policy.minimum_change};
+        ensure!(prepared.commitment()==&hash(TEMPLATE,&serde_json::to_vec(&template)?),
+            "BCH wallet candidate differs from published preparation");
+        let preview=prepared.preview();
+        let inputs: Vec<_>=preview.transaction().input.iter().zip(preview.previous_outputs()).map(|(input,previous)|
+            serde_json::json!({"outpoint":input.previous_output.to_string(),"valueAtoms":previous.value.to_sat().to_string(),
+                "script":hex(previous.script_pubkey.as_bytes())})).collect();
+        let outputs: Vec<_>=preview.transaction().output.iter().enumerate().map(|(index,output)|
+            serde_json::json!({"vout":index,"valueAtoms":output.value.to_sat().to_string(),
+                "script":hex(output.script_pubkey.as_bytes())})).collect();
+        let details=serde_json::json!({"schema":REVIEW,"action":"inspect-unsigned-preparation",
+            "swapId":self.quote.terms()["swapId"],"quote":hex(self.quote.commitment()),
+            "admission":hex(&candidate.admission),"deployment":hex(deployment),
+            "network":self.quote.terms()["bchNetwork"],"genesis":self.quote.terms()["bchGenesis"],
+            "expiresAt":self.quote.terms()["expiresAt"],"preparedAt":candidate.prepared_at.to_string(),
+            "preparation":hex(prepared.commitment()),"policy":policy,"inputs":inputs,"outputs":outputs,
+            "feeAtoms":preview.fee().to_sat().to_string(),"contractVout":preview.lock_vout()});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok(WalletPreparationReview {details,commitment})
+    }
+
