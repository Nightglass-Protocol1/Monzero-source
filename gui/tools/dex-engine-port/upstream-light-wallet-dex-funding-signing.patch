--- /dev/null
+++ b/swap-machine/src/litecoin_negotiation/execution/light_funding/approval.rs
@@ -0,0 +1,68 @@
+//! Local funding approval after durable two-party recovery. Never broadcasts.
+use super::*;
+use crate::litecoin_light::vault::{SeedVault,mnemonic::storage::MnemonicVault};
+use super::super::lock_approval::LockFundingReview;
+use bitcoin::{Transaction,consensus::encode::serialize_hex};
+
+/// Borrow local encrypted storage; the password is never retained in the review.
+pub enum LightFundingVault<'a> { Seed(&'a SeedVault),Mnemonic(&'a MnemonicVault) }
+
+impl Execution {
+    /// Recheck the exact wallet claim, fresh quote policy and both retained
+    /// recovery messages. The returned public details are for explicit review;
+    /// obtaining them does not unlock keys, sign funding or authorize relay.
+    pub fn review_light_funding(&mut self,spend:&ObservedClaimedSpend,
+        chain:&HeaderSequence,observed:&ObservedWallet,claim:sha256::Hash,now:u64)->Result<LockFundingReview> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong light funding role");
+        ensure!(chain.network()==LightNetwork::from(self.policy.ltc_network),"wrong light funding network");
+        let (head,_,quote,_,exchange)=self.load()?;
+        let psbt=spend.funding_psbt_on(chain,observed,self.claim.trade,claim)?;
+        let binding=self.light_funding_binding(&head,&psbt,chain,claim)?;
+        ensure!(self.metadata.read(&format!("{}.ltc-light-funding",self.claim.trade))?==binding,
+            "light funding proposal differs from retained binding");
+        let keys=exchange.finish()?;
+        let plan=RecoveryPlan::new(&quote,&self.policy,now,&keys,psbt.clone())?;
+        // A fresh plan must authenticate the already-retained local message,
+        // including its exact lock/cancel/refund/punish binding. Cold recovery
+        // then independently rechecks the peer message and durable receipts.
+        let outgoing=self.recover_recovery_outgoing()?;
+        plan.verify_local_message(outgoing.bytes(),outgoing.signature())?;
+        let recovery=self.recover_recovery()?;
+        ensure!(recovery.punish.is_none(),"unexpected light-funder punishment");
+        let refund=recovery.refund.context("missing retained light-funder refund")?;
+        ensure!(recovery.cancel.input.first().is_some_and(|i|i.previous_output==plan.lock_outpoint())
+            && refund.compute_txid()==plan.refund_txid(),"light funding recovery differs from review");
+        let details=serde_json::json!({"schema":"monzero-ltc-light-funding-approval-v1",
+            "trade":self.claim.trade,"quote":self.claim.quote,"network":chain.network().storage_identity(),
+            "claimCommitment":claim,"bindingDigest":sha256::Hash::hash(&binding),
+            "txid":psbt.unsigned_tx.compute_txid(),"transaction":serialize_hex(&psbt.unsigned_tx),
+            "amountAtoms":quote.terms()["ltcAtoms"],"feeAtoms":spend.fee().to_sat().to_string(),
+            "contractAddress":keys.contract_address().to_string(),
+            "refundAddress":quote.destinations().ltc_refund.to_string(),
+            "cancelTxid":recovery.cancel.compute_txid(),"refundTxid":refund.compute_txid(),
+            "cancelBlocks":self.policy.cancel_blocks,"punishBlocks":self.policy.punish_blocks,
+            "observedHeight":observed.height(),"observedTip":observed.tip(),"action":"sign",
+            "broadcastAuthorized":false});
+        let mut hash=Sha256::new();hash.update(b"MONZERO-LTC-LIGHT-FUNDING-APPROVAL-V1\0");
+        hash.update(serde_json::to_vec(&details)?);
+        Ok(LockFundingReview {details,commitment:hash.finalize().into()})
+    }
+
+    /// Explicit approval is compared before password-based unlocking. The wallet
+    /// retains exact signed bytes under its shared input lease. Retry revalidates
+    /// the same agreement and returns those bytes; it never creates a replacement.
+    /// Expired quotes or prior submission require the separate recovery path.
+    pub fn sign_light_funding(&mut self,spend:&ObservedClaimedSpend,
+        chain:&HeaderSequence,observed:&ObservedWallet,claim:sha256::Hash,
+        approved:&[u8;32],vault:LightFundingVault<'_>,password:&[u8],now:u64)->Result<Transaction> {
+        let review=self.review_light_funding(spend,chain,observed,claim,now)?;
+        ensure!(review.commitment==*approved,"light funding approval is stale or changed");
+        let signed=match vault {
+            LightFundingVault::Seed(vault)=>spend.approve_with_vault_on(chain,observed,vault,password,claim)?,
+            LightFundingVault::Mnemonic(vault)=>spend.approve_with_mnemonic_on(chain,observed,vault,password,claim)?,
+        };
+        ensure!(signed.compute_txid()==spend.transaction().compute_txid()
+            && spend.retained_signed()?==signed,"light funding signed record changed");
+        Ok(signed)
+    }
+}
