+// Offline native-funder punishment terms and retained dispatch history only.
+use super::*;
+use swap_machine::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding::recovery::punish::observation::relay::PunishRelayState;
+fn request(bytes:&[u8],action:&str)->Result<Request> {
+    ensure!(matches!(action,"review"|"status") && !bytes.is_empty() && bytes.len()<=512,"invalid punishment request size or action");
+    let request:Request=serde_json::from_slice(bytes)?;
+    ensure!(!request.request_id.is_nil() && request.schema==format!("monzero-bch-punish-{action}-request-v1")
+        && request.commitment.is_none(),"invalid offline punishment request");Ok(request)
+}
+fn config(bytes:&[u8])->Result<FundingConfig> {
+    let config:FundingConfig=serde_json::from_slice(bytes)?;
+    ensure!(config.schema=="monzero-private-bch-punish-v1" && config.admission_config_file.is_absolute(),
+        "invalid punishment configuration");parse_digest(&config.deployment_commitment)?;Ok(config)
+}
+pub(super) fn operation(path:&Path,bytes:&[u8],action:&str)->Result<serde_json::Value> {
+    let request=request(bytes,action)?;
+    let (_wrapper_lease,bytes)=private_bytes(path)?;let wrapper=config(&bytes)?;
+    let deployment=parse_digest(&wrapper.deployment_commitment)?;
+    let (_config_lease,config)=load(&wrapper.admission_config_file)?;
+    ensure!(matches!(config.role,Role::NativeFunder),"punishment requires native funder");
+    let (_quote_lease,bytes)=private_bytes(&config.quote_file)?;
+    let quote=VerifiedBchQuote::restore_record(&bytes,&config.policy,config.admitted_at,
+        &config.identity_pins[0],&config.identity_pins[1],&parse_digest(&config.quote_commitment)?)?;
+    ensure!(quote.terms()["swapId"].parse::<uuid::Uuid>()?==config.trade_id,"punishment trade changed");
+    let execution=AdmittedExecution::resume(&config.metadata_directory,&config.snapshot_directory,&quote,&config.policy,config.role)?;
+    execution.saved_admission_review(&config.negotiation_pins)?;
+    let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    let review=execution.review_bch_punish_relay_for_deployment(&deployment,now)?;
+    let (state,txid)=match execution.bch_punish_relay_state()? {
+        None=>("not-attempted",review.details["txid"].as_str().context("missing punishment txid")?.to_owned()),
+        Some(PunishRelayState::Attempted {txid})=>("attempted",txid.to_string()),
+        Some(PunishRelayState::Acknowledged {txid})=>("acknowledged",txid.to_string()),
+    };
+    let commitment=review.commitment.iter().map(|b|format!("{b:02x}")).collect::<String>();
+    Ok(serde_json::json!({"schema":format!("monzero-bch-punish-{action}-response-v1"),
+        "requestId":request.request_id,"tradeId":config.trade_id,"executable":false,"chainObserved":false,
+        "review":{"details":review.details,"commitment":commitment},
+        "relay":{"state":state,"txid":txid,"confirmed":false},"observation":null}))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn offline_requests_reject_dispatch_and_approval()->Result<()> {
+        let value=serde_json::json!({"schema":"monzero-bch-punish-review-request-v1","requestId":uuid::Uuid::new_v4()});
+        assert!(request(&serde_json::to_vec(&value)?,"review").is_ok());
+        assert!(request(&serde_json::to_vec(&value)?,"status").is_err());
+        for action in ["submit","observe","window",""] {assert!(request(&serde_json::to_vec(&value)?,action).is_err());}
+        let mut value=value;value["commitment"]="00".repeat(32).into();
+        assert!(request(&serde_json::to_vec(&value)?,"review").is_err());
+        value.as_object_mut().unwrap().remove("commitment");value["requestId"]=uuid::Uuid::nil().to_string().into();
+        assert!(request(&serde_json::to_vec(&value)?,"review").is_err());Ok(())
+    }
+    #[test]
+    fn configuration_has_no_rpc_or_secret_fields()->Result<()> {
+        let base=serde_json::json!({"schema":"monzero-private-bch-punish-v1","admissionConfigFile":"/private/admission","deploymentCommitment":"ab".repeat(32)});
+        assert!(config(&serde_json::to_vec(&base)?).is_ok());
+        for field in ["rpcFile","cookieFile","password","bchObserverKind"] {
+            let mut value=base.clone();value[field]="unexpected".into();assert!(config(&serde_json::to_vec(&value)?).is_err());
+        }
+        let mut value=base.clone();value["schema"]="monzero-private-bch-cancel-v1".into();assert!(config(&serde_json::to_vec(&value)?).is_err());
+        let mut value=base;value["admissionConfigFile"]="relative".into();assert!(config(&serde_json::to_vec(&value)?).is_err());Ok(())
+    }
+}
