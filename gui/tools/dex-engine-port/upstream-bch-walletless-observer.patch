+use super::*;
+use crate::bch_rpc::observation::FundingStatus;
+use bitcoin::{absolute,transaction::Version,Amount,OutPoint,Sequence,Transaction,Txid,TxIn,Witness,
+    secp256k1,sighash::{SighashCache,EcdsaSighashType},hashes::sha256d};
+use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},sync::{Arc,atomic::AtomicBool}};
+
+fn funding()->Result<swap_core::bch::funding::SignedFunding> {
+    let (policy,terms)=crate::bch_quote::tests::fixture();
+    let quote=crate::bch_quote::tests::signed(&terms,&policy,1000)?;
+    let secp=secp256k1::Secp256k1::new();let secret=secp256k1::SecretKey::from_slice(&[5;32])?;
+    let key=secp256k1::PublicKey::from_secret_key(&secp,&secret);
+    let script=ScriptBuf::new_p2pkh(&bitcoin::PublicKey::new(key).pubkey_hash());
+    let parent=Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(120_000),script_pubkey:script.clone()}]};
+    let mut tx=parent.clone();tx.input[0].previous_output=OutPoint {txid:parent.compute_txid(),vout:0};
+    tx.output=vec![TxOut {value:Amount::from_sat(100_000),script_pubkey:quote.recovery_plan().lock().script_pubkey()},
+        TxOut {value:Amount::from_sat(19_000),script_pubkey:script.clone()}];
+    let preview=FundingPreview::verify(&serialize(&tx),&[&serialize(&parent)],quote.recovery_plan().lock(),100_000,&script,1000,546)?;
+    let mut preimage=Vec::new();SighashCache::new(&tx).segwit_v0_encode_signing_data_to(&mut preimage,0,&script,
+        Amount::from_sat(120_000),EcdsaSighashType::All)?;
+    let end=preimage.len();preimage[end-4..].copy_from_slice(&0x41u32.to_le_bytes());
+    let sig=secp.sign_ecdsa(&secp256k1::Message::from_digest(sha256d::Hash::hash(&preimage).to_byte_array()),&secret).serialize_der();
+    let mut bytes=vec![(sig.len()+1) as u8];bytes.extend(sig.as_ref());bytes.push(0x41);bytes.push(33);bytes.extend(key.serialize());
+    tx.input[0].script_sig=ScriptBuf::from_bytes(bytes);preview.verify_signed(&serialize(&tx))
+}
+#[test]
+fn bch_walletless_observer_identity_is_separate_and_credentials_can_rotate()->Result<()> {
+    let network=BchNetwork::Regtest {checkpoint_height:1,checkpoint:BlockHash::from_byte_array([7;32])};
+    let create=|port,password:&str|OwnedBchObserver::new(port,"user".into(),password.into(),network,"/Bitcoin Cash Node:29.0.0/".into());
+    let observer=create(12345,"first")?;
+    assert_eq!(observer.deployment_commitment()?,create(12345,"second")?.deployment_commitment()?);
+    assert_ne!(observer.deployment_commitment()?,create(12346,"first")?.deployment_commitment()?);
+    let wallet=BchRpc::new(12345,"user".into(),"first".into(),network,"test".into(),"bchreg:qanchor".into(),ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+    assert_ne!(observer.deployment_commitment()?,wallet.deployment_commitment()?);
