+//! Read-only chain access to a separately authenticated owned BCHN process.
+//! No wallet, private key, signing, reservation or broadcast capability.
+//! This remains trusted loopback RPC, not public SPV consensus verification.
+use super::*;
+
+pub struct OwnedBchObserver {
+    client: reqwest::Client, pub(super) port: u16,
+    username: Zeroizing<String>, password: Zeroizing<String>,
+    pub(super) network: BchNetwork, pub(super) subversion: String, request_id: AtomicU64,
+}
+impl OwnedBchObserver {
+    pub fn new(port:u16,username:String,password:String,network:BchNetwork,subversion:String)->Result<Self> {
+        let username=Zeroizing::new(username);let password=Zeroizing::new(password);
+        ensure!(port>0 && !username.is_empty() && !password.is_empty() && !username.contains(':')
+            && username.len()+password.len()<=1024,"invalid BCH RPC credentials or port");
+        ensure!(subversion.starts_with("/Bitcoin Cash Node:") && subversion.ends_with('/') && subversion.len()<=128,
+            "expected owned Bitcoin Cash Node subversion required");
+        network.checkpoint()?;
+        Ok(Self {client:reqwest::Client::builder().no_proxy().pool_max_idle_per_host(0)
+            .redirect(reqwest::redirect::Policy::none()).timeout(std::time::Duration::from_secs(15)).build()?,
+            port,username,password,network,subversion,request_id:AtomicU64::new(0)})
+    }
+    pub fn network(&self)->BchNetwork {self.network}
+    /// Configuration identity only; no RPC, wallet identity or proof of ownership.
+    /// Credentials may rotate without changing the selected chain deployment.
+    pub fn deployment_commitment(&self)->Result<[u8;32]> {
+        let (height,checkpoint)=self.network.checkpoint()?;
+        let bytes=serde_json::to_vec(&json!({"schema":"monzero-bch-chain-observer-v1",
+            "host":"127.0.0.1","port":self.port,"network":self.network.quote_name(),
+            "genesis":self.network.genesis(),"checkpointHeight":height,"checkpoint":checkpoint,
+            "subversion":self.subversion}))?;
+        Ok(sha256::Hash::hash(&bytes).to_byte_array())
+    }
+    pub(super) async fn rpc(&self, wallet: Option<&str>, method: &str, params: Value) -> Result<Box<RawValue>> {
+        self.rpc_optional(wallet,method,params,false).await?.context("missing BCH RPC result")
+    }
+    // Only getmempoolentry's explicit -5 means missing; transport/authentication
+    // errors, malformed envelopes and every other RPC failure remain errors.
+    pub(super) async fn rpc_optional(&self, wallet: Option<&str>, method: &str, params: Value, missing_mempool: bool)
+        -> Result<Option<Box<RawValue>>> {
+        let id=self.request_id.fetch_update(Ordering::Relaxed,Ordering::Relaxed,|v|v.checked_add(1))
+            .map_err(|_|anyhow::anyhow!("BCH RPC identity exhausted"))?;
+        let path=wallet.map(|name|format!("/wallet/{name}")).unwrap_or_default();
+        let mut response=self.client.post(format!("http://127.0.0.1:{}{}",self.port,path))
+            .basic_auth(self.username.as_str(),Some(self.password.as_str()))
+            .json(&json!({"jsonrpc":"1.0","id":id,"method":method,"params":params})).send().await
+            .map_err(|_|anyhow::anyhow!("BCH local RPC transport failed"))?;
+        let status = response.status();
+        ensure!(status.is_success() || (missing_mempool && status.as_u16()==500),"BCH local RPC HTTP rejection");
+        let mut bytes=Vec::new();
+        while let Some(chunk)=response.chunk().await.map_err(|_|anyhow::anyhow!("BCH RPC response failed"))? {
+            ensure!(bytes.len()+chunk.len()<=2_000_000,"oversized BCH RPC response");bytes.extend_from_slice(&chunk);
+        }
+        let reply:Envelope=serde_json::from_slice(&bytes).map_err(|_|anyhow::anyhow!("invalid BCH RPC envelope"))?;
+        ensure!(reply.id==id,"BCH RPC identity mismatch");
+        if let Some(error) = reply.error {
+            ensure!(missing_mempool && wallet.is_none() && method=="getmempoolentry"
+                && error["code"].as_i64()==Some(-5) && error["message"].is_string()
+                && reply.result.get()=="null","BCH RPC rejection");
+            return Ok(None)
+        }
+        ensure!(status.is_success(),"BCH RPC success envelope with HTTP failure");
+        Ok(Some(reply.result))
+    }
+    pub(super) async fn chain_state(&self) -> Result<Chain> {
+        let info:Value=serde_json::from_str(self.rpc(None,"getnetworkinfo",json!([])).await?.get())?;
+        ensure!(info["subversion"].as_str()==Some(self.subversion.as_str()) && info["networkactive"]==true,
+            "unexpected or offline BCH deployment");
+        let chain:Chain=serde_json::from_str(self.rpc(None,"getblockchaininfo",json!([])).await?.get())?;
+        let (height,checkpoint)=self.network.checkpoint()?;
+        ensure!(chain.chain==self.network.chain() && !chain.initialblockdownload && chain.blocks==chain.headers
+            && chain.blocks>=height && chain.blocks<=i32::MAX as u64 && chain.bestblockhash!=BlockHash::all_zeros(),"BCH chain is not synchronized to expected deployment");
+        let genesis:BlockHash=serde_json::from_str(self.rpc(None,"getblockhash",json!([0])).await?.get())?;
+        let anchor:BlockHash=serde_json::from_str(self.rpc(None,"getblockhash",json!([height])).await?.get())?;
+        ensure!(genesis.to_string()==self.network.genesis() && anchor==checkpoint,"BCH genesis or fork checkpoint mismatch");
+        Ok(chain)
+    }
+}
