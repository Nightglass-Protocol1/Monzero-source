+    /// Public protocol cursor for an owned coordinator. No frame, key material,
+    /// repair or chain operation is exposed by this read.
+    pub fn negotiation_status(&self)->Result<serde_json::Value> {
+        let (head,_,_,_,_)=self.load()?;
+        Ok(serde_json::json!({"next":if head.step==2 {"complete"}
+            else if head.step==self.claim.role {"local"} else {"peer"},
+            "outgoingRetained":head.outgoing_source.is_some()}))
+    }
+
     /// Read the local message for an external identity signer. Secret trade keys
     /// remain in the engine; the returned message contains private view material.
