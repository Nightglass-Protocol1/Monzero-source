+impl Execution {
+    /// Admit wallet preparation before reserving addresses/inputs. This checks
+    /// payment policy only; it is neither a reservation nor spending authority.
+    pub fn check_light_funding_payment(&self,payment:&bitcoin::TxOut,fee:bitcoin::Amount,
+        minimum_change:bitcoin::Amount,now:u64)->Result<()> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong light funding role");
+        let (_,_,quote,_,exchange)=self.load()?;
+        quote.check_policy(&self.policy,now)?;
+        let keys=exchange.finish()?;
+        ensure!(payment.script_pubkey==*keys.contract_address().script_pubkey()
+            && payment.value.to_sat()==quote.terms()["ltcAtoms"].parse::<u64>()?
+            && fee.to_sat()>0 && fee.to_sat()<=quote.terms()["ltcFundingFeeMaxAtoms"].parse::<u64>()?
+            && minimum_change.to_sat()>=quote.terms()["ltcMinimumOutputAtoms"].parse::<u64>()?,
+            "light funding payment differs from negotiated policy");
+        Ok(())
+    }
+}
