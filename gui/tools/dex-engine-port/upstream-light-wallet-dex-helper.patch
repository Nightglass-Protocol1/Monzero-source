+//! Owned-regtest driver fixture: real helper owns all wallet funding operations.
+use super::*;
+use std::{io::Write,os::unix::fs::OpenOptionsExt};
+use serde::{Deserialize,Serialize};
+use crate::litecoin_quote::Policy;
+#[derive(Deserialize,Serialize)]
+struct Context {policy:Policy,trade:uuid::Uuid,pins:[[u8;32];2]}
+fn write(path:&Path,value:&serde_json::Value)->Result<()> {
+    let mut file=fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(path)?;
+    file.write_all(&serde_json::to_vec(value)?)?;file.sync_all()?;Ok(())
+}
+#[test]
+#[ignore="requires owned helper/node/TLS fixture"]
+fn actual_light_dex_helper_context()->Result<()> {
+    let root=PathBuf::from(std::env::var("MONZERO_LIGHT_DEX_FIXTURE_ROOT")?).canonicalize()?;
+    let stage=std::env::var("MONZERO_LIGHT_DEX_FIXTURE_STAGE")?;
+    let bi=SigningKey::from_bytes(&[1;32]);let ai=SigningKey::from_bytes(&[2;32]);
+    let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    if stage=="init" {
+        for name in ["bob-meta","bob-secrets","alice-meta","alice-secrets"] {fs::DirBuilder::new().mode(0o700).create(root.join(name))?;}
+        let (policy,mut terms)=crate::litecoin_quote::tests::fixture();terms.insert("expiresAt".into(),(now+1800).to_string());
+        let quote=crate::litecoin_quote::tests::signed(&terms,&policy,now)?;
+        let trade=quote.terms()["swapId"].parse()?;let pins=[bi.verifying_key().to_bytes(),ai.verifying_key().to_bytes()];
+        let mut rng=rand::rngs::StdRng::seed_from_u64(91452);
+        let mut bob=Execution::begin(&root.join("bob-meta"),&root.join("bob-secrets"),&quote,&policy,LocalRole::LitecoinFunder,quote.commitment(),now,&mut rng)?;
+        let mut alice=Execution::begin(&root.join("alice-meta"),&root.join("alice-secrets"),&quote,&policy,LocalRole::NativeFunder,quote.commitment(),now,&mut rng)?;
+        let message=bob.outgoing(&bi,now)?;alice.accept_peer(message.bytes(),message.signature(),now)?;
+        let message=alice.outgoing(&ai,now)?;bob.accept_peer(message.bytes(),message.signature(),now)?;
+        write(&root.join("context.json"),&serde_json::to_value(Context {policy,trade,pins})?)?;
+        write(&root.join("payment.json"),&serde_json::json!({"address":bob.completed_keys()?.contract_address().to_string(),
+            "amountAtomic":"100000000","feeAtomic":"10000","minimumChangeAtomic":"100000","minimumConfirmations":1}))?;
+    } else {
+        anyhow::ensure!(stage=="peer","invalid helper fixture stage");
+        let context:Context=serde_json::from_slice(&fs::read(root.join("context.json"))?)?;
+        let mut bob=Execution::resume(&root.join("bob-meta"),&root.join("bob-secrets"),context.trade,&context.policy,LocalRole::LitecoinFunder,context.pins)?;
+        let mut alice=Execution::resume(&root.join("alice-meta"),&root.join("alice-secrets"),context.trade,&context.policy,LocalRole::NativeFunder,context.pins)?;
+        let prepared:serde_json::Value=serde_json::from_slice(&fs::read(root.join("prepared.json"))?)?;
+        use bitcoin::hex::FromHex;
+        let frame=Vec::from_hex(prepared["result"]["recoveryFrame"].as_str().unwrap())?;
+        let psbt:bitcoin::psbt::Psbt=prepared["result"]["fundingPsbt"].as_str().unwrap().parse()?;
+        let signature=bi.sign(&crate::litecoin_negotiation::recovery::signing_bytes(&frame)?).to_bytes();
+        let message=bob.submit_recovery_signature(&frame,&signature,now)?;
+        let other=alice.prepare_recovery(&psbt,&ai,now)?;
+        bob.accept_recovery(other.bytes(),other.signature())?;alice.accept_recovery(message.bytes(),message.signature())?;
+    }
+    Ok(())
+}
