diff --git a/swap-machine/src/bin/native-ltc-light/dex.rs b/swap-machine/src/bin/native-ltc-light/dex.rs
new file mode 100644
--- /dev/null
+++ b/swap-machine/src/bin/native-ltc-light/dex.rs
@@ -0,0 +1,205 @@
+// Isolated-chain DEX commands over a local private pipe. No identity key input.
+use super::*;
+use swap_machine::{litecoin_quote::Policy,litecoin_negotiation::{LocalRole,execution::{Execution,
+    light_funding::approval::LightFundingVault}}};
+use swap_machine::litecoin_light::vault::mnemonic::storage::MnemonicVault;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct DexConfig {schema:String,wallet_config_file:PathBuf,metadata_directory:PathBuf,
+    snapshot_directory:PathBuf,trade_id:uuid::Uuid,pins:[[u8;32];2],policy:Policy}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct DexRequest {schema:String,request_id:uuid::Uuid,approved_config_digest:String,
+    maximum_download_headers:u32,payment:Payment,retained_review:Option<RetainedReview>,
+    wallet_scan:Option<WalletScan>,maximum_history_entries:Option<usize>,
+    approval:Option<String>,password:Option<Password>}
+
+pub(super) fn mode(flag:&str)->Option<&str> {
+    let name=flag.strip_prefix("--dex-funding-")?.strip_suffix("-stdio-v1")?;
+    ["prepare","review","sign","send-review","send","observe","retry-review","retry"].contains(&name).then_some(name)
+}
+fn cold(mode:&str)->bool {matches!(mode,"observe"|"retry-review"|"retry")}
+fn digest(value:&str)->Result<sha256::Hash> {
+    let hash:sha256::Hash=value.parse()?;
+    ensure!(hash.to_string()==value,"noncanonical DEX approval digest");Ok(hash)
+}
+fn validate(request:&DexRequest,mode:&str)->Result<()> {
+    ensure!(request.schema==format!("monzero-ltc-light-dex-funding-{mode}-request-v1")
+        && !request.request_id.is_nil() && (1..=10_000_000).contains(&request.maximum_download_headers),"invalid light DEX request");
+    digest(&request.approved_config_digest)?;
+    ensure!(request.retained_review.is_some() || mode=="prepare","missing retained DEX funding review");
+    ensure!(request.password.is_some()==(mode=="sign"),"unexpected DEX password field");
+    ensure!(request.approval.is_some()==matches!(mode,"sign"|"send"|"retry"),"invalid DEX approval fields");
+    if let Some(value)=&request.approval {digest(value)?;}
+    ensure!(if cold(mode) {request.wallet_scan.is_none() && request.maximum_history_entries.is_some_and(|n|(1..=1000).contains(&n))}
+        else {request.maximum_history_entries.is_none() && request.wallet_scan.as_ref().is_some_and(|s|
+            (1..=500).contains(&s.gap) && (1..=500).contains(&s.addresses_per_branch)
+                && (1..=1000).contains(&s.history_entries_per_branch))},"invalid DEX observation budget");
+    ensure!((1..=1000).contains(&request.payment.minimum_confirmations),"invalid DEX input confirmation policy");
+    if let Some(review)=&request.retained_review {digest(&review.signing_commitment)?;}
+    Ok(())
+}
+fn context_digest(dex:&[u8],wallet:&[u8])->Result<sha256::Hash> {
+    Ok(sha256::Hash::hash(&serde_json::to_vec(&json!({"schema":"monzero-ltc-light-dex-context-v1",
+        "dexDigest":sha256::Hash::hash(dex),"walletDigest":sha256::Hash::hash(wallet)}))?))
+}
+fn public_review(review:swap_machine::litecoin_negotiation::execution::lock_approval::LockFundingReview)->Value {
+    json!({"details":review.details,"commitment":sha256::Hash::from_byte_array(review.commitment).to_string()})
+}
+pub(super) fn run(path:&Path,mode:&str)->Result<()> {
+    let mut input=Zeroizing::new(Vec::new());std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid light DEX request size");
+    let request:DexRequest=serde_json::from_slice(&input)?;drop(input);validate(&request,mode)?;
+    let (_lease,bytes)=private_config(path)?;let dex:DexConfig=serde_json::from_slice(&bytes)?;
+    ensure!(dex.schema=="monzero-private-ltc-light-dex-v1" && !dex.trade_id.is_nil()
+        && dex.policy.ltc_network==LtcNetwork::Regtest,"light DEX helper is limited to isolated Litecoin regtest");
+    let (_wallet_lease,wallet_bytes)=private_config(&dex.wallet_config_file)?;
+    let expected=context_digest(&bytes,&wallet_bytes)?;
+    ensure!(expected==digest(&request.approved_config_digest)?,"light DEX configuration changed");
+    let wallet_config=parse_config(&wallet_bytes,"ltc")?;
+    let network=network_for("ltc",&wallet_config.network)?;
+    ensure!(network==LightNetwork::from(LtcNetwork::Regtest),"wrong light DEX wallet network");
+    let mut execution=Execution::resume(&dex.metadata_directory,&dex.snapshot_directory,dex.trade_id,
+        &dex.policy,LocalRole::LitecoinFunder,dex.pins)?;
+    let result=tokio::runtime::Builder::new_current_thread().enable_all().build()?.block_on(async {
+        tokio::time::timeout(std::time::Duration::from_secs(3600),execute(&wallet_config,network,&dex,&request,mode,&mut execution))
+            .await.context("light DEX operation deadline exceeded")?
+    })?;
+    let response=json!({"schema":format!("monzero-ltc-light-dex-funding-{mode}-response-v1"),
+        "requestId":request.request_id,"tradeId":dex.trade_id,"configurationDigest":expected,
+        "executable":false,"result":result});
+    let bytes=serde_json::to_vec(&response)?;ensure!(bytes.len()<=262144,"oversized light DEX response");
+    std::io::stdout().write_all(&bytes)?;Ok(())
+}
+async fn execute(config:&Config,network:LightNetwork,dex:&DexConfig,request:&DexRequest,
+    mode:&str,execution:&mut Execution)->Result<Value> {
+    let payment=&request.payment;
+    let address=LightAddress::parse(network,&payment.address)?;
+    let output=TxOut {value:atomic(&payment.amount_atomic)?,script_pubkey:address.script_pubkey().clone()};
+    let policy=PreparationPolicy {fee:atomic(&payment.fee_atomic)?,minimum_change:atomic(&payment.minimum_change_atomic)?,
+        minimum_confirmations:payment.minimum_confirmations};
+    if !cold(mode) {execution.check_light_funding_payment(&output,policy.fee,policy.minimum_change,now()?)?;}
+    let mut state=ChainState::open(&config.cache_directory,network,config.maximum_height,now()?)?;
+    let sync=synchronize(config,network,&mut state,request.maximum_download_headers).await?;
+    ensure!(sync["reportedTipOnSelectedChain"]==json!(true)
+        && sync["reportedHeight"].as_u64()==Some(u64::from(state.chain()?.height())),"DEX peer tip differs from selected chain");
+    let endpoint=config.endpoint.as_ref().context("missing DEX TLS endpoint")?;
+    let target=TlsEndpoint::new(endpoint.host.clone(),endpoint.port,network)?;
+    if cold(mode) {
+        let retained=request.retained_review.as_ref().context("missing DEX retained review")?;
+        let expected=digest(&retained.signing_commitment)?;
+        let (claim,mut result)=recovered_payment(config,network,payment,dex.trade_id,retained)?;
+        let mut session=target.connect().await?;
+        let observation=execution.observe_light_funding_on(&claim,state.chain()?,expected,&mut session,
+            request.maximum_history_entries.context("missing DEX history budget")?).await?;
+        drop(session);
+        apply_broadcast_status(&mut result,&claim,endpoint,&target,expected)?;
+        result["observation"]=match observation.position_on(state.chain()?)? {
+            PaymentPosition::NotReported=>json!({"position":"not-reported"}),
+            PaymentPosition::ReportedPending=>json!({"position":"reported-pending"}),
+            PaymentPosition::Included {height,block_hash,confirmations}=>json!({"position":"included","height":height,"blockHash":block_hash,"confirmations":confirmations}),
+        };
+        result["selectedHeight"]=json!(observation.selected_height());result["selectedTip"]=json!(observation.selected_tip());
+        if mode=="retry-review" {result["review"]=public_review(execution.review_light_funding_retry(&claim,state.chain()?,expected,&target,&observation)?);}
+        if mode=="retry" {
+            let approved=digest(request.approval.as_deref().context("missing DEX retry approval")?)?.to_byte_array();
+            result["txid"]=json!(execution.retry_light_funding(&claim,state.chain()?,expected,&target,&observation,&approved).await?);
+            apply_broadcast_status(&mut result,&claim,endpoint,&target,expected)?;
+            result["watchOnly"]=json!(false);
+        }
+        return Ok(result);
+    }
+    let wallet=config.wallet.as_ref().context("missing DEX wallet")?;
+    let directory=wallet.spend_directory.as_ref().context("missing DEX spend journal")?;
+    let account=PublicAccount::from_descriptor(&wallet.account,network)?;
+    let mut book=AddressBook::open(&wallet.address_book_directory,PublicAccount::from_descriptor(&wallet.account,network)?)?;
+    let retained=request.retained_review.as_ref().map(|r|retained_context(&book,r,dex.trade_id)).transpose()?;
+    let allocated=[book.allocated_count(Branch::Receive)?,book.allocated_count(Branch::Change)?];
+    let scan=request.wallet_scan.as_ref().context("missing DEX wallet scan")?;
+    let mut session=target.connect().await?;
+    let observation=session.refresh_wallet(state.chain()?,&account,allocated,&RefreshLimits {gap:scan.gap,
+        addresses_per_branch:scan.addresses_per_branch,history_entries_per_branch:scan.history_entries_per_branch}).await?;drop(session);
+    let prepared=if let Some((expected,change))=retained {
+        observation.reopen_payment(state.chain()?,&output,change,policy.fee,policy.minimum_confirmations,directory,dex.trade_id,expected)?
+    } else {observation.prepare_payment(state.chain()?,&output,&policy,&mut book,directory,dex.trade_id)?};
+    ensure!(prepared.fee()==policy.fee && prepared.transaction().output.get(1).is_none_or(|o|o.value>=policy.minimum_change),"DEX wallet payment policy changed");
+    let expected=prepared.signing_commitment();
+    let mut result=payment_view(network,&address.to_string(),&output,prepared.transaction(),prepared.fee(),expected)?;
+    match mode {
+        "prepare"=>{
+            let frame=execution.light_recovery_signing_frame(&prepared,state.chain()?,observation.accounting(),expected,now()?)?;
+            result["recoveryFrame"]=json!(frame.iter().map(|b|format!("{b:02x}")).collect::<String>());
+            result["fundingPsbt"]=json!(prepared.funding_psbt_on(state.chain()?,observation.accounting(),dex.trade_id,expected)?.to_string());
+        },
+        "review"=>result["review"]=public_review(execution.review_light_funding(&prepared,state.chain()?,observation.accounting(),expected,now()?)?),
+        "sign"=>{
+            let vault=wallet.vault.as_ref().context("missing DEX vault")?;
+            let approved=digest(request.approval.as_deref().context("missing DEX signing approval")?)?.to_byte_array();
+            let password=request.password.as_ref().context("missing DEX password")?.0.as_bytes();
+            let signed=match vault.seed_encoding {
+                vault_format::VaultFormat::Raw=>{
+                    let local=SeedVault::open(&vault.directory,network,vault.wallet_id)?;
+                    execution.sign_light_funding(&prepared,state.chain()?,observation.accounting(),expected,&approved,LightFundingVault::Seed(&local),password,now()?)?
+                },
+                vault_format::VaultFormat::Mnemonic=>{
+                    let local=MnemonicVault::open(&vault.directory,network,vault.wallet_id)?;
+                    execution.sign_light_funding(&prepared,state.chain()?,observation.accounting(),expected,&approved,LightFundingVault::Mnemonic(&local),password,now()?)?
+                },
+            };
+            result["signed"]=json!(true);result["watchOnly"]=json!(false);
+            result["txid"]=json!(signed.compute_txid());result["broadcast"]=json!(false);
+        },
+        "send-review"=>{
+            result["review"]=public_review(execution.review_light_funding_send(&prepared,state.chain()?,observation.accounting(),expected,&target,now()?)?);
+            result["signed"]=json!(true);
+        },
+        "send"=>{
+            let approved=digest(request.approval.as_deref().context("missing DEX send approval")?)?.to_byte_array();
+            result["txid"]=json!(execution.send_light_funding(&prepared,state.chain()?,observation.accounting(),expected,&target,&approved,now()?).await?);
+            result["signed"]=json!(true);result["watchOnly"]=json!(false);result["broadcastStatus"]=json!("server-acknowledged");result["confirmationStatus"]=json!("unassessed");
+        },
+        _=>anyhow::bail!("invalid fresh DEX operation"),
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request(mode:&str)->Value {
+        let mut value=json!({"schema":format!("monzero-ltc-light-dex-funding-{mode}-request-v1"),
+            "requestId":uuid::Uuid::new_v4(),"approvedConfigDigest":"11".repeat(32),"maximumDownloadHeaders":1000,
+            "payment":{"address":"fixture","amountAtomic":"100000000","feeAtomic":"1000","minimumChangeAtomic":"100000","minimumConfirmations":1}});
+        if mode!="prepare" {value["retainedReview"]=json!({"signingCommitment":"22".repeat(32),"changeAddress":null});}
+        if cold(mode) {value["maximumHistoryEntries"]=json!(10);} else {value["walletScan"]=json!({"gap":2,"addressesPerBranch":10,"historyEntriesPerBranch":50});}
+        if matches!(mode,"sign"|"send"|"retry") {value["approval"]=json!("33".repeat(32));}
+        if mode=="sign" {value["password"]=json!("test credential");}value
+    }
+    #[test]
+    fn modes_isolate_passwords_approvals_and_observation_budgets()->Result<()> {
+        for name in ["prepare","review","sign","send-review","send","observe","retry-review","retry"] {
+            assert_eq!(mode(&format!("--dex-funding-{name}-stdio-v1")),Some(name));
+            let valid=request(name);validate(&serde_json::from_value(valid.clone())?,name)?;
+            for field in ["schema","requestId","approvedConfigDigest","maximumDownloadHeaders"] {
+                let mut bad=valid.clone();bad.as_object_mut().unwrap().remove(field);
+                assert!(serde_json::from_value::<DexRequest>(bad).is_err());
+            }
+            let mut bad=valid.clone();bad["password"]=if name=="sign" {Value::Null}else{json!("unexpected")};
+            assert!(validate(&serde_json::from_value(bad)?,name).is_err());
+            let mut bad=valid.clone();bad["approval"]=if matches!(name,"sign"|"send"|"retry") {Value::Null}else{json!("33".repeat(32))};
+            assert!(validate(&serde_json::from_value(bad)?,name).is_err());
+            let mut bad=valid.clone();bad["maximumDownloadHeaders"]=json!(0);
+            assert!(validate(&serde_json::from_value(bad)?,name).is_err());
+            let mut bad=valid;bad["unknown"]=json!(true);assert!(serde_json::from_value::<DexRequest>(bad).is_err());
+        }
+        assert!(mode("--dex-funding-sign-stdio-v2").is_none());assert!(mode("--wallet-sign-stdio-v1").is_none());Ok(())
+    }
+    #[test]
+    fn context_fingerprint_binds_both_exact_private_files()->Result<()> {
+        let a=context_digest(b"dex",b"wallet")?;
+        assert_ne!(a,context_digest(b"dex ",b"wallet")?);
+        assert_ne!(a,context_digest(b"dex",b"wallet ")?);
+        assert_ne!(a,context_digest(b"wallet",b"dex")?);Ok(())
+    }
+}
