+async fn phase(event: &std::path::Path,gate: &std::path::Path,stage: &str,expected: &str,txid: Txid) -> Result<()> {
+    let pending=event.with_extension("pending");
+    save(&pending,&serde_json::to_vec(&json!({"phase":stage,"txid":txid.to_string()}))?)?;
+    std::fs::rename(&pending,event)?;
+    tokio::time::timeout(std::time::Duration::from_secs(90),async {
+        loop {
+            match std::fs::read(gate) {
+                Ok(bytes)=>{ensure!(bytes.len()<64,"oversized fixture phase");if bytes==expected.as_bytes() {return Ok(())}},
+                Err(e) if e.kind()==std::io::ErrorKind::NotFound=>(),
+                Err(e)=>return Err(e.into()),
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+    }).await.context("node fixture phase timed out")?
