+//! Public payment terms for a local BCH wallet. No input reservation or secrets.
+use super::*;
+use bitcoin::{Amount,TxOut};
+
+impl AdmittedExecution<'_> {
+    /// Derive the exact covenant payment from the revalidated admitted exchange.
+    /// Script bytes are used because BCH covenant destinations need not be P2PKH.
+    pub fn light_funding_terms(&self,now:u64)->Result<serde_json::Value> {
+        let plan=self.quote.recovery_plan();
+        let payment=TxOut {value:Amount::from_sat(plan.terms().locked_atoms),
+            script_pubkey:plan.lock().script_pubkey()};
+        let fee=self.quote.terms()["bchFundingFeeMaxAtoms"].parse::<u64>()?;
+        let minimum=self.quote.terms()["bchMinimumOutputAtoms"].parse::<u64>()?;
+        self.check_light_funding_payment(&payment,Amount::from_sat(fee),Amount::from_sat(minimum),now)?;
+        Ok(serde_json::json!({"schema":"monzero-bch-light-funding-terms-v1",
+            "tradeId":self.quote.terms()["swapId"],"quoteCommitment":hex(self.quote.commitment()),
+            "network":self.quote.terms()["bchNetwork"],"genesis":self.quote.terms()["bchGenesis"],
+            "contractScript":hex(payment.script_pubkey.as_bytes()),"amountAtomic":payment.value.to_sat().to_string(),
+            "maximumFeeAtomic":fee.to_string(),"minimumChangeAtomic":minimum.to_string(),
+            "lockConfirmations":self.policy.bch_confirmations,"refundScript":self.quote.terms()["bchRefundScript"],
+            "expiresAt":self.quote.terms()["expiresAt"],"watchOnly":true,"broadcastAuthorized":false}))
+    }
+
+    /// Validate payment policy before a local wallet allocates change or inputs.
+    /// Ownership, fresh chain evidence, signing and relay remain separate checks.
+    pub fn check_light_funding_payment(&self,payment:&TxOut,fee:Amount,
+        minimum_change:Amount,now:u64)->Result<()> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH light funding role");
+        ensure!(now>=self.read_admission()?.admitted_at,"BCH light funding predates admission");
+        self.restore_agreement()?.check_bch_funding(self.quote,self.policy,now,
+            &payment.script_pubkey,payment.value.to_sat(),fee.to_sat())?;
+        ensure!(minimum_change.to_sat()>=self.quote.terms()["bchMinimumOutputAtoms"].parse::<u64>()?
+            && minimum_change.to_sat()<=21_000_000*100_000_000,"BCH light funding change policy mismatch");
+        Ok(())
+    }
+}
