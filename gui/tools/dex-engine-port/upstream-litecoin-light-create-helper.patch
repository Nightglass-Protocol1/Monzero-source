+//! Bind setup options and publish the standard private helper configuration.
+//! Publication does not activate the account or contact the configured server.
+use super::*;
+use bitcoin::hashes::{Hash,sha256};
+use crate::litecoin_light::tls::TlsEndpoint;
+use serde_json::{Value,json};
+const SETTINGS:&str="litecoin-wallet-settings.json";
+const CONFIGURATION:&str="litecoin-wallet.json";
+pub struct ConfigurationOptions {
+    pub cache:PathBuf,
+    pub spends:PathBuf,
+    pub maximum_height:u32,
+    pub endpoint:Option<TlsEndpoint>,
+}
+pub struct ConfiguredWallet {
+    wallet:CreatedWallet,
+    path:PathBuf,
+    digest:sha256::Hash,
+}
+impl ConfiguredWallet {
+    pub fn wallet(&self)->&CreatedWallet {&self.wallet}
+    pub fn configuration_path(&self)->&Path {&self.path}
+    pub fn configuration_digest(&self)->sha256::Hash {self.digest}
+}
+impl ConfigurationOptions {
+    fn endpoint_value(&self)->Value {
+        self.endpoint.as_ref().map(|e|json!({"host":e.host(),"port":e.port()})).unwrap_or(Value::Null)
+    }
+    fn validate(&self,setup:&Path,paths:&SetupDirectories,network:LtcNetwork)->Result<()> {
+        ensure!(self.maximum_height<=10_000_000 && self.endpoint.as_ref().is_none_or(|e|e.network()==network),
+            "invalid Litecoin creation chain settings");
+        let directories=[setup,paths.vault.as_path(),paths.addresses.as_path(),paths.backup.as_path(),
+            self.cache.as_path(),self.spends.as_path()];
+        for (i,directory) in directories.iter().enumerate() {
+            ensure!(directories[..i].iter().all(|other|other!=directory),"creation directories must be distinct");
+            drop(Journal::open(directory)?);
+        }
+        Ok(())
+    }
+}
+/// The caller explicitly approves these settings before passing a password.
+/// Identical retries reuse both keys and configuration; changed settings fail.
+/// Configuration contains only public account data and local storage paths.
+pub fn initialize_configured(setup:&Path,paths:&SetupDirectories,network:LtcNetwork,wallet:Uuid,
+    index:u32,password:&[u8],options:&ConfigurationOptions)->Result<ConfiguredWallet> {
+    ensure!(!wallet.is_nil() && !password.is_empty() && password.len()<=1024,"invalid wallet creation identity or password");
+    bitcoin::bip32::ChildNumber::from_hardened_idx(index)?;
+    options.validate(setup,paths,network)?;
+    let settings=serde_json::to_vec(&json!({"schema":"monzero-ltc-wallet-settings-v1","network":network.name(),
+        "wallet":wallet,"account":index,"directories":paths,"cache":options.cache,"spends":options.spends,
+        "maximumHeight":options.maximum_height,"endpoint":options.endpoint_value()}))?;
+    {
+        let journal=Journal::open(setup)?;
+        // A standalone setup/configuration cannot silently adopt new settings.
+        match journal.read(SETTINGS) {
+            Err(error) if missing(&error)=>{
+                require_absent(&journal,INTENT)?;require_absent(&journal,COMPLETE)?;require_absent(&journal,CONFIGURATION)?;
+            },
+            Err(error)=>return Err(error),
+            Ok(existing)=>ensure!(existing==settings,"Litecoin creation settings changed"),
+        }
+        journal.retain(SETTINGS,&settings)?;
+    }
+    let created=initialize(setup,paths,network,wallet,index,password)?;
+    let mut configuration=json!({"schema":"monzero-private-ltc-light-v1","network":network.name(),
+        "cacheDirectory":options.cache,"maximumHeight":options.maximum_height,
+        "wallet":{"account":created.account().descriptor(),"addressBookDirectory":paths.addresses,
+            "spendDirectory":options.spends,"vault":{"directory":paths.vault,"walletId":wallet}}});
+    if options.endpoint.is_some() {configuration["endpoint"]=options.endpoint_value();}
+    let bytes=serde_json::to_vec(&configuration)?;
+    ensure!(bytes.len()<=4096,"oversized generated Litecoin configuration");
+    let journal=Journal::open(setup)?;
+    ensure!(journal.read(SETTINGS)?==settings,"Litecoin creation settings changed before publication");
+    journal.retain(CONFIGURATION,&bytes)?;
+    ensure!(journal.read(CONFIGURATION)?==bytes,"Litecoin configuration read-back mismatch");
+    Ok(ConfiguredWallet {wallet:created,path:setup.join(CONFIGURATION),digest:sha256::Hash::hash(&bytes)})
+}
