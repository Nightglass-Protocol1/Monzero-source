+use super::*;
+use agreement::execution::funding::success::publication::SuccessRecordStage;
+use sha2::{Digest,Sha256};
+fn copy_store(path:&std::path::Path)->Result<PrivateStore> {
+    let store=PrivateStore::new()?;
+    for entry in std::fs::read_dir(path)? {let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),store.0.join(entry.file_name()))?;}}
+    Ok(store)
+}
+fn hashes(path:&std::path::Path)->Result<std::collections::BTreeMap<std::ffi::OsString,[u8;32]>> {
+    let mut result=std::collections::BTreeMap::new();
+    for entry in std::fs::read_dir(path)? {let entry=entry?;if entry.file_type()?.is_file() {result.insert(entry.file_name(),Sha256::digest(std::fs::read(entry.path())?).into());}}
+    Ok(result)
+}
+pub(in crate::bch_key_recovery::authenticated::native_wallet::tests)
+async fn exercise(execution:&mut AdmittedExecution<'_>,setup:&Setup,fixture:&super::super::light_observer::Fixture,
+    funding:&Transaction,metadata:&std::path::Path,snapshots:&std::path::Path)->Result<()> {
+    let native=Native::new(execution,setup)?;let observer=&fixture.observer;
+    retain_proof(execution,setup,funding,&native)?;
+    let review=execution.review_light_bch_success_release(observer,5,2010)?;
+    let frame=execution.prepare_reviewed_light_bch_success_release(&native,observer,5,2010,&review.commitment).await?;
+    let review=execution.review_light_bch_success_signature_retention(observer,5,2011)?;
+    let signature=SigningKey::from_bytes(&[1;32]).sign(&agreement::success::signing_bytes(&frame)?).to_bytes();
+    let original=execution.retain_reviewed_light_bch_success_signature(&native,observer,5,2011,&frame,&signature,&review.commitment).await?;
+    let original_public=hashes(metadata)?;let original_private=hashes(snapshots)?;
+    for (stage,label) in [(SuccessRecordStage::Prepared,"prepared"),(SuccessRecordStage::Signed,"signed")] {
+        let slot=format!("{}.bch-success-{label}",setup.quote.terms()["swapId"]);
+        let record=Zeroizing::new(std::fs::read(snapshots.join(&slot))?);
+        let pin=std::fs::read(metadata.join(format!("{slot}-pin")))?;
+        assert_eq!(*Zeroizing::new(std::fs::read(snapshots.join(format!("{slot}-candidate")))?),*record);
+        for pin_retained in [false,true] {
+            let public=copy_store(metadata)?;let private=copy_store(snapshots)?;
+            let published=private.0.join(&slot);let pinned=public.0.join(format!("{slot}-pin"));
+            let candidate=private.0.join(format!("{slot}-candidate"));
+            std::fs::remove_file(&published)?;if !pin_retained {std::fs::remove_file(&pinned)?;}
+            let recovered=AdmittedExecution::resume(&public.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+            let calls=fixture.calls.load(Ordering::Relaxed);let observations=native.snapshots.load(Ordering::SeqCst);
+            assert!(recovered.saved_light_bch_success_preparation(observer,5,2020).is_err());
+            let before_public=hashes(&public.0)?;let before_private=hashes(&private.0)?;
+            let repair=recovered.review_light_bch_success_publication_repair(observer,stage,2020)?;
+            assert_eq!(repair.details["releasesPrivateMaterial"],false);assert_eq!(repair.details["chainApproval"],false);
+            assert_eq!(repair.details["stage"],label);assert_eq!(repair.details["fundingSource"],"local-wallet");
+            if matches!(stage,SuccessRecordStage::Prepared) && !pin_retained {
+                let port=u16::try_from(observer.deployment_context()?["port"].as_u64().context("missing fixture port")?)?;
+                let node=crate::bch_rpc::BchRpc::new(port,"user".into(),"pass".into(),observer.network(),"test".into(),
+                    "bchreg:qanchor".into(),bitcoin::ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+                let changed=crate::bch_rpc::observer::OwnedBchObserver::new(if port==65535 {port-1}else{port+1},"user".into(),"pass".into(),
+                    observer.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+                assert!(recovered.review_bch_success_publication_repair(&node,stage,2020).is_err());
+                assert!(recovered.repair_reviewed_bch_success_publication(&node,stage,2020,&repair.commitment).is_err());
+                assert!(recovered.review_light_bch_success_publication_repair(&changed,stage,2020).is_err());
+                assert!(recovered.repair_reviewed_light_bch_success_publication(&changed,stage,2020,&repair.commitment).is_err());
+            }
+            if matches!(stage,SuccessRecordStage::Signed) && pin_retained {
+                let prepared=format!("{}.bch-success-prepared",setup.quote.terms()["swapId"]);
+                let prepared_pin=format!("{prepared}-pin");
+                std::fs::remove_file(private.0.join(&prepared))?;std::fs::remove_file(public.0.join(&prepared_pin))?;
+                let interrupted_public=hashes(&public.0)?;let interrupted_private=hashes(&private.0)?;
+                assert!(recovered.review_light_bch_success_publication_repair(observer,stage,2020).err()
+                    .context("prepared publication must be repaired first")?.to_string().contains("publication is pending"));
+                assert_eq!(hashes(&public.0)?,interrupted_public);assert_eq!(hashes(&private.0)?,interrupted_private);
+                std::fs::copy(snapshots.join(&prepared),private.0.join(&prepared))?;
+                std::fs::copy(metadata.join(&prepared_pin),public.0.join(&prepared_pin))?;
+            }
+            assert!(recovered.repair_reviewed_light_bch_success_publication(observer,stage,2020,&[0;32]).is_err());
+            assert_eq!(hashes(&public.0)?,before_public);assert_eq!(hashes(&private.0)?,before_private);
+            // Malformed candidate and a conflicting durable pin must not be repaired.
+            std::fs::write(&candidate,b"{}")?;
+            let tampered=hashes(&private.0)?;
+            assert!(recovered.review_light_bch_success_publication_repair(observer,stage,2020).is_err());
+            assert_eq!(hashes(&public.0)?,before_public);assert_eq!(hashes(&private.0)?,tampered);
+            std::fs::write(&candidate,&*record)?;
+            if matches!(stage,SuccessRecordStage::Prepared) && !pin_retained {
+                // Preserve the exact canonical struct field order using the
+                // original bytes; a later preparation must not reanchor a
+                // previously signed record whose timestamp is earlier.
+                let altered=std::str::from_utf8(&record)?.replace("\"at\":2010","\"at\":2012");
+                assert_ne!(altered.as_bytes(),record.as_slice());
+                std::fs::write(&candidate,altered.as_bytes())?;
+                assert!(recovered.review_light_bch_success_publication_repair(observer,stage,2020).err()
+                    .context("conflicting preparation time must fail")?.to_string().contains("differs from signed record"));
+                std::fs::write(&candidate,&*record)?;
+            }
+            if pin_retained {
+                let changed=std::str::from_utf8(&pin)?.replace("monzero-bch-success-release-pin-v1","monzero-bch-success-release-pin-v2");
+                std::fs::write(&pinned,changed.as_bytes())?;let tampered=hashes(&public.0)?;
+                assert!(recovered.review_light_bch_success_publication_repair(observer,stage,2020).is_err());
+                assert_eq!(hashes(&public.0)?,tampered);assert_eq!(hashes(&private.0)?,before_private);
+                std::fs::write(&pinned,&pin)?;
+            }
+            recovered.repair_reviewed_light_bch_success_publication(observer,stage,2020,&repair.commitment)?;
+            assert_eq!(*Zeroizing::new(std::fs::read(&published)?),*record);assert_eq!(std::fs::read(&pinned)?,pin);
+            let repaired_public=hashes(&public.0)?;let repaired_private=hashes(&private.0)?;
+            recovered.repair_reviewed_light_bch_success_publication(observer,stage,2021,&repair.commitment)?;
+            assert_eq!(hashes(&public.0)?,repaired_public);assert_eq!(hashes(&private.0)?,repaired_private);
+            assert_eq!(fixture.calls.load(Ordering::Relaxed),calls);assert_eq!(native.snapshots.load(Ordering::SeqCst),observations);
+            drop(recovered);
+            let mut cold=AdmittedExecution::resume(&public.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+            assert_eq!(cold.review_light_bch_success_publication_repair(observer,stage,2022)?.commitment,repair.commitment);
+            let release=cold.review_signed_light_bch_success_release(observer,5,2022)?;
+            if matches!(stage,SuccessRecordStage::Signed) && pin_retained {
+                native.mode(1);
+                assert!(cold.recover_reviewed_light_bch_success_release(&native,observer,5,2022,&release.commitment).await.is_err());
+                native.mode(0);
+                let fresh=cold.recover_reviewed_light_bch_success_release(&native,observer,5,2022,&release.commitment).await?;
+                assert_eq!(fresh.frame(),original.frame());assert_eq!(fresh.signature(),original.signature());
+            }
+        }
+        // A published private record without its pin is rollback/loss, not a
+        // state produced by this publication order. Do not silently reanchor it.
+        let public=copy_store(metadata)?;let private=copy_store(snapshots)?;
+        std::fs::remove_file(public.0.join(format!("{slot}-pin")))?;
+        let rollback=AdmittedExecution::resume(&public.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let before_public=hashes(&public.0)?;let before_private=hashes(&private.0)?;
+        assert!(rollback.review_light_bch_success_publication_repair(observer,stage,2020).err()
+            .context("missing trusted pin must fail")?.to_string().contains("private record lacks trusted pin"));
+        assert_eq!(hashes(&public.0)?,before_public);assert_eq!(hashes(&private.0)?,before_private);
+    }
+    // Legacy complete records remain readable; a fresh checked release can
+    // add the candidate. Lost legacy bytes cannot be recreated from a hash.
+    let public=copy_store(metadata)?;let private=copy_store(snapshots)?;
+    for label in ["prepared","signed"] {std::fs::remove_file(private.0.join(format!("{}.bch-success-{label}-candidate",setup.quote.terms()["swapId"])))?;}
+    let mut legacy=AdmittedExecution::resume(&public.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    assert!(legacy.saved_light_bch_success_preparation(observer,5,2020)?.signature_retained);
+    assert!(legacy.review_light_bch_success_publication_repair(observer,SuccessRecordStage::Signed,2020).is_err());
+    let signed_path=private.0.join(format!("{}.bch-success-signed",setup.quote.terms()["swapId"]));
+    let signed_bytes=Zeroizing::new(std::fs::read(&signed_path)?);std::fs::remove_file(&signed_path)?;
+    let before_public=hashes(&public.0)?;let before_private=hashes(&private.0)?;
+    assert!(legacy.review_light_bch_success_publication_repair(observer,SuccessRecordStage::Signed,2020).is_err());
+    assert!(legacy.saved_light_bch_success_preparation(observer,5,2020).is_err());
+    assert_eq!(hashes(&public.0)?,before_public);assert_eq!(hashes(&private.0)?,before_private);
+    {use std::{io::Write,os::unix::fs::OpenOptionsExt};std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&signed_path)?.write_all(&signed_bytes)?;}
+    let review=legacy.review_signed_light_bch_success_release(observer,5,2021)?;
+    let restored=legacy.recover_reviewed_light_bch_success_release(&native,observer,5,2021,&review.commitment).await?;
+    assert_eq!(restored.frame(),original.frame());
+    for label in ["prepared","signed"] {
+        let slot=format!("{}.bch-success-{label}",setup.quote.terms()["swapId"]);
+        assert_eq!(*Zeroizing::new(std::fs::read(private.0.join(format!("{slot}-candidate")))?),*Zeroizing::new(std::fs::read(private.0.join(slot))?));
+    }
+    assert_eq!(hashes(metadata)?,original_public);assert_eq!(hashes(snapshots)?,original_private);
+    Ok(())
+}
