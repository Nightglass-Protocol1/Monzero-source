+//! Explicit offline repair of an exact durable success publication candidate.
+//! This neither releases its private frame nor grants current chain approval.
+use super::*;
+use crate::bch_rpc::observer::OwnedBchObserver;
+const REVIEW:&str="monzero-bch-success-publication-repair-v1";
+#[derive(Clone,Copy)]
+pub enum SuccessRecordStage {Prepared,Signed}
+impl SuccessRecordStage {fn name(self)->&'static str {match self {Self::Prepared=>"prepared",Self::Signed=>"signed"}}}
+pub struct SuccessRecordRepairReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+impl AdmittedExecution<'_> {
+    fn success_publication_materials(&self,bch:SuccessObserver<'_>,stage:SuccessRecordStage,now:u64)
+        ->Result<(SuccessRecordRepairReview,Release)> {
+        let context=self.success_context_for_observer(&bch,now)?;let slot=name(self.quote,stage.name());
+        let journal=Journal::open(&self.snapshots)?;
+        let bytes=Zeroizing::new(journal.read(&format!("{slot}-candidate"))?);
+        let release=self.validate_success_record(stage.name(),&context,&bytes)
+            .map_err(|_|anyhow::anyhow!("BCH success repair candidate validation failed"))?;
+        ensure!(now>=release.at,"BCH success repair predates candidate");
+        let pin=serde_json::to_vec(&Pin {schema:PIN.into(),admission:context.admission,record:hash(RECORD,&bytes)})?;
+        let saved_pin=optional(&self.metadata,&format!("{slot}-pin"))?;
+        let saved_private=optional(&journal,&slot)?.map(Zeroizing::new);
+        ensure!(saved_pin.is_some() || saved_private.is_none(),"BCH success private record lacks trusted pin");
+        if let Some(saved)=saved_pin {ensure!(saved==pin,"BCH success repair pin conflict");}
+        if let Some(saved)=saved_private {ensure!(*saved==*bytes,"BCH success repair private record conflict");}
+        // The private journal has a non-reentrant lease. Release it before
+        // validating the separately published preparation through load_success.
+        drop(journal);
+        if matches!(stage,SuccessRecordStage::Signed) {
+            let prepared=self.load_success("prepared",&context)?.context("repair BCH success preparation first")?;
+            ensure!(prepared.frame==release.frame && release.at>=prepared.at,"BCH signed repair differs from preparation");
+        } else {
+            // Check every available signed copy without requiring its publication
+            // to be complete; prepared repair must precede signed repair.
+            let expected=context.agreement.success_frame(self.quote,context.funding.lock_outpoint(),&context.request.proof.tx_hash.0)?;
+            ensure!(release.frame==*expected,"BCH success repair frame differs from agreed deterministic frame");
+            let journal=Journal::open(&self.snapshots)?;
+            let signed_slot=name(self.quote,"signed");
+            for signed_name in [&signed_slot,&format!("{signed_slot}-candidate")] {
+                if let Some(bytes)=optional(&journal,signed_name)?.map(Zeroizing::new) {
+                    let signed=self.validate_success_record("signed",&context,&bytes)
+                        .map_err(|_|anyhow::anyhow!("BCH signed repair context validation failed"))?;
+                    ensure!(signed.frame==release.frame && signed.at>=release.at,"BCH prepared repair differs from signed record");
+                }
+            }
+        }
+        let details=serde_json::json!({"schema":REVIEW,"action":"repair-private-success-publication",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),"admission":context.admission,
+            "nativeReceipt":context.receipt,"stage":stage.name(),"candidate":hash(RECORD,&bytes),"recordedAt":release.at,
+            "bchDeployment":bch.deployment()?,"fundingSource":match bch {SuccessObserver::Node(_)=>"node-wallet",SuccessObserver::Local(_)=>"local-wallet"},
+            "releasesPrivateMaterial":false,"chainApproval":false});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((SuccessRecordRepairReview {details,commitment},release))
+    }
+    pub fn review_bch_success_publication_repair(&self,bch:&BchRpc,stage:SuccessRecordStage,now:u64)->Result<SuccessRecordRepairReview> {
+        Ok(self.success_publication_materials(SuccessObserver::Node(bch),stage,now)?.0)
+    }
+    pub fn review_light_bch_success_publication_repair(&self,bch:&OwnedBchObserver,stage:SuccessRecordStage,now:u64)->Result<SuccessRecordRepairReview> {
+        Ok(self.success_publication_materials(SuccessObserver::Local(bch),stage,now)?.0)
+    }
+    pub fn repair_reviewed_bch_success_publication(&self,bch:&BchRpc,stage:SuccessRecordStage,now:u64,approved:&[u8;32])->Result<()> {
+        self.repair_success_publication(SuccessObserver::Node(bch),stage,now,approved)
+    }
+    pub fn repair_reviewed_light_bch_success_publication(&self,bch:&OwnedBchObserver,stage:SuccessRecordStage,now:u64,approved:&[u8;32])->Result<()> {
+        self.repair_success_publication(SuccessObserver::Local(bch),stage,now,approved)
+    }
+    fn repair_success_publication(&self,bch:SuccessObserver<'_>,stage:SuccessRecordStage,now:u64,approved:&[u8;32])->Result<()> {
+        let (review,release)=self.success_publication_materials(bch,stage,now)?;
+        ensure!(review.commitment==*approved,"BCH success publication repair approval changed");
+        self.retain_success(stage.name(),&release)
+    }
+}
