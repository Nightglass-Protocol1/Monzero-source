+            ("v2",Some(serde_json::json!("node-wallet")),false),("v3",Some(serde_json::json!("owned-node")),false)] {
+            let mut value=base.clone();value["schema"]=serde_json::json!(format!("monzero-private-bch-cancel-{version}"));
