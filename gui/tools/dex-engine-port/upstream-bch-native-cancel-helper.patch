+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+pub(super) struct CancelConfig {
+    schema:String,pub(super) admission_config_file:PathBuf,pub(super) deployment_commitment:String,
+    #[serde(default,deserialize_with="required_kind")]
+    pub(super) bch_observer_kind:Option<Kind>,
+}
+pub(super) fn cancel_config(bytes:&[u8])->Result<CancelConfig> {
+    let config:CancelConfig=serde_json::from_slice(bytes)?;
+    let valid=match config.schema.as_str() {
+        "monzero-private-bch-cancel-v1"=>config.bch_observer_kind.is_none(),
+        "monzero-private-bch-cancel-v2"=>config.bch_observer_kind==Some(Kind::OwnedNode),
+        _=>false,
+    };
+    ensure!(valid && config.admission_config_file.is_absolute(),"invalid cancellation configuration");
+    parse_digest(&config.deployment_commitment)?;Ok(config)
+}
+impl Backend {
+    pub(super) async fn observe_cancellation(&self,execution:&AdmittedExecution<'_>,now:u64)
+        ->Result<swap_machine::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding::recovery::cancel::observation::ConfirmedCancellation> {
+        match self {
+            Self::Node(bch)=>execution.observe_bch_cancel(bch,None).await,
+            Self::Owned(bch)=>execution.observe_light_bch_cancel(bch,None,now).await,
+        }
+    }
+    pub(super) async fn relay_cancellation(&self,execution:&mut AdmittedExecution<'_>,approved:&[u8;32],now:u64)
+        ->Result<bitcoin::Txid> {
+        match self {
+            Self::Node(bch)=>execution.relay_bch_cancel(bch,approved,now).await,
+            Self::Owned(bch)=>{
+                let relay=swap_machine::bch_rpc::contract_relay::OwnedBchContractRelay::new(bch);
+                execution.relay_light_bch_cancel(&relay,approved,now).await
+            },
+        }
+    }
+}
