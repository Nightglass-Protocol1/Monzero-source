+
+/// Public review modes use private retained state but never export its frames.
+pub(super) fn reviews(setup: &Setup,original: &PrivateStore,snapshots: &PrivateStore,
+    pins: &NegotiationPins,base: u64,deployment: &[u8;32],signing: Option<&Value>,release: Option<&Value>) -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==digest,"review helper changed");
+    let metadata=PrivateStore::new()?;let private=PrivateStore::new()?;let config=PrivateStore::new()?;
+    for (name,bytes) in contents(&original.0)? {save(&metadata.0.join(name),&bytes)?;}
+    for (name,bytes) in contents(&snapshots.0)? {save(&private.0.join(name),&bytes)?;}
+    let quote=config.0.join("quote.json");save(&quote,&setup.quote.record()?)?;
+    let admission=config.0.join("admission.json");
+    save(&admission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":digest,"quoteFile":quote,
+        "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"bch-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":private.0,"negotiationPins":pins}))?)?;
+    let wrapper=config.0.join("review.json");
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-success-release-review-v1",
+        "admissionConfigFile":admission,"deploymentCommitment":hex(deployment),"safetyBlocks":5}))?)?;
+    let before=contents(&metadata.0)?;let secrets=contents(&private.0)?;
+    for (action,expected) in [("signature",signing),("signed-release",release)] {
+        let id=uuid::Uuid::new_v4();
+        let request=json!({"schema":format!("monzero-bch-success-{action}-review-request-v1"),"requestId":id});
+        let mut child=Command::new(&helper).arg(format!("--success-{action}-review-stdio-v1")).arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("signing review stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),expected.is_some(),"signing review outcome");
+        if let Some(expected)=expected {
+            assert!(output.stderr.is_empty() && output.stdout.len()<=16384);
+            let value: Value=serde_json::from_slice(&output.stdout)?;
+            assert_eq!(value.as_object().unwrap().len(),6);
+            assert_eq!(value["schema"],format!("monzero-bch-success-{action}-review-response-v1"));
+            assert_eq!(value["requestId"],id.to_string());assert_eq!(value["tradeId"],setup.quote.terms()["swapId"]);
+            assert_eq!(value["executable"],false);assert_eq!(value["chainObserved"],false);
+            assert_eq!(&value["review"],expected);
+        } else {assert!(output.stdout.is_empty());}
+        assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&private.0)?,secrets);
+    }
+    Ok(())
+}
