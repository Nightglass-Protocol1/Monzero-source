+//! One explicit dispatch of the exact saved native payout. Lost acknowledgements
+//! remain unresolved intents; no restart or fresh client authorizes retransmission.
+use super::*;
+
+const ATTEMPT: &str="monzero-bch-native-refund-payout-relay-intent-v1";
+const ACK: &str="monzero-bch-native-refund-payout-relay-ack-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt {schema: String,review: [u8;32],approved_at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack {schema: String,attempt: [u8;32],txid: String}
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub enum NativeRefundPayoutRelayState {
+    /// Includes interruption before dispatch; not permission to send again.
+    Attempted {txid: String},
+    /// Exact node acknowledgement, not current confirmation.
+    Acknowledged {txid: String},
+}
+fn relay_slot(quote: &VerifiedBchQuote,part: &str) -> String {
+    format!("{}.bch-native-refund-payout-relay-{part}",quote.terms()["swapId"])
+}
+impl AdmittedExecution<'_> {
+    fn native_refund_payout_attempt(&self,review: &NativeRefundPayoutRelayReview,intent: &Intent) -> Result<Option<(Attempt,[u8;32])>> {
+        let Some(bytes)=optional(&self.metadata,&relay_slot(self.quote,"intent"))? else {return Ok(None)};
+        ensure!(bytes.len()<=4096,"oversized BCH native payout relay intent");
+        let attempt: Attempt=serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema==ATTEMPT && attempt.review==review.commitment && attempt.approved_at>=intent.at
+            && serde_json::to_vec(&attempt)?==bytes,"BCH native payout relay intent changed");
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+    fn native_refund_payout_state(&self,review: &NativeRefundPayoutRelayReview,intent: &Intent) -> Result<Option<NativeRefundPayoutRelayState>> {
+        let ack=optional(&self.metadata,&relay_slot(self.quote,"ack"))?;
+        let Some((_,attempt))=self.native_refund_payout_attempt(review,intent)? else {
+            ensure!(ack.is_none(),"BCH native payout acknowledgement lacks relay intent");return Ok(None)
+        };
+        let txid=review.details["payout"]["txid"].as_str().context("missing saved payout transaction identity")?.to_owned();
+        let Some(bytes)=ack else {return Ok(Some(NativeRefundPayoutRelayState::Attempted {txid}))};
+        ensure!(bytes.len()<=4096,"oversized BCH native payout acknowledgement");
+        let ack: Ack=serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema==ACK && ack.attempt==attempt && ack.txid==txid
+            && serde_json::to_vec(&ack)?==bytes,"BCH native payout acknowledgement changed");
+        Ok(Some(NativeRefundPayoutRelayState::Acknowledged {txid}))
+    }
+    pub fn bch_native_refund_payout_relay_state(&self) -> Result<Option<NativeRefundPayoutRelayState>> {
+        let (review,_,intent,_)=self.native_refund_payout_relay_materials()?;
+        self.native_refund_payout_state(&review,&intent)
+    }
+    /// Consumes the dedicated session so spend-key verification and relay use
+    /// the same owned client. Caller approval applies only to retained bytes.
+    pub async fn relay_bch_native_refund_payout(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        block: Option<BlockHash>,approved: &[u8;32],now: u64,mut session: NativeWalletSession) -> Result<String> {
+        let (review,prepared,intent,deployment)=self.native_refund_payout_relay_materials()?;
+        ensure!(*approved==review.commitment,"BCH native payout approval is stale or mismatched");
+        ensure!(now>=intent.at && bch.deployment_commitment()?==deployment,"BCH native payout predates preparation or changes observer");
+        if let Some((attempt,_))=self.native_refund_payout_attempt(&review,&intent)? {
+            ensure!(now>=attempt.approved_at,"BCH native payout time moved backwards");
+        }
+        match self.native_refund_payout_state(&review,&intent)? {
+            Some(NativeRefundPayoutRelayState::Acknowledged {txid})=>return Ok(txid),
+            Some(NativeRefundPayoutRelayState::Attempted {..})=>anyhow::bail!("BCH native payout result is uncertain; reconcile without retransmitting"),
+            None=>(),
+        }
+        // All saved payout validation precedes fresh two-chain refund evidence.
+        let refund=self.recover_bch_native_refund(native,bch,intent.refund,block,now).await?;
+        ensure!(refund.payment==intent.payment && refund.native_txid==prepared.terms()["lockTxid"]
+            && refund.address.to_string()==prepared.terms()["wallet"],"BCH native payout refund changed");
+        let deadline=refund.observed_at.checked_add(std::time::Duration::from_secs(30)).context("native payout relay deadline overflow")?;
+        tokio::time::timeout_at(deadline.into(),refund.check_wallet(&mut session)).await
+            .context("BCH native payout wallet verification timed out")??;
+        let mut relay=session.into_payout_relay()?;
+        tokio::time::timeout_at(deadline.into(),relay.preflight_native_payout(&prepared)).await
+            .context("BCH native payout relay preflight timed out")??;
+        ensure!(std::time::Instant::now()<deadline,"BCH native payout evidence expired before dispatch intent");
+        let bytes=serde_json::to_vec(&Attempt {schema:ATTEMPT.into(),review:*approved,approved_at:now})?;
+        self.metadata.retain(&relay_slot(self.quote,"intent"),&bytes)?;
+        ensure!(std::time::Instant::now()<deadline,"BCH native payout evidence expired after dispatch intent; reconcile without retransmitting");
+        let result=tokio::time::timeout_at(deadline.into(),relay.dispatch_native_payout(&prepared)).await
+            .context("BCH native payout dispatch timed out; result is uncertain")??;
+        let ack=Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid:result.txid.clone()};
+        self.metadata.retain(&relay_slot(self.quote,"ack"),&serde_json::to_vec(&ack)?)?;
+        Ok(result.txid)
+    }
+}
+
+pub mod observation;
