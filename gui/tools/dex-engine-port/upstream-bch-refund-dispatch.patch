+use super::*;
+use crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding::recovery::native_refund::wallet::payout::preparation::approval::relay::NativeRefundPayoutRelayState;
+use std::sync::atomic::Ordering;
+use sha2::{Digest,Sha256};
+
+fn store_hashes(path: &std::path::Path) -> Result<std::collections::BTreeMap<std::ffi::OsString,[u8;32]>> {
+    let mut hashes=std::collections::BTreeMap::new();
+    for entry in std::fs::read_dir(path)? {
+        let entry=entry?;if entry.file_type()?.is_file() {
+            hashes.insert(entry.file_name(),Sha256::digest(std::fs::read(entry.path())?).into());
+        }
+    }
+    Ok(hashes)
+}
+
+pub(super) async fn exercise(metadata: &std::path::Path,setup: &Setup,snapshots: &PrivateStore,
+    observer_fixture: &Fixture,rpc: &BchRpc,wallet: &WalletFixture) -> Result<()> {
+    let observer=observer_fixture.funding_client()?;let block=Some(BlockHash::from_byte_array([6;32]));
+    for lost in [false,true] {
+        let copied=copy_store(metadata)?;let private=copy_store(&snapshots.0)?;
+        let slot=|part:&str|format!("{}.bch-native-refund-payout-relay-{part}",setup.quote.terms()["swapId"]);
+        let intent=copied.0.join(slot("intent"));let ack=copied.0.join(slot("ack"));
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let review=execution.review_bch_native_refund_payout_relay(rpc,2051)?;
+        assert!(execution.bch_native_refund_payout_relay_state()?.is_none());
+        assert!(execution.observe_bch_native_refund_payout(&observer,rpc,block,2051,wallet.payout_session(&observer)?).await.is_err());
+        let transfers=wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="transfer").count();
+        let relays=wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="relay_tx").count();
+        {
+            let mut state=wallet.state.lock().unwrap();state.relay_intent=Some(intent.clone());state.lose_relay=lost;
+        }
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_bch_native_refund_payout(&observer,rpc,block,&bad,2052,wallet.payout_session(&observer)?).await.is_err());
+        assert!(!intent.exists());
+        if !lost {
+            observer_fixture.confirmed.store(false,Ordering::SeqCst);
+            let rejected=execution.relay_bch_native_refund_payout(&observer,rpc,block,&review.commitment,2052,wallet.payout_session(&observer)?).await;
+            observer_fixture.confirmed.store(true,Ordering::SeqCst);
+            assert!(rejected.is_err());assert!(!intent.exists());
+        }
+        let result=execution.relay_bch_native_refund_payout(&observer,rpc,block,&review.commitment,2052,wallet.payout_session(&observer)?).await;
+        assert!(intent.exists());
+        assert_eq!(wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="relay_tx").count(),relays+1);
+        let expected=if lost {
+            assert!(result.is_err());assert!(!ack.exists());NativeRefundPayoutRelayState::Attempted {txid:"dd".repeat(32)}
+        } else {
+            assert_eq!(result?,"dd".repeat(32));assert!(ack.exists());NativeRefundPayoutRelayState::Acknowledged {txid:"dd".repeat(32)}
+        };
+        assert_eq!(execution.bch_native_refund_payout_relay_state()?,Some(expected.clone()));
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let calls=wallet.state.lock().unwrap().calls.len();let observations=observer_fixture.calls.lock().unwrap().len();
+        assert_eq!(execution.bch_native_refund_payout_relay_state()?,Some(expected.clone()));
+        let retry=execution.relay_bch_native_refund_payout(&observer,rpc,block,&review.commitment,2053,wallet.payout_session(&observer)?).await;
+        if lost {assert!(retry.is_err());} else {assert_eq!(retry?,"dd".repeat(32));}
+        assert_eq!(wallet.state.lock().unwrap().calls.len(),calls,"relay replay sent another wallet request");
+        assert_eq!(observer_fixture.calls.lock().unwrap().len(),observations,"relay replay performed chain observations");
+        assert_eq!(wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="transfer").count(),transfers);
+        let public_before=store_hashes(&copied.0)?;let private_before=store_hashes(&private.0)?;
+        if !lost {
+            wallet.state.lock().unwrap().payout_confirmations=1;
+            assert!(execution.observe_bch_native_refund_payout(&observer,rpc,block,2054,wallet.payout_session(&observer)?).await.is_err());
+        }
+        wallet.state.lock().unwrap().payout_confirmations=10;
+        let evidence=execution.observe_bch_native_refund_payout(&observer,rpc,block,2054,wallet.payout_session(&observer)?).await?;
+        assert_eq!(evidence.txid(),"dd".repeat(32));assert_eq!(evidence.confirmations(),10);
+        assert_eq!(evidence.quote(),setup.quote.commitment());assert_eq!(evidence.review(),&review.commitment);
+        assert_eq!(evidence.native_snapshot().genesis,setup.policy.xmz_genesis);
+        assert_eq!(evidence.bch_confirmation().block(),BlockHash::from_byte_array([6;32]));
+        assert_eq!(execution.bch_native_refund_payout_relay_state()?,Some(expected));
+        assert_eq!(store_hashes(&copied.0)?,public_before);assert_eq!(store_hashes(&private.0)?,private_before);
+        let methods=wallet.state.lock().unwrap().calls[calls..].to_vec();
+        assert!(methods.iter().all(|s|matches!(s.as_str(),"get_address"|"query_key"|"check_tx_key")),"confirmation mutated the wallet");
+        if !lost {
+            let saved=std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;
+            assert!(execution.bch_native_refund_payout_relay_state().is_err());std::fs::write(&ack,saved)?;
+            let held=copied.0.join("held-payout-relay-intent");std::fs::rename(&intent,&held)?;
+            assert!(execution.bch_native_refund_payout_relay_state().is_err());std::fs::rename(&held,&intent)?;
+        }
+    }
+    Ok(())
+}
