+//! Immutable exact native payout preparation. An unresolved intent never grants
+//! permission to construct another transaction. Private checkpoints never relay.
+use super::*;
+use crate::native_funding_rpc::full_proceeds::lock_payout::PreparedLockPayout;
+use serde_json::Value;
+use sha2::{Digest,Sha256};
+
+const INTENT: &str="monzero-bch-native-payout-intent-v1";
+const PIN: &str="monzero-bch-native-payout-pin-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema: String,quote: [u8;32],admission: [u8;32],native_receipt: [u8;32],wallet_intent: [u8;32],
+    redemption: Txid,at: u64,priority: u32,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin {schema: String,intent: [u8;32],prepared: [u8;32]}
+fn slot(quote: &VerifiedBchQuote,part: &str) -> String {format!("{}.bch-native-payout-{part}",quote.terms()["swapId"])}
+impl AdmittedExecution<'_> {
+    fn payout_intent(&self) -> Result<Option<(Intent,Vec<u8>)>> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH native payout role");
+        let Some(bytes)=optional(&self.metadata,&slot(self.quote,"intent"))? else {
+            ensure!(optional(&self.metadata,&slot(self.quote,"pin"))?.is_none()
+                && optional(&Journal::open(&self.snapshots)?,&slot(self.quote,"prepared"))?.is_none(),
+                "BCH native payout artifact lacks original intent");return Ok(None)
+        };
+        ensure!(bytes.len()<=4096,"oversized BCH native payout intent");
+        let intent: Intent=serde_json::from_slice(&bytes)?;
+        ensure!(intent.schema==INTENT && intent.quote==*self.quote.commitment()
+            && intent.admission==self.admission_digest()? && (1..=4).contains(&intent.priority)
+            && serde_json::to_vec(&intent)?==bytes,"BCH native payout intent changed");
+        Ok(Some((intent,bytes)))
+    }
+    fn payout_request(&self,intent: &Intent) -> Result<BoundPayout> {
+        let (payment,receipt,received_at)=self.native_payment_release_binding()?;
+        ensure!(receipt==intent.native_receipt && intent.at>=received_at,"BCH payout differs from original native receipt");
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.claim_wallet_binding_values(&payment.address,&payment.proof.tx_hash.0,intent.redemption,&id)?;
+        ensure!(self.required_claim_wallet_intent(&binding,intent.at)?==intent.wallet_intent,"BCH payout wallet intent changed");
+        BoundPayout::from_parts(self.quote,&payment.address,&payment.proof.tx_hash.0,intent.priority)
+    }
+    pub(super) fn load_bch_native_payout(&self) -> Result<PreparedLockPayout> {
+        let (intent,bytes)=self.payout_intent()?.context("missing BCH native payout intent")?;
+        let bound=self.payout_request(&intent)?;let binding=hash(INTENT,&bytes);
+        let private=optional(&Journal::open(&self.snapshots)?,&slot(self.quote,"prepared"))?.map(Zeroizing::new);
+        let pin=optional(&self.metadata,&slot(self.quote,"pin"))?.context("BCH payout construction unresolved; do not reconstruct")?;
+        ensure!(pin.len()<=4096,"oversized BCH payout pin");let decoded: Pin=serde_json::from_slice(&pin)?;
+        ensure!(decoded.schema==PIN && decoded.intent==binding && serde_json::to_vec(&decoded)?==pin,"BCH native payout pin changed");
+        let private=private.context("private BCH payout checkpoint missing")?;
+        PreparedLockPayout::decode(&private,binding,decoded.prepared,&bound.request,&bound.genesis)
+    }
+    /// Public accounting only. Offline restoration is never confirmation or approval.
+    pub fn recover_prepared_bch_native_payout(&self) -> Result<Value> {
+        Ok(self.load_bch_native_payout()?.terms().clone())
+    }
+    /// Construct at most once. No new funding/quote expiry extension or relay.
+    pub async fn prepare_bch_native_payout(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        redemption: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession,priority: u32) -> Result<Value> {
+        ensure!((1..=4).contains(&priority),"invalid BCH native payout priority");
+        if let Some((intent,_))=self.payout_intent()? {
+            ensure!(intent.priority==priority && intent.redemption==redemption && now>=intent.at,"BCH payout already prepared with different context");
+            return self.recover_prepared_bch_native_payout()
+        }
+        let claim=self.recover_bch_native_claim(native,bch,redemption,block,now).await?;
+        let bound=BoundPayout::from_quote(self.quote,&claim,priority)?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let wallet_binding=self.claim_wallet_binding(&claim,&id)?;
+        let wallet_intent=self.required_claim_wallet_intent(&wallet_binding,now)?;
+        let deadline=claim.observed_at.checked_add(std::time::Duration::from_secs(30)).context("native payout deadline overflow")?;
+        claim.check_wallet(session).await?;
+        ensure!(std::time::Instant::now()<deadline,"native payout evidence expired before intent");
+        let intent=Intent {schema:INTENT.into(),quote:claim.quote,admission:claim.admission,
+            native_receipt:claim.native_receipt,wallet_intent,redemption,at:now,priority};
+        let bytes=serde_json::to_vec(&intent)?;let binding=hash(INTENT,&bytes);
+        self.metadata.retain(&slot(self.quote,"intent"),&bytes)?;
+        let prepared=session.prepare_lock_payout(&bound.request,&bound.genesis,deadline).await?;
+        let private=prepared.encode(binding)?;let digest=Sha256::digest(&*private).into();
+        PreparedLockPayout::decode(&private,binding,digest,&bound.request,&bound.genesis)?;
+        let pin=Pin {schema:PIN.into(),intent:binding,prepared:digest};
+        self.metadata.retain(&slot(self.quote,"pin"),&serde_json::to_vec(&pin)?)?;
+        Journal::open(&self.snapshots)?.retain(&slot(self.quote,"prepared"),&private)?;
+        Ok(prepared.terms().clone())
+    }
+}
