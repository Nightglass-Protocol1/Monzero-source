+//! Exercise session safety without a running blockchain or wallet service.
+use super::*;
+use crate::native_funding_rpc::full_proceeds::{ExactNetRequest,FullProceedsRequest};
+use swap_core::xmz::XmzAmount;
+use std::time::{Duration,Instant};
+
+fn request() -> Result<ExactNetRequest> {
+    let addresses=include_str!("../../../../swap-core/src/xmz_address_vectors.txt").lines().take(3)
+        .map(|s|XmzAddress::parse(XmzNetwork::Mainnet,s)).collect::<Result<Vec<_>>>()?;
+    Ok(ExactNetRequest {source:FullProceedsRequest {wallet:addresses[0].clone(),destination:addresses[1].clone(),
+        lock_txid:"ab".repeat(32),locked:XmzAmount::from_atoms(110),maximum_fee:XmzAmount::from_atoms(3),account:0,priority:1},
+        principal:XmzAmount::from_atoms(100),reserve_return:addresses[2].clone()})
+}
+
+#[tokio::test]
+async fn bch_native_payout_session_rejects_expired_or_wrong_network_before_dispatch() -> Result<()> {
+    let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let port=listener.local_addr()?.port();
+    let mut session=NativeWalletSession::new(NativeFundingRpc::new(port,port,"fixture".into(),"fixture".into())?,XmzNetwork::Mainnet);
+    let request=request()?;let genesis="aa".repeat(32);
+    let result=session.prepare_lock_payout(&request,&genesis,Instant::now()).await;
+    assert_eq!(result.err().context("accepted expired evidence")?.to_string(),"native payout evidence expired before construction");
+    assert!(!session.uncertain);
+    session.network=XmzNetwork::Testnet;
+    let result=session.prepare_lock_payout(&request,&genesis,Instant::now()+Duration::from_secs(30)).await;
+    assert_eq!(result.err().context("accepted wrong network")?.to_string(),"payout wallet network mismatch");
+    assert!(!session.uncertain);
+    assert!(tokio::time::timeout(Duration::from_millis(20),listener.accept()).await.is_err());
+    Ok(())
+}
+
+#[tokio::test]
+async fn bch_native_payout_session_cancellation_and_timeout_require_reconciliation() -> Result<()> {
+    for cancel in [false,true] {
+        let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let port=listener.local_addr()?.port();
+        let mut session=NativeWalletSession::new(NativeFundingRpc::new(port,port,"fixture".into(),"fixture".into())?,XmzNetwork::Mainnet);
+        let request=request()?;let genesis="aa".repeat(32);
+        let deadline=Instant::now()+Duration::from_secs(if cancel {30} else {1});
+        {
+            let pending=session.prepare_lock_payout(&request,&genesis,deadline);
+            tokio::pin!(pending);
+            // Confirm real dispatch before cancellation; keep the accepted socket
+            // open without a reply to exercise the controller's own deadline.
+            let (_socket,_)=tokio::select! {
+                connection=listener.accept()=>connection?,
+                _=&mut pending=>anyhow::bail!("preparation ended before dispatch"),
+                _=tokio::time::sleep(Duration::from_secs(5))=>anyhow::bail!("no payout observation request"),
+            };
+            if !cancel {
+                let error=pending.await.err().context("unanswered construction succeeded")?;
+                assert_eq!(error.to_string(),"native payout construction deadline exceeded; result is uncertain");
+            }
+        }
+        assert!(session.uncertain);
+        let retry=session.prepare_lock_payout(&request,&genesis,Instant::now()+Duration::from_secs(30)).await;
+        assert_eq!(retry.err().context("uncertain session retried")?.to_string(),"wallet session requires reconciliation");
+        assert!(tokio::time::timeout(Duration::from_millis(20),listener.accept()).await.is_err());
+    }
+    Ok(())
+}
