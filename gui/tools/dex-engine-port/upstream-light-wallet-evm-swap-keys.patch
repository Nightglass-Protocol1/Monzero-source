diff --git a/swap-machine/src/litecoin_light/vault/evm.rs b/swap-machine/src/litecoin_light/vault/evm.rs
new file mode 100644
index 0000000..3c3ab25
--- /dev/null
+++ b/swap-machine/src/litecoin_light/vault/evm.rs
@@ -0,0 +1,50 @@
+//! Keys for XMZ <-> EVM swaps from an unlocked vault seed. Only the swap seed and one EVM
+//! account key leave the vault; the wallet seed (and its recovery words) never do.
+use anyhow::{Context, Result};
+use zeroize::Zeroizing;
+
+pub struct EvmSwapKeys {
+    pub swap_seed: Zeroizing<[u8; 32]>,
+    pub evm_key: Zeroizing<[u8; 32]>,
+    pub address: [u8; 20],
+}
+
+/// `wallet_seed`: the raw vault seed (32 bytes) or the BIP-39 seed of a mnemonic vault (64).
+pub fn from_wallet_seed(wallet_seed: &[u8], account: u32) -> Result<EvmSwapKeys> {
+    let evm_key = monzero_evm_keys::evm_private_key(wallet_seed, account).map_err(|e| anyhow::anyhow!("{e}"))?;
+    let address = monzero_evm_keys::evm_address(&evm_key).context("invalid derived EVM key")?;
+    Ok(EvmSwapKeys { swap_seed: monzero_evm_keys::swap_seed(wallet_seed), evm_key, address })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::litecoin_light::vault::mnemonic::MnemonicMaterial;
+
+    fn hexs(bytes: &[u8]) -> String {
+        bytes.iter().map(|b| format!("{b:02x}")).collect()
+    }
+
+    #[test]
+    fn mnemonic_vault_seed_gives_the_accounts_other_evm_wallets_show() -> Result<()> {
+        let material = MnemonicMaterial::parse("test test test test test test test test test test test junk")?;
+        let seed = material.derive_seed("")?;
+        let keys = from_wallet_seed(&*seed, 0)?;
+        assert_eq!(hexs(&keys.address), "f39fd6e51aad88f6f4ce6ab8827279cfffb92266");
+        assert_eq!(hexs(&*keys.evm_key), "ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80");
+        assert_eq!(*keys.swap_seed, *monzero_evm_keys::swap_seed(&*seed));
+        assert_eq!(hexs(&from_wallet_seed(&*seed, 1)?.address), "70997970c51812dc3a010c7d01b50e0d17dc79c8");
+        // The same key derivation as the swap engine (pinned there and in monzero-evm-keys)
+        assert_eq!(hexs(&*monzero_evm_keys::swap_seed(&[9; 32])), "624ec00514813457261791e59284ba6699586bb286481e47f6840cb138a6eaaf");
+        Ok(())
+    }
+
+    #[test]
+    fn raw_vault_seeds_work_and_bad_indexes_are_refused() -> Result<()> {
+        let keys = from_wallet_seed(&[7u8; 32], 3)?;
+        assert_ne!(*keys.swap_seed, [0; 32]);
+        assert!(from_wallet_seed(&[7u8; 32], 1 << 31).is_err());
+        assert!(from_wallet_seed(&[7u8; 8], 0).is_err());
+        Ok(())
+    }
+}
