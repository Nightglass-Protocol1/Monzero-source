diff --git a/swap-machine/src/bin/native-ltc-light/evm_keys.rs b/swap-machine/src/bin/native-ltc-light/evm_keys.rs
new file mode 100644
index 0000000..dae655c
--- /dev/null
+++ b/swap-machine/src/bin/native-ltc-light/evm_keys.rs
@@ -0,0 +1,78 @@
+// Private output: the keys an XMZ <-> EVM swap needs, derived here from the unlocked vault.
+// Only the swap seed and one EVM account key leave the helper, never the wallet seed or its
+// recovery words. The desktop hands them straight to the EVM swap helper; never to QML,
+// public status or logs.
+use super::*;
+use serde::Serialize;
+use swap_machine::litecoin_light::vault::{evm, recovery as material};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct KeysRequest {
+    schema:String,
+    request_id:uuid::Uuid,
+    approved_config_digest:String,
+    keys_approved:bool,
+    password:Password,
+    evm_account:u32,
+}
+struct KeyHex<'a>(&'a [u8]);
+impl std::fmt::Display for KeyHex<'_> {
+    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result {
+        for byte in self.0 {write!(f,"{byte:02x}")?;} Ok(())
+    }
+}
+impl Serialize for KeyHex<'_> {
+    fn serialize<S:serde::Serializer>(&self,serializer:S)->std::result::Result<S::Ok,S::Error> {serializer.collect_str(self)}
+}
+#[derive(Serialize)]
+#[serde(rename_all="camelCase")]
+struct KeysResponse<'a> {
+    schema:String,request_id:uuid::Uuid,coin:&'a str,network:&'a str,wallet_id:uuid::Uuid,
+    evm_account:u32,evm_address:String,swap_seed_hex:KeyHex<'a>,evm_key_hex:KeyHex<'a>,
+}
+
+pub(super) fn run(path:&Path)->Result<()> {
+    let mut input=Zeroizing::new(Vec::with_capacity(8193));
+    std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid swap-keys request size");
+    let request:KeysRequest=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-wallet-evm-swap-keys-request-v1"))
+        .context("invalid swap-keys schema")?;
+    ensure!(!request.request_id.is_nil() && request.keys_approved,"missing swap-keys approval");
+    ensure!(request.evm_account<(1<<31),"invalid EVM account index");
+    let (_lease,raw)=private_config(path)?;
+    let approved:sha256::Hash=request.approved_config_digest.parse()?;
+    ensure!(approved.to_string()==request.approved_config_digest && sha256::Hash::hash(&raw)==approved,
+        "swap-keys configuration differs from approval");
+    let config:Config=serde_json::from_slice(&raw)?;
+    ensure!(config.schema==format!("monzero-private-{tag}-light-v1"),"wrong swap-keys chain");
+    let network=network_for(tag,&config.network)?;
+    let wallet=config.wallet.as_ref().context("missing wallet")?;
+    let vault_config=wallet.vault.as_ref().context("missing vault")?;
+    let password=request.password.0.as_bytes();
+    // The wallet seed lives only inside this function
+    let keys=match vault_config.seed_encoding {
+        vault_format::VaultFormat::Mnemonic=>{
+            let vault=swap_machine::litecoin_light::vault::mnemonic::storage::MnemonicVault::open(&vault_config.directory,network,vault_config.wallet_id)?;
+            let unlocked=vault.unlock_for_account(password,&wallet.account)?;
+            let seed=unlocked.material().derive_seed(unlocked.passphrase())?;
+            evm::from_wallet_seed(&*seed,request.evm_account)?
+        }
+        vault_format::VaultFormat::Raw=>{
+            let vault=SeedVault::open(&vault_config.directory,network,vault_config.wallet_id)?;
+            let seed=material::reveal(&vault,password,&wallet.account)?;
+            evm::from_wallet_seed(seed.expose_bytes(),request.evm_account)?
+        }
+    };
+    let response=KeysResponse {schema:format!("monzero-{tag}-light-wallet-evm-swap-keys-response-v1"),
+        request_id:request.request_id,coin:tag,network:&config.network,wallet_id:vault_config.wallet_id,
+        evm_account:request.evm_account,evm_address:format!("0x{}",KeyHex(&keys.address)),
+        swap_seed_hex:KeyHex(&*keys.swap_seed),evm_key_hex:KeyHex(&*keys.evm_key)};
+    let mut output=Zeroizing::new(Vec::with_capacity(1024));
+    serde_json::to_writer(&mut *output,&response)?;
+    ensure!(output.len()<=1024,"oversized swap-keys response");
+    std::io::stdout().write_all(&output)?;
+    Ok(())
+}
