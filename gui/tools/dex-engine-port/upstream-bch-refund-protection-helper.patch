+//! Production helper receipt acceptance with no running wallet backend.
+use super::*;
+pub(super) fn exercise(helper: &std::path::Path,admission: &std::path::Path,
+    config: &PrivateStore,metadata: &PrivateStore,snapshots: &PrivateStore,
+    setup: &Setup,frame: &[u8],signature: &[u8],expected: &[u8;32]) -> Result<()> {
+    let wrapper=config.0.join("refund-protection.json");
+    let message=config.0.join("peer-refund.json");
+    let original=json!({"schema":"monzero-bch-peer-refund-protection-v1","frame":frame,"signature":signature});
+    save(&message,&serde_json::to_vec(&original)?)?;
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-refund-protection-v1",
+        "admissionConfigFile":admission,"peerMessageFile":message}))?)?;
+    let invoke=|action: &str,commitment: Option<&str>,success: bool| -> Result<Value> {
+        let id=uuid::Uuid::new_v4();
+        let mut request=json!({"schema":format!("monzero-bch-refund-protection-{action}-request-v1"),"requestId":id});
+        if let Some(commitment)=commitment {request["commitment"]=json!(commitment);}
+        let mut child=Command::new(helper).arg(format!("--refund-protection-{action}-stdio-v1")).arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("missing stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty());assert!(output.stdout.len()<=16384);
+        let response:Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(response.as_object().unwrap().len(),7);
+        assert_eq!(response["schema"],format!("monzero-bch-refund-protection-{action}-response-v1"));
+        assert_eq!(response["requestId"],id.to_string());assert_eq!(response["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(response["executable"],false);assert_eq!(response["chainObserved"],false);
+        Ok(response)
+    };
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    let status=invoke("status",None,true)?;assert!(status["review"].is_null());
+    let review=invoke("review",None,true)?;
+    assert_eq!(review["review"]["commitment"],hex(expected));
+    invoke("submit",Some(&"00".repeat(32)),false)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    let receipt_path=metadata.0.join(format!("{}.bch-refund-bch-funder-authenticated",setup.quote.terms()["swapId"]));
+    let receipt=std::fs::read(&receipt_path)?;
+    // Isolate first acceptance from the older receipt already referenced by
+    // the surrounding funding fixture. Restore its exact bytes afterwards.
+    std::fs::remove_file(&receipt_path)?;
+    assert!(invoke("status",None,true)?["receipt"].is_null());
+    let absent=contents(&metadata.0)?;
+    let mut corrupt=original.clone();corrupt["signature"][0]=json!(signature[0]^1);
+    save(&message,&serde_json::to_vec(&corrupt)?)?;
+    invoke("review",None,false)?;invoke("submit",Some(&hex(expected)),false)?;
+    assert_eq!(contents(&metadata.0)?,absent);
+    save(&message,&serde_json::to_vec(&original)?)?;
+    let accepted=invoke("submit",Some(&hex(expected)),true)?;
+    assert!(accepted["receipt"]["commitment"].as_str().is_some_and(|s|s.len()==64));
+    assert!(accepted["receipt"]["receivedAt"].as_str().context("missing receipt time")?.parse::<u64>()?>0);
+    let saved=contents(&metadata.0)?;
+    assert_eq!(invoke("submit",Some(&hex(expected)),true)?["receipt"],accepted["receipt"]);
+    assert_eq!(contents(&metadata.0)?,saved);assert_eq!(contents(&snapshots.0)?,secrets);
+    std::fs::remove_file(&message)?;
+    assert_eq!(invoke("status",None,true)?["receipt"],accepted["receipt"]);
+    invoke("review",None,false)?;
+    save(&receipt_path,&receipt)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    Ok(())
+}
