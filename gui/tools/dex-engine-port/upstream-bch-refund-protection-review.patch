+    /// Offline review of the authenticated peer's exact refund protection.
+    /// This approves receiving one adaptor only, never funding or refund release.
+    pub fn review_bch_refund_protection(&self,now: u64,frame: &[u8],signature: &[u8])
+        -> Result<RefundProtectionReview> {
+        ensure!(self.role==Role::BchFunder,"only BCH funder reviews received refund protection");
+        let (admission,agreed)=self.refund_context(now)?;
+        agreed.check_signed_refund(self.quote,frame,signature)?;
+        if let Some(bytes)=optional(&self.metadata,&name(self.quote,self.role,"authenticated"))? {
+            let (old,_)=self.refund_receipt(&bytes)?;
+            ensure!(now>=old.signed.admitted_at && old.signed.bytes==frame && old.signed.signature==signature,
+                "BCH refund protection already retained differently");
+        }
+        let parsed: serde_json::Value=serde_json::from_slice(frame)?;
+        let details=serde_json::json!({"schema":PROTECTION_REVIEW,"action":"accept-peer-refund-protection-only",
+            "swapId":self.quote.terms()["swapId"],"quote":hex(self.quote.commitment()),"admission":hex(&admission),
+            "agreement":parsed["agreement"],"peerIdentity":self.quote.terms()[Role::NativeFunder.identity()],
+            "frame":hex(&digest("monzero-bch-refund-frame-v1",frame)),
+            "signature":hex(&digest("monzero-bch-refund-identity-signature-v1",signature))});
+        Ok(RefundProtectionReview {commitment:digest(PROTECTION_REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+
+    /// Explicit acceptance of the displayed, separately authenticated message.
+    /// Wrong or expired approval is refused before any durable write.
+    pub fn accept_reviewed_bch_refund_protection(&mut self,now: u64,frame: &[u8],signature: &[u8],
+        approved: &[u8;32]) -> Result<()> {
+        let review=self.review_bch_refund_protection(now,frame,signature)?;
+        ensure!(&review.commitment==approved,"BCH refund protection approval changed");
+        self.accept_bch_refund_adaptor(now,frame,signature)?;
+        Ok(())
+    }
+
+    /// Historical receipt validation, including after quote expiry. This does
+    /// not assert that a private recovery bundle is retained or funding is safe.
+    pub fn saved_bch_refund_protection(&self) -> Result<Option<SavedRefundProtection>> {
+        Ok(self.received_bch_refund_record()?.map(|(_,receipt,received_at)|SavedRefundProtection {receipt,received_at}))
+    }
