+
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    /// Export only this prepared payment's verified input transactions. The
+    /// selected chain and scan are borrowed throughout. Raw txids must match the
+    /// inclusion evidence; this does not authenticate witness data or prove a
+    /// complete server history. No claims, signatures or broadcasts are written.
+    pub async fn funding_sources_on(&mut self,chain:&HeaderSequence,observation:&WalletObservation,
+        prepared:&ObservedClaimedSpend,minimum_confirmations:u64)->Result<Vec<Vec<u8>>> {
+        ensure!(self.network==chain.network() && observation.account.network()==chain.network()
+            && (1..=1000).contains(&minimum_confirmations)
+            && (1..=1000).contains(&prepared.transaction().input.len()),"invalid funding source context");
+        let candidates=observation.payment_inputs()?;
+        let by_outpoint=candidates.iter().map(|input|(bitcoin::OutPoint {txid:input.transaction.txid(),vout:input.vout},input))
+            .collect::<BTreeMap<_,_>>();
+        let inputs=prepared.transaction().input.iter().map(|input| {
+            let found=by_outpoint.get(&input.previous_output).context("funding source is absent or observed spent")?;
+            Ok(IncludedInput {transaction:found.transaction,vout:found.vout,branch:found.branch,index:found.index})
+        }).collect::<Result<Vec<_>>>()?;
+        prepared.check_funding_inputs_on(chain,observation.accounting(),&inputs,minimum_confirmations)?;
+        let txids=inputs.iter().map(|input|input.transaction.txid()).collect::<BTreeSet<_>>();
+        let result=async {
+            let mut sources=Vec::with_capacity(txids.len());let mut total=0usize;
+            for txid in txids {
+                let transaction=self.reported_transaction(txid).await?;
+                let raw=bitcoin::consensus::serialize(&transaction);
+                total=total.checked_add(raw.len()).context("funding source size overflow")?;
+                ensure!(total<=2_000_000,"funding source byte budget exceeded");
+                sources.push(raw);
+            }
+            prepared.check_funding_inputs_on(chain,observation.accounting(),&inputs,minimum_confirmations)?;
+            Ok(sources)
+        }.await;
+        if result.is_err() {self.usable=false;}
+        result
+    }
+}
