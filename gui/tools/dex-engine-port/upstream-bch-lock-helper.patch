@@ -0,0 +1,62 @@
+use super::*;
+
+pub(super) fn invoke(helper: &std::path::Path,path: &std::path::Path,action: &str,
+    approved: Option<&str>,success: bool) -> Result<Value> {
+    let id=uuid::Uuid::new_v4();
+    let mut request=json!({"schema":format!("monzero-bch-funding-{action}-request-v1"),"requestId":id});
+    if let Some(approved)=approved {request["commitment"]=json!(approved);}
+    let mut child=Command::new(helper).arg(format!("--funding-{action}-stdio-v1")).arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing lock stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+    if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+    assert!(output.stderr.is_empty());assert!(output.stdout.len()<=65536);
+    let response: Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response.as_object().unwrap().len(),if action=="lock-submit" {8} else {7});
+    assert_eq!(response["schema"],format!("monzero-bch-funding-{action}-response-v1"));
+    assert_eq!(response["requestId"],id.to_string());assert_eq!(response["executable"],false);
+    assert_eq!(response["chainObserved"],action=="lock-submit");
+    if action=="lock-submit" {
+        assert_eq!(response["observation"].as_object().unwrap().len(),4);
+        assert_eq!(response["observation"]["walletInputsLocked"],true);
+        assert_eq!(response["observation"]["tip"],"08".repeat(32));
+    }
+    Ok(response)
+}
+pub(super) fn exercise(helper: &std::path::Path,path: &std::path::Path,server: &Server,
+    metadata: &PrivateStore,snapshots: &PrivateStore,preparation: &Value,rpc_path: &std::path::Path,
+    descriptor: &Value) -> Result<Value> {
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    let status=invoke(helper,path,"lock-status",None,true)?;assert!(status["lockIntent"].is_null());
+    assert_eq!(&status["review"],preparation);
+    let review=invoke(helper,path,"lock-review",None,true)?;
+    assert_eq!(review["review"]["details"]["preparationReview"],preparation["details"]);
+    let approved=review["review"]["commitment"].as_str().context("missing lock review")?;
+    invoke(helper,path,"lock-submit",None,false)?;
+    invoke(helper,path,"lock-submit",preparation["commitment"].as_str(),false)?;
+    let mut wrong=descriptor.clone();wrong["wallet"]=json!("other");
+    save(rpc_path,&serde_json::to_vec(&wrong)?)?;invoke(helper,path,"lock-submit",Some(approved),false)?;
+    save(rpc_path,&serde_json::to_vec(descriptor)?)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    assert_eq!(server.state.lock().unwrap().calls,0);
+    server.state.lock().unwrap().ambiguous=true;
+    invoke(helper,path,"lock-submit",Some(approved),false)?;
+    assert_eq!(server.state.lock().unwrap().calls,1);
+    let recorded=invoke(helper,path,"lock-status",None,true)?;
+    assert_eq!(recorded["lockIntent"]["state"],"recorded");
+    let before=contents(&metadata.0)?;
+    // Explicit reconciliation observes existing locks; it does not issue another mutation.
+    let reconciled=invoke(helper,path,"lock-submit",Some(approved),true)?;
+    assert_eq!(reconciled["review"],review["review"]);
+    assert_eq!(reconciled["lockIntent"],recorded["lockIntent"]);
+    assert_eq!(server.state.lock().unwrap().calls,1);
+    server.state.lock().unwrap().locked=false;
+    assert_eq!(invoke(helper,path,"lock-status",None,true)?["lockIntent"],recorded["lockIntent"]);
+    assert!(!server.state.lock().unwrap().locked);
+    invoke(helper,path,"lock-submit",Some(approved),true)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    {let state=server.state.lock().unwrap();assert_eq!(state.calls,2);assert!(state.locked);
+        assert_eq!(state.preparation_calls,1);assert_eq!(state.sign_calls,0);assert_eq!(state.relay_calls,0);}
+    Ok(recorded["lockIntent"].clone())
+}
