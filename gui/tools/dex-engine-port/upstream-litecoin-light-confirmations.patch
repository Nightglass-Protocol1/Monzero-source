+#[test]
+fn selected_chain_confirmation_depth_tracks_extensions() -> Result<()> {
+    let (mut chain,request,raw,proof)=anchored_fixture();
+    let header=serialize(&chain.header(1).unwrap());
+    let matched=match_merkle_proof(&request,&header,&raw,&serde_json::to_vec(&proof)?)?;
+    assert_eq!(matched.confirmations_on(&chain),Some(1));
+    // Fixed descendant, independent Scrypt result:
+    // 70edba8ef7cab733d6d5978944d6994734cb253d2c7a667a5c2c8592ea30806b.
+    let descendant=decode_hex("00000020770d2e4fe1fc63105ef7fa9c49c16599f041afac4f8c8d91df0b56ed7691c10ca3c12fc762f95f226e93318d8d50326b90a0cc97ab8ab3fd9112d3803d3fa66406e7494dffff7f202a000000",80)?;
+    chain.append(&descendant,1296688902)?;
+    assert_eq!(matched.confirmations_on(&chain),Some(2));
+    assert_eq!(matched.confirmations_on(&chain.fork(1)?),Some(1));
+    assert_eq!(matched.confirmations_on(&chain.fork(0)?),None);
+    assert_eq!(matched.confirmations_on(&super::super::headers::HeaderSequence::new(LtcNetwork::Mainnet)?),None);
+    Ok(())
+}
