+#[tokio::test]
+async fn session_selected_chain_proof_loses_confirmations_after_reorg() -> Result<()> {
+    let (mut chain,request,raw,proof)=anchored_fixture();
+    let mut responses=regtest_handshake();
+    responses.push(reply(3,json!(hex(&raw))));
+    let mut wire=serde_json::to_vec(&proof)?;wire.push(b'\n');responses.push(wire);
+    let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let matched=session.inclusion_on(&chain,1,request.txid).await?;
+    assert_eq!(matched.txid(),request.txid);assert_eq!(matched.confirmations_on(&chain),Some(1));
+    let mut replacement=chain.fork(0)?;
+    assert_eq!(matched.confirmations_on(&replacement),None);
+    let mut alternative=super::super::headers::tests::child();alternative.nonce=0;
+    replacement.append(&serialize(&alternative),1296688902)?;
+    let descendant=decode_hex("000000209d08f789f2afaf053878d9b21add2f847fff4a9c32fb58b8c5c79ca166f94a9d111111111111111111111111111111111111111111111111111111111111111106e7494dffff7f2000000000",80)?;
+    replacement.append(&descendant,1296688902)?;
+    assert_eq!(chain.adopt(replacement)?.unwrap().common_ancestor,0);
+    assert_eq!(matched.confirmations_on(&chain),None);
+    drop(session);let requests=task.await?;
+    assert_eq!(requests.len(),4);assert_eq!(requests[2]["method"],"blockchain.transaction.get");
+    assert_eq!(requests[3]["method"],"blockchain.transaction.get_merkle");
