+//! Owned native wallet lifecycle for a freshly verified local-funded BCH claim.
+//! Restore/open/check do not construct or authorize any native payout.
+use super::*;
+use crate::bch_rpc::observer::OwnedBchObserver;
+impl AdmittedExecution<'_> {
+    pub async fn restore_light_bch_claim_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        redemption:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession,password:String)->Result<()> {
+        let password=Zeroizing::new(password);
+        let claim=self.recover_light_bch_native_claim(native,bch,redemption,block,now).await?;
+        self.restore_claim_wallet(&claim,now,session,password).await
+    }
+    pub async fn open_light_bch_claim_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        redemption:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession,password:String)->Result<()> {
+        let password=Zeroizing::new(password);
+        let claim=self.recover_light_bch_native_claim(native,bch,redemption,block,now).await?;
+        self.open_claim_wallet(&claim,now,session,password).await
+    }
+    pub async fn check_light_bch_claim_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        redemption:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession)->Result<()> {
+        let claim=self.recover_light_bch_native_claim(native,bch,redemption,block,now).await?;
+        self.check_claim_wallet(&claim,now,session).await
+    }
+}
