@@ -0,0 +1,53 @@
+use super::*;
+use crate::native_funding_rpc::wallet_session::{SwapWalletId,fixture::Fixture as WalletFixture};
+use agreement::execution::funding::success::native_claim::NativeClaim;
+
+pub(super) async fn exercise(metadata:&std::path::Path,snapshots:&std::path::Path,setup:&Setup,
+    bch:&super::super::super::light_observer::Fixture,txid:bitcoin::Txid,claim:&NativeClaim)->Result<()> {
+    let id=SwapWalletId::new(setup.quote.terms()["swapId"].parse()?)?;
+    let block=Some(BlockHash::from_byte_array([6;32]));
+    for lost in [false,true] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(metadata)? {
+            let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+        }
+        let mut execution=AdmittedExecution::resume(&copied.0,snapshots,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let native=Native::new(&execution,setup)?;
+        let intent=copied.0.join(format!("{}.bch-native-claim-wallet-intent",setup.quote.terms()["swapId"]));
+        let ready=copied.0.join(format!("{}.bch-native-claim-wallet-ready",setup.quote.terms()["swapId"]));
+        let wallet=WalletFixture::new(&id,claim.address(),claim.spend_key(),claim.view_key(),claim.native_txid()).await?;
+        {let mut state=wallet.state.lock().unwrap();state.intent=Some(intent.clone());state.lose_restore=lost;}
+        let mut session=wallet.session()?;
+        native.mode(1);
+        assert!(execution.restore_light_bch_claim_wallet(&native,&bch.observer,txid,block,2030,&mut session,"fixture".into()).await.err()
+            .context("unconfirmed native payment must block restoration")?.to_string().contains("native funding is not mined"));
+        assert!(!intent.exists());assert!(!ready.exists());assert!(wallet.state.lock().unwrap().calls.is_empty());
+        native.mode(0);
+        let result=execution.restore_light_bch_claim_wallet(&native,&bch.observer,txid,block,2030,&mut session,"fixture".into()).await;
+        assert!(intent.exists());
+        if lost {assert!(result.is_err());assert!(!ready.exists());}else{result?;assert!(ready.exists());}
+        let before=wallet.state.lock().unwrap().calls.len();let observations=native.snapshots.load(Ordering::SeqCst);
+        assert!(execution.restore_light_bch_claim_wallet(&native,&bch.observer,txid,block,2031,&mut wallet.session()?,"fixture".into()).await.err()
+            .context("duplicate wallet restoration must fail")?.to_string().contains("already attempted"));
+        assert_eq!(wallet.state.lock().unwrap().calls.len(),before);
+        assert!(native.snapshots.load(Ordering::SeqCst)>observations);
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&copied.0,snapshots,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let mut recovered=wallet.session()?;
+        execution.check_light_bch_claim_wallet(&native,&bch.observer,txid,block,2032,&mut recovered).await?;
+        assert!(ready.exists());
+        recovered.close(claim.address()).await?;
+        execution.open_light_bch_claim_wallet(&native,&bch.observer,txid,block,2033,&mut recovered,"fixture".into()).await?;
+        if !lost {
+            let saved=std::fs::read(&ready)?;std::fs::write(&ready,b"{}")?;
+            let before=wallet.state.lock().unwrap().calls.len();
+            let result=execution.check_light_bch_claim_wallet(&native,&bch.observer,txid,block,2034,&mut recovered).await;
+            std::fs::write(&ready,saved)?;
+            assert!(result.is_err());assert_eq!(wallet.state.lock().unwrap().calls.len(),before);
+        }
+        let state=wallet.state.lock().unwrap();
+        assert_eq!(state.calls.iter().filter(|method|method.as_str()=="generate_from_keys").count(),1);
+        assert!(state.calls.iter().all(|method|matches!(method.as_str(),"get_address"|"generate_from_keys"|"query_key"|"scan_tx"|"open_wallet"|"close_wallet")));
+    }
+    Ok(())
+}
