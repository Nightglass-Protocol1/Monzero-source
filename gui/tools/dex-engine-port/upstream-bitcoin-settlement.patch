+#[cfg(unix)]
+async fn resume_in_process(checkpoint: &std::path::Path, swap_id: Uuid, lock_id: bitcoin::Txid,
+    unavailable: bool, bitcoin_url: &url::Url) -> Result<Option<bob::State4>> {
+    use std::io::{Read, Write};
+    let output = checkpoint.with_extension(if unavailable { "refused-state" } else { "resumed-state" });
+    let rejection = checkpoint.with_extension("rpc-rejection");
+    let server = if unavailable {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0")?;
+        listener.set_nonblocking(true)?;
+        Some(listener)
+    } else { None };
+    let mut command = std::process::Command::new(std::env::current_exe()?);
+    command
+        .args(["--exact", "resume_pending_in_child", "--ignored", "--test-threads=1"])
+        .env("MONZERO_TEST_CHILD_CHECKPOINT", checkpoint)
+        .env("MONZERO_TEST_CHILD_OUTPUT", &output)
+        .env("MONZERO_TEST_CHILD_SWAP", swap_id.to_string())
+        .env("MONZERO_TEST_CHILD_LOCK", lock_id.to_string())
+        .env("MONZERO_TEST_CHILD_BITCOIN_RPC", bitcoin_url.as_str())
+        .env_remove("MONZERO_TEST_LOCK_EXPORT").env_remove("MONZERO_TEST_RELEASE")
+        .env_remove("MONZERO_TEST_RECOVERY_EXPORT")
+        .env_remove("MONZERO_TEST_CHILD_REJECTION")
+        .stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null());
+    if let Some(server) = &server {
+        command.env("MONZERO_TEST_DAEMON_RPC_PORT", server.local_addr()?.port().to_string())
+            .env("MONZERO_TEST_CHILD_REJECTION", &rejection);
+    }
+    let child = command.spawn()?;
+    struct OwnedChild(std::process::Child);
+    impl Drop for OwnedChild {
+        fn drop(&mut self) { let _ = self.0.kill(); let _ = self.0.wait(); }
+    }
+    let mut child = OwnedChild(child);
+    let mut contacted = false;
+    let status = tokio::time::timeout(Duration::from_secs(45), async {
+        loop {
+            if let Some(server) = &server {
+                match server.accept() {
+                    Ok((mut stream, _)) => {
+                        stream.set_read_timeout(Some(Duration::from_secs(2)))?;
+                        stream.set_write_timeout(Some(Duration::from_secs(2)))?;
+                        let mut request = Vec::new();
+                        loop {
+                            let mut chunk = [0u8; 1024];
+                            let n = stream.read(&mut chunk)?;
+                            anyhow::ensure!(n > 0 && request.len() + n <= 4096, "invalid outage fixture request");
+                            request.extend_from_slice(&chunk[..n]);
+                            if let Some(end) = request.windows(4).position(|w| w == b"\r\n\r\n") {
+                                let headers = std::str::from_utf8(&request[..end])?;
+                                let length: usize = headers.lines().find_map(|line| {
+                                    let (name, value) = line.split_once(':')?;
+                                    name.eq_ignore_ascii_case("content-length").then_some(value.trim())
+                                }).context("missing fixture content length")?.parse()?;
+                                anyhow::ensure!(length <= 2048, "oversized outage fixture body");
+                                if request.len() >= end + 4 + length { break; }
+                            }
+                        }
+                        stream.write_all(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")?;
+                        contacted = true;
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {}
+                    Err(error) => return Err(error.into()),
+                }
+            }
+            if let Some(status) = child.0.try_wait()? { return Ok::<_, anyhow::Error>(status); }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    }).await.context("recovery subprocess deadline")??;
+    if unavailable {
+        anyhow::ensure!(contacted && !status.success() && !output.exists(), "outage recovery did not fail closed");
+        anyhow::ensure!(std::fs::read(rejection)? == b"native-rpc-unavailable\n", "unexpected recovery rejection");
+        return Ok(None);
+    }
+    anyhow::ensure!(status.success(), "recovery subprocess failed");
+    let mut bytes = Vec::new();
+    std::fs::File::open(output)?.take(1_048_577).read_to_end(&mut bytes)?;
+    anyhow::ensure!(bytes.len() <= 1_048_576, "oversized resumed state");
+    Ok(Some(serde_json::from_slice(&bytes)?))
+}
