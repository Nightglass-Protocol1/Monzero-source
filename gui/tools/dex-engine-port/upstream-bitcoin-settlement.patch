+/// Trusted local fixture evidence, NOT an independently verified peer message.
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeFunding {
+    genesis: String,
+    address: String,
+    atoms: String,
+    txid: String,
+    tx_key: String,
+    height: u64,
+    confirmations: u64,
+}
+
+impl NativeFunding {
+    fn parse(data: &[u8], address: &str, atoms: u64) -> Result<Self> {
+        anyhow::ensure!(data.len() <= 4096, "oversized fixture funding evidence");
+        let evidence: Self = serde_json::from_slice(data).context("fixture funding format")?;
+        anyhow::ensure!(evidence.genesis == "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4",
+            "wrong fixture genesis");
+        anyhow::ensure!(evidence.address == address && evidence.atoms == atoms.to_string(),
+            "fixture funding destination or amount mismatch");
+        let hex = |value: &str| value.len() == 64 && value.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+        anyhow::ensure!(hex(&evidence.txid) && hex(&evidence.tx_key), "invalid fixture transaction fields");
+        anyhow::ensure!(evidence.height > 0 && evidence.confirmations >= 10,
+            "unconfirmed fixture funding");
+        let key: PrivateKey = evidence.tx_key.parse().context("fixture transaction scalar")?;
+        anyhow::ensure!(key != PrivateKey::from_scalar(Scalar::ZERO), "zero fixture transaction key");
+        Ok(evidence)
+    }
+}
