+#[tokio::test]
+async fn engine_redeem_is_accepted_on_regtest() -> Result<()> { settlement(false).await }
+
+#[tokio::test]
+async fn engine_cancel_and_full_refund_are_accepted_on_regtest() -> Result<()> { settlement(true).await }
+
+async fn settlement(refund: bool) -> Result<()> {
+    let cli = Cli::default();
+    let env = harness::setup(&cli).await?;
+    let alice_wallet = wallet(&env, 61).await?;
+    let bob_wallet = wallet(&env, 62).await?;
+    let funding = Amount::from_sat(1_000_000);
+    harness::fund_and_mine(&env.bitcoind, bob_wallet.new_address().await?, funding).await?;
+    balance(&bob_wallet, funding).await?;
+
+    let amount = Amount::from_sat(500_000);
+    let fee = Amount::from_sat(1_000);
+    let config = Regtest::get_config();
+    // This does not validate native XMZ funding, network identity, or transfer proof.
+    let atoms: swap_core::xmz::XmzAmount = "2".parse().expect("constant fixture amount");
+    let legacy_amount = swap_core::monero::primitives::Amount::from_pico(atoms.atoms());
+    let alice0 = alice::State0::new(amount, legacy_amount, Amount::ZERO, config,
+        alice_wallet.new_address().await?, alice_wallet.new_address().await?,
+        fee, fee, fee, false, &mut OsRng);
+    let swap_id = Uuid::new_v4();
+    let bob0 = bob::State0::new(swap_id, &mut OsRng, amount, legacy_amount,
+        CancelTimelock::new(config.bitcoin_cancel_timelock),
+        PunishTimelock::new(config.bitcoin_punish_timelock),
+        RemainingRefundTimelock::new(config.bitcoin_remaining_refund_timelock),
+        bob_wallet.new_address().await?, config.monero_finality_confirmations,
+        fee, fee, fee, fee, fee, fee);
+    let (_, alice1) = alice0.receive(bob0.next_message()?)?;
+    let bob1 = bob0.receive(&bob_wallet, alice1.next_message()?).await?;
+    let alice2 = alice1.receive(bob1.next_message())?;
+    let bob2 = bob1.receive(alice2.next_message()?)?;
+    let alice3 = alice2.receive(bob2.next_message()?)?;
+    let (bob3, lock) = bob2.lock_btc().await?;
+    let lock_id = lock.txid();
+    let lock_tx = bob_wallet.sign_and_finalize(lock.into()).await?;
+    broadcast_confirm(&env, lock_tx).await?;
+    let request = alice3.lock_xmr_transfer_request();
+    let address = swap_core::xmz_address::XmzAddress::new(
+        swap_core::xmz_address::XmzNetwork::Mainnet,
+        monero_address::AddressType::Legacy,
+        request.public_spend_key.decompress(), request.public_view_key.0.decompress(),
+    ).expect("fixture lock address");
+    let view = bob3.xmr_view_keys().1;
+    // Standalone Bitcoin tests have no native chain; the combined fixture replaces this.
+    let mut funding_height = 0;
+    let mut verified_state = None;
+    let mut funding_proof = TransferProof::new(
+        swap_core::monero::TxHash("fixture-not-an-xmz-proof".into()),
+        PrivateKey::from_scalar(Scalar::ONE));
+    // Explicit opt-in fixture coordination, not a protocol funding proof.
+    #[cfg(unix)]
+    if export_fixture("MONZERO_TEST_LOCK_EXPORT", &format!("{address}\n{}\n{view}\n", atoms.atoms()))? {
+        let release = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_RELEASE")
+            .context("missing fixture release path")?);
+        tokio::time::timeout(Duration::from_secs(120), async {
+            while !release.is_file() { tokio::time::sleep(Duration::from_millis(20)).await; }
+        }).await.context("native fixture funding deadline")?;
+        use std::io::Read;
+        let mut data = Vec::new();
+        std::fs::File::open(release)?.take(4097).read_to_end(&mut data)?;
+        let evidence = NativeFunding::parse(&data, &address.to_string(), atoms.atoms())?;
+        funding_height = evidence.height;
+        funding_proof = TransferProof::new(swap_core::monero::TxHash(evidence.txid),
+            evidence.tx_key.parse().context("fixture transaction key")?);
+        let observer = native_rpc::authenticated_fixture()?;
+        let mut wrong_key_proof = funding_proof.clone();
+        wrong_key_proof.tx_key = PrivateKey::from_scalar(Scalar::ONE);
+        anyhow::ensure!(wrong_key_proof.tx_key != funding_proof.tx_key, "fixture key collision");
+        let wrong_key_error = swap_machine::xmz_funding::verify_state3(&observer, &bob3,
+            wrong_key_proof, swap_core::xmz_address::XmzNetwork::Mainnet,
+            "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4", 10).await.err()
+            .context("engine accepted wrong native transaction key")?;
+        anyhow::ensure!(wrong_key_error.to_string() == "native wallet observations disagree",
+            "wrong-key test failed for an unexpected reason");
+        let wrong_amount = swap_core::xmz::XmzAmount::from_atoms(atoms.atoms() + 1);
+        let wrong_amount_error = swap_machine::xmz_funding::verify(&observer,
+            swap_machine::xmz_funding::FundingRequest {
+                address: address.clone(), amount: wrong_amount, proof: funding_proof.clone(),
+            }, "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4", 10).await.err()
+            .context("engine accepted wrong expected native amount")?;
+        anyhow::ensure!(wrong_amount_error.to_string() == "native funding amount mismatch",
+            "wrong-amount test failed for an unexpected reason");
+        let verified = swap_machine::xmz_funding::verify(&observer,
+            swap_machine::xmz_funding::FundingRequest {
+                address: address.clone(), amount: atoms, proof: funding_proof.clone(),
+            }, "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4", 10).await?;
+        anyhow::ensure!(verified.height() == funding_height, "fixture claimed wrong funding height");
+        use swap_machine::xmz_funding::{FundingPolicy, PendingFunding};
+        let policy = FundingPolicy::new(swap_core::xmz_address::XmzNetwork::Mainnet,
+            "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4".into(), 10, Network::Regtest, 1)?;
+        let pending = PendingFunding::new(swap_id, policy.clone(), bob3.clone(), funding_proof.clone())?;
+        let encoded = pending.encode()?;
+        drop(pending);
+        let lock_id = bob3.tx_lock.txid();
+        anyhow::ensure!(PendingFunding::decode(&encoded, Uuid::new_v4(), lock_id, &policy).is_err(),
+            "accepted another swap's recovery record");
+        anyhow::ensure!(PendingFunding::decode(&encoded, swap_id, "00".repeat(32).parse()?, &policy).is_err(),
+            "accepted another Bitcoin lock's recovery record");
+        let changed_policy = FundingPolicy::new(swap_core::xmz_address::XmzNetwork::Mainnet,
+            "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4".into(), 11, Network::Regtest, 1)?;
+        anyhow::ensure!(PendingFunding::decode(&encoded, swap_id, lock_id, &changed_policy).is_err(),
+            "accepted a changed recovery policy");
+        let mut altered: serde_json::Value = serde_json::from_slice(&encoded)?;
+        altered["verified"] = serde_json::json!(true);
+        anyhow::ensure!(PendingFunding::decode(&serde_json::to_vec(&altered)?, swap_id, lock_id, &policy).is_err(),
+            "accepted a persisted approval flag");
+        // Private checkpoint for separate-process verification and reconstruction.
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+        let checkpoint_path = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_RECOVERY_EXPORT")
+            .context("missing fixture recovery export")?).with_extension("pending-state");
+        let mut checkpoint = std::fs::OpenOptions::new().write(true).create_new(true)
+            .mode(0o600).open(&checkpoint_path)?;
+        checkpoint.write_all(&encoded)?;
+        checkpoint.sync_all()?;
+        drop(checkpoint);
+        anyhow::ensure!(resume_in_process(&checkpoint_path, swap_id, lock_id, true, &env.bitcoind_url).await?.is_none(),
+            "recovery accepted unavailable native RPC");
+        verified_state = Some(resume_in_process(&checkpoint_path, swap_id, lock_id, false, &env.bitcoind_url).await?
+            .context("missing recovered state")?);
+    }
+    let bob4 = match verified_state {
+        Some(state) => state,
+        None => bob3.xmr_locked(swap_core::monero::BlockHeight { height: funding_height },
+            funding_proof.into(), None), // Bitcoin-only fixture, no native chain.
+    };
+
+    if refund {
+        let cancel = alice3.signed_cancel_transaction()?;
+        let error = env.bitcoind.sendrawtransaction(cancel.clone().into()).await
+            .expect_err("cancel must fail before relative timelock");
+        anyhow::ensure!(error.to_string().contains("non-BIP68-final"), "unexpected early-cancel rejection: {error}");
+        mine(&env, config.bitcoin_cancel_timelock.checked_sub(1).context("zero test cancellation delay")?).await?;
+        #[cfg(unix)]
+        if std::env::var_os("MONZERO_TEST_LOCK_EXPORT").is_some() {
+            assert_pending_rejected(&env, swap_id, lock_id,
+                "Bitcoin cancellation window reached; recovery required").await?;
+        }
+        broadcast_confirm(&env, cancel).await?;
+        let mut cancellation = bob4.cancel();
+        #[cfg(unix)]
+        if std::env::var_os("MONZERO_TEST_LOCK_EXPORT").is_some() {
+            cancellation = load_pending_fixture(swap_id, lock_id)?.prepare_cancellation();
+        }
+        let refund_tx = cancellation.signed_full_refund_transaction()?;
+        let refund_id = refund_tx.compute_txid();
+        broadcast_confirm(&env, refund_tx).await?;
+        // Bob pays lock, cancel and refund fees; Alice receives nothing.
+        balance(&bob_wallet, funding - fee - fee - fee).await?;
+        balance(&alice_wallet, Amount::ZERO).await?;
+        let observed = bob_wallet.get_raw_transaction(refund_id).await?
+            .context("confirmed refund missing from Electrum")?;
+        let recovered = alice3.extract_monero_private_key_from_refund(observed)?;
+        assert_eq!(monero_oxide_ext::PublicKey::from_private_key(&recovered),
+            alice3.lock_xmr_transfer_request().public_spend_key);
+        #[cfg(unix)]
+        export_fixture("MONZERO_TEST_RECOVERY_EXPORT", &format!("{address}\n{recovered}\n{view}\n{}\n", atoms.atoms()))?;
+    } else {
+        #[cfg(unix)]
+        let signature = if std::env::var_os("MONZERO_TEST_LOCK_EXPORT").is_some() {
+            let pending = load_pending_fixture(swap_id, lock_id)?;
+            let native = native_rpc::authenticated_fixture()?;
+            let bitcoin = native_rpc::BitcoinRpc::new(env.bitcoind_url.clone())?;
+            pending.redeem_signature(&native, &bitcoin).await?
+        } else { bob4.tx_redeem_encsig() };
+        #[cfg(not(unix))]
+        let signature = bob4.tx_redeem_encsig();
+        let redeem = alice3.signed_redeem_transaction(signature)?;
+        broadcast_confirm(&env, redeem).await?;
+        balance(&alice_wallet, amount - fee).await?;
+        balance(&bob_wallet, funding - amount - fee).await?;
+        let recovered = bob4.check_for_tx_redeem(&bob_wallet).await?
+            .context("confirmed redeem missing from Electrum")?;
+        assert_eq!(monero_oxide_ext::PublicKey::from_private_key(&recovered.xmr_keys().0),
+            alice3.lock_xmr_transfer_request().public_spend_key);
+        #[cfg(unix)]
+        export_fixture("MONZERO_TEST_RECOVERY_EXPORT", &format!("{address}\n{}\n{view}\n{}\n", recovered.xmr_keys().0, atoms.atoms()))?;
+    }
+    #[cfg(unix)]
+    if std::env::var_os("MONZERO_TEST_LOCK_EXPORT").is_some() {
+        assert_pending_rejected(&env, swap_id, lock_id, "Bitcoin lock absent or spent").await?;
+    }
+    Ok(())
+}
