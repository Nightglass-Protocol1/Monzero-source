+/// Only launched by resume_in_process with a disposable private checkpoint.
+#[cfg(unix)]
+#[tokio::test]
+#[ignore = "subprocess helper requires private fixture paths and owned native RPC"]
+async fn resume_pending_in_child() -> Result<()> {
+    use std::io::{Read, Write};
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+    use swap_machine::xmz_funding::{FundingPolicy, PendingFunding};
+    let input = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_CHILD_CHECKPOINT")
+        .context("missing private checkpoint")?);
+    let metadata = std::fs::symlink_metadata(&input)?;
+    anyhow::ensure!(metadata.is_file() && metadata.permissions().mode() & 0o077 == 0,
+        "checkpoint must be a private regular file");
+    let mut bytes = Vec::new();
+    std::fs::File::open(input)?.take(1_048_577).read_to_end(&mut bytes)?;
+    let policy = FundingPolicy::new(swap_core::xmz_address::XmzNetwork::Mainnet,
+        "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4".into(), 10, Network::Regtest, 1)?;
+    let pending = PendingFunding::decode(&bytes, std::env::var("MONZERO_TEST_CHILD_SWAP")?.parse()?,
+        std::env::var("MONZERO_TEST_CHILD_LOCK")?.parse()?, &policy)?;
+    let observer = native_rpc::authenticated_fixture()?;
+    let bitcoin = native_rpc::BitcoinRpc::new(std::env::var("MONZERO_TEST_CHILD_BITCOIN_RPC")?.parse()?)?;
+    let resumed = match pending.resume(&observer, &bitcoin).await {
+        Ok(state) => state,
+        Err(error) => {
+            if std::env::var_os("MONZERO_TEST_CHILD_REJECTION").is_some() {
+                anyhow::ensure!(error.chain().any(|cause| cause.downcast_ref::<reqwest::Error>()
+                    .is_some_and(|http| http.status() == Some(reqwest::StatusCode::SERVICE_UNAVAILABLE))),
+                    "unexpected native recovery failure");
+                export_fixture("MONZERO_TEST_CHILD_REJECTION", "native-rpc-unavailable\n")?;
+            }
+            return Err(error);
+        }
+    };
+    let serialized = serde_json::to_vec(&resumed)?;
+    anyhow::ensure!(serialized.len() <= 1_048_576, "oversized resumed state");
+    let mut output = std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600)
+        .open(std::env::var_os("MONZERO_TEST_CHILD_OUTPUT").context("missing recovery output")?)?;
+    output.write_all(&serialized)?;
+    output.sync_all()?;
+    Ok(())
+}
