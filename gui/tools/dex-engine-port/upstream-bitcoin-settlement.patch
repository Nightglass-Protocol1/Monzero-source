+#[cfg(unix)]
+fn export_fixture(variable: &str, contents: &str) -> Result<bool> {
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+    let Some(path) = std::env::var_os(variable) else { return Ok(false); };
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true)
+        .mode(0o600).open(path).context("create private fixture export")?;
+    file.write_all(contents.as_bytes())?;
+    file.sync_all()?;
+    Ok(true)
+}
