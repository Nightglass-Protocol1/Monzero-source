+impl BitcoinWalletSeed for TestSeed {
+    fn derive_extended_private_key(&self, network: Network) -> Result<bitcoin::bip32::Xpriv> {
+        Ok(bitcoin::bip32::Xpriv::new_master(network, &[self.0; 64])?)
+    }
+
+    fn derive_extended_private_key_legacy(
+        &self, network: bdk::bitcoin::Network,
+    ) -> Result<bdk::bitcoin::util::bip32::ExtendedPrivKey> {
+        Ok(bdk::bitcoin::util::bip32::ExtendedPrivKey::new_master(network, &[self.0; 64])?)
+    }
+}
+
+async fn wallet(env: &harness::TestEnv<'_>, seed: u8) -> Result<Wallet> {
+    WalletBuilder::<TestSeed>::default().seed(TestSeed(seed)).network(Network::Regtest)
+        .electrum_rpc_urls(vec![env.electrum_url.clone()])
+        .persister(PersisterConfig::InMemorySqlite).finality_confirmations(1u32)
+        .target_block(1u32).sync_interval(Duration::from_millis(0))
+        .use_mempool_space_fee_estimation(false).build().await
+}
+
+async fn balance(wallet: &Wallet, expected: Amount) -> Result<()> {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        loop {
+            wallet.sync().await?;
+            if wallet.balance().await? == expected { return Ok::<_, anyhow::Error>(()); }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    }).await.context("balance deadline")?
+}
+
+async fn mine(env: &harness::TestEnv<'_>, blocks: u32) -> Result<()> {
+    let address = env.bitcoind.with_wallet(harness::BITCOIN_TEST_WALLET_NAME)?
+        .getnewaddress(None, None).await?.require_network(Network::Regtest)?;
+    env.bitcoind.generatetoaddress(blocks, address).await?;
+    Ok(())
+}
+
+async fn broadcast_confirm(env: &harness::TestEnv<'_>, tx: Transaction) -> Result<()> {
+    let expected = tx.compute_txid().to_string();
+    let actual = env.bitcoind.sendrawtransaction(tx.into()).await?;
+    anyhow::ensure!(actual == expected, "broadcast txid mismatch");
+    mine(env, 1).await
+}
