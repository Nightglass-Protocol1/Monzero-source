+#[cfg(unix)]
+#[tokio::test]
+#[ignore = "requires the owned funded fakechain wallet fixture"]
+async fn native_fee_estimation() -> Result<()> {
+    use swap_machine::native_funding_rpc::fee_estimation::{FeeRequest, NativeFeeEstimator};
+    use swap_core::{xmz::XmzAmount, xmz_address::{XmzAddress, XmzNetwork}};
+    let wallet = XmzAddress::parse(XmzNetwork::Mainnet, &std::env::var("MONZERO_TEST_FEE_WALLET")?)?;
+    let destination = XmzAddress::parse(XmzNetwork::Mainnet, &std::env::var("MONZERO_TEST_FEE_DESTINATION")?)?;
+    anyhow::ensure!(wallet != destination, "fixture requires distinct wallet and destination");
+    let amount = XmzAmount::from_atom_string(&std::env::var("MONZERO_TEST_FEE_ATOMS")?)
+        .map_err(|_| anyhow::anyhow!("invalid fee fixture amount"))?;
+    let request = || FeeRequest { wallet: wallet.clone(), destination: destination.clone(),
+        amount, account: 0, priority: 1 };
+    let genesis = "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4";
+    let mut estimator = NativeFeeEstimator::new(native_rpc::authenticated_fixture()?);
+    let error = estimator.estimate(request(), &"0".repeat(64)).await.err()
+        .context("accepted wrong fee chain")?;
+    anyhow::ensure!(error.to_string() == "unexpected fee-estimation chain", "unexpected chain rejection");
+    let mut wrong_wallet = request();
+    wrong_wallet.wallet = destination.clone();
+    let error = estimator.estimate(wrong_wallet, genesis).await.err()
+        .context("accepted wrong fee wallet")?;
+    anyhow::ensure!(error.to_string() == "unexpected estimation wallet", "unexpected wallet rejection");
+    let estimate = estimator.estimate(request(), genesis).await?;
+    anyhow::ensure!(estimate.request().wallet == wallet && estimate.request().destination == destination
+        && estimate.request().amount == amount && estimate.request().account == 0
+        && estimate.request().priority == 1, "fee request binding lost");
+    anyhow::ensure!(estimate.fee().atoms() > 0 && estimate.weight() > 0
+        && estimate.snapshot().genesis == genesis, "invalid native estimate");
+    estimator.revalidate_for_display(&estimate, std::time::Duration::from_secs(30)).await?;
+    let request_id = std::env::var("MONZERO_TEST_FEE_REQUEST_ID")?.parse::<Uuid>()?;
+    let wire = serde_json::json!({"schema":"monzero-native-fee-request-v1","requestId":request_id.to_string(),
+        "wallet":wallet.to_string(),"destination":destination.to_string(),"amountAtoms":amount.atom_string(),
+        "account":"0","priority":"1","genesis":genesis});
+    let bytes = serde_json::to_vec(&wire)?;
+    anyhow::ensure!(estimator.preview_request(&bytes,XmzNetwork::Mainnet,genesis,std::time::Duration::ZERO)
+        .await.err().context("accepted zero operation budget")?.to_string() == "invalid fee request time budget",
+        "unexpected budget rejection");
+    let mut injected = wire;
+    injected["rpcUrl"] = serde_json::json!("http://example.invalid");
+    let error = estimator.preview_request(&serde_json::to_vec(&injected)?,XmzNetwork::Mainnet,genesis,
+        std::time::Duration::from_secs(30)).await.err().context("accepted injected endpoint")?;
+    anyhow::ensure!(error.to_string() == "invalid fee preview request JSON", "unexpected input rejection");
+    let mut response_bytes = Vec::new();
+    estimator.serve_preview(bytes.as_slice(), &mut response_bytes, XmzNetwork::Mainnet,genesis,
+        std::time::Duration::from_secs(30)).await?;
+    let preview: serde_json::Value = serde_json::from_slice(&response_bytes)?;
+    anyhow::ensure!(preview["requestId"] == request_id.to_string()
+        && preview["amountAtoms"] == amount.atom_string()
+        && preview["executable"] == false, "invalid fee display export");
+    // Separate constructions can select different inputs and fees.
+    let exported_fee = XmzAmount::from_atom_string(preview["feeAtoms"].as_str().context("missing fee string")?)
+        .map_err(|_| anyhow::anyhow!("invalid exported fee"))?;
+    anyhow::ensure!(exported_fee.atoms() > 0, "zero exported fee");
+    anyhow::ensure!(export_fixture("MONZERO_TEST_FEE_PREVIEW", &serde_json::to_string(&preview)?)?,
+        "missing fee preview output path");
+    anyhow::ensure!(estimator.preview_for_display(Uuid::nil(), &estimate,
+        std::time::Duration::from_secs(30)).await.is_err(), "accepted missing preview identity");
+    let rejected = estimator.revalidate_for_display(&estimate, std::time::Duration::ZERO).await;
+    anyhow::ensure!(rejected.err().context("accepted invalid estimate age limit")?.to_string()
+        == "fee estimate age limit must be positive", "unexpected freshness rejection");
+    anyhow::ensure!(export_fixture("MONZERO_TEST_FEE_RESULT", "fee-estimation-verified\n")?,
+        "missing fee fixture result path");
+    Ok(())
+}
