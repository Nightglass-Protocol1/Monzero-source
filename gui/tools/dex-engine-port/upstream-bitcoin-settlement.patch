+#[cfg(unix)]
+#[tokio::test]
+#[ignore = "requires a disposable authenticated wallet RPC and private credential file"]
+async fn native_rpc_digest_auth() -> Result<()> {
+    use std::io::Read;
+    use std::os::unix::fs::PermissionsExt;
+    let path = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_AUTH_LOGIN").context("missing auth fixture")?);
+    let metadata = std::fs::symlink_metadata(&path)?;
+    anyhow::ensure!(metadata.is_file() && metadata.permissions().mode() & 0o077 == 0, "nonprivate credentials");
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)?.take(1025).read_to_end(&mut bytes)?;
+    anyhow::ensure!(bytes.len() <= 1024, "oversized credentials");
+    let credentials = std::str::from_utf8(&bytes)?;
+    let (username, password) = credentials.split_once(':').context("invalid credential file")?;
+    let daemon = std::env::var("MONZERO_TEST_AUTH_DAEMON_PORT")?.parse()?;
+    let wallet = std::env::var("MONZERO_TEST_AUTH_WALLET_PORT")?.parse()?;
+    let unauthenticated = reqwest::Client::builder().no_proxy()
+        .redirect(reqwest::redirect::Policy::none()).timeout(std::time::Duration::from_secs(5)).build()?
+        .post(format!("http://127.0.0.1:{wallet}/json_rpc"))
+        .json(&serde_json::json!({"jsonrpc":"2.0","id":"auth","method":"get_version"})).send().await?;
+    anyhow::ensure!(unauthenticated.status() == reqwest::StatusCode::UNAUTHORIZED,
+        "accepted unauthenticated request");
+    let wrong = native_rpc::NativeRpc::new(daemon, wallet, username.into(), format!("{password}-wrong"))?;
+    let error = wrong.wallet_version().await.err().context("accepted unauthorised RPC")?;
+    anyhow::ensure!(error.chain().any(|cause| cause.downcast_ref::<reqwest::Error>()
+        .is_some_and(|http| http.status() == Some(reqwest::StatusCode::UNAUTHORIZED))), "unexpected auth rejection");
+    let mut client = native_rpc::NativeRpc::new(daemon, wallet, username.into(), password.into())?;
+    let version = client.wallet_version().await?;
+    let expected_open = match std::env::var("MONZERO_TEST_WALLET_EXPECT_OPEN")?.as_str() {
+        "0" => false, "1" => true, _ => anyhow::bail!("invalid wallet-state fixture"),
+    };
+    anyhow::ensure!(client.opened_wallet(swap_core::xmz_address::XmzNetwork::Mainnet).await?.is_some() == expected_open,
+        "unexpected native wallet state");
+    anyhow::ensure!(client.wallet_version().await? == version, "authenticated repeated request failed");
+    anyhow::ensure!(client.replace_credentials(username.into(), String::new()).is_err(),
+        "accepted empty replacement password");
+    anyhow::ensure!(client.wallet_version().await? == version, "invalid rotation damaged client");
+    client.replace_credentials(username.into(), format!("{password}-rotated-wrong"))?;
+    let error = client.wallet_version().await.err().context("rotation reused old credentials")?;
+    anyhow::ensure!(error.chain().any(|cause| cause.downcast_ref::<reqwest::Error>()
+        .is_some_and(|http| http.status() == Some(reqwest::StatusCode::UNAUTHORIZED))),
+        "unexpected rotation rejection");
+    client.replace_credentials(username.into(), password.into())?;
+    anyhow::ensure!(client.wallet_version().await? == version, "credential restoration failed");
+    use swap_machine::native_funding_rpc::wallet_session::{NativeWalletSession, SwapWalletId};
+    let id = SwapWalletId::new("12345678-1234-1234-1234-123456789abc".parse()?)?;
+    let mut session = NativeWalletSession::new(client, swap_core::xmz_address::XmzNetwork::Mainnet);
+    if expected_open {
+        anyhow::ensure!(session.create(&id, "disposable-lifecycle-test".into()).await.err()
+            .context("switched an existing wallet")?.to_string() == "wallet already open", "unexpected open-wallet rejection");
+    } else {
+        let command = serde_json::json!({"schema":"monzero-wallet-control-v1",
+            "requestId":"34567890-1234-1234-1234-123456789abc","operation":"create",
+            "walletId":"12345678-1234-1234-1234-123456789abc","password":"disposable-lifecycle-test","expectedAddress":""});
+        let reply = session.execute_control(&serde_json::to_vec(&command)?,std::time::Duration::from_secs(30)).await?;
+        anyhow::ensure!(reply["requestId"] == command["requestId"] && reply["operation"] == "create"
+            && reply["schema"] == "monzero-wallet-control-result-v1" && reply["readyForTrading"] == false
+            && reply.as_object().context("invalid control reply")?.len() == 5, "invalid wallet control result");
+        let address = swap_core::xmz_address::XmzAddress::parse(swap_core::xmz_address::XmzNetwork::Mainnet,
+            reply["address"].as_str().context("missing created wallet address")?)?;
+        anyhow::ensure!(session.create(&id, "disposable-lifecycle-test".into()).await.is_err(), "created over an open wallet");
+        session.close(&address).await?;
+        session.open(&id, "disposable-lifecycle-test".into(), &address).await?;
+        session.close(&address).await?;
+        anyhow::ensure!(session.open(&id, "wrong-password".into(), &address).await.is_err(), "accepted wrong wallet password");
+        anyhow::ensure!(session.open(&id, "disposable-lifecycle-test".into(), &address).await.err()
+            .context("retried an uncertain wallet operation")?.to_string() == "wallet session requires reconciliation",
+            "unexpected reconciliation rejection");
+    }
+    anyhow::ensure!(export_fixture("MONZERO_TEST_AUTH_RESULT", if expected_open {
+        "wallet-lifecycle-v1:open\n"
+    } else {
+        "wallet-lifecycle-v1:empty\n"
+    })?, "missing lifecycle completion marker path");
+    Ok(())
+}
