+#[test]
+fn native_funding_rejects_mismatched_evidence() {
+    let valid = serde_json::json!({
+        "genesis": "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4",
+        "address": "test-destination", "atoms": "200000000000",
+        "txid": "ab".repeat(32), "tx_key": PrivateKey::from_scalar(Scalar::ONE).to_string(),
+        "height": 132, "confirmations": 10,
+    });
+    let parse = |value: &serde_json::Value| NativeFunding::parse(
+        &serde_json::to_vec(value).unwrap(), "test-destination", 200_000_000_000);
+    assert!(parse(&valid).is_ok());
+    for (field, value) in [
+        ("genesis", serde_json::json!("wrong-chain")),
+        ("address", serde_json::json!("other-destination")),
+        ("atoms", serde_json::json!("0200000000000")),
+        ("txid", serde_json::json!("invalid")),
+        ("tx_key", serde_json::json!("00".repeat(32))),
+        ("height", serde_json::json!(0)),
+        ("confirmations", serde_json::json!(9)),
+        ("unknown", serde_json::json!(true)),
+    ] {
+        let mut changed = valid.clone();
+        changed[field] = value;
+        assert!(parse(&changed).is_err(), "accepted invalid field {field}");
+    }
+    assert!(NativeFunding::parse(&vec![b' '; 4097], "test-destination", 200_000_000_000).is_err());
+}
