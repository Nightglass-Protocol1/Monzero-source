+//! Read-only adapter to owned local fakechain fixtures; not a public RPC client.
+use anyhow::{Context, Result, ensure};
+use serde_json::{Value, json};
+
+pub struct BitcoinRpc {
+    client: reqwest::Client,
+    url: url::Url,
+    username: String,
+    password: String,
+}
+
+impl BitcoinRpc {
+    pub fn new(mut url: url::Url) -> Result<Self> {
+        let host: std::net::Ipv4Addr = url.host_str().context("missing Bitcoin fixture host")?.parse()?;
+        ensure!(url.scheme() == "http" && (host.is_private() || host.is_loopback())
+            && url.query().is_none() && url.fragment().is_none(), "nonlocal Bitcoin fixture endpoint");
+        let username = url.username().to_owned();
+        let password = url.password().context("missing fixture RPC password")?.to_owned();
+        url.set_username("").map_err(|_| anyhow::anyhow!("invalid fixture URL"))?;
+        url.set_password(None).map_err(|_| anyhow::anyhow!("invalid fixture URL"))?;
+        Ok(Self { client: reqwest::Client::builder().no_proxy()
+            .redirect(reqwest::redirect::Policy::none()).timeout(std::time::Duration::from_secs(15)).build()?,
+            url, username, password })
+    }
+
+    async fn rpc(&self, method: &str, params: Value) -> Result<Box<serde_json::value::RawValue>> {
+        let mut response = self.client.post(self.url.clone()).basic_auth(&self.username, Some(&self.password))
+            .json(&json!({"jsonrpc":"1.0", "id":"bitcoin-funding", "method":method, "params":params}))
+            .send().await?.error_for_status()?;
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await? {
+            ensure!(bytes.len() + chunk.len() <= 1_048_576, "oversized Bitcoin RPC response");
+            bytes.extend_from_slice(&chunk);
+        }
+        #[derive(serde::Deserialize)]
+        struct Response { id: String, error: Option<Value>, result: Box<serde_json::value::RawValue> }
+        let result: Response = serde_json::from_slice(&bytes)?;
+        ensure!(result.id == "bitcoin-funding" && result.error.is_none(), "Bitcoin RPC rejected request");
+        Ok(result.result)
+    }
+}
+
+#[async_trait::async_trait]
+impl swap_machine::xmz_funding::BitcoinLockObserver for BitcoinRpc {
+    async fn unspent(&self, outpoint: bitcoin::OutPoint) -> Result<Option<swap_machine::xmz_funding::BitcoinLockObservation>> {
+        let genesis = serde_json::from_str(self.rpc("getblockhash", json!([0])).await?.get())?;
+        let raw = self.rpc("gettxout", json!([outpoint.txid.to_string(), outpoint.vout, true])).await?;
+        #[derive(serde::Deserialize)]
+        struct Script { hex: String }
+        #[derive(serde::Deserialize)]
+        struct Output {
+            bestblock: bitcoin::BlockHash, confirmations: u64,
+            value: Box<serde_json::value::RawValue>,
+            #[serde(rename = "scriptPubKey")] script: Script,
+        }
+        let Some(output): Option<Output> = serde_json::from_str(raw.get())? else { return Ok(None); };
+        Ok(Some(swap_machine::xmz_funding::BitcoinLockObservation {
+            genesis, tip: output.bestblock, confirmations: output.confirmations,
+            script: bitcoin::ScriptBuf::from_hex(&output.script.hex)?,
+            // Preserve the JSON decimal lexeme: never round through f64.
+            amount: bitcoin::Amount::from_str_in(output.value.get(), bitcoin::Denomination::Bitcoin)?,
+        }))
+    }
+}
