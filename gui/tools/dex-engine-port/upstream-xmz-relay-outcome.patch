+fn classify_broadcast(response: Result<Value>, amount: XmzAmount) -> Result<RelayedTransfer> {
+    // Even a malformed success reply may follow a completed broadcast. Keep
+    // pre-dispatch errors distinct, but never label a dispatch error "not sent".
+    response.and_then(|value| parse_relay(&value, amount))
