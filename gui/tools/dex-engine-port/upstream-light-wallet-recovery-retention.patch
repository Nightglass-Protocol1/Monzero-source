+//! Allocation-only recovery intent and completion. Never activates a wallet.
+//! Private local records are not protection against malicious local rollback.
+use super::*;
+use crate::litecoin_rpc::reservation::Journal;
+use serde::{Deserialize,Serialize};
+use std::path::Path;
+const INTENT:&str="light-recovery-allocation-intent.json";
+const COMPLETE:&str="light-recovery-allocation-complete.json";
+#[derive(Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {schema:String,context:sha256::Hash,review:Value,before:String,after:String}
+
+impl RecoveryCoverage {
+    /// Persist exact new reservation identities before changing the address book.
+    /// `context` must bind the caller's reviewed configuration; approval must be
+    /// supplied independently of retained files. No password or secret is stored.
+    pub fn retain_journaled(&self,directory:&Path,chain:&HeaderSequence,book:&mut AddressBook,
+        approved:sha256::Hash,context:sha256::Hash)->Result<Value> {
+        ensure!(approved==self.commitment,"recovery coverage differs from approval");
+        let journal=Journal::open(directory)?;
+        match journal.read(INTENT) {
+            Ok(_)=>{},
+            Err(error) if error.downcast_ref::<std::io::Error>()
+                .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                ensure!(chain.network()==self.account.network() && chain.height()==self.height
+                    && chain.contains(self.height,self.tip),"recovery coverage chain changed");
+                let (descriptor,before)=book.backup_parts()?;
+                ensure!(serde_json::to_vec(&descriptor)?==serde_json::to_vec(&self.account.descriptor())?
+                    && sha256::Hash::hash(&before)==self.before,"recovery allocation source changed");
+                let intent=Intent {schema:"monzero-light-recovery-allocation-intent-v1".into(),context,
+                    review:self.review.clone(),before:String::from_utf8(before)?,
+                    after:String::from_utf8(book.prepare_discovered(self.target)?)?};
+                let bytes=serde_json::to_vec(&intent)?;
+                // Conflicting completion must fail before even retaining intent.
+                journal.compatible(COMPLETE,&receipt(&bytes,&intent)?)?;
+                journal.retain(INTENT,&bytes)?;
+            },
+            Err(error)=>return Err(error),
+        }
+        resume(&journal,chain,book,approved,context)
+    }
+}
+
+/// Resume a previously approved allocation transition after reopening the book.
+/// The expected coverage commitment and configuration context must come from the
+/// caller's saved approval, never be automatically adopted from this journal.
+/// This does not deserialize coverage into a new scan/proof capability.
+pub fn resume_retention(directory:&Path,chain:&HeaderSequence,book:&mut AddressBook,
+    approved:sha256::Hash,context:sha256::Hash)->Result<Value> {
+    resume(&Journal::open(directory)?,chain,book,approved,context)
+}
+fn receipt(bytes:&[u8],intent:&Intent)->Result<Vec<u8>> {
+    Ok(serde_json::to_vec(&json!({"schema":"monzero-light-recovery-allocation-complete-v1",
+        "context":intent.context,"intentDigest":sha256::Hash::hash(bytes),
+        "coverageCommitment":sha256::Hash::hash(&serde_json::to_vec(&intent.review)?),
+        "allocationDigest":sha256::Hash::hash(intent.after.as_bytes()),
+        "allocationsRetained":true,"backupRefreshRequired":true,"activated":false,
+        "historyCompleteness":"unproven","activeSwapRecovery":false}))?)
+}
+fn resume(journal:&Journal,chain:&HeaderSequence,book:&mut AddressBook,
+    approved:sha256::Hash,context:sha256::Hash)->Result<Value> {
+    let bytes=journal.read(INTENT)?;
+    let intent:Intent=serde_json::from_slice(&bytes)?;
+    ensure!(intent.schema=="monzero-light-recovery-allocation-intent-v1" && intent.context==context
+        && sha256::Hash::hash(&serde_json::to_vec(&intent.review)?)==approved,
+        "retained recovery differs from approval or configuration");
+    let (descriptor,_)=book.backup_parts()?;
+    let account=PublicAccount::from_descriptor(&descriptor,chain.network())?;
+    ensure!(intent.review["account"]==serde_json::to_value(&descriptor)?
+        && intent.review["network"]==chain.network().name()
+        && intent.review["schema"]==format!("monzero-{}-recovery-coverage-v1",chain.network().tag()),
+        "retained recovery account or network changed");
+    let height:u32=serde_json::from_value(intent.review["height"].clone())?;
+    let tip:bitcoin::BlockHash=serde_json::from_value(intent.review["tip"].clone())?;
+    // An extension is safe for conservative allocation retention; a fork is not
+    // accepted as fresh balance evidence or permission to activate.
+    ensure!(chain.contains(height,tip),"retained recovery chain changed");
+    let digest:sha256::Hash=serde_json::from_value(intent.review["allocationDigest"].clone())?;
+    ensure!(sha256::Hash::hash(intent.before.as_bytes())==digest,"retained recovery source mismatch");
+    let before:[u32;2]=serde_json::from_value(intent.review["allocatedBefore"].clone())?;
+    let after:[u32;2]=serde_json::from_value(intent.review["allocatedAfter"].clone())?;
+    ensure!(AddressBook::backup_counts(&account,intent.before.as_bytes())?==before
+        && AddressBook::backup_counts(&account,intent.after.as_bytes())?==after,
+        "retained recovery allocation counts mismatch");
+    let completed=receipt(&bytes,&intent)?;
+    journal.compatible(COMPLETE,&completed)?;
+    // Reconcile possible previous publication before any address mutation.
+    journal.retain(INTENT,&bytes)?;
+    book.apply_recovery_record(intent.before.as_bytes(),intent.after.as_bytes())?;
+    journal.retain(COMPLETE,&completed)?;
+    ensure!(journal.read(COMPLETE)?==completed,"recovery completion read-back mismatch");
+    Ok(serde_json::from_slice(&completed)?)
+}
