+#[tokio::test]
+async fn journaled_recovery_resumes_exact_allocation_transition_on_four_chains()->Result<()> {
+    use super::retention::resume_retention;
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        let directory=Directory::new()?;let journal=Directory::new()?;
+        let mut book=AddressBook::create(&directory.0,account(network,1)?)?;
+        let request=Uuid::new_v4();let first=book.reserve(request,Branch::Receive)?.address().to_string();
+        let before=fs::read(directory.0.join("litecoin-address-book.json"))?;
+        let (chain,observation)=empty_scan(network,[2,1]).await?;
+        let coverage=observation.review_recovery_coverage(&chain,&book,[2,1])?;
+        let approved=coverage.commitment();let context=sha256::Hash::hash(b"reviewed configuration");
+        let wrong=sha256::Hash::hash(b"wrong");
+        assert!(coverage.retain_journaled(&journal.0,&chain,&mut book,wrong,context).is_err());
+        assert_eq!(fs::read_dir(&journal.0)?.count(),0);
+        let receipt=coverage.retain_journaled(&journal.0,&chain,&mut book,approved,context)?;
+        assert_eq!(receipt["activated"],false);assert_eq!(receipt["backupRefreshRequired"],true);
+        let after=fs::read(directory.0.join("litecoin-address-book.json"))?;
+        let intent_path=journal.0.join("light-recovery-allocation-intent.json");
+        let complete_path=journal.0.join("light-recovery-allocation-complete.json");
+        let intent=fs::read(&intent_path)?;let complete=fs::read(&complete_path)?;
+        drop(book);drop(coverage);drop(observation);
+        // Simulate interruption after intent publication but before allocation.
+        fs::write(directory.0.join("litecoin-address-book.json"),&before)?;
+        fs::remove_file(&complete_path)?;
+        let mut book=AddressBook::open(&directory.0,account(network,1)?)?;
+        assert!(resume_retention(&journal.0,&chain,&mut book,wrong,context).is_err());
+        assert!(resume_retention(&journal.0,&chain,&mut book,approved,wrong).is_err());
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,before);
+        // An invalid retained replacement cannot rewrite an original identity.
+        let mut altered:Value=serde_json::from_slice(&intent)?;
+        let mut replacement:Value=serde_json::from_str(altered["after"].as_str().unwrap())?;
+        replacement["entries"][0]["request"]=json!(Uuid::new_v4());
+        altered["after"]=json!(serde_json::to_string(&replacement)?);
+        fs::write(&intent_path,serde_json::to_vec(&altered)?)?;
+        assert!(resume_retention(&journal.0,&chain,&mut book,approved,context).is_err());
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,before);
+        fs::write(&intent_path,&intent)?;
+        assert_eq!(resume_retention(&journal.0,&chain,&mut book,approved,context)?,receipt);
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,after);
+        assert_eq!(fs::read(&complete_path)?,complete);
+        assert_eq!(book.reserved(request,Branch::Receive)?.unwrap().address().to_string(),first);
+        drop(book);
+        // Simulate interruption after allocation rename, before completion.
+        fs::remove_file(&complete_path)?;
+        let mut book=AddressBook::open(&directory.0,account(network,1)?)?;
+        assert_eq!(resume_retention(&journal.0,&chain,&mut book,approved,context)?,receipt);
+        assert_eq!(fs::read(&intent_path)?,intent);assert_eq!(fs::read(&complete_path)?,complete);
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,after);
+        let other=Directory::new()?;let mut other_book=AddressBook::create(&other.0,account(network,2)?)?;
+        assert!(resume_retention(&journal.0,&chain,&mut other_book,approved,context).is_err());
+        let other_chain=HeaderSequence::new(if network==LightNetwork::Litecoin(LtcNetwork::Regtest) {
+            LightNetwork::Bitcoin(BtcNetwork::Regtest)}else {LightNetwork::Litecoin(LtcNetwork::Regtest)})?;
+        assert!(resume_retention(&journal.0,&other_chain,&mut book,approved,context).is_err());
+        // Even a same-count unrelated book is not an exact completed retry.
+        drop(book);
+        let mut altered_book:Value=serde_json::from_slice(&after)?;
+        altered_book["entries"][0]["request"]=json!(Uuid::new_v4());
+        fs::write(directory.0.join("litecoin-address-book.json"),serde_json::to_vec(&altered_book)?)?;
+        let mut book=AddressBook::open(&directory.0,account(network,1)?)?;
+        assert!(resume_retention(&journal.0,&chain,&mut book,approved,context).is_err());
+        drop(book);fs::write(directory.0.join("litecoin-address-book.json"),&after)?;
+        let mut book=AddressBook::open(&directory.0,account(network,1)?)?;
+        book.reserve(Uuid::new_v4(),Branch::Receive)?;
+        let later=fs::read(directory.0.join("litecoin-address-book.json"))?;
+        assert!(resume_retention(&journal.0,&chain,&mut book,approved,context).is_err());
+        assert_eq!(fs::read(directory.0.join("litecoin-address-book.json"))?,later);
+    }
+    Ok(())
+}
