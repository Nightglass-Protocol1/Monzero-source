--- a/swap-machine/src/litecoin_light/script.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/swap-machine/src/litecoin_light/script.rs	2026-10-12 00:05:54.492059699 +0100
@@ -0,0 +1,132 @@
+//! Owned-output locking and signing for each chain's script kind.
+//! SegWit v0 P2WPKH (Litecoin, Bitcoin), P2PKH with the legacy signature hash
+//! (Dogecoin) and P2PKH with the BIP143-style SIGHASH_FORKID hash (Bitcoin Cash).
+//! Every signature commits to all inputs and outputs (SIGHASH_ALL).
+use super::network::ScriptKind;
+use anyhow::{Context, Result, ensure};
+use bitcoin::{CompressedPublicKey, EcdsaSighashType, ScriptBuf, Transaction, TxIn, TxOut, Witness,
+    consensus::Encodable, ecdsa, hashes::{Hash, sha256d}, script::{Builder, Instruction, PushBytesBuf},
+    secp256k1, sighash::SighashCache};
+
+/// Bitcoin Cash replay-protected SIGHASH_ALL | SIGHASH_FORKID with fork id 0.
+const SIGHASH_ALL_FORKID: u8 = 0x41;
+/// Conservative DER signature plus hash-type byte.
+const MAX_SIGNATURE: usize = 73;
+
+/// Locking script controlled by `key`.
+pub fn owned_script(kind: ScriptKind, key: &CompressedPublicKey) -> ScriptBuf {
+    match kind {
+        ScriptKind::WitnessV0 => ScriptBuf::new_p2wpkh(&key.wpubkey_hash()),
+        ScriptKind::P2pkhLegacy | ScriptKind::P2pkhForkId => ScriptBuf::new_p2pkh(&key.pubkey_hash()),
+    }
+}
+
+fn hash_type(kind: ScriptKind) -> u8 {
+    match kind {
+        ScriptKind::WitnessV0 | ScriptKind::P2pkhLegacy => EcdsaSighashType::All as u8,
+        ScriptKind::P2pkhForkId => SIGHASH_ALL_FORKID,
+    }
+}
+
+/// The digest an owned input signs.
+pub fn signature_hash(kind: ScriptKind, transaction: &Transaction, input: usize, prevout: &TxOut) -> Result<[u8; 32]> {
+    ensure!(input < transaction.input.len(), "signature input outside transaction");
+    Ok(match kind {
+        ScriptKind::WitnessV0 => SighashCache::new(transaction)
+            .p2wpkh_signature_hash(input, &prevout.script_pubkey, prevout.value, EcdsaSighashType::All)?.to_byte_array(),
+        ScriptKind::P2pkhLegacy => SighashCache::new(transaction)
+            .legacy_signature_hash(input, &prevout.script_pubkey, EcdsaSighashType::All.to_u32())?.to_byte_array(),
+        ScriptKind::P2pkhForkId => {
+            ensure!(prevout.script_pubkey.is_p2pkh(), "Bitcoin Cash signing requires a P2PKH prevout");
+            bip143_hash(transaction, input, &prevout.script_pubkey, prevout.value.to_sat(), u32::from(SIGHASH_ALL_FORKID))?
+        }
+    })
+}
+
+/// BIP143 signature hash (adopted by Bitcoin Cash with SIGHASH_FORKID). For
+/// P2PKH the scriptCode is the prevout script itself.
+fn bip143_hash(transaction: &Transaction, input: usize, script_code: &bitcoin::Script, value: u64, hash_type: u32)
+    -> Result<[u8; 32]> {
+    let digest = |data: &[u8]| sha256d::Hash::hash(data).to_byte_array();
+    let (mut prevouts, mut sequences, mut outputs) = (Vec::new(), Vec::new(), Vec::new());
+    for txin in &transaction.input {
+        txin.previous_output.consensus_encode(&mut prevouts)?;
+        txin.sequence.consensus_encode(&mut sequences)?;
+    }
+    for txout in &transaction.output { txout.consensus_encode(&mut outputs)?; }
+    let target = &transaction.input[input];
+    let mut preimage = Vec::new();
+    transaction.version.consensus_encode(&mut preimage)?;
+    preimage.extend_from_slice(&digest(&prevouts));
+    preimage.extend_from_slice(&digest(&sequences));
+    target.previous_output.consensus_encode(&mut preimage)?;
+    script_code.to_owned().consensus_encode(&mut preimage)?;
+    value.consensus_encode(&mut preimage)?;
+    target.sequence.consensus_encode(&mut preimage)?;
+    preimage.extend_from_slice(&digest(&outputs));
+    transaction.lock_time.consensus_encode(&mut preimage)?;
+    hash_type.consensus_encode(&mut preimage)?;
+    Ok(digest(&preimage))
+}
+
+/// Attach a signature to an unsigned input in the chain's spending format.
+pub fn finalize_input(kind: ScriptKind, input: &mut TxIn, signature: &secp256k1::ecdsa::Signature,
+    key: &CompressedPublicKey) -> Result<()> {
+    ensure!(input.script_sig.is_empty() && input.witness.is_empty(), "input is already signed");
+    match kind {
+        ScriptKind::WitnessV0 => input.witness = Witness::p2wpkh(
+            &ecdsa::Signature { signature: *signature, sighash_type: EcdsaSighashType::All }, &key.0),
+        ScriptKind::P2pkhLegacy | ScriptKind::P2pkhForkId => {
+            let mut encoded = signature.serialize_der().to_vec();
+            encoded.push(hash_type(kind));
+            input.script_sig = Builder::new().push_slice(PushBytesBuf::try_from(encoded)?)
+                .push_slice(key.to_bytes()).into_script();
+        }
+    }
+    Ok(())
+}
+
+/// Read back (signature, public key) from a signed input, requiring the exact
+/// two-element spending format and SIGHASH_ALL (with FORKID on Bitcoin Cash).
+pub fn signed_parts(kind: ScriptKind, input: &TxIn) -> Result<(secp256k1::ecdsa::Signature, Vec<u8>)> {
+    let items: Vec<Vec<u8>> = match kind {
+        ScriptKind::WitnessV0 => {
+            ensure!(input.script_sig.is_empty(), "unexpected scriptSig on a witness input");
+            input.witness.iter().map(<[u8]>::to_vec).collect()
+        }
+        ScriptKind::P2pkhLegacy | ScriptKind::P2pkhForkId => {
+            ensure!(input.witness.is_empty(), "unexpected witness on a P2PKH input");
+            input.script_sig.instructions().map(|instruction| match instruction? {
+                Instruction::PushBytes(bytes) => Ok(bytes.as_bytes().to_vec()),
+                Instruction::Op(_) => anyhow::bail!("non-push scriptSig"),
+            }).collect::<Result<_>>()?
+        }
+    };
+    ensure!(items.len() == 2, "invalid signed input format");
+    let (flag, signature) = items[0].split_last().context("missing signature")?;
+    ensure!(*flag == hash_type(kind), "unexpected signature hash type");
+    Ok((secp256k1::ecdsa::Signature::from_der(signature)?, items[1].clone()))
+}
+
+/// Replace every input with a maximum-size spend of `kind` for size estimation.
+pub fn size_template(kind: ScriptKind, transaction: &mut Transaction) -> Result<()> {
+    for input in &mut transaction.input {
+        match kind {
+            ScriptKind::WitnessV0 => input.witness = Witness::from_slice(&[vec![0u8; MAX_SIGNATURE], vec![0u8; 33]]),
+            ScriptKind::P2pkhLegacy | ScriptKind::P2pkhForkId => input.script_sig = Builder::new()
+                .push_slice(PushBytesBuf::try_from(vec![0u8; MAX_SIGNATURE])?)
+                .push_slice(PushBytesBuf::try_from(vec![0u8; 33])?).into_script(),
+        }
+    }
+    Ok(())
+}
+
+/// The transaction with all spending data removed.
+pub fn unsigned(transaction: &Transaction) -> Transaction {
+    let mut stripped = transaction.clone();
+    for input in &mut stripped.input { input.witness = Witness::new(); input.script_sig = ScriptBuf::new(); }
+    stripped
+}
