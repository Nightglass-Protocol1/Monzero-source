+//! Script-kind signing checks. The BIP143 implementation used for Bitcoin Cash
+//! is cross-checked against rust-bitcoin's independent P2WPKH digest, which is
+//! the same preimage with hash type 1. Real-node acceptance is covered by the
+//! Bitcoin Cash and Dogecoin end-to-end fixtures.
+use super::*;
+use bitcoin::{Amount, OutPoint, Sequence, Txid, absolute, secp256k1::{Message, Secp256k1, SecretKey}, transaction};
+
+fn key(byte: u8) -> (SecretKey, CompressedPublicKey) {
+    let secret = SecretKey::from_slice(&[byte; 32]).unwrap();
+    let public = CompressedPublicKey(secret.public_key(&Secp256k1::new()));
+    (secret, public)
+}
+fn spend(prevouts: usize) -> Transaction {
+    Transaction { version: transaction::Version::TWO, lock_time: absolute::LockTime::from_consensus(17),
+        input: (0..prevouts).map(|i| TxIn { previous_output: OutPoint { txid: Txid::from_byte_array([i as u8 + 1; 32]), vout: i as u32 },
+            script_sig: ScriptBuf::new(), sequence: Sequence(0xffff_fffe - i as u32), witness: Witness::new() }).collect(),
+        output: vec![TxOut { value: Amount::from_sat(70_000), script_pubkey: ScriptBuf::new_op_return([1, 2, 3]) },
+                     TxOut { value: Amount::from_sat(29_000), script_pubkey: owned_script(ScriptKind::P2pkhForkId, &key(9).1) }] }
+}
+
+#[test]
+fn bip143_matches_rust_bitcoin_p2wpkh_digest_for_hash_type_one() {
+    let (_, public) = key(3);
+    let transaction = spend(3);
+    let witness_prevout = TxOut { value: Amount::from_sat(123_456), script_pubkey: owned_script(ScriptKind::WitnessV0, &public) };
+    let expected = SighashCache::new(&transaction)
+        .p2wpkh_signature_hash(1, &witness_prevout.script_pubkey, witness_prevout.value, EcdsaSighashType::All).unwrap();
+    // BIP143's P2WPKH scriptCode is the P2PKH script of the same key.
+    let script_code = owned_script(ScriptKind::P2pkhLegacy, &public);
+    assert_eq!(bip143_hash(&transaction, 1, &script_code, 123_456, 1).unwrap(), expected.to_byte_array());
+}
+
+#[test]
+fn forkid_digest_differs_only_by_hash_type_and_requires_p2pkh() {
+    let (_, public) = key(4);
+    let transaction = spend(2);
+    let prevout = TxOut { value: Amount::from_sat(99_000), script_pubkey: owned_script(ScriptKind::P2pkhForkId, &public) };
+    let forkid = signature_hash(ScriptKind::P2pkhForkId, &transaction, 0, &prevout).unwrap();
+    assert_eq!(forkid, bip143_hash(&transaction, 0, &prevout.script_pubkey, 99_000, 0x41).unwrap());
+    assert_ne!(forkid, bip143_hash(&transaction, 0, &prevout.script_pubkey, 99_000, 1).unwrap());
+    assert_ne!(forkid, signature_hash(ScriptKind::P2pkhLegacy, &transaction, 0, &prevout).unwrap(), "legacy and FORKID digests must differ");
+    let witness = TxOut { value: prevout.value, script_pubkey: owned_script(ScriptKind::WitnessV0, &public) };
+    assert!(signature_hash(ScriptKind::P2pkhForkId, &transaction, 0, &witness).is_err());
+    assert!(signature_hash(ScriptKind::P2pkhForkId, &transaction, 5, &prevout).is_err());
+}
+
+#[test]
+fn every_kind_round_trips_its_spending_format_and_verifies() {
+    let secp = Secp256k1::new();
+    for kind in [ScriptKind::WitnessV0, ScriptKind::P2pkhLegacy, ScriptKind::P2pkhForkId] {
+        let (secret, public) = key(5);
+        let prevout = TxOut { value: Amount::from_sat(50_000), script_pubkey: owned_script(kind, &public) };
+        let mut transaction = spend(1);
+        let digest = signature_hash(kind, &transaction, 0, &prevout).unwrap();
+        let signature = secp.sign_ecdsa(&Message::from_digest(digest), &secret);
+        finalize_input(kind, &mut transaction.input[0], &signature, &public).unwrap();
+        assert!(finalize_input(kind, &mut transaction.input[0], &signature, &public).is_err(), "double signing");
+        let (read, key_bytes) = signed_parts(kind, &transaction.input[0]).unwrap();
+        assert_eq!((read, key_bytes.as_slice()), (signature, public.to_bytes().as_slice()));
+        // The digest commits to no spending data: signing does not change it.
+        assert_eq!(signature_hash(kind, &transaction, 0, &prevout).unwrap(), digest);
+        secp.verify_ecdsa(&Message::from_digest(digest), &read, &public.0).unwrap();
+        assert_eq!(unsigned(&transaction), spend(1));
+        match kind {
+            ScriptKind::WitnessV0 => assert!(transaction.input[0].script_sig.is_empty() && transaction.input[0].witness.len() == 2),
+            _ => {
+                assert!(transaction.input[0].witness.is_empty());
+                let flag = *transaction.input[0].script_sig.as_bytes()[1..].iter().nth(signature.serialize_der().len()).unwrap();
+                assert_eq!(flag, if kind == ScriptKind::P2pkhForkId { 0x41 } else { 0x01 });
+            }
+        }
+    }
+}
+
+#[test]
+fn signed_parts_rejects_wrong_formats_and_hash_types() {
+    let secp = Secp256k1::new();
+    let (secret, public) = key(6);
+    let mut legacy = spend(1);
+    let prevout = TxOut { value: Amount::from_sat(1), script_pubkey: owned_script(ScriptKind::P2pkhLegacy, &public) };
+    let signature = secp.sign_ecdsa(&Message::from_digest(signature_hash(ScriptKind::P2pkhLegacy, &legacy, 0, &prevout).unwrap()), &secret);
+    finalize_input(ScriptKind::P2pkhLegacy, &mut legacy.input[0], &signature, &public).unwrap();
+    assert!(signed_parts(ScriptKind::P2pkhForkId, &legacy.input[0]).is_err(), "a legacy signature is not a FORKID signature");
+    assert!(signed_parts(ScriptKind::WitnessV0, &legacy.input[0]).is_err());
+    let mut extra = legacy.input[0].clone();
+    extra.script_sig = Builder::from(extra.script_sig.to_bytes()).push_slice([1u8]).into_script();
+    assert!(signed_parts(ScriptKind::P2pkhLegacy, &extra).is_err());
+    let mut opcode = legacy.input[0].clone();
+    opcode.script_sig = Builder::from(opcode.script_sig.to_bytes()).push_opcode(bitcoin::opcodes::all::OP_DROP).into_script();
+    assert!(signed_parts(ScriptKind::P2pkhLegacy, &opcode).is_err());
+}
+
+#[test]
+fn size_templates_cover_maximum_signatures() {
+    let mut witness = spend(2);
+    size_template(ScriptKind::WitnessV0, &mut witness).unwrap();
+    assert!(witness.input.iter().all(|i| i.witness.len() == 2 && i.script_sig.is_empty()));
+    let mut legacy = spend(2);
+    size_template(ScriptKind::P2pkhForkId, &mut legacy).unwrap();
+    // 1-byte push + 73-byte signature + 1-byte push + 33-byte key.
+    assert!(legacy.input.iter().all(|i| i.script_sig.len() == 108 && i.witness.is_empty()));
+    assert!(legacy.vsize() > witness.vsize(), "P2PKH inputs get no witness discount");
+}
