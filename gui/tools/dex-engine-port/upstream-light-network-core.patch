diff --color -ruN a/swap-machine/src/litecoin_light/script/tests.rs b/swap-machine/src/litecoin_light/script/tests.rs
--- a/swap-machine/src/litecoin_light/script/tests.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/swap-machine/src/litecoin_light/script/tests.rs	2026-10-12 00:05:54.492160184 +0100
