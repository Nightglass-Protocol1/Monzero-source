+//! Network identity and Bitcoin consensus vectors. Bitcoin headers are real
+//! mainnet headers (heights 1, 2, 30240, 32255, 32256) copied from public block
+//! data; the 32256 retarget is the first mainnet difficulty change.
+use super::*;
+use crate::litecoin_light::{account::{Branch, PublicAccount}, headers::HeaderSequence};
+use bitcoin::{bip32::Xpriv, consensus::deserialize};
+use swap_core::litecoin_address::LtcSegwitAddress;
+
+const NOW: u64 = 2_000_000_000;
+const BTC_1: &str = "010000006fe28c0ab6f1b372c1a6a246ae63f74f931e8365e15a089c68d6190000000000982051fd1e4ba744bbbe680e1fee14677ba1a3c3540bf7b1cdb606e857233e0e61bc6649ffff001d01e36299";
+const BTC_2: &str = "010000004860eb18bf1b1620e37e9490fc8a427514416fd75159ab86688e9a8300000000d5fdcc541e25de1c7a5addedf24858b8bb665c9f36ef744ee42c316022c90f9bb0bc6649ffff001d08d2bd61";
+const BTC_30240: &str = "01000000e6bf7fd7f7790a63786faa878d0dc7fd8f2ff365732e45862c66075100000000700d342f65c7b6834dffb615358a1897016f0448913372190cbe3d27a4b53355b1512b4bffff001dbfb02519";
+const BTC_32255: &str = "0100000049c1daab3b6536ff1b2633c3a316a6e06ec287676cdeec4ca7baae6b00000000ac10b36b8f354b3353207de15940a5edbc05bb8364af75b4b5409e7823f2b48923ec3a4bffff001dbd5fa412";
+const BTC_32256: &str = "010000004b0360d834a330ec7833e30e1f523ee05a0793361e29a73421964f980000000027b64a020af294e903feed93768705336a20090612a043f47af462a2f5e5b564f8ee3a4b6ad8001dd3a43707";
+
+fn bytes(hex: &str) -> Vec<u8> {
+    (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect()
+}
+fn header(hex: &str) -> Header { deserialize(&bytes(hex)).unwrap() }
+
+const BTC_NETWORKS: [BtcNetwork; 3] = [BtcNetwork::Mainnet, BtcNetwork::Testnet, BtcNetwork::Regtest];
+const LTC_NETWORKS: [LtcNetwork; 3] = [LtcNetwork::Mainnet, LtcNetwork::Testnet, LtcNetwork::Regtest];
+
+#[test]
+fn every_network_builds_its_pinned_genesis() {
+    for network in BTC_NETWORKS.map(LightNetwork::from).into_iter().chain(LTC_NETWORKS.map(LightNetwork::from)) {
+        let chain = HeaderSequence::new(network).unwrap();
+        assert_eq!(chain.height(), 0);
+        assert_eq!(chain.header(0).unwrap().block_hash().to_string(), network.genesis());
+        assert_eq!(chain.network(), network);
+    }
+}
+
+#[test]
+fn litecoin_identity_is_unchanged() {
+    for network in LTC_NETWORKS {
+        let light = LightNetwork::from(network);
+        assert_eq!((light.name(), light.hrp(), light.genesis(), light.tag(), light.coin()),
+            (network.name(), network.hrp(), network.genesis(), "ltc", "Litecoin"));
+        assert!(light == network);
+        assert_eq!(light.coin_type(), if network == LtcNetwork::Mainnet { 2 } else { 1 });
+    }
+}
+
+#[test]
+fn bitcoin_identity() {
+    let main = LightNetwork::from(BtcNetwork::Mainnet);
+    assert_eq!((main.name(), main.hrp(), main.tag(), main.coin(), main.coin_type()), ("main", "bc", "btc", "Bitcoin", 0));
+    assert!(main.is_mainnet() && main.network_kind() == NetworkKind::Main);
+    let test = LightNetwork::from(BtcNetwork::Testnet);
+    assert_eq!((test.name(), test.hrp(), test.coin_type()), ("test", "tb", 1));
+    let regtest = LightNetwork::from(BtcNetwork::Regtest);
+    assert_eq!((regtest.name(), regtest.hrp(), regtest.coin_type()), ("regtest", "bcrt", 1));
+    assert!(!regtest.is_mainnet() && regtest.network_kind() == NetworkKind::Test);
+    // The same deployment name never makes a Bitcoin network equal to Litecoin's.
+    assert!(main != LightNetwork::from(LtcNetwork::Mainnet));
+    assert!(main != LtcNetwork::Mainnet);
+}
+
+#[test]
+fn bitcoin_mainnet_headers_extend_genesis_with_sha256d_work() {
+    let mut chain = HeaderSequence::new(BtcNetwork::Mainnet).unwrap();
+    let genesis_work = chain.chain_work().clone();
+    let first = chain.append(&bytes(BTC_1), NOW).unwrap();
+    assert_eq!(first.to_string(), "00000000839a8e6886ab5951d76f411475428afc90947ee320161bbf18eb6048");
+    let second = chain.append(&bytes(BTC_2), NOW).unwrap();
+    assert_eq!(second.to_string(), "000000006a625f06636b8bb6ac7b960a8d03705d1ace08b1a19da3fdcc99ddbd");
+    assert_eq!(chain.height(), 2);
+    assert_eq!(chain.chain_work(), &(genesis_work * 3u8));
+}
+
+#[test]
+fn bitcoin_headers_are_rejected_when_work_link_or_clock_is_wrong() {
+    let mut chain = HeaderSequence::new(BtcNetwork::Mainnet).unwrap();
+    let mut tampered = bytes(BTC_1);
+    tampered[76] ^= 1;
+    assert!(chain.append(&tampered, NOW).unwrap_err().to_string().contains("insufficient Bitcoin SHA256d work"));
+    assert!(chain.append(&bytes(BTC_2), NOW).unwrap_err().to_string().contains("disconnected Bitcoin header"));
+    assert!(chain.append(&bytes(BTC_1), 1231469665 - 7201).unwrap_err().to_string().contains("too far in future"));
+    // A Litecoin chain never accepts Bitcoin work.
+    let mut litecoin = HeaderSequence::new(LtcNetwork::Mainnet).unwrap();
+    assert!(litecoin.append(&bytes(BTC_1), NOW).is_err());
+    assert_eq!((chain.height(), litecoin.height()), (0, 0));
+}
+
+#[test]
+fn bitcoin_first_mainnet_retarget_matches_block_32256() {
+    let network = LightNetwork::from(BtcNetwork::Mainnet);
+    let mut history = vec![header(BTC_32255); 32256];
+    history[30240] = header(BTC_30240);
+    let expected = header(BTC_32256);
+    assert_eq!(network.next_bits(&history, expected.time).unwrap(), expected.bits.to_consensus());
+    assert_eq!(expected.bits.to_consensus(), 0x1d00d86a);
+    // Inside an interval mainnet keeps the previous difficulty.
+    assert_eq!(network.next_bits(&history[..32255], expected.time).unwrap(), 0x1d00ffff);
+}
+
+#[test]
+fn bitcoin_difficulty_limits_and_test_network_rules() {
+    let main = LightNetwork::from(BtcNetwork::Mainnet);
+    assert_eq!(main.limit(), (BigUint::from(1u8) << 224usize) - BigUint::from(1u8));
+    assert_eq!(main.target(0x1d00ffff).unwrap(), BigUint::from(0xffffu32) << 208usize);
+    assert!(main.target(0x1e00ffff).is_err());
+    // testnet3: a block more than 20 minutes after its parent may use the minimum difficulty.
+    let test = LightNetwork::from(BtcNetwork::Testnet);
+    let mut parent = header(BTC_32255);
+    parent.bits = CompactTarget::from_consensus(0x1c0fffff);
+    let history = vec![parent; 5];
+    assert_eq!(test.next_bits(&history, parent.time + 1201).unwrap(), 0x1d00ffff);
+    assert_eq!(test.next_bits(&history, parent.time + 1200).unwrap(), 0x1c0fffff);
+    // regtest never retargets.
+    let regtest = LightNetwork::from(BtcNetwork::Regtest);
+    let mut easy = header(BTC_32255);
+    easy.bits = CompactTarget::from_consensus(0x207fffff);
+    assert_eq!(regtest.next_bits(&vec![easy; 2016], easy.time + 1).unwrap(), 0x207fffff);
+}
+
+#[test]
+fn bitcoin_header_versions_follow_activation_heights() {
+    let main = LightNetwork::from(BtcNetwork::Mainnet);
+    assert!(main.check_version(227930, 1).is_ok());
+    assert!(main.check_version(227931, 1).is_err());
+    assert!(main.check_version(388381, 3).is_err());
+    assert!(main.check_version(388381, 4).is_ok());
+    // No Litecoin-style SegWit version floor on Bitcoin.
+    assert!(main.check_version(800000, 4).is_ok());
+    assert!(LightNetwork::from(LtcNetwork::Mainnet).check_version(1201536, 4).is_err());
+}
