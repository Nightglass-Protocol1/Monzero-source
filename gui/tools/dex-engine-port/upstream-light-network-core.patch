diff --color -ruN a/swap-machine/src/litecoin_light/network.rs b/swap-machine/src/litecoin_light/network.rs
--- a/swap-machine/src/litecoin_light/network.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/swap-machine/src/litecoin_light/network.rs	2026-10-12 00:05:54.491933045 +0100
@@ -0,0 +1,509 @@
+//! Chain identity and header consensus rules for the shared UTXO light wallet.
+//! Litecoin rules are pinned to Core v0.21.5.8 and unchanged from the original
+//! Litecoin-only implementation. Bitcoin rules follow Bitcoin Core's
+//! `GetNextWorkRequired`/`CalculateNextWorkRequired` and contextual header checks.
+//! A network value names both the chain and its deployment, so a Bitcoin chain,
+//! vault or session can never be mistaken for a Litecoin one at runtime.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{BlockHash, CompactTarget, NetworkKind, ScriptBuf, TxMerkleNode, WitnessProgram, WitnessVersion,
+    bech32::{Hrp, segwit}, block::{Header, Version}, hashes::Hash};
+use num_bigint::BigUint;
+use std::fmt;
+use swap_core::litecoin_address::LtcNetwork;
+
+/// Bitcoin deployments. Testnet is testnet3 (testnet4 uses BIP94 rules not implemented here).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BtcNetwork { Mainnet, Testnet, Regtest }
+/// Bitcoin Cash deployments. Only regtest header rules are implemented: mainnet
+/// and testnet need a post-fork checkpoint and ASERT, and are refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BchNetwork { Mainnet, Testnet, Regtest }
+/// Dogecoin deployments. Only regtest header rules are implemented: mainnet and
+/// testnet need DigiShield, AuxPoW and checkpoints, and are refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DogeNetwork { Mainnet, Testnet, Regtest }
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LightNetwork { Litecoin(LtcNetwork), Bitcoin(BtcNetwork), BitcoinCash(BchNetwork), Dogecoin(DogeNetwork) }
+
+/// How owned outputs are locked and signed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ScriptKind {
+    /// Native SegWit v0 P2WPKH under BIP84 (Litecoin, Bitcoin).
+    WitnessV0,
+    /// P2PKH under BIP44 with the pre-SegWit signature hash (Dogecoin).
+    P2pkhLegacy,
+    /// P2PKH under BIP44 with the BIP143-style SIGHASH_FORKID hash (Bitcoin Cash).
+    P2pkhForkId,
+}
+
+impl From<LtcNetwork> for LightNetwork { fn from(network: LtcNetwork) -> Self { Self::Litecoin(network) } }
+impl From<BtcNetwork> for LightNetwork { fn from(network: BtcNetwork) -> Self { Self::Bitcoin(network) } }
+impl From<BchNetwork> for LightNetwork { fn from(network: BchNetwork) -> Self { Self::BitcoinCash(network) } }
+impl From<DogeNetwork> for LightNetwork { fn from(network: DogeNetwork) -> Self { Self::Dogecoin(network) } }
+impl PartialEq<LtcNetwork> for LightNetwork {
+    fn eq(&self, other: &LtcNetwork) -> bool { *self == Self::Litecoin(*other) }
+}
+
+impl LightNetwork {
+    /// Human chain name, for messages only.
+    pub fn coin(self) -> &'static str {
+        match self { Self::Litecoin(_) => "Litecoin", Self::Bitcoin(_) => "Bitcoin",
+            Self::BitcoinCash(_) => "Bitcoin Cash", Self::Dogecoin(_) => "Dogecoin" }
+    }
+    /// Short tag used in persisted schema names (`monzero-ltc-…`, `monzero-btc-…`).
+    pub fn tag(self) -> &'static str {
+        match self { Self::Litecoin(_) => "ltc", Self::Bitcoin(_) => "btc", Self::BitcoinCash(_) => "bch", Self::Dogecoin(_) => "doge" }
+    }
+    /// Deployment name as reported by the chain's Core node (`getblockchaininfo.chain`).
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Litecoin(network) => network.name(),
+            Self::Bitcoin(BtcNetwork::Mainnet) | Self::BitcoinCash(BchNetwork::Mainnet) | Self::Dogecoin(DogeNetwork::Mainnet) => "main",
+            Self::Bitcoin(BtcNetwork::Testnet) | Self::BitcoinCash(BchNetwork::Testnet) | Self::Dogecoin(DogeNetwork::Testnet) => "test",
+            Self::Bitcoin(BtcNetwork::Regtest) | Self::BitcoinCash(BchNetwork::Regtest) | Self::Dogecoin(DogeNetwork::Regtest) => "regtest",
+        }
+    }
+    /// Bech32 human-readable part; empty for chains without SegWit addresses.
+    pub fn hrp(self) -> &'static str {
+        match self {
+            Self::Litecoin(network) => network.hrp(),
+            Self::Bitcoin(BtcNetwork::Mainnet) => "bc",
+            Self::Bitcoin(BtcNetwork::Testnet) => "tb",
+            Self::Bitcoin(BtcNetwork::Regtest) => "bcrt",
+            Self::BitcoinCash(_) | Self::Dogecoin(_) => "",
+        }
+    }
+    pub fn genesis(self) -> &'static str {
+        match self {
+            Self::Litecoin(network) => network.genesis(),
+            // Bitcoin Cash shares Bitcoin's genesis blocks.
+            Self::Bitcoin(BtcNetwork::Mainnet) | Self::BitcoinCash(BchNetwork::Mainnet) => "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f",
+            Self::Bitcoin(BtcNetwork::Testnet) | Self::BitcoinCash(BchNetwork::Testnet) => "000000000933ea01ad0ee984209779baaec3ced90fa3f408719526f8d77f4943",
+            Self::Bitcoin(BtcNetwork::Regtest) | Self::BitcoinCash(BchNetwork::Regtest) => "0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206",
+            Self::Dogecoin(DogeNetwork::Mainnet) => "1a91e3dace36e2be3bf030a65679fe821aa1d6ef92e7c9902eb318182c355691",
+            Self::Dogecoin(DogeNetwork::Testnet) => "bb0a78264637406b6360aad926284d544d7049f45189db5664f3c4d07350559e",
+            Self::Dogecoin(DogeNetwork::Regtest) => "3d2160a3b5dc4a9d62e7e66a295f70313ac808440ef7400d6c0772171ce973a5",
+        }
+    }
+    /// 64-character identity binding persisted wallet records to one chain and
+    /// deployment. Equal to the genesis hash except for Bitcoin Cash, whose
+    /// genesis is Bitcoin's; Litecoin and Bitcoin records are unchanged.
+    pub fn storage_identity(self) -> String {
+        match self {
+            Self::BitcoinCash(_) => {
+                let tagged = format!("monzero-bch-light-identity-v1:{}", self.genesis());
+                bitcoin::hashes::sha256::Hash::hash(tagged.as_bytes()).to_string()
+            }
+            _ => self.genesis().to_string(),
+        }
+    }
+    pub fn is_mainnet(self) -> bool {
+        matches!(self, Self::Litecoin(LtcNetwork::Mainnet) | Self::Bitcoin(BtcNetwork::Mainnet)
+            | Self::BitcoinCash(BchNetwork::Mainnet) | Self::Dogecoin(DogeNetwork::Mainnet))
+    }
+    /// BIP32 key version family: test networks share testnet key prefixes.
+    pub fn network_kind(self) -> NetworkKind {
+        if self.is_mainnet() { NetworkKind::Main } else { NetworkKind::Test }
+    }
+    /// SLIP-44 coin type for account paths; every test network uses 1.
+    pub fn coin_type(self) -> u32 {
+        match self {
+            Self::Litecoin(LtcNetwork::Mainnet) => 2,
+            Self::Bitcoin(BtcNetwork::Mainnet) => 0,
+            Self::BitcoinCash(BchNetwork::Mainnet) => 145,
+            Self::Dogecoin(DogeNetwork::Mainnet) => 3,
+            _ => 1,
+        }
+    }
+    pub fn script_kind(self) -> ScriptKind {
+        match self {
+            Self::Litecoin(_) | Self::Bitcoin(_) => ScriptKind::WitnessV0,
+            Self::BitcoinCash(_) => ScriptKind::P2pkhForkId,
+            Self::Dogecoin(_) => ScriptKind::P2pkhLegacy,
+        }
+    }
+    /// BIP43 purpose: 84 for native SegWit accounts, 44 for P2PKH accounts.
+    pub fn purpose(self) -> u32 {
+        if self.script_kind() == ScriptKind::WitnessV0 { 84 } else { 44 }
+    }
+    /// Header consensus rules implemented for this deployment. Refusing is
+    /// safer than accepting headers under rules that were never checked.
+    pub(super) fn ensure_header_rules(self) -> Result<()> {
+        ensure!(!matches!(self, Self::BitcoinCash(BchNetwork::Mainnet | BchNetwork::Testnet)),
+            "Bitcoin Cash {} header validation needs a post-fork checkpoint and ASERT, which are not implemented", self.name());
+        ensure!(!matches!(self, Self::Dogecoin(DogeNetwork::Mainnet | DogeNetwork::Testnet)),
+            "Dogecoin {} header validation needs DigiShield, AuxPoW and checkpoints, which are not implemented", self.name());
+        Ok(())
+    }
+
+    pub(super) fn genesis_header(self) -> Result<Header> {
+        self.ensure_header_rules()?;
+        let (merkle, time, nonce, bits) = match self {
+            Self::Litecoin(network) => {
+                let (time, nonce, bits) = match network {
+                    LtcNetwork::Mainnet => (1317972665, 2084524493, 0x1e0ffff0),
+                    LtcNetwork::Testnet => (1486949366, 293345, 0x1e0ffff0),
+                    LtcNetwork::Regtest => (1296688602, 0, 0x207fffff),
+                };
+                ("97ddfbbae6be97fd6cdf3e7ca13232a3afff2353e29badfab7f73011edd4ced9", time, nonce, bits)
+            }
+            Self::Bitcoin(network) => {
+                let (time, nonce, bits) = match network {
+                    BtcNetwork::Mainnet => (1231006505, 2083236893, 0x1d00ffff),
+                    BtcNetwork::Testnet => (1296688602, 414098458, 0x1d00ffff),
+                    BtcNetwork::Regtest => (1296688602, 2, 0x207fffff),
+                };
+                ("4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b", time, nonce, bits)
+            }
+            Self::BitcoinCash(network) => {
+                let (time, nonce, bits) = match network {
+                    BchNetwork::Mainnet => (1231006505, 2083236893, 0x1d00ffff),
+                    BchNetwork::Testnet => (1296688602, 414098458, 0x1d00ffff),
+                    BchNetwork::Regtest => (1296688602, 2, 0x207fffff),
+                };
+                ("4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b", time, nonce, bits)
+            }
+            Self::Dogecoin(network) => {
+                let (time, nonce, bits) = match network {
+                    DogeNetwork::Mainnet => (1386325540, 99943, 0x1e0ffff0),
+                    DogeNetwork::Testnet => (1391503289, 997879, 0x1e0ffff0),
+                    DogeNetwork::Regtest => (1296688602, 2, 0x207fffff),
+                };
+                ("5b2a3f53f605d62c53e62932dac6925e3d74afa5a4b459745c36d42d0ed26a69", time, nonce, bits)
+            }
+        };
+        let genesis = Header { version: Version::from_consensus(1), prev_blockhash: BlockHash::all_zeros(),
+            merkle_root: merkle.parse::<TxMerkleNode>()?, time,
+            bits: CompactTarget::from_consensus(bits), nonce };
+        ensure!(genesis.block_hash().to_string() == self.genesis(), "{} genesis constants changed", self.coin());
+        Ok(genesis)
+    }
+
+    /// Proof-of-work value of a serialized header, little-endian as compared with targets.
+    pub(super) fn pow_value(self, header: &[u8]) -> Result<BigUint> {
+        ensure!(header.len() == 80, "invalid {} header length", self.coin());
+        Ok(match self {
+            Self::Litecoin(_) | Self::Dogecoin(_) => BigUint::from_bytes_le(&scrypt_hash(header)?),
+            Self::Bitcoin(_) | Self::BitcoinCash(_) =>
+                BigUint::from_bytes_le(&bitcoin::hashes::sha256d::Hash::hash(header).to_byte_array()),
+        })
+    }
+
+    pub(super) fn limit(self) -> BigUint {
+        let bits = match self {
+            Self::Litecoin(LtcNetwork::Regtest) | Self::Bitcoin(BtcNetwork::Regtest)
+                | Self::BitcoinCash(BchNetwork::Regtest) | Self::Dogecoin(DogeNetwork::Regtest) => 255,
+            Self::Litecoin(_) | Self::Dogecoin(_) => 236,
+            Self::Bitcoin(_) | Self::BitcoinCash(_) => 224,
+        };
+        (BigUint::from(1u8) << bits) - BigUint::from(1u8)
+    }
+
+    pub(super) fn target(self, bits: u32) -> Result<BigUint> {
+        let size = bits >> 24; let word = bits & 0x007fffff;
+        ensure!(bits & 0x00800000 == 0 && word != 0 && size <= 34
+            && !(word > 0xff && size > 33) && !(word > 0xffff && size > 32), "invalid {} compact target", self.coin());
+        let value = if size <= 3 { BigUint::from(word >> (8 * (3 - size))) }
+            else { BigUint::from(word) << (8 * (size - 3)) as usize };
+        ensure!(value != BigUint::from(0u8) && value <= self.limit(), "{} target outside network limit", self.coin());
+        Ok(value)
+    }
+
+    pub(super) fn next_bits(self, headers: &[Header], time: u32) -> Result<u32> {
+        self.ensure_header_rules()?;
+        let previous = headers.last().context("missing difficulty history")?;
+        // Implemented Bitcoin Cash and Dogecoin deployments are regtest only, where
+        // every block keeps the minimum difficulty and nodes never retarget.
+        if matches!(self, Self::BitcoinCash(_) | Self::Dogecoin(_)) { return Ok(previous.bits.to_consensus()) }
+        let height = headers.len();
+        let easiest = compact(&self.limit());
+        // Minimum-difficulty blocks on test networks: twice the target spacing.
+        let (min_difficulty_gap, timespan) = match self {
+            Self::Litecoin(_) => (300, 302400),
+            _ => (1200, 1209600),
+        };
+        if height % 2016 != 0 {
+            if !self.is_mainnet() {
+                if u64::from(time) > u64::from(previous.time) + min_difficulty_gap { return Ok(easiest) }
+                let mut index = height - 1;
+                while index > 0 && index % 2016 != 0 && headers[index].bits.to_consensus() == easiest { index -= 1; }
+                return Ok(headers[index].bits.to_consensus())
+            }
+            return Ok(previous.bits.to_consensus())
+        }
+        if matches!(self, Self::Litecoin(LtcNetwork::Regtest) | Self::Bitcoin(BtcNetwork::Regtest)) {
+            return Ok(previous.bits.to_consensus())
+        }
+        let first = match self {
+            // Litecoin uses an extra ancestor after the first adjustment interval.
+            Self::Litecoin(_) => if height == 2016 { 0 } else { height - 2017 },
+            _ => height - 2016,
+        };
+        let elapsed = i64::from(previous.time) - i64::from(headers[first].time);
+        self.retarget(previous.bits.to_consensus(), elapsed, timespan)
+    }
+
+    pub(super) fn retarget(self, bits: u32, elapsed: i64, timespan: u64) -> Result<u32> {
+        let mut value = self.target(bits)?;
+        let limit = self.limit();
+        let clamped = elapsed.clamp(timespan as i64 / 4, timespan as i64 * 4) as u64;
+        // Litecoin Core shifts once to avoid 256-bit overflow; Bitcoin Core does not.
+        let shift = matches!(self, Self::Litecoin(_)) && value.bits() > limit.bits() - 1;
+        if shift { value >>= 1usize; }
+        value *= clamped;
+        value /= timespan;
+        if shift { value <<= 1usize; }
+        Ok(compact(&value.min(limit)))
+    }
+
+    pub(super) fn check_version(self, height: u32, version: i32) -> Result<()> {
+        let (version, bip34, bip66, bip65, segwit_version) = match self {
+            // BCHN regtest: BIP34 inactive, BIP66 at 1251, BIP65 at 1351.
+            Self::BitcoinCash(_) => (version, u32::MAX, 1251, 1351, None),
+            // Dogecoin encodes its AuxPoW chain ID (0x62) above the base version.
+            Self::Dogecoin(_) => {
+                ensure!(version & 0x100 == 0, "Dogecoin AuxPoW headers are not supported");
+                ensure!(version < 0x100 || version >> 16 == 0x62, "wrong Dogecoin AuxPoW chain ID");
+                (version & 0xff, u32::MAX, 1251, 1351, None)
+            }
+            _ => { let (a, b, c, d) = self.activation_heights(); (version, a, b, c, d) }
+        };
+        ensure!(!(height >= bip34 && version < 2) && !(height >= bip66 && version < 3)
+            && !(height >= bip65 && version < 4)
+            && !segwit_version.is_some_and(|segwit| height >= segwit && version < 0x20000000),
+            "outdated {} header version", self.coin());
+        Ok(())
+    }
+
+    fn activation_heights(self) -> (u32, u32, u32, Option<u32>) {
+        match self {
+            Self::Litecoin(LtcNetwork::Mainnet) => (710000, 811879, 918684, Some(1201536)),
+            Self::Litecoin(LtcNetwork::Testnet) => (76, 76, 76, Some(6048)),
+            Self::Litecoin(LtcNetwork::Regtest) => (500, 1251, 1351, Some(0)),
+            Self::Bitcoin(BtcNetwork::Mainnet) => (227931, 363725, 388381, None),
+            Self::Bitcoin(BtcNetwork::Testnet) => (21111, 330776, 581885, None),
+            Self::Bitcoin(BtcNetwork::Regtest) => (1, 1, 1, None),
+            Self::BitcoinCash(_) | Self::Dogecoin(_) => (u32::MAX, u32::MAX, u32::MAX, None),
+        }
+    }
+}
+
+pub(super) fn compact(value: &BigUint) -> u32 {
+    let mut size = value.bits().div_ceil(8) as u32;
+    let shifted = if size <= 3 { value << (8 * (3 - size)) as usize } else { value >> (8 * (size - 3)) as usize };
+    let mut word = shifted.to_bytes_be().iter().fold(0u32, |word, byte| (word << 8) | u32::from(*byte));
+    if word & 0x00800000 != 0 { word >>= 8; size += 1; }
+    word | (size << 24)
+}
+
+pub(super) fn block_work(target: &BigUint) -> BigUint {
+    (BigUint::from(1u8) << 256usize) / (target + BigUint::from(1u8))
+}
+
+/// Fixed Litecoin N=1024, r=1, p=1, 32-byte output. Never Bitcoin SHA256d work.
+pub(super) fn scrypt_hash(header: &[u8]) -> Result<[u8; 32]> {
+    ensure!(header.len() == 80, "invalid Scrypt header length");
+    let params = scrypt::Params::new(10, 1, 1, 32).map_err(|_| anyhow::anyhow!("invalid Litecoin Scrypt parameters"))?;
+    let mut output = [0; 32];
+    scrypt::scrypt(header, header, &params, &mut output).map_err(|_| anyhow::anyhow!("Litecoin Scrypt failed"))?;
+    Ok(output)
+}
+
+/// Native-SegWit destination for any light-wallet chain: P2WPKH, P2WSH and P2TR.
+/// Encoding is identical to `LtcSegwitAddress` for Litecoin networks.
+/// Parsing does not establish wallet ownership, chain activation or fee policy.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SegwitAddress {
+    network: LightNetwork,
+    encoded: String,
+    script: ScriptBuf,
+}
+
+impl SegwitAddress {
+    pub fn parse(network: impl Into<LightNetwork>, value: &str) -> Result<Self> {
+        let network = network.into();
+        ensure!(network.script_kind() == ScriptKind::WitnessV0, "{} has no SegWit addresses", network.coin());
+        ensure!(value.len() <= 90, "{} address too long", network.coin());
+        let (hrp, version, program) = segwit::decode(value)
+            .with_context(|| format!("invalid {} SegWit address", network.coin()))?;
+        ensure!(hrp == Hrp::parse(network.hrp())?, "wrong {} address network", network.coin());
+        let version = match version.to_u8() {
+            0 => WitnessVersion::V0,
+            1 if program.len() == 32 => WitnessVersion::V1,
+            _ => anyhow::bail!("unsupported {} witness program", network.coin()),
+        };
+        let script = ScriptBuf::new_witness_program(&WitnessProgram::new(version, &program)?);
+        let address = Self::from_script(network, &script)?;
+        ensure!(address.encoded == value, "noncanonical {} address", network.coin());
+        Ok(address)
+    }
+
+    pub fn from_script(network: impl Into<LightNetwork>, script: &ScriptBuf) -> Result<Self> {
+        let network = network.into();
+        ensure!(network.script_kind() == ScriptKind::WitnessV0, "{} has no SegWit addresses", network.coin());
+        ensure!(script.is_p2wpkh() || script.is_p2wsh() || script.is_p2tr(),
+            "unsupported {} destination script", network.coin());
+        let hrp = Hrp::parse(network.hrp())?;
+        let program = &script.as_bytes()[2..];
+        let encoded = if script.is_p2tr() { segwit::encode_v1(hrp, program)? }
+            else { segwit::encode_v0(hrp, program)? };
+        Ok(Self { network, encoded, script: script.clone() })
+    }
+
+    pub fn network(&self) -> LightNetwork { self.network }
+    pub fn script_pubkey(&self) -> &ScriptBuf { &self.script }
+}
+
+impl fmt::Display for SegwitAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str(&self.encoded) }
+}
+
+/// P2PKH/P2SH destination for chains without SegWit: CashAddr for Bitcoin Cash
+/// (canonical lowercase with prefix), Base58Check for Dogecoin.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct LegacyAddress {
+    network: LightNetwork,
+    encoded: String,
+    script: ScriptBuf,
+}
+
+const CASHADDR_CHARSET: &[u8; 32] = b"qpzry9x8gf2tvdw0s3jn54khce6mua7l";
+
+fn cashaddr_prefix(network: LightNetwork) -> Option<&'static str> {
+    match network {
+        LightNetwork::BitcoinCash(BchNetwork::Mainnet) => Some("bitcoincash"),
+        LightNetwork::BitcoinCash(BchNetwork::Testnet) => Some("bchtest"),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest) => Some("bchreg"),
+        _ => None,
+    }
+}
+/// Base58Check version bytes (P2PKH, P2SH).
+fn base58_versions(network: LightNetwork) -> Option<(u8, u8)> {
+    match network {
+        LightNetwork::Dogecoin(DogeNetwork::Mainnet) => Some((30, 22)),
+        LightNetwork::Dogecoin(DogeNetwork::Testnet) => Some((113, 196)),
+        LightNetwork::Dogecoin(DogeNetwork::Regtest) => Some((111, 196)),
+        _ => None,
+    }
+}
+fn cashaddr_polymod(values: &[u8]) -> u64 {
+    let mut c: u64 = 1;
+    for value in values {
+        let c0 = (c >> 35) as u8;
+        c = ((c & 0x07_ffff_ffff) << 5) ^ u64::from(*value);
+        for (bit, generator) in [0x98f2bc8e61u64, 0x79b76d99e2, 0xf33e5fb3c4, 0xae2eabe2a8, 0x1e4f43e470].iter().enumerate() {
+            if c0 & (1 << bit) != 0 { c ^= generator; }
+        }
+    }
+    c ^ 1
+}
+fn convert_bits(data: &[u8], from: u32, to: u32, pad: bool) -> Result<Vec<u8>> {
+    let (mut acc, mut bits, mut out) = (0u32, 0u32, Vec::new());
+    let maximum = (1u32 << to) - 1;
+    for value in data {
+        ensure!(u32::from(*value) >> from == 0, "invalid CashAddr data");
+        acc = (acc << from) | u32::from(*value); bits += from;
+        while bits >= to { bits -= to; out.push(((acc >> bits) & maximum) as u8); }
+    }
+    if pad { if bits > 0 { out.push(((acc << (to - bits)) & maximum) as u8); } }
+    else { ensure!(bits < from && (acc << (to - bits)) & maximum == 0, "invalid CashAddr padding"); }
+    Ok(out)
+}
+fn cashaddr_encode(prefix: &str, version: u8, hash: &[u8; 20]) -> Result<String> {
+    let mut payload = vec![version]; payload.extend_from_slice(hash);
+    let data = convert_bits(&payload, 8, 5, true)?;
+    let mut checked: Vec<u8> = prefix.bytes().map(|b| b & 0x1f).collect();
+    checked.push(0); checked.extend_from_slice(&data); checked.extend_from_slice(&[0; 8]);
+    let checksum = cashaddr_polymod(&checked);
+    let mut encoded = format!("{prefix}:");
+    for value in data.iter().copied().chain((0..8).map(|i| ((checksum >> (5 * (7 - i))) & 0x1f) as u8)) {
+        encoded.push(CASHADDR_CHARSET[value as usize] as char);
+    }
+    Ok(encoded)
+}
+fn cashaddr_decode(prefix: &str, value: &str) -> Result<(u8, [u8; 20])> {
+    let body = value.strip_prefix(prefix).and_then(|rest| rest.strip_prefix(':')).context("wrong CashAddr prefix")?;
+    let data: Vec<u8> = body.bytes().map(|b| CASHADDR_CHARSET.iter().position(|c| *c == b).map(|i| i as u8))
+        .collect::<Option<_>>().context("invalid CashAddr character")?;
+    ensure!(data.len() == 42, "unsupported CashAddr length");
+    let mut checked: Vec<u8> = prefix.bytes().map(|b| b & 0x1f).collect();
+    checked.push(0); checked.extend_from_slice(&data);
+    ensure!(cashaddr_polymod(&checked) == 0, "invalid CashAddr checksum");
+    let payload = convert_bits(&data[..34], 5, 8, false)?;
+    ensure!(payload.len() == 21, "invalid CashAddr payload");
+    Ok((payload[0], payload[1..].try_into()?))
+}
+
+impl LegacyAddress {
+    pub fn from_script(network: impl Into<LightNetwork>, script: &ScriptBuf) -> Result<Self> {
+        let network = network.into();
+        ensure!(network.script_kind() != ScriptKind::WitnessV0, "{} uses SegWit addresses", network.coin());
+        let bytes = script.as_bytes();
+        let (p2sh, hash): (bool, [u8; 20]) = if script.is_p2pkh() { (false, bytes[3..23].try_into()?) }
+            else if script.is_p2sh() { (true, bytes[2..22].try_into()?) }
+            else { anyhow::bail!("unsupported {} destination script", network.coin()) };
+        let encoded = if let Some(prefix) = cashaddr_prefix(network) {
+            cashaddr_encode(prefix, if p2sh { 8 } else { 0 }, &hash)?
+        } else {
+            let (pubkey, scripthash) = base58_versions(network).context("missing address versions")?;
+            let mut data = vec![if p2sh { scripthash } else { pubkey }]; data.extend_from_slice(&hash);
+            bitcoin::base58::encode_check(&data)
+        };
+        Ok(Self { network, encoded, script: script.clone() })
+    }
+    pub fn parse(network: impl Into<LightNetwork>, value: &str) -> Result<Self> {
+        let network = network.into();
+        ensure!(value.len() <= 120, "{} address too long", network.coin());
+        let (p2sh, hash) = if let Some(prefix) = cashaddr_prefix(network) {
+            let (version, hash) = cashaddr_decode(prefix, value)?;
+            ensure!(version == 0 || version == 8, "unsupported Bitcoin Cash address type");
+            (version == 8, hash)
+        } else {
+            let (pubkey, scripthash) = base58_versions(network).with_context(|| format!("{} uses SegWit addresses", network.coin()))?;
+            let data = bitcoin::base58::decode_check(value).with_context(|| format!("invalid {} address", network.coin()))?;
+            ensure!(data.len() == 21 && (data[0] == pubkey || data[0] == scripthash), "wrong {} address network", network.coin());
+            (data[0] == scripthash, data[1..].try_into()?)
+        };
+        let script = if p2sh { ScriptBuf::new_p2sh(&bitcoin::ScriptHash::from_byte_array(hash)) }
+            else { ScriptBuf::new_p2pkh(&bitcoin::PubkeyHash::from_byte_array(hash)) };
+        let address = Self::from_script(network, &script)?;
+        ensure!(address.encoded == value, "noncanonical {} address", network.coin());
+        Ok(address)
+    }
+    pub fn network(&self) -> LightNetwork { self.network }
+    pub fn script_pubkey(&self) -> &ScriptBuf { &self.script }
+}
+impl fmt::Display for LegacyAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str(&self.encoded) }
+}
+
+/// The destination format a light-wallet chain uses.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum LightAddress { Segwit(SegwitAddress), Legacy(LegacyAddress) }
+impl LightAddress {
+    pub fn parse(network: impl Into<LightNetwork>, value: &str) -> Result<Self> {
+        let network = network.into();
+        Ok(if network.script_kind() == ScriptKind::WitnessV0 { Self::Segwit(SegwitAddress::parse(network, value)?) }
+            else { Self::Legacy(LegacyAddress::parse(network, value)?) })
+    }
+    pub fn from_script(network: impl Into<LightNetwork>, script: &ScriptBuf) -> Result<Self> {
+        let network = network.into();
+        Ok(if network.script_kind() == ScriptKind::WitnessV0 { Self::Segwit(SegwitAddress::from_script(network, script)?) }
+            else { Self::Legacy(LegacyAddress::from_script(network, script)?) })
+    }
+    pub fn network(&self) -> LightNetwork {
+        match self { Self::Segwit(address) => address.network(), Self::Legacy(address) => address.network() }
+    }
+    pub fn script_pubkey(&self) -> &ScriptBuf {
+        match self { Self::Segwit(address) => address.script_pubkey(), Self::Legacy(address) => address.script_pubkey() }
+    }
+}
+impl fmt::Display for LightAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self { Self::Segwit(address) => address.fmt(f), Self::Legacy(address) => address.fmt(f) }
+    }
+}
