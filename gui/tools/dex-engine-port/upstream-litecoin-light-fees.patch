+//! Untrusted server fee estimates, never approval or a confirmation guarantee.
+//! Electrum reports coin units per kilobyte; retain a rounded-up atomic rate.
+use super::*;
+use bitcoin::{Amount,Transaction,Witness};
+
+pub struct ReportedFeeRate {target:u16,atomic_per_kvb:u64}
+impl ReportedFeeRate {
+    pub fn target_blocks(&self)->u16 {self.target}
+    pub fn atomic_per_kvb(&self)->u64 {self.atomic_per_kvb}
+    /// Conservative virtual size assuming every input is native P2WPKH with a
+    /// maximum 73-byte DER+hashtype signature and a 33-byte compressed key.
+    /// The caller must verify input types and review the resulting absolute fee.
+    /// No MWEB, legacy or arbitrary-script input estimate is supported here.
+    pub fn p2wpkh_fee(&self,unsigned:&Transaction,maximum_fee:Amount)->Result<(u64,Amount)> {
+        ensure!(!unsigned.input.is_empty() && unsigned.input.len()<=1000
+            && !unsigned.output.is_empty() && unsigned.output.len()<=1000
+            && unsigned.output.iter().all(|out|out.script_pubkey.len()<=10000)
+            && unsigned.input.iter().all(|input|!input.previous_output.is_null()
+                && input.script_sig.is_empty() && input.witness.is_empty()),"invalid Litecoin fee template");
+        let mut template=unsigned.clone();
+        for input in &mut template.input {input.witness=Witness::from_slice(&[vec![0u8;73],vec![0u8;33]]);}
+        let virtual_bytes=template.vsize() as u64;
+        let fee=(u128::from(self.atomic_per_kvb)*u128::from(virtual_bytes)).div_ceil(1000);
+        ensure!(fee<=u128::from(maximum_fee.to_sat()),"Litecoin estimated fee exceeds maximum");
+        Ok((virtual_bytes,Amount::from_sat(u64::try_from(fee)?)))
+    }
+}
+// Parse the JSON number's original decimal/exponent spelling without binary
+// floating-point amount conversion. Round fractional atomic rates upward.
+fn parse_rate(raw:&str,maximum:u64)->Result<Option<u64>> {
+    let raw=raw.trim();ensure!(raw.len()<=128,"oversized Litecoin fee rate");
+    let _:serde_json::Number=serde_json::from_str(raw)?;
+    if raw=="-1" {return Ok(None)}
+    ensure!(!raw.starts_with('-'),"negative Litecoin fee rate");
+    let (mantissa,exponent)=if let Some(index)=raw.find(['e','E']) {
+        (&raw[..index],raw[index+1..].parse::<i32>()?)
+    } else {(raw,0)};
+    ensure!((-1000..=1000).contains(&exponent),"Litecoin fee exponent exceeds limit");
+    let decimals=mantissa.split_once('.').map(|(_,fraction)|fraction.len()).unwrap_or(0);
+    let digits=mantissa.replace('.', "");ensure!(digits.len()<=38,"Litecoin fee precision exceeds limit");
+    let value=digits.parse::<u128>()?;let shift=8+exponent-decimals as i32;
+    let atomic=if value==0 {0} else if shift>=0 {
+        value.checked_mul(10u128.checked_pow(shift as u32).context("Litecoin fee scale overflow")?)
+            .context("Litecoin fee rate overflow")?
+    } else if shift<=-39 {1} else {value.div_ceil(10u128.pow((-shift) as u32))};
+    ensure!(atomic<=u128::from(maximum),"Litecoin reported fee rate exceeds maximum");
+    Ok(Some(u64::try_from(atomic)?))
+}
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    /// Explicit target and caller rate ceiling; no default fee if unavailable.
+    pub async fn reported_fee_rate(&mut self,target:u16,maximum_atomic_per_kvb:u64)->Result<Option<ReportedFeeRate>> {
+        ensure!((1..=1008).contains(&target) && maximum_atomic_per_kvb>0,"invalid Litecoin fee request policy");
+        let outcome=async {
+            let (_,bytes)=self.exchange("blockchain.estimatefee",json!([target]),512).await?;
+            let raw:Box<RawValue>=result(&bytes)?;
+            Ok(parse_rate(raw.get(),maximum_atomic_per_kvb)?.map(|atomic_per_kvb|ReportedFeeRate {target,atomic_per_kvb}))
+        }.await;
+        if outcome.is_err() {self.usable=false;}outcome
+    }
+}
+#[cfg(test)]
+mod tests;
