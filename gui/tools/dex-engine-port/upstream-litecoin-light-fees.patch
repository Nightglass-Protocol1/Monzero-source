+use super::*;
+use crate::litecoin_light::session::tests::{server,reply,regtest_handshake};
+#[test]
+fn fee_decimal_conversion_is_exact_and_bounded()->Result<()> {
+    for (raw,expected) in [("0.00001",1000),("1.169e-05",1169),("1e-8",1),("1e-9",1),("0",0),("1E+0",100000000),("0.0000000100000001",2)] {
+        assert_eq!(parse_rate(raw,u64::MAX)?,Some(expected));
+    }
+    assert_eq!(parse_rate("-1",1000)?,None);
+    assert_eq!(parse_rate("184467440737.09551615",u64::MAX)?,Some(u64::MAX));
+    for raw in ["-2","-0","null","true","\"0.00001\"","[]","184467440737.09551616","1e100","1e-1001"] {
+        assert!(parse_rate(raw,u64::MAX).is_err(),"{raw}");
+    }
+    assert!(parse_rate("0.00001001",1000).is_err());Ok(())
+}
+#[tokio::test]
+async fn fee_query_preserves_unavailable_and_poisoning_semantics()->Result<()> {
+    for response in [json!(0.00001),json!(-1),json!(-2),json!("0.00001"),json!(1)] {
+        let mut responses=regtest_handshake();responses.push(reply(3,response.clone()));
+        let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        assert!(session.reported_fee_rate(0,1000).await.is_err());assert!(session.usable);
+        let outcome=session.reported_fee_rate(6,1000).await;
+        if response==json!(0.00001) {let rate=outcome?.unwrap();assert_eq!(rate.target_blocks(),6);assert_eq!(rate.atomic_per_kvb(),1000);assert!(session.usable);}
+        else if response==json!(-1) {assert!(outcome?.is_none());assert!(session.usable);}
+        else {assert!(outcome.is_err());assert!(!session.usable);}
+        drop(session);let requests=task.await?;assert_eq!(requests.len(),3);
+        assert_eq!(requests[2]["method"],"blockchain.estimatefee");assert_eq!(requests[2]["params"],json!([6]));
+    }Ok(())
+}
+#[cfg(target_os="linux")]
+#[test]
+fn fee_size_bound_covers_actual_p2wpkh_signatures()->Result<()> {
+    use crate::litecoin_light::{account::Branch,vault::SecretSeed};
+    use bitcoin::{absolute,transaction,OutPoint,Txid,TxIn,TxOut,ScriptBuf,Sequence,hashes::Hash};
+    let seed=SecretSeed::from_bytes(zeroize::Zeroizing::new([42;32]));let account=seed.public_account(LtcNetwork::Regtest,0)?;
+    let prevout=TxOut {value:Amount::from_sat(100000),script_pubkey:account.derive(Branch::Receive,0)?.address().script_pubkey().clone()};
+    let tx=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:(0..2).map(|vout|TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([1;32]),vout},script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}).collect(),
+        output:vec![TxOut {value:Amount::from_sat(199000),script_pubkey:prevout.script_pubkey.clone()}]};
+    let rate=ReportedFeeRate {target:6,atomic_per_kvb:1001};let (size,fee)=rate.p2wpkh_fee(&tx,Amount::from_sat(10000))?;
+    let mut signed=tx.clone();
+    for index in 0..2 {signed.input[index].witness=seed.sign_p2wpkh_input(&account,Branch::Receive,0,&tx,index,&prevout)?;}
+    assert!(size>=signed.vsize() as u64);assert_eq!(fee.to_sat(),(size*1001).div_ceil(1000));
+    assert!(rate.p2wpkh_fee(&tx,Amount::from_sat(fee.to_sat()-1)).is_err());
+    assert!(rate.p2wpkh_fee(&signed,Amount::from_sat(10000)).is_err());Ok(())
+}
