 impl RecoveryLease {
+    /// Historical pre-lock recovery data only. This does NOT prove whether the
+    /// lock was signed, broadcast, mined or spent, and permits no funding retry.
+    /// Caller must reconcile the exact transaction with the expected chain.
+    #[cfg(target_os = "linux")]
+    pub fn load_bitcoin_lock(&self, store: &CheckpointPinStore, expected_lock: bitcoin::Txid)
+        -> Result<crate::bob::State3> {
+        store.separate_from(&self.directory)?;
+        let quote=self.record.quote();
+        let name=format!("{}.bitcoin-lock",filename(quote)?);
+        let pin_bytes=read_private(&store.directory,&format!("{name}.pin"))?;
+        let pin=decode_pin(&pin_bytes,quote.terms()["swapId"].parse()?,quote.commitment())?;
+        let bytes=read_pinned(&self.directory,&name,&pin)?;
+        ensure!(bytes.len()>LOCK_DOMAIN.len()+32 && bytes.starts_with(LOCK_DOMAIN)
+            && &bytes[LOCK_DOMAIN.len()..LOCK_DOMAIN.len()+32]==quote.commitment(),
+            "Bitcoin lock checkpoint envelope mismatch");
+        let state:crate::bob::State3=serde_json::from_slice(&bytes[LOCK_DOMAIN.len()+32..])
+            .map_err(|_|anyhow::anyhow!("invalid Bitcoin lock checkpoint"))?;
+        ensure!(state.tx_lock.txid()==expected_lock,"Bitcoin lock checkpoint transaction mismatch");
+        state.check_recorded_quote(quote)?;
+        Ok(state)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn load_bitcoin_lock(&self, _: &CheckpointPinStore, _: bitcoin::Txid) -> Result<crate::bob::State3> {
+        anyhow::bail!("Bitcoin lock checkpoint recovery is not implemented on this platform")
+    }
