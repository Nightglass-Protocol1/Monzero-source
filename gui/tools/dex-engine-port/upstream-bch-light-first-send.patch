+//! Explicit first publication of local BCH funding after private recovery.
+//! Wallet relay intent precedes TLS; interrupted/unknown attempts require reconciliation.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,accounting::ObservedWallet,tls::TlsEndpoint,
+    vault::signing::review::{confirmed::{IncludedInput,claimed::ObservedClaimedSpend},claims::broadcast::BroadcastStatus}};
+use bitcoin::{consensus::serialize,hashes::{Hash,sha256},Txid};
+use super::super::relay::FundingRelayReview;
+
+impl AdmittedExecution<'_> {
+    /// Review exact retained funding and recovery against same-tip input evidence.
+    /// A wallet's personal-payment confirmation setting cannot weaken trade policy.
+    pub fn review_light_bch_funding_send(&self,spend:&ObservedClaimedSpend,
+        chain:&HeaderSequence,observed:&ObservedWallet,inputs:&[IncludedInput<'_>],
+        expected:sha256::Hash,endpoint:&TlsEndpoint,now:u64)->Result<FundingRelayReview> {
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(endpoint.network()==chain.network(),"wrong BCH light relay endpoint network");
+        spend.check_funding_inputs_on(chain,observed,inputs,u64::from(self.policy.bch_confirmations))?;
+        let claim=spend.retained_claim();
+        let (signed,signed_at)=self.require_local_funding_claim(claim,chain.network(),expected)?;
+        let recovery=self.retained_bch_recovery()?.context("private BCH recovery required before local funding relay")?;
+        ensure!(now>=signed_at && now>=recovery.prepared_at(),"BCH light relay predates funding or recovery");
+        self.funding_message_material()?;
+        ensure!(claim.broadcast_status(endpoint,expected)?==BroadcastStatus::NoLocalAttempt,
+            "BCH local funding already attempted; reconcile first");
+        let details=serde_json::json!({"schema":"monzero-bch-light-relay-review-v1","action":"send",
+            "tradeId":self.quote.terms()["swapId"],"quoteCommitment":hex(self.quote.commitment()),
+            "claimCommitment":expected,"txid":signed.transaction().compute_txid(),
+            "signedDigest":sha256::Hash::hash(&serialize(signed.transaction())),
+            "privateRecovery":hex(recovery.commitment()),"cancelTxid":recovery.cancel().compute_txid(),
+            "refundTxid":recovery.refund_txid()?,"punishTxid":recovery.punish().compute_txid(),
+            "minimumConfirmations":self.policy.bch_confirmations,"observedHeight":chain.height(),
+            "observedTip":observed.tip(),"endpoint":{"network":endpoint.network().storage_identity(),
+                "host":endpoint.host(),"port":endpoint.port()}});
+        let commitment=hash("monzero-bch-light-relay-review-v1",&serde_json::to_vec(&details)?);
+        Ok(FundingRelayReview {details,commitment})
+    }
+
+    /// Fresh consent covers the exact transaction, recovery, selected tip and
+    /// endpoint. No key unlock or re-signing. Cancellation retains unknown intent.
+    pub async fn send_light_bch_funding(&self,spend:&ObservedClaimedSpend,
+        chain:&HeaderSequence,observed:&ObservedWallet,inputs:&[IncludedInput<'_>],
+        expected:sha256::Hash,endpoint:&TlsEndpoint,approved:&[u8;32],now:u64)->Result<Txid> {
+        let review=self.review_light_bch_funding_send(spend,chain,observed,inputs,expected,endpoint,now)?;
+        ensure!(review.commitment==*approved,"BCH local funding send approval is stale or changed");
+        spend.broadcast_on(chain,observed,endpoint,expected).await
+    }
+}
