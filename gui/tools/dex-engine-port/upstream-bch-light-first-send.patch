+    /// Recheck exact retained inputs at this observation tip against a trade's
+    /// required depth, which may exceed the original personal-wallet review.
+    /// Requires no global submission marker, including attempts at other endpoints.
+    /// This establishes neither complete unspentness nor broadcast permission.
+    pub fn check_funding_inputs_on(&self,chain:&HeaderSequence,observed:&ObservedWallet,
+        inputs:&[IncludedInput<'_>],minimum_confirmations:u64)->Result<()> {
+        self.claimed.ensure_not_submitted()?;
+        require_observed(chain,observed,self.network,self.height,self.tip,&self.inputs)?;
+        self.claimed.revalidate_inclusions(chain,inputs,minimum_confirmations)
+    }
     pub fn transaction(&self)->&Transaction {self.claimed.transaction()}
     pub fn fee(&self)->Amount {self.claimed.fee()}
     pub fn signing_commitment(&self)->sha256::Hash {self.claimed.signing_commitment()}
