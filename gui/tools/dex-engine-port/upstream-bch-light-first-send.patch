+        let retained=claim.retained_bch_funding(network,self.quote.terms()["swapId"].parse()?,expected)?;
+        let result=self.restore_local_signed_funding()?.context("missing local BCH funding")?;
+        ensure!(retained.signed()==result.0.transaction()
+            && serialize(retained.unsigned())==record.template.unsigned,"local BCH funding bytes changed");
+        Ok(result)
+    }
