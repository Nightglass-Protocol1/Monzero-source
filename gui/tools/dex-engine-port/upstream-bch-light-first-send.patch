+use super::*;
+use agreement::execution::AdmittedExecution;
+use crate::litecoin_light::{account::PublicAccount,accounting::ObservedWallet,headers::HeaderSequence,
+    network::BchNetwork,session::ReadSession,tls::TlsEndpoint,account::Branch,
+    vault::signing::review::{claims::{ClaimedSpend,broadcast::BroadcastStatus},
+        confirmed::{IncludedInput,claimed::ObservedClaimedSpend}}};
+use bitcoin::hashes::sha256;
+use std::{path::Path,time::Duration};
+use tokio::io::{AsyncBufReadExt,AsyncWriteExt,BufReader};
+
+pub(super) async fn exercise(execution:&AdmittedExecution<'_>,claim:ClaimedSpend,parent:&Transaction,
+    account:&PublicAccount,payment:&TxOut,claims:&Path,metadata:&Path,operation:uuid::Uuid,
+    expected:sha256::Hash,minimum:u32)->Result<()> {
+    // Synthetic block-body inclusion tests policy; these are not live-chain funds.
+    let mut chain=HeaderSequence::new(BchNetwork::Regtest)?;
+    for _ in 0..minimum {
+        let mut header=chain.header(chain.height()).unwrap();header.prev_blockhash=header.block_hash();
+        header.version=bitcoin::block::Version::from_consensus(0x20000000);
+        header.merkle_root=bitcoin::TxMerkleNode::from_byte_array(parent.compute_txid().to_byte_array());
+        header.time+=1;header.nonce=0;
+        while header.validate_pow(header.target()).is_err() {header.nonce+=1;}
+        chain.append(&serialize(&header),u64::from(header.time)+7201)?;
+    }
+    let (client,server)=tokio::io::duplex(65536);
+    let raw=hex(&serialize(parent));let genesis=chain.network().genesis();
+    let server=tokio::spawn(async move {
+        let mut stream=BufReader::new(server);
+        for (method,result) in [
+            ("server.version",serde_json::json!(["fixture","1.4"])),
+            ("server.features",serde_json::json!({"genesis_hash":genesis,"hash_function":"sha256"})),
+            ("blockchain.transaction.get",serde_json::json!(raw)),
+            ("blockchain.transaction.get_merkle",serde_json::json!({"block_height":1,"pos":0,"merkle":[]}))] {
+            let mut line=String::new();assert!(stream.read_line(&mut line).await.unwrap()>0);
+            let request:serde_json::Value=serde_json::from_str(&line).unwrap();assert_eq!(request["method"],method);
+            let mut reply=serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":request["id"],"result":result})).unwrap();
+            reply.push(b'\n');stream.get_mut().write_all(&reply).await.unwrap();
+        }
+    });
+    let mut session=ReadSession::negotiate(client,BchNetwork::Regtest).await?;
+    let included=session.transaction_on(&chain,1,parent.compute_txid()).await?;drop(session);server.await?;
+    let scripts=[parent.output[0].script_pubkey.clone()];
+    let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:0}];
+    let shallow=chain.fork(1)?;
+    let shallow_observation=ObservedWallet::reconcile(&shallow,&scripts,std::slice::from_ref(&included))?;
+    let held_listener=std::net::TcpListener::bind("127.0.0.1:0")?;
+    let endpoint=TlsEndpoint::new("127.0.0.1".into(),held_listener.local_addr()?.port(),BchNetwork::Regtest)?;
+    let spend=ObservedClaimedSpend::revalidate(claim,&shallow,&shallow_observation,&inputs,1)?;
+    assert!(execution.review_light_bch_funding_send(&spend,&shallow,&shallow_observation,&inputs,expected,&endpoint,1013).is_err());
+    drop(spend);
+    let claim=ClaimedSpend::open(claims,operation,account,payment,None,Amount::from_sat(1000),expected)?;
+    let observed=ObservedWallet::reconcile(&chain,&scripts,std::slice::from_ref(&included))?;
+    let spend=ObservedClaimedSpend::revalidate(claim,&chain,&observed,&inputs,1)?;
+    let review=execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&endpoint,1013)?;
+    assert_eq!(review.details["minimumConfirmations"],minimum);
+    assert_eq!(review.details["txid"],spend.retained_signed()?.compute_txid().to_string());
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&[],expected,&endpoint,1013).is_err());
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,sha256::Hash::hash(b"wrong"),&endpoint,1013).is_err());
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&endpoint,2000).is_err());
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&endpoint,1011).is_err());
+    let spent=ObservedWallet::reconcile_with_pending(&chain,&scripts,std::slice::from_ref(&included),&[spend.retained_signed()?])?;
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&spent,&inputs,expected,&endpoint,1013).is_err());
+    let other=TlsEndpoint::new("localhost".into(),endpoint.port(),BchNetwork::Regtest)?;
+    assert_ne!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&other,1013)?.commitment,review.commitment);
+    let recovery_pin=metadata.join(format!("{operation}.bch-funding-recovery-pin"));
+    let saved_pin=metadata.join("temporarily-held-recovery-pin");std::fs::rename(&recovery_pin,&saved_pin)?;
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&endpoint,1013).is_err());
+    std::fs::rename(saved_pin,recovery_pin)?;
+    assert!(execution.send_light_bch_funding(&spend,&chain,&observed,&inputs,expected,&endpoint,&[0;32],1013).await.is_err());
+    assert_eq!(spend.retained_claim().broadcast_status(&endpoint,expected)?,BroadcastStatus::NoLocalAttempt);
+    // Cancel a real owned-loopback TLS connection attempt after intent is durable.
+    let outcome=tokio::time::timeout(Duration::from_millis(200),execution.send_light_bch_funding(
+        &spend,&chain,&observed,&inputs,expected,&endpoint,&review.commitment,1013)).await;
+    assert!(outcome.is_err());
+    assert_eq!(spend.retained_claim().broadcast_status(&endpoint,expected)?,BroadcastStatus::OutcomeUnknown);
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&endpoint,1013).is_err());
+    // Endpoint-local absence must not bypass the wallet's global submission marker.
+    assert_eq!(spend.retained_claim().broadcast_status(&other,expected)?,BroadcastStatus::NoLocalAttempt);
+    assert!(execution.review_light_bch_funding_send(&spend,&chain,&observed,&inputs,expected,&other,1013).is_err());
+    drop(held_listener);Ok(())
+}
