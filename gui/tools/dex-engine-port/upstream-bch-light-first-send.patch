+    fn require_local_funding_claim(&self,claim:&ClaimedSpend,network:LightNetwork,
+        expected:sha256::Hash)->Result<(SignedFunding,u64)> {
+        let bytes=self.local_record_bytes()?.context("missing local BCH source binding")?;
+        let (record,_)=self.validate_local_record(&bytes)?;
+        ensure!(record.network==network.storage_identity() && record.claim==expected.to_byte_array(),
