+//! Retained unsigned funding preparation, not input reservation, approval,
+//! signing permission or relay state. Snapshot publication precedes metadata.
+use super::*;
+use swap_core::bch::funding::FundingPreview;
+
+const TEMPLATE: &str = "monzero-bch-funding-template-v1";
+const PIN: &str = "monzero-bch-funding-pin-v1";
+
+pub struct PreparedBchFunding { preview: FundingPreview, commitment: [u8;32], prepared_at: u64 }
+impl PreparedBchFunding {
+    pub fn preview(&self) -> &FundingPreview { &self.preview }
+    pub fn commitment(&self) -> &[u8;32] { &self.commitment }
+    pub fn prepared_at(&self) -> u64 { self.prepared_at }
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Template {
+    schema: String, admission: [u8;32], prepared_at: u64, unsigned: Vec<u8>,
+    sources: Vec<Vec<u8>>, change: Vec<u8>, maximum_fee: u64, minimum_change: u64,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin { schema: String, admission: [u8;32], template: [u8;32] }
+fn hash(domain: &str, bytes: &[u8]) -> [u8;32] {
+    let mut h = Sha256::new(); h.update(domain); h.update([0]); h.update(bytes); h.finalize().into()
+}
+fn record_name(quote: &VerifiedBchQuote, suffix: &str) -> String {
+    format!("{}.bch-funding-{suffix}",quote.terms()["swapId"])
+}
+impl AdmittedExecution<'_> {
+    fn admission_digest(&self) -> Result<[u8;32]> {
+        Ok(hash(SCHEMA,&serde_json::to_vec(&self.read_admission()?)?))
+    }
+    /// Retain the exact validated preparation before publishing its trusted pin.
+    /// A retry must supply the original bytes, policy and preparation time.
+    /// Failure leaves any written records in place; never delete them to reprice.
+    pub fn retain_bch_funding_preparation(&mut self, now: u64, unsigned: &[u8], sources: &[&[u8]],
+        change: &bitcoin::Script, maximum_fee: u64, minimum_change: u64) -> Result<PreparedBchFunding> {
+        let preview = self.validate_bch_funding_preview(now,unsigned,sources,change,maximum_fee,minimum_change)?;
+        let admission = self.admission_digest()?;
+        let template = Template {schema:TEMPLATE.into(),admission,prepared_at:now,unsigned:unsigned.to_vec(),
+            sources:sources.iter().map(|s|s.to_vec()).collect(),change:change.as_bytes().to_vec(),maximum_fee,minimum_change};
+        let bytes = serde_json::to_vec(&template)?;
+        // A bounded journal record is stricter than the in-memory preview limit.
+        ensure!(bytes.len() <= 2_000_000,"BCH funding preparation exceeds durable record limit");
+        let commitment = hash(TEMPLATE,&bytes);
+        Journal::open(&self.snapshots)?.retain(&record_name(self.quote,"template"),&bytes)?;
+        let pin = Pin {schema:PIN.into(),admission,template:commitment};
+        self.metadata.retain(&record_name(self.quote,"pin"),&serde_json::to_vec(&pin)?)?;
+        Ok(PreparedBchFunding {preview,commitment,prepared_at:now})
+    }
+
+    /// Restore the exact historically validated preparation. None means there
+    /// is no trusted pin, not that inputs may be reselected or funds relayed.
+    /// An orphan template still blocks any different preparation at its slot.
+    /// Signing must separately check current expiry, chain state and approval.
+    pub fn prepared_bch_funding(&self) -> Result<Option<PreparedBchFunding>> {
+        let pin_bytes = match self.metadata.read(&record_name(self.quote,"pin")) {
+            Ok(bytes)=>bytes,
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>return Ok(None),
+            Err(error)=>return Err(error),
+        };
+        ensure!(self.role == Role::BchFunder && pin_bytes.len() <= 4096,"invalid BCH funding preparation owner");
+        let pin: Pin = serde_json::from_slice(&pin_bytes)?;
+        let admission = self.admission_digest()?;
+        ensure!(pin.schema == PIN && pin.admission == admission && serde_json::to_vec(&pin)? == pin_bytes,
+            "BCH funding pin admission mismatch");
+        let bytes = Journal::open(&self.snapshots)?.read(&record_name(self.quote,"template"))?;
+        ensure!(hash(TEMPLATE,&bytes) == pin.template,"BCH funding template digest mismatch");
+        let template: Template = serde_json::from_slice(&bytes)?;
+        ensure!(template.schema == TEMPLATE && template.admission == admission
+            && serde_json::to_vec(&template)? == bytes,"BCH funding template admission mismatch");
+        let sources: Vec<&[u8]> = template.sources.iter().map(Vec::as_slice).collect();
+        let preview = self.validate_bch_funding_preview(template.prepared_at,&template.unsigned,&sources,
+            bitcoin::Script::from_bytes(&template.change),template.maximum_fee,template.minimum_change)?;
+        Ok(Some(PreparedBchFunding {preview,commitment:pin.template,prepared_at:template.prepared_at}))
+    }
+}
