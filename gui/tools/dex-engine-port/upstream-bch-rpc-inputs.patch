+use super::*;
+use bitcoin::{absolute,transaction::Version,Amount,OutPoint,Sequence,Transaction,Txid,TxIn,Witness};
+use crate::bch_quote::tests::{fixture,signed};
+
+fn preview() -> Result<(FundingPreview,ScriptBuf,OutPoint)> {
+    let (policy,terms)=fixture();let quote=signed(&terms,&policy,1000)?;
+    let script=quote.recovery_plan().recovery().terms().redeem_destination.clone();
+    let parent=Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(120_000),script_pubkey:script.clone()}]};
+    let outpoint=OutPoint {txid:parent.compute_txid(),vout:0};
+    let mut tx=parent.clone();tx.input[0].previous_output=outpoint;
+    tx.output=vec![TxOut {value:Amount::from_sat(100_000),script_pubkey:quote.recovery_plan().lock().script_pubkey()},
+        TxOut {value:Amount::from_sat(19_000),script_pubkey:script.clone()}];
+    Ok((FundingPreview::verify(&serialize(&tx),&[&serialize(&parent)],quote.recovery_plan().lock(),100_000,&script,1000,546)?,script,outpoint))
+}
+#[test]
+fn exact_amounts_and_explicit_chain_pins_are_required() -> Result<()> {
+    assert_eq!(atoms("0.00000001")?,1);assert_eq!(atoms("21000000.00000000")?,2_100_000_000_000_000);
+    for raw in ["1e-8","\"0.01\"","-1","1.000000001","21000001","1.",".1"] {assert!(atoms(raw).is_err());}
+    assert_eq!(BchNetwork::Mainnet.checkpoint()?.0,792773);
+    assert_eq!(BchNetwork::Testnet.checkpoint()?.0,1552788);
+    assert!(BchNetwork::Regtest {checkpoint_height:0,checkpoint:BlockHash::all_zeros()}.checkpoint().is_err());
+    Ok(())
+}
+#[tokio::test]
+async fn owned_bchn_input_observation_rejects_deployment_wallet_and_utxo_mismatches() -> Result<()> {
+    use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},sync::{Arc,atomic::AtomicBool}};
+    for case in 0..22 {
+        let (preview,script,outpoint)=preview()?;
+        let network=BchNetwork::Regtest {checkpoint_height:1,checkpoint:BlockHash::from_byte_array([7;32])};
+        let listener=TcpListener::bind("127.0.0.1:0")?;listener.set_nonblocking(true)?;
+        let rpc=BchRpc::new(listener.local_addr()?.port(),"user".into(),"pass".into(),network,
+            "test".into(),"bchreg:qanchor".into(),script.clone(),"/Bitcoin Cash Node:29.0.0/".into())?;
+        let stop=Arc::new(AtomicBool::new(false));let signal=stop.clone();
+        let server=std::thread::spawn(move || -> Result<usize> {
+            let mut chain_calls=0;let mut count=0;
+            while !signal.load(Ordering::Relaxed) {
+                let (mut socket,_)=match listener.accept() {
+                    Ok(connection)=>connection,
+                    Err(error) if error.kind()==std::io::ErrorKind::WouldBlock=>{
+                        std::thread::sleep(std::time::Duration::from_millis(2));continue;
+                    },Err(error)=>return Err(error.into()),
+                };
+                socket.set_read_timeout(Some(std::time::Duration::from_secs(3)))?;
+                socket.set_write_timeout(Some(std::time::Duration::from_secs(3)))?;
+                let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();reader.read_line(&mut line)?;
+                let path=line.split_whitespace().nth(1).context("missing RPC path")?.to_owned();
+                let mut length=None;let mut auth=false;
+                loop {
+                    line.clear();ensure!(reader.read_line(&mut line)?>0,"missing RPC headers");
+                    if line=="\r\n" {break;}
+                    let lower=line.to_ascii_lowercase();
+                    if let Some(value)=lower.strip_prefix("content-length:") {length=Some(value.trim().parse::<usize>()?);}
+                    if lower.starts_with("authorization:") {auth=line.trim().ends_with("Basic dXNlcjpwYXNz");}
+                }
+                ensure!(auth,"missing authenticated RPC request");
+                let length=length.context("missing RPC content length")?;ensure!(length<4096,"oversized request");
+                let mut body=vec![0;length];reader.read_exact(&mut body)?;let request:Value=serde_json::from_slice(&body)?;
+                let method=request["method"].as_str().context("missing RPC method")?;
+                let wallet=matches!(method,"getwalletinfo"|"getaddressinfo");
+                ensure!(path==if wallet {"/wallet/test"} else {"/"},"wrong wallet RPC route");
+                let result=match method {
+                    "getnetworkinfo"=>json!({"subversion":if case==1 {"/Satoshi:29.0.0/"} else {"/Bitcoin Cash Node:29.0.0/"},"networkactive":true}),
+                    "getblockchaininfo"=>{chain_calls+=1;json!({"chain":if case==2 {"main"} else {"regtest"},
+                        "blocks":200,"headers":200,"initialblockdownload":case==5,
+                        "bestblockhash":if case==6 && chain_calls>1 {"09".repeat(32)} else {"08".repeat(32)}})},
+                    "getblockhash"=>{let height=request["params"][0].as_u64().unwrap();ensure!(height==0||height==1,"unexpected chain pin height");
+                        json!(if (height==0 && case==3)||(height==1 && case==4) {"00".repeat(32)}
+                        else if height==0 {network.genesis().into()} else {"07".repeat(32)})},
+                    "getwalletinfo"=>json!({"walletname":if case==12 {"other"} else {"test"},"private_keys_enabled":true}),
+                    "getaddressinfo"=>{
+                        let address=request["params"][0].as_str().unwrap();
+                        ensure!(["bchreg:qanchor","bchreg:qinput","bchreg:qchange"].contains(&address),"unexpected ownership request");
+                        json!({"ismine":!(case==17 && address=="bchreg:qchange"),"iswatchonly":case==13,"scriptPubKey":script.to_hex_string()})},
+                    "gettxout"=>{
+                        ensure!(request["params"]==json!([outpoint.txid.to_string(),outpoint.vout,true]),"gettxout must include pending spends");
+                        let mut v=json!({"bestblock":"08".repeat(32),"confirmations":if case==16 {0} else if case==10 {99} else {100},
+                            "value":0.0012,"coinbase":case==10||case==18,"scriptPubKey":{"hex":script.to_hex_string(),"addresses":["bchreg:qinput"]}});
+                        match case {7=>v["value"]=json!(0.001201),8=>v["scriptPubKey"]["hex"]=json!("51"),
+                            9=>v["tokenData"]=json!({"category":"01".repeat(32),"amount":"1"}),11=>v=Value::Null,
+                            15=>v["value"]=json!("0.0012"),20=>v["scriptPubKey"]["addresses"]=json!([]),
+                            21=>v["scriptPubKey"]["addresses"]=json!(["bitcoincash:qinput"]),_=>()};v},
+                    _=>anyhow::bail!("unexpected or mutating BCH RPC method"),
+                };
+                count+=1;
+                let reply=json!({"id":if case==14 {json!(999)} else {request["id"].clone()},
+                    "error":if case==19 {json!({"code":-1,"message":"fixture"})} else {Value::Null},"result":result});
+                let body=serde_json::to_vec(&reply)?;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;socket.write_all(&body)?;
+            }
+            Ok(count)
+        });
+        let result=rpc.observe_funding_inputs(&preview,"bchreg:qchange",3).await;
+        stop.store(true,Ordering::Relaxed);let calls=server.join().unwrap()?;
+        assert!(calls>0);
+        if case==0||case==18 {
+            let observation=result?;assert_eq!(observation.tip(),BlockHash::from_byte_array([8;32]));
+            assert_eq!(observation.template_hash(),sha256::Hash::hash(&serialize(preview.transaction())));
+        } else {assert!(result.is_err(),"case {case}");}
+    }
+    Ok(())
+}
