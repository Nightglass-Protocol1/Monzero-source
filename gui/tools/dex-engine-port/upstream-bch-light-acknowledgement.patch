+//! Import only an exact original endpoint's durable wallet acknowledgement.
+//! This historical receipt is not evidence of inclusion or spendability.
+use super::*;
+use super::super::super::relay::{optional,FundingRelayState};
+use crate::litecoin_light::vault::signing::review::claims::ClaimedSpend;
+
+const ACK:&str="monzero-bch-local-relay-ack-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LocalAck {schema:String,intent:[u8;32],txid:Txid}
+impl AdmittedExecution<'_> {
+    /// Repair interruption between wallet acknowledgement and trade publication.
+    /// No network access, secret access, expiry gate or new broadcast approval.
+    pub fn reconcile_light_bch_funding_ack(&self,claim:&ClaimedSpend,endpoint:&TlsEndpoint,
+        expected:sha256::Hash)->Result<Txid> {
+        self.require_local_funding_claim(claim,endpoint.network(),expected)?;
+        let saved=self.saved_local_send()?;
+        ensure!(saved.claim==expected && saved.endpoint.network()==endpoint.network()
+            && saved.endpoint.host()==endpoint.host() && saved.endpoint.port()==endpoint.port(),
+            "BCH acknowledgement differs from original endpoint or claim");
+        ensure!(claim.broadcast_status(endpoint,expected)?==BroadcastStatus::ServerAcknowledged,
+            "BCH wallet has no acknowledged broadcast for original endpoint");
+        let txid=saved.signed.transaction().compute_txid();
+        let ack=LocalAck {schema:ACK.into(),intent:saved.intent,txid};
+        self.metadata.retain(&record_name(self.quote,"local-relay-ack"),&serde_json::to_vec(&ack)?)?;
+        Ok(txid)
+    }
+    pub(in crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding)
+    fn local_bch_relay_state(&self)->Result<Option<FundingRelayState>> {
+        // Validate complete preparation even if sending has not begun.
+        self.restore_local_signed_funding()?.context("missing local BCH funding")?;
+        let ack=optional(&self.metadata,&record_name(self.quote,"local-relay-ack"))?;
+        if self.local_send_intent_bytes()?.is_none() {
+            ensure!(ack.is_none(),"BCH local acknowledgement has no send intent");
+            return Ok(None)
+        }
+        let saved=self.saved_local_send()?;
+        let txid=saved.signed.transaction().compute_txid();
+        let Some(bytes)=ack else {return Ok(Some(FundingRelayState::Attempted {txid}))};
+        ensure!(bytes.len()<=4096,"oversized BCH local acknowledgement");
+        let ack:LocalAck=serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema==ACK && ack.intent==saved.intent && ack.txid==txid
+            && serde_json::to_vec(&ack)?==bytes,"BCH local acknowledgement changed");
+        Ok(Some(FundingRelayState::Acknowledged {txid}))
+    }
+    pub(in crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding)
+    fn local_bch_approved_at(&self)->Result<u64> {
+        ensure!(matches!(self.local_bch_relay_state()?,Some(FundingRelayState::Acknowledged {..})),
+            "BCH funding message requires acknowledged local relay");
+        Ok(self.saved_local_send()?.approved_at)
+    }
+}
