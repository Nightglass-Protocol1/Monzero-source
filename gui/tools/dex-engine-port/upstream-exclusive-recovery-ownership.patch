+/// Cooperative process ownership of an existing attempt, not a new execution
+/// claim or payment permit. Keep this alive for the entire recovery operation.
+/// Requires private trusted storage; hostile same-user code can bypass advisory
+/// locks or replace files. Protocol/chain revalidation is still mandatory.
+pub struct RecoveryLease {
+    record: RecordedExecution,
+    _owner: std::fs::File,
+}
+
+impl RecoveryLease {
+    pub fn record(&self) -> &RecordedExecution { &self.record }
+
+    #[cfg(target_os = "linux")]
+    pub fn acquire(directory: &Path, context: &RecoveryContext<'_>, now: u64) -> Result<Self> {
+        let (owner,bytes)=read_execution(directory,context.swap_id,true)?;
+        let record=RecordedExecution::decode(&bytes,context,now)?;
+        ensure!(record.ownership_aware,"legacy execution record has no recovery ownership protocol");
+        Ok(Self {record,_owner:owner})
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn acquire(_: &Path, _: &RecoveryContext<'_>, _: u64) -> Result<Self> {
+        anyhow::bail!("execution recovery ownership is not implemented on this platform")
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn lock_owner(file: &std::fs::File) -> Result<()> {
+    use std::os::fd::AsRawFd;
+    if unsafe{libc::flock(file.as_raw_fd(),libc::LOCK_EX|libc::LOCK_NB)} != 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    Ok(())
+}
