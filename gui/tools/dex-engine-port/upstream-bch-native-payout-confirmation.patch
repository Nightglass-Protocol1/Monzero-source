+//! Fresh settlement evidence after an attempted native payout. Read-only:
+//! no acknowledgement fabrication, journal updates, construction or retransmission.
+use super::*;
+use crate::{bch_rpc::confirmed::ConfirmedTransaction,xmz_funding::ChainSnapshot};
+
+pub struct ConfirmedNativePayout {
+    quote: [u8;32],admission: [u8;32],review: [u8;32],txid: String,
+    confirmations: u64,native: ChainSnapshot,bch: ConfirmedTransaction,
+}
+impl ConfirmedNativePayout {
+    pub fn quote(&self) -> &[u8;32] {&self.quote}
+    pub fn admission(&self) -> &[u8;32] {&self.admission}
+    pub fn review(&self) -> &[u8;32] {&self.review}
+    pub fn txid(&self) -> &str {&self.txid}
+    pub fn confirmations(&self) -> u64 {self.confirmations}
+    pub fn native_snapshot(&self) -> &ChainSnapshot {&self.native}
+    pub fn bch_confirmation(&self) -> &ConfirmedTransaction {&self.bch}
+}
+impl AdmittedExecution<'_> {
+    /// A saved relay acknowledgement is not required. A retained, validated
+    /// attempt is required; confirmation never authorizes another dispatch.
+    pub async fn observe_bch_native_payout(&self,native: &impl FundingObserver,bch: &BchRpc,
+        block: Option<BlockHash>,now: u64,session: NativeWalletSession) -> Result<ConfirmedNativePayout> {
+        let (review,prepared,intent,deployment)=self.native_payout_relay_materials()?;
+        self.native_payout_state(&review,&intent)?.context("missing BCH native payout relay attempt")?;
+        let (attempt,_)=self.native_payout_attempt(&review,&intent)?.context("missing BCH native payout relay attempt")?;
+        ensure!(now>=attempt.approved_at && bch.deployment_commitment()?==deployment,
+            "BCH native payout observation predates dispatch or changes observer");
+        let claim=self.recover_bch_native_claim(native,bch,intent.redemption,block,now).await?;
+        ensure!(claim.native_receipt==intent.native_receipt && claim.native_txid==prepared.terms()["lockTxid"]
+            && claim.address.to_string()==prepared.terms()["wallet"],"BCH native payout claim changed");
+        let deadline=claim.observed_at.checked_add(std::time::Duration::from_secs(30)).context("native payout observation deadline overflow")?;
+        let txid=prepared.terms()["txid"].as_str().context("missing saved native payout identity")?.to_owned();
+        let (confirmations,snapshot,confirmed)=tokio::time::timeout_at(deadline.into(),async {
+            // Read-only spend-key check; do not import or rescan a wallet here.
+            session.verify_spend_key(&claim.spend,&claim.address).await?;
+            let observer=session.into_payout_relay()?;
+            let (confirmations,snapshot)=observer.confirm_native_payout_evidence(&prepared,u64::from(self.policy.xmz_confirmations)).await?;
+            let confirmed=bch.confirmed_transaction(intent.redemption,claim.block,u64::from(self.policy.bch_confirmations)).await?;
+            ensure!(confirmed.deployment()==&deployment && confirmed.block()==claim.block,
+                "BCH native payout redemption changed during confirmation");
+            observer.recheck_native_payout_snapshot(&snapshot).await?;
+            Ok::<_,anyhow::Error>((confirmations,snapshot,confirmed))
+        }).await.context("BCH native payout confirmation timed out")??;
+        ensure!(std::time::Instant::now()<deadline,"BCH native payout evidence expired");
+        Ok(ConfirmedNativePayout {quote:*self.quote.commitment(),admission:intent.admission,review:review.commitment,
+            txid,confirmations,native:snapshot,bch:confirmed})
+    }
+}
