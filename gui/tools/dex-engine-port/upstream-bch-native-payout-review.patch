+//! Read-only review of an exact saved native payout. This exposes neither
+//! signing artifacts nor broadcast authority; relay must revalidate separately.
+use super::*;
+use serde_json::json;
+
+const REVIEW: &str="monzero-bch-native-payout-relay-review-v1";
+pub struct NativePayoutRelayReview {pub details: Value,pub commitment: [u8;32]}
+
+impl AdmittedExecution<'_> {
+    fn native_payout_relay_materials(&self) -> Result<(NativePayoutRelayReview,PreparedLockPayout,Intent,[u8;32])> {
+        let (intent,bytes)=self.payout_intent()?.context("missing BCH native payout intent")?;
+        let prepared=self.load_bch_native_payout()?;
+        // Re-encoding a validated canonical checkpoint preserves its exact bytes,
+        // including metadata and proof keys that are never exposed by the review.
+        let binding=hash(INTENT,&bytes);
+        let checkpoint: [u8;32]=Sha256::digest(&*prepared.encode(binding)?).into();
+        let funding=self.prepared_bch_funding()?.context("missing BCH funding preparation")?;
+        let (locked,_)=self.funding_lock_intent(&funding)?;
+        let signed=self.signed_bch_funding()?.context("missing exact BCH funding")?;
+        let details=json!({"schema":REVIEW,"action":"broadcast-bch-native-payout",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),"admission":intent.admission,
+            "nativeReceipt":intent.native_receipt,"walletIntent":intent.wallet_intent,
+            "payoutIntent":binding,"privateCheckpoint":checkpoint,"preparedAt":intent.at,
+            "redemption":intent.redemption,"bchFundingOutpoint":signed.lock_outpoint(),
+            "bchDeployment":locked.deployment,"bchNetwork":self.quote.terms()["bchNetwork"],
+            "bchGenesis":self.quote.terms()["bchGenesis"],"xmzNetwork":self.quote.terms()["xmzNetwork"],
+            "minimumBchConfirmations":self.policy.bch_confirmations,
+            "minimumXmzConfirmations":self.policy.xmz_confirmations,"payout":prepared.terms()});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((NativePayoutRelayReview {details,commitment},prepared,intent,locked.deployment))
+    }
+    /// Review survives commercial expiry but conveys no current chain evidence.
+    /// Any future relay must recompute this commitment before accepting approval.
+    pub fn review_bch_native_payout_relay(&self,bch: &BchRpc,now: u64) -> Result<NativePayoutRelayReview> {
+        let (review,_,intent,deployment)=self.native_payout_relay_materials()?;
+        ensure!(now>=intent.at,"BCH native payout review predates preparation");
+        ensure!(bch.deployment_commitment()?==deployment,"BCH native payout observer changed");
+        Ok(review)
+    }
+}
