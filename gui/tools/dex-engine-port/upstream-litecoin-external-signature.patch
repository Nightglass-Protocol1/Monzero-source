+#[cfg(target_os="linux")]
+#[test]
+fn external_local_signature_is_exact_durable_and_recovers_after_expiry()->Result<()> {
+    use std::os::unix::fs::DirBuilderExt;
+    use execution::Execution;
+    let root=std::env::temp_dir().canonicalize()?.join(format!("ltc-external-{}",uuid::Uuid::new_v4()));
+    std::fs::DirBuilder::new().mode(0o700).create(&root)?;
+    let metadata=root.join("metadata");let secrets=root.join("secrets");
+    for path in [&metadata,&secrets] {std::fs::DirBuilder::new().mode(0o700).create(path)?;}
+    let (policy,quote,_,_)=setup();let trade=quote.terms()["swapId"].parse()?;
+    let pins=[SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()];
+    let mut rng=rand::rngs::StdRng::seed_from_u64(516);
+    let mut execution=Execution::begin(&metadata,&secrets,&quote,&policy,LocalRole::LitecoinFunder,
+        quote.commitment(),1000,&mut rng)?;
+    let before=execution.checkpoint()?;
+    let frame=execution.outgoing_signing_frame(1000)?;
+    assert_eq!(frame,execution.outgoing_signing_frame(1001)?);
+    assert_eq!(execution.checkpoint()?,before);
+    assert!(execution.submit_outgoing_signature(&frame,&signature(&frame,2),1000).is_err());
+    let mut altered=frame.to_vec();altered.push(b' ');
+    assert!(execution.submit_outgoing_signature(&altered,&signature(&altered,1),1000).is_err());
+    assert!(execution.submit_outgoing_signature(&frame,&signature(&frame,1),2000).is_err());
+    assert_eq!(execution.checkpoint()?,before);
+    // Simulate a crash after signed retention but before publishing the head.
+    let signed=storage::retain_signed_outgoing(&secrets,&quote,&policy,LocalRole::LitecoinFunder,
+        &before,&frame,&signature(&frame,1),1000)?;
+    drop(execution);
+    let mut execution=Execution::resume(&metadata,&secrets,trade,&policy,LocalRole::LitecoinFunder,pins)?;
+    assert_eq!(execution.outgoing_signing_frame(2000)?.as_slice(),frame.as_slice());
+    let recovered=execution.submit_outgoing_signature(&frame,signed.signature(),2000)?;
+    assert_eq!(recovered.bytes(),frame.as_slice());
+    let after=execution.checkpoint()?;assert_ne!(after,before);
+    execution.submit_outgoing_signature(&frame,signed.signature(),2001)?;
+    assert!(execution.submit_outgoing_signature(&frame,&signature(&frame,2),2001).is_err());
+    assert_eq!(execution.checkpoint()?,after);
+    drop(execution);std::fs::remove_dir_all(root)?;
+    Ok(())
+}
