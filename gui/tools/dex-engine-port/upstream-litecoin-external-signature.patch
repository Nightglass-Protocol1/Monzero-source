+    /// Read the local message for an external identity signer. Secret trade keys
+    /// remain in the engine; the returned message contains private view material.
+    pub fn outgoing_signing_frame(&self,now:u64)->Result<zeroize::Zeroizing<Vec<u8>>> {
+        let (head,_,quote,_,_)=self.load()?;
+        storage::local_signing_frame(&self.snapshots,&quote,&self.policy,self.role,
+            &head.outgoing_source.unwrap_or(head.checkpoint),now)
+    }
+
+    /// Publish an externally signed local message before allowing delivery. A
+    /// changed message or identity cannot replace the held keys or prior frame.
+    pub fn submit_outgoing_signature(&mut self,bytes:&[u8],signature:&[u8],now:u64)->Result<storage::OutgoingFrame> {
+        let (head,previous,quote,_,_)=self.load()?;
+        let source=head.outgoing_source.unwrap_or(head.checkpoint);
+        let outgoing=storage::retain_signed_outgoing(&self.snapshots,&quote,&self.policy,self.role,
+            &source,bytes,signature,now)?;
+        if head.outgoing_source.is_none() {
+            let successor=storage::recover_outgoing_acceptance(&self.snapshots,&quote,&self.policy,self.role,&source)?;
+            self.advance(head,&previous,successor,Some(source))?;
+        }
+        Ok(outgoing)
+    }
