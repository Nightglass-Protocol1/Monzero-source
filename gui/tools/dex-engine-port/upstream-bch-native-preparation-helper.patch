@@ -0,0 +1,58 @@
+//! Explicit consent for native deposit construction; never relay authority.
+use super::*;
+
+const REVIEW: &str = "monzero-bch-native-preparation-review-v1";
+pub struct NativePreparationReview { pub details: serde_json::Value, pub commitment: [u8;32] }
+pub struct SavedNativePreparation {
+    pub review: NativePreparationReview,
+    pub attempted_at: u64,
+    pub payment: Option<RelayedTransfer>,
+}
+fn review_details(intent: &Intent,quote: &VerifiedBchQuote) -> Result<NativePreparationReview> {
+    let details=json!({"schema":REVIEW,"action":"prepare-bch-native-funding",
+        "swapId":quote.terms()["swapId"],"quote":quote.commitment(),
+        "admission":intent.admission,"receipt":intent.receipt,"deployment":intent.deployment,
+        "genesis":intent.genesis,"wallet":intent.wallet,"account":intent.account,
+        "priority":intent.priority,"destination":intent.destination,
+        "amountAtoms":intent.amount.to_string(),"maximumFeeAtoms":intent.maximum_fee.to_string(),
+        "safetyBlocks":intent.safety_blocks});
+    Ok(NativePreparationReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+}
+impl AdmittedExecution<'_> {
+    /// Offline review of fresh construction terms. The actual preparation still
+    /// checks source funds, BCH confirmation and quote validity before mutation.
+    pub fn review_bch_native_preparation(&self,source: &NativeFundingSource,
+        deployment: [u8;32],safety_blocks: u32,now: u64) -> Result<NativePreparationReview> {
+        ensure!(optional(&self.metadata,&record_name(self.quote,"native-intent"))?.is_none(),
+            "BCH native preparation already attempted; inspect retained state");
+        ensure!(optional(&self.metadata,&record_name(self.quote,"native-pin"))?.is_none()
+            && optional(&Journal::open(&self.snapshots)?,&record_name(self.quote,"native-prepared"))?.is_none(),
+            "BCH native preparation exists without its original intent");
+        let intent=self.native_preparation_intent(source,deployment,safety_blocks,now)?;
+        review_details(&intent,self.quote)
+    }
+    /// Historical local records only. Missing or damaged prepared material is
+    /// never permission to reconstruct. No chain evidence or private proof leaks.
+    pub fn saved_bch_native_preparation(&self) -> Result<Option<SavedNativePreparation>> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH native preparation status role");
+        let intent=optional(&self.metadata,&record_name(self.quote,"native-intent"))?;
+        let pin=optional(&self.metadata,&record_name(self.quote,"native-pin"))?;
+        let private=optional(&Journal::open(&self.snapshots)?,&record_name(self.quote,"native-prepared"))?.map(Zeroizing::new);
+        if intent.is_none() {
+            ensure!(pin.is_none() && private.is_none(),"orphaned BCH native preparation");
+            return Ok(None)
+        }
+        let (intent,_)=self.retained_native_intent()?;
+        let review=review_details(&intent,self.quote)?;
+        let payment=if pin.is_none() && private.is_none() {None}
+            else {Some(self.recover_bch_native_funding()?)};
+        Ok(Some(SavedNativePreparation {review,attempted_at:intent.admitted_at,payment}))
+    }
+    pub async fn prepare_reviewed_bch_native_funding(&mut self,native: &mut NativeTransferRelay,
+        bch: &BchRpc,source: NativeFundingSource,safety_blocks: u32,now: u64,approved: &[u8;32])
+        -> Result<RelayedTransfer> {
+        let review=self.review_bch_native_preparation(&source,bch.deployment_commitment()?,safety_blocks,now)?;
+        ensure!(*approved==review.commitment,"BCH native preparation approval changed");
+        self.prepare_bch_native_funding(native,bch,source,safety_blocks,now).await
+    }
+}
