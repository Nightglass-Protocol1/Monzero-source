+//! Actual helper construction, offline restart and no repeat preparation.
+use super::*;
+pub(super) fn exercise(context: &Value,setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    pins: &NegotiationPins,base: u64,rpc: &BchRpc) -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==digest,"native preparation helper changed");
+    let files=PrivateStore::new()?;let quote=files.0.join("quote.json");save(&quote,&setup.quote.record()?)?;
+    let admission=files.0.join("admission.json");
+    save(&admission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":digest,"quoteFile":quote,"quoteCommitment":hex(setup.quote.commitment()),
+        "admittedAt":base,"tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"native-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":snapshots.0,"negotiationPins":pins}))?)?;
+    let cookie=files.0.join("bch.cookie");save(&cookie,context["cookie"].as_str().context("missing cookie")?.as_bytes())?;
+    let bch=files.0.join("bch.json");
+    save(&bch,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-funding-rpc-v1",
+        "port":context["port"],"wallet":"fixture","anchor":context["anchor"],"anchorScript":context["anchorScript"],
+        "cookieFile":cookie,"checkpointHeight":1,"checkpoint":context["checkpoint"],"subversion":context["subversion"]}))?)?;
+    let n=&context["native"];let login=files.0.join("native.login");
+    save(&login,format!("{}:{}",n["username"].as_str().context("username")?,n["password"].as_str().context("password")?).as_bytes())?;
+    let native=files.0.join("native.json");
+    save(&native,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-rpc-v1",
+        "daemonPort":n["daemonPort"],"walletPort":n["walletPort"],"loginFile":login}))?)?;
+    let wrapper=files.0.join("preparation.json");
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-preparation-v1",
+        "admissionConfigFile":admission,"bchRpcFile":bch,"nativeRpcFile":native,
+        "deploymentCommitment":hex(&rpc.deployment_commitment()?),"wallet":n["source"],
+        "account":0,"priority":1,"safetyBlocks":5}))?)?;
+    let call=|action: &str,approval: Option<&str>,success: bool| -> Result<Value> {
+        let id=uuid::Uuid::new_v4();
+        let mut request=json!({"schema":format!("monzero-bch-native-preparation-{action}-request-v1"),"requestId":id});
+        if let Some(approval)=approval {request["commitment"]=approval.into();}
+        let mut child=Command::new(&helper).arg(format!("--native-preparation-{action}-stdio-v1")).arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty() && output.stdout.len()<=16384);
+        let value:Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(value.as_object().unwrap().len(),7);assert_eq!(value["requestId"],id.to_string());
+        assert_eq!(value["schema"],format!("monzero-bch-native-preparation-{action}-response-v1"));
+        assert_eq!(value["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(value["executable"],false);assert_eq!(value["chainObserved"],false);Ok(value)
+    };
+    let before=contents(&metadata.0)?;let private=contents(&snapshots.0)?;
+    assert!(call("status",None,true)?["preparation"].is_null());
+    let review=call("review",None,true)?;
+    assert_eq!(review["review"]["details"]["amountAtoms"],"200000000000");
+    assert_eq!(review["review"]["details"]["maximumFeeAtoms"],"10000000000");
+    call("submit",Some(&"00".repeat(32)),false)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,private);
+    let approval=review["review"]["commitment"].as_str().context("review commitment")?;
+    let prepared=call("submit",Some(approval),true)?;
+    assert_eq!(prepared["preparation"]["state"],"prepared");assert_eq!(prepared["review"],review["review"]);
+    let retained=contents(&metadata.0)?;let private=contents(&snapshots.0)?;
+    call("submit",Some(approval),false)?;call("review",None,false)?;
+    std::fs::remove_file(&native)?;std::fs::remove_file(&bch)?;
+    std::fs::remove_file(&login)?;std::fs::remove_file(&cookie)?;
+    let saved=call("status",None,true)?;
+    assert_eq!(saved["preparation"],prepared["preparation"]);assert_eq!(saved["review"],prepared["review"]);
+    assert_eq!(contents(&metadata.0)?,retained);assert_eq!(contents(&snapshots.0)?,private);
+    Ok(())
+}
