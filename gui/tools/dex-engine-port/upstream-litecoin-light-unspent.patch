+//! Peer-reported UTXO candidates only. A server may omit spends or fabricate
+//! outputs; this response grants no signing, balance or unspentness authority.
+use super::*;
+use bitcoin::{Amount,OutPoint};
+use std::collections::BTreeSet;
+pub struct ReportedOutput {outpoint:OutPoint,height:u32,value:Amount}
+impl ReportedOutput {
+    pub fn outpoint(&self)->OutPoint {self.outpoint}
+    /// Zero denotes a mempool report, not a confirmed genesis output.
+    pub fn height(&self)->u32 {self.height}
+    pub fn value(&self)->Amount {self.value}
+}
+impl<S:AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    /// Query one script under an explicit 1..=1000 entry budget. This discloses
+    /// wallet interest to the configured server. Entries remain untrusted.
+    pub async fn reported_unspent(&mut self,script:&Script,maximum:usize)->Result<Vec<ReportedOutput>> {
+        ensure!(!script.is_empty() && script.len()<=10000 && (1..=1000).contains(&maximum),
+            "invalid Litecoin unspent request");
+        let outcome=self.unspent_inner(script,maximum).await;
+        if outcome.is_err() {self.usable=false;}outcome
+    }
+    async fn unspent_inner(&mut self,script:&Script,maximum:usize)->Result<Vec<ReportedOutput>> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Entry {tx_hash:String,tx_pos:u32,height:u32,value:u64}
+        let (_,bytes)=self.exchange("blockchain.scripthash.listunspent",json!([script_hash(script)]),maximum*192+1024).await?;
+        let entries:Vec<Entry>=result(&bytes)?;
+        ensure!(entries.len()<=maximum,"Litecoin unspent report exceeds entry budget");
+        let mut seen=BTreeSet::new();let mut outputs=Vec::with_capacity(entries.len());
+        for entry in entries {
+            let outpoint=OutPoint {txid:entry.tx_hash.parse().context("invalid Litecoin unspent transaction ID")?,vout:entry.tx_pos};
+            ensure!(!outpoint.is_null() && seen.insert(outpoint),"invalid or duplicate Litecoin reported output");
+            outputs.push(ReportedOutput {outpoint,height:entry.height,value:Amount::from_sat(entry.value)});
+        }
+        Ok(outputs)
+    }
+}
