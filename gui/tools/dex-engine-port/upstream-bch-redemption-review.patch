@@ -0,0 +1,41 @@
+//! Explicit approval review for the exact private redemption. Review contains
+//! no spend signature and grants no permission to broadcast by itself.
+use super::*;
+use crate::bch_rpc::BchRpc;
+use serde_json::{Value,json};
+
+const REVIEW: &str = "monzero-bch-redemption-relay-review-v1";
+pub struct RedemptionRelayReview {pub details: Value,pub commitment: [u8;32]}
+
+impl AdmittedExecution<'_> {
+    fn redemption_relay_materials(&self) -> Result<(RedemptionRelayReview,Record,[u8;32],u32)> {
+        let record = self.load_private_redemption()?.context("missing private BCH redemption")?;
+        let retained = summary(&record)?;
+        let (deployment,safety_blocks) = self.native_bch_observation_policy()?;
+        let transaction: Transaction = deserialize(&record.transaction)?;
+        ensure!(transaction.input.len()==1 && transaction.output.len()==1,"invalid retained BCH redemption shape");
+        let output = &transaction.output[0];let plan = self.quote.recovery_plan();
+        let fee = plan.terms().locked_atoms.checked_sub(output.value.to_sat()).context("invalid redemption fee")?;
+        ensure!(fee == plan.lock().terms().fee_atoms,"BCH redemption fee changed");
+        let details = json!({"schema":REVIEW,"action":"broadcast-bch-redemption",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),
+            "admission":record.admission,"successReceipt":record.receipt,"funding":record.funding,
+            "privateRedemption":retained.commitment(),"bchDeployment":deployment,
+            "network":self.quote.terms()["bchNetwork"],"genesis":self.quote.terms()["bchGenesis"],
+            "txid":retained.txid(),"fundingOutpoint":transaction.input[0].previous_output,
+            "destinationScript":output.script_pubkey.to_hex_string(),"payoutAtoms":output.value.to_sat().to_string(),
+            "feeAtoms":fee.to_string(),"preparedAt":record.prepared_at,
+            "minimumBchConfirmations":self.policy.bch_confirmations,
+            "minimumXmzConfirmations":self.policy.xmz_confirmations,"cancellationMarginBlocks":safety_blocks});
+        let commitment = hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((RedemptionRelayReview {details,commitment},record,deployment,safety_blocks))
+    }
+    /// Read-only approval details, including after commercial expiry. Approval
+    /// submission must independently revalidate exact bytes and both chains.
+    pub fn review_bch_redemption_relay(&self,bch: &BchRpc,now: u64) -> Result<RedemptionRelayReview> {
+        let (review,record,deployment,_) = self.redemption_relay_materials()?;
+        ensure!(now >= record.prepared_at,"BCH redemption review predates preparation");
+        ensure!(bch.deployment_commitment()? == deployment,"BCH redemption observer changed");
+        Ok(review)
+    }
+}
