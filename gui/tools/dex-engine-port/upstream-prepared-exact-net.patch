+/// Engine-owned prepared transaction, not serializable and not relay authority.
+/// There is deliberately no metadata accessor or broadcast method until a
+/// durable two-source intent can bind this exact transaction before dispatch.
+pub struct PreparedExactNet {
+    preview: ExactNetPreview,
+    terms: Value,
+    _metadata: zeroize::Zeroizing<String>,
+}
+
+impl PreparedExactNet {
+    pub fn preview(&self) -> &ExactNetPreview { &self.preview }
+    /// Public accounting and transaction identity only; contains no signing data.
+    pub fn terms(&self) -> &Value { &self.terms }
+}
+
+/// Prepare once with relay disabled. Caller owns the dedicated wallet service
+/// and independently establishes the approved sources and swap outcome.
+pub async fn prepare_exact_net_with_top_up(client: &NativeFundingRpc, request: &ExactNetRequest,
+    genesis: &str, top_up_txid: &str) -> Result<PreparedExactNet> {
+    let source = &request.source;
+    let mut params = exact_net_params(request)?;
+    ensure!(hash(genesis) && hash(&source.lock_txid) && hash(top_up_txid)
+        && top_up_txid != "0".repeat(64) && top_up_txid != source.lock_txid,
+        "invalid exact-net preparation context");
+    let before = client.snapshot().await?;
+    ensure!(before.genesis == genesis && hash(&before.tip_hash), "unexpected exact-net chain");
+    ensure!(client.opened_wallet(source.wallet.network()).await?.as_ref() == Some(&source.wallet),
+        "unexpected exact-net wallet");
+    let incoming = client.rpc(client.wallet, "incoming_transfers",
+        json!({"transfer_type":"available", "account_index":source.account})).await?;
+    let inputs = top_up_inputs(&incoming, request, top_up_txid)?;
+    params["get_tx_metadata"] = json!(true);
+    let response = client.rpc(client.wallet, "transfer", params).await?;
+    let prepared = check_prepared_exact_net(response, request, genesis, top_up_txid, &inputs)?;
+    ensure!(client.opened_wallet(source.wallet.network()).await?.as_ref() == Some(&source.wallet),
+        "exact-net wallet changed");
+    ensure!(client.snapshot().await? == before, "exact-net chain changed");
+    Ok(prepared)
+}
+
+fn check_prepared_exact_net(mut response: Value, request: &ExactNetRequest,
+    genesis: &str, top_up_txid: &str, inputs: &BTreeSet<String>) -> Result<PreparedExactNet> {
+    let metadata = match response.get_mut("tx_metadata").map(Value::take) {
+        Some(Value::String(value)) => zeroize::Zeroizing::new(value),
+        _ => anyhow::bail!("missing private exact-net metadata"),
+    };
+    ensure!(!metadata.is_empty() && metadata.len() <= 524288 && metadata.len() % 2 == 0
+        && metadata.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid private exact-net metadata");
+    response["tx_metadata"] = json!("");
+    let preview = check_exact_net(&response, request, inputs)?;
+    let source = &request.source;
+    let terms = json!({"schema":"monzero-exact-net-prepared-accounting-v1",
+        "genesis":genesis,"wallet":source.wallet.to_string(),"lockTxid":source.lock_txid,
+        "topUpTxid":top_up_txid,"totalAtoms":source.locked.atom_string(),
+        "principalAtoms":request.principal.atom_string(),"destination":source.destination.to_string(),
+        "reserveReturnDestination":request.reserve_return.to_string(),
+        "reserveReturnAtoms":preview.reserve_return.atom_string(),
+        "feeAtoms":preview.network_fee.atom_string(),"maximumFeeAtoms":source.maximum_fee.atom_string(),
+        "account":source.account,"priority":source.priority,"txid":response["tx_hash"],
+        "weight":number(&response,"weight")?});
+    Ok(PreparedExactNet { preview, terms, _metadata: metadata })
+}
