+++ b/swap-machine/src/litecoin_light/vault/signing/review.rs
@@ -0,0 +1,63 @@
+//! Immutable transaction-content review. Inputs are caller-supplied evidence,
+//! not an unspentness proof; consent and durable reservations remain external.
+use super::*;
+use bitcoin::{Amount,OutPoint};
+
+pub struct OwnedInput {
+    pub outpoint:OutPoint,
+    pub prevout:TxOut,
+    pub branch:Branch,
+    pub index:u32,
+}
+pub struct SpendReview {
+    account:PublicAccount,
+    transaction:Transaction,
+    inputs:Vec<OwnedInput>,
+    fee:Amount,
+}
+impl SpendReview {
+    /// Exactly one payment followed by optional wallet change. Output order and
+    /// values are retained, not reconstructed after approval. The caller must
+    /// separately authenticate prevouts and establish spending authorization.
+    pub fn new(account:&PublicAccount,transaction:Transaction,inputs:Vec<OwnedInput>,
+        payment:&TxOut,change_index:Option<u32>,maximum_fee:Amount)->Result<Self> {
+        ensure!(!inputs.is_empty() && inputs.len()<=1000 && transaction.input.len()==inputs.len(),
+            "invalid Litecoin spend input count");
+        ensure!(payment.value.to_sat()>0 && !payment.script_pubkey.is_empty() && payment.script_pubkey.len()<=10000,
+            "invalid Litecoin payment");
+        ensure!(transaction.output.len()==if change_index.is_some() {2}else{1}
+            && transaction.output.first()==Some(payment),"Litecoin payment outputs changed");
+        if let Some(index)=change_index {
+            let change=&transaction.output[1];
+            ensure!(change.value.to_sat()>0 && &change.script_pubkey==account.derive(Branch::Change,index)?.address().script_pubkey(),
+                "Litecoin change does not match wallet");
+        }
+        let mut seen=std::collections::HashSet::new();let mut total=0u64;
+        for (input,owned) in transaction.input.iter().zip(&inputs) {
+            ensure!(input.previous_output==owned.outpoint && !owned.outpoint.is_null() && seen.insert(owned.outpoint)
+                && input.script_sig.is_empty() && input.witness.is_empty(),"invalid Litecoin unsigned input");
+            ensure!(owned.prevout.value.to_sat()>0 && account.matches_script(owned.branch,owned.index,&owned.prevout.script_pubkey)?,
+                "Litecoin input ownership mismatch");
+            total=total.checked_add(owned.prevout.value.to_sat()).context("Litecoin input amount overflow")?;
+        }
+        let output=transaction.output.iter().try_fold(0u64,|sum,out|sum.checked_add(out.value.to_sat()).context("Litecoin output amount overflow"))?;
+        let fee=Amount::from_sat(total.checked_sub(output).context("Litecoin outputs exceed inputs")?);
+        ensure!(fee<=maximum_fee,"Litecoin fee exceeds approved maximum");
+        Ok(Self {account:PublicAccount::from_descriptor(&account.descriptor(),account.network())?,transaction,inputs,fee})
+    }
+    pub fn transaction(&self)->&Transaction {&self.transaction}
+    pub fn fee(&self)->Amount {self.fee}
+    /// Signs only the retained transaction; does not submit it or establish
+    /// freshness, unspentness, relay policy or user approval.
+    pub fn sign(&self,seed:&SecretSeed)->Result<Transaction> {
+        let mut signed=self.transaction.clone();
+        for (index,input) in self.inputs.iter().enumerate() {
+            signed.input[index].witness=seed.sign_p2wpkh_input(&self.account,input.branch,input.index,
+                &self.transaction,index,&input.prevout)?;
+        }
+        ensure!(signed.compute_txid()==self.transaction.compute_txid(),"Litecoin signing changed transaction identity");
+        Ok(signed)
+    }
+}
