+use super::*;
+fn fixture()->Result<(SecretSeed,PublicAccount,Transaction,Vec<OwnedInput>)> {
+    let (seed,account,tx,prevout)=super::super::tests::fixture()?;
+    let input=OwnedInput {outpoint:tx.input[0].previous_output,prevout,branch:Branch::Receive,index:3};
+    Ok((seed,account,tx,vec![input]))
+}
+#[test]
+fn reviewed_payment_signs_exact_transaction_and_fee()->Result<()> {
+    let (seed,account,mut tx,inputs)=fixture()?;
+    tx.output[0].value=Amount::from_sat(60000);
+    tx.output.push(TxOut {value:Amount::from_sat(39000),script_pubkey:account.derive(Branch::Change,1)?.address().script_pubkey().clone()});
+    let payment=tx.output[0].clone();
+    let review=SpendReview::new(&account,tx.clone(),inputs,&payment,Some(1),Amount::from_sat(1000))?;
+    assert_eq!(review.fee(),Amount::from_sat(1000));assert_eq!(review.transaction(),&tx);
+    let signed=review.sign(&seed)?;assert_eq!(signed.output,tx.output);assert_eq!(signed.input[0].witness.len(),2);
+    assert!(review.transaction().input[0].witness.is_empty());
+    let other=SecretSeed::from_bytes(Zeroizing::new([43;32]));assert!(review.sign(&other).is_err());Ok(())
+}
+#[test]
+fn review_rejects_output_substitution_fees_and_input_mismatch()->Result<()> {
+    for mode in 0..7 {
+        let (_,account,mut tx,mut inputs)=fixture()?;let payment=tx.output[0].clone();
+        let mut limit=Amount::from_sat(1000);
+        match mode {
+            0=>limit=Amount::from_sat(999),
+            1=>tx.output[0].value=Amount::from_sat(100001),
+            2=>tx.output.push(payment.clone()),
+            3=>inputs[0].outpoint.vout=1,
+            4=>inputs[0].index=4,
+            5=>tx.input[0].witness.push([1]),
+            _=>tx.output[0].script_pubkey=account.derive(Branch::Change,1)?.address().script_pubkey().clone(),
+        }
+        assert!(SpendReview::new(&account,tx,inputs,&payment,None,limit).is_err());
+    }
+    let (_,account,mut tx,inputs)=fixture()?;let payment=tx.output[0].clone();
+    tx.output.push(TxOut {value:Amount::from_sat(1),script_pubkey:account.derive(Branch::Receive,0)?.address().script_pubkey().clone()});
+    assert!(SpendReview::new(&account,tx,inputs,&payment,Some(0),Amount::from_sat(1000)).is_err());Ok(())
+}
