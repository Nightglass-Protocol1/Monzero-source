+//! BCHN v29 sendrawtransaction uses allowhighfees, not a numeric fee rate.
+use super::*;
+use bitcoin::{hex::DisplayHex,Txid};
+use swap_core::bch::funding::SignedFunding;
+
+impl BchRpc {
+    /// Only the admitted executor may call this after retaining relay approval.
+    /// An error may follow successful broadcast; never retry automatically.
+    pub(crate) async fn relay_funding(&self,signed: &SignedFunding,deadline: std::time::Instant) -> Result<Txid> {
+        ensure!(std::time::Instant::now() < deadline,"BCH funding relay quote expired before preflight");
+        self.chain_state().await?;
+        self.wallet_ready().await?;
+        let raw = serialize(signed.transaction()).to_lower_hex_string();
+        ensure!(std::time::Instant::now() < deadline,"BCH funding relay quote expired during preflight");
+        let reply = self.rpc(false,"sendrawtransaction",json!([raw,false])).await?;
+        let txid: Txid = serde_json::from_str(reply.get())?;
+        ensure!(txid == signed.lock_outpoint().txid,"BCH relay returned another transaction ID");
+        Ok(txid)
+    }
+}
