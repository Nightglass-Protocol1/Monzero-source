+//! Explicit funding publication, after private recovery retention. A durable
+//! attempt precedes RPC; ambiguous results never authorize automatic retry.
+use super::*;
+use crate::bch_rpc::{BchRpc,observation::FundingStatus};
+use bitcoin::{consensus::serialize,Txid};
+use serde_json::{Value,json};
+use swap_core::bch::funding::SignedFunding;
+
+const REVIEW: &str = "monzero-bch-funding-relay-review-v1";
+const ATTEMPT: &str = "monzero-bch-funding-relay-intent-v1";
+const ACK: &str = "monzero-bch-funding-relay-ack-v1";
+pub struct FundingRelayReview { pub details: Value, pub commitment: [u8;32] }
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum FundingRelayState {
+    /// Includes an attempt interrupted before sending. Observe the exact txid;
+    /// absence does not prove it was never broadcast or permit retransmission.
+    Attempted { txid: Txid },
+    /// The node returned the exact txid, not proof of confirmation or finality.
+    Acknowledged { txid: Txid },
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent { schema: String, review: [u8;32], approved_at: u64 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack { schema: String, intent: [u8;32], txid: Txid }
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+impl AdmittedExecution<'_> {
+    fn funding_relay_materials(&self) -> Result<(FundingRelayReview,SignedFunding,u64,locks::Intent)> {
+        let prepared = self.prepared_bch_funding()?.context("BCH funding preparation is absent")?;
+        let (locked,_) = self.funding_lock_intent(&prepared)?;
+        let (signed,signed_at) = self.restore_signed_bch_funding()?.context("BCH signed funding is absent")?;
+        let recovery = self.retained_bch_recovery()?.context("BCH private recovery must be retained before funding relay")?;
+        let details = json!({"schema":REVIEW,"action":"broadcast-funding",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),
+            "admission":self.admission_digest()?,"deployment":locked.deployment,
+            "network":self.quote.terms()["bchNetwork"],"genesis":self.quote.terms()["bchGenesis"],
+            "expiresAt":self.quote.terms()["expiresAt"],"fundingTxid":signed.lock_outpoint().txid,
+            "contractVout":signed.lock_outpoint().vout,
+            "signedBytes":hash("monzero-bch-exact-signed-funding-v1",&serialize(signed.transaction())),
+            "preparation":prepared.commitment(),"feeAtoms":prepared.preview().fee().to_sat(),
+            "outputs":signed.transaction().output.iter().map(|o|json!({"atoms":o.value.to_sat(),
+                "script":o.script_pubkey.to_hex_string()})).collect::<Vec<_>>(),
+            "privateRecovery":recovery.commitment(),"cancelTxid":recovery.cancel().compute_txid(),
+            "refundTxid":recovery.refund_txid()?,"punishTxid":recovery.punish().compute_txid()});
+        let commitment = hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((FundingRelayReview {details,commitment},signed,signed_at.max(recovery.prepared_at()),locked))
+    }
+
+    /// Display this independently of sign-only approval. No network mutation.
+    pub fn review_bch_funding_relay(&self,backend: &BchRpc,now: u64) -> Result<FundingRelayReview> {
+        self.quote.check_policy(self.policy,now)?;
+        let (review,_,prepared_at,locked) = self.funding_relay_materials()?;
+        ensure!(now >= prepared_at && backend.deployment_commitment()? == locked.deployment,
+            "BCH funding relay predates recovery or targets another deployment");
+        Ok(review)
+    }
+
+    fn relay_intent(&self,review: &FundingRelayReview,prepared_at: u64) -> Result<Option<(Intent,[u8;32])>> {
+        let Some(bytes) = optional(&self.metadata,&record_name(self.quote,"relay-intent"))? else {return Ok(None)};
+        ensure!(bytes.len() <= 4096,"oversized BCH relay intent");
+        let intent: Intent = serde_json::from_slice(&bytes)?;
+        ensure!(intent.schema == ATTEMPT && intent.review == review.commitment
+            && intent.approved_at >= prepared_at && serde_json::to_vec(&intent)? == bytes,
+            "BCH relay intent differs from retained approval or recovery");
+        self.quote.check_policy(self.policy,intent.approved_at)?;
+        Ok(Some((intent,hash(ATTEMPT,&bytes))))
+    }
+
+    /// Historical local attempt status, including after quote expiry. Use the
+    /// separate read-only funding observer for current chain/mempool evidence.
+    pub fn bch_funding_relay_state(&self) -> Result<Option<FundingRelayState>> {
+        let (review,signed,prepared_at,_) = self.funding_relay_materials()?;
+        let ack = optional(&self.metadata,&record_name(self.quote,"relay-ack"))?;
+        let Some((_,intent)) = self.relay_intent(&review,prepared_at)? else {
+            ensure!(ack.is_none(),"BCH relay acknowledgement has no original intent");
+            return Ok(None)
+        };
+        let txid = signed.lock_outpoint().txid;
+        let Some(bytes) = ack else {return Ok(Some(FundingRelayState::Attempted {txid}))};
+        ensure!(bytes.len() <= 4096,"oversized BCH relay acknowledgement");
+        let ack: Ack = serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema == ACK && ack.intent == intent && ack.txid == txid
+            && serde_json::to_vec(&ack)? == bytes,"BCH relay acknowledgement changed");
+        Ok(Some(FundingRelayState::Acknowledged {txid}))
+    }
+
+    /// Broadcast once, only after explicit approval and fresh input checks.
+    /// Any attempt without a retained acknowledgement requires observation and
+    /// separate reconciliation; never re-sign, replace inputs or auto-retransmit.
+    pub async fn relay_bch_funding(&mut self,backend: &BchRpc,approved: &[u8;32],now: u64) -> Result<Txid> {
+        let started = std::time::Instant::now();
+        let review = self.review_bch_funding_relay(backend,now)?;
+        let expires = self.quote.terms()["expiresAt"].parse::<u64>().context("invalid BCH quote expiry")?;
+        let deadline = started.checked_add(std::time::Duration::from_secs(expires.checked_sub(now)
+            .context("BCH quote expired before relay")?)).context("BCH relay deadline overflow")?;
+        ensure!(review.commitment == *approved,"BCH funding relay approval is stale or mismatched");
+        let (_,signed,prepared_at,locked) = self.funding_relay_materials()?;
+        if let Some((intent,_)) = self.relay_intent(&review,prepared_at)? {
+            ensure!(now >= intent.approved_at,"BCH funding relay time moved backwards");
+        }
+        match self.bch_funding_relay_state()? {
+            Some(FundingRelayState::Acknowledged {txid}) => return Ok(txid),
+            Some(FundingRelayState::Attempted {..}) => anyhow::bail!("BCH funding relay has an uncertain result; observe without retransmitting"),
+            None => (),
+        }
+        ensure!(backend.observe_funding(&signed).await?.status() == FundingStatus::Unobserved,
+            "BCH funding already observed; reconcile without sending");
+        let prepared = self.prepared_bch_funding()?.context("BCH funding preparation is absent")?;
+        backend.observe_funding_inputs(prepared.preview(),&locked.change_address,locked.minimum_confirmations).await?;
+        let wallet_locks = backend.locked_outpoints().await?;
+        ensure!(prepared.preview().transaction().input.iter().all(|i|wallet_locks.contains(&i.previous_output)),
+            "BCH funding inputs lost wallet locks before relay");
+        let intent = Intent {schema:ATTEMPT.into(),review:*approved,approved_at:now};
+        let bytes = serde_json::to_vec(&intent)?;
+        self.metadata.retain(&record_name(self.quote,"relay-intent"),&bytes)?;
+        let txid = backend.relay_funding(&signed,deadline).await?;
+        let ack = Ack {schema:ACK.into(),intent:hash(ATTEMPT,&bytes),txid};
+        self.metadata.retain(&record_name(self.quote,"relay-ack"),&serde_json::to_vec(&ack)?)?;
+        Ok(txid)
+    }
+}
