+use super::*;
+use agreement::execution::funding::relay::FundingRelayState;
+use swap_core::bch::funding::SignedFunding;
+
+pub(super) async fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: &Server,rpc: &BchRpc,signed: &SignedFunding) -> Result<()> {
+    let baseline: Vec<_> = std::fs::read_dir(&metadata.0)?.map(|entry| {
+        let entry = entry?; Ok((entry.file_name(),std::fs::read(entry.path())?))
+    }).collect::<std::io::Result<_>>()?;
+    let swap = &setup.quote.terms()["swapId"];
+    let txid = signed.lock_outpoint().txid;
+    for mode in 0..=6 {
+        let metadata = PrivateStore::new()?;
+        for (name,bytes) in &baseline {
+            let path = metadata.0.join(name); std::fs::write(&path,bytes)?;
+            std::fs::set_permissions(path,std::fs::Permissions::from_mode(0o600))?;
+        }
+        let intent = metadata.0.join(format!("{swap}.bch-funding-relay-intent"));
+        let ack = metadata.0.join(format!("{swap}.bch-funding-relay-ack"));
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        {
+            let mut state = server.state.lock().unwrap();
+            state.observed = Some(signed.transaction().clone()); state.observed_vout = signed.lock_outpoint().vout;
+            state.observation_mode = 2; state.observation_chain_calls = 0;
+            state.relay_mode = mode; state.relay_intent = Some(intent.clone()); state.locked = true;
+        }
+        let calls = server.state.lock().unwrap().relay_calls;
+        let review = execution.review_bch_funding_relay(rpc,1018)?;
+        assert_eq!(review.details["action"],"broadcast-funding");
+        assert_eq!(review.details["fundingTxid"],txid.to_string());
+        assert_eq!(review.details["feeAtoms"],1000);
+        assert!(execution.bch_funding_relay_state()?.is_none());
+        if mode == 0 {
+            assert!(rpc.relay_funding(signed,std::time::Instant::now()).await.is_err());
+            let pin = metadata.0.join(format!("{swap}.bch-funding-recovery-pin"));
+            let saved = std::fs::read(&pin)?; std::fs::remove_file(&pin)?;
+            assert!(execution.review_bch_funding_relay(rpc,1018).is_err());
+            std::fs::write(&pin,saved)?; std::fs::set_permissions(&pin,std::fs::Permissions::from_mode(0o600))?;
+            let sign_only = execution.review_bch_funding_signing(rpc,1018)?;
+            assert!(execution.relay_bch_funding(rpc,&sign_only.commitment,1018).await.is_err());
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,2000).await.is_err());
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1014).await.is_err());
+            server.state.lock().unwrap().locked = false;
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1018).await.is_err());
+            server.state.lock().unwrap().locked = true;
+            for observed in [0,1,3] {
+                server.state.lock().unwrap().observation_mode = observed;
+                assert!(execution.relay_bch_funding(rpc,&review.commitment,1018).await.is_err());
+            }
+            server.state.lock().unwrap().observation_mode = 2;
+            assert!(!intent.exists()); assert!(!ack.exists());
+            assert_eq!(server.state.lock().unwrap().relay_calls,calls);
+        }
+        let result = execution.relay_bch_funding(rpc,&review.commitment,1018).await;
+        assert_eq!(server.state.lock().unwrap().relay_calls,calls+1);
+        assert!(intent.is_file());
+        let expected = if mode == 0 {
+            assert_eq!(result?,txid); assert!(ack.is_file());
+            assert_eq!(execution.relay_bch_funding(rpc,&review.commitment,1019).await?,txid);
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1017).await.is_err());
+            FundingRelayState::Acknowledged {txid}
+        } else {
+            assert!(result.is_err()); assert!(!ack.exists());
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1019).await.is_err());
+            FundingRelayState::Attempted {txid}
+        };
+        drop(execution);
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        assert_eq!(execution.bch_funding_relay_state()?,Some(expected));
+        // Historical state survives expiry; submission cannot renew approval.
+        assert!(execution.relay_bch_funding(rpc,&review.commitment,2000).await.is_err());
+        if mode == 0 {
+            let saved = std::fs::read(&ack)?; std::fs::write(&ack,b"{}")?;
+            assert!(execution.bch_funding_relay_state().is_err());
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1019).await.is_err());
+            std::fs::write(&ack,saved)?;
+            let saved = std::fs::read(&intent)?; std::fs::remove_file(&intent)?;
+            assert!(execution.bch_funding_relay_state().is_err());
+            std::fs::write(&intent,saved)?; std::fs::set_permissions(&intent,std::fs::Permissions::from_mode(0o600))?;
+        } else {
+            // Even an unobserved exact transaction never permits automatic retry.
+            assert!(execution.relay_bch_funding(rpc,&review.commitment,1020).await.is_err());
+        }
+        assert_eq!(server.state.lock().unwrap().relay_calls,calls+1);
+    }
+    let mut state = server.state.lock().unwrap();
+    state.observed = None; state.observation_mode = 0; state.relay_mode = 0;
+    assert_eq!(state.sign_calls,1);
+    Ok(())
+}
