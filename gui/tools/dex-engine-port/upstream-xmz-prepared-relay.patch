+
+fn parse_prepared(mut response: Value, amount: XmzAmount, maximum_fee: XmzAmount)
+    -> Result<(RelayedTransfer, zeroize::Zeroizing<String>)> {
+    let metadata = match response.get_mut("tx_metadata").map(Value::take) {
+        Some(Value::String(value)) => zeroize::Zeroizing::new(value),
+        _ => anyhow::bail!("missing private prepared metadata"),
+    };
+    ensure!(!metadata.is_empty() && metadata.len() <= 524288 && metadata.len() % 2 == 0
+        && metadata.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid private prepared metadata");
+    response["tx_metadata"] = json!("");
+    let summary = parse_relay(&response, amount)?;
+    ensure!(summary.fee.atoms() <= maximum_fee.atoms(), "prepared fee exceeds approved ceiling");
+    Ok((summary, metadata))
