+
+/// The Host header value for a URI: the host, plus the port when it is not the scheme's default.
+fn host_header(uri: &Uri) -> Result<String, Error> {
+  let host = uri.host().ok_or(Error::MissingHost)?;
+  let default_port = match uri.scheme_str() {
+    Some("https") => 443,
+    _ => 80,
+  };
+  Ok(match uri.port_u16() {
+    Some(port) if port != default_port => format!("{host}:{port}"),
+    _ => host.to_string(),
+  })
+}
