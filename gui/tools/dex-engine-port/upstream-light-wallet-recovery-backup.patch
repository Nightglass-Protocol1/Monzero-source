+/// Authenticate a backup against the exact current vault and allocation record.
+/// Counts alone are insufficient: different reservation identities can have the
+/// same counts. This is point-in-time evidence, not proof of complete history.
+pub fn verify_current(bundle:&[u8],vault:&MnemonicVault,book:&AddressBook,password:&[u8])->Result<BackupInfo> {
+    let decoded=decode(bundle,password,vault.network,vault.wallet)?;
+    let (descriptor,record)=book.backup_parts()?;
+    drop(vault.unlock_for_account(password,&descriptor)?);
+    ensure!(decoded.vault==vault.bytes && decoded.book==record
+        && serde_json::to_vec(&decoded.account.descriptor())?==serde_json::to_vec(&descriptor)?,
+        "mnemonic backup does not match current wallet records");
+    Ok(BackupInfo {digest:sha256::Hash::hash(bundle),account:decoded.account,
+        wallet:vault.wallet,allocated:decoded.allocated})
+}
+
+/// Retain an immutable, authenticated snapshot in a caller-selected private
+/// directory. Recovery must use a separate directory from the initial backup.
+/// An interrupted publication can be retried without generating new ciphertext.
+/// An existing stale or conflicting backup is rejected, never overwritten.
+/// This does not activate a wallet or certify scan coverage or trade recovery.
+pub fn retain_current(directory:&Path,vault:&MnemonicVault,book:&AddressBook,password:&[u8])->Result<BackupInfo> {
+    // Authenticate before even opening a destination journal.
+    let (descriptor,_)=book.backup_parts()?;
+    drop(vault.unlock_for_account(password,&descriptor)?);
+    let journal=Journal::open(directory)?;
+    let bundle=match journal.read(FILE) {
+        Ok(bundle)=>bundle,
+        Err(error) if error.downcast_ref::<std::io::Error>()
+            .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>export(vault,book,password)?,
+        Err(error)=>return Err(error),
+    };
+    verify_current(&bundle,vault,book,password)?;
+    journal.retain(FILE,&bundle)?;
+    let retained=journal.read(FILE)?;
+    ensure!(retained==bundle,"mnemonic recovery backup read-back mismatch");
+    verify_current(&retained,vault,book,password)
+}
