-//! Exact Bitcoin lock submission intent. No RPC, signature validation, broadcast
+//! Exact Bitcoin lock submission intent and read-only observations. No signature validation, broadcast
 //! authority or acceptance receipt. Never infer rejection from a missing receipt.
 use super::*;
 
 const SUBMISSION_DOMAIN: &[u8] = b"monzero-native-bitcoin-submission-v1\0";
 
+#[derive(Clone, PartialEq, Eq)]
+pub struct BitcoinSubmissionSnapshot {
+    pub genesis: bitcoin::BlockHash,
+    pub tip: bitcoin::BlockHash,
+}
+
+/// Read-only node interface. Errors must not be converted into absent results.
+#[async_trait::async_trait]
+pub trait BitcoinSubmissionObserver: Sync {
+    async fn snapshot(&self) -> Result<BitcoinSubmissionSnapshot>;
+    /// None means only that this observer did not find it, never proof of rejection.
+    async fn transaction(&self, id: bitcoin::Txid) -> Result<Option<bitcoin::Transaction>>;
+}
+
+/// Neither result authorizes another submission or proves confirmation/finality.
+#[derive(Debug, PartialEq, Eq)]
+pub enum BitcoinSubmissionObservation { NotObserved, ExactTransactionObserved }
+
+async fn observe(record: &RecordedBitcoinSubmission, expected_genesis: bitcoin::BlockHash,
+    observer: &impl BitcoinSubmissionObserver) -> Result<BitcoinSubmissionObservation> {
+    let before=observer.snapshot().await?;
+    ensure!(before.genesis==expected_genesis,"wrong Bitcoin submission chain");
+    let transaction=observer.transaction(record.transaction.compute_txid()).await?;
+    let after=observer.snapshot().await?;
+    ensure!(after==before,"Bitcoin submission chain changed during observation");
+    match transaction {
+        Some(transaction)=>{
+            ensure!(transaction==record.transaction,"observed Bitcoin submission bytes differ");
+            Ok(BitcoinSubmissionObservation::ExactTransactionObserved)
+        }
+        None=>Ok(BitcoinSubmissionObservation::NotObserved),
+    }
+}
