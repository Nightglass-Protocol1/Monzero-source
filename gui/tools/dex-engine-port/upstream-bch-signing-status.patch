     /// Render this exact review in the approval UI. Preparing a review does not
     /// approve anything or assert that advisory locks still exist in the wallet.
     pub fn review_bch_funding_signing(&self, backend: &BchRpc, now: u64) -> Result<SigningReview> {
+        self.review_bch_funding_signing_for_deployment(&backend.deployment_commitment()?,now)
+    }
+
+    /// Offline review bound to the caller's independently pinned deployment.
+    pub fn review_bch_funding_signing_for_deployment(&self,deployment: &[u8;32],now: u64)
+        -> Result<SigningReview> {
         self.quote.check_policy(self.policy,now)?;
         let (review,_,locked) = self.signing_review()?;
-        ensure!(now >= locked.admitted_at && backend.deployment_commitment()? == locked.deployment,
+        ensure!(now >= locked.admitted_at && *deployment == locked.deployment,
             "BCH signing deployment or time differs from retained wallet lock intent");
         Ok(review)
+    }
+
+    /// Read retained signing state without RPC, including after quote expiry.
+    /// An intent without signed funding requires explicit reconciliation, never
+    /// a signing retry. Absence of intent is not evidence of wallet/chain state.
+    pub fn saved_bch_signing(&self,deployment: &[u8;32]) -> Result<SavedBchSigning> {
+        let (review,_,locked) = self.signing_review()?;
+        ensure!(*deployment == locked.deployment,"saved BCH signing deployment changed");
+        let Some(_) = optional(&self.metadata,&record_name(self.quote,"signing-intent"))? else {
+            ensure!(optional(&self.metadata,&record_name(self.quote,"signed"))?.is_none()
+                && optional(&self.metadata,&record_name(self.quote,"reconciliation"))?.is_none(),
+                "BCH signing result or reconciliation lacks original intent");
+            return Ok(SavedBchSigning {review,intent:None,signed:None})
+        };
+        let (_,bytes,intent) = self.retained_signing_intent()?;
+        let signed = self.signed_bch_funding()?;
+        Ok(SavedBchSigning {review,intent:Some(SavedSigningIntent {
+            commitment:hash(ATTEMPT,&bytes),approved_at:intent.approved_at}),signed})
     }
 
