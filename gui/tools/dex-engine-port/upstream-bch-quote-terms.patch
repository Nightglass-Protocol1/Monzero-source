+use super::*;
+use ed25519_dalek::{Signer, SigningKey};
+use bitcoin::secp256k1::{Secp256k1, SecretKey};
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+fn fixture() -> (Policy, BTreeMap<String,String>) {
+    let policy = Policy { bch_network:"bch-regtest".into(), bch_genesis:"b".repeat(64),
+        xmz_network:XmzNetwork::Mainnet, xmz_genesis:"a".repeat(64),
+        bch_confirmations:2, xmz_confirmations:10, cancel_blocks:20, punish_blocks:30,
+        maximum_bch_atoms:1_000_000, maximum_xmz_atoms:2_000_000,
+        maximum_bch_funding_fee:5000, maximum_xmz_fee:1000,
+        minimum_covenant_fee:500, maximum_covenant_fee:3000, minimum_output_atoms:546 };
+    let identity = |tag| hex(&SigningKey::from_bytes(&[tag;32]).verifying_key().to_bytes());
+    let key = |tag| hex(&PublicKey::from_secret_key(&Secp256k1::new(), &SecretKey::from_slice(&[tag;32]).unwrap()).serialize());
+    let xmz = include_str!("../../../swap-core/src/xmz_address_vectors.txt").lines().next().unwrap();
+    let t = serde_json::json!({"schema":"monzero-native-bch-xmz-quote-v1",
+        "quoteId":"11111111-1111-4111-8111-111111111111", "swapId":"22222222-2222-4222-8222-222222222222",
+        "bchFunder":identity(1), "xmzFunder":identity(2), "bchNetwork":policy.bch_network,
+        "bchGenesis":policy.bch_genesis, "xmzNetwork":"xmz-mainnet", "xmzGenesis":policy.xmz_genesis,
+        "bchAtoms":"100000", "xmzAtoms":"101000", "xmzPayoutAtoms":"100000",
+        "bchPayoutScript":format!("76a914{}88ac","03".repeat(20)),
+        "bchRefundScript":format!("76a914{}88ac","04".repeat(20)), "xmzPayout":xmz, "xmzRefund":xmz,
+        "bchSigningKey":key(3), "xmzSigningKey":key(4), "bchFundingFeeMaxAtoms":"5000",
+        "bchLockFeeAtoms":"1000", "bchRecoveryFeeAtoms":"2000", "xmzFundingFeeMaxAtoms":"1000",
+        "xmzClaimFeeMaxAtoms":"1000", "xmzRefundFeeMaxAtoms":"1000", "bchConfirmations":"2",
+        "xmzConfirmations":"10", "cancelBlocks":"20", "punishBlocks":"30",
+        "bchMinimumOutputAtoms":"546", "expiresAt":"2000", "appFeeXmzAtoms":"0"});
+    (policy, serde_json::from_value(t).unwrap())
+}
+fn signed(t: &BTreeMap<String,String>, p: &Policy, now: u64) -> Result<VerifiedBchQuote> {
+    let payload = serde_json::to_vec(t)?;
+    let b = SigningKey::from_bytes(&[1;32]); let x = SigningKey::from_bytes(&[2;32]);
+    let message = |role| {
+        let d = format!("monzero-native-bch-xmz-quote-v1-{role}");
+        let mut m = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",d.len(),d,payload.len()).into_bytes();
+        m.extend_from_slice(&payload); m
+    };
+    VerifiedBchQuote::verify(&payload, now, p, &b.verifying_key().to_bytes(), &x.verifying_key().to_bytes(),
+        &b.sign(&message("bch-funder")).to_bytes(), &x.sign(&message("xmz-funder")).to_bytes())
+}
+#[test]
+fn signed_terms_construct_exact_recovery_stages() -> Result<()> {
+    let (policy, terms) = fixture(); let quote = signed(&terms, &policy, 1000)?;
+    let plan = quote.recovery_plan();
+    assert_eq!(plan.recovery_atoms(),99_000); assert_eq!(plan.final_recovery_atoms(),97_000);
+    assert_eq!(plan.lock().terms().delay_blocks,20); assert_eq!(plan.recovery().terms().delay_blocks,30);
+    assert_eq!(plan.lock().terms().timeout_destination,plan.recovery().script_pubkey());
+    assert_eq!(hex(plan.lock().terms().redeem_destination.as_bytes()),terms["bchPayoutScript"]);
+    assert_eq!(hex(plan.recovery().terms().redeem_destination.as_bytes()),terms["bchRefundScript"]);
+    assert_eq!(quote.xmz_payout().to_string(),terms["xmzPayout"]);
+    assert_eq!(quote.xmz_refund().to_string(),terms["xmzRefund"]);
+    assert!(quote.check_policy(&policy,2000).is_err());
+    // Even valid, jointly signed changes produce different commitments and scripts.
+    let mut changed = terms.clone(); changed.insert("bchLockFeeAtoms".into(),"1001".into());
+    let other = signed(&changed,&policy,1000)?;
+    assert_ne!(quote.commitment(),other.commitment());
+    assert!(plan.verify_scripts(other.recovery_plan().lock().redeem_script(),
+        other.recovery_plan().recovery().redeem_script()).is_err());
+    Ok(())
+}
+#[test]
+fn jointly_signed_invalid_terms_are_rejected() {
+    let (policy, terms) = fixture();
+    for (field, value) in [("bchAtoms","0"),("bchAtoms","0100000"),("bchAtoms","1000001"),
+        ("bchAtoms","18446744073709551616"),("bchAtoms","3000"),
+        ("xmzAtoms","2000001"),("xmzPayoutAtoms","101001"),("xmzPayoutAtoms","100001"),
+        ("bchFundingFeeMaxAtoms","5001"),("xmzFundingFeeMaxAtoms","1001"),
+        ("xmzClaimFeeMaxAtoms","1001"),("xmzRefundFeeMaxAtoms","0"),
+        ("bchLockFeeAtoms","499"),("bchRecoveryFeeAtoms","3001"),
+        ("bchMinimumOutputAtoms","1"),("cancelBlocks","65536"),("punishBlocks","2"),
+        ("bchConfirmations","1"),("xmzConfirmations","0"),
+        ("expiresAt","1000"),("expiresAt","4601"),("appFeeXmzAtoms","1"),
+        ("bchNetwork","btc-regtest"),("xmzNetwork","xmz-testnet"),
+        ("bchGenesis","invalid"),("xmzGenesis","invalid"),
+        ("bchPayoutScript","51"),("bchRefundScript","0"),("xmzPayout","invalid"),
+        ("xmzRefund","invalid"),("bchSigningKey","00"),
+        ("xmzSigningKey",terms["bchSigningKey"].as_str()),
+        ("quoteId","00000000-0000-0000-0000-000000000000")] {
+        let mut changed = terms.clone(); changed.insert(field.into(),value.into());
+        assert!(signed(&changed,&policy,1000).is_err(),"accepted {field}={value}");
+    }
+    for field in FIELDS {
+        let mut missing = terms.clone(); missing.remove(*field);
+        assert!(signed(&missing,&policy,1000).is_err(),"accepted missing {field}");
+    }
+    let mut extra = terms.clone(); extra.insert("extra".into(),"1".into());
+    assert!(signed(&extra,&policy,1000).is_err());
+}
+#[test]
+fn policy_changes_are_rechecked_before_funding() -> Result<()> {
+    let (mut policy, terms) = fixture(); let quote = signed(&terms,&policy,1000)?;
+    policy.maximum_bch_atoms = 99_999;
+    assert!(quote.check_policy(&policy,1000).is_err());
+    policy.maximum_bch_atoms = 1_000_000;
+    policy.cancel_blocks = 2;
+    assert!(quote.check_policy(&policy,1000).is_err());
+    policy.cancel_blocks = 20;
+    policy.minimum_covenant_fee = 0;
+    assert!(quote.check_policy(&policy,1000).is_err());
+    Ok(())
+}
