+//! Authenticated BCH/XMZ commercial terms and covenant construction.
+//! This is not user approval, chain evidence or proof of adaptor-key ownership.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{ScriptBuf, secp256k1::PublicKey};
+use std::collections::BTreeMap;
+use swap_core::{bch::recovery::{RecoveryPlan, RecoveryTerms},
+    xmz_address::{XmzAddress, XmzNetwork}};
+
+const FIELDS: &[&str] = &[
+    "schema", "quoteId", "swapId", "bchFunder", "xmzFunder", "bchNetwork", "bchGenesis",
+    "xmzNetwork", "xmzGenesis", "bchAtoms", "xmzAtoms", "xmzPayoutAtoms",
+    "bchPayoutScript", "bchRefundScript", "xmzPayout", "xmzRefund",
+    "bchSigningKey", "xmzSigningKey", "bchFundingFeeMaxAtoms", "bchLockFeeAtoms",
+    "bchRecoveryFeeAtoms", "xmzFundingFeeMaxAtoms", "xmzClaimFeeMaxAtoms",
+    "xmzRefundFeeMaxAtoms", "bchConfirmations", "xmzConfirmations", "cancelBlocks",
+    "punishBlocks", "bchMinimumOutputAtoms", "expiresAt", "appFeeXmzAtoms",
+];
+
+/// Local operator configuration, never taken from a peer's quote. Genesis alone
+/// cannot distinguish BCH from Bitcoin; the BCH node must also be authenticated
+/// and its covenant activation checked by the future chain adapter.
+pub struct Policy {
+    pub bch_network: String, pub bch_genesis: String,
+    pub xmz_network: XmzNetwork, pub xmz_genesis: String,
+    pub bch_confirmations: u32, pub xmz_confirmations: u32,
+    pub cancel_blocks: u16, pub punish_blocks: u16,
+    pub maximum_bch_atoms: u64, pub maximum_xmz_atoms: u64,
+    pub maximum_bch_funding_fee: u64, pub maximum_xmz_fee: u64,
+    pub minimum_covenant_fee: u64, pub maximum_covenant_fee: u64,
+    pub minimum_output_atoms: u64,
+}
+
+pub struct VerifiedBchQuote {
+    terms: BTreeMap<String, String>, commitment: [u8;32], plan: RecoveryPlan,
+    xmz_payout: XmzAddress, xmz_refund: XmzAddress,
+}
+
+fn number(terms: &BTreeMap<String,String>, field: &str) -> Result<u64> {
+    let text = terms.get(field).context("missing BCH quote amount")?;
+    let value: u64 = text.parse()?;
+    ensure!(value > 0 && value.to_string() == *text, "noncanonical BCH quote number");
+    Ok(value)
+}
+fn bytes(text: &str, length: usize) -> Result<Vec<u8>> {
+    ensure!(text.len() == length * 2
+        && text.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "noncanonical BCH quote hex");
+    (0..length).map(|i| Ok(u8::from_str_radix(&text[i*2..i*2+2],16)?)).collect()
+}
+fn script(text: &str) -> Result<ScriptBuf> {
+    ensure!(text.len() <= 70 && text.len() % 2 == 0, "invalid BCH destination length");
+    Ok(ScriptBuf::from_bytes(bytes(text, text.len()/2)?))
+}
+
+impl VerifiedBchQuote {
+    pub fn verify(payload: &[u8], now: u64, policy: &Policy,
+        bch_pin: &[u8;32], xmz_pin: &[u8;32], bch_signature: &[u8], xmz_signature: &[u8]) -> Result<Self> {
+        let commitment = crate::bch_quote_signatures::verify(payload, bch_pin, xmz_pin,
+            bch_signature, xmz_signature)?;
+        let terms: BTreeMap<String,String> = serde_json::from_slice(payload)?;
+        ensure!(terms.len() == FIELDS.len() && FIELDS.iter().all(|f| terms.contains_key(*f)),
+            "unexpected BCH quote fields");
+        for field in ["quoteId", "swapId"] {
+            let id: uuid::Uuid = terms[field].parse()?;
+            ensure!(!id.is_nil() && id.to_string() == terms[field], "invalid BCH quote identifier");
+        }
+        ensure!(terms["appFeeXmzAtoms"] == "0", "BCH quote application fee unsupported");
+        let n = |field| number(&terms, field);
+        let key = |field: &str| -> Result<PublicKey> {
+            Ok(PublicKey::from_slice(&bytes(&terms[field],33)?)?)
+        };
+        let plan = RecoveryPlan::new(RecoveryTerms {
+            locked_atoms: n("bchAtoms")?, lock_fee_atoms: n("bchLockFeeAtoms")?,
+            recovery_fee_atoms: n("bchRecoveryFeeAtoms")?, minimum_output_atoms: n("bchMinimumOutputAtoms")?,
+            cancel_delay_blocks: n("cancelBlocks")?.try_into()?,
+            punish_delay_blocks: n("punishBlocks")?.try_into()?,
+            bch_funder_signing_key: key("bchSigningKey")?, native_funder_signing_key: key("xmzSigningKey")?,
+            bch_funder_refund: script(&terms["bchRefundScript"])?,
+            native_funder_payout: script(&terms["bchPayoutScript"])?,
+        })?;
+        let xmz_payout = XmzAddress::parse(policy.xmz_network, &terms["xmzPayout"])?;
+        let xmz_refund = XmzAddress::parse(policy.xmz_network, &terms["xmzRefund"])?;
+        let quote = Self { terms, commitment, plan, xmz_payout, xmz_refund };
+        quote.check_policy(policy, now)?;
+        Ok(quote)
+    }
+
+    /// Recheck before new funding; historical recovery must instead use its
+    /// retained admission context, never demand a fresh commercial quote.
+    pub fn check_policy(&self, policy: &Policy, now: u64) -> Result<()> {
+        let t = &self.terms;
+        let n = |field| number(t, field);
+        ensure!(matches!(policy.bch_network.as_str(), "bch-mainnet" | "bch-testnet" | "bch-regtest"),
+            "unsupported BCH network policy");
+        let native = match policy.xmz_network { XmzNetwork::Mainnet => "xmz-mainnet",
+            XmzNetwork::Testnet => "xmz-testnet", XmzNetwork::Stagenet => "xmz-stagenet" };
+        for hash in [&policy.bch_genesis, &policy.xmz_genesis] {
+            ensure!(bytes(hash,32)?.iter().any(|b| *b != 0), "zero quote deployment hash");
+        }
+        ensure!(t["bchNetwork"] == policy.bch_network && t["bchGenesis"] == policy.bch_genesis
+            && t["xmzNetwork"] == native && t["xmzGenesis"] == policy.xmz_genesis
+            && policy.bch_genesis != policy.xmz_genesis, "BCH quote deployment mismatch");
+        let expiry = n("expiresAt")?;
+        ensure!(expiry > now && expiry - now <= 3600, "BCH quote outside validity window");
+        ensure!(policy.bch_confirmations > 0 && policy.bch_confirmations <= 1000
+            && policy.xmz_confirmations > 0 && policy.xmz_confirmations <= 1000
+            && u32::from(policy.cancel_blocks) > policy.bch_confirmations
+            && u32::from(policy.punish_blocks) > policy.bch_confirmations,
+            "invalid BCH confirmation or timeout policy");
+        for (field, expected) in [("bchConfirmations",u64::from(policy.bch_confirmations)),
+            ("xmzConfirmations",u64::from(policy.xmz_confirmations)),
+            ("cancelBlocks",u64::from(policy.cancel_blocks)), ("punishBlocks",u64::from(policy.punish_blocks)),
+            ("bchMinimumOutputAtoms",policy.minimum_output_atoms)] {
+            ensure!(n(field)? == expected, "BCH quote differs from local policy");
+        }
+        ensure!(n("bchAtoms")? <= policy.maximum_bch_atoms && n("xmzAtoms")? <= policy.maximum_xmz_atoms,
+            "BCH quote principal exceeds policy");
+        ensure!(n("bchFundingFeeMaxAtoms")? <= policy.maximum_bch_funding_fee
+            && n("bchFundingFeeMaxAtoms")? < n("bchAtoms")?, "BCH funding fee exceeds policy");
+        ensure!(policy.minimum_covenant_fee > 0, "zero BCH covenant fee floor");
+        for field in ["bchLockFeeAtoms", "bchRecoveryFeeAtoms"] {
+            ensure!(n(field)? >= policy.minimum_covenant_fee && n(field)? <= policy.maximum_covenant_fee,
+                "BCH covenant fee outside policy");
+        }
+        for field in ["xmzFundingFeeMaxAtoms", "xmzClaimFeeMaxAtoms", "xmzRefundFeeMaxAtoms"] {
+            ensure!(n(field)? <= policy.maximum_xmz_fee && n(field)? < n("xmzAtoms")?,
+                "XMZ fee exceeds BCH quote policy");
+        }
+        let reserve = n("xmzAtoms")?.checked_sub(n("xmzPayoutAtoms")?).context("XMZ payout exceeds lock")?;
+        ensure!(reserve >= n("xmzClaimFeeMaxAtoms")? && reserve >= n("xmzRefundFeeMaxAtoms")?,
+            "insufficient signed XMZ settlement reserve");
+        Ok(())
+    }
+
+    pub fn commitment(&self) -> &[u8;32] { &self.commitment }
+    pub fn terms(&self) -> &BTreeMap<String,String> { &self.terms }
+    pub fn recovery_plan(&self) -> &RecoveryPlan { &self.plan }
+    pub fn xmz_payout(&self) -> &XmzAddress { &self.xmz_payout }
+    pub fn xmz_refund(&self) -> &XmzAddress { &self.xmz_refund }
+}
+
