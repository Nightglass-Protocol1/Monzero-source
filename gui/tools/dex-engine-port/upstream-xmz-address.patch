@@ -0,0 +1,119 @@
+//! Monzero address boundary. Preserve the core's varint network prefixes.
+use anyhow::{Result, bail, anyhow};
+use monero_address::{AddressType, MoneroAddress, Network};
+use monero_oxide_wallet::ed25519::Point;
+use std::fmt;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum XmzNetwork { Mainnet, Testnet, Stagenet }
+
+impl XmzNetwork {
+    fn base(self) -> u8 {
+        match self { Self::Mainnet => 86, Self::Testnet => 111, Self::Stagenet => 131 }
+    }
+}
+
+/// The inner Monero encoding is private and only used for key/type validation.
+/// It must never escape as a payment destination.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct XmzAddress {
+    network: XmzNetwork,
+    inner: MoneroAddress,
+}
+
+impl XmzAddress {
+    pub fn new(network: XmzNetwork, kind: AddressType, spend: Point, view: Point) -> Result<Self> {
+        if matches!(kind, AddressType::Featured { .. }) {
+            bail!("Featured addresses are not supported by Monzero");
+        }
+        Ok(Self { network, inner: MoneroAddress::new(Network::Mainnet, kind, spend, view) })
+    }
+
+    pub fn parse(network: XmzNetwork, value: &str) -> Result<Self> {
+        // Bound decoding before processing untrusted input.
+        if value.len() > 110 { bail!("Address too long"); }
+        let raw = monero_base58::decode_check(value).ok_or_else(|| anyhow!("Invalid address checksum or encoding"))?;
+        let base = network.base();
+        let (tag, offset) = if base < 128 {
+            (*raw.first().ok_or_else(|| anyhow!("Missing prefix"))?, 1)
+        } else {
+            if raw.len() < 2 || raw[1] != 1 || raw[0] < 128 { bail!("Invalid Monzero prefix"); }
+            (raw[0], 2)
+        };
+        let monero_tag = match tag.checked_sub(base) {
+            Some(0) => 18,
+            Some(1) => 19,
+            Some(2) => 42,
+            _ => bail!("Wrong Monzero network or address type"),
+        };
+        let mut normalized = vec![monero_tag];
+        normalized.extend_from_slice(&raw[offset..]);
+        let inner = MoneroAddress::from_str(Network::Mainnet, &monero_base58::encode_check(normalized))?;
+        let address = Self { network, inner };
+        if address.to_string() != value { bail!("Noncanonical address"); }
+        Ok(address)
+    }
+
+    pub fn network(&self) -> XmzNetwork { self.network }
+}
+
+impl fmt::Display for XmzAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let raw = monero_base58::decode_check(&self.inner.to_string()).ok_or(fmt::Error)?;
+        let offset = match raw[0] { 18 => 0, 19 => 1, 42 => 2, _ => return Err(fmt::Error) };
+        let tag = self.network.base() + offset;
+        let mut encoded = if tag < 128 { vec![tag] } else { vec![tag, 1] };
+        encoded.extend_from_slice(&raw[1..]);
+        f.write_str(&monero_base58::encode_check(encoded))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn key() -> Point {
+        monero_oxide_ext::PublicKey::from_private_key(&monero_oxide_ext::PrivateKey::from_scalar(
+            monero_oxide_wallet::ed25519::Scalar::ONE
+        )).decompress()
+    }
+    #[test]
+    fn matches_native_monzero_encoder_vectors() {
+        let vectors: Vec<_> = include_str!("xmz_address_vectors.txt").lines().collect();
+        assert_eq!(vectors.len(), 9);
+        let mut index = 0;
+        for network in [XmzNetwork::Mainnet, XmzNetwork::Testnet, XmzNetwork::Stagenet] {
+            for kind in [AddressType::Legacy, AddressType::LegacyIntegrated([7; 8]), AddressType::Subaddress] {
+                let address = XmzAddress::new(network, kind, key(), key()).unwrap();
+                assert_eq!(address.to_string(), vectors[index]);
+                assert_eq!(XmzAddress::parse(network, vectors[index]).unwrap(), address);
+                index += 1;
+            }
+        }
+    }
+    #[test]
+    fn all_core_networks_and_types_roundtrip() {
+        for network in [XmzNetwork::Mainnet, XmzNetwork::Testnet, XmzNetwork::Stagenet] {
+            for (index, kind) in [AddressType::Legacy, AddressType::LegacyIntegrated([7; 8]), AddressType::Subaddress].into_iter().enumerate() {
+                let address = XmzAddress::new(network, kind, key(), key()).unwrap();
+                let text = address.to_string();
+                assert_eq!(XmzAddress::parse(network, &text).unwrap(), address);
+                let raw = monero_base58::decode_check(&text).unwrap();
+                assert_eq!(raw[0], network.base() + index as u8);
+                if network == XmzNetwork::Stagenet { assert_eq!(raw[1], 1); }
+                for other in [XmzNetwork::Mainnet, XmzNetwork::Testnet, XmzNetwork::Stagenet] {
+                    if other != network { assert!(XmzAddress::parse(other, &text).is_err()); }
+                }
+            }
+        }
+    }
+    #[test]
+    fn rejects_monero_truncated_and_non_varint_stagenet() {
+        let monero = MoneroAddress::new(Network::Mainnet, AddressType::Legacy, key(), key()).to_string();
+        assert!(XmzAddress::parse(XmzNetwork::Mainnet, &monero).is_err());
+        let mut raw = monero_base58::decode_check(&monero).unwrap();
+        raw[0] = 131; // Upstream's one-byte encoding is not the core's varint.
+        assert!(XmzAddress::parse(XmzNetwork::Stagenet, &monero_base58::encode_check(raw)).is_err());
+        assert!(XmzAddress::parse(XmzNetwork::Mainnet, "").is_err());
+        assert!(XmzAddress::parse(XmzNetwork::Mainnet, &"1".repeat(111)).is_err());
+    }
+}
