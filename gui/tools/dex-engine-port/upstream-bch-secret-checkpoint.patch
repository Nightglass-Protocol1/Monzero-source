+#[test]
+fn secret_checkpoint_rejects_changed_pins_secrets_and_admission_history() -> Result<()> {
+    use agreement::{AgreedNativeWallet,checkpoint};
+    let setup = Setup::new()?; let original = agreed(&setup,Role::BchFunder)?;
+    let record = original.secret_checkpoint(&setup.quote)?; let digest = checkpoint::commitment(&record)?;
+    assert!(AgreedNativeWallet::restore_secret_checkpoint(&record,&[0;32],&setup.quote,&setup.policy,Role::BchFunder).is_err());
+    assert!(AgreedNativeWallet::restore_secret_checkpoint(&record,&digest,&setup.quote,&setup.policy,Role::NativeFunder).is_err());
+    let text = std::str::from_utf8(&record)?;
+    let value: serde_json::Value = serde_json::from_slice(&record)?;
+    for field in ["contract_secret","spend_secret","view_secret"] {
+        let before = format!("\"{field}\":{}",serde_json::to_string(&value[field])?);
+        let after = format!("\"{field}\":{}",serde_json::to_string(&[5u8;32])?);
+        assert!(text.contains(&before));
+        let changed = text.replace(&before,&after).into_bytes();
+        assert!(AgreedNativeWallet::restore_secret_checkpoint(&changed,&digest,&setup.quote,&setup.policy,Role::BchFunder).is_err());
+        // Preserve struct field order and recompute the external digest to test
+        // actual secret/advertised-key validation, not only hash rejection.
+        let changed_digest = checkpoint::commitment(&changed)?;
+        assert!(AgreedNativeWallet::restore_secret_checkpoint(&changed,&changed_digest,&setup.quote,&setup.policy,Role::BchFunder).is_err());
+    }
+    for changed in [text.replace("\"admitted_at\":1000","\"admitted_at\":999"),
+        text.replace("\"agreed_at\":1000","\"agreed_at\":999"),
+        text.replace("\"agreed_at\":1000","\"agreed_at\":2000"),
+        format!(" {text}"), text[..text.len()-1].to_owned()] {
+        let changed_digest = checkpoint::commitment(changed.as_bytes())?;
+        assert!(AgreedNativeWallet::restore_secret_checkpoint(changed.as_bytes(),&changed_digest,&setup.quote,&setup.policy,Role::BchFunder).is_err());
+    }
+    let mut other_terms = setup.quote.terms().clone(); other_terms.insert("bchLockFeeAtoms".into(),"1001".into());
+    let other_quote = signed(&other_terms,&setup.policy,1000)?;
+    assert!(AgreedNativeWallet::restore_secret_checkpoint(&record,&digest,&other_quote,&setup.policy,Role::BchFunder).is_err());
+    Ok(())
+}
