+#[test]
+fn secret_checkpoint_restores_both_roles_and_recovery_after_quote_expiry() -> Result<()> {
+    use agreement::{AgreedNativeWallet,checkpoint};
+    let setup = Setup::new()?;
+    let plan = setup.quote.recovery_plan();
+    let funding = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([7;32]),vout:0},
+            script_sig:bitcoin::ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(plan.terms().locked_atoms),script_pubkey:plan.lock().script_pubkey()}]};
+    let first = OutPoint {txid:funding.compute_txid(),vout:0};
+    let cancel = plan.lock().prepare_timeout(&serialize(&funding),&plan.lock_spend_terms(first))?;
+    for (index,role) in [(0,Role::BchFunder),(1,Role::NativeFunder)] {
+        let original = agreed(&setup,role)?; let expected_agreement = *original.commitment();
+        let record = original.secret_checkpoint(&setup.quote)?; let digest = checkpoint::commitment(&record)?;
+        drop(original);
+        let restored = AgreedNativeWallet::restore_secret_checkpoint(&record,&digest,&setup.quote,&setup.policy,role)?;
+        assert_eq!(*restored.commitment(),expected_agreement);
+        assert_eq!(*restored.secret_checkpoint(&setup.quote)?,*record);
+        assert!(restored.check_bch_funding(&setup.quote,&setup.policy,2000,&plan.lock().script_pubkey(),100_000,5000).is_err());
+        assert!(restored.check_native_funding(&setup.quote,&setup.policy,2000,restored.owned().wallet().address(),101_000,1000).is_err());
+        let (covenant,raw,outpoint) = if index==0 {(plan.lock(),serialize(&funding),first)}
+            else {(plan.recovery(),serialize(&cancel),OutPoint {txid:cancel.compute_txid(),vout:0})};
+        let encrypted = restored.owned().prepare_encrypted_signature(&setup.quote)?;
+        let mut decrypt = setup.spend[1-index].as_bytes(); decrypt.reverse();
+        let decrypt = Scalar::from_bytes(decrypt).unwrap().non_zero().unwrap();
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize()).unwrap();
+        let der = covenant.data_message().decrypt(&signer,&decrypt,encrypted.clone())?;
+        let spend_terms = if index==0 {plan.lock_spend_terms(outpoint)} else {plan.recovery_spend_terms(outpoint)};
+        let tx = covenant.prepare_redemption(&raw,&spend_terms,&der)?;
+        let key = restored.owned().recover_spend_key(&setup.quote,&raw,outpoint,&serialize(&tx),&encrypted)?;
+        assert_eq!(key.as_bytes(),(setup.spend[0]+setup.spend[1]).as_bytes());
+    }
+    Ok(())
+}
