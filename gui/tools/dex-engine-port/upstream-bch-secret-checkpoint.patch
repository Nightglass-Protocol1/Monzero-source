+//! Sensitive completed-exchange checkpoint codec. This does not write, encrypt,
+//! fsync or lock files, nor does it restore execution/funding permission.
+//! Pin the digest in the latest independently trusted execution record.
+use super::*;
+use zeroize::{Zeroize,Zeroizing};
+const SCHEMA: &str = "monzero-bch-owned-agreement-checkpoint-v1";
+const MAX_CHECKPOINT: usize = 2_000_000;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    schema: String, quote_record: Vec<u8>, role: Role,
+    contract_secret: [u8;32], spend_secret: [u8;32], view_secret: [u8;32],
+    proofs: [SignedFrame;2], views: [SignedFrame;2],
+    acknowledgement: Vec<u8>, signatures: [Vec<u8>;2], agreed_at: u64,
+    agreement_commitment: [u8;32],
+}
+impl Drop for State {
+    fn drop(&mut self) {
+        self.contract_secret.zeroize(); self.spend_secret.zeroize(); self.view_secret.zeroize();
+    }
+}
+
+pub fn commitment(bytes: &[u8]) -> Result<[u8;32]> {
+    ensure!(!bytes.is_empty() && bytes.len() <= MAX_CHECKPOINT,"invalid BCH secret checkpoint size");
+    let mut hash = Sha256::new(); hash.update(SCHEMA); hash.update([0]); hash.update(bytes);
+    Ok(hash.finalize().into())
+}
+
+impl AgreedNativeWallet {
+    /// Contains spending secrets and private view frames. Never log these bytes.
+    /// Returned and retained frame buffers are zeroized on drop; serializer
+    /// internals may contain additional copies, so this is not memory isolation.
+    pub fn secret_checkpoint(&self, quote: &VerifiedBchQuote) -> Result<Zeroizing<Vec<u8>>> {
+        ensure!(self.owned.wallet.pair.bch.quote_commitment == *quote.commitment(),"BCH checkpoint quote mismatch");
+        let wallet = &self.owned.wallet;
+        let state = State {schema:SCHEMA.into(),quote_record:quote.record()?,role:self.owned.role,
+            contract_secret:*self.owned.contract,spend_secret:self.owned.spend.as_bytes(),view_secret:self.owned.view_share.0.as_bytes(),
+            proofs:[wallet.pair.bch.accepted.clone(),wallet.pair.native.accepted.clone()],
+            views:wallet.view_frames.clone(),acknowledgement:self.acknowledgement.clone(),signatures:self.signatures.clone(),
+            agreed_at:self.agreed_at,agreement_commitment:self.commitment};
+        let bytes = Zeroizing::new(serde_json::to_vec(&state)?);
+        commitment(&bytes)?;
+        Ok(bytes)
+    }
+
+    /// Quote/policy/role and expected digest must come from the original trusted
+    /// admission/execution record, never be selected by the checkpoint itself.
+    /// Replays historical admission, allowing recovery after commercial expiry.
+    /// New funding still checks current time and requires separate durable guards.
+    pub fn restore_secret_checkpoint(bytes: &[u8], expected: &[u8;32], quote: &VerifiedBchQuote,
+        policy: &Policy, role: Role) -> Result<Self> {
+        ensure!(&commitment(bytes)? == expected,"BCH secret checkpoint digest mismatch");
+        let state: State = serde_json::from_slice(bytes).map_err(|_|anyhow::anyhow!("invalid BCH secret checkpoint encoding"))?;
+        ensure!(state.schema == SCHEMA && state.role == role && state.quote_record == quote.record()?,
+            "BCH secret checkpoint admission context mismatch");
+        ensure!(Zeroizing::new(serde_json::to_vec(&state)?).as_slice() == bytes,"noncanonical BCH secret checkpoint");
+        let bch = AuthenticatedNativeAdaptor::verify(&state.proofs[0].bytes,&state.proofs[0].signature,
+            quote,policy,state.proofs[0].admitted_at,Role::BchFunder)?;
+        let native = AuthenticatedNativeAdaptor::verify(&state.proofs[1].bytes,&state.proofs[1].signature,
+            quote,policy,state.proofs[1].admitted_at,Role::NativeFunder)?;
+        ensure!(state.views[0].admitted_at == state.views[1].admitted_at,"BCH checkpoint view admission mismatch");
+        let wallet = NativePair::new(quote,bch,native)?.finish(quote,policy,state.views[0].admitted_at,
+            [(&state.views[0].bytes,&state.views[0].signature),(&state.views[1].bytes,&state.views[1].signature)])?;
+        let contract = bitcoin::secp256k1::SecretKey::from_slice(&state.contract_secret)?;
+        let spend = monero::PrivateKey::from_slice(&state.spend_secret)
+            .map_err(|_|anyhow::anyhow!("invalid retained BCH native spend share"))?;
+        ensure!(spend.as_bytes() == state.spend_secret,"noncanonical retained BCH native spend share");
+        let view = monero::PrivateViewKey(view_key(&state.view_secret)?);
+        let owned = wallet.bind_local(quote,role,contract,spend,view)?;
+        let restored = owned.accept_agreement(quote,policy,state.agreed_at,&state.acknowledgement,
+            &state.signatures[0],&state.signatures[1])?;
+        ensure!(restored.commitment == state.agreement_commitment,"BCH checkpoint agreement mismatch");
+        ensure!(*restored.secret_checkpoint(quote)? == bytes,"BCH checkpoint reconstruction mismatch");
+        Ok(restored)
+    }
+}
