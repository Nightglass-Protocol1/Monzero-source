+#[test]
+fn submission_marker_prevents_resigning_after_partial_or_unknown_send()->Result<()> {
+    let directory=Directory::new()?;let (seed,review)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review)?;let expected=claim.signing_commitment();
+    let signed=claim.approve_and_sign(&seed,expected)?;let endpoint=endpoint()?;
+    let record=BroadcastRecord::new(&claim,&endpoint,expected)?;
+    claim.journal.retain(&claim.submission_name(),&record.submission)?;
+    assert!(claim.approve_and_sign(&seed,expected).is_err());
+    record.retain_intent()?;assert_eq!(claim.broadcast_status(&endpoint,expected)?,BroadcastStatus::OutcomeUnknown);
+    assert!(claim.approve_and_sign(&seed,expected).is_err());assert_eq!(claim.load_signed()?,signed);
+    fs::remove_file(directory.0.join(claim.submission_name()))?;
+    assert!(claim.broadcast_status(&endpoint,expected).is_err());assert!(record.check_intent().is_err());Ok(())
+}
