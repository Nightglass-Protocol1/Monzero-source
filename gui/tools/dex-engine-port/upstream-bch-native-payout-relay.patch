+#[tokio::test]
+async fn bch_native_payout_owned_session_relays_saved_bytes_once() -> Result<()> {
+    use crate::native_funding_rpc::{full_proceeds::FullProceedsRequest,relay::{BroadcastOutcomeUnknown,lock_checkpoint::tests::Fixture as ChainFixture}};
+    use swap_core::xmz::XmzAmount;
+    let addresses=include_str!("../../../../swap-core/src/xmz_address_vectors.txt").lines().take(2)
+        .map(|s|XmzAddress::parse(XmzNetwork::Mainnet,s)).collect::<Result<Vec<_>>>()?;
+    let request=ExactNetRequest {source:FullProceedsRequest {wallet:addresses[0].clone(),destination:addresses[1].clone(),
+        lock_txid:"ab".repeat(32),locked:XmzAmount::from_atoms(110),maximum_fee:XmzAmount::from_atoms(3),account:0,priority:1},
+        principal:XmzAmount::from_atoms(100),reserve_return:addresses[1].clone()};
+    let dir=std::env::temp_dir().join(format!("monzero-payout-relay-fixture-{}",uuid::Uuid::new_v4()));std::fs::create_dir(&dir)?;
+    let intent=dir.join("prepare");std::fs::write(&intent,br#"{"schema":"monzero-bch-native-payout-intent-v1"}"#)?;
+    let relay_intent=dir.join("relay");std::fs::write(&relay_intent,br#"{"schema":"monzero-bch-native-payout-relay-intent-v1"}"#)?;
+    let chain=ChainFixture::new(addresses[0].clone(),addresses[1].clone(),"aa".repeat(32),110,3).await?;
+    let observer=chain.funding_client()?;
+    for lost in [false,true] {
+        let id=SwapWalletId::new(uuid::Uuid::new_v4())?;
+        let wallet=Fixture::new(&id,&addresses[0],&[1;32],&[2;32],&request.source.lock_txid).await?;
+        {
+            let mut state=wallet.state.lock().unwrap();state.opened=true;state.exists=true;
+            state.payout=Some(Payout {request:request.clone(),intent:intent.clone(),fee:2});
+            state.relay_intent=Some(relay_intent.clone());state.lose_relay=lost;
+        }
+        let mut uncertain=wallet.payout_session(&observer)?;uncertain.uncertain=true;
+        assert!(uncertain.into_payout_relay().is_err());
+        let mut session=wallet.payout_session(&observer)?;
+        session.verify_spend_key(&[1;32],&addresses[0]).await?;
+        let prepared=session.prepare_lock_payout(&request,&"aa".repeat(32),std::time::Instant::now()+std::time::Duration::from_secs(30)).await?;
+        let mut relay=session.into_payout_relay()?;
+        let result=relay.dispatch_native_payout(&prepared).await;
+        if lost {assert!(result.err().context("lost reply was accepted")?.is::<BroadcastOutcomeUnknown>());}
+        else {assert_eq!(result?.txid,"dd".repeat(32));}
+        assert!(relay.dispatch_native_payout(&prepared).await.is_err());
+        let state=wallet.state.lock().unwrap();
+        assert_eq!(state.calls.iter().filter(|s|s.as_str()=="transfer").count(),1);
+        assert_eq!(state.calls.iter().filter(|s|s.as_str()=="relay_tx").count(),1);
+    }
+    std::fs::remove_dir_all(dir)?;
+    Ok(())
+}
