+#[test]
+fn both_peers_acknowledge_identical_context_and_only_their_funding_intent() -> Result<()> {
+    let setup = Setup::new()?;
+    let bch = owned(&setup,Role::BchFunder)?; let native = owned(&setup,Role::NativeFunder)?;
+    let frame = bch.acknowledgement(&setup.quote)?;
+    assert_eq!(frame,native.acknowledgement(&setup.quote)?);
+    let bs = ack_sign(&frame,Role::BchFunder); let ns = ack_sign(&frame,Role::NativeFunder);
+    let bch = bch.accept_agreement(&setup.quote,&setup.policy,1000,&frame,&bs,&ns)?;
+    let native = native.accept_agreement(&setup.quote,&setup.policy,1000,&frame,&bs,&ns)?;
+    assert_eq!(bch.commitment(),native.commitment());
+    let lock = setup.quote.recovery_plan().lock().script_pubkey();
+    let address = native.owned().wallet().address();
+    bch.check_bch_funding(&setup.quote,&setup.policy,1001,&lock,100_000,5000)?;
+    native.check_native_funding(&setup.quote,&setup.policy,1001,address,101_000,1000)?;
+    assert!(native.check_bch_funding(&setup.quote,&setup.policy,1001,&lock,100_000,5000).is_err());
+    assert!(bch.check_native_funding(&setup.quote,&setup.policy,1001,address,101_000,1000).is_err());
+    for time in [999,2000] {
+        assert!(bch.check_bch_funding(&setup.quote,&setup.policy,time,&lock,100_000,5000).is_err());
+        assert!(native.check_native_funding(&setup.quote,&setup.policy,time,address,101_000,1000).is_err());
+    }
+    for (amount,fee) in [(99_999,5000),(100_000,0),(100_000,5001)] {
+        assert!(bch.check_bch_funding(&setup.quote,&setup.policy,1001,&lock,amount,fee).is_err());
+    }
+    for (amount,fee) in [(100_000,1000),(101_000,0),(101_000,1001)] {
+        assert!(native.check_native_funding(&setup.quote,&setup.policy,1001,address,amount,fee).is_err());
+    }
+    assert!(bch.check_bch_funding(&setup.quote,&setup.policy,1001,
+        setup.quote.recovery_plan().recovery().script_pubkey().as_script(),100_000,5000).is_err());
+    assert!(native.check_native_funding(&setup.quote,&setup.policy,1001,setup.quote.xmz_payout(),101_000,1000).is_err());
+    Ok(())
+}
