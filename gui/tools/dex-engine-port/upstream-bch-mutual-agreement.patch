+fn owned(setup: &Setup, role: Role) -> Result<OwnedNativeWallet> {
+    let (index,tag) = if role == Role::BchFunder {(0,3)} else {(1,4)};
+    setup.wallet()?.bind_local(&setup.quote,role,bitcoin::secp256k1::SecretKey::from_slice(&[tag;32])?,
+        setup.spend[index],setup.view[index])
+}
+fn ack_sign(bytes: &[u8], role: Role) -> Vec<u8> {
+    SigningKey::from_bytes(&[if role==Role::BchFunder {1} else {2};32])
+        .sign(&agreement::signing_bytes(bytes,role).unwrap()).to_bytes().to_vec()
+}
