+#[test]
+fn jointly_signed_acknowledgements_cannot_replace_derived_transcript() -> Result<()> {
+    let setup = Setup::new()?; let frame = owned(&setup,Role::BchFunder)?.acknowledgement(&setup.quote)?;
+    let bs = ack_sign(&frame,Role::BchFunder); let ns = ack_sign(&frame,Role::NativeFunder);
+    assert!(owned(&setup,Role::BchFunder)?.accept_agreement(&setup.quote,&setup.policy,1000,&frame,&ns,&bs).is_err());
+    assert!(owned(&setup,Role::NativeFunder)?.accept_agreement(&setup.quote,&setup.policy,1000,&frame,&bs,&[]).is_err());
+    assert!(owned(&setup,Role::BchFunder)?.accept_agreement(&setup.quote,&setup.policy,2000,&frame,&bs,&ns).is_err());
+    let value: serde_json::Value = serde_json::from_slice(&frame)?;
+    let mut variants = vec![serde_json::to_vec_pretty(&value)?];
+    for field in ["quoteCommitment","swapId","transcript","xmzAddress","bchLockScript","bchRecoveryScript","schema"] {
+        let mut changed = value.clone(); changed[field] = "wrong".into(); variants.push(serde_json::to_vec(&changed)?);
+    }
+    for changed in variants {
+        let bs = ack_sign(&changed,Role::BchFunder); let ns = ack_sign(&changed,Role::NativeFunder);
+        assert!(owned(&setup,Role::BchFunder)?.accept_agreement(&setup.quote,&setup.policy,1000,&changed,&bs,&ns).is_err());
+    }
+    // Valid alternative signed view shares under the same quote create another
+    // wallet/transcript; the old acknowledgement must not approve it.
+    let mut other = setup;
+    other.view[1] = monero::PrivateViewKey::new_random(&mut rand::thread_rng());
+    assert!(owned(&other,Role::NativeFunder)?.accept_agreement(&other.quote,&other.policy,1000,&frame,&bs,&ns).is_err());
+    Ok(())
+}
