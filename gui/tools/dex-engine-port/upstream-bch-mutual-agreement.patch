+//! Both peers acknowledge the exact derived wallet and contracts. This is a
+//! protocol precondition, not user approval, chain evidence or relay authority.
+use super::*;
+const DOMAIN: &str = "monzero-bch-xmz-key-agreement-v1";
+const MAX_ACK: usize = 4096;
+
+pub struct AgreedNativeWallet {
+    owned: OwnedNativeWallet, commitment: [u8;32], agreed_at: u64,
+}
+
+pub fn signing_bytes(frame: &[u8], role: Role) -> Result<Vec<u8>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX_ACK,"invalid BCH key acknowledgement size");
+    let domain = format!("{DOMAIN}-{}",role.domain());
+    let mut message = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",domain.len(),domain,frame.len()).into_bytes();
+    message.extend_from_slice(frame); Ok(message)
+}
+
+impl OwnedNativeWallet {
+    /// Public acknowledgement: contains commitments and destinations, never
+    /// private view shares, native spend shares or contract signing secrets.
+    pub fn acknowledgement(&self, quote: &VerifiedBchQuote) -> Result<Vec<u8>> {
+        ensure!(self.wallet.pair.bch.quote_commitment == *quote.commitment(),"BCH acknowledgement quote mismatch");
+        Ok(serde_json::to_vec(&serde_json::json!({"schema":DOMAIN,
+            "quoteCommitment":hex(quote.commitment()),"swapId":quote.terms()["swapId"],
+            "transcript":hex(self.wallet.transcript_commitment()),"xmzAddress":self.wallet.address().to_string(),
+            "bchLockScript":hex(quote.recovery_plan().lock().script_pubkey().as_bytes()),
+            "bchRecoveryScript":hex(quote.recovery_plan().recovery().script_pubkey().as_bytes())}))?)
+    }
+
+    pub fn accept_agreement(self, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        frame: &[u8], bch_signature: &[u8], native_signature: &[u8]) -> Result<AgreedNativeWallet> {
+        quote.check_policy(policy,now)?;
+        ensure!(frame.len() <= MAX_ACK && self.acknowledgement(quote)? == frame,
+            "BCH acknowledgement differs from locally derived exchange");
+        for (role,signature) in [(Role::BchFunder,bch_signature),(Role::NativeFunder,native_signature)] {
+            let identity = &quote.terms()[role.identity()]; let mut pin = [0;32];
+            for (i,byte) in pin.iter_mut().enumerate() { *byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?; }
+            VerifyingKey::from_bytes(&pin)?.verify_strict(&signing_bytes(frame,role)?,&Signature::from_slice(signature)?)?;
+        }
+        let mut hash = Sha256::new(); hash.update(DOMAIN); hash.update([0]);
+        hash.update(frame); hash.update(bch_signature); hash.update(native_signature);
+        Ok(AgreedNativeWallet {owned:self,commitment:hash.finalize().into(),agreed_at:now})
+    }
+}
+
+impl AgreedNativeWallet {
+    pub fn owned(&self) -> &OwnedNativeWallet { &self.owned }
+    pub fn commitment(&self) -> &[u8;32] { &self.commitment }
+
+    fn check(&self, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        role: Role, atoms: u64, fee_cap: u64) -> Result<()> {
+        ensure!(self.owned.role == role && self.owned.wallet.pair.bch.quote_commitment == *quote.commitment()
+            && now >= self.agreed_at,"BCH agreed funding context mismatch");
+        quote.check_policy(policy,now)?;
+        let (amount,fee) = match role { Role::BchFunder => ("bchAtoms","bchFundingFeeMaxAtoms"),
+            Role::NativeFunder => ("xmzAtoms","xmzFundingFeeMaxAtoms") };
+        ensure!(atoms == quote.terms()[amount].parse::<u64>()? && fee_cap > 0
+            && fee_cap <= quote.terms()[fee].parse::<u64>()?, "funding differs from signed BCH quote");
+        Ok(())
+    }
+
+    /// Check a prepared funding intent before the separate approval/chain flow.
+    pub fn check_bch_funding(&self, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        output_script: &bitcoin::Script, atoms: u64, fee_cap: u64) -> Result<()> {
+        self.check(quote,policy,now,Role::BchFunder,atoms,fee_cap)?;
+        ensure!(output_script == quote.recovery_plan().lock().script_pubkey().as_script(),
+            "BCH funding destination differs from acknowledged contract");
+        Ok(())
+    }
+
+    /// The native lock includes the signed payout and its settlement fee reserve.
+    pub fn check_native_funding(&self, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        address: &XmzAddress, atoms: u64, fee_cap: u64) -> Result<()> {
+        self.check(quote,policy,now,Role::NativeFunder,atoms,fee_cap)?;
+        ensure!(address == self.owned.wallet.address(),"XMZ funding destination differs from acknowledged wallet");
+        Ok(())
+    }
+}
