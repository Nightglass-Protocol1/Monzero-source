+        let (_cookie,user,password)=credentials(&rpc.ltc_cookie_file)?;
+        let ltc=LitecoinRpc::new(rpc.ltc_port,user,password,LtcNetwork::Regtest,rpc.ltc_wallet,
+            LtcSegwitAddress::parse(LtcNetwork::Regtest,&rpc.ltc_anchor)?)?;
+        if operation=="check" {
+            let observation=execution.check_recovery_spend(&ltc,kind).await?;
+            return Ok(serde_json::json!({"schema":schema,"requestId":request.request_id,
+                "snapshot":execution.saved_status()?,"observation":observation}));
+        }
+        let outcome=execution.submit_reviewed_recovery_spend(&ltc,kind,approved.context("missing recovery approval")?).await?;
+        Ok(serde_json::json!({"schema":schema,"requestId":request.request_id,
+            "snapshot":execution.saved_status()?,"outcome":outcome}))
+    }
