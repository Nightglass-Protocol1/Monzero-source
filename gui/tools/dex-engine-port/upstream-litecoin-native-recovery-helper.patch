+        let schema=format!("monzero-ltc-native-recovery-{name}-{operation}-response-v1");
+        if operation=="review" {
+            let review=execution.review_recovery_spend(kind)?;
+            return Ok(serde_json::json!({"schema":schema,"requestId":request.request_id,
+                "snapshot":execution.saved_status()?,"review":{"details":review.details,
+                    "commitment":review.commitment.iter().map(|b|format!("{b:02x}")).collect::<String>()}}));
+        }
+        let approved=if operation=="submit" {
+            let approved=parse_commitment(request.commitment.as_deref().context("missing recovery approval")?)?;
+            ensure!(execution.review_recovery_spend(kind)?.commitment==approved,"native-funder recovery review changed");
+            Some(approved)
