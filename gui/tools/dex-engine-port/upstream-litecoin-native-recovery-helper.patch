+    async fn native_recovery_rpc(config:&Config,execution:&mut Execution,request:&Request,mode:&str)->Result<serde_json::Value> {
+        use swap_machine::litecoin_rpc::LitecoinRpc;
+        use swap_core::litecoin_address::{LtcNetwork,LtcSegwitAddress};
+        ensure!(valid_request(request,mode),"invalid native-funder recovery request");
