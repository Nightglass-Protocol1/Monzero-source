+//! Durable local-wallet source binding. Retain exact bytes before preparation;
+//! partial publication can resume only the same record. No signing or relay.
+use super::*;
+use crate::litecoin_light::{network::{LightNetwork,BchNetwork},vault::signing::review::claims::ClaimedSpend};
+use bitcoin::{consensus::serialize,hashes::{Hash,sha256}};
+use swap_core::bch::funding::SignedFunding;
+
+const LOCAL:&str="monzero-bch-local-signed-funding-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LocalRecord {
+    schema:String, admission:[u8;32], network:String, claim:[u8;32],
+    template:Template, signed:Vec<u8>,
+}
+impl AdmittedExecution<'_> {
+    fn local_record_bytes(&self)->Result<Option<Vec<u8>>> {
+        match self.metadata.read(&record_name(self.quote,"local-signed")) {
+            Ok(bytes)=>{ensure!(bytes.len()<=2_000_000,"oversized local BCH funding record");Ok(Some(bytes))},
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(None),
+            Err(e)=>Err(e),
+        }
+    }
+    pub(in crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding)
+    fn require_node_funding_source(&self)->Result<()> {
+        ensure!(self.local_record_bytes()?.is_none(),"BCH trade is bound to local-wallet funding");Ok(())
+    }
+    fn require_no_node_funding_records(&self)->Result<()> {
+        for suffix in ["wallet-preparation-pin","wallet-lock-intent","signing-intent","signed","reconciliation"] {
+            match self.metadata.read(&record_name(self.quote,suffix)) {
+                Ok(_)=>anyhow::bail!("BCH trade already contains node-wallet funding records"),
+                Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                Err(e)=>return Err(e),
+            }
+        }
+        match Journal::open(&self.snapshots)?.read(&record_name(self.quote,"wallet-preparation")) {
+            Ok(_)=>anyhow::bail!("BCH trade contains a node-wallet preparation candidate"),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(()),
+            Err(e)=>Err(e),
+        }
+    }
+    fn validate_local_record(&self,bytes:&[u8])->Result<(LocalRecord,SignedFunding)> {
+        self.require_no_node_funding_records()?;
+        let record:LocalRecord=serde_json::from_slice(bytes)?;
+        let admission=self.admission_digest()?;
+        let network=match self.quote.terms()["bchNetwork"].as_str() {
+            "bch-mainnet"=>LightNetwork::from(BchNetwork::Mainnet),
+            "bch-testnet"=>LightNetwork::from(BchNetwork::Testnet),
+            "bch-regtest"=>LightNetwork::from(BchNetwork::Regtest),
+            _=>anyhow::bail!("unsupported BCH local funding network"),
+        };
+        ensure!(record.schema==LOCAL && record.admission==admission && record.template.admission==admission
+            && record.template.schema==TEMPLATE && record.network==network.storage_identity()
+            && network.genesis()==self.quote.terms()["bchGenesis"] && serde_json::to_vec(&record)?==bytes,
+            "local BCH funding context changed");
+        let sources=record.template.sources.iter().map(Vec::as_slice).collect::<Vec<_>>();
+        let preview=self.validate_bch_funding_preview(record.template.prepared_at,&record.template.unsigned,&sources,
+            bitcoin::Script::from_bytes(&record.template.change),record.template.maximum_fee,record.template.minimum_change)?;
+        ensure!(record.template.minimum_change==self.quote.terms()["bchMinimumOutputAtoms"].parse::<u64>()?
+            && record.template.maximum_fee==preview.fee().to_sat(),"local BCH funding policy changed");
+        let signed=preview.verify_signed(&record.signed)?;
+        Ok((record,signed))
+    }
+    /// Bind already-approved local signatures to this trade before publishing
+    /// preparation. A retry retains original time and exact bytes; never re-sign.
+    pub fn retain_light_signed_funding(&mut self,claim:&ClaimedSpend,network:LightNetwork,
+        expected:sha256::Hash,sources:&[&[u8]],now:u64)->Result<SignedFunding> {
+        let signed=self.verify_light_signed_funding(claim,network,expected,sources,now)?;
+        self.require_no_node_funding_records()?;
+        let saved=self.local_record_bytes()?;
+        let prepared_at=if let Some(bytes)=&saved {
+            let (record,_)=self.validate_local_record(bytes)?;
+            ensure!(now>=record.template.prepared_at,"local BCH funding time moved backwards");
+            record.template.prepared_at
+        } else {
+            ensure!(self.prepared_bch_funding()?.is_none(),"existing BCH preparation cannot change funding source");
+            match Journal::open(&self.snapshots)?.read(&record_name(self.quote,"template")) {
+                Ok(_)=>anyhow::bail!("partial BCH preparation cannot change funding source"),
+                Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                Err(e)=>return Err(e),
+            }
+            now
+        };
+        let retained=claim.retained_bch_funding(network,self.quote.terms()["swapId"].parse()?,expected)?;
+        let change=retained.unsigned().output.get(1).or_else(||retained.previous_outputs().first())
+            .context("missing local BCH change policy")?;
+        let admission=self.admission_digest()?;
+        let record=LocalRecord {schema:LOCAL.into(),admission,network:network.storage_identity(),
+            claim:expected.to_byte_array(),template:Template {schema:TEMPLATE.into(),admission,prepared_at,
+                unsigned:serialize(retained.unsigned()),sources:sources.iter().map(|s|s.to_vec()).collect(),
+                change:change.script_pubkey.as_bytes().to_vec(),maximum_fee:claim.fee().to_sat(),
+                minimum_change:self.quote.terms()["bchMinimumOutputAtoms"].parse()?},signed:serialize(signed.transaction())};
+        let bytes=serde_json::to_vec(&record)?;
+        ensure!(bytes.len()<=2_000_000,"local BCH funding exceeds durable record limit");
+        self.validate_local_record(&bytes)?;
+        self.metadata.retain(&record_name(self.quote,"local-signed"),&bytes)?;
+        self.retain_bch_funding_preparation(prepared_at,&record.template.unsigned,sources,
+            bitcoin::Script::from_bytes(&record.template.change),record.template.maximum_fee,record.template.minimum_change)?;
+        self.restore_local_signed_funding()?.map(|(signed,_)|signed).context("local BCH funding publication incomplete")
+    }
+    /// Historical exact funding for existing recovery code, including after
+    /// expiry. Missing preparation is a partial publication, never relay consent.
+    pub(in crate::bch_key_recovery::authenticated::native_wallet::agreement::execution::funding)
+    fn restore_local_signed_funding(&self)->Result<Option<(SignedFunding,u64)>> {
+        let Some(bytes)=self.local_record_bytes()? else {return Ok(None)};
+        let (record,signed)=self.validate_local_record(&bytes)?;
+        let prepared=self.prepared_bch_funding()?.context("local BCH funding publication incomplete")?;
+        ensure!(*prepared.commitment()==hash(TEMPLATE,&serde_json::to_vec(&record.template)?),
+            "local BCH funding differs from retained preparation");
+        Ok(Some((signed,record.template.prepared_at)))
+    }
+}
