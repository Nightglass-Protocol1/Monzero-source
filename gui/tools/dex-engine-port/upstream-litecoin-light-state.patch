+use super::*;
+use crate::litecoin_light::{headers::tests::child,session::{ReadSession,
+    tests::{server,reply,hex,regtest_handshake}}};
+use bitcoin::{block::Header,consensus::{serialize,deserialize}};
+use serde_json::json;
+use std::{fs,os::unix::fs::PermissionsExt,path::PathBuf};
+struct Directory(PathBuf);
+impl Directory {
+    fn new() -> Result<Self> {
+        let path=std::env::temp_dir().join(format!("monzero-chain-state-{}",uuid::Uuid::new_v4()));
+        fs::create_dir(&path)?;fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;
+        Ok(Self(path.canonicalize()?))
+    }
+}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn descendant() -> Header {
+    let raw="000000209d08f789f2afaf053878d9b21add2f847fff4a9c32fb58b8c5c79ca166f94a9d111111111111111111111111111111111111111111111111111111111111111106e7494dffff7f2000000000";
+    let bytes: Vec<u8>=(0..raw.len()).step_by(2).map(|i|u8::from_str_radix(&raw[i..i+2],16).unwrap()).collect();
+    deserialize(&bytes).unwrap()
+}
+/// Exercise production tip parsing, fork discovery and download over two mock
+/// connections, not a fabricated SyncCandidate or a real network/node.
+async fn candidate(selected: &HeaderSequence,branch: &[Header],download: bool) -> Result<SyncCandidate> {
+    let last=branch.last().unwrap();
+    let mut responses=regtest_handshake();responses.push(reply(3,json!({"height":branch.len(),"hex":hex(&serialize(last))})));
+    let (stream,task)=server(responses);
+    let tip=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.reported_tip().await?;
+    assert_eq!(task.await?.len(),3);
+    // These fixed cases have a genesis or height-one selected chain.
+    assert!(selected.height()<=1);
+    let mut responses=regtest_handshake();let mut id=3;
+    let start=if selected.height()==1 {
+        responses.push(reply(id,json!(hex(&serialize(&branch[0])))));id+=1;
+        if selected.contains(1,branch[0].block_hash()) {1} else {0}
+    } else {0};
+    if download && start<branch.len() {
+        responses.push(reply(id,json!({"count":branch.len()-start,"max":2016,
+            "hex":hex(&branch[start..].iter().flat_map(serialize).collect::<Vec<_>>())})));
+    }
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut candidate=session.begin_sync(selected,tip).await?;
+    if download && !candidate.complete() {candidate.advance(&mut session,2016,1296688902).await?;}
+    drop(session);task.await?;Ok(candidate)
+}
+#[tokio::test]
+async fn state_sync_publication_and_reorg_survive_reopen() -> Result<()> {
+    let dir=Directory::new()?;let mut state=ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902)?;
+    assert_eq!(state.chain()?.height(),0);assert!(!dir.0.join("headers.bin").exists());
+    let first=candidate(state.chain()?,&[child()],true).await?;
+    assert_eq!(state.publish(first)?.unwrap().new_tip,(1,child().block_hash()));
+    assert!(ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902).is_err());drop(state);
+    let mut state=ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902)?;
+    assert!(state.chain()?.contains(1,child().block_hash()));
+    let mut alternate=child();alternate.nonce=0;
+    let fork=candidate(state.chain()?,&[alternate,descendant()],true).await?;
+    assert_eq!(state.publish(fork)?.unwrap().common_ancestor,0);
+    assert!(!state.chain()?.contains(1,child().block_hash()));drop(state);
+    let state=ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902)?;
+    assert!(state.chain()?.contains(1,alternate.block_hash()));assert!(state.chain()?.contains(2,descendant().block_hash()));
+    Ok(())
+}
+#[tokio::test]
+async fn state_incomplete_equal_work_and_policy_refusal_do_not_write() -> Result<()> {
+    let dir=Directory::new()?;let mut state=ChainState::open(&dir.0,LtcNetwork::Regtest,1,1296688902)?;
+    let pending=candidate(state.chain()?,&[child()],false).await?;
+    assert!(state.publish(pending).is_err());assert_eq!(state.chain()?.height(),0);assert!(!dir.0.join("headers.bin").exists());
+    let first=candidate(state.chain()?,&[child()],true).await?;state.publish(first)?;
+    let before=fs::read(dir.0.join("headers.bin"))?;
+    let equal=candidate(state.chain()?,&[child()],true).await?;assert!(state.publish(equal)?.is_none());
+    assert_eq!(fs::read(dir.0.join("headers.bin"))?,before);
+    let mut alternate=child();alternate.nonce=0;
+    let over=candidate(state.chain()?,&[alternate,descendant()],true).await?;
+    assert!(state.publish(over).is_err());assert!(state.chain()?.contains(1,child().block_hash()));
+    assert_eq!(fs::read(dir.0.join("headers.bin"))?,before);Ok(())
+}
+#[tokio::test]
+async fn state_publication_failure_requires_reopen_and_preserves_prior_record() -> Result<()> {
+    let dir=Directory::new()?;let mut state=ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902)?;
+    let first=candidate(state.chain()?,&[child()],true).await?;state.publish(first)?;
+    let mut alternate=child();alternate.nonce=0;
+    let next=candidate(state.chain()?,&[alternate,descendant()],true).await?;
+    let path=dir.0.join("headers.bin");let before=fs::read(&path)?;
+    // Deterministic storage refusal works even when tests run with broad privileges.
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o644))?;
+    assert!(state.publish(next).is_err());assert!(state.chain().is_err());assert_eq!(fs::read(&path)?,before);
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o600))?;assert!(state.chain().is_err());drop(state);
+    let state=ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902)?;
+    assert!(state.chain()?.contains(1,child().block_hash()));assert_eq!(state.chain()?.height(),1);drop(state);
+    let mut damaged=fs::read(&path)?;damaged[48]^=1;fs::write(&path,damaged)?;
+    assert!(ChainState::open(&dir.0,LtcNetwork::Regtest,2,1296688902).is_err());Ok(())
+}
+
+#[tokio::test]
+async fn state_ambiguous_publication_reopens_actual_durable_tip() -> Result<()> {
+    let dir=Directory::new()?;let mut state=ChainState::open(&dir.0,LtcNetwork::Regtest,1,1296688902)?;
+    let first=candidate(state.chain()?,&[child()],true).await?;
+    // Inject an error after actual publication. This exercises uncertainty at
+    // the cache API boundary; it does not claim to force an OS fsync failure.
+    assert!(state.publish_with(first,|cache,chain| {
+        cache.save(chain)?;anyhow::bail!("simulated error after cache publication")
+    }).is_err());
+    assert!(state.chain().is_err());drop(state);
+    let state=ChainState::open(&dir.0,LtcNetwork::Regtest,1,1296688902)?;
+    assert_eq!(state.chain()?.height(),1);assert!(state.chain()?.contains(1,child().block_hash()));
+    Ok(())
+}
