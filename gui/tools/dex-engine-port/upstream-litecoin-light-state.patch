+//! Coordinates selected headers, validated candidates and durable publication.
+//! Blocking cache replay and publication belong on an application worker.
+//! This is not a wallet, a freshness decision or signing authority.
+use super::{headers::{HeaderSequence,ChainChange,cache::HeaderCache},session::sync::SyncCandidate};
+use anyhow::{Result,ensure};
+use std::path::Path;
+use swap_core::litecoin_address::LtcNetwork;
+
+/// Owns the cache lease throughout synchronization. No mutable chain reference
+/// escapes, so updates through this API cannot bypass durable publication.
+pub struct ChainState {
+    cache: HeaderCache,
+    selected: HeaderSequence,
+    maximum_height: u32,
+    usable: bool,
+}
+impl ChainState {
+    /// Only an absent cache starts at genesis; a damaged cache is an error.
+    /// A restored chain still requires current network/freshness assessment.
+    pub fn open(directory: &Path,network: LtcNetwork,maximum_height: u32,now: u64) -> Result<Self> {
+        let cache=HeaderCache::open(directory,network)?;
+        let selected=match cache.load(maximum_height,now)? {
+            Some(chain)=>chain,
+            None=>HeaderSequence::new(network)?,
+        };
+        Ok(Self {cache,selected,maximum_height,usable:true})
+    }
+    pub fn chain(&self) -> Result<&HeaderSequence> {
+        ensure!(self.usable,"Litecoin chain state requires reopen after publication failure");
+        Ok(&self.selected)
+    }
+    /// Publish only a complete, stronger candidate within the resource policy.
+    /// Persistence precedes visibility; any persistence error invalidates this
+    /// handle, including when rename succeeded but directory sync failed.
+    /// Drop and reopen to reconcile the durable record before further use.
+    pub fn publish(&mut self,candidate: SyncCandidate) -> Result<Option<ChainChange>> {
+        self.publish_with(candidate,|cache,chain|cache.save(chain))
+    }
+    fn publish_with(&mut self,candidate: SyncCandidate,
+        save: impl FnOnce(&HeaderCache,&HeaderSequence)->Result<()>) -> Result<Option<ChainChange>> {
+        ensure!(candidate.target_height()<=self.maximum_height,"Litecoin candidate exceeds cache height policy");
+        let chain=self.chain()?;
+        let mut staged=chain.fork(chain.height())?;
+        let Some(change)=candidate.finish(&mut staged)? else {return Ok(None)};
+        self.usable=false;
+        save(&self.cache,&staged)?;
+        self.selected=staged;
+        self.usable=true;
+        Ok(Some(change))
+    }
+}
