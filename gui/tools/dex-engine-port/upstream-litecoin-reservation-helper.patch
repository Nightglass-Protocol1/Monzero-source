+    /// Resume an existing reservation before considering new inputs. Only an
+    /// absent intent permits construction; corruption or a different deployment
+    /// never falls back to another transaction. Concurrent publication still
+    /// fails closed in reserve_lock under the journal lease.
+    pub async fn prepare_or_resume_lock(&self,directory:&Path,trade:uuid::Uuid,
+        contract:&LtcSegwitAddress,amount:Amount,maximum_fee:Amount,fee_rate:u64)->Result<ReservedLock> {
+        ensure!(!trade.is_nil(),"invalid Litecoin reservation trade");
+        let journal=Journal::open(directory)?;
+        match journal.read(&format!("{trade}.intent")) {
+            Ok(bytes)=>{
+                let intent:Intent=serde_json::from_slice(&bytes)?;
+                ensure!(intent.trade==trade && intent.contract==contract.to_string()
+                    && intent.amount==amount.to_sat() && intent.maximum_fee==maximum_fee.to_sat(),
+                    "reservation differs from requested trade terms");
+                self.validate_intent(&intent)?;
+                drop(journal);
+                self.resume_lock(directory,trade).await
+            },
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                drop(journal);
+                let preview=self.preview_lock(contract,amount,fee_rate,maximum_fee).await?;
+                self.reserve_lock(directory,trade,contract,amount,maximum_fee,&preview).await
+            },
+            Err(error)=>Err(error),
+        }
+    }
