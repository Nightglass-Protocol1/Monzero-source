+#[cfg(target_os="linux")]
+#[test]
+fn execution_admission_owns_and_revalidates_both_negotiations() -> Result<()> {
+    use agreement::execution::{AdmittedExecution,NegotiationPins};
+    let setup = Setup::new()?; let snapshots = PrivateStore::new()?;
+    let (b,bv,bpin) = selected_with_outgoing(&setup,&snapshots.0,0)?;
+    let (n,nv,npin) = selected_with_outgoing(&setup,&snapshots.0,1)?;
+    for (role,selected,own,peer,initial) in [
+        (Role::BchFunder,&b,&bv,&nv,bpin),(Role::NativeFunder,&n,&nv,&bv,npin)] {
+        let metadata = PrivateStore::new()?;
+        let (wallet,received) = selected.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+            1003,own.commitment(),peer.frame(),peer.signature())?;
+        let ack = wallet.acknowledgement(&setup.quote)?;
+        let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+        let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,role,&agreed)?;
+        let pins = NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+        let admit = |metadata: &std::path::Path,review: &[u8;32],pins,now| AdmittedExecution::admit(metadata,
+            &snapshots.0,&setup.quote,&setup.policy,role,review,pins,now);
+        assert!(admit(&metadata.0,&[0;32],pins.clone(),1005).is_err());
+        assert!(admit(&metadata.0,setup.quote.commitment(),pins.clone(),1003).is_err());
+        assert!(admit(&metadata.0,setup.quote.commitment(),pins.clone(),2000).is_err());
+        let mut wrong = pins.clone(); wrong.received[0] ^= 1;
+        assert!(admit(&metadata.0,setup.quote.commitment(),wrong,1005).is_err());
+        assert!(admit(&snapshots.0,setup.quote.commitment(),pins.clone(),1005).is_err());
+        assert_eq!(std::fs::read_dir(&metadata.0)?.count(),0);
+        let execution = admit(&metadata.0,setup.quote.commitment(),pins.clone(),1005)?;
+        assert!(AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,role).is_err());
+        assert_eq!(*execution.restore_agreement()?.secret_checkpoint(&setup.quote)?,*agreed.secret_checkpoint(&setup.quote)?);
+        drop(execution);
+        let execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,role)?;
+        assert_eq!(execution.restore_agreement()?.commitment(),agreed.commitment());
+        drop(execution);
+        // An identical admission is an idempotent retry, not a replacement.
+        drop(admit(&metadata.0,setup.quote.commitment(),pins,1005)?);
+        let record = std::fs::read_dir(&metadata.0)?.next().unwrap()?.path();
+        std::fs::write(&record,b"{")?;
+        assert!(AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,role).is_err());
+    }
+    Ok(())
+}
