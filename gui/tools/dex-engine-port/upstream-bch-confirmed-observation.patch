+use super::*;
+use std::{io::{BufRead,BufReader,Read,Write},net::TcpListener,time::{Duration,Instant}};
+
+#[tokio::test]
+async fn bch_confirmation_rpc_checks_exact_lookup_and_stable_deployment_tip() -> Result<()> {
+    for (indexed,mode) in [(false,0),(false,1),(true,0),(true,1),(true,2)] {
+        let tx=tests::transaction();let txid=tx.compute_txid();let block=BlockHash::from_byte_array([7;32]);
+        let tip=BlockHash::from_byte_array([8;32]);let checkpoint=BlockHash::from_byte_array([4;32]);
+        let network=BchNetwork::Regtest {checkpoint_height:1,checkpoint};
+        let listener=TcpListener::bind("127.0.0.1:0")?;listener.set_nonblocking(true)?;
+        let port=listener.local_addr()?.port();
+        let server=std::thread::spawn(move || -> Result<()> {
+            let mut methods=vec!["getnetworkinfo","getblockchaininfo","getblockhash","getblockhash",
+                "getrawtransaction","getblockheader","getnetworkinfo","getblockchaininfo","getblockhash","getblockhash"];
+            if indexed {methods.insert(0,"getrawtransaction");}
+            if mode==2 {methods.truncate(1);}
+            for (i,method) in methods.iter().enumerate() {
+                let deadline=Instant::now()+Duration::from_secs(10);
+                let (mut socket,_)=loop {
+                    match listener.accept() {
+                        Ok(pair)=>break pair,
+                        Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>{
+                            ensure!(Instant::now()<deadline,"missing expected BCH observation RPC");
+                            std::thread::sleep(Duration::from_millis(1));
+                        },
+                        Err(e)=>return Err(e.into()),
+                    }
+                };
+                socket.set_read_timeout(Some(Duration::from_secs(10)))?;
+                let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();let mut length=None;
+                loop {
+                    line.clear();ensure!(reader.read_line(&mut line)?>0,"missing BCH request headers");
+                    if line=="\r\n" {break;}
+                    if let Some(value)=line.to_ascii_lowercase().strip_prefix("content-length:") {length=Some(value.trim().parse::<usize>()?);}
+                }
+                let length=length.context("missing BCH request length")?;ensure!(length<4096,"oversized BCH test request");
+                let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;let request:Value=serde_json::from_slice(&bytes)?;
+                ensure!(request["method"]==*method,"unexpected BCH confirmation RPC order");
+                let result=match *method {
+                    "getnetworkinfo"=>json!({"subversion":"/Bitcoin Cash Node:29.0.0/","networkactive":true}),
+                    "getblockchaininfo"=>json!({"chain":"regtest","blocks":102,"headers":102,"initialblockdownload":false,
+                        "bestblockhash":if mode==1 && i==7+usize::from(indexed) {BlockHash::from_byte_array([9;32])} else {tip}}),
+                    "getblockhash"=>{
+                        if request["params"]==json!([0]) {json!(network.genesis())}
+                        else {ensure!(request["params"]==json!([1]),"wrong BCH checkpoint");json!(checkpoint)}
+                    },
+                    "getrawtransaction" if indexed && i==0=>{
+                        ensure!(request["params"]==json!([txid,true]),"wrong BCH index lookup");
+                        json!({"txid":if mode==2 {Txid::from_byte_array([9;32])} else {txid},"blockhash":block})
+                    },
+                    "getrawtransaction"=>{
+                        ensure!(request["params"]==json!([txid,true,block]),"wrong BCH explicit block lookup");
+                        json!({"in_active_chain":true,"hex":serialize_hex(&tx),"txid":txid,"blockhash":block,"confirmations":3})
+                    },
+                    _=>{ensure!(request["params"]==json!([block,true]),"wrong BCH header lookup");json!({"hash":block,"height":100,"confirmations":3})},
+                };
+                let body=serde_json::to_vec(&json!({"id":request["id"],"error":null,"result":result}))?;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;socket.write_all(&body)?;
+            }
+            Ok(())
+        });
+        let rpc=BchRpc::new(port,"fixture".into(),"fixture".into(),network,"fixture".into(),
+            "bchreg:qanchor".into(),ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+        let result=if indexed {rpc.indexed_confirmed_transaction(txid,3).await} else {rpc.confirmed_transaction(txid,block,3).await};
+        server.join().unwrap()?;
+        if mode!=0 {assert!(result.is_err());} else {
+            let observed=result?;
+            assert_eq!(observed.transaction().compute_txid(),txid);assert_eq!(observed.confirmations(),3);
+            assert_eq!(observed.height(),100);assert_eq!(observed.block(),block);assert_eq!(observed.tip(),tip);
+            assert_eq!(observed.deployment(),&rpc.deployment_commitment()?);
+        }
+    }
+    Ok(())
+}
