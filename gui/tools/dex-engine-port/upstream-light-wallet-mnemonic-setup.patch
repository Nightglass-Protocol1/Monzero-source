+
+#[test]
+fn mnemonic_setup_reuses_keys_and_backup_after_each_interruption()->Result<()> {
+    use crate::litecoin_light::network::{BtcNetwork,BchNetwork,DogeNetwork};
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        for stage in [Publication::Intent,Publication::Vault,Publication::Addresses,Publication::Backup] {
+            let f=Fixture::new()?;
+            assert!(initialize_mode(&f.setup,&f.paths,network,f.wallet,3,PASSWORD,true,|current| {
+                ensure!(current!=stage,"injected publication interruption");Ok(())
+            }).is_err());
+            let intent=fs::read(f.setup.join(INTENT))?;
+            assert!(initialize_mnemonic(&f.setup,&f.paths,network,f.wallet,3,b"wrong").is_err());
+            assert!(initialize(&f.setup,&f.paths,network,f.wallet,3,PASSWORD).is_err());
+            assert_eq!(fs::read(f.setup.join(INTENT))?,intent);
+            let ready=initialize_mnemonic(&f.setup,&f.paths,network,f.wallet,3,PASSWORD)?;
+            let digest=ready.backup().digest();
+            let vault=MnemonicVault::open(&f.paths.vault,network,f.wallet)?;
+            let unlocked=vault.unlock_for_account(PASSWORD,&ready.account().descriptor())?;
+            assert_eq!(unlocked.material().word_count(),24);assert_eq!(unlocked.passphrase(),"");
+            assert!(!intent.windows(unlocked.material().reveal().len()).any(|bytes|bytes==unlocked.material().reveal().as_bytes()));
+            drop(vault);
+            assert_eq!(initialize_mnemonic(&f.setup,&f.paths,network,f.wallet,3,PASSWORD)?.backup().digest(),digest);
+            let destination=Fixture::new()?;
+            let (bundle,info)=mnemonic_backup::load_verified(&f.paths.backup,PASSWORD,network,f.wallet)?;
+            assert_eq!(info.allocated(),[0,0]);
+            let (restored,_book)=mnemonic_backup::restore(&destination.paths.vault,&destination.paths.addresses,network,f.wallet,PASSWORD,&bundle)?;
+            assert_eq!(&*restored.unlock_for_account(PASSWORD,&ready.account().descriptor())?.material().reveal(),&*unlocked.material().reveal());
+        }
+    }
+    Ok(())
+}
