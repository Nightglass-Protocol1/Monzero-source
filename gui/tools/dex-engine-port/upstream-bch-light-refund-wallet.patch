+#[test]
+fn refund_account_rejects_same_xpub_on_another_coin()->Result<()> {
+    use crate::litecoin_light::network::{BchNetwork,BtcNetwork};
+    let master=Xpriv::new_master(NetworkKind::Test,&[43;32])?;
+    let account=PublicAccount::from_master(&master,BchNetwork::Regtest,0)?;
+    let mut descriptor=serde_json::to_value(account.descriptor())?;
+    descriptor["schema"]=serde_json::json!("monzero-btc-public-account-v1");
+    let bitcoin=PublicAccount::from_descriptor(&serde_json::from_value(descriptor)?,BtcNetwork::Regtest)?;
+    // Historical address-book identity shares the common genesis; the new
+    // refund check must separately distinguish the selected coin/network.
+    assert_eq!(identity(&account),identity(&bitcoin));
+    let dir=Directory::new()?;
+    let mut book=AddressBook::create(&dir.0,PublicAccount::from_master(&master,BchNetwork::Regtest,0)?)?;
+    let address=book.reserve(Uuid::new_v4(),Branch::Receive)?;
+    let before=fs::read(dir.0.join(NAME))?;
+    book.require_allocated_address(&account,address.address())?;
+    assert!(book.require_allocated_address(&bitcoin,address.address()).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,before);
+    Ok(())
+}
