+++ b/swap-machine/src/native_quote_destinations.rs
@@ -10,6 +10,34 @@ pub struct QuoteDestinations {
     pub xmz_refund: XmzAddress,
 }
 
+/// Echoes caller correlation only; commitment is not independent quote evidence.
+pub fn validate_command(bytes: &[u8], btc: Network, xmz: XmzNetwork) -> Result<serde_json::Value> {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields, rename_all = "camelCase")]
+    struct Request {
+        schema: String, request_id: String, quote_commitment: String,
+        btc_payout: String, btc_refund: String, xmz_payout: String, xmz_refund: String,
+    }
+    ensure!(bytes.len() <= 2048, "oversized destination command");
+    let value: serde_json::Value = serde_json::from_slice(bytes)?;
+    ensure!(serde_json::to_vec(&value)? == bytes, "noncanonical destination command");
+    let request: Request = serde_json::from_value(value)?;
+    let id: uuid::Uuid = request.request_id.parse()?;
+    ensure!(request.schema == "monzero-native-destinations-request-v1"
+        && !id.is_nil() && id.to_string() == request.request_id, "invalid destination context");
+    ensure!(request.quote_commitment.len() == 64 && request.quote_commitment.bytes()
+        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)), "invalid quote commitment");
+    let destinations = QuoteDestinations::parse(btc, xmz, &request.btc_payout,
+        &request.btc_refund, &request.xmz_payout, &request.xmz_refund)?;
+    Ok(serde_json::json!({
+        "schema": "monzero-native-destinations-v1", "requestId": request.request_id,
+        "quoteCommitment": request.quote_commitment,
+        "btcPayout": destinations.btc_payout.to_string(), "btcRefund": destinations.btc_refund.to_string(),
+        "xmzPayout": destinations.xmz_payout.to_string(), "xmzRefund": destinations.xmz_refund.to_string(),
+        "valid": true, "executable": false
+    }))
+}
+
 impl QuoteDestinations {
     /// Networks must come from trusted deployment configuration, not the quote.
     /// Some Bitcoin networks share legacy prefixes; genesis is checked separately.
