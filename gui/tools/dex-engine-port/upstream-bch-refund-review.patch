+//! Public review of the exact privately retained refund. Returning a review
+//! exposes neither the refund signature nor permission to publish it.
+use super::*;
+use crate::bch_rpc::BchRpc;
+use serde_json::{Value,json};
+
+const REVIEW: &str="monzero-bch-refund-relay-review-v1";
+pub struct RefundRelayReview {pub details: Value,pub commitment: [u8;32]}
+impl AdmittedExecution<'_> {
+    fn refund_relay_materials(&self,safety_blocks: u32) -> Result<(RefundRelayReview,PrivateRecovery,[u8;32])> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH refund role");
+        let minimum=u64::from(self.policy.bch_confirmations);let delay=u64::from(self.policy.punish_blocks);
+        ensure!(minimum>0 && safety_blocks>0 && minimum.checked_add(u64::from(safety_blocks))
+            .is_some_and(|value|value<delay),"invalid BCH refund safety margin");
+        let recovery=self.retained_bch_recovery()?.context("missing private BCH recovery")?;
+        let funding=self.signed_bch_funding()?.context("missing exact BCH funding")?;
+        let prepared=self.prepared_bch_funding()?.context("missing BCH funding preparation")?;
+        let (locked,_)=self.funding_lock_intent(&prepared)?;
+        let refund: Transaction=deserialize(recovery.refund_bytes())?;
+        let source=OutPoint {txid:recovery.cancel().compute_txid(),vout:0};let plan=self.quote.recovery_plan();
+        ensure!(refund.input.len()==1 && refund.output.len()==1 && refund.input[0].previous_output==source,
+            "BCH refund recovery source changed");
+        let output=&refund.output[0];let fee=plan.recovery_atoms().checked_sub(output.value.to_sat()).context("invalid BCH refund fee")?;
+        ensure!(output.value.to_sat()==plan.final_recovery_atoms() && fee==plan.terms().recovery_fee_atoms
+            && output.script_pubkey==plan.terms().bch_funder_refund,"BCH refund destination or accounting changed");
+        let details=json!({"schema":REVIEW,"action":"broadcast-bch-refund","swapId":self.quote.terms()["swapId"],
+            "quote":self.quote.commitment(),"admission":self.admission_digest()?,"privateRecovery":recovery.commitment(),
+            "bchDeployment":locked.deployment,"bchNetwork":self.quote.terms()["bchNetwork"],"bchGenesis":self.quote.terms()["bchGenesis"],
+            "fundingOutpoint":funding.lock_outpoint(),"recoveryOutpoint":source,"txid":refund.compute_txid(),
+            "destinationScript":output.script_pubkey.to_hex_string(),"refundAtoms":output.value.to_sat().to_string(),"feeAtoms":fee.to_string(),
+            "preparedAt":recovery.prepared_at(),"minimumBchConfirmations":minimum,"punishDelayBlocks":delay,
+            "punishmentMarginBlocks":safety_blocks,"revealsNativeSpendShare":true});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((RefundRelayReview {details,commitment},recovery,locked.deployment))
+    }
+    /// Historical review survives quote expiry. Publication must separately
+    /// revalidate the exact review and current recovery-output safety window.
+    pub fn review_bch_refund_relay(&self,bch: &BchRpc,now: u64,safety_blocks: u32) -> Result<RefundRelayReview> {
+        let (review,recovery,deployment)=self.refund_relay_materials(safety_blocks)?;
+        ensure!(now>=recovery.prepared_at() && bch.deployment_commitment()?==deployment,
+            "BCH refund review predates preparation or changes observer");
+        Ok(review)
+    }
+}
