@@ -0,0 +1,96 @@
+//! Read-only historical preparation evidence, not broadcast or retry authority.
+use anyhow::{ensure, Result};
+use serde_json::Value;
+use std::path::Path;
+use super::{full_proceeds::ExactNetRequest, number, string};
+use swap_core::xmz::XmzAmount;
+
+pub struct ExactNetRecovery {
+    terms: Value,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn fixture() -> (Value,Value) {
+        let intent=json!({"schema":"monzero-exact-net-spend-intent-v1","genesis":"a".repeat(64),
+            "wallet":"fixture","lockTxid":"b".repeat(64),"topUpTxid":"c".repeat(64),
+            "totalAtoms":"110","principalAtoms":"100","destination":"buyer",
+            "reserveReturnDestination":"reserve","maximumFeeAtoms":"3","account":0,"priority":1});
+        let mut prepared=intent.clone();
+        prepared["schema"]=json!("monzero-exact-net-prepared-accounting-v1");
+        prepared["txid"]=json!("d".repeat(64));prepared["weight"]=json!(10);
+        prepared["reserveReturnAtoms"]=json!("8");prepared["feeAtoms"]=json!("2");
+        (intent,prepared)
+    }
+    #[test]
+    fn recovery_rejects_changed_context_and_prepared_terms() -> Result<()> {
+        let (intent,prepared)=fixture();
+        let loaded=ExactNetRecovery::decode(intent.clone(),prepared.clone(),&intent)?;
+        assert_eq!(loaded.terms(),&prepared);
+        for field in intent.as_object().unwrap().keys() {
+            let mut changed=intent.clone();changed[field]=json!(null);
+            assert!(ExactNetRecovery::decode(changed,prepared.clone(),&intent).is_err());
+            let mut changed=prepared.clone();changed[field]=json!(null);
+            assert!(ExactNetRecovery::decode(intent.clone(),changed,&intent).is_err());
+        }
+        let mut extra=prepared.clone();extra["tx_metadata"]=json!("secret");
+        assert!(ExactNetRecovery::decode(intent.clone(),extra,&intent).is_err());
+        Ok(())
+    }
+    #[test]
+    fn recovery_requires_exact_bounded_accounting_and_identity() {
+        let (intent,prepared)=fixture();
+        for (field,value) in [("feeAtoms",json!("0")),("feeAtoms",json!("4")),
+            ("feeAtoms",json!("02")),("feeAtoms",json!(2)),("reserveReturnAtoms",json!("9")),
+            ("reserveReturnAtoms",json!("0")),("reserveReturnAtoms",json!(u64::MAX.to_string())),
+            ("weight",json!(0)),("txid",json!("0".repeat(64))),("txid",json!("D".repeat(64)))] {
+            let mut changed=prepared.clone();changed[field]=value;
+            assert!(ExactNetRecovery::decode(intent.clone(),changed,&intent).is_err(),"accepted {field}");
+        }
+    }
+}
+
+impl ExactNetRecovery {
+    /// Expected terms come from retained trusted trade context, not these files.
+    /// Neither a successful load nor an absent receipt proves chain settlement.
+    #[cfg(unix)]
+    pub fn load(directory: &Path, genesis: &str, request: &ExactNetRequest,
+        top_up: &str) -> Result<Self> {
+        let expected=super::exact_net_journal::intent_terms(genesis,request,top_up)?;
+        let (intent,prepared)=super::spend_recovery::load_records(directory,genesis,
+            &request.source.wallet,&request.source.lock_txid)?;
+        Self::decode(intent,prepared,&expected)
+    }
+
+    #[cfg(not(unix))]
+    pub fn load(_: &Path, _: &str, _: &ExactNetRequest, _: &str) -> Result<Self> {
+        anyhow::bail!("exact-net recovery reader not implemented on this platform")
+    }
+
+    fn decode(intent: Value, prepared: Value, expected: &Value) -> Result<Self> {
+        ensure!(&intent == expected, "exact-net recovery intent differs from trusted terms");
+        ensure!(prepared.as_object().is_some_and(|value| value.len()==16)
+            && prepared["schema"]=="monzero-exact-net-prepared-accounting-v1",
+            "invalid exact-net prepared record");
+        super::exact_net_journal::check_terms(&intent,&prepared)?;
+        let txid=string(&prepared,"txid")?;
+        ensure!(txid.len()==64 && txid != "0".repeat(64)
+            && txid.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+            "invalid exact-net prepared transaction identity");
+        let atoms=|field| -> Result<u64> {
+            let amount=XmzAmount::from_atom_string(&string(&prepared,field)?)
+                .map_err(|_| anyhow::anyhow!("invalid exact-net recovery amount"))?;
+            ensure!(amount.atoms()>0,"zero exact-net recovery amount");Ok(amount.atoms())
+        };
+        let fee=atoms("feeAtoms")?;
+        ensure!(fee<=atoms("maximumFeeAtoms")? && number(&prepared,"weight")?>0
+            && atoms("principalAtoms")?.checked_add(atoms("reserveReturnAtoms")?)
+                .and_then(|total| total.checked_add(fee))==Some(atoms("totalAtoms")?),
+            "inconsistent exact-net recovery accounting");
+        Ok(Self { terms:prepared })
+    }
+
+    pub fn terms(&self) -> &Value { &self.terms }
+}
