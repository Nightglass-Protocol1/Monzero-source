+//! Encrypted mnemonic vault plus address allocations. Excludes trade journals.
+//! Retained files are never overwritten; exact restore retries are idempotent.
+use super::*;
+use crate::litecoin_light::account::allocation::AddressBook;
+use bitcoin::hashes::{Hash,sha256};
+const BUNDLE_MAGIC:&[u8;8]=b"MZMNBK01";
+const FILE:&str="litecoin-wallet.backup";
+const MAX_BUNDLE:usize=2_000_000;
+
+pub struct BackupInfo {digest:sha256::Hash,account:PublicAccount,wallet:Uuid,allocated:[u32;2]}
+impl BackupInfo {
+    pub fn digest(&self)->sha256::Hash {self.digest}
+    pub fn account(&self)->&PublicAccount {&self.account}
+    pub fn wallet_id(&self)->Uuid {self.wallet}
+    pub fn allocated(&self)->[u32;2] {self.allocated}
+}
+struct Decoded {vault:Vec<u8>,book:Vec<u8>,account:PublicAccount,allocated:[u32;2]}
+
+pub fn export(vault:&MnemonicVault,book:&AddressBook,password:&[u8])->Result<Vec<u8>> {
+    let (descriptor,record)=book.backup_parts()?;
+    let account=PublicAccount::from_descriptor(&descriptor,vault.network)?;
+    drop(vault.unlock_for_account(password,&descriptor)?);
+    let mut payload=Zeroizing::new(Vec::with_capacity(12+vault.bytes.len()+record.len()));
+    payload.extend_from_slice(&(vault.bytes.len() as u32).to_be_bytes());payload.extend_from_slice(&vault.bytes);
+    payload.extend_from_slice(&account.account_index().to_be_bytes());
+    payload.extend_from_slice(&(record.len() as u32).to_be_bytes());payload.extend_from_slice(&record);
+    ensure!(HEADER+payload.len()+16<=MAX_BUNDLE,"mnemonic backup exceeds record limit");
+    let mut salt=[0u8;16];let mut nonce=[0u8;24];
+    OsRng.try_fill_bytes(&mut salt).context("backup entropy unavailable")?;
+    OsRng.try_fill_bytes(&mut nonce).context("backup entropy unavailable")?;
+    let mut result=Vec::with_capacity(HEADER+payload.len()+16);
+    result.extend_from_slice(BUNDLE_MAGIC);result.extend_from_slice(vault.network.storage_identity().as_bytes());
+    result.extend_from_slice(vault.wallet.as_bytes());result.extend_from_slice(&salt);result.extend_from_slice(&nonce);
+    let key=super::super::super::key(password,&salt)?;
+    let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid backup key"))?;
+    cipher.encrypt_in_place(XNonce::from_slice(&nonce),&result,&mut *payload)
+        .map_err(|_|anyhow::anyhow!("mnemonic backup encryption failed"))?;
+    result.extend_from_slice(&payload);Ok(result)
+}
+fn decode(bundle:&[u8],password:&[u8],network:LightNetwork,wallet:Uuid)->Result<Decoded> {
+    ensure!(!wallet.is_nil() && bundle.len()>HEADER+16+12 && bundle.len()<=MAX_BUNDLE
+        && &bundle[..8]==BUNDLE_MAGIC && &bundle[8..72]==network.storage_identity().as_bytes()
+        && &bundle[72..88]==wallet.as_bytes(),"invalid mnemonic backup context");
+    let key=super::super::super::key(password,&bundle[88..104])?;
+    let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid backup key"))?;
+    let mut payload=Zeroizing::new(bundle[HEADER..].to_vec());
+    cipher.decrypt_in_place(XNonce::from_slice(&bundle[104..128]),&bundle[..HEADER],&mut *payload)
+        .map_err(|_|anyhow::anyhow!("mnemonic backup authentication failed"))?;
+    ensure!(payload.len()>=12,"truncated mnemonic backup payload");
+    let length=u32::from_be_bytes(payload[..4].try_into()?) as usize;
+    ensure!(length<=HEADER+MAX_PAYLOAD+16 && payload.len()>=length+12,"invalid mnemonic vault length");
+    let vault=payload[4..length+4].to_vec();
+    let unlocked=decode_record(&vault,password,network,wallet)?;
+    let index=u32::from_be_bytes(payload[length+4..length+8].try_into()?);
+    let count=u32::from_be_bytes(payload[length+8..length+12].try_into()?) as usize;
+    ensure!(count>0 && count==payload.len()-length-12,"invalid mnemonic address record length");
+    let account=unlocked.public_account(network,index)?;
+    let book=payload[length+12..].to_vec();
+    let allocated=AddressBook::backup_counts(&account,&book)?;
+    Ok(Decoded {vault,book,account,allocated})
+}
+pub fn inspect(bundle:&[u8],password:&[u8],network:impl Into<LightNetwork>,wallet:Uuid)->Result<BackupInfo> {
+    let decoded=decode(bundle,password,network.into(),wallet)?;
+    Ok(BackupInfo {digest:sha256::Hash::hash(bundle),account:decoded.account,wallet,allocated:decoded.allocated})
+}
+pub fn save_verified(directory:&Path,bundle:&[u8],password:&[u8],network:impl Into<LightNetwork>,wallet:Uuid)->Result<BackupInfo> {
+    let info=inspect(bundle,password,network,wallet)?;let journal=Journal::open(directory)?;
+    journal.retain(FILE,bundle)?;ensure!(journal.read(FILE)?==bundle,"mnemonic backup read-back mismatch");Ok(info)
+}
+pub fn load_verified(directory:&Path,password:&[u8],network:impl Into<LightNetwork>,wallet:Uuid)->Result<(Vec<u8>,BackupInfo)> {
+    let journal=Journal::open(directory)?;let bundle=journal.read(FILE)?;
+    let info=inspect(&bundle,password,network,wallet)?;Ok((bundle,info))
+}
+/// Preflight both destinations before publishing either. An interruption may
+/// leave the vault alone retained; retry the identical bundle to finish safely.
+pub fn restore(vault_directory:&Path,book_directory:&Path,network:impl Into<LightNetwork>,wallet:Uuid,
+    password:&[u8],bundle:&[u8])->Result<(MnemonicVault,AddressBook)> {
+    let network=network.into();let decoded=decode(bundle,password,network,wallet)?;
+    let vault_journal=Journal::open(vault_directory)?;let book_journal=Journal::open(book_directory)?;
+    vault_journal.compatible(RECORD,&decoded.vault)?;
+    AddressBook::restore_preflight(&book_journal,&decoded.account,&decoded.book)?;
+    vault_journal.retain(RECORD,&decoded.vault)?;
+    let book=AddressBook::restore_record(book_journal,decoded.account,decoded.book)?;
+    Ok((MnemonicVault {journal:vault_journal,network,wallet,bytes:decoded.vault},book))
+}
