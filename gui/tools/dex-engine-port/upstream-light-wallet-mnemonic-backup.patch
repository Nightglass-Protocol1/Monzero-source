+use super::*;
+use crate::litecoin_light::{account::Branch,network::{BtcNetwork,BchNetwork,DogeNetwork}};
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("mnemonic-backup-{}",Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+const PASSWORD:&[u8]=b"disposable mnemonic backup password";
+
+#[test]
+fn four_chain_backup_restores_mnemonic_passphrase_and_allocations()->Result<()> {
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        let source=Directory::new()?;let allocations=Directory::new()?;let saved=Directory::new()?;
+        let material=MnemonicMaterial::from_entropy(&[7;32])?;let wallet=Uuid::new_v4();
+        let vault=MnemonicVault::create(&source.0,network,wallet,PASSWORD,&material,"recovery passphrase")?;
+        let account=material.public_account(network,3,"recovery passphrase")?;
+        let mut book=AddressBook::create(&allocations.0,material.public_account(network,3,"recovery passphrase")?)?;
+        let receive=Uuid::new_v4();book.reserve(receive,Branch::Receive)?;book.reserve(Uuid::new_v4(),Branch::Change)?;
+        book.reserve(Uuid::new_v4(),Branch::Receive)?;
+        let bundle=export(&vault,&book,PASSWORD)?;
+        assert_eq!(save_verified(&saved.0,&bundle,PASSWORD,network,wallet)?.allocated(),[2,1]);
+        assert_eq!(load_verified(&saved.0,PASSWORD,network,wallet)?.0,bundle);
+        assert!(inspect(&bundle,b"wrong",network,wallet).is_err());
+        assert!(inspect(&bundle,PASSWORD,network,Uuid::new_v4()).is_err());
+        let other=if network==LightNetwork::Bitcoin(BtcNetwork::Regtest) {LightNetwork::BitcoinCash(BchNetwork::Regtest)} else {LightNetwork::Bitcoin(BtcNetwork::Regtest)};
+        assert!(inspect(&bundle,PASSWORD,other,wallet).is_err());
+        let mut corrupt=bundle.clone();let last=corrupt.len()-1;corrupt[last]^=1;
+        assert!(inspect(&corrupt,PASSWORD,network,wallet).is_err());
+        let destination=Directory::new()?;let target_book=Directory::new()?;
+        assert!(restore(&destination.0,&target_book.0,network,wallet,b"wrong",&bundle).is_err());
+        assert_eq!(fs::read_dir(&destination.0)?.count(),0);assert_eq!(fs::read_dir(&target_book.0)?.count(),0);
+        // Simulate a crash after the first of the two publication steps.
+        let decoded=decode(&bundle,PASSWORD,network,wallet)?;
+        Journal::open(&destination.0)?.retain(RECORD,&decoded.vault)?;
+        let (restored,mut restored_book)=restore(&destination.0,&target_book.0,network,wallet,PASSWORD,&bundle)?;
+        let unlocked=restored.unlock_for_account(PASSWORD,&account.descriptor())?;
+        assert_eq!(&*unlocked.material().reveal(),&*material.reveal());assert_eq!(unlocked.passphrase(),"recovery passphrase");
+        assert_eq!(restored_book.allocated_count(Branch::Receive)?,2);assert_eq!(restored_book.allocated_count(Branch::Change)?,1);
+        // Reusing the original request must return the original address.
+        assert_eq!(restored_book.reserve(receive,Branch::Receive)?.address(),account.derive(Branch::Receive,0)?.address());
+        let vault_bytes=fs::read(destination.0.join(RECORD))?;
+        let book_bytes=fs::read(target_book.0.join("litecoin-address-book.json"))?;
+        drop(restored);drop(restored_book);
+        let (restored,mut restored_book)=restore(&destination.0,&target_book.0,network,wallet,PASSWORD,&bundle)?;
+        assert_eq!(fs::read(destination.0.join(RECORD))?,vault_bytes);
+        assert_eq!(fs::read(target_book.0.join("litecoin-address-book.json"))?,book_bytes);
+        assert_eq!(restored_book.reserve(Uuid::new_v4(),Branch::Receive)?.address(),account.derive(Branch::Receive,2)?.address());
+        drop(restored);drop(restored_book);
+        // An older backup cannot reset allocations that have advanced.
+        assert!(restore(&destination.0,&target_book.0,network,wallet,PASSWORD,&bundle).is_err());
+        assert_eq!(fs::read(destination.0.join(RECORD))?,vault_bytes);
+    }
+    Ok(())
+}
+
+#[test]
+fn conflicting_address_record_refuses_vault_publication()->Result<()> {
+    let network=LightNetwork::Litecoin(LtcNetwork::Regtest);let wallet=Uuid::new_v4();
+    let source=Directory::new()?;let addresses=Directory::new()?;let destination=Directory::new()?;let target=Directory::new()?;
+    let material=MnemonicMaterial::from_entropy(&[8;16])?;
+    let vault=MnemonicVault::create(&source.0,network,wallet,PASSWORD,&material,"")?;
+    let book=AddressBook::create(&addresses.0,material.public_account(network,0,"")?)?;
+    let bundle=export(&vault,&book,PASSWORD)?;
+    let mut other=AddressBook::create(&target.0,material.public_account(network,0,"")?)?;
+    other.reserve(Uuid::new_v4(),Branch::Receive)?;drop(other);
+    let before=fs::read(target.0.join("litecoin-address-book.json"))?;
+    assert!(restore(&destination.0,&target.0,network,wallet,PASSWORD,&bundle).is_err());
+    assert!(!destination.0.join(RECORD).exists());assert_eq!(fs::read(target.0.join("litecoin-address-book.json"))?,before);
+    Ok(())
+}
