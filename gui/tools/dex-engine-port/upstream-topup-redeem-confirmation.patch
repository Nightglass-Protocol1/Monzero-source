+/// The address a `TopUpRequest` targets must be exactly the one this trade's
+/// protocol actually derives, never a value trusted from elsewhere. Callers
+/// obtain `spend`/`view` from `bob::State5::xmr_keys()` after
+/// `bob::State4::watch_for_redeem_btc_confirmed` -- which enforces the
+/// required Bitcoin confirmation depth -- and must call this immediately
+/// before reserving, not rely on an earlier binding.
+pub fn authorize_recovered_destination(request: &TopUpRequest, network: XmzNetwork,
+    spend: monero_oxide_ext::PrivateKey, view: monero::PrivateViewKey) -> Result<()> {
+    let address = XmzAddress::new(network, monero_address::AddressType::Legacy,
+        monero_oxide_ext::PublicKey::from_private_key(&spend).decompress(),
+        view.public().0.decompress())?;
+    ensure!(address == request.destination,
+        "recovered swap address does not match the approved top-up destination");
+    Ok(())
+}
