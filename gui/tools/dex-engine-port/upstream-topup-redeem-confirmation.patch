+    /// Like `watch_for_redeem_btc`, but only recovers the key once the redeem
+    /// transaction has reached `required_confirmations`, not merely been seen.
+    /// A caller about to authorize a new payment against the recovered key
+    /// (rather than just reacting to it) needs this stronger depth guarantee;
+    /// `required_confirmations` is local policy, never a peer-supplied value.
+    pub async fn watch_for_redeem_btc_confirmed(
+        &self,
+        bitcoin_wallet: &dyn bitcoin_wallet::BitcoinWallet,
+        required_confirmations: u32,
+    ) -> Result<State5> {
+        anyhow::ensure!(required_confirmations > 0, "invalid required confirmation depth");
+        let tx_redeem =
+            bitcoin::TxRedeem::new(&self.tx_lock, &self.redeem_address, self.tx_redeem_fee);
+
+        bitcoin_wallet
+            .subscribe_to(Box::new(tx_redeem))
+            .await
+            .wait_until_confirmed_with(required_confirmations)
+            .await?;
+
+        let state5 = self.check_for_tx_redeem(bitcoin_wallet).await?;
+
+        state5.ok_or_else(|| {
+            anyhow!("Bitcoin redeem transaction was not found in the chain even though we previously saw it confirmed. Our Electrum server might have reorged?")
+        })
+    }
+
