+
+    #[test]
+    fn authorization_binds_the_exact_recovered_address_and_rejects_any_other() {
+        use swap_core::monero::{PrivateKey as XmrPrivateKey, PrivateViewKey, Scalar};
+        let network = XmzNetwork::Mainnet;
+        let spend = XmrPrivateKey::from_scalar(Scalar::ONE);
+        let view = PrivateViewKey(XmrPrivateKey::from_scalar(Scalar::ONE) + XmrPrivateKey::from_scalar(Scalar::ONE));
+        let destination = XmzAddress::new(network, monero_address::AddressType::Legacy,
+            monero_oxide_ext::PublicKey::from_private_key(&spend).decompress(),
+            view.public().0.decompress()).unwrap();
+        let mut request = request();
+        request.destination = destination;
+        assert!(authorize_recovered_destination(&request, network, spend, view).is_ok());
+
+        let wrong_spend = XmrPrivateKey::from_scalar(Scalar::ONE) + XmrPrivateKey::from_scalar(Scalar::ONE) + XmrPrivateKey::from_scalar(Scalar::ONE);
+        assert!(authorize_recovered_destination(&request, network, wrong_spend, view).is_err());
+        let wrong_view = PrivateViewKey(XmrPrivateKey::from_scalar(Scalar::ONE));
+        assert!(authorize_recovered_destination(&request, network, spend, wrong_view).is_err());
+        assert!(authorize_recovered_destination(&request, XmzNetwork::Testnet, spend, view).is_err());
+    }
