diff --git a/swap-machine/src/bin/native-ltc-light/import_recovery.rs b/swap-machine/src/bin/native-ltc-light/import_recovery.rs
new file mode 100644
--- /dev/null
+++ b/swap-machine/src/bin/native-ltc-light/import_recovery.rs
@@ -0,0 +1,60 @@
+// Private imported-wallet recovery. Retains allocations and an exact encrypted
+// backup; never publishes a normal configuration or activates spending/trading.
+use super::*;
+use swap_machine::litecoin_light::{vault::mnemonic::storage::MnemonicVault,
+    session::wallet::recovery::retention::mnemonic::{Approval,Destinations,resume_mnemonic_recovery}};
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct RecoveryRequest {
+    schema:String,request_id:uuid::Uuid,approved_config_digest:String,recovery_approved:bool,
+    approved_review:Value,approved_review_digest:String,resume:bool,
+    journal_directory:PathBuf,backup_directory:PathBuf,password:Password,
+    maximum_download_headers:u32,known_minimum:[u32;2],wallet_scan:WalletScan,
+}
+pub(super) fn run(path:&Path)->Result<()> {
+    let mut input=Zeroizing::new(Vec::with_capacity(16_385));
+    std::io::stdin().take(16_385).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=16_384,"invalid import recovery request size");
+    let request:RecoveryRequest=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-wallet-import-recover-request-v1"))
+        .context("invalid import recovery schema")?;
+    ensure!(request.recovery_approved && !request.request_id.is_nil(),"missing import recovery approval");
+    let digest:sha256::Hash=request.approved_review_digest.parse()?;
+    ensure!(digest.to_string()==request.approved_review_digest
+        && sha256::Hash::hash(&serde_json::to_vec(&request.approved_review)?)==digest,
+        "discovery review differs from approval");
+    let (_lease,config,configuration)=discovery::pending_config(path,tag,&request.approved_config_digest)?;
+    let network=network_for(tag,&config.network)?;
+    let wallet=config.wallet.as_ref().context("missing imported wallet")?;
+    let vault_config=wallet.vault.as_ref().context("missing imported vault")?;
+    ensure!(matches!(vault_config.seed_encoding,vault_format::VaultFormat::Mnemonic),"wrong imported key format");
+    let review=&request.approved_review;
+    ensure!(review["schema"]==format!("monzero-{tag}-light-import-discovery-review-v1")
+        && review["configurationDigest"]==configuration.to_string()
+        && review["walletId"]==vault_config.wallet_id.to_string(),"discovery review context mismatch");
+    let coverage:sha256::Hash=serde_json::from_value(review["coverageCommitment"].clone())?;
+    ensure!(sha256::Hash::hash(&serde_json::to_vec(&review["coverage"])?)==coverage,
+        "discovery coverage differs from review");
+    let approval=Approval {coverage,configuration};
+    let destinations=Destinations {journal:&request.journal_directory,backup:&request.backup_directory};
+    let mut book=AddressBook::open(&wallet.address_book_directory,PublicAccount::from_descriptor(&wallet.account,network)?)?;
+    let vault=MnemonicVault::open(&vault_config.directory,network,vault_config.wallet_id)?;
+    // Authenticate before server contact or header-cache updates.
+    drop(vault.unlock_for_account(request.password.0.as_bytes(),&wallet.account)?);
+    let receipt=if request.resume {
+        // Retained allocation recovery requires only the already selected chain;
+        // it does not refresh balances or contact the discovery endpoint.
+        let state=ChainState::open(&config.cache_directory,network,config.maximum_height,now()?)?;
+        resume_mnemonic_recovery(&destinations,state.chain()?,&mut book,&vault,request.password.0.as_bytes(),&approval)?
+    } else {
+        let (state,coverage,fresh,_)=discovery::observe(&config,tag,configuration,&book,&request.wallet_scan,
+            request.known_minimum,request.maximum_download_headers)?;
+        ensure!(fresh==request.approved_review && sha256::Hash::hash(&serde_json::to_vec(&fresh)?)==digest,
+            "discovery changed; review again before recovery");
+        coverage.retain_mnemonic_recovery(&destinations,state.chain()?,&mut book,&vault,
+            request.password.0.as_bytes(),&approval)?
+    };
+    output(&json!({"schema":format!("monzero-{tag}-light-wallet-import-recover-response-v1"),
+        "requestId":request.request_id,"recovery":receipt,"activationRequired":true,"executable":false}))
+}
