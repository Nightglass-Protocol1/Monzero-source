+use super::*;
+use crate::litecoin_light::session::{ReadSession,tests::{server,reply,regtest_handshake}};
+async fn rate()->Result<ReportedFeeRate> {
+    let mut responses=regtest_handshake();responses.push(reply(3,serde_json::json!(0.00001)));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let rate=session.reported_fee_rate(6,1000).await?.unwrap();drop(session);assert_eq!(task.await?.len(),3);Ok(rate)
+}
+fn policy()->EstimatedPaymentPolicy {EstimatedPaymentPolicy {minimum_change:Amount::from_sat(1000),change_index:0,minimum_confirmations:1,maximum_fee:Amount::from_sat(10000)}}
+#[tokio::test]
+async fn estimated_selection_adds_inputs_to_cover_their_fee()->Result<()> {
+    let (_,account,chain,credit,mut payment)=super::super::tests::fixture()?;let rate=rate().await?;
+    let inputs=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    payment.value=Amount::from_sat(79900);let mut policy=policy();policy.minimum_change=Amount::from_sat(1);
+    let (review,size)=ConfirmedSpendReview::select_estimated_payment(&chain,&observed,&account,&inputs,&payment,&policy,&rate)?;
+    assert_eq!(review.transaction().input.len(),2);assert_eq!(review.fee().to_sat(),size);
+    assert_eq!(review.transaction().output[0],payment);
+    assert_eq!(review.transaction().output.iter().map(|out|out.value.to_sat()).sum::<u64>()+review.fee().to_sat(),130000);
+    assert_eq!(rate.p2wpkh_fee(review.transaction(),policy.maximum_fee)?,(size,review.fee()));Ok(())
+}
+#[tokio::test]
+async fn estimated_selection_accepts_exact_no_change_under_tight_fee_cap()->Result<()> {
+    let (_,account,chain,credit,mut payment)=super::super::tests::fixture()?;let rate=rate().await?;
+    let inputs=[IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    payment.value=Amount::from_sat(80000);
+    let template=ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&PaymentPolicy {
+        fee:Amount::ZERO,minimum_change:Amount::from_sat(1000),change_index:0,minimum_confirmations:1})?;
+    let (_,fee)=rate.p2wpkh_fee(template.transaction(),Amount::from_sat(10000))?;
+    payment.value=Amount::from_sat(80000-fee.to_sat());let mut policy=policy();policy.maximum_fee=fee;
+    let (review,_)=ConfirmedSpendReview::select_estimated_payment(&chain,&observed,&account,&inputs,&payment,&policy,&rate)?;
+    assert_eq!(review.transaction().output.len(),1);assert_eq!(review.fee(),fee);Ok(())
+}
+#[tokio::test]
+async fn estimated_selection_rejects_small_change_and_excess_fees()->Result<()> {
+    let (_,account,chain,credit,mut payment)=super::super::tests::fixture()?;let rate=rate().await?;
+    let inputs=[IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    payment.value=Amount::from_sat(79800);
+    assert!(ConfirmedSpendReview::select_estimated_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&rate).err().unwrap().to_string().contains("cannot meet"));
+    payment.value=Amount::from_sat(40000);let mut capped=policy();capped.maximum_fee=Amount::from_sat(1);
+    assert!(ConfirmedSpendReview::select_estimated_payment(&chain,&observed,&account,&inputs,&payment,&capped,&rate).err().unwrap().to_string().contains("exceeds maximum"));Ok(())
