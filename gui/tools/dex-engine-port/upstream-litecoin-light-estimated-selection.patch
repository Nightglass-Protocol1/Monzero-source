@@ -0,0 +1,51 @@
+//! Fee-aware deterministic selection. Pure review: no allocation, claims or relay.
+use super::*;
+use crate::litecoin_light::session::fees::ReportedFeeRate;
+pub struct EstimatedPaymentPolicy {
+    pub minimum_change:Amount,
+    pub change_index:u32,
+    pub minimum_confirmations:u64,
+    pub maximum_fee:Amount,
+}
+impl ConfirmedSpendReview {
+    /// Test each largest-first prefix with exact no-change fees, then with
+    /// change. Never burn a small remainder as extra fee. The quote assumes
+    /// native P2WPKH witnesses and is not a fee/confirmation guarantee.
+    pub fn select_estimated_payment(chain:&HeaderSequence,observed:&ObservedWallet,account:&PublicAccount,
+        candidates:&[IncludedInput<'_>],payment:&TxOut,policy:&EstimatedPaymentPolicy,
+        rate:&ReportedFeeRate)->Result<(Self,u64)> {
+        ensure!(payment.value.to_sat()>0 && !payment.script_pubkey.is_empty() && payment.script_pubkey.len()<=10000
+            && policy.minimum_change.to_sat()>0,"invalid Litecoin estimated payment policy");
+        let eligible=eligible_inputs(chain,observed,account,candidates,policy.minimum_confirmations)?;
+        let change_script=account.derive(Branch::Change,policy.change_index)?.address().script_pubkey().clone();
+        let mut selected=Vec::new();let mut total=0u64;
+        for (value,_,candidate) in eligible {
+            total=total.checked_add(value).context("Litecoin selected amount overflow")?;
+            selected.push(IncludedInput {transaction:candidate.transaction,vout:candidate.vout,
+                branch:candidate.branch,index:candidate.index});
+            let input=selected.iter().map(|candidate|TxIn {
+                previous_output:OutPoint {txid:candidate.transaction.txid(),vout:candidate.vout},
+                script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new(),
+            }).collect();
+            let mut transaction=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+                input,output:vec![payment.clone()]};
+            let (size,fee)=rate.p2wpkh_fee(&transaction,policy.maximum_fee)?;
+            let required=payment.value.to_sat().checked_add(fee.to_sat()).context("Litecoin estimated payment overflow")?;
+            if total==required {
+                return Ok((Self::new(chain,account,transaction,&selected,payment,None,fee,policy.minimum_confirmations)?,size));
+            }
+            transaction.output.push(TxOut {value:Amount::from_sat(1),script_pubkey:change_script.clone()});
+            let (size,fee)=rate.p2wpkh_fee(&transaction,policy.maximum_fee)?;
+            let required=payment.value.to_sat().checked_add(fee.to_sat()).context("Litecoin estimated payment overflow")?;
+            if let Some(change)=total.checked_sub(required) {
+                if change>=policy.minimum_change.to_sat() {
+                    transaction.output[1].value=Amount::from_sat(change);
+                    return Ok((Self::new(chain,account,transaction,&selected,payment,Some(policy.change_index),fee,policy.minimum_confirmations)?,size));
+                }
+            }
+        }
+        anyhow::bail!("Litecoin candidates cannot meet estimated payment, fee and change policy")
+    }
+}
+#[cfg(test)]
+mod tests;
