+// Explicit local wallet operations; no payout, export or automatic retry.
+use super::*;
+use zeroize::Zeroizing;
+
+pub(super) struct Submission {pub approved:[u8;32],pub password:Zeroizing<String>}
+fn secret<'de,D:serde::Deserializer<'de>>(deserializer:D)->std::result::Result<Zeroizing<String>,D::Error> {
+    String::deserialize(deserializer).map(Zeroizing::new)
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct Request {
+    schema:String,request_id:uuid::Uuid,action:Action,commitment:String,
+    #[serde(deserialize_with="secret")]
+    password:Zeroizing<String>,
+}
+pub(super) fn request(bytes:&[u8])->Result<(ReviewRequest,Submission)> {
+    ensure!(!bytes.is_empty() && bytes.len()<=4096,"invalid refund wallet submission size");
+    let value:Request=serde_json::from_slice(bytes)?;
+    ensure!(value.schema=="monzero-bch-native-refund-wallet-submit-request-v1" && !value.request_id.is_nil(),
+        "invalid refund wallet submission context");
+    let approved=parse_digest(&value.commitment)?;
+    ensure!(approved!=[0;32],"missing refund wallet approval");
+    ensure!(value.password.len()<=1024 && !value.password.chars().any(char::is_control),"invalid refund wallet password");
+    match value.action {
+        Action::Restore|Action::Open=>ensure!(!value.password.is_empty(),"missing refund wallet password"),
+        Action::Check=>ensure!(value.password.is_empty(),"unexpected check password"),
+    }
+    Ok((ReviewRequest {schema:"monzero-bch-native-refund-wallet-review-request-v1".into(),
+        request_id:value.request_id,action:value.action},Submission {approved,password:value.password}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn fixture(action:&str)->serde_json::Value {
+        json!({"schema":"monzero-bch-native-refund-wallet-submit-request-v1","requestId":uuid::Uuid::new_v4(),
+            "action":action,"commitment":"ab".repeat(32),"password":if action=="check" {""} else {"fixture password"}})
+    }
+    fn accepts(value:&serde_json::Value)->bool {request(&serde_json::to_vec(value).unwrap()).is_ok()}
+    #[test]
+    fn submit_requires_exact_approval_and_explicit_context() {
+        for action in ["restore","open","check"] {
+            let base=fixture(action);assert!(accepts(&base));
+            for (field,bad) in [("schema",json!("monzero-bch-native-refund-wallet-review-request-v1")),
+                ("requestId",json!(uuid::Uuid::nil())),("action",json!("send")),
+                ("commitment",json!("AB".repeat(32))),("commitment",json!("0".repeat(64))),
+                ("commitment",json!("ab")),("commitment",serde_json::Value::Null),
+                ("spendKey",json!("unexpected")),("retry",json!(true))] {
+                let mut changed=base.clone();changed[field]=bad;assert!(!accepts(&changed),"{field}");
+            }
+            for field in ["schema","requestId","action","commitment","password"] {
+                let mut changed=base.clone();changed.as_object_mut().unwrap().remove(field);assert!(!accepts(&changed),"{field}");
+            }
+        }
+    }
+    #[test]
+    fn submit_password_is_action_bound_and_bounded() {
+        for action in ["restore","open","check"] {
+            let base=fixture(action);
+            for bad in [json!("a".repeat(1025)),json!("bad\u{0}password"),json!("bad\npassword"),json!(false),serde_json::Value::Null] {
+                let mut changed=base.clone();changed["password"]=bad;assert!(!accepts(&changed));
+            }
+            let mut changed=base;changed["password"]=json!(if action=="check" {"unexpected"} else {""});assert!(!accepts(&changed));
+        }
+        assert!(request(&[]).is_err());assert!(request(&vec![b' ';4097]).is_err());
+        let mut value=fixture("restore");value["password"]=json!("a".repeat(1024));assert!(accepts(&value));
+        let mut value=fixture("open");value["password"]=json!("local π password");assert!(accepts(&value));
+    }
+}
