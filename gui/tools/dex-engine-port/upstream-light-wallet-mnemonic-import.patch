+use super::*;
+use crate::litecoin_light::network::{BtcNetwork,BchNetwork,DogeNetwork};
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("mnemonic-import-{}",Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+#[test]
+fn imported_words_and_passphrase_match_saved_account_before_publication()->Result<()> {
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        let directory=Directory::new()?;let wallet=Uuid::new_v4();let password=b"disposable import password";
+        let material=MnemonicMaterial::from_entropy(&[7;16])?;let phrase=material.reveal();
+        let account=material.public_account(network,3,"fixture passphrase")?;
+        let imported=MnemonicMaterial::parse(&phrase)?;
+        assert!(MnemonicVault::restore_material(&directory.0,network,wallet,password,&imported,"wrong",&account.descriptor()).is_err());
+        assert_eq!(fs::read_dir(&directory.0)?.count(),0);
+        let wrong=MnemonicMaterial::from_entropy(&[8;16])?;
+        assert!(MnemonicVault::restore_material(&directory.0,network,wallet,password,&wrong,"fixture passphrase",&account.descriptor()).is_err());
+        assert_eq!(fs::read_dir(&directory.0)?.count(),0);
+        let vault=MnemonicVault::restore_material(&directory.0,network,wallet,password,&imported,"fixture passphrase",&account.descriptor())?;
+        assert_eq!(&*vault.unlock_for_account(password,&account.descriptor())?.material().reveal(),&*phrase);
+        let bytes=fs::read(directory.0.join(RECORD))?;drop(vault);
+        drop(MnemonicVault::restore_material(&directory.0,network,wallet,password,&imported,"fixture passphrase",&account.descriptor())?);
+        assert_eq!(fs::read(directory.0.join(RECORD))?,bytes);
+        assert!(MnemonicVault::restore_material(&directory.0,network,wallet,b"wrong password",&imported,"fixture passphrase",&account.descriptor()).is_err());
+        assert!(MnemonicVault::restore_material(&directory.0,network,Uuid::new_v4(),password,&imported,"fixture passphrase",&account.descriptor()).is_err());
+        assert_eq!(fs::read(directory.0.join(RECORD))?,bytes);
+        assert!(MnemonicMaterial::parse("abandon abandon").is_err());
+    }
+    Ok(())
+}
