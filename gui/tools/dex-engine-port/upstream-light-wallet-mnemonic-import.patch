+
+// BIP39 permits an empty additional passphrase; the vault password does not.
+struct RecoveryPassphrase(Zeroizing<String>);
+impl<'de> Deserialize<'de> for RecoveryPassphrase {
+    fn deserialize<D:serde::Deserializer<'de>>(deserializer:D)->std::result::Result<Self,D::Error> {
+        let value=Zeroizing::new(String::deserialize(deserializer)?);
+        if value.len()>1024 {return Err(serde::de::Error::custom("invalid recovery passphrase length"));}
+        Ok(Self(value))
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct MnemonicRestoreRequest {
+    schema:String,request_id:uuid::Uuid,approved_config_digest:String,restore_approved:bool,
+    password:Password,seed_encoding:String,phrase:Password,recovery_passphrase:RecoveryPassphrase,
+}
+pub(super) fn restore_mnemonic(path:&Path)->Result<()> {
+    use swap_machine::litecoin_light::vault::mnemonic::{MnemonicMaterial,storage::MnemonicVault};
+    let mut input=Zeroizing::new(Vec::with_capacity(8193));
+    std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid mnemonic restore request size");
+    let request:MnemonicRestoreRequest=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-wallet-mnemonic-restore-request-v1"))
+        .context("invalid mnemonic restore schema")?;
+    ensure!(!request.request_id.is_nil() && request.restore_approved,"missing mnemonic restore approval");
+    ensure!(request.seed_encoding==MnemonicMaterial::ENCODING,"wrong mnemonic recovery format");
+    let (_lease,raw)=private_config(path)?;
+    let approved:sha256::Hash=request.approved_config_digest.parse()?;
+    ensure!(approved.to_string()==request.approved_config_digest && sha256::Hash::hash(&raw)==approved,
+        "recovery configuration differs from approval");
+    let config:Config=serde_json::from_slice(&raw)?;
+    ensure!(config.schema==format!("monzero-private-{tag}-light-v1"),"wrong recovery chain");
+    let network=network_for(tag,&config.network)?;
+    let wallet=config.wallet.as_ref().context("missing recovery wallet")?;
+    let public=PublicAccount::from_descriptor(&wallet.account,network)?;
+    let vault_config=wallet.vault.as_ref().context("missing recovery vault")?;
+    ensure!(matches!(vault_config.seed_encoding,vault_format::VaultFormat::Mnemonic),"wrong recovery vault format");
+    let material=MnemonicMaterial::parse(&request.phrase.0)?;
+    let vault=MnemonicVault::restore_material(&vault_config.directory,network,vault_config.wallet_id,
+        request.password.0.as_bytes(),&material,&request.recovery_passphrase.0,&wallet.account)?;
+    drop(vault.unlock_for_account(request.password.0.as_bytes(),&wallet.account)?);
+    let response=json!({"schema":format!("monzero-{tag}-light-wallet-mnemonic-restore-response-v1"),
+        "requestId":request.request_id,"coin":tag,"network":config.network,"walletId":vault_config.wallet_id,
+        "account":public.account_index(),"restored":true,"activeSwapRecovery":false,"addressRecordsRestored":false});
+    std::io::stdout().write_all(&serde_json::to_vec(&response)?)?;Ok(())
+}
