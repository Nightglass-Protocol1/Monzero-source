+
+    /// Restore keys only for a separately saved and reviewed public account.
+    /// Never replaces existing ciphertext or resets allocation/trade records.
+    pub fn restore_material(directory:&Path,network:impl Into<LightNetwork>,wallet:Uuid,password:&[u8],
+        material:&MnemonicMaterial,passphrase:&str,expected:&PublicAccountDescriptor)->Result<Self> {
+        let network=network.into();
+        ensure!(!wallet.is_nil() && !password.is_empty() && password.len()<=1024,"invalid mnemonic restore context");
+        let account=PublicAccount::from_descriptor(expected,network)?;
+        let actual=material.public_account(network,account.account_index(),passphrase)?;
+        ensure!(serde_json::to_vec(&actual.descriptor())?==serde_json::to_vec(expected)?,
+            "mnemonic recovery does not match saved public account");
+        let journal=Journal::open(directory)?;
+        let bytes=match journal.read(RECORD) {
+            Ok(bytes)=>{
+                let existing=decode_record(&bytes,password,network,wallet)?;
+                ensure!(*existing.material().derive_seed(existing.passphrase())?==*material.derive_seed(passphrase)?,
+                    "existing mnemonic vault has different keys");bytes
+            },
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                seal_record(network,wallet,password,material,passphrase)?
+            },
+            Err(error)=>return Err(error),
+        };
+        journal.retain(RECORD,&bytes)?;Ok(Self {journal,network,wallet,bytes})
     }
 
