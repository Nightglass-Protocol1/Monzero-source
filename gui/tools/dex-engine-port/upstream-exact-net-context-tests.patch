+// Private seam: public callers cannot substitute peer-provided observations.
+#[async_trait::async_trait]
+trait ConstructionContext: Sync {
+    async fn current_wallet(&self, expected: &XmzAddress) -> Result<Option<XmzAddress>>;
+    async fn current_snapshot(&self) -> Result<ChainSnapshot>;
+}
+
+#[async_trait::async_trait]
+impl ConstructionContext for NativeFundingRpc {
+    async fn current_wallet(&self, expected: &XmzAddress) -> Result<Option<XmzAddress>> {
+        self.opened_wallet(expected.network()).await
+    }
+    async fn current_snapshot(&self) -> Result<ChainSnapshot> { self.snapshot().await }
+}
+
+async fn revalidate_exact_net(context: &impl ConstructionContext, wallet: &XmzAddress,
+    before: &ChainSnapshot) -> Result<()> {
+    ensure!(context.current_wallet(wallet).await?.as_ref() == Some(wallet),
+        "exact-net wallet changed");
+    ensure!(context.current_snapshot().await? == *before, "exact-net chain changed");
+    Ok(())
+}
