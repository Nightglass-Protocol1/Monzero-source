+++ b/swap-machine/src/litecoin_light/account.rs
@@ -0,0 +1,72 @@
+//! Litecoin BIP84 public-account derivation. No seed generation/storage, signing,
+//! address allocation, discovery or balance claim. Caller owns the master key.
+use anyhow::{Result,ensure};
+use bitcoin::{bip32::{ChildNumber,DerivationPath,Fingerprint,Xpriv,Xpub},
+    secp256k1::Secp256k1,CompressedPublicKey,NetworkKind,Script,ScriptBuf};
+use swap_core::litecoin_address::{LtcNetwork,LtcSegwitAddress};
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum Branch {Receive,Change}
+impl Branch {fn index(self)->u32 {match self {Self::Receive=>0,Self::Change=>1}}}
+
+/// Public derivation data only. No Debug/Serialize to avoid accidental logging
+/// of the account's address-linking data. Not proof of present spending control.
+pub struct PublicAccount {
+    network:LtcNetwork,
+    account:u32,
+    fingerprint:Fingerprint,
+    public:Xpub,
+}
+pub struct DerivedAddress {
+    address:LtcSegwitAddress,
+    public_key:CompressedPublicKey,
+    path:DerivationPath,
+}
+impl PublicAccount {
+    /// Mainnet m/84'/2'/account'; test networks m/84'/1'/account'.
+    /// Borrowed master key must be a root of the correct network kind.
+    /// The existing BIP32 dependency can internally copy secrets; this API is
+    /// not a secure-memory or encrypted-vault implementation.
+    pub fn from_master(master:&Xpriv,network:LtcNetwork,account:u32)->Result<Self> {
+        let kind=if network==LtcNetwork::Mainnet {NetworkKind::Main} else {NetworkKind::Test};
+        ensure!(master.depth==0 && master.parent_fingerprint==Fingerprint::default()
+            && master.child_number==(ChildNumber::Normal {index:0}) && master.network==kind,
+            "Litecoin account requires a matching master key");
+        let path=account_path(network,account)?;
+        let secp=Secp256k1::new();
+        let mut derived=master.derive_priv(&secp,&path)?;
+        let public=Xpub::from_priv(&secp,&derived);
+        derived.private_key.non_secure_erase();
+        Ok(Self {network,account,fingerprint:master.fingerprint(&secp),public})
+    }
+    pub fn network(&self)->LtcNetwork {self.network}
+    pub fn account_index(&self)->u32 {self.account}
+    pub fn master_fingerprint(&self)->Fingerprint {self.fingerprint}
+    /// Pure derivation, not allocation: callers must persist address indices
+    /// and backup/discovery policy before displaying a new receiving address.
+    pub fn derive(&self,branch:Branch,index:u32)->Result<DerivedAddress> {
+        let suffix=[ChildNumber::from_normal_idx(branch.index())?,ChildNumber::from_normal_idx(index)?];
+        let public=self.public.derive_pub(&Secp256k1::verification_only(),&suffix)?;
+        let public_key=CompressedPublicKey(public.public_key);
+        let script=ScriptBuf::new_p2wpkh(&public_key.wpubkey_hash());
+        let address=LtcSegwitAddress::from_script(self.network,&script)?;
+        let mut path=account_path(self.network,self.account)?.as_ref().to_vec();path.extend(suffix);
+        Ok(DerivedAddress {address,public_key,path:DerivationPath::from(path)})
+    }
+    /// Script matching only; does not prove that an output exists or is unspent.
+    pub fn matches_script(&self,branch:Branch,index:u32,script:&Script)->Result<bool> {
+        Ok(self.derive(branch,index)?.address.script_pubkey().as_script()==script)
+    }
+}
+impl DerivedAddress {
+    pub fn address(&self)->&LtcSegwitAddress {&self.address}
+    pub fn public_key(&self)->CompressedPublicKey {self.public_key}
+    pub fn path(&self)->&DerivationPath {&self.path}
+}
+fn account_path(network:LtcNetwork,account:u32)->Result<DerivationPath> {
+    let coin=if network==LtcNetwork::Mainnet {2} else {1};
+    Ok(DerivationPath::from(vec![ChildNumber::from_hardened_idx(84)?,
+        ChildNumber::from_hardened_idx(coin)?,ChildNumber::from_hardened_idx(account)?]))
+}
+#[cfg(test)]
+mod tests;
