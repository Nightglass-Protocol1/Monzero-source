@@ -0,0 +1,65 @@
+use super::*;
+use serde_json::Value;
+fn decode(hex:&str)->Vec<u8> {(0..hex.len()).step_by(2).map(|i|u8::from_str_radix(&hex[i..i+2],16).unwrap()).collect()}
+fn master(network:LtcNetwork)->Xpriv {
+    Xpriv::new_master(if network==LtcNetwork::Mainnet {NetworkKind::Main} else {NetworkKind::Test},&(0u8..16).collect::<Vec<_>>()).unwrap()
+}
+#[test]
+fn account_matches_independent_public_seed_vectors() -> Result<()> {
+    let fixture:Value=serde_json::from_str(include_str!("vectors.json"))?;
+    let seed=decode(fixture["seed"].as_str().unwrap());
+    for vector in fixture["vectors"].as_array().unwrap() {
+        let network=match vector["network"].as_str().unwrap() {"main"=>LtcNetwork::Mainnet,"test"=>LtcNetwork::Testnet,"regtest"=>LtcNetwork::Regtest,_=>unreachable!()};
+        let root=Xpriv::new_master(if network==LtcNetwork::Mainnet {NetworkKind::Main} else {NetworkKind::Test},&seed)?;
+        let original=root;
+        let account_index=vector["account"].as_u64().unwrap() as u32;
+        let account=PublicAccount::from_master(&root,network,account_index)?;
+        let branch=if vector["branch"]==0 {Branch::Receive} else {Branch::Change};
+        let index=vector["index"].as_u64().unwrap() as u32;
+        let derived=account.derive(branch,index)?;
+        assert_eq!(root,original);assert_eq!(account.network(),network);assert_eq!(account.account_index(),account_index);
+        assert_eq!(account.master_fingerprint().to_string(),"3442193e");
+        assert_eq!(derived.public_key().to_string(),vector["publicKey"].as_str().unwrap());
+        assert_eq!(derived.address().to_string(),vector["address"].as_str().unwrap());
+        assert_eq!(derived.path().to_string(),vector["path"].as_str().unwrap());
+        let script=ScriptBuf::from_bytes(decode(vector["script"].as_str().unwrap()));
+        assert_eq!(derived.address().script_pubkey(),&script);assert!(account.matches_script(branch,index,&script)?);
+        assert!(!account.matches_script(branch,index+1,&script)?);
+        assert_eq!(LtcSegwitAddress::parse(network,&derived.address().to_string())?.script_pubkey(),&script);
+    }
+    Ok(())
+}
+#[test]
+fn account_rejects_wrong_roots_and_hardened_address_indices() -> Result<()> {
+    let network=LtcNetwork::Mainnet;let root=master(network);
+    for changed in 0..4 {
+        let mut invalid=root;
+        match changed {0=>invalid.depth=1,1=>invalid.parent_fingerprint=Fingerprint::from([1;4]),
+            2=>invalid.child_number=ChildNumber::from_normal_idx(1)?,3=>invalid.network=NetworkKind::Test,_=>unreachable!()}
+        assert!(PublicAccount::from_master(&invalid,network,0).is_err());
+    }
+    for index in [1<<31,u32::MAX] {assert!(PublicAccount::from_master(&root,network,index).is_err());}
+    let account=PublicAccount::from_master(&root,network,0)?;
+    for branch in [Branch::Receive,Branch::Change] {
+        for index in [1<<31,u32::MAX] {assert!(account.derive(branch,index).is_err());}
+        assert!(account.derive(branch,(1<<31)-1)?.address().script_pubkey().is_p2wpkh());
+    }
+    Ok(())
+}
+#[test]
+fn account_separates_mainnet_branches_accounts_and_test_addresses() -> Result<()> {
+    let root=master(LtcNetwork::Mainnet);let a=PublicAccount::from_master(&root,LtcNetwork::Mainnet,0)?;
+    let b=PublicAccount::from_master(&root,LtcNetwork::Mainnet,1)?;
+    let receiving=a.derive(Branch::Receive,0)?;
+    assert_ne!(receiving.address().script_pubkey(),a.derive(Branch::Change,0)?.address().script_pubkey());
+    assert_ne!(receiving.address().script_pubkey(),b.derive(Branch::Receive,0)?.address().script_pubkey());
+    let test=PublicAccount::from_master(&master(LtcNetwork::Testnet),LtcNetwork::Testnet,0)?;
+    let reg=PublicAccount::from_master(&master(LtcNetwork::Regtest),LtcNetwork::Regtest,0)?;
+    let t=test.derive(Branch::Receive,0)?;let r=reg.derive(Branch::Receive,0)?;
+    assert_ne!(receiving.address().script_pubkey(),t.address().script_pubkey());
+    // Shared all-testnets coin path, but chain-specific Litecoin address encoding.
+    assert_eq!(t.address().script_pubkey(),r.address().script_pubkey());
+    assert_ne!(t.address().to_string(),r.address().to_string());
+    assert!(LtcSegwitAddress::parse(LtcNetwork::Testnet,&r.address().to_string()).is_err());
+    Ok(())
+}
