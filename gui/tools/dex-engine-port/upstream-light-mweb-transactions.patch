+
+// HogEx transaction 9fca4fed… from Litecoin testnet block 4,926,156, as
+// litecoind's getrawtransaction returns it (MWEB flag 0x08).
+const TESTNET_HOGEX: &str = "02000000000801e8524178f45afa866ef46199e9d547cf6d8557871dd948301fed84cc79b01fb50000000000ffffffff01d4511a2f11a300002258205b8365f5e750603d21f800a1cb2146bc5e5ae0bc8137a4ee99e01bae900bd0ef0000000000";
+
+#[test]
+fn mweb_hogex_is_read_without_its_extension_data() -> Result<()> {
+    let raw = bytes(TESTNET_HOGEX);
+    assert!(deserialize::<Transaction>(&raw).is_err(), "the plain decoder cannot read MWEB bytes");
+    let canonical = canonical_transaction(&raw)?;
+    let tx: Transaction = deserialize(&canonical)?;
+    assert_eq!(tx.compute_txid().to_string(), "9fca4fedfd27be931530b168845a4896aee81065dcd552a6b432d314895a46ff");
+    assert_eq!(tx.input.len(), 1);
+    assert_eq!(tx.output.len(), 1);
+    assert_eq!(serialize(&tx), *canonical);
+    Ok(())
+}
+
+#[test]
+fn mweb_segwit_transaction_keeps_its_witnesses() -> Result<()> {
+    let (_, _, raw, _) = fixture();
+    let mut tx: Transaction = deserialize(&raw)?;
+    tx.input[0].witness.push([7; 72]); tx.input[0].witness.push([2; 33]);
+    let segwit = serialize(&tx);
+    // Same transaction with the MWEB bit and three bytes of extension data.
+    let mut mweb = segwit.clone();
+    mweb[5] = 0x09;
+    let at = mweb.len() - 4;
+    mweb.splice(at..at, [1, 0xab, 0xcd]);
+    let canonical = canonical_transaction(&mweb)?;
+    assert_eq!(*canonical, segwit[..]);
+    let decoded: Transaction = deserialize(&canonical)?;
+    assert_eq!(decoded.compute_txid(), tx.compute_txid());
+    assert_eq!(decoded.input[0].witness, tx.input[0].witness);
+    Ok(())
+}
+
+#[test]
+fn mweb_bytes_that_do_not_parse_are_refused() {
+    let raw = bytes(TESTNET_HOGEX);
+    let mut unknown_flag = raw.clone(); unknown_flag[5] = 0x0c;
+    assert!(canonical_transaction(&unknown_flag).is_err());
+    // No extension data left before the lock time.
+    assert!(canonical_transaction(&raw[..raw.len() - 1]).is_err());
+    assert!(canonical_transaction(&raw[..20]).is_err());
+    let mut huge_count = raw.clone(); huge_count[6] = 0xff;
+    assert!(canonical_transaction(&huge_count).is_err());
+    // Ordinary transactions pass through untouched.
+    let (_, _, plain, _) = fixture();
+    assert!(matches!(canonical_transaction(&plain), Ok(std::borrow::Cow::Borrowed(_))));
+}
