+/// Litecoin MWEB serialization (flag bit 0x08) carries extension-block data
+/// between the outputs (or witnesses) and the lock time: the HogEx transaction
+/// that pays MWEB peg-outs, and canonical transactions that peg in. The txid
+/// excludes that data, as it excludes witnesses. Returns the bytes without it,
+/// in the plain or segwit form, so the standard decoder reads them; callers
+/// still require the decoded txid to be the one they asked for. Other bytes
+/// are returned unchanged.
+pub fn canonical_transaction(raw: &[u8]) -> Result<std::borrow::Cow<'_, [u8]>> {
+    use std::borrow::Cow;
+    if raw.len() < 6 || raw[4] != 0 || raw[5] & 0x08 == 0 { return Ok(Cow::Borrowed(raw)); }
+    let flags = raw[5];
+    ensure!(flags & !0x09 == 0, "unsupported Litecoin transaction flags");
+    struct Reader<'a> { bytes: &'a [u8], at: usize }
+    impl Reader<'_> {
+        fn take(&mut self, count: usize) -> Result<std::ops::Range<usize>> {
+            let end = self.at.checked_add(count).filter(|end| *end <= self.bytes.len())
+                .context("truncated Litecoin MWEB transaction")?;
+            let range = self.at..end; self.at = end; Ok(range)
+        }
+        fn count(&mut self) -> Result<usize> {
+            let first = self.bytes[self.take(1)?.start];
+            let value = match first {
+                0xfd => u64::from(u16::from_le_bytes(self.bytes[self.take(2)?].try_into()?)),
+                0xfe => u64::from(u32::from_le_bytes(self.bytes[self.take(4)?].try_into()?)),
+                0xff => u64::from_le_bytes(self.bytes[self.take(8)?].try_into()?),
+                small => u64::from(small),
+            };
+            ensure!(value <= MAX_TRANSACTION as u64, "oversized Litecoin MWEB transaction field");
+            Ok(value as usize)
+        }
+        fn item(&mut self) -> Result<()> { let length = self.count()?; self.take(length)?; Ok(()) }
+    }
+    let mut reader = Reader { bytes: raw, at: 6 };
+    let body = reader.at;
+    let inputs = reader.count()?;
+    for _ in 0..inputs { reader.take(36)?; reader.item()?; reader.take(4)?; }
+    let outputs = reader.count()?;
+    for _ in 0..outputs { reader.take(8)?; reader.item()?; }
+    let witness_start = reader.at;
+    let mut witnessed = false;
+    if flags & 0x01 != 0 {
+        for _ in 0..inputs {
+            let items = reader.count()?;
+            witnessed |= items != 0;
+            for _ in 0..items { reader.item()?; }
+        }
+    }
+    // The extension data itself is not decoded: it is whatever lies between
+    // here and the four lock-time bytes, and must not be empty.
+    ensure!(raw.len() >= reader.at + 5, "truncated Litecoin MWEB transaction");
+    let mut canonical = Vec::with_capacity(raw.len());
+    canonical.extend_from_slice(&raw[..4]);
+    if witnessed { canonical.extend_from_slice(&[0, 1]); }
+    canonical.extend_from_slice(&raw[body..witness_start]);
+    if witnessed { canonical.extend_from_slice(&raw[witness_start..reader.at]); }
+    canonical.extend_from_slice(&raw[raw.len() - 4..]);
+    Ok(Cow::Owned(canonical))
+}
