+pub struct SavedAdmissionReview {
+    pub review: AdmissionReview,
+    pub admitted_at: u64,
+}
+
 impl<'a> AdmittedExecution<'a> {
+    /// Read-only historical admission evidence. The app independently retains
+    /// the expected negotiation pins; a different saved negotiation is rejected.
+    /// Quote expiry does not hide a previously admitted exchange on restart.
+    pub fn saved_admission_review(&self, expected: &NegotiationPins) -> Result<SavedAdmissionReview> {
+        let admission = self.read_admission()?;
+        ensure!(serde_json::to_vec(&admission.pins)? == serde_json::to_vec(expected)?,
+            "BCH saved admission negotiation differs from configured pins");
+        self.restore_agreement()?;
+        Ok(SavedAdmissionReview {
+            review:review_admission(self.quote,self.policy,self.role,expected,admission.admitted_at)?,
+            admitted_at:admission.admitted_at,
+        })
+    }
+
     /// For app/helper callers: reject changed consent before opening storage,
     /// then use the existing admission path to validate all negotiation records.
     /// This grants no permission to sign, lock inputs or broadcast transactions.
