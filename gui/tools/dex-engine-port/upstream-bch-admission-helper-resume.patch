@@ -0,0 +1,134 @@
+//! Real helper processes over full cryptographic negotiation records, no nodes.
+use super::*;
+use agreement::execution::{AdmittedExecution, NegotiationPins};
+use std::{collections::BTreeMap, fs::OpenOptions, io::Write,
+    os::unix::fs::OpenOptionsExt, path::{Path,PathBuf}, process::{Command,Stdio}};
+use sha2::{Digest,Sha256};
+
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b|format!("{b:02x}")).collect() }
+fn helper() -> Result<(PathBuf,String)> {
+    let path = PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    ensure!(path.is_absolute() && path.canonicalize()? == path,"helper path is not canonical");
+    let expected = std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(hex(&Sha256::digest(std::fs::read(&path)?)) == expected,"helper binary digest mismatch");
+    Ok((path,expected))
+}
+fn write_new(path: &Path, bytes: &[u8]) -> Result<()> {
+    let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600).open(path)?;
+    file.write_all(bytes)?; file.sync_all()?; Ok(())
+}
+fn contents(path: &Path) -> Result<BTreeMap<String,String>> {
+    std::fs::read_dir(path)?.map(|entry| {
+        let entry = entry?;
+        Ok((entry.file_name().into_string().map_err(|_|anyhow::anyhow!("non-UTF8 fixture entry"))?,
+            hex(&Sha256::digest(std::fs::read(entry.path())?))))
+    }).collect()
+}
+fn invoke(helper: &Path, config: &Path, action: &str, approval: Option<&str>, success: bool)
+    -> Result<serde_json::Value> {
+    let request_id = uuid::Uuid::new_v4();
+    let mut request = serde_json::json!({"schema":format!("monzero-bch-admission-{action}-request-v1"),
+        "requestId":request_id});
+    if let Some(approval) = approval {request["commitment"] = serde_json::json!(approval);}
+    let mut child = Command::new(helper).arg(format!("--admission-{action}-stdio-v1")).arg(config)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output = child.wait_with_output()?;
+    ensure!(output.status.success() == success,"unexpected helper outcome for {action}");
+    if !success {
+        ensure!(output.stdout.is_empty(),"failed helper disclosed stdout");
+        ensure!(output.stderr == b"BCH admission request failed; inspect retained state before retrying\n",
+            "unexpected helper error output");
+        return Ok(serde_json::Value::Null);
+    }
+    ensure!(output.stderr.is_empty() && output.stdout.len() <= 16384,"unexpected helper output");
+    let response: serde_json::Value = serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response["requestId"],request_id.to_string());
+    assert_eq!(response["schema"],format!("monzero-bch-admission-{action}-response-v1"));
+    assert_eq!(response["executable"],false);
+    Ok(response)
+}
+
+fn roundtrip(historical: bool) -> Result<()> {
+    let (helper,helper_digest) = helper()?;
+    let clock = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    let base = clock.checked_sub(if historical {7200} else {10}).context("invalid test clock")?;
+    let setup = Setup::with_network_at(None,base,base+3500)?;
+    let snapshots = PrivateStore::new()?;
+    let (b,bv,bpin) = selected_with_outgoing_at(&setup,&snapshots.0,0,base)?;
+    let (n,nv,npin) = selected_with_outgoing_at(&setup,&snapshots.0,1,base)?;
+    for (role,selected,own,peer,initial) in [
+        (Role::BchFunder,&b,&bv,&nv,bpin),(Role::NativeFunder,&n,&nv,&bv,npin)] {
+        let metadata = PrivateStore::new()?; let config_store = PrivateStore::new()?;
+        let (wallet,received) = selected.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+            base+3,own.commitment(),peer.frame(),peer.signature())?;
+        let ack = wallet.acknowledgement(&setup.quote)?;
+        let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,base+4,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+        let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,role,&agreed)?;
+        let pins = NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+        let quote_file = config_store.0.join("quote.json"); write_new(&quote_file,&setup.quote.record()?)?;
+        let config_file = config_store.0.join("config.json");
+        let config = serde_json::json!({"schema":"monzero-private-bch-admission-v1",
+            "helper":helper,"helperDigest":helper_digest,"quoteFile":quote_file,
+            "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+            "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+                SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+                SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+            "policy":setup.policy,"role":role,"metadataDirectory":metadata.0,
+            "snapshotDirectory":snapshots.0,"negotiationPins":pins});
+        write_new(&config_file,&serde_json::to_vec(&config)?)?;
+        let secret_before = contents(&snapshots.0)?;
+        let expected = agreement::execution::approval::review_admission(&setup.quote,&setup.policy,role,&pins,base+5)?;
+        let expected_commitment = hex(&expected.commitment);
+        if historical {
+            // Seed a genuinely historically valid record, then ask today's
+            // helper to recover it without renewing an expired quote.
+            drop(AdmittedExecution::admit_reviewed(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,
+                role,&expected.commitment,pins.clone(),base+5)?);
+            invoke(&helper,&config_file,"review",None,false)?;
+            invoke(&helper,&config_file,"submit",Some(&expected_commitment),false)?;
+        } else {
+            invoke(&helper,&config_file,"status",None,false)?;
+            let review = invoke(&helper,&config_file,"review",None,true)?;
+            assert_eq!(review["review"]["details"],expected.details);
+            assert_eq!(review["review"]["commitment"],expected_commitment);
+            assert_eq!(review["admitted"],false);
+            invoke(&helper,&config_file,"submit",Some(&"00".repeat(32)),false)?;
+            assert!(contents(&metadata.0)?.is_empty());
+            let submitted = invoke(&helper,&config_file,"submit",Some(&expected_commitment),true)?;
+            assert_eq!(submitted["admitted"],true);
+            assert_eq!(submitted["review"],review["review"]);
+        }
+        let metadata_before = contents(&metadata.0)?;
+        assert_eq!(metadata_before.len(),1);
+        let status = invoke(&helper,&config_file,"status",None,true)?;
+        assert_eq!(status["admitted"],true);
+        assert_eq!(status["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(status["review"]["commitment"],expected_commitment);
+        assert!(status["admittedAt"].as_u64().context("missing saved admission time")? >= base+5);
+        if historical {assert_eq!(status["admittedAt"],base+5);}
+        assert_eq!(contents(&metadata.0)?,metadata_before);
+        assert_eq!(contents(&snapshots.0)?,secret_before);
+        // Restart respects the process lease and independently pinned history.
+        let execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,role)?;
+        invoke(&helper,&config_file,"status",None,false)?; drop(execution);
+        let mut changed = config.clone(); changed["negotiationPins"]["received"][0] = serde_json::json!(received[0]^1);
+        std::fs::write(&config_file,serde_json::to_vec(&changed)?)?;
+        invoke(&helper,&config_file,"status",None,false)?;
+        std::fs::write(&config_file,serde_json::to_vec(&config)?)?;
+        let admission_file = metadata.0.join(metadata_before.keys().next().unwrap());
+        std::fs::write(&admission_file,b"{")?;
+        invoke(&helper,&config_file,"status",None,false)?;
+        assert_eq!(contents(&snapshots.0)?,secret_before);
+    }
+    Ok(())
+}
+
+#[test]
+#[ignore = "requires independently hashed native-bch-admission executable; offline cryptographic fixture"]
+fn bch_admission_helper_roundtrip_retained_negotiation() -> Result<()> { roundtrip(false) }
+
+#[test]
+#[ignore = "requires independently hashed native-bch-admission executable; offline cryptographic fixture"]
+fn bch_admission_helper_roundtrip_expired_negotiation() -> Result<()> { roundtrip(true) }
