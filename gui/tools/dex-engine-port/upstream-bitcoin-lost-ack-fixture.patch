+/// Fault injection at the client boundary, not a TCP-disconnection simulation.
+/// The node accepts the transaction, but the caller receives no success result.
+async fn submit_with_lost_ack(env: &harness::TestEnv<'_>, tx: Transaction) -> Result<()> {
+    let expected=tx.compute_txid().to_string();
+    let actual=env.bitcoind.sendrawtransaction(tx.into()).await?;
+    anyhow::ensure!(actual==expected,"fault fixture node returned wrong transaction");
+    anyhow::bail!("injected lost Bitcoin submission acknowledgement")
+}
