+// Process-local positive cryptographic results only. No quote, identity, journal,
+// time or chain authorization is cached. All of those are checked by callers.
+// Bound memory even when a peer supplies many different valid public proofs.
+const VERIFIED_PROOF_LIMIT: usize = 64;
+static VERIFIED_PROOFS: Mutex<VecDeque<[u8;32]>> = Mutex::new(VecDeque::new());
+fn proof_digest(adaptor: &Point,native: &[u8;32],proof: &CrossCurveDLEQProof) -> Result<[u8;32]> {
+    let mut hash=Sha256::new();hash.update(b"monzero-bch-cross-curve-verification-cache-v1\0");
+    hash.update(adaptor.to_bytes());hash.update(native);hash.update(serde_json::to_vec(proof)?);
+    Ok(hash.finalize().into())
+}
 
