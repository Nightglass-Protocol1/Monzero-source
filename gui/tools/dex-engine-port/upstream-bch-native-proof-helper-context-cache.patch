+//! Production helper approval and restart over an isolated copy of pre-receipt state.
+use super::*;
+
+pub(super) fn exercise(setup: &Setup,snapshots: &PrivateStore,
+    original: &std::collections::BTreeMap<std::ffi::OsString,Vec<u8>>,pins: &NegotiationPins,
+    base: u64,frame: &[u8],signature: &[u8],expected: &[u8;32],context: &Value) -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let helper_digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==helper_digest,"proof helper changed");
+    let program=match (std::env::var_os("MONZERO_BCH_QT_NATIVE_PROOF_PROBE"),
+        std::env::var_os("MONZERO_BCH_QT_NATIVE_PROOF_PROBE_SHA256")) {
+        (None,None)=>helper.clone(),
+        (Some(path),Some(digest))=>{
+            let path=PathBuf::from(path);
+            ensure!(path.is_absolute() && path.canonicalize()?==path
+                && digest.to_str()==Some(hex(&Sha256::digest(std::fs::read(&path)?)).as_str()),"Qt proof probe changed");
+            path
+        },
+        _=>anyhow::bail!("incomplete Qt proof probe pin"),
+    };
+    let through_qt=program!=helper;
+    // Clone both stores: proof retention creates a private snapshot record and
+    // must not mutate the still-live controller's funding context.
+    let private_copy=PrivateStore::new()?;
+    for (name,bytes) in contents(&snapshots.0)? {save(&private_copy.0.join(name),&bytes)?;}
+    let snapshots=&private_copy;
+    let metadata=PrivateStore::new()?;let config=PrivateStore::new()?;
+    for (name,bytes) in original {save(&metadata.0.join(name),bytes)?;}
+    let quote_path=config.0.join("quote.json");save(&quote_path,&setup.quote.record()?)?;
+    let admission=config.0.join("admission.json");
+    save(&admission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":helper_digest,"quoteFile":quote_path,
+        "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"bch-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":snapshots.0,"negotiationPins":pins}))?)?;
+    let peer=config.0.join("peer.json");
+    let message=json!({"schema":"monzero-bch-peer-native-proof-v1","frame":frame,"signature":signature});
+    let message_bytes=serde_json::to_vec(&message)?;save(&peer,&message_bytes)?;
+    let wrapper=config.0.join("receipt.json");
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-proof-v1",
+        "admissionConfigFile":admission,"peerMessageFile":peer}))?)?;
+    // Independently restored before any peer proof was read.
+    save(&PathBuf::from(format!("{}.public-context.json",wrapper.display())),&serde_json::to_vec(context)?)?;
+    let invoke=|action: &str,approval: Option<&str>,success: bool| -> Result<Value> {
+        let id=uuid::Uuid::new_v4();
+        let mut request=json!({"schema":format!("monzero-bch-native-proof-{action}-request-v1"),"requestId":id});
+        if let Some(approval)=approval {request["commitment"]=approval.into();}
+        let mut child=Command::new(&program).arg(format!("--native-proof-{action}-stdio-v1")).arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("helper stdin missing")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty() && output.stdout.len()<=16384);
+        let result:Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(result.as_object().unwrap().len(),7);
+        assert_eq!(result["schema"],format!("monzero-bch-native-proof-{action}-response-v1"));
+        assert_eq!(result["requestId"],id.to_string());assert_eq!(result["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(result["executable"],false);assert_eq!(result["chainObserved"],false);
+        Ok(result)
+    };
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    // The context command must work before the private peer file is available.
+    std::fs::remove_file(&peer)?;
+    let id=uuid::Uuid::new_v4();
+    let request=json!({"schema":"monzero-bch-native-proof-context-request-v1","requestId":id});
+    let mut child=Command::new(&helper).arg("--native-proof-context-stdio-v1").arg(&wrapper)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("context helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert!(output.status.success() && output.stderr.is_empty() && output.stdout.len()<=16384);
+    let restored: Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(restored.as_object().unwrap().len(),6);
+    assert_eq!(restored["schema"],"monzero-bch-native-proof-context-response-v1");
+    assert_eq!(restored["requestId"],id.to_string());assert_eq!(restored["tradeId"],setup.quote.terms()["swapId"]);
+    assert_eq!(restored["executable"],false);assert_eq!(restored["chainObserved"],false);
+    assert_eq!(&restored["context"],context);
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    save(&peer,&message_bytes)?;
+
+    let initial=invoke("status",None,true)?;assert!(initial["receipt"].is_null() && initial["review"].is_null());
+    let reviewed=invoke("review",None,true)?;assert_eq!(reviewed["review"]["commitment"],hex(expected));
+    assert!(reviewed["receipt"].is_null());
+    invoke("submit",Some(&"00".repeat(32)),false)?;
+    let mut wrong=message.clone();wrong["signature"][0]=json!(signature[0]^1);save(&peer,&serde_json::to_vec(&wrong)?)?;
+    invoke("review",None,false)?;save(&peer,&message_bytes)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    let accepted=invoke("submit",Some(&hex(expected)),true)?;
+    assert_eq!(accepted["receipt"]["state"],"retained");
+    assert_eq!(accepted["review"]["details"].as_object().unwrap().len(),13);
+    assert_eq!(accepted["review"],reviewed["review"]);
+    assert!(accepted["receipt"]["receivedAt"].as_str().context("receipt time")?.parse::<u64>()?>=base);
+
+    let retained=contents(&metadata.0)?;let retained_secrets=contents(&snapshots.0)?;
+    let again=if through_qt {
+        invoke("submit",Some(&hex(expected)),false)?;invoke("status",None,true)?
+    } else {invoke("submit",Some(&hex(expected)),true)?};
+    assert_eq!(again["receipt"],accepted["receipt"]);assert_eq!(again["review"],accepted["review"]);
+    assert_eq!(contents(&metadata.0)?,retained);
+    std::fs::remove_file(&peer)?;
+    let status=invoke("status",None,true)?;
+    assert_eq!(status["receipt"],accepted["receipt"]);assert_eq!(status["review"],accepted["review"]);
+    invoke("review",None,false)?;
+    assert_eq!(contents(&metadata.0)?,retained);assert_eq!(contents(&snapshots.0)?,retained_secrets);
+    Ok(())
+}
