+//! Fresh two-chain evidence, not cached approval or permission to dispatch.
+use super::*;
+use bitcoin::BlockHash;
+use crate::{bch_rpc::{confirmed::ConfirmedTransaction,unspent::ConfirmedUnspentOutput},
+    xmz_funding::{self,FundingObserver,ChainSnapshot}};
+
+pub struct PunishWindow {
+    review: [u8;32],native: ChainSnapshot,cancellation: ConfirmedTransaction,
+    recovery: ConfirmedUnspentOutput,deadline: std::time::Instant,
+}
+impl PunishWindow {
+    pub fn review(&self) -> &[u8;32] {&self.review}
+    pub fn native_snapshot(&self) -> &ChainSnapshot {&self.native}
+    pub fn cancellation(&self) -> &ConfirmedTransaction {&self.cancellation}
+    pub fn recovery_output(&self) -> &ConfirmedUnspentOutput {&self.recovery}
+}
+impl AdmittedExecution<'_> {
+    /// Payment preparation and relay history do not prove payment or maturity.
+    pub async fn observe_bch_punish_window(&self,native: &impl FundingObserver,bch: &BchRpc,
+        block: Option<BlockHash>,now: u64) -> Result<PunishWindow> {
+        let materials=self.punish_relay_materials()?;
+        ensure!(now>=materials.prepared_at && bch.deployment_commitment()?==materials.deployment,
+            "BCH punishment observation predates preparation or changes observer");
+        self.check_punish_window(native,bch,block,materials).await
+    }
+    async fn check_punish_window(&self,native: &impl FundingObserver,bch: &BchRpc,
+        block: Option<BlockHash>,materials: PunishMaterials) -> Result<PunishWindow> {
+        let deadline=std::time::Instant::now().checked_add(std::time::Duration::from_secs(30)).context("BCH punishment deadline overflow")?;
+        tokio::time::timeout_at(deadline.into(),async {
+            let funding=xmz_funding::verify(native,materials.payment,&self.policy.xmz_genesis,
+                u64::from(self.policy.xmz_confirmations)).await?;
+            let minimum=u64::from(self.policy.bch_confirmations);
+            let txid=materials.cancel.compute_txid();
+            let cancellation=match block {
+                Some(block)=>bch.confirmed_transaction(txid,block,minimum).await?,
+                None=>bch.indexed_confirmed_transaction(txid,minimum).await?,
+            };
+            ensure!(cancellation.deployment()==&materials.deployment
+                && serialize(cancellation.transaction())==serialize(&materials.cancel),"BCH punishment cancellation changed");
+            let recovery=bch.confirmed_unspent_output(&cancellation,0).await?;
+            ensure!(recovery.outpoint()==materials.transaction.input[0].previous_output,"BCH punishment recovery source changed");
+            recovery.require_punish_maturity(minimum,u32::from(self.policy.punish_blocks))?;
+            ensure!(native.snapshot().await?==*funding.snapshot(),"native chain changed during BCH punishment observation");
+            Ok(PunishWindow {review:materials.review.commitment,native:funding.snapshot().clone(),cancellation,recovery,deadline})
+        }).await.context("BCH punishment observation timed out")?
+    }
+}
