+
+async fn observe(execution:&AdmittedExecution<'_>,claim:&ClaimedSpend,chain:&HeaderSequence,
+    expected:sha256::Hash,position:Option<i32>)->Result<crate::litecoin_light::session::reconciliation::PaymentObservation> {
+    let signed=claim.load_signed()?;let txid=signed.compute_txid();
+    let mut responses=vec![
+        ("server.version",serde_json::json!(["fixture","1.4"])),
+        ("server.features",serde_json::json!({"genesis_hash":chain.network().genesis(),"hash_function":"sha256"})),
+        ("blockchain.scripthash.get_history",match position {
+            None=>serde_json::json!([]),Some(height)=>serde_json::json!([{"tx_hash":txid,"height":height}])})];
+    if let Some(height)=position {
+        responses.push(("blockchain.transaction.get",serde_json::json!(hex(&serialize(&signed)))));
+        if height>0 {responses.push(("blockchain.transaction.get_merkle",serde_json::json!({"block_height":height,"pos":0,"merkle":[]})));}
+    }
+    let (client,server)=tokio::io::duplex(65536);
+    let server=tokio::spawn(async move {
+        let mut stream=BufReader::new(server);
+        for (method,result) in responses {
+            let mut line=String::new();assert!(stream.read_line(&mut line).await.unwrap()>0);
+            let request:serde_json::Value=serde_json::from_str(&line).unwrap();assert_eq!(request["method"],method);
+            let mut reply=serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":request["id"],"result":result})).unwrap();
+            reply.push(b'\n');stream.get_mut().write_all(&reply).await.unwrap();
+        }
+    });
+    let mut session=ReadSession::negotiate(client,chain.network()).await?;
+    let observation=execution.observe_light_bch_funding_on(claim,chain,expected,&mut session,10).await?;
+    drop(session);server.await?;Ok(observation)
+}
