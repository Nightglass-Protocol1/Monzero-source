+//! Cold observation and separately approved exact-byte retry. The trade intent
+//! binds the original endpoint before wallet/network publication can be interrupted.
+use super::*;
+use crate::litecoin_light::{network::LightNetwork,session::{ReadSession,reconciliation::{PaymentObservation,PaymentPosition}},
+    vault::signing::review::claims::ClaimedSpend};
+use tokio::io::{AsyncRead,AsyncWrite};
+use swap_core::bch::funding::SignedFunding;
+
+const INTENT:&str="monzero-bch-local-send-intent-v1";
+const REVIEW:&str="monzero-bch-light-relay-review-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LocalSendIntent {
+    schema:String,admission:[u8;32],approved_at:u64,commitment:[u8;32],details:serde_json::Value,
+}
+impl AdmittedExecution<'_> {
+    pub(super) fn local_send_intent_bytes(&self)->Result<Option<Vec<u8>>> {
+        match self.metadata.read(&record_name(self.quote,"local-relay-intent")) {
+            Ok(bytes)=>{ensure!(bytes.len()<=16384,"oversized BCH local relay intent");Ok(Some(bytes))},
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(None),
+            Err(e)=>Err(e),
+        }
+    }
+    pub(super) fn retain_local_send_intent(&self,claim:&ClaimedSpend,endpoint:&TlsEndpoint,
+        expected:sha256::Hash,review:&FundingRelayReview,now:u64)->Result<()> {
+        self.require_local_funding_claim(claim,endpoint.network(),expected)?;
+        let record=LocalSendIntent {schema:INTENT.into(),admission:self.admission_digest()?,approved_at:now,
+            commitment:review.commitment,details:review.details.clone()};
+        self.metadata.retain(&record_name(self.quote,"local-relay-intent"),&serde_json::to_vec(&record)?)
+    }
+    fn retained_send(&self,claim:&ClaimedSpend,network:LightNetwork,expected:sha256::Hash,
+        endpoint:&TlsEndpoint)->Result<(SignedFunding,[u8;32],u64)> {
+        ensure!(endpoint.network()==network,"wrong BCH retry endpoint network");
+        let bytes=self.local_send_intent_bytes()?.context("no retained BCH send intent")?;
+        let record:LocalSendIntent=serde_json::from_slice(&bytes)?;
+        ensure!(record.schema==INTENT && record.admission==self.admission_digest()?
+            && serde_json::to_vec(&record)?==bytes && record.commitment==hash(REVIEW,&serde_json::to_vec(&record.details)?),
+            "BCH send intent changed");
+        self.quote.check_policy(self.policy,record.approved_at)?;
+        let (signed,signed_at)=self.require_local_funding_claim(claim,network,expected)?;
+        let recovery=self.retained_bch_recovery()?.context("missing retained BCH private recovery")?;
+        ensure!(record.approved_at>=signed_at && record.approved_at>=recovery.prepared_at(),"BCH send intent predates recovery");
+        let height=record.details["observedHeight"].as_u64().context("missing BCH send observation height")?;
+        ensure!(height<=u64::from(u32::MAX),"invalid BCH send observation height");
+        let tip:bitcoin::BlockHash=record.details["observedTip"].as_str().context("missing BCH send observation tip")?.parse()?;
+        let expected_details=serde_json::json!({"schema":REVIEW,"action":"send",
+            "tradeId":self.quote.terms()["swapId"],"quoteCommitment":hex(self.quote.commitment()),
+            "claimCommitment":expected,"txid":signed.transaction().compute_txid(),
+            "signedDigest":sha256::Hash::hash(&serialize(signed.transaction())),
+            "privateRecovery":hex(recovery.commitment()),"cancelTxid":recovery.cancel().compute_txid(),
+            "refundTxid":recovery.refund_txid()?,"punishTxid":recovery.punish().compute_txid(),
+            "minimumConfirmations":self.policy.bch_confirmations,"observedHeight":height,
+            "observedTip":tip,"endpoint":{"network":endpoint.network().storage_identity(),
+                "host":endpoint.host(),"port":endpoint.port()}});
+        ensure!(record.details==expected_details,"BCH retry differs from original endpoint or approved funding");
+        Ok((signed,hash(INTENT,&bytes),record.approved_at))
+    }
+
+    /// Read-only observation of the exact retained transaction, including after
+    /// expiry. No vault access, intent creation, replacement or broadcast.
+    pub async fn observe_light_bch_funding_on<S:AsyncRead+AsyncWrite+Unpin>(&self,
+        claim:&ClaimedSpend,chain:&HeaderSequence,expected:sha256::Hash,
+        session:&mut ReadSession<S>,maximum_history:usize)->Result<PaymentObservation> {
+        let (signed,_)=self.require_local_funding_claim(claim,chain.network(),expected)?;
+        let observation=claim.observe_payment_on(session,chain,maximum_history).await?;
+        ensure!(self.require_local_funding_claim(claim,chain.network(),expected)?.0.transaction()==signed.transaction(),
+            "BCH retained funding changed during observation");
+        Ok(observation)
+    }
+
+    /// Retry may newly publish funding, so current quote policy is required.
+    /// Pending/absent reports are not proof of unspentness or network absence.
+    /// The durable trade intent also covers interruption before wallet intent.
+    pub fn review_light_bch_funding_retry(&self,claim:&ClaimedSpend,chain:&HeaderSequence,
+        expected:sha256::Hash,endpoint:&TlsEndpoint,observation:&PaymentObservation,now:u64)->Result<FundingRelayReview> {
+        self.quote.check_policy(self.policy,now)?;
+        let (signed,intent,approved_at)=self.retained_send(claim,chain.network(),expected,endpoint)?;
+        ensure!(now>=approved_at,"BCH retry predates original approval");
+        ensure!(observation.txid()==signed.transaction().compute_txid(),"BCH retry observation targets another transaction");
+        let position=match observation.position_on(chain)? {
+            PaymentPosition::NotReported=>"not-reported",
+            PaymentPosition::ReportedPending=>"reported-pending",
+            PaymentPosition::Included {..}=>anyhow::bail!("BCH funding already included; reconcile settlement"),
+        };
+        let status=match claim.broadcast_status(endpoint,expected)? {
+            BroadcastStatus::NoLocalAttempt=>"trade-intent-only",
+            BroadcastStatus::OutcomeUnknown=>"outcome-unknown",
+            BroadcastStatus::ServerAcknowledged=>"server-acknowledged",
+        };
+        let details=serde_json::json!({"schema":REVIEW,"action":"retry",
+            "tradeId":self.quote.terms()["swapId"],"quoteCommitment":hex(self.quote.commitment()),
+            "claimCommitment":expected,"originalIntent":hex(&intent),"txid":signed.transaction().compute_txid(),
+            "signedDigest":sha256::Hash::hash(&serialize(signed.transaction())),
+            "endpoint":{"network":endpoint.network().storage_identity(),"host":endpoint.host(),"port":endpoint.port()},
+            "localStatus":status,"reportedPosition":position,"observedHeight":observation.selected_height(),
+            "observedTip":observation.selected_tip()});
+        Ok(FundingRelayReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+
+    pub async fn retry_light_bch_funding(&self,claim:&ClaimedSpend,chain:&HeaderSequence,
+        expected:sha256::Hash,endpoint:&TlsEndpoint,observation:&PaymentObservation,
+        approved:&[u8;32],now:u64)->Result<Txid> {
+        let review=self.review_light_bch_funding_retry(claim,chain,expected,endpoint,observation,now)?;
+        ensure!(review.commitment==*approved,"BCH funding retry approval is stale or changed");
+        endpoint.broadcast_retained(claim,expected).await
+    }
+}
