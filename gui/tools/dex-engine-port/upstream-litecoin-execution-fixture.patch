+// Public test seeds shared with the independent machine execution fixture.
+// LocalKeys::generate draws its contract and native spend secrets first; view
+// generation and proof randomness occur afterward and do not change these keys.
+fn execution_fixture_keys(role: &str) -> (SecretKey,SecretKey) {
+    let seed: [u8;32]=Sha256::digest(format!("monzero-ltc-execution-fixture-v1/{role}")).into();
+    let mut rng=ChaCha20Rng::from_seed(seed);
+    let contract=SecretKey::new_random(&mut rng);
+    let native=swap_core::monero::Scalar::random(&mut rng);
+    (contract,SecretKey::from(native.to_secpfun_scalar()))
