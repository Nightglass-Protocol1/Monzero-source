+/// Trusted retained context, NOT values adopted from the file being loaded.
+/// Policy must be the historical policy for this swap, not today's new-trade
+/// policy. Production checkpoint integrity/ownership remains separate work.
+pub struct RecoveryContext<'a> {
+    pub swap_id: uuid::Uuid,
+    pub commitment: &'a [u8;32],
+    pub policy: &'a DeploymentPolicy,
+    pub btc_key: &'a [u8;32],
+    pub xmz_key: &'a [u8;32],
+    pub btc_network: bitcoin::Network,
+    pub xmz_network: swap_core::xmz_address::XmzNetwork,
+}
+
+/// Historical commercial context only: no fresh claim, funding permit, engine
+/// checkpoint, broadcast status or resume method. Never proves user consent.
+pub struct RecordedExecution {
+    quote: crate::native_trade_quote::RecordedQuote,
+    requested_at: u64,
+}
+
+impl RecordedExecution {
+    pub fn quote(&self) -> &crate::native_trade_quote::RecordedQuote { &self.quote }
+    pub fn requested_at(&self) -> u64 { self.requested_at }
+
+    #[cfg(target_os = "linux")]
+    pub fn load(directory: &Path, context: &RecoveryContext<'_>, now: u64) -> Result<Self> {
+        let bytes = read_execution(directory, context.swap_id)?;
+        Self::decode(&bytes, context, now)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn load(_: &Path, _: &RecoveryContext<'_>, _: u64) -> Result<Self> {
+        anyhow::bail!("execution recovery is not implemented on this platform")
+    }
+
+    fn decode(bytes: &[u8], context: &RecoveryContext<'_>, now: u64) -> Result<Self> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields, rename_all="camelCase")]
+        struct Record {
+            schema: String, quote_commitment: [u8;32], requested_at: String,
+            policy: DeploymentPolicy, reservation: serde_json::Value,
+        }
+        ensure!(!context.swap_id.is_nil() && !bytes.is_empty() && bytes.len()<=32768,
+            "invalid execution recovery identity or size");
+        let value: serde_json::Value = serde_json::from_slice(bytes)?;
+        ensure!(serde_json::to_vec(&value)? == bytes, "noncanonical execution record");
+        let record: Record = serde_json::from_value(value)?;
+        ensure!(record.schema == "monzero-native-execution-attempt-v2"
+            && &record.quote_commitment == context.commitment && &record.policy == context.policy,
+            "execution record differs from retained context");
+        let at: u64 = record.requested_at.parse()?;
+        ensure!(at <= now && at <= i64::MAX as u64 && at.to_string() == record.requested_at,
+            "invalid execution request timestamp");
+        let reservation = serde_json::to_vec(&record.reservation)?;
+        // Validate admission at its recorded request time, not today's time.
+        // Local timestamps are consistency evidence, not signed consent proofs.
+        let then = VerifiedQuote::from_gui_reservation(&reservation, at, context.btc_key,
+            context.xmz_key, context.btc_network, context.xmz_network)?;
+        then.check_deployment(context.policy, at)?;
+        let quote = crate::native_trade_quote::RecordedQuote::from_gui_reservation(
+            &reservation, now, context.btc_key, context.xmz_key,
+            context.btc_network, context.xmz_network, context.policy, context.commitment)?;
+        ensure!(quote.terms()["swapId"] == context.swap_id.to_string(), "execution swap identity mismatch");
+        Ok(Self {quote, requested_at:at})
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn read_execution(directory: &Path, swap: uuid::Uuid) -> Result<Vec<u8>> {
+    use std::{fs::{File, OpenOptions}, io::Read,
+        os::{fd::{AsRawFd, FromRawFd}, unix::fs::{MetadataExt, OpenOptionsExt}}};
+    ensure!(!swap.is_nil() && directory.is_absolute() && directory.canonicalize()? == directory,
+        "invalid execution recovery directory or identity");
+    let root = OpenOptions::new().read(true)
+        .custom_flags(libc::O_DIRECTORY|libc::O_NOFOLLOW|libc::O_CLOEXEC).open(directory)?;
+    let metadata = root.metadata()?;
+    ensure!(metadata.is_dir() && metadata.uid()==unsafe{libc::geteuid()} && metadata.mode()&0o077==0,
+        "execution recovery directory is not private and owned");
+    let name = std::ffi::CString::new(format!("swap-{swap}.execution"))?;
+    let open = || -> Result<File> {
+        let fd = unsafe {libc::openat(root.as_raw_fd(),name.as_ptr(),
+            libc::O_RDONLY|libc::O_NOFOLLOW|libc::O_NONBLOCK|libc::O_CLOEXEC)};
+        if fd<0 {return Err(std::io::Error::last_os_error().into());}
+        Ok(unsafe{File::from_raw_fd(fd)})
+    };
+    let mut file=open()?;let before=file.metadata()?;
+    ensure!(before.is_file() && before.uid()==unsafe{libc::geteuid()} && before.mode()&0o077==0
+        && before.nlink()==1 && before.len()>0 && before.len()<=32768,"unsafe execution recovery record");
+    let mut bytes=Vec::new();(&mut file).take(32769).read_to_end(&mut bytes)?;
+    let after=file.metadata()?;let named=open()?.metadata()?;
+    ensure!(bytes.len() as u64==before.len() && after.len()==before.len()
+        && after.uid()==before.uid() && after.mode()==before.mode() && after.nlink()==1
+        && (after.mtime(),after.mtime_nsec(),after.ctime(),after.ctime_nsec())
+            ==(before.mtime(),before.mtime_nsec(),before.ctime(),before.ctime_nsec())
+        && (named.dev(),named.ino())==(before.dev(),before.ino()),"execution record changed while reading");
+    Ok(bytes)
+}
