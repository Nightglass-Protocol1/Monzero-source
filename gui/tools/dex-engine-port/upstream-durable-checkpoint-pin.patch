 const DOMAIN: &[u8] = b"monzero-native-bob-pending-checkpoint-v1\0";
 const MAX_BYTES: usize = 1_048_576 + DOMAIN.len() + 32;
+const PIN_DOMAIN: &[u8] = b"monzero-pending-pin-v1\0";
+
+/// Caller-trusted local metadata, separate from checkpoint storage.
+/// Private permissions do not protect against hostile same-user code, rollback,
+/// or a maliciously selected directory. Never take this path from a peer.
+pub struct CheckpointPinStore {
+    directory: std::fs::File,
+}
+
+impl CheckpointPinStore {
+    #[cfg(target_os = "linux")]
+    pub fn open(path: &std::path::Path) -> Result<Self> {
+        use std::os::unix::fs::OpenOptionsExt;
+        ensure!(path.is_absolute() && path.canonicalize()?==path,
+            "pin directory must be canonical and absolute");
+        let directory=std::fs::OpenOptions::new().read(true)
+            .custom_flags(libc::O_DIRECTORY|libc::O_NOFOLLOW|libc::O_CLOEXEC).open(path)?;
+        directory_is_private(&directory)?;
+        Ok(Self {directory})
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn open(_: &std::path::Path) -> Result<Self> {
+        anyhow::bail!("checkpoint pin storage is not implemented on this platform")
+    }
+
+    #[cfg(target_os = "linux")]
+    fn separate_from(&self, directory: &std::fs::File) -> Result<()> {
+        use std::os::unix::fs::MetadataExt;
+        directory_is_private(&self.directory)?;
+        let a=self.directory.metadata()?;let b=directory.metadata()?;
+        ensure!((a.dev(),a.ino())!=(b.dev(),b.ino()),"pin and checkpoint directories must differ");
+        Ok(())
+    }
+}
+
+fn pin_record(id: uuid::Uuid, commitment: &[u8;32], digest: &[u8;32]) -> Vec<u8> {
+    [PIN_DOMAIN,id.as_bytes(),commitment,digest].concat()
+}
+
+fn decode_pin(bytes: &[u8], id: uuid::Uuid, commitment: &[u8;32]) -> Result<[u8;32]> {
+    let prefix=[PIN_DOMAIN,id.as_bytes(),commitment].concat();
+    ensure!(bytes.len()==prefix.len()+32 && bytes.starts_with(&prefix),
+        "checkpoint pin identity or format mismatch");
+    Ok(bytes[prefix.len()..].try_into()?)
+}
 
