+    #[test]
+    fn pin_store_is_private_separate_write_once_and_identity_bound() -> Result<()> {
+        let (root,fd)=root()?;
+        let store=CheckpointPinStore::open(&root.0)?;
+        assert!(store.separate_from(&fd).is_err());
+        let other=root.0.join("checkpoints");fs::DirBuilder::new().mode(0o700).create(&other)?;
+        store.separate_from(&fs::File::open(&other)?)?;
+        let id=uuid::Uuid::new_v4();let commitment=[1;32];let digest=[2;32];
+        let record=pin_record(id,&commitment,&digest);
+        write_once(&store.directory,"fixture.pin",&record)?;
+        drop(store);
+        let reopened=CheckpointPinStore::open(&root.0)?;
+        let bytes=read_private(&reopened.directory,"fixture.pin")?;
+        assert_eq!(decode_pin(&bytes,id,&commitment)?,digest);
+        assert!(decode_pin(&bytes,uuid::Uuid::new_v4(),&commitment).is_err());
