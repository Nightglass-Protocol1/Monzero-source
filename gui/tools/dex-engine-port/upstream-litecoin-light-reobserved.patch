+    /// Reopen the exact retained payment using externally retained review terms
+    /// and commitment, then revalidate only its inputs against this scan. No
+    /// selection, allocation, new claims, signing or broadcast occurs here.
+    pub fn reopen_payment(&self,chain:&HeaderSequence,payment:&TxOut,change_index:Option<u32>,
+        maximum_fee:bitcoin::Amount,minimum_confirmations:u64,directory:&Path,operation:Uuid,
+        expected:bitcoin::hashes::sha256::Hash)->Result<ObservedClaimedSpend> {
+        use crate::litecoin_light::vault::signing::review::claims::ClaimedSpend;
+        let claimed=ClaimedSpend::open(directory,operation,&self.account,payment,change_index,maximum_fee,expected)?;
+        let candidates=self.payment_inputs()?;
+        let by_outpoint=candidates.iter().map(|input|(bitcoin::OutPoint {txid:input.transaction.txid(),vout:input.vout},input)).collect::<BTreeMap<_,_>>();
+        let mut inputs=Vec::with_capacity(claimed.transaction().input.len());
+        for input in &claimed.transaction().input {
+            let found=by_outpoint.get(&input.previous_output).context("Litecoin retained input is absent or observed spent")?;
+            inputs.push(IncludedInput {transaction:found.transaction,vout:found.vout,branch:found.branch,index:found.index});
+        }
+        ObservedClaimedSpend::revalidate(claimed,chain,&self.accounting,&inputs,minimum_confirmations)
+    }
