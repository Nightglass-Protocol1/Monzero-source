+#[test]
+fn reopened_claim_reanchors_exact_transaction_after_chain_extension()->Result<()> {
+    // Public seed and injected genesis inclusion test policy, not consensus history.
+    let (seed,account,mut spend,prevout)=super::super::super::super::tests::fixture()?;
+    let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut credit=spend.clone();credit.output=vec![prevout.clone()];
+    let included=IncludedTransaction::new(MerkleMatch {txid:credit.compute_txid(),
+        block_hash:chain.header(0).unwrap().block_hash(),claimed_height:0},&credit)?;
+    spend.input[0].previous_output=OutPoint {txid:included.txid(),vout:0};
+    let payment=spend.output[0].clone();let fee=Amount::from_sat(1000);
+    let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:3}];
+    let old=ObservedWallet::reconcile(&chain,&[prevout.script_pubkey.clone()],std::slice::from_ref(&included))?;
+    let directory=Directory::new()?;let operation=Uuid::new_v4();
+    let prepared=ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,fee,1)?
+        .retain_observed(&chain,&old,&directory.0,operation)?;
+    let commitment=prepared.signing_commitment();drop(prepared);
+    let fixture:serde_json::Value=serde_json::from_str(include_str!("../../../../../session/wallet/fixture.json"))?;
+    chain.append(&Vec::from_hex(fixture["blocks"][0]["header"].as_str().unwrap())?,u64::MAX-7200)?;
+    let observed=ObservedWallet::reconcile(&chain,&[prevout.script_pubkey.clone()],std::slice::from_ref(&included))?;
+    let open=||ClaimedSpend::open(&directory.0,operation,&account,&payment,None,fee,commitment);
+    let count=fs::read_dir(&directory.0)?.count();
+    assert!(ObservedClaimedSpend::revalidate(open()?,&chain,&old,&inputs,1).is_err());
+    assert!(ObservedClaimedSpend::revalidate(open()?,&chain,&observed,&inputs,3).is_err());
+    let wrong=[IncludedInput {transaction:&included,vout:0,branch:Branch::Change,index:3}];
+    assert!(ObservedClaimedSpend::revalidate(open()?,&chain,&observed,&wrong,1).is_err());
+    assert!(ObservedClaimedSpend::revalidate(open()?,&chain,&observed,&[],1).is_err());
+    let spent=ObservedWallet::reconcile_with_pending(&chain,&[prevout.script_pubkey],std::slice::from_ref(&included),&[spend.clone()])?;
+    assert!(ObservedClaimedSpend::revalidate(open()?,&chain,&spent,&inputs,1).is_err());
+    assert_eq!(fs::read_dir(&directory.0)?.count(),count);
+    let reopened=ObservedClaimedSpend::revalidate(open()?,&chain,&observed,&inputs,2)?;
+    assert_eq!(reopened.transaction(),&spend);assert_eq!(reopened.signing_commitment(),commitment);
+    let signed=reopened.approve_and_sign_on(&chain,&observed,&seed,commitment)?;
+    assert_eq!(signed.compute_txid(),spend.compute_txid());drop(reopened);
+    assert_eq!(open()?.load_signed()?,signed);Ok(())
+}
