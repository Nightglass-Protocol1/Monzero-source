 impl ObservedClaimedSpend {
+    /// Re-anchor an existing claimed transaction after a refresh/restart, without
+    /// selecting replacement inputs, changing records or granting signing consent.
+    pub fn revalidate(claimed:ClaimedSpend,chain:&HeaderSequence,observed:&ObservedWallet,
+        inputs:&[IncludedInput<'_>],minimum_confirmations:u64)->Result<Self> {
+        claimed.revalidate_inclusions(chain,inputs,minimum_confirmations)?;
+        let inputs=inputs.iter().map(|input|Ok((OutPoint {txid:input.transaction.txid(),vout:input.vout},
+            input.transaction.outputs().get(input.vout as usize).context("missing Litecoin recovered output")?.value)))
+            .collect::<Result<Vec<_>>>()?;
+        let network=chain.network();let height=chain.height();
+        let tip=chain.header(height).context("missing Litecoin selected tip")?.block_hash();
+        require_observed(chain,observed,network,height,tip,&inputs)?;
+        Ok(Self {claimed,network,height,tip,inputs})
+    }
     pub fn transaction(&self)->&Transaction {self.claimed.transaction()}
     pub fn fee(&self)->Amount {self.claimed.fee()}
     pub fn signing_commitment(&self)->sha256::Hash {self.claimed.signing_commitment()}
