+    /// Authenticate every retained prevout/path against fresh inclusion evidence.
+    /// The retained transaction is never rebuilt by coin selection. This checks
+    /// chain membership/depth; the caller must separately check observed spends.
+    pub(in crate::litecoin_light::vault::signing::review) fn revalidate_inclusions(&self,
+        chain:&crate::litecoin_light::headers::HeaderSequence,
+        inputs:&[super::super::confirmed::IncludedInput<'_>],minimum_confirmations:u64)
+        ->Result<()> {
+        ensure!(inputs.len()==self.review.inputs.len(),"Litecoin recovered input evidence count mismatch");
+        for (included,retained) in inputs.iter().zip(&self.review.inputs) {
+            ensure!(included.transaction.txid()==retained.outpoint.txid && included.vout==retained.outpoint.vout
+                && included.transaction.outputs().get(included.vout as usize)==Some(&retained.prevout)
+                && included.branch==retained.branch && included.index==retained.index,
+                "Litecoin recovered input evidence mismatch");
+            let depth=included.transaction.confirmations_on(chain).context("Litecoin recovered input is orphaned")?;
+            ensure!(minimum_confirmations>0 && depth>=minimum_confirmations
+                && (!included.transaction.is_coinbase() || depth>=100),"Litecoin recovered input is immature");
+        }
+        ensure!(chain.network()==self.review.account.network(),"Litecoin recovered chain network mismatch");
+        Ok(())
+    }
