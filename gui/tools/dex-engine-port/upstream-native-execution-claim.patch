@@ -0,0 +1,65 @@
+//! Single-use local execution-attempt reservation, not a funding permit.
+//! The trusted driver must obtain separate explicit trade-start consent first.
+//! A retained file means reconcile, never restart a new attempt automatically.
+use anyhow::{Result, ensure};
+use std::path::Path;
+use crate::native_trade_quote::{DeploymentPolicy, VerifiedQuote};
+
+/// Only a successful durable create yields this handle. It cannot be reopened
+/// from a file or cloned. Keeping it does not bypass fresh chain/quote checks.
+pub struct ExecutionClaim {
+    quote: VerifiedQuote,
+}
+
+impl ExecutionClaim {
+    /// Caller supplies a persistent, exclusively controlled directory, independent
+    /// of peer input, and the exact commitment approved for trade start (not merely
+    /// quote storage). This API cannot itself attest a human interaction.
+    ///
+    /// Any failure may leave an incomplete intent. Never delete it to retry.
+    /// Neither dropping this handle nor a process restart releases the reservation.
+    #[cfg(target_os = "linux")]
+    pub fn reserve(
+        directory: &Path, quote: VerifiedQuote, policy: &DeploymentPolicy,
+        reviewed_commitment: &[u8; 32], now: u64,
+    ) -> Result<Self> {
+        use std::{fs::{File, OpenOptions}, io::Write,
+            os::{fd::{AsRawFd, FromRawFd}, unix::fs::{MetadataExt, OpenOptionsExt}}};
+        quote.check_deployment(policy, now)?;
+        ensure!(quote.commitment() == reviewed_commitment, "execution consent commitment mismatch");
+        ensure!(directory.is_absolute() && directory.canonicalize()? == directory,
+            "execution directory must be canonical and absolute");
+        let root = OpenOptions::new().read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC).open(directory)?;
+        let metadata = root.metadata()?;
+        ensure!(metadata.is_dir() && metadata.uid() == unsafe { libc::geteuid() }
+            && metadata.mode() & 0o077 == 0, "execution directory must be private and owned");
+        let swap: uuid::Uuid = quote.terms()["swapId"].parse()?;
+        ensure!(!swap.is_nil(), "missing execution swap identity");
+        // Identity excludes quote ID/price/destination so changed terms cannot
+        // create a second attempt for the same swap in this local namespace.
+        let name = std::ffi::CString::new(format!("swap-{swap}.execution"))?;
+        let value = serde_json::json!({
+            "schema": "monzero-native-execution-attempt-v1",
+            "quoteCommitment": reviewed_commitment,
+            "requestedAt": now.to_string(),
+            "terms": quote.terms(),
+        });
+        let bytes = serde_json::to_vec(&value)?;
+        let fd = unsafe { libc::openat(root.as_raw_fd(), name.as_ptr(),
+            libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC, 0o600) };
+        if fd < 0 { return Err(std::io::Error::last_os_error().into()); }
+        let mut file = unsafe { File::from_raw_fd(fd) };
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        root.sync_all()?;
+        Ok(Self { quote })
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn reserve(_: &Path, _: VerifiedQuote, _: &DeploymentPolicy, _: &[u8;32], _: u64) -> Result<Self> {
+        anyhow::bail!("execution claims are not implemented on this platform")
+    }
+
+    pub fn quote(&self) -> &VerifiedQuote { &self.quote }
+}
