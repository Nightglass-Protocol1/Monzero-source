+//! Actual private helper subprocess over an authenticated, admitted BCH exchange.
+use super::*;
+use agreement::execution::{AdmittedExecution,NegotiationPins};
+use crate::litecoin_light::{network::BchNetwork,account::{Branch,allocation::AddressBook},vault::SecretSeed};
+use bitcoin::hashes::sha256;
+use std::{collections::BTreeMap,io::Write,os::unix::fs::OpenOptionsExt,path::{Path,PathBuf},process::{Command,Stdio}};
+fn write_new(path:&Path,bytes:&[u8])->Result<()> {
+    let mut file=std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(path)?;
+    file.write_all(bytes)?;file.sync_all()?;Ok(())
+}
+fn inventory(paths:&[&Path])->Result<BTreeMap<PathBuf,sha256::Hash>> {
+    let mut files=BTreeMap::new();
+    for path in paths {for entry in std::fs::read_dir(path)? {
+        let path=entry?.path();files.insert(path.clone(),sha256::Hash::hash(&std::fs::read(path)?));
+    }}Ok(files)
+}
+fn context(config:&[u8],wallet:&[u8],quote:&[u8])->Result<String> {
+    Ok(sha256::Hash::hash(&serde_json::to_vec(&serde_json::json!({"schema":"monzero-bch-light-dex-context-v1",
+        "dexDigest":sha256::Hash::hash(config),"walletDigest":sha256::Hash::hash(wallet),
+        "quoteDigest":sha256::Hash::hash(quote)}))?).to_string())
+}
+fn invoke(helper:&Path,path:&Path,request:&serde_json::Value,success:bool)->Result<serde_json::Value> {
+    let mut child=Command::new(helper).arg("--bch-dex-funding-terms-stdio-v1").arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing helper stdin")?.write_all(&serde_json::to_vec(request)?)?;
+    let output=child.wait_with_output()?;
+    ensure!(output.status.success()==success,"unexpected BCH light terms helper outcome");
+    if !success {
+        ensure!(output.stdout.is_empty() && output.stderr==b"Litecoin light-chain request failed; reload validated state before retrying\n",
+            "failed BCH terms disclosed unexpected output");
+        return Ok(serde_json::Value::Null)
+    }
+    ensure!(output.stderr.is_empty() && output.stdout.len()<=4096,"unexpected BCH terms output");
+    let response:serde_json::Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response["schema"],"monzero-bch-light-dex-funding-terms-response-v1");
+    assert_eq!(response["requestId"],request["requestId"]);assert_eq!(response["executable"],false);
+    Ok(response)
+}
+#[test]
+#[ignore="requires explicitly pinned MONZERO_BCH_LIGHT_HELPER and SHA256"]
+fn bch_local_terms_helper_checks_quote_admission_and_refund_wallet()->Result<()> {
