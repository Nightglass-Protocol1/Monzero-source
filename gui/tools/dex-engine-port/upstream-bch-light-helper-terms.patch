+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper,"noncanonical helper fixture");
+    ensure!(sha256::Hash::hash(&std::fs::read(&helper)?).to_string()==std::env::var("MONZERO_BCH_LIGHT_HELPER_SHA256")?,
+        "BCH light helper fixture digest mismatch");
+    let clock=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();let base=clock-30;
+    let seed=SecretSeed::from_bytes(zeroize::Zeroizing::new([44;32]));
+    let account=seed.public_account(BchNetwork::Regtest,0)?;
+    let refund=account.derive(Branch::Receive,0)?;
+    let network=crate::bch_rpc::BchNetwork::Regtest {checkpoint_height:1,checkpoint:bitcoin::BlockHash::from_byte_array([7;32])};
+    let setup=Setup::with_context_and_refund(Some(network),base,base+3500,None,Some(refund.address().script_pubkey()))?;
+    let snapshots=PrivateStore::new()?;let metadata=PrivateStore::new()?;let addresses=PrivateStore::new()?;let configs=PrivateStore::new()?;
+    let (selected,own,initial)=selected_with_outgoing_at(&setup,&snapshots.0,0,base)?;
+    let (_,peer,_)=selected_with_outgoing_at(&setup,&snapshots.0,1,base)?;
+    let (wallet,received)=selected.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+        base+3,own.commitment(),peer.frame(),peer.signature())?;
+    let ack=wallet.acknowledgement(&setup.quote)?;
+    let agreed=wallet.accept_agreement(&setup.quote,&setup.policy,base+4,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let agreement=agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder,&agreed)?;
+    let pins=NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+    let approval=agreement::execution::approval::review_admission(&setup.quote,&setup.policy,Role::BchFunder,&pins,base+5)?;
+    drop(AdmittedExecution::admit_reviewed(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder,
+        &approval.commitment,pins.clone(),base+5)?);
+    drop(AddressBook::create(&addresses.0,seed.public_account(BchNetwork::Regtest,0)?)?);
+    let wallet_path=configs.0.join("wallet.json");let quote_path=configs.0.join("quote.json");let config_path=configs.0.join("dex.json");
+    let wallet=serde_json::json!({"schema":"monzero-private-bch-light-v1","network":"regtest",
+        "cacheDirectory":configs.0.join("unused-cache"),"maximumHeight":10000,"endpoint":null,
+        "wallet":{"account":account.descriptor(),"addressBookDirectory":addresses.0,"spendDirectory":null,"vault":null}});
+    let mut config=serde_json::json!({"schema":"monzero-private-bch-light-dex-v1","walletConfigFile":wallet_path,
+        "quoteFile":quote_path,"quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "identityPins":[SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"tradeId":setup.quote.terms()["swapId"],"metadataDirectory":metadata.0,
+        "snapshotDirectory":snapshots.0,"negotiationPins":pins});
+    let wallet_bytes=serde_json::to_vec(&wallet)?;let quote_bytes=setup.quote.record()?;let config_bytes=serde_json::to_vec(&config)?;
+    write_new(&wallet_path,&wallet_bytes)?;write_new(&quote_path,&quote_bytes)?;write_new(&config_path,&config_bytes)?;
+    let mut request=serde_json::json!({"schema":"monzero-bch-light-dex-funding-terms-request-v1",
+        "requestId":uuid::Uuid::new_v4(),"approvedConfigDigest":context(&config_bytes,&wallet_bytes,&quote_bytes)?});
+    let stores=[snapshots.0.as_path(),metadata.0.as_path(),addresses.0.as_path()];
+    let before=inventory(&stores)?;invoke(&helper,&config_path,&request,false)?;assert_eq!(inventory(&stores)?,before);
+    let mut book=AddressBook::open(&addresses.0,seed.public_account(BchNetwork::Regtest,0)?)?;
+    book.reserve(uuid::Uuid::new_v4(),Branch::Receive)?;drop(book);
+    let before=inventory(&stores)?;
+    let response=invoke(&helper,&config_path,&request,true).context("allocated BCH wallet terms")?;
+    assert_eq!(response["configurationDigest"],request["approvedConfigDigest"]);
+    assert_eq!(response["result"]["refundAddress"],refund.address().to_string());
+    assert_eq!(response["result"]["amountAtomic"],setup.quote.recovery_plan().terms().locked_atoms.to_string());
+    let contract=crate::litecoin_light::network::LightAddress::parse(BchNetwork::Regtest,response["result"]["contractAddress"].as_str().unwrap())?;
+    assert_eq!(contract.script_pubkey(),&setup.quote.recovery_plan().lock().script_pubkey());
+    assert_eq!(response["result"]["broadcastAuthorized"],false);assert_eq!(response["result"]["watchOnly"],true);
+    assert_eq!(inventory(&stores)?,before);assert!(!configs.0.join("unused-cache").exists());
+    let good=request.clone();request["approvedConfigDigest"]=serde_json::json!("00".repeat(32));
+    invoke(&helper,&config_path,&request,false)?;request=good.clone();
+    request["password"]=serde_json::json!("unexpected secret field");invoke(&helper,&config_path,&request,false)?;request=good;
+    // Flip, do not assume the saved commitment's first byte was nonzero.
+    config["negotiationPins"]["initial"][0]=serde_json::json!(pins.initial[0]^1);
+    let bad=serde_json::to_vec(&config)?;std::fs::write(&config_path,&bad)?;
+    request["approvedConfigDigest"]=serde_json::json!(context(&bad,&wallet_bytes,&quote_bytes)?);
+    invoke(&helper,&config_path,&request,false)?;std::fs::write(&config_path,&config_bytes)?;
+    request["approvedConfigDigest"]=serde_json::json!(context(&config_bytes,&wallet_bytes,&quote_bytes)?);
+    let mut wrong_wallet=wallet.clone();wrong_wallet["network"]=serde_json::json!("main");
+    let wrong=serde_json::to_vec(&wrong_wallet)?;std::fs::write(&wallet_path,&wrong)?;
+    request["approvedConfigDigest"]=serde_json::json!(context(&config_bytes,&wrong,&quote_bytes)?);
+    invoke(&helper,&config_path,&request,false)?;std::fs::write(&wallet_path,&wallet_bytes)?;
+    assert_eq!(inventory(&stores)?,before);assert!(!configs.0.join("unused-cache").exists());
+    Ok(())
+}
