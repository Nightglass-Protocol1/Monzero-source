+// Private local-wallet BCH DEX boundary. Terms are read-only and isolated-chain
+// only; they cannot reserve inputs, unlock keys, sign or authorize publication.
+use super::*;
+use swap_machine::{bch_quote::{Policy,VerifiedBchQuote},
+    bch_key_recovery::authenticated::{Role,native_wallet::agreement::execution::{AdmittedExecution,NegotiationPins}}};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct DexConfig {
+    schema:String,wallet_config_file:PathBuf,quote_file:PathBuf,quote_commitment:String,
+    admitted_at:u64,identity_pins:[[u8;32];2],policy:Policy,trade_id:uuid::Uuid,
+    metadata_directory:PathBuf,snapshot_directory:PathBuf,negotiation_pins:NegotiationPins,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct TermsRequest {schema:String,request_id:uuid::Uuid,approved_config_digest:String}
+fn digest(value:&str)->Result<sha256::Hash> {
+    let digest:sha256::Hash=value.parse()?;
+    ensure!(digest.to_string()==value,"noncanonical BCH DEX digest");Ok(digest)
+}
+fn context_digest(dex:&[u8],wallet:&[u8],quote:&[u8])->Result<sha256::Hash> {
+    Ok(sha256::Hash::hash(&serde_json::to_vec(&json!({"schema":"monzero-bch-light-dex-context-v1",
+        "dexDigest":sha256::Hash::hash(dex),"walletDigest":sha256::Hash::hash(wallet),
+        "quoteDigest":sha256::Hash::hash(quote)}))?))
+}
+pub(super) fn terms(path:&Path)->Result<()> {
+    let mut input=Zeroizing::new(Vec::new());std::io::stdin().take(4097).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=4096,"invalid BCH terms request size");
+    let request:TermsRequest=serde_json::from_slice(&input)?;drop(input);
+    ensure!(request.schema=="monzero-bch-light-dex-funding-terms-request-v1" && !request.request_id.is_nil(),
+        "invalid BCH funding terms request");
+    let (_dex_lease,dex_bytes)=private_config(path)?;
+    let dex:DexConfig=serde_json::from_slice(&dex_bytes)?;
+    ensure!(dex.schema=="monzero-private-bch-light-dex-v1" && !dex.trade_id.is_nil()
+        && dex.policy.bch_network=="bch-regtest","BCH light DEX requires isolated regtest");
+    let (_wallet_lease,wallet_bytes)=private_config(&dex.wallet_config_file)?;
+    let (_quote_lease,quote_bytes)=private_config_limit(&dex.quote_file,16384)?;
+    let expected=context_digest(&dex_bytes,&wallet_bytes,&quote_bytes)?;
+    ensure!(expected==digest(&request.approved_config_digest)?,"BCH light DEX configuration changed");
+    let wallet_config=parse_config(&wallet_bytes,"bch")?;
+    let network=network_for("bch",&wallet_config.network)?;
+    ensure!(network==LightNetwork::from(BchNetwork::Regtest),"wrong BCH DEX wallet network");
+    let quote=VerifiedBchQuote::restore_record(&quote_bytes,&dex.policy,dex.admitted_at,
+        &dex.identity_pins[0],&dex.identity_pins[1],&digest(&dex.quote_commitment)?.to_byte_array())?;
+    ensure!(quote.terms()["bchGenesis"]==network.genesis(),"BCH DEX quote has another genesis");
+    ensure!(quote.terms()["swapId"].parse::<uuid::Uuid>()?==dex.trade_id,"BCH DEX quote belongs to another trade");
+    let execution=AdmittedExecution::resume(&dex.metadata_directory,&dex.snapshot_directory,
+        &quote,&dex.policy,Role::BchFunder)?;
+    execution.saved_admission_review(&dex.negotiation_pins)?;
+    let mut terms=execution.light_funding_terms(now()?)?;
+    let wallet=wallet_config.wallet.as_ref().context("missing BCH local wallet")?;
+    let account=PublicAccount::from_descriptor(&wallet.account,network)?;
+    let book=AddressBook::open(&wallet.address_book_directory,PublicAccount::from_descriptor(&wallet.account,network)?)?;
+    let refund=LightAddress::from_script(network,&quote.recovery_plan().terms().bch_funder_refund)?;
+    book.require_allocated_address(&account,&refund)?;
+    terms["refundAddress"]=json!(refund.to_string());
+    terms["contractAddress"]=json!(LightAddress::from_script(network,&quote.recovery_plan().lock().script_pubkey())?.to_string());
+    output(&json!({"schema":"monzero-bch-light-dex-funding-terms-response-v1","requestId":request.request_id,
+        "tradeId":dex.trade_id,"configurationDigest":expected,"executable":false,"result":terms}))
+}
