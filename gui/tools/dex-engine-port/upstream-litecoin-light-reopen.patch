+//! Reload under the journal lease, with externally supplied review expectations.
+use super::*;
+use bitcoin::consensus::deserialize;
+use serde::Deserialize;
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    schema:String,operation:Uuid,network:String,account:PublicAccountDescriptor,
+    transaction:Vec<u8>,inputs:Vec<Input>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {outpoint:String,prevout:Vec<u8>,branch:u8,index:u32}
+impl ClaimedSpend {
+    /// Reload an existing preparation without signing or creating records.
+    /// Payment/change/fee policy and the commitment come from the caller's
+    /// retained review context, never inferred as approval from disk contents.
+    pub fn open(directory:&Path,operation:Uuid,account:&PublicAccount,payment:&TxOut,
+        change_index:Option<u32>,maximum_fee:Amount,expected:sha256::Hash)->Result<Self> {
+        ensure!(!operation.is_nil(),"missing Litecoin spend operation");
+        let journal=Journal::open(directory)?;
+        let bytes=journal.read(&format!("ltc-spend-{operation}.json"))?;
+        ensure!(sha256::Hash::hash(&bytes)==expected,"Litecoin signing review commitment mismatch");
+        let manifest:Manifest=serde_json::from_slice(&bytes)?;
+        ensure!(manifest.schema=="monzero-ltc-spend-claim-v1" && manifest.operation==operation
+            && manifest.network==account.network().genesis(),"Litecoin recovered spend context mismatch");
+        let imported=PublicAccount::from_descriptor(&manifest.account,account.network())?;
+        ensure!(serde_json::to_vec(&imported.descriptor())?==serde_json::to_vec(&account.descriptor())?,
+            "Litecoin recovered spend account mismatch");
+        ensure!(!manifest.inputs.is_empty() && manifest.inputs.len()<=1000,"invalid Litecoin recovered input count");
+        let transaction:Transaction=deserialize(&manifest.transaction)?;
+        ensure!(serialize(&transaction)==manifest.transaction,"noncanonical Litecoin recovered transaction");
+        let mut inputs=Vec::with_capacity(manifest.inputs.len());
+        for input in manifest.inputs {
+            let prevout:TxOut=deserialize(&input.prevout)?;
+            ensure!(serialize(&prevout)==input.prevout,"noncanonical Litecoin recovered prevout");
+            let branch=match input.branch {0=>Branch::Receive,1=>Branch::Change,_=>anyhow::bail!("invalid Litecoin recovered branch")};
+            inputs.push(OwnedInput {outpoint:input.outpoint.parse()?,prevout,branch,index:input.index});
+        }
+        let review=SpendReview::new(account,transaction,inputs,payment,change_index,maximum_fee)?;
+        let records=records(operation,&review)?;
+        for (name,expected) in &records {
+            ensure!(journal.read(name)?==*expected,"Litecoin recovered claim mismatch");
+        }
+        Ok(Self {journal,review,records})
+    }
+    /// Verify a retained signed transaction without unlocking the seed. Missing
+    /// intent/bytes is an error, never permission to replace or release inputs.
+    /// Verification proves signatures against retained prevouts, not unspentness.
+    pub fn load_signed(&self)->Result<Transaction> {
+        for (name,bytes) in &self.records {
+            ensure!(self.journal.read(name)?==*bytes,"Litecoin spend claim changed; reopen required");
+        }
+        let commitment=self.signing_commitment();
+        let approval=serde_json::to_vec(&serde_json::json!({
+            "schema":"monzero-ltc-signing-intent-v1","commitment":commitment.to_string()
+        }))?;
+        ensure!(self.journal.read(&format!("ltc-signing-{commitment}.json"))?==approval,
+            "Litecoin retained signing intent mismatch");
+        let bytes=self.journal.read(&format!("ltc-signed-{commitment}.tx"))?;
+        let signed:Transaction=deserialize(&bytes)?;
+        ensure!(serialize(&signed)==bytes,"noncanonical Litecoin signed transaction");
+        let mut unsigned=signed.clone();
+        for input in &mut unsigned.input {input.witness=Witness::new();}
+        ensure!(unsigned==self.review.transaction,"Litecoin signed transaction content mismatch");
+        let secp=Secp256k1::verification_only();
+        for (index,owned) in self.review.inputs.iter().enumerate() {
+            let witness=&signed.input[index].witness;
+            ensure!(witness.len()==2,"invalid Litecoin signed witness");
+            let mut items=witness.iter();
+            let signature=ecdsa::Signature::from_slice(items.next().context("missing Litecoin signature")?)?;
+            let key=self.review.account.derive(owned.branch,owned.index)?.public_key();
+            ensure!(signature.sighash_type==EcdsaSighashType::All
+                && items.next()==Some(key.0.serialize().as_slice()),"Litecoin signed witness ownership mismatch");
+            let hash=SighashCache::new(&signed).p2wpkh_signature_hash(index,&owned.prevout.script_pubkey,
+                owned.prevout.value,EcdsaSighashType::All)?;
+            secp.verify_ecdsa(&Message::from(hash),&signature.signature,&key.0)?;
+        }
+        Ok(signed)
+    }
+}
+#[cfg(test)]
+mod tests;
