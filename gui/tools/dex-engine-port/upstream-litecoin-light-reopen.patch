+use super::*;
+use std::fs;
+#[test]
+fn reopen_review_and_signed_bytes_without_seed()->Result<()> {
+    let directory=super::super::tests::Directory::new()?;let operation=Uuid::new_v4();
+    let (seed,review)=super::super::tests::review(&[0,1])?;
+    let account=seed.public_account(LtcNetwork::Regtest,2)?;
+    let payment=review.transaction().output[0].clone();
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;let commitment=claim.signing_commitment();
+    assert!(claim.load_signed().is_err());
+    let signed=claim.approve_and_sign(&seed,commitment)?;drop(seed);drop(claim);
+    let reopened=ClaimedSpend::open(&directory.0,operation,&account,&payment,None,Amount::from_sat(101000),commitment)?;
+    assert_eq!(reopened.load_signed()?,signed);assert_eq!(reopened.fee().to_sat(),101000);Ok(())
+}
+#[test]
+fn reopen_rejects_changed_policy_and_missing_claims()->Result<()> {
+    let directory=super::super::tests::Directory::new()?;let operation=Uuid::new_v4();
+    let (seed,review)=super::super::tests::review(&[0])?;
+    let account=seed.public_account(LtcNetwork::Regtest,2)?;let payment=review.transaction().output[0].clone();
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;let commitment=claim.signing_commitment();
+    let input_name=claim.records[1].0.clone();drop(claim);
+    let open=|payment:&TxOut,max,commitment|ClaimedSpend::open(&directory.0,operation,&account,payment,None,Amount::from_sat(max),commitment);
+    assert!(open(&payment,999,commitment).is_err());
+    let mut changed=payment.clone();changed.value=Amount::from_sat(98000);assert!(open(&changed,1000,commitment).is_err());
+    assert!(open(&payment,1000,sha256::Hash::hash(b"wrong")).is_err());
+    let other=seed.public_account(LtcNetwork::Regtest,3)?;
+    assert!(ClaimedSpend::open(&directory.0,operation,&other,&payment,None,Amount::from_sat(1000),commitment).is_err());
+    fs::remove_file(directory.0.join(input_name))?;
+    assert!(open(&payment,1000,commitment).is_err());Ok(())
+}
+#[test]
+fn signed_reload_rejects_changed_outputs_signatures_and_intent()->Result<()> {
+    let directory=super::super::tests::Directory::new()?;let operation=Uuid::new_v4();
+    let (seed,review)=super::super::tests::review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;let commitment=claim.signing_commitment();
+    let signed=claim.approve_and_sign(&seed,commitment)?;
+    let path=directory.0.join(format!("ltc-signed-{commitment}.tx"));
+    let mut altered=signed.clone();altered.output[0].value=Amount::from_sat(98000);
+    fs::write(&path,serialize(&altered))?;assert!(claim.load_signed().is_err());
+    let mut altered=signed.clone();let mut signature=altered.input[0].witness.iter().next().unwrap().to_vec();signature[10]^=1;
+    let key=altered.input[0].witness.iter().nth(1).unwrap().to_vec();
+    altered.input[0].witness=Witness::from_slice(&[signature,key]);
+    fs::write(&path,serialize(&altered))?;assert!(claim.load_signed().is_err());
+    fs::write(&path,serialize(&signed))?;assert_eq!(claim.load_signed()?,signed);
+    fs::remove_file(directory.0.join(format!("ltc-signing-{commitment}.json")))?;
+    assert!(claim.load_signed().is_err());Ok(())
+}
