+/// The only deployments light DEX funding accepts: isolated regtest paired with
+/// the XMZ fakechain, or Litecoin testnet paired with XMZ testnet. Never mainnet.
+fn staged_network(policy:&Policy)->Result<LtcNetwork> {
+    use swap_core::xmz_address::XmzNetwork;
+    match (policy.ltc_network,policy.xmz_network) {
+        (LtcNetwork::Regtest,XmzNetwork::Mainnet) => Ok(LtcNetwork::Regtest),
+        (LtcNetwork::Testnet,XmzNetwork::Testnet) => Ok(LtcNetwork::Testnet),
+        _ => anyhow::bail!("light DEX funding is limited to Litecoin regtest or testnet test deployments"),
+    }
+}
