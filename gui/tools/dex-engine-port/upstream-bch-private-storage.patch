+#[cfg(target_os="linux")]
+#[test]
+fn private_storage_reopens_exact_agreement_and_never_replaces_valid_alternatives() -> Result<()> {
+    use agreement::storage;
+    use std::os::unix::fs::MetadataExt;
+    let mut setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let first = agreed(&setup,Role::BchFunder)?; let agreement = *first.commitment();
+    assert!(storage::persist(&directory.0,&setup.quote,&setup.policy,Role::NativeFunder,&first).is_err());
+    assert_eq!(std::fs::read_dir(&directory.0)?.count(),0);
+    let digest = storage::persist(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&first)?;
+    let path = std::fs::read_dir(&directory.0)?.next().unwrap()?.path();
+    let inode = std::fs::metadata(&path)?.ino();
+    assert_eq!(storage::persist(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&first)?,digest);
+    assert_eq!(std::fs::metadata(&path)?.ino(),inode);
+    assert_eq!(std::fs::metadata(&path)?.mode()&0o777,0o600);
+    drop(first);
+    let restored = storage::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&digest)?;
+    assert_eq!(*restored.commitment(),agreement);
+    assert!(storage::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&[0;32]).is_err());
+    assert!(storage::restore(&directory.0,&setup.quote,&setup.policy,Role::NativeFunder,&digest).is_err());
+    let lease = crate::litecoin_rpc::reservation::Journal::open(&directory.0)?;
+    assert!(storage::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&digest).is_err());
+    drop(lease);
+    setup.view[0] = monero::PrivateViewKey::new_random(&mut rand::thread_rng());
+    let alternative = agreed(&setup,Role::BchFunder)?;
+    assert_ne!(alternative.commitment(),&agreement);
+    assert!(storage::persist(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&alternative).is_err());
+    assert_eq!(*storage::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&digest)?.commitment(),agreement);
+    Ok(())
+}
