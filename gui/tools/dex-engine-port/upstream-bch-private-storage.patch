+#[cfg(target_os="linux")]
+struct PrivateStore(std::path::PathBuf);
+#[cfg(target_os="linux")]
+impl PrivateStore {
+    fn new() -> Result<Self> {
+        use std::os::unix::fs::DirBuilderExt;
+        let path = std::env::temp_dir().canonicalize()?.join(format!("bch-private-store-{}",uuid::Uuid::new_v4()));
+        std::fs::DirBuilder::new().mode(0o700).create(&path)?; Ok(Self(path))
+    }
+}
+#[cfg(target_os="linux")]
+impl Drop for PrivateStore {
+    fn drop(&mut self) {let _=std::fs::remove_dir_all(&self.0);}
+}
