+#[cfg(target_os="linux")]
+#[test]
+fn private_storage_rejects_insecure_links_torn_and_missing_records() -> Result<()> {
+    use agreement::storage;
+    use std::os::unix::fs::{PermissionsExt,symlink};
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let original = agreed(&setup,Role::BchFunder)?;
+    let digest = storage::persist(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&original)?;
+    let path = std::fs::read_dir(&directory.0)?.next().unwrap()?.path();
+    let fails = || storage::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&digest).is_err();
+    std::fs::set_permissions(&directory.0,std::fs::Permissions::from_mode(0o755))?;
+    assert!(fails());
+    std::fs::set_permissions(&directory.0,std::fs::Permissions::from_mode(0o700))?;
+    std::fs::set_permissions(&path,std::fs::Permissions::from_mode(0o644))?;
+    assert!(fails());
+    std::fs::set_permissions(&path,std::fs::Permissions::from_mode(0o600))?;
+    let backup = directory.0.join("other-link");
+    std::fs::hard_link(&path,&backup)?; assert!(fails()); std::fs::remove_file(&backup)?;
+    std::fs::rename(&path,&backup)?; symlink(&backup,&path)?; assert!(fails());
+    std::fs::remove_file(&path)?; std::fs::rename(&backup,&path)?;
+    assert!(!fails());
+    std::fs::write(&path,b"{")?; assert!(fails());
+    assert!(storage::persist(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&original).is_err());
+    assert_eq!(std::fs::read(&path)?,b"{");
+    std::fs::remove_file(&path)?; assert!(fails());
+    Ok(())
+}
