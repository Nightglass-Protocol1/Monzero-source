+//! Private immutable completed-exchange records. Reuses the established journal
+//! filesystem primitive only; it invokes no Litecoin RPC or coin-specific logic.
+//! The driver must separately pin the returned digest in its trusted execution
+//! record before funding. No directory scan or automatic replacement is allowed.
+use super::*;
+use crate::litecoin_rpc::reservation::Journal;
+use std::path::Path;
+use zeroize::Zeroizing;
+
+fn name(quote: &VerifiedBchQuote, role: Role) -> String {
+    let role = match role {Role::BchFunder=>0,Role::NativeFunder=>1};
+    format!("{}.bch-owned-agreement-{role}",quote.terms()["swapId"])
+}
+
+/// One write-once slot per trade/role prevents a later valid exchange from
+/// replacing the keys used for the original funding. Identical retries are safe.
+/// Publication is atomic and synced; failure must not authorize funding/retry.
+/// The directory must be canonical, caller-owned and private (0700).
+pub fn persist(directory: &Path, quote: &VerifiedBchQuote, policy: &Policy,
+    role: Role, agreed: &AgreedNativeWallet) -> Result<[u8;32]> {
+    let journal = Journal::open(directory)?;
+    let bytes = agreed.secret_checkpoint(quote)?;
+    let digest = checkpoint::commitment(&bytes)?;
+    // Revalidate the complete context before creating any secret record.
+    AgreedNativeWallet::restore_secret_checkpoint(&bytes,&digest,quote,policy,role)?;
+    journal.retain(&name(quote,role),&bytes)?;
+    Ok(digest)
+}
+
+/// Reopen only the requested trade/role slot and require the independently
+/// retained digest. Missing/corrupt/insecure data never starts another exchange.
+/// Recovery material is not execution-state, wallet-import or relay authority.
+pub fn restore(directory: &Path, quote: &VerifiedBchQuote, policy: &Policy,
+    role: Role, expected: &[u8;32]) -> Result<AgreedNativeWallet> {
+    let journal = Journal::open(directory)?;
+    let bytes = Zeroizing::new(journal.read(&name(quote,role))?);
+    AgreedNativeWallet::restore_secret_checkpoint(&bytes,expected,quote,policy,role)
+}
