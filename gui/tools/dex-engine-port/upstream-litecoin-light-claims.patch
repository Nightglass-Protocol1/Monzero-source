@@ -0,0 +1,36 @@
+use super::*;
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("ltc-claims-{}",Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn review(indices:&[u32])->Result<(SecretSeed,SpendReview)> {
+    let (seed,account,mut tx,prevout)=super::super::super::tests::fixture()?;
+    let template=tx.input[0].clone();tx.input.clear();let mut inputs=Vec::new();
+    for index in indices {let mut input=template.clone();input.previous_output.vout=*index;
+        inputs.push(OwnedInput {outpoint:input.previous_output,prevout:prevout.clone(),branch:Branch::Receive,index:3});tx.input.push(input);}
+    let payment=tx.output[0].clone();
+    Ok((seed,SpendReview::new(&account,tx,inputs,&payment,None,Amount::from_sat(100000*indices.len() as u64))?))
+}
+#[test]
+fn claims_survive_restart_and_reject_conflicts_before_partial_publication()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();let (seed,first)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,operation,first)?;
+    assert_eq!(claim.sign(&seed)?.input[0].witness.len(),2);assert_eq!(claim.fee().to_sat(),1000);
+    assert!(ClaimedSpend::retain(&directory.0,operation,review(&[0])?.1).is_err());drop(claim);
+    drop(ClaimedSpend::retain(&directory.0,operation,review(&[0])?.1)?);
+    let count=fs::read_dir(&directory.0)?.count();
+    assert!(ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review(&[1,0])?.1).is_err());
+    assert_eq!(fs::read_dir(&directory.0)?.count(),count);
+    drop(ClaimedSpend::retain(&directory.0,Uuid::new_v4(),review(&[1])?.1)?);
+    assert!(ClaimedSpend::retain(&directory.0,operation,review(&[2])?.1).is_err());Ok(())
+}
+#[test]
+fn claims_resume_partial_publication_and_refuse_tampered_manifest()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();let (seed,review)=review(&[0,1])?;
+    let entries=records(operation,&review)?;let journal=Journal::open(&directory.0)?;
+    journal.retain(&entries[1].0,&entries[1].1)?;drop(journal);
+    let claim=ClaimedSpend::retain(&directory.0,operation,review)?;
+    assert_eq!(claim.sign(&seed)?.input.len(),2);
+    fs::write(directory.0.join(&entries[0].0),b"changed")?;
+    assert!(claim.sign(&seed).is_err());Ok(())
+}
