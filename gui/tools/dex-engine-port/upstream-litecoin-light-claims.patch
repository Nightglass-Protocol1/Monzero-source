+//! Cooperative persistent input claims. All preparations for a wallet must use
+//! the same private directory. No node lock, unspentness proof or auto-release.
+use super::*;
+use bitcoin::{consensus::serialize,hashes::{Hash,sha256}};
+pub struct ClaimedSpend {journal:Journal,review:SpendReview,records:Vec<(String,Vec<u8>)>}
+fn records(operation:Uuid,review:&SpendReview)->Result<Vec<(String,Vec<u8>)>> {
+    ensure!(!operation.is_nil(),"missing Litecoin spend operation");
+    let inputs=review.inputs.iter().map(|input|serde_json::json!({"outpoint":input.outpoint.to_string(),
+        "prevout":serialize(&input.prevout),"branch":match input.branch {Branch::Receive=>0,Branch::Change=>1},"index":input.index})).collect::<Vec<_>>();
+    let manifest=serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-spend-claim-v1","operation":operation,
+        "network":review.account.network().genesis(),"account":review.account.descriptor(),
+        "transaction":serialize(&review.transaction),"inputs":inputs}))?;
+    ensure!(manifest.len()<=2_000_000,"Litecoin spend claim exceeds record limit");
+    let commitment=sha256::Hash::hash(&manifest).to_string();
+    let mut records=vec![(format!("ltc-spend-{operation}.json"),manifest)];
+    for input in &review.inputs {
+        let scope=serde_json::to_vec(&serde_json::json!({"network":review.account.network().genesis(),"outpoint":input.outpoint.to_string()}))?;
+        let name=format!("ltc-input-{}.claim",sha256::Hash::hash(&scope));
+        let bytes=serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-input-claim-v1","operation":operation,"commitment":commitment}))?;
+        records.push((name,bytes));
+    }
+    Ok(records)
+}
+impl ClaimedSpend {
+    /// Holds the shared journal lease through signing. Preflights every record
+    /// before publication. An I/O failure can retain a subset; retry the exact
+    /// operation/review to complete it, never replace it or clear its claims.
+    pub fn retain(directory:&Path,operation:Uuid,review:SpendReview)->Result<Self> {
+        let records=records(operation,&review)?;let journal=Journal::open(directory)?;
+        for (name,bytes) in &records {journal.compatible(name,bytes)?;}
+        // Input claims precede the completed preparation manifest.
+        for (name,bytes) in records.iter().skip(1).chain(records.iter().take(1)) {journal.retain(name,bytes)?;}
+        Ok(Self {journal,review,records})
+    }
+    pub fn transaction(&self)->&Transaction {self.review.transaction()}
+    pub fn fee(&self)->Amount {self.review.fee()}
+    pub fn sign(&self,seed:&SecretSeed)->Result<Transaction> {
+        for (name,bytes) in &self.records {
+            ensure!(self.journal.read(name)?==*bytes,"Litecoin spend claim changed; reopen required");
+        }
+        self.review.sign(seed)
+    }
+}
