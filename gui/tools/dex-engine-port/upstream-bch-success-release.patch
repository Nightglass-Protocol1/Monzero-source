+use super::*;
+use agreement::success::signing_bytes;
+
+pub(super) async fn exercise(bch: &mut AdmittedExecution<'_>,native: &mut AdmittedExecution<'_>,
+    setup: &Setup,snapshots: &PrivateStore,fixture: &Fixture,rpc: &BchRpc,server: &Server) -> Result<()> {
+    let observer = fixture.funding_client()?;
+    let prepared = snapshots.0.join(format!("{}.bch-success-prepared",setup.quote.terms()["swapId"]));
+    assert!(native.bch_success_signing_frame(&observer,rpc,5,2030).await.is_err());
+    // A received proof is insufficient while the native payment is unconfirmed.
+    assert!(bch.bch_success_signing_frame(&observer,rpc,5,2030).await.is_err());
+    assert!(!prepared.exists());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    for mode in [1,3,21,22] {
+        server.state.lock().unwrap().observation_mode = mode;
+        assert!(bch.bch_success_signing_frame(&observer,rpc,5,2030).await.is_err(),"unsafe BCH mode {mode}");
+        assert!(!prepared.exists());
+    }
+    server.state.lock().unwrap().observation_mode = 0;
+    assert!(bch.bch_success_signing_frame(&observer,rpc,0,2030).await.is_err());
+    assert!(bch.bch_success_signing_frame(&observer,rpc,17,2030).await.is_err());
+    assert!(!prepared.exists());
+    // Settlement remains possible after quote expiry, with both chains safe.
+    let frame = bch.bch_success_signing_frame(&observer,rpc,5,2030).await?;
+    assert!(prepared.exists());
+    assert_eq!(*bch.bch_success_signing_frame(&observer,rpc,5,2031).await?,*frame);
+    assert!(bch.recover_bch_success_release(&observer,rpc,5,2031).await.is_err());
+    let key = SigningKey::from_bytes(&[1;32]);
+    let sig = key.sign(&signing_bytes(&frame)?).to_bytes();
+    let wrong = SigningKey::from_bytes(&[2;32]).sign(&signing_bytes(&frame)?).to_bytes();
+    assert!(bch.retain_bch_success_signature(&observer,rpc,5,2031,&frame,&wrong).await.is_err());
+    let changed = zeroize::Zeroizing::new(std::str::from_utf8(&frame)?.replacen(&"ab".repeat(32),&"cd".repeat(32),1).into_bytes());
+    assert_ne!(*changed,*frame);
+    assert!(bch.retain_bch_success_signature(&observer,rpc,5,2031,&changed,&key.sign(&signing_bytes(&changed)?).to_bytes()).await.is_err());
+    fixture.confirmed.store(false,Ordering::SeqCst);
+    assert!(bch.bch_success_signing_frame(&observer,rpc,5,2031).await.is_err());
+    assert!(bch.retain_bch_success_signature(&observer,rpc,5,2031,&frame,&sig).await.is_err());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    let signed = bch.retain_bch_success_signature(&observer,rpc,5,2031,&frame,&sig).await?;
+    assert_eq!(signed.frame(),&*frame);assert_eq!(signed.signature(),sig);
+    assert_eq!(bch.recover_bch_success_release(&observer,rpc,5,2032).await?.frame(),&*frame);
+    server.state.lock().unwrap().observation_mode = 3;
+    assert!(bch.recover_bch_success_release(&observer,rpc,5,2032).await.is_err());
+    assert!(bch.retain_bch_success_signature(&observer,rpc,5,2032,&frame,&sig).await.is_err());
+    server.state.lock().unwrap().observation_mode = 0;
+    fixture.incoming_unlock.store(500,Ordering::SeqCst);
+    assert!(bch.recover_bch_success_release(&observer,rpc,5,2032).await.is_err());
+    fixture.incoming_unlock.store(0,Ordering::SeqCst);
+    assert!(bch.recover_bch_success_release(&observer,rpc,5,2030).await.is_err());
+    let saved = zeroize::Zeroizing::new(std::fs::read(&prepared)?);
+    std::fs::write(&prepared,b"{}")?;
+    assert!(bch.recover_bch_success_release(&observer,rpc,5,2032).await.is_err());
+    std::fs::write(&prepared,&*saved)?;
+    assert_eq!(bch.recover_bch_success_release(&observer,rpc,5,2032).await?.signature(),sig);
+    fixture.confirmed.store(false,Ordering::SeqCst);
+    Ok(())
+}
