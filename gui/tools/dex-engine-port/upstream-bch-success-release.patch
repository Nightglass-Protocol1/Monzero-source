+//! Durable success release. Even the unsigned adaptor frame can enable a BCH
+//! spend, so every public exposure requires fresh observations on both chains.
+use super::*;
+use crate::{bch_rpc::BchRpc,xmz_funding::{self,FundingObserver,FundingRequest}};
+use swap_core::bch::funding::SignedFunding;
+use zeroize::{Zeroize,Zeroizing};
+
+const RECORD: &str = "monzero-bch-success-release-v1";
+const PIN: &str = "monzero-bch-success-release-pin-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Release {
+    schema: String, admission: [u8;32], receipt: [u8;32], at: u64,
+    frame: Vec<u8>, signature: Option<Vec<u8>>,
+}
+impl Drop for Release {fn drop(&mut self) {self.frame.zeroize();}}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin {schema: String, admission: [u8;32], record: [u8;32]}
+/// Sensitive release material. No Debug/Serialize or public-status conversion.
+pub struct SignedSuccess {frame: Zeroizing<Vec<u8>>,signature: Vec<u8>}
+impl SignedSuccess {
+    pub fn frame(&self) -> &[u8] {&self.frame}
+    pub fn signature(&self) -> &[u8] {&self.signature}
+}
+enum Action<'a> {Prepare,Submit(&'a [u8],&'a [u8]),Recover}
+struct ReleaseContext {
+    agreement: AgreedNativeWallet, funding: SignedFunding, request: FundingRequest,
+    receipt: [u8;32], received_at: u64, admission: [u8;32],
+}
+fn name(quote: &VerifiedBchQuote,stage: &str) -> String {format!("{}.bch-success-{stage}",quote.terms()["swapId"])}
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+fn encode(release: &Release) -> Result<Zeroizing<Vec<u8>>> {
+    let mut bytes = Zeroizing::new(Vec::with_capacity(65536));serde_json::to_writer(&mut *bytes,release)?;
+    ensure!(bytes.len() <= 65536,"oversized BCH success release");Ok(bytes)
+}
+impl AdmittedExecution<'_> {
+    fn success_context(&self,bch: &BchRpc,now: u64) -> Result<ReleaseContext> {
+        ensure!(self.role == Role::BchFunder,"wrong BCH success release role");
+        // The receipt accessor is supplied by the native proof module and must
+        // revalidate its private record, signature, quote and agreement binding.
+        let (request,receipt,received_at) = self.native_payment_release_binding()?;
+        ensure!(now >= received_at,"BCH success release predates native proof receipt");
+        let agreement = self.restore_agreement()?;
+        let funding = self.signed_bch_funding()?.context("missing exact BCH funding")?;
+        let prepared = self.prepared_bch_funding()?.context("missing BCH funding preparation")?;
+        let (locked,_) = self.funding_lock_intent(&prepared)?;
+        ensure!(bch.deployment_commitment()? == locked.deployment,"BCH success observer changed");
+        self.retained_bch_recovery()?.context("missing retained BCH recovery")?;
+        Ok(ReleaseContext {agreement,funding,request,receipt,received_at,admission:self.admission_digest()?})
+    }
+    fn load_success(&self,stage: &str,context: &ReleaseContext) -> Result<Option<Release>> {
+        let slot = name(self.quote,stage);
+        let private = optional(&Journal::open(&self.snapshots)?,&slot)?.map(Zeroizing::new);
+        let Some(pin_bytes) = optional(&self.metadata,&format!("{slot}-pin"))? else {
+            ensure!(private.is_none(),"BCH success release lacks trusted pin");return Ok(None)
+        };
+        ensure!(pin_bytes.len() <= 4096,"oversized BCH success pin");
+        let pin: Pin = serde_json::from_slice(&pin_bytes)?;
+        let bytes = private.context("BCH success private record is missing")?;
+        ensure!(bytes.len() <= 65536 && pin.schema == PIN && pin.admission == context.admission
+            && pin.record == hash(RECORD,&bytes) && serde_json::to_vec(&pin)? == pin_bytes,"BCH success pin changed");
+        let release: Release = serde_json::from_slice(&bytes)?;
+        ensure!(*encode(&release)? == *bytes && release.schema == RECORD && release.admission == context.admission
+            && release.receipt == context.receipt && release.at >= context.received_at,"BCH success context changed");
+        let outpoint = context.funding.lock_outpoint();let txid = &context.request.proof.tx_hash.0;
+        if stage == "prepared" {
+            ensure!(release.signature.is_none(),"prepared BCH success has an unexpected identity signature");
+            context.agreement.check_success_frame(self.quote,outpoint,txid,&release.frame)?;
+        } else {
+            ensure!(stage == "signed","invalid BCH success stage");
+            context.agreement.check_signed_success(self.quote,outpoint,txid,&release.frame,
+                release.signature.as_deref().context("missing BCH success identity signature")?)?;
+        }
+        Ok(Some(release))
+    }
+    fn retain_success(&self,stage: &str,release: &Release) -> Result<()> {
+        let bytes = encode(release)?;let slot = name(self.quote,stage);
+        let pin = Pin {schema:PIN.into(),admission:release.admission,record:hash(RECORD,&bytes)};
+        self.metadata.retain(&format!("{slot}-pin"),&serde_json::to_vec(&pin)?)?;
+        Journal::open(&self.snapshots)?.retain(&slot,&bytes)?;Ok(())
+    }
+    async fn checked_success(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64,action: Action<'_>) -> Result<Release> {
+        // Finish slow retained-state and signature validation before live RPCs.
+        let context = self.success_context(bch,now)?;
+        let retained = self.load_success("prepared",&context)?;
+        let signed = self.load_success("signed",&context)?;
+        ensure!(signed.is_none() || retained.is_some(),"signed BCH success lacks original preparation");
+        let prepared = match retained {
+            Some(record) => record,
+            None => {
+                ensure!(matches!(action,Action::Prepare),"missing BCH success signing preparation");
+                let frame = context.agreement.success_frame(self.quote,context.funding.lock_outpoint(),&context.request.proof.tx_hash.0)?;
+                Release {schema:RECORD.into(),admission:context.admission,receipt:context.receipt,at:now,
+                    frame:frame.to_vec(),signature:None}
+            },
+        };
+        ensure!(now >= prepared.at,"BCH success time moved backwards");
+        if let Some(record) = &signed {
+            ensure!(record.frame == prepared.frame && record.at >= prepared.at && now >= record.at,
+                "signed BCH success differs from preparation or time");
+        }
+        let result = match action {
+            Action::Prepare => Release {schema:RECORD.into(),admission:prepared.admission,receipt:prepared.receipt,
+                at:prepared.at,frame:prepared.frame.clone(),signature:None},
+            Action::Submit(frame,signature) => {
+                ensure!(frame == prepared.frame,"BCH success signing frame changed");
+                context.agreement.check_signed_success(self.quote,context.funding.lock_outpoint(),
+                    &context.request.proof.tx_hash.0,frame,signature)?;
+                if let Some(record) = signed {
+                    ensure!(record.signature.as_deref() == Some(signature),"BCH success already signed differently");record
+                } else {Release {schema:RECORD.into(),admission:context.admission,receipt:context.receipt,
+                    at:now,frame:frame.to_vec(),signature:Some(signature.to_vec())}}
+            },
+            Action::Recover => signed.context("missing signed BCH success release")?,
+        };
+        let evidence = xmz_funding::verify(native,context.request,&self.policy.xmz_genesis,
+            u64::from(self.policy.xmz_confirmations)).await?;
+        let live = bch.observe_funding(&context.funding).await?;
+        live.require_funding_window(u64::from(self.policy.bch_confirmations),u32::from(self.policy.cancel_blocks),safety_blocks)?;
+        ensure!(native.snapshot().await? == *evidence.snapshot(),"native chain changed before BCH success release");
+        // Records are not cached chain approval. Every path above, including a
+        // retry or external signer submission, repeats both-chain observation.
+        self.retain_success("prepared",&prepared)?;
+        if result.signature.is_some() {self.retain_success("signed",&result)?;}
+        Ok(result)
+    }
+    pub async fn bch_success_signing_frame(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64) -> Result<Zeroizing<Vec<u8>>> {
+        let release = self.checked_success(native,bch,safety_blocks,now,Action::Prepare).await?;
+        Ok(Zeroizing::new(release.frame.clone()))
+    }
+    pub async fn retain_bch_success_signature(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64,frame: &[u8],signature: &[u8]) -> Result<SignedSuccess> {
+        let release = self.checked_success(native,bch,safety_blocks,now,Action::Submit(frame,signature)).await?;
+        Ok(SignedSuccess {frame:Zeroizing::new(release.frame.clone()),signature:release.signature.clone().context("missing signature")?})
+    }
+    pub async fn recover_bch_success_release(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64) -> Result<SignedSuccess> {
+        let release = self.checked_success(native,bch,safety_blocks,now,Action::Recover).await?;
+        Ok(SignedSuccess {frame:Zeroizing::new(release.frame.clone()),signature:release.signature.clone().context("missing signature")?})
+    }
+}
