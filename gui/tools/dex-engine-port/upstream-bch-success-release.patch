@@ -0,0 +1,54 @@
+//! BCH success adaptor, bound to both funding transactions. The adaptor itself
+//! permits redemption: only chain-gated execution may expose these bytes.
+use super::*;
+use bitcoin::OutPoint;
+use zeroize::Zeroizing;
+
+const DOMAIN: &str = "monzero-bch-success-adaptor-v1";
+const MAX: usize = 8192;
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    schema: String, quote: [u8;32], agreement: [u8;32], swap: String,
+    bch_outpoint: OutPoint, native_txid: String, encrypted: EncryptedSignature,
+}
+pub fn signing_bytes(frame: &[u8]) -> Result<Zeroizing<Vec<u8>>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX,"invalid BCH success frame size");
+    let mut message = Zeroizing::new(format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",DOMAIN.len(),DOMAIN,frame.len()).into_bytes());
+    message.extend_from_slice(frame);Ok(message)
+}
+impl AgreedNativeWallet {
+    pub(super) fn success_frame(&self,quote: &VerifiedBchQuote,bch: OutPoint,native_txid: &str)
+        -> Result<Zeroizing<Vec<u8>>> {
+        ensure!(self.owned.role == Role::BchFunder,"only BCH funder prepares success release");
+        let frame = Frame {schema:DOMAIN.into(),quote:*quote.commitment(),agreement:self.commitment,
+            swap:quote.terms()["swapId"].clone(),bch_outpoint:bch,native_txid:native_txid.into(),
+            encrypted:self.owned.prepare_encrypted_signature(quote)?};
+        let bytes = Zeroizing::new(serde_json::to_vec(&serde_json::to_value(frame)?)?);
+        self.check_success_frame(quote,bch,native_txid,&bytes)?;Ok(bytes)
+    }
+    pub(super) fn check_success_frame(&self,quote: &VerifiedBchQuote,bch: OutPoint,native_txid: &str,bytes: &[u8])
+        -> Result<EncryptedSignature> {
+        ensure!(!bytes.is_empty() && bytes.len() <= MAX,"invalid BCH success frame size");
+        ensure!(native_txid.len() == 64 && native_txid != "0".repeat(64)
+            && native_txid.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid native success payment identity");
+        let frame: Frame = serde_json::from_slice(bytes)?;
+        ensure!(frame.schema == DOMAIN && frame.quote == *quote.commitment()
+            && self.owned.wallet.pair.bch.quote_commitment == *quote.commitment()
+            && frame.agreement == self.commitment && frame.swap == quote.terms()["swapId"]
+            && frame.bch_outpoint == bch && frame.native_txid == native_txid
+            && *Zeroizing::new(serde_json::to_vec(&serde_json::to_value(&frame)?)?) == bytes,
+            "BCH success frame context mismatch");
+        let covenant = quote.recovery_plan().lock();
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize()).context("invalid BCH success signer")?;
+        covenant.data_message().verify_encrypted(&signer,&self.owned.wallet.pair.native.binding.adaptor,&frame.encrypted)?;
+        Ok(frame.encrypted)
+    }
+    pub(super) fn check_signed_success(&self,quote: &VerifiedBchQuote,bch: OutPoint,native_txid: &str,
+        bytes: &[u8],signature: &[u8]) -> Result<EncryptedSignature> {
+        let identity = &quote.terms()[Role::BchFunder.identity()];let mut pin = [0;32];
+        for (i,byte) in pin.iter_mut().enumerate() {*byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?;}
+        VerifyingKey::from_bytes(&pin)?.verify_strict(&signing_bytes(bytes)?,&Signature::from_slice(signature)?)?;
+        self.check_success_frame(quote,bch,native_txid,bytes)
+    }
+}
