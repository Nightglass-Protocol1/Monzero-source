diff --git a/swap/src/cli/api/request/selection_tests.rs b/swap/src/cli/api/request/selection_tests.rs
new file mode 100644
--- /dev/null
+++ b/swap/src/cli/api/request/selection_tests.rs
@@ -0,0 +1,121 @@
+use super::determine_btc_to_swap;
+use crate::cli::list_sellers::QuoteWithAddress;
+use crate::network::quote::{BidQuote, RefundPolicyWire};
+use anyhow::Result;
+use bitcoin::{Address, Amount, Network, address::NetworkUnchecked};
+use libp2p::PeerId;
+use std::future::Future;
+use std::time::Duration;
+use tokio::sync::watch;
+use uuid::Uuid;
+
+type ApprovalFuture = Box<dyn Future<Output = Result<bool>> + Send>;
+
+fn quotes(minimum: u64, maximum: u64) -> (
+    watch::Sender<Vec<QuoteWithAddress>>,
+    watch::Receiver<Vec<QuoteWithAddress>>,
+) {
+    watch::channel(vec![QuoteWithAddress {
+        peer_id: PeerId::random(),
+        multiaddr: "/ip4/127.0.0.1/tcp/5678".parse().unwrap(),
+        quote: BidQuote {
+            price: Amount::from_sat(100_000),
+            min_quantity: Amount::from_sat(minimum),
+            max_quantity: Amount::from_sat(maximum),
+            refund_policy: RefundPolicyWire::FullRefund,
+            reserve_proof: None,
+        },
+        version: Some("1.0.0".parse().unwrap()),
+    }])
+}
+
+async fn deposit_address() -> Result<Address> {
+    Ok("1PdfytjS7C8wwd9Lq5o4x9aXA2YRqaCpH6"
+        .parse::<Address<NetworkUnchecked>>()?
+        .require_network(Network::Bitcoin)?)
+}
+
+#[tokio::test(start_paused = true)]
+async fn approval_receives_selected_amount_and_fee_not_maker_maximum() {
+    for (maximum, expected) in [(10_000, 5_000), (3_000, 3_000)] {
+        let (_source, quotes) = quotes(1_000, maximum);
+        let (_, _, _, amount, fee) = tokio::time::timeout(
+            Duration::from_secs(1),
+            determine_btc_to_swap(
+                quotes,
+                deposit_address(),
+                || async { Ok(Amount::from_sat(6_000)) },
+                || async { Ok((Amount::from_sat(5_000), Amount::from_sat(1_000))) },
+                || async { Ok(()) },
+                None,
+                Uuid::new_v4(),
+                move |quote, amount, fee| -> ApprovalFuture {
+                    assert_eq!(quote.quote.max_quantity, Amount::from_sat(maximum));
+                    assert_eq!(amount, Amount::from_sat(expected));
+                    assert_eq!(fee, Amount::from_sat(1_000));
+                    Box::new(async { Ok(true) })
+                },
+            ),
+        ).await.unwrap().unwrap();
+        assert_eq!(amount, Amount::from_sat(expected));
+        assert_eq!(fee, Amount::from_sat(1_000));
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn zero_balance_never_requests_zero_amount_approval() {
+    let (_source, quotes) = quotes(0, 10_000);
+    let result = tokio::time::timeout(
+        Duration::from_secs(1),
+        determine_btc_to_swap(
+            quotes,
+            deposit_address(),
+            || async { Ok(Amount::ZERO) },
+            || async { Ok((Amount::ZERO, Amount::ZERO)) },
+            || async { Ok(()) },
+            None,
+            Uuid::new_v4(),
+            |_, _, _| -> ApprovalFuture { panic!("zero amount offered for approval") },
+        ),
+    ).await;
+    assert!(result.is_err(), "must wait for a funded balance");
+}
+
+#[tokio::test(start_paused = true)]
+async fn malformed_quote_limits_are_not_offered_for_approval() {
+    let (_source, quotes) = quotes(2_000, 1_000);
+    let result = tokio::time::timeout(
+        Duration::from_secs(1),
+        determine_btc_to_swap(
+            quotes,
+            deposit_address(),
+            || async { Ok(Amount::from_sat(6_000)) },
+            || async { Ok((Amount::from_sat(5_000), Amount::from_sat(1_000))) },
+            || async { Ok(()) },
+            None,
+            Uuid::new_v4(),
+            |_, _, _| -> ApprovalFuture { panic!("amount below maker minimum offered for approval") },
+        ),
+    ).await;
+    assert!(result.is_err(), "must wait for a valid quote");
+}
+
+#[tokio::test(start_paused = true)]
+async fn inconsistent_balance_fails_before_requesting_approval() {
+    let (_source, quotes) = quotes(1_000, 10_000);
+    let result = tokio::time::timeout(
+        Duration::from_secs(1),
+        determine_btc_to_swap(
+            quotes,
+            deposit_address(),
+            || async { Ok(Amount::from_sat(4_000)) },
+            || async { Ok((Amount::from_sat(5_000), Amount::from_sat(1_000))) },
+            || async { Ok(()) },
+            None,
+            Uuid::new_v4(),
+            |_, _, _| -> ApprovalFuture { panic!("inconsistent balance offered for approval") },
+        ),
+    ).await.unwrap();
+    assert!(result.err().expect("inconsistent balance must fail").to_string()
+        .contains("spendable amount exceeds"));
+}
