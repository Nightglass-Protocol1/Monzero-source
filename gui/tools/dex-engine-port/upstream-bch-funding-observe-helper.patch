+// Observe the retained transaction without altering relay intent or private records.
+fn observe(helper: &std::path::Path,path: &std::path::Path,server: &Server,
+    metadata: &PrivateStore,snapshots: &PrivateStore,txid: &str,relay: &str,modes: &[u8]) -> Result<()> {
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    let calls=server.state.lock().unwrap().relay_calls;
+    for &mode in modes {
+        {let mut state=server.state.lock().unwrap();state.observation_mode=mode.into();state.observation_chain_calls=0;}
+        let success=matches!(mode,0|1|2|3);
+        let response=invoke(helper,path,"observe",None,success)?;
+        if success {
+            assert_eq!(response["relay"]["state"],relay);
+            assert_eq!(response["relay"]["confirmed"],false);
+            let value=&response["observation"];
+            assert_eq!(value.as_object().unwrap().len(),6);
+            assert_eq!(value["txid"],txid);assert_eq!(value["tip"],"08".repeat(32));
+            assert!(value["observedAt"].as_str().context("missing observation time")?.parse::<u64>()?>0);
+            let (state,confirmations,unspent)=match mode {
+                0 => ("confirmed-unspent",json!("3"),json!(true)),
+                1 => ("mempool",Value::Null,json!(true)),
+                3 => ("mempool",Value::Null,json!(false)),
+                2 => ("unobserved",Value::Null,Value::Null),
+                _ => unreachable!(),
+            };
+            assert_eq!(value["state"],state);assert_eq!(value["confirmations"],confirmations);
+            assert_eq!(value["lockOutputUnspent"],unspent);
+        }
+        assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+        assert_eq!(server.state.lock().unwrap().relay_calls,calls);
+    }
+    Ok(())
+}
