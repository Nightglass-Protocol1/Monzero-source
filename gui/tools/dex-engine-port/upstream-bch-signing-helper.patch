@@ -0,0 +1,71 @@
+use super::*;
+
+pub(super) fn invoke(helper: &std::path::Path,path: &std::path::Path,action: &str,
+    approved: Option<&str>,success: bool) -> Result<Value> {
+    let id=uuid::Uuid::new_v4();
+    let mut request=json!({"schema":format!("monzero-bch-funding-{action}-request-v1"),"requestId":id});
+    if let Some(approved)=approved {request["commitment"]=json!(approved);}
+    let mut child=Command::new(helper).arg(format!("--funding-{action}-stdio-v1")).arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing signing stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+    if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+    assert!(output.stderr.is_empty());assert!(output.stdout.len()<=65536);
+    let response: Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response.as_object().unwrap().len(),8);
+    assert_eq!(response["schema"],format!("monzero-bch-funding-{action}-response-v1"));
+    assert_eq!(response["requestId"],id.to_string());assert_eq!(response["executable"],false);
+    assert_eq!(response["chainObserved"],false);
+    Ok(response)
+}
+
+pub(super) fn exercise(helper: &std::path::Path,path: &std::path::Path,server: &Server,
+    setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,rpc_path: &std::path::Path,
+    descriptor: &Value) -> Result<Value> {
+    let before=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    let status=invoke(helper,path,"signing-status",None,true)?;
+    assert!(status["signingIntent"].is_null() && status["signedFunding"].is_null());
+    let review=invoke(helper,path,"signing-review",None,true)?;
+    assert_eq!(review["review"]["details"]["action"],"sign-only");
+    assert_eq!(review["review"],status["review"]);
+    assert_eq!(review["tradeId"],setup.quote.terms()["swapId"]);
+    let approved=review["review"]["commitment"].as_str().context("missing signing review")?;
+    invoke(helper,path,"signing-submit",None,false)?;
+    let lock=locking::invoke(helper,path,"lock-review",None,true)?;
+    invoke(helper,path,"signing-submit",lock["review"]["commitment"].as_str(),false)?;
+    let mut wrong=descriptor.clone();wrong["wallet"]=json!("other");
+    save(rpc_path,&serde_json::to_vec(&wrong)?)?;
+    invoke(helper,path,"signing-submit",Some(approved),false)?;
+    save(rpc_path,&serde_json::to_vec(descriptor)?)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    assert_eq!(server.state.lock().unwrap().sign_calls,0);
+    let intent_path=metadata.0.join(format!("{}.bch-funding-signing-intent",setup.quote.terms()["swapId"]));
+    {let mut state=server.state.lock().unwrap();state.sign_intent=Some(intent_path);state.sign_mode=4;}
+    invoke(helper,path,"signing-submit",Some(approved),false)?;
+    let uncertain=invoke(helper,path,"signing-status",None,true)?;
+    assert!(uncertain["signingIntent"].is_object());assert!(uncertain["signedFunding"].is_null());
+    assert_eq!(uncertain["review"],review["review"]);
+    let before=contents(&metadata.0)?;
+    invoke(helper,path,"signing-submit",Some(approved),false)?;
+    assert_eq!(contents(&metadata.0)?,before);
+    assert_eq!(server.state.lock().unwrap().sign_calls,1);
+    // Recover the exact bytes produced by the lost reply through the existing
+    // explicit controller. Helper reconciliation will be integrated separately.
+    let raw=server.state.lock().unwrap().signed_candidate.clone();
+    let mut execution=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    let recovered=execution.review_bch_signing_reconciliation(&raw)?;
+    let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    let signed=execution.reconcile_bch_signing(&raw,&recovered.commitment,now)?;
+    let expected=json!({"txid":signed.lock_outpoint().txid.to_string(),"contractVout":signed.lock_outpoint().vout});
+    drop(execution);
+    let restored=invoke(helper,path,"signing-status",None,true)?;
+    assert_eq!(restored["signingIntent"],uncertain["signingIntent"]);
+    assert_eq!(restored["signedFunding"],expected);
+    let before=contents(&metadata.0)?;
+    assert_eq!(invoke(helper,path,"signing-submit",Some(approved),true)?["signedFunding"],expected);
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&snapshots.0)?,secrets);
+    {let state=server.state.lock().unwrap();assert_eq!(state.sign_calls,1);
+        assert_eq!(state.preparation_calls,1);assert_eq!(state.relay_calls,0);}
+    Ok(expected)
+}
