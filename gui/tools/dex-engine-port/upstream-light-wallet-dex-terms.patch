 impl Execution {
+    /// Public terms from the admitted quote and completed exchange. This never
+    /// reserves wallet inputs, prepares recovery, unlocks a vault or sends.
+    pub fn light_funding_terms(&self,now:u64)->Result<serde_json::Value> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong light funding role");
