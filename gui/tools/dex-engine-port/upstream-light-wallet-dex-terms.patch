+            "tradeId":self.claim.trade,"quoteCommitment":hex(&self.claim.quote),
+            "network":LightNetwork::from(self.policy.ltc_network).storage_identity(),
+            "contractAddress":keys.contract_address().to_string(),
+            "amountAtomic":quote.terms()["ltcAtoms"],"maximumFeeAtomic":quote.terms()["ltcFundingFeeMaxAtoms"],
+            "minimumChangeAtomic":quote.terms()["ltcMinimumOutputAtoms"],
+            "lockConfirmations":self.policy.ltc_confirmations,
+            "refundAddress":quote.destinations().ltc_refund.to_string(),
+            "expiresAt":quote.terms()["expiresAt"],"watchOnly":true,"broadcastAuthorized":false}))
+    }
