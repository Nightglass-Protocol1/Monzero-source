+impl OwnedNativeWallet {
+    pub fn wallet(&self) -> &NativeWalletKeys { &self.wallet }
+    pub fn native_spend_share(&self) -> &monero::PrivateKey { &self.spend }
+    pub fn private_view_share(&self) -> &monero::PrivateViewKey { &self.view_share }
+
+    /// Prepare an encrypted signature only for this role's quoted branch and
+    /// the authenticated peer adaptor. Protocol release policy is separate.
+    pub fn prepare_encrypted_signature(&self, quote: &VerifiedBchQuote) -> Result<EncryptedSignature> {
+        ensure!(self.wallet.pair.bch.quote_commitment == *quote.commitment(), "BCH local signing quote mismatch");
+        let (covenant,peer) = match self.role {
+            Role::BchFunder => (quote.recovery_plan().lock(),&self.wallet.pair.native),
+            Role::NativeFunder => (quote.recovery_plan().recovery(),&self.wallet.pair.bch),
+        };
+        let secret = ecdsa_fun::fun::Scalar::from_bytes(*self.contract).context("invalid held BCH contract scalar")?
+            .non_zero().context("zero held BCH contract scalar")?;
+        Ok(covenant.data_message().encrypted_sign(&secret,&peer.binding.adaptor))
+    }
+
+    pub fn recover_spend_key(&self, quote: &VerifiedBchQuote, funding: &[u8], outpoint: OutPoint,
+        spend: &[u8], encrypted: &EncryptedSignature) -> Result<monero::PrivateKey> {
+        self.wallet.recover_spend_key(quote,self.role,&self.spend,funding,outpoint,spend,encrypted)
+    }
+}
