+#[test]
+fn owned_context_rejects_unrelated_contract_spend_view_role_and_quote() -> Result<()> {
+    let setup = Setup::new()?;
+    for (index,role,tag) in [(0,Role::BchFunder,3),(1,Role::NativeFunder,4)] {
+        let contract = bitcoin::secp256k1::SecretKey::from_slice(&[tag;32])?;
+        let wrong_contract = bitcoin::secp256k1::SecretKey::from_slice(&[5;32])?;
+        assert!(setup.wallet()?.bind_local(&setup.quote,role,wrong_contract,setup.spend[index],setup.view[index]).is_err());
+        assert!(setup.wallet()?.bind_local(&setup.quote,role,contract,setup.spend[1-index],setup.view[index]).is_err());
+        assert!(setup.wallet()?.bind_local(&setup.quote,role,contract,setup.spend[index],setup.view[1-index]).is_err());
+        let wrong_role = if role == Role::BchFunder {Role::NativeFunder} else {Role::BchFunder};
+        assert!(setup.wallet()?.bind_local(&setup.quote,wrong_role,contract,setup.spend[index],setup.view[index]).is_err());
+        let mut terms = setup.quote.terms().clone(); terms.insert("bchLockFeeAtoms".into(),"1001".into());
+        let other_quote = signed(&terms,&setup.policy,1000)?;
+        assert!(setup.wallet()?.bind_local(&other_quote,role,contract,setup.spend[index],setup.view[index]).is_err());
+        let owned = setup.wallet()?.bind_local(&setup.quote,role,contract,setup.spend[index],setup.view[index])?;
+        assert!(owned.prepare_encrypted_signature(&other_quote).is_err());
+        assert_eq!(owned.native_spend_share().as_bytes(),setup.spend[index].as_bytes());
+    }
+    Ok(())
