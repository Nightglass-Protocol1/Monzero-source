 impl NativeWalletKeys {
+    pub fn bind_local(self, quote: &VerifiedBchQuote, role: Role,
+        contract: bitcoin::secp256k1::SecretKey, spend: monero::PrivateKey,
+        view_share: monero::PrivateViewKey) -> Result<OwnedNativeWallet> {
+        ensure!(self.pair.bch.quote_commitment == *quote.commitment(), "BCH local ownership quote mismatch");
+        let (own,index,signer) = match role {
+            Role::BchFunder => (&self.pair.bch,0,quote.recovery_plan().terms().bch_funder_signing_key),
+            Role::NativeFunder => (&self.pair.native,1,quote.recovery_plan().terms().native_funder_signing_key),
+        };
+        let public = bitcoin::secp256k1::PublicKey::from_secret_key(&bitcoin::secp256k1::Secp256k1::new(),&contract);
+        ensure!(public == signer, "BCH local contract secret differs from quote");
+        ensure!(monero::PublicKey::from_private_key(&spend).decompress().compress().to_bytes() == own.binding.native,
+            "BCH local spend secret differs from proof");
+        view_key(&view_share.0.as_bytes())?;
+        ensure!(monero::PublicKey::from_private_key(&view_share.0).decompress().compress().to_bytes() == self.view_public[index],
+            "BCH local view secret differs from signed frame");
+        // Also check the exact unreduced scalar on the adaptor curve.
+        let mut bytes = zeroize::Zeroizing::new(spend.as_bytes()); bytes.reverse();
+        let scalar = ecdsa_fun::fun::Scalar::from_bytes(*bytes).context("invalid local BCH adaptor scalar")?
+            .non_zero().context("zero local BCH adaptor scalar")?;
+        ensure!(ecdsa_fun::ECDSA::verify_only().verification_key_for(&scalar) == own.binding.adaptor,
+            "BCH local scalar differs from proven adaptor");
+        Ok(OwnedNativeWallet {wallet:self,role,contract:zeroize::Zeroizing::new(contract.secret_bytes()),spend,view_share})
+    }
