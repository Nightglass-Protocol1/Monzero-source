+    /// Restores a wallet from an already-recovered spend/view key pair (for
+    /// example, the shared XMZ key a swap participant obtains after the
+    /// counterparty's secret is revealed). This only opens and verifies the
+    /// wallet against the expected address; it constructs, signs and
+    /// broadcasts nothing, matching this module's existing boundary.
+    pub async fn restore(&mut self, id: &SwapWalletId, spend_key: String, view_key: String,
+        restore_height: u64, password: String, expected: &XmzAddress) -> Result<()> {
+        let spend_key = checked_private_key_hex(spend_key)?;
+        let view_key = checked_private_key_hex(view_key)?;
+        let password = checked_password(password)?;
+        ensure!(expected.network() == self.network, "wallet network mismatch");
+        self.require_empty().await?;
+        self.uncertain = true;
+        self.client.rpc(self.client.wallet, "generate_from_keys", json!({
+            "restore_height":restore_height, "filename":id.filename(), "address":expected.to_string(),
+            "spendkey":spend_key.as_str(), "viewkey":view_key.as_str(),
+            "password":password.as_str(), "autosave_current":true, "language":"English"})).await?;
+        ensure!(self.client.opened_wallet(self.network).await?.as_ref() == Some(expected), "restored wallet identity mismatch");
+        self.uncertain = false;
+        Ok(())
+    }
+
     pub async fn close(&mut self, expected: &XmzAddress) -> Result<()> {
         ensure!(!self.uncertain, "wallet session requires reconciliation");
         ensure!(self.client.opened_wallet(self.network).await?.as_ref() == Some(expected), "unexpected wallet before close");
