+/// Canonical lowercase 32-byte hex, matching this codebase's other private
+/// scalar/key encodings. Uppercase or short/long input is rejected rather
+/// than normalized, so a caller cannot smuggle a noncanonical key through.
+fn checked_private_key_hex(value: String) -> Result<Zeroizing<String>> {
+    let value = Zeroizing::new(value);
+    ensure!(value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid private key encoding");
+    Ok(value)
+}
