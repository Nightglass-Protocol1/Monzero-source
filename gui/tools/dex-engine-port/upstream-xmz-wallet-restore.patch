+    #[test]
+    fn private_key_hex_must_be_canonical_lowercase_32_bytes() {
+        let valid = "a".repeat(64);
+        assert!(checked_private_key_hex(valid.clone()).is_ok());
+        for value in [String::new(), "a".repeat(63), "a".repeat(65), "A".repeat(64),
+            format!("{}g", "a".repeat(63)), format!("{}\0", "a".repeat(63))] {
+            assert!(checked_private_key_hex(value).is_err());
+        }
+    }
