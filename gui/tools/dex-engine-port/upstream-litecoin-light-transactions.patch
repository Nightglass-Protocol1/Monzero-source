+use super::*;
+#[test]
+fn transaction_effects_match_scripts_and_spent_outpoints()->Result<()> {
+    let (request,header,raw,response)=crate::litecoin_light::tests::fixture();
+    let proof=match_merkle_proof(&request,&header,&raw,&serde_json::to_vec(&response)?)?;
+    let transaction:Transaction=deserialize(&raw)?;
+    let included=IncludedTransaction::new(proof,&transaction)?;
+    assert_eq!(included.txid(),request.txid);assert_eq!(included.block_hash(),request.block_hash);
+    assert_eq!(included.height(),request.height);assert!(!included.is_coinbase());
+    assert_eq!(included.inputs(),&[transaction.input[0].previous_output]);
+    assert_eq!(included.outputs_to(&transaction.output[0].script_pubkey).collect::<Vec<_>>(),
+        [(OutPoint {txid:request.txid,vout:0},Amount::from_sat(100000))]);
+    assert_eq!(included.outputs_to(Script::new()).count(),0);
+    let chain=headers::HeaderSequence::new(swap_core::litecoin_address::LtcNetwork::Regtest)?;
+    assert_eq!(included.confirmations_on(&chain),None);
+    Ok(())
+}
+#[test]
+fn transaction_effects_reject_replaced_outputs()->Result<()> {
+    let (request,header,raw,response)=crate::litecoin_light::tests::fixture();
+    let proof=match_merkle_proof(&request,&header,&raw,&serde_json::to_vec(&response)?)?;
+    let mut transaction:Transaction=deserialize(&raw)?;transaction.output[0].value=Amount::from_sat(100001);
+    assert!(IncludedTransaction::new(proof,&transaction).is_err());Ok(())
+}
+#[tokio::test]
+async fn transaction_query_requires_local_chain_height_before_io()->Result<()> {
+    use crate::litecoin_light::session::{ReadSession,tests::{server,regtest_handshake}};
+    use swap_core::litecoin_address::LtcNetwork;
+    let (stream,task)=server(regtest_handshake());
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let chain=headers::HeaderSequence::new(LtcNetwork::Regtest)?;
+    assert!(session.transaction_on(&chain,1,Txid::all_zeros()).await.is_err());
+    let chain=headers::HeaderSequence::new(LtcNetwork::Testnet)?;
+    assert!(session.transaction_on(&chain,0,Txid::all_zeros()).await.is_err());
+    drop(session);assert_eq!(task.await?.len(),2);Ok(())
+}
