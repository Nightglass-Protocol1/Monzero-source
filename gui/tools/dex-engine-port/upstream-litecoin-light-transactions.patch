+//! Transaction effects committed by an inclusion proof. No witness or signing
+//! authority is exposed. Inclusion alone does not establish an unspent balance.
+use super::*;
+use bitcoin::{Amount, OutPoint, TxOut};
+
+pub struct IncludedTransaction {
+    proof: MerkleMatch,
+    inputs: Vec<OutPoint>,
+    outputs: Vec<TxOut>,
+    coinbase: bool,
+}
+impl IncludedTransaction {
+    pub(super) fn new(proof:MerkleMatch,transaction:&Transaction)->Result<Self> {
+        ensure!(transaction.compute_txid()==proof.txid(),"Litecoin included transaction identity changed");
+        Ok(Self {proof,inputs:transaction.input.iter().map(|input|input.previous_output).collect(),
+            outputs:transaction.output.clone(),coinbase:transaction.is_coinbase()})
+    }
+    pub(super) fn into_proof(self)->MerkleMatch {self.proof}
+    pub fn txid(&self)->Txid {self.proof.txid()}
+    pub fn block_hash(&self)->BlockHash {self.proof.block_hash()}
+    pub fn height(&self)->u32 {self.proof.claimed_height()}
+    pub fn confirmations_on(&self,chain:&headers::HeaderSequence)->Option<u64> {
+        self.proof.confirmations_on(chain)
+    }
+    /// Coinbase receipts additionally require maturity handling before spending.
+    pub fn is_coinbase(&self)->bool {self.coinbase}
+    pub fn inputs(&self)->&[OutPoint] {&self.inputs}
+    /// Exact script equality; callers derive their own wallet scripts.
+    /// Values are committed output amounts, never a spendable-balance assertion.
+    pub fn outputs_to<'a>(&'a self,script:&'a Script)->impl Iterator<Item=(OutPoint,Amount)>+'a {
+        self.outputs.iter().enumerate().filter(move |(_,output)|output.script_pubkey.as_script()==script)
+            .map(move |(index,output)|(OutPoint {txid:self.txid(),vout:index as u32},output.value))
+    }
+}
