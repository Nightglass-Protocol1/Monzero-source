+use super::*;
+use bitcoin::{ScriptBuf,TxIn,Txid,Witness};
+use crate::bch::covenant::CovenantTerms;
+
+fn fixture(uncompressed: bool) -> Result<(FundingPreview,secp256k1::SecretKey)> {
+    let secret = secp256k1::SecretKey::from_slice(&[3;32])?;
+    let public = secp256k1::PublicKey::from_secret_key(&secp256k1::Secp256k1::new(),&secret);
+    let public = bitcoin::PublicKey {compressed:!uncompressed,inner:public};
+    let script = ScriptBuf::new_p2pkh(&public.pubkey_hash());
+    let covenant = Covenant::new(CovenantTerms {fee_atoms:1000,delay_blocks:20,
+        signing_key:public.inner,redeem_destination:script.clone(),timeout_destination:script.clone()})?;
+    let parent = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(60_000),script_pubkey:script.clone()};2]};
+    let mut tx = parent.clone(); tx.input.push(tx.input[0].clone());
+    for (vout,input) in tx.input.iter_mut().enumerate() {
+        input.previous_output = OutPoint {txid:parent.compute_txid(),vout:vout as u32};
+    }
+    tx.output = vec![TxOut {value:Amount::from_sat(19_000),script_pubkey:script.clone()},
+        TxOut {value:Amount::from_sat(100_000),script_pubkey:covenant.script_pubkey()}];
+    let parent = serialize(&parent);
+    Ok((FundingPreview::verify(&serialize(&tx),&[&parent,&parent],&covenant,100_000,&script,1000,546)?,secret))
+}
+fn sign(preview: &FundingPreview, secret: &secp256k1::SecretKey, uncompressed: bool,
+    wrong_amount: bool) -> Result<Transaction> {
+    let mut tx = preview.transaction().clone(); let secp = secp256k1::Secp256k1::new();
+    let public = secp256k1::PublicKey::from_secret_key(&secp,secret);
+    let key = if uncompressed {public.serialize_uncompressed().to_vec()} else {public.serialize().to_vec()};
+    for index in 0..tx.input.len() {
+        let mut previous = preview.previous_outputs()[index].clone();
+        if wrong_amount { previous.value += Amount::from_sat(1); }
+        let digest = signature_hash(&tx,index,&previous,0x41)?;
+        let signature = secp.sign_ecdsa(&secp256k1::Message::from_digest(digest),secret).serialize_der();
+        let mut bytes = vec![(signature.len()+1) as u8]; bytes.extend(signature.as_ref());
+        bytes.push(0x41); bytes.push(key.len() as u8); bytes.extend(&key);
+        tx.input[index].script_sig = ScriptBuf::from_bytes(bytes);
+    }
+    Ok(tx)
+}
+
+#[test]
+fn forkid_all_matches_four_pinned_bchn_vectors() -> Result<()> {
+    // BCHN src/test/sighash_tests.cpp uses amount zero and preserves scriptCode
+    // for FORKID. Hash strings in its JSON are displayed in reversed byte order.
+    use bitcoin::hex::FromHex;
+    let vectors: Vec<(String,String,usize,i64,String,String)> = serde_json::from_str(
+        include_str!("../bchn-forkid-all-vectors.json"))?;
+    assert_eq!(vectors.len(),4);
+    for (raw,script,index,mode,expected,_) in vectors {
+        let tx: Transaction = deserialize(&Vec::<u8>::from_hex(&raw)?)?;
+        let previous = TxOut {value:Amount::ZERO,script_pubkey:ScriptBuf::from_hex(&script)?};
+        let digest = signature_hash(&tx,index,&previous,mode as u32)?;
+        assert_eq!(sha256d::Hash::from_byte_array(digest).to_string(),expected);
+    }
+    Ok(())
+}
+
+#[test]
+fn signed_funding_verifies_every_input_and_uses_final_legacy_txid() -> Result<()> {
+    for uncompressed in [false,true] {
+        let (preview,secret) = fixture(uncompressed)?;
+        let tx = sign(&preview,&secret,uncompressed,false)?;
+        let signed = preview.verify_signed(&serialize(&tx))?;
+        assert_eq!(signed.transaction(),&tx); assert_eq!(signed.fee().to_sat(),1000);
+        assert_eq!(signed.lock_outpoint(),OutPoint {txid:tx.compute_txid(),vout:1});
+        assert_ne!(signed.lock_outpoint().txid,preview.transaction().compute_txid());
+        assert!(preview.verify_signed(&serialize(&sign(&preview,&secret,uncompressed,true)?)).is_err());
+        let wrong_key = secp256k1::SecretKey::from_slice(&[4;32])?;
+        assert!(preview.verify_signed(&serialize(&sign(&preview,&wrong_key,uncompressed,false)?)).is_err());
+    }
+    Ok(())
+}
+
+#[test]
+fn signed_funding_rejects_changed_template_modes_and_noncanonical_unlocking() -> Result<()> {
+    let (preview,secret) = fixture(false)?; let tx = sign(&preview,&secret,false,false)?;
+    let mut variants = Vec::new();
+    let mut t = tx.clone(); t.output[0].value -= Amount::from_sat(1); variants.push(t);
+    let mut t = tx.clone(); t.output.swap(0,1); variants.push(t);
+    let mut t = tx.clone(); t.input.swap(0,1); variants.push(t);
+    let mut t = tx.clone(); t.input[1].previous_output.vout = 2; variants.push(t);
+    let mut t = tx.clone(); t.input[1].sequence = Sequence::ZERO; variants.push(t);
+    let mut t = tx.clone(); t.version = Version::ONE; variants.push(t);
+    let mut t = tx.clone(); t.lock_time = absolute::LockTime::from_consensus(1); variants.push(t);
+    let mut t = tx.clone(); t.input[1].witness.push([1]); variants.push(t);
+    let mut t = tx.clone(); t.input[1].script_sig = ScriptBuf::new(); variants.push(t);
+    for mode in [0x01,0x42,0x43,0xc1,0x61] {
+        let mut t = tx.clone(); let mut bytes = t.input[1].script_sig.to_bytes();
+        let index = bytes[0] as usize; bytes[index] = mode;
+        t.input[1].script_sig = ScriptBuf::from_bytes(bytes); variants.push(t);
+    }
+    for mutation in 0..4 {
+        let mut t = tx.clone(); let mut bytes = t.input[1].script_sig.to_bytes();
+        match mutation {
+            0 => bytes.push(0), // Extra stack item.
+            1 => bytes.insert(0,0x4c), // Nonminimal PUSHDATA1.
+            2 => bytes[8] ^= 1, // Invalid ECDSA signature.
+            _ => { let at = bytes[0] as usize; bytes.insert(at,0); bytes[0] += 1; }, // Noncanonical DER.
+        }
+        t.input[1].script_sig = ScriptBuf::from_bytes(bytes); variants.push(t);
+    }
+    for invalid in variants { assert!(preview.verify_signed(&serialize(&invalid)).is_err()); }
+    let mut trailing = serialize(&tx); trailing.push(0);
+    assert!(preview.verify_signed(&trailing).is_err());
+    Ok(())
+}
+
+#[test]
+fn signed_funding_rejects_high_s_and_hybrid_public_keys() -> Result<()> {
+    use bitcoin::hex::FromHex;
+    let (preview,secret) = fixture(true)?; let tx = sign(&preview,&secret,true,false)?;
+    let bytes = tx.input[0].script_sig.as_bytes(); let (der,key) = unlocking(bytes)?;
+    let mut compact = Signature::from_der(der)?.serialize_compact();
+    let order = Vec::<u8>::from_hex("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141")?;
+    let mut borrow = 0i16;
+    for index in (0..32).rev() {
+        let value = i16::from(order[index])-i16::from(compact[index+32])-borrow;
+        compact[index+32] = value.rem_euclid(256) as u8;
+        borrow = i16::from(value < 0);
+    }
+    let high = Signature::from_compact(&compact)?;
+    let mut low = high; low.normalize_s(); assert_ne!(high,low);
+    let der = high.serialize_der(); let mut script = vec![(der.len()+1) as u8];
+    script.extend(der.as_ref()); script.push(0x41); script.push(key.len() as u8); script.extend(key);
+    let mut changed = tx.clone(); changed.input[0].script_sig = ScriptBuf::from_bytes(script);
+    assert!(preview.verify_signed(&serialize(&changed)).is_err());
+    let mut script = bytes.to_vec(); let key_at = script[0] as usize+2;
+    script[key_at] = 6 | (script[script.len()-1] & 1);
+    changed.input[0].script_sig = ScriptBuf::from_bytes(script);
+    assert!(preview.verify_signed(&serialize(&changed)).is_err());
+    Ok(())
+}
