+//! Native BCH P2PKH funding signatures: strict DER, low S, ALL|FORKID (0x41).
+//! Reviewed against BCHN 89a591f7c5b1fd110c0819377ad8f2647d656800,
+//! src/script/interpreter.cpp SignatureHash. CashTokens are not supported.
+use super::*;
+use bitcoin::{consensus::Encodable,hashes::{Hash,sha256d,hash160},
+    secp256k1::{self,ecdsa::Signature},OutPoint};
+
+/// Exact signed bytes matching a retained template. This is cryptographic
+/// evidence only: it proves neither live inputs nor approval nor relay status.
+pub struct SignedFunding { transaction: Transaction, lock_vout: u32, fee: Amount }
+impl SignedFunding {
+    pub fn transaction(&self) -> &Transaction { &self.transaction }
+    pub fn fee(&self) -> Amount { self.fee }
+    /// Unlike the template ID, this ID includes the verified legacy signatures.
+    /// Retain these exact bytes before using the outpoint in recovery messages.
+    pub fn lock_outpoint(&self) -> OutPoint {
+        OutPoint {txid:self.transaction.compute_txid(),vout:self.lock_vout}
+    }
+}
+
+impl FundingPreview {
+    /// Accept only exact reviewed fields and independently verified P2PKH input
+    /// signatures. Other preview-supported scripts require their own verifier;
+    /// no generic script acceptance or BCH consensus validity is implied here.
+    pub fn verify_signed(&self, raw: &[u8]) -> Result<SignedFunding> {
+        let transaction = decode(raw)?;
+        let mut unsigned = transaction.clone();
+        for input in &mut unsigned.input { input.script_sig = bitcoin::ScriptBuf::new(); }
+        ensure!(unsigned == self.transaction,"signed BCH funding differs from reviewed template");
+        let secp = secp256k1::Secp256k1::verification_only();
+        for (index,(input,previous)) in transaction.input.iter().zip(&self.previous_outputs).enumerate() {
+            ensure!(previous.script_pubkey.is_p2pkh(),"BCH funding signature verification requires P2PKH inputs");
+            let (der,key) = unlocking(input.script_sig.as_bytes())?;
+            let signature = Signature::from_der(der).context("invalid BCH funding DER signature")?;
+            ensure!(signature.serialize_der().as_ref() == der,"noncanonical BCH funding DER signature");
+            let mut normalized = signature; normalized.normalize_s();
+            ensure!(normalized == signature,"BCH funding signature must have low S");
+            let public = secp256k1::PublicKey::from_slice(key)?;
+            ensure!(hash160::Hash::hash(key).as_byte_array().as_slice() == &previous.script_pubkey.as_bytes()[3..23],
+                "BCH funding signature key differs from source");
+            let message = secp256k1::Message::from_digest(signature_hash(&transaction,index,previous,0x41)?);
+            secp.verify_ecdsa(&message,&signature,&public).context("invalid BCH ALL|FORKID funding signature")?;
+        }
+        Ok(SignedFunding {transaction,lock_vout:self.lock_vout,fee:self.fee})
+    }
+}
+
+fn unlocking(bytes: &[u8]) -> Result<(&[u8],&[u8])> {
+    let length = usize::from(*bytes.first().context("missing BCH funding signature")?);
+    ensure!((9..=73).contains(&length) && bytes.len() > length+1,"invalid BCH funding signature push");
+    ensure!(bytes[length] == 0x41,"BCH funding requires SIGHASH_ALL|FORKID");
+    let key_length = usize::from(bytes[length+1]);
+    ensure!((key_length == 33 || key_length == 65) && bytes.len() == length+2+key_length,
+        "BCH funding requires exactly two minimal pushes");
+    let key = &bytes[length+2..];
+    ensure!((key_length == 33 && matches!(key[0],2|3)) || (key_length == 65 && key[0] == 4),
+        "noncanonical BCH funding public key");
+    Ok((&bytes[1..length],key))
+}
+
+// High fork-id bits are accepted here only to check the pinned BCHN vectors;
+// the production caller and unlocking parser always require exactly 0x41.
+fn signature_hash(tx: &Transaction,index: usize,previous: &TxOut,hash_type: u32) -> Result<[u8;32]> {
+    ensure!(hash_type & 0xff == 0x41,"unsupported BCH funding signature hash mode");
+    let input = tx.input.get(index).context("missing BCH signature input")?;
+    let mut prevouts = Vec::new(); let mut sequences = Vec::new(); let mut outputs = Vec::new();
+    for input in &tx.input {
+        input.previous_output.consensus_encode(&mut prevouts)?;
+        input.sequence.consensus_encode(&mut sequences)?;
+    }
+    for output in &tx.output { output.consensus_encode(&mut outputs)?; }
+    let mut preimage = Vec::new();
+    tx.version.consensus_encode(&mut preimage)?;
+    preimage.extend(sha256d::Hash::hash(&prevouts).to_byte_array());
+    preimage.extend(sha256d::Hash::hash(&sequences).to_byte_array());
+    input.previous_output.consensus_encode(&mut preimage)?;
+    previous.script_pubkey.consensus_encode(&mut preimage)?;
+    previous.value.to_sat().consensus_encode(&mut preimage)?;
+    input.sequence.consensus_encode(&mut preimage)?;
+    preimage.extend(sha256d::Hash::hash(&outputs).to_byte_array());
+    tx.lock_time.consensus_encode(&mut preimage)?;
+    hash_type.consensus_encode(&mut preimage)?;
+    Ok(sha256d::Hash::hash(&preimage).to_byte_array())
+}
