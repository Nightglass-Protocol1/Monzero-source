+use super::*;
+use agreement::execution::{AdmittedExecution,funding::success::SignedSuccess};
+use crate::xmz_funding::{FundingObserver,FundingRequest,FundingObservation,ChainSnapshot};
+use std::sync::atomic::{AtomicUsize,Ordering};
+use swap_core::monero::{TransferProof,TxHash,PrivateKey,Scalar};
+use zeroize::Zeroizing;
+
+struct Native {genesis:String,address:String,amount:u64,mode:AtomicUsize,snapshots:AtomicUsize}
+impl Native {
+    fn new(execution:&AdmittedExecution<'_>,setup:&Setup)->Result<Self> {
+        Ok(Self {genesis:setup.policy.xmz_genesis.clone(),
+            address:execution.restore_agreement()?.owned().wallet().address().to_string(),
+            amount:setup.quote.terms()["xmzAtoms"].parse()?,mode:AtomicUsize::new(0),snapshots:AtomicUsize::new(0)})
+    }
+    fn mode(&self,mode:usize) {self.mode.store(mode,Ordering::SeqCst);self.snapshots.store(0,Ordering::SeqCst);}
+}
+#[async_trait::async_trait]
+impl FundingObserver for Native {
+    async fn snapshot(&self)->Result<ChainSnapshot> {
+        let call=self.snapshots.fetch_add(1,Ordering::SeqCst);
+        Ok(ChainSnapshot {genesis:self.genesis.clone(),tip_height:110,
+            tip_hash:if self.mode.load(Ordering::SeqCst)==3 && call>=2 {"09"}else{"08"}.repeat(32)})
+    }
+    async fn observe(&self,request:&FundingRequest)->Result<FundingObservation> {
+        ensure!(request.proof.tx_hash.0=="ab".repeat(32) && request.proof.tx_key==PrivateKey::from_scalar(Scalar::ONE),
+            "unexpected fixture payment proof");
+        let mode=self.mode.load(Ordering::SeqCst);
+        Ok(FundingObservation {txid:"ab".repeat(32),address:self.address.clone(),
+            received_atoms:self.amount+u64::from(mode==2),in_pool:mode==1,height:100,confirmations:11})
+    }
+}
+#[derive(serde::Serialize)]
+struct Proof {
+    schema:String,quote:[u8;32],agreement:[u8;32],swap:String,bch_txid:String,bch_vout:u32,
+    genesis:String,destination:String,amount:u64,proof:TransferProof,
+}
+pub(super) async fn exercise(execution:&mut AdmittedExecution<'_>,setup:&Setup,snapshots:&std::path::Path,
+    metadata:&std::path::Path,fixture:&super::light_observer::Fixture,signed:&Transaction)->Result<SignedSuccess> {
+    let bch=&fixture.observer;let native=Native::new(execution,setup)?;
+    let trade=&setup.quote.terms()["swapId"];
+    let prepared=snapshots.join(format!("{trade}.bch-success-prepared"));
+    let signed_slot=snapshots.join(format!("{trade}.bch-success-signed"));
+    assert!(!prepared.exists());assert!(!signed_slot.exists());
+    assert!(execution.review_light_bch_success_release(bch,5,2010).is_err());
+    let proof=Proof {schema:"monzero-bch-native-payment-proof-v1".into(),quote:*setup.quote.commitment(),
+        agreement:*execution.restore_agreement()?.commitment(),swap:trade.clone(),
+        bch_txid:signed.compute_txid().to_string(),bch_vout:0,genesis:setup.policy.xmz_genesis.clone(),
+        destination:native.address.clone(),amount:native.amount,
+        proof:TransferProof::new(TxHash("ab".repeat(32)),PrivateKey::from_scalar(Scalar::ONE))};
+    let bytes=Zeroizing::new(serde_json::to_vec(&proof)?);
+    let signature=SigningKey::from_bytes(&[2;32]).sign(&agreement::execution::funding::native::proof::signing_bytes(&bytes)?).to_bytes();
+    execution.accept_bch_native_proof(2004,&bytes,&signature)?;
+    assert!(execution.review_bch_success_release(&bch.deployment_commitment()?,5,2010).is_err());
+    for margin in [0,u32::from(setup.policy.cancel_blocks)] {assert!(execution.review_light_bch_success_release(bch,margin,2010).is_err());}
+    let review=execution.review_light_bch_success_release(bch,5,2010)?;
+    assert_eq!(review.details["fundingSource"],"local-wallet");
+    assert_eq!(native.snapshots.load(Ordering::SeqCst),0);
+    assert!(execution.prepare_reviewed_light_bch_success_release(&native,bch,5,2010,&[0;32]).await.is_err());
+    assert_eq!(native.snapshots.load(Ordering::SeqCst),0);
+    for mode in [1,2,3] {
+        native.mode(mode);
+        assert!(execution.prepare_reviewed_light_bch_success_release(&native,bch,5,2010,&review.commitment).await.is_err(),"unsafe native mode {mode}");
+        assert!(!prepared.exists());
+    }
+    native.mode(0);
+    for depth in [usize::try_from(setup.policy.bch_confirmations)?-1,usize::from(setup.policy.cancel_blocks)-5,usize::from(setup.policy.cancel_blocks)] {
+        fixture.depth.store(depth,Ordering::SeqCst);
+        assert!(execution.prepare_reviewed_light_bch_success_release(&native,bch,5,2010,&review.commitment).await.is_err(),"unsafe BCH depth {depth}");
+        assert!(!prepared.exists());
+    }
+    fixture.depth.store(3,Ordering::SeqCst);
+    let frame=execution.prepare_reviewed_light_bch_success_release(&native,bch,5,2010,&review.commitment).await?;
+    assert!(prepared.exists());assert!(!signed_slot.exists());
+    let original=Zeroizing::new(std::fs::read(&prepared)?);
+    assert_eq!(*execution.prepare_reviewed_light_bch_success_release(&native,bch,5,2011,&review.commitment).await?,*frame);
+    assert_eq!(*Zeroizing::new(std::fs::read(&prepared)?),*original);
+    assert!(execution.review_signed_light_bch_success_release(bch,5,2011).is_err());
+    let signing=execution.review_light_bch_success_signature_retention(bch,5,2011)?;
+    assert_ne!(signing.commitment,review.commitment);
+    let signing_bytes=agreement::success::signing_bytes(&frame)?;
+    let sig=SigningKey::from_bytes(&[1;32]).sign(&signing_bytes).to_bytes();
+    let wrong=SigningKey::from_bytes(&[2;32]).sign(&signing_bytes).to_bytes();
+    assert!(execution.retain_reviewed_light_bch_success_signature(&native,bch,5,2011,&frame,&sig,&review.commitment).await.is_err());
+    assert!(execution.retain_reviewed_light_bch_success_signature(&native,bch,5,2011,&frame,&wrong,&signing.commitment).await.is_err());
+    assert!(!signed_slot.exists());
+    native.mode(1);
+    assert!(execution.retain_reviewed_light_bch_success_signature(&native,bch,5,2011,&frame,&sig,&signing.commitment).await.is_err());
+    assert!(!signed_slot.exists());native.mode(0);
+    let release=execution.retain_reviewed_light_bch_success_signature(&native,bch,5,2011,&frame,&sig,&signing.commitment).await?;
+    assert_eq!(release.frame(),&*frame);assert_eq!(release.signature(),sig);
+    let recovery=execution.review_signed_light_bch_success_release(bch,5,2012)?;
+    assert_ne!(recovery.commitment,signing.commitment);
+    fixture.depth.store(usize::from(setup.policy.cancel_blocks)-5,Ordering::SeqCst);
+    assert!(execution.recover_reviewed_light_bch_success_release(&native,bch,5,2012,&recovery.commitment).await.is_err());
+    fixture.depth.store(3,Ordering::SeqCst);native.mode(3);
+    assert!(execution.recover_reviewed_light_bch_success_release(&native,bch,5,2012,&recovery.commitment).await.is_err());
+    native.mode(0);
+    assert_eq!(execution.recover_reviewed_light_bch_success_release(&native,bch,5,2012,&recovery.commitment).await?.frame(),release.frame());
+    assert!(!metadata.join(format!("{trade}.bch-funding-wallet-lock-intent")).exists());
+    Ok(release)
+}
+pub(super) async fn reopen(execution:&mut AdmittedExecution<'_>,setup:&Setup,fixture:&super::light_observer::Fixture,
+    original:&SignedSuccess)->Result<()> {
+    let native=Native::new(execution,setup)?;let bch=&fixture.observer;
+    let saved=execution.saved_light_bch_success_preparation(bch,5,2020)?;
+    assert_eq!(saved.prepared_at,Some(2010));assert!(saved.signature_retained);
+    let review=execution.review_signed_light_bch_success_release(bch,5,2020)?;
+    native.mode(1);
+    assert!(execution.recover_reviewed_light_bch_success_release(&native,bch,5,2020,&review.commitment).await.is_err());
+    native.mode(0);
+    let recovered=execution.recover_reviewed_light_bch_success_release(&native,bch,5,2020,&review.commitment).await?;
+    assert_eq!(recovered.frame(),original.frame());assert_eq!(recovered.signature(),original.signature());
+    Ok(())
+}
