+//! Explicit local-wallet success release using the retained chain observer.
+//! All exposures share the node path's live native/BCH checks and private journal.
+use super::*;
+use crate::bch_rpc::observer::OwnedBchObserver;
+use super::approval::{SuccessReleaseReview,SavedSuccessPreparation};
+const REVIEW:&str="monzero-bch-light-success-release-review-v1";
+impl AdmittedExecution<'_> {
+    pub fn saved_light_bch_success_preparation(&self,bch:&OwnedBchObserver,safety:u32,now:u64)->Result<SavedSuccessPreparation> {
+        let context=self.success_context_for_observer(&SuccessObserver::Local(bch),now)?;
+        let mut saved=self.saved_success_for_context(context,&bch.deployment_commitment()?,safety,now)?;
+        saved.review=action_review(saved.review,"prepare-bch-success-release")?;
+        Ok(saved)
+    }
+    pub fn review_light_bch_success_release(&self,bch:&OwnedBchObserver,safety:u32,now:u64)->Result<SuccessReleaseReview> {
+        Ok(self.saved_light_bch_success_preparation(bch,safety,now)?.review)
+    }
+    pub fn review_light_bch_success_signature_retention(&self,bch:&OwnedBchObserver,safety:u32,now:u64)->Result<SuccessReleaseReview> {
+        let saved=self.saved_light_bch_success_preparation(bch,safety,now)?;
+        ensure!(saved.prepared_at.is_some(),"missing BCH success signing preparation");
+        action_review(saved.review,"retain-bch-success-signature")
+    }
+    pub fn review_signed_light_bch_success_release(&self,bch:&OwnedBchObserver,safety:u32,now:u64)->Result<SuccessReleaseReview> {
+        let saved=self.saved_light_bch_success_preparation(bch,safety,now)?;
+        ensure!(saved.signature_retained,"missing signed BCH success release");
+        action_review(saved.review,"release-signed-bch-success")
+    }
+    /// Public review is not chain evidence. Fresh checks precede every exposure,
+    /// including identical retries after commercial expiry or process restart.
+    pub async fn prepare_reviewed_light_bch_success_release(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        safety:u32,now:u64,approved:&[u8;32])->Result<Zeroizing<Vec<u8>>> {
+        ensure!(self.review_light_bch_success_release(bch,safety,now)?.commitment==*approved,"BCH light success release consent changed");
+        let release=self.checked_success(native,SuccessObserver::Local(bch),safety,now,Action::Prepare).await?;
+        Ok(Zeroizing::new(release.frame.clone()))
+    }
+    pub async fn retain_reviewed_light_bch_success_signature(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        safety:u32,now:u64,frame:&[u8],signature:&[u8],approved:&[u8;32])->Result<SignedSuccess> {
+        ensure!(self.review_light_bch_success_signature_retention(bch,safety,now)?.commitment==*approved,"BCH light success signature consent changed");
+        let release=self.checked_success(native,SuccessObserver::Local(bch),safety,now,Action::Submit(frame,signature)).await?;
+        Ok(SignedSuccess {frame:Zeroizing::new(release.frame.clone()),signature:release.signature.clone().context("missing signature")?})
+    }
+    pub async fn recover_reviewed_light_bch_success_release(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        safety:u32,now:u64,approved:&[u8;32])->Result<SignedSuccess> {
+        ensure!(self.review_signed_light_bch_success_release(bch,safety,now)?.commitment==*approved,"signed BCH light success consent changed");
+        let release=self.checked_success(native,SuccessObserver::Local(bch),safety,now,Action::Recover).await?;
+        Ok(SignedSuccess {frame:Zeroizing::new(release.frame.clone()),signature:release.signature.clone().context("missing signature")?})
+    }
+}
+fn action_review(mut review:SuccessReleaseReview,action:&str)->Result<SuccessReleaseReview> {
+    review.details["schema"]=serde_json::json!(REVIEW);
+    review.details["fundingSource"]=serde_json::json!("local-wallet");
+    review.details["action"]=serde_json::json!(action);
+    review.commitment=hash(REVIEW,&serde_json::to_vec(&review.details)?);
+    Ok(review)
+}
