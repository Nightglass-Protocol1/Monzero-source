 use super::*;
+#[test]
+fn funding_review_protocol_rejects_approval_and_unpinned_deployment() {
+    let valid = serde_json::json!({"schema":"monzero-bch-funding-review-request-v1",
+        "requestId":uuid::Uuid::new_v4()});
+    assert!(funding_request(&serde_json::to_vec(&valid).unwrap()).is_ok());
+    for (key,value) in [("commitment",serde_json::json!("11".repeat(32))),
+        ("schema",serde_json::json!("monzero-bch-admission-review-request-v1")),
+        ("requestId",serde_json::json!(uuid::Uuid::nil())),("broadcast",serde_json::json!(true))] {
+        let mut bad = valid.clone(); bad[key] = value;
+        assert!(funding_request(&serde_json::to_vec(&bad).unwrap()).is_err());
+    }
+    assert!(funding_request(&vec![b' ';513]).is_err());
+    let valid = serde_json::json!({"schema":"monzero-private-bch-funding-v1",
+        "admissionConfigFile":"/private/admission.json","deploymentCommitment":"11".repeat(32)});
+    assert!(funding_config(&serde_json::to_vec(&valid).unwrap()).is_ok());
+    for (key,value) in [("deploymentCommitment",serde_json::json!("00".repeat(32))),
+        ("deploymentCommitment",serde_json::json!("AA".repeat(32))),
+        ("admissionConfigFile",serde_json::json!("relative.json")),
+        ("rpcPassword",serde_json::json!("unexpected")),
+        ("schema",serde_json::json!("monzero-private-bch-admission-v1"))] {
+        let mut bad = valid.clone(); bad[key] = value;
+        assert!(funding_config(&serde_json::to_vec(&bad).unwrap()).is_err());
+    }
