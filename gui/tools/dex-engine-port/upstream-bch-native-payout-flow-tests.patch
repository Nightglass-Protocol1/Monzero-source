+#[tokio::test]
+async fn bch_native_payout_wallet_constructs_without_relay_and_retains_uncertainty() -> Result<()> {
+    use crate::native_funding_rpc::{full_proceeds::FullProceedsRequest,relay::lock_checkpoint::tests::Fixture as ChainFixture};
+    use swap_core::xmz::XmzAmount;
+    let addresses=include_str!("../../../../swap-core/src/xmz_address_vectors.txt").lines().take(2)
+        .map(|s|XmzAddress::parse(XmzNetwork::Mainnet,s)).collect::<Result<Vec<_>>>()?;
+    let request=ExactNetRequest {source:FullProceedsRequest {wallet:addresses[0].clone(),destination:addresses[1].clone(),
+        lock_txid:"ab".repeat(32),locked:XmzAmount::from_atoms(110),maximum_fee:XmzAmount::from_atoms(3),account:0,priority:1},
+        principal:XmzAmount::from_atoms(100),reserve_return:addresses[1].clone()};
+    let dir=std::env::temp_dir().join(format!("monzero-payout-fixture-{}",uuid::Uuid::new_v4()));std::fs::create_dir(&dir)?;
+    let intent=dir.join("intent");std::fs::write(&intent,br#"{"schema":"monzero-bch-native-payout-intent-v1"}"#)?;
+    let chain=ChainFixture::new(addresses[0].clone(),addresses[1].clone(),"aa".repeat(32),110,3).await?;
+    let observer=chain.funding_client()?;
+    for lost in [false,true] {
+        let id=SwapWalletId::new(uuid::Uuid::new_v4())?;
+        let wallet=Fixture::new(&id,&addresses[0],&[1;32],&[2;32],&request.source.lock_txid).await?;
+        {
+            let mut state=wallet.state.lock().unwrap();state.opened=true;state.exists=true;
+            state.payout=Some(Payout {request:request.clone(),intent:intent.clone(),fee:2});state.lose_payout=lost;
+        }
+        let mut session=wallet.payout_session(&observer)?;
+        session.verify_spend_key(&[1;32],&addresses[0]).await?;
+        let result=session.prepare_lock_payout(&request,&"aa".repeat(32),std::time::Instant::now()+std::time::Duration::from_secs(30)).await;
+        if lost {
+            assert!(result.is_err());assert!(session.uncertain);
+            assert!(session.prepare_lock_payout(&request,&"aa".repeat(32),std::time::Instant::now()+std::time::Duration::from_secs(30)).await.is_err());
+        } else {
+            let prepared=result?;assert!(!session.uncertain);
+            assert_eq!(prepared.terms()["payoutAtoms"],"100");assert_eq!(prepared.terms()["reserveReturnAtoms"],"8");
+            assert_eq!(prepared.terms()["feeAtoms"],"2");
+        }
+        let state=wallet.state.lock().unwrap();assert_eq!(state.calls.iter().filter(|s|s.as_str()=="transfer").count(),1);
+        assert!(!state.calls.iter().any(|s|s=="relay_tx"));
+    }
+    std::fs::remove_dir_all(dir)?;
+    Ok(())
