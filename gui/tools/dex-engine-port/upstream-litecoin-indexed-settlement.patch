 }
+
+impl Execution {
+    /// Find a current confirmed block for the role's already-agreed settlement
+    /// transaction. This returns a search hint, not native-payment authority:
+    /// claim/refund preparation and reconciliation still verify both chains.
+    pub async fn locate_native_settlement_block(&mut self,ltc:&crate::litecoin_rpc::LitecoinRpc)->Result<bitcoin::BlockHash> {
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong settlement lookup network");
+        let (plan,_)=self.recovery_plan()?;
+        let (_,_,quote,_,_)=self.load()?;
+        let txid=match self.role {
+            LocalRole::LitecoinFunder=>plan.redeem_txid(),
+            LocalRole::NativeFunder=>plan.refund_txid(),
+        };
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        Ok(ltc.indexed_confirmed_transaction(txid,minimum).await?.block())
+    }
+}
