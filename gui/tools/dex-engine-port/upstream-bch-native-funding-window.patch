+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn funding_window_rejects_shallow_spent_unobserved_and_cancellation_boundaries() {
+        let check = |status,minimum,cancel,safety| FundingObservation {
+            txid:Txid::all_zeros(),tip:BlockHash::all_zeros(),status,
+        }.require_funding_window(minimum,cancel,safety);
+        for confirmations in [2,3,14] {
+            assert!(check(FundingStatus::ConfirmedUnspent {confirmations},2,20,5).is_ok());
+        }
+        for confirmations in [0,1,15,19,20,21,u64::MAX] {
+            assert!(check(FundingStatus::ConfirmedUnspent {confirmations},2,20,5).is_err());
+        }
+        for status in [FundingStatus::Unobserved,FundingStatus::Mempool {lock_output_unspent:true},
+            FundingStatus::Mempool {lock_output_unspent:false}] {
+            assert!(check(status,2,20,5).is_err());
+        }
+        for (minimum,cancel,safety) in [(0,20,5),(2,20,0),(15,20,5),(2,0,5),
+            (2,65536,5),(u64::MAX,20,1),(2,20,u32::MAX)] {
+            assert!(check(FundingStatus::ConfirmedUnspent {confirmations:3},minimum,cancel,safety).is_err());
+        }
+    }
