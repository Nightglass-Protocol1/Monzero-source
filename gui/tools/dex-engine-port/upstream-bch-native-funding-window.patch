+    /// Check the authenticated BCH lock before native payment preparation.
+    /// The caller selects a positive block margin; confirmation depth and the
+    /// cancellation delay come from the independently checked signed policy.
+    /// Native wallet checks and explicit payment approval remain separate, and
+    /// every later relay/release must independently recheck the chain window.
+    pub async fn check_bch_lock_for_native_funding(&self,backend: &BchRpc,now: u64,safety_blocks: u32)
+        -> Result<NativeFundingLockCheck> {
+        let started = std::time::Instant::now();
+        ensure!(self.role == Role::NativeFunder,"wrong native funding role");
+        let agreed = self.message_context(now)?;
+        let expires = self.quote.terms()["expiresAt"].parse::<u64>()?;
+        let deadline = started.checked_add(std::time::Duration::from_secs(expires.checked_sub(now)
+            .context("BCH native funding quote expired")?)).context("BCH native funding deadline overflow")?;
+        let amount = self.quote.terms()["xmzAtoms"].parse::<u64>()?;
+        let maximum_fee = self.quote.terms()["xmzFundingFeeMaxAtoms"].parse::<u64>()?;
+        let destination = agreed.owned().wallet().address().clone();
+        agreed.check_native_funding(self.quote,self.policy,now,&destination,amount,maximum_fee)?;
+        let (receipt,_,_) = self.message_record("message-received")?.context("missing BCH funding receipt")?;
+        ensure!(now >= receipt.at,"native funding check predates BCH funding receipt");
+        let observation = self.observe_received_bch_funding(backend).await?;
+        observation.require_funding_window(u64::from(self.policy.bch_confirmations),
+            u32::from(self.policy.cancel_blocks),safety_blocks)?;
+        ensure!(std::time::Instant::now() < deadline,"BCH quote expired during native funding check");
+        Ok(NativeFundingLockCheck {observation,destination,amount,maximum_fee})
+    }
