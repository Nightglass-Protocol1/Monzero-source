+    /// Require confirmed, unspent funding with a strict cancellation margin.
+    /// This is point-in-time evidence only. Reobserve immediately before each
+    /// native preparation/release action; a block margin is not a time guarantee.
+    pub fn require_funding_window(&self,minimum: u64,cancel_blocks: u32,safety_blocks: u32) -> Result<()> {
+        ensure!(minimum > 0 && safety_blocks > 0 && cancel_blocks <= 0xffff
+            && minimum.checked_add(u64::from(safety_blocks)).is_some_and(|depth|depth < u64::from(cancel_blocks)),
+            "invalid BCH confirmation or cancellation safety policy");
+        let FundingStatus::ConfirmedUnspent {confirmations} = self.status else {
+            anyhow::bail!("BCH funding is not confirmed and unspent")
+        };
+        ensure!(confirmations >= minimum
+            && confirmations.checked_add(u64::from(safety_blocks)).is_some_and(|depth|depth < u64::from(cancel_blocks)),
+            "BCH funding is shallow or too close to cancellation");
+        Ok(())
+    }
