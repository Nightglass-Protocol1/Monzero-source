+#[test]
+fn cashaddr_p2sh32_contract_destination_and_strict_versions() {
+    // Published CashAddr larger vector: type 1, 256-bit hash.
+    // https://upgradespecs.bitcoincashnode.org/cashaddr/
+    let script=ScriptBuf::from_bytes(bytes("aa203173ef6623c6b48ffd1a3dcc0cc6489b0a07bb47a37f47cfef4fe69de825c06087"));
+    let vector="bchtest:pvch8mmxy0rtfrlarg7ucrxxfzds5pamg73h7370aa87d80gyhqxq7fqng6m6";
+    assert_eq!(LightAddress::from_script(BchNetwork::Testnet,&script).unwrap().to_string(),vector);
+    assert_eq!(LightAddress::parse(BchNetwork::Testnet,vector).unwrap().script_pubkey(),&script);
+    assert!(LightAddress::parse(BchNetwork::Regtest,vector).is_err());
+    assert!(LightAddress::from_script(DogeNetwork::Regtest,&script).is_err());
+    assert!(LightAddress::from_script(BtcNetwork::Regtest,&script).is_err());
+    for network in [BchNetwork::Mainnet,BchNetwork::Testnet,BchNetwork::Regtest] {
+        let address=LightAddress::from_script(network,&script).unwrap().to_string();
+        assert_eq!(LightAddress::parse(network,&address).unwrap().script_pubkey(),&script);
+        let mut corrupt=address.clone();let last=corrupt.pop().unwrap();corrupt.push(if last=='q' {'p'}else{'q'});
+        assert!(LightAddress::parse(network,&corrupt).is_err());
+        assert!(LightAddress::parse(network,&address.to_uppercase()).is_err());
+    }
+    // Valid checksums must not admit mismatched size, reserved or token types.
+    for (version,size) in [(0,32),(3,32),(8,32),(11,20),(27,32),(139,32),(9,24)] {
+        let address=cashaddr_encode("bchreg",version,&vec![1;size]).unwrap();
+        assert!(LightAddress::parse(BchNetwork::Regtest,&address).is_err());
+    }
+    let mut malformed=script.into_bytes();malformed[0]=0xa9;
+    assert!(LightAddress::from_script(BchNetwork::Regtest,&ScriptBuf::from_bytes(malformed)).is_err());
+}
