+//! Exact XMZ preparation for an authenticated BCH lock. Never broadcasts.
+//! Caller must exclusively own the native wallet, as required by its adapter.
+use super::*;
+use crate::{bch_rpc::BchRpc,native_funding_rpc::relay::{NativeTransferRelay,RelayRequest,RelayedTransfer,
+    lock_checkpoint::PreparedNativeLock}};
+use serde_json::json;
+use swap_core::xmz::XmzAmount;
+use zeroize::Zeroizing;
+
+const INTENT: &str = "monzero-bch-native-preparation-intent-v1";
+const PIN: &str = "monzero-bch-native-preparation-pin-v1";
+pub struct NativeFundingSource { pub wallet: XmzAddress, pub account: u32, pub priority: u32 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema: String, admission: [u8;32], receipt: [u8;32], deployment: [u8;32], admitted_at: u64,
+    genesis: String, wallet: String, account: u32, priority: u32, destination: String,
+    amount: u64, maximum_fee: u64, safety_blocks: u32,
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin { schema: String, intent: [u8;32], prepared: [u8;32] }
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+fn summary(prepared: &PreparedNativeLock) -> RelayedTransfer {
+    let value = prepared.summary();
+    RelayedTransfer {txid:value.txid.clone(),fee:value.fee,weight:value.weight}
+}
+impl AdmittedExecution<'_> {
+    fn native_preparation_intent(&self,source: &NativeFundingSource,deployment: [u8;32],
+        safety_blocks: u32,now: u64) -> Result<Intent> {
+        ensure!(self.role == Role::NativeFunder,"wrong BCH native funding role");
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(now >= self.read_admission()?.admitted_at && source.wallet.network() == self.policy.xmz_network
+            && (1..=4).contains(&source.priority),"invalid BCH native source or admission time");
+        ensure!(safety_blocks > 0 && u64::from(self.policy.bch_confirmations)+u64::from(safety_blocks)
+            < u64::from(self.policy.cancel_blocks),"invalid BCH native preparation safety margin");
+        let (receipt,received_at) = self.received_bch_funding_pin()?;
+        ensure!(now >= received_at,"native preparation predates authenticated BCH funding");
+        let agreed = self.restore_agreement()?;
+        let destination = agreed.owned().wallet().address();
+        let amount = self.quote.terms()["xmzAtoms"].parse()?;
+        let maximum_fee = self.quote.terms()["xmzFundingFeeMaxAtoms"].parse()?;
+        agreed.check_native_funding(self.quote,self.policy,now,destination,amount,maximum_fee)?;
+        Ok(Intent {schema:INTENT.into(),admission:self.admission_digest()?,receipt,deployment,admitted_at:now,
+            genesis:self.policy.xmz_genesis.clone(),wallet:source.wallet.to_string(),account:source.account,
+            priority:source.priority,destination:destination.to_string(),amount,maximum_fee,safety_blocks})
+    }
+    fn retained_native_intent(&self) -> Result<(Intent,Vec<u8>)> {
+        let bytes = self.metadata.read(&record_name(self.quote,"native-intent"))?;
+        ensure!(bytes.len() <= 8192,"oversized BCH native funding intent");
+        let intent: Intent = serde_json::from_slice(&bytes)?;
+        let source = NativeFundingSource {wallet:XmzAddress::parse(self.policy.xmz_network,&intent.wallet)?,
+            account:intent.account,priority:intent.priority};
+        let expected = self.native_preparation_intent(&source,intent.deployment,intent.safety_blocks,intent.admitted_at)?;
+        ensure!(serde_json::to_vec(&expected)? == bytes,"BCH native preparation intent changed");
+        Ok((intent,bytes))
+    }
+
+    /// Prepare once with do_not_relay. Source, chain, receipt and margin become
+    /// immutable before wallet construction. Uncertain attempts never construct
+    /// another transaction automatically. No consent for later relay is implied.
+    pub async fn prepare_bch_native_funding(&mut self,native: &mut NativeTransferRelay,bch: &BchRpc,
+        source: NativeFundingSource,safety_blocks: u32,now: u64) -> Result<RelayedTransfer> {
+        let started = std::time::Instant::now();
+        let intent_name = record_name(self.quote,"native-intent");
+        if optional(&self.metadata,&intent_name)?.is_some() {
+            let (retained,bytes) = self.retained_native_intent()?;
+            ensure!(now >= retained.admitted_at,"BCH native preparation time moved backwards");
+            let expected = self.native_preparation_intent(&source,bch.deployment_commitment()?,safety_blocks,retained.admitted_at)?;
+            ensure!(serde_json::to_vec(&expected)? == bytes,"BCH native source, observer or margin already committed");
+            // A missing snapshot is an uncertain attempt, never retry permission.
+            return self.recover_bch_native_funding()
+        }
+        let orphan = optional(&Journal::open(&self.snapshots)?,&record_name(self.quote,"native-prepared"))?.map(Zeroizing::new);
+        ensure!(orphan.is_none() && optional(&self.metadata,&record_name(self.quote,"native-pin"))?.is_none(),
+            "BCH native preparation exists without its original intent");
+        let intent = self.native_preparation_intent(&source,bch.deployment_commitment()?,safety_blocks,now)?;
+        let expires = self.quote.terms()["expiresAt"].parse::<u64>()?;
+        let deadline = started.checked_add(std::time::Duration::from_secs(expires.checked_sub(now)
+            .context("BCH native quote expired")?)).context("BCH native deadline overflow")?;
+        let request = RelayRequest {wallet:source.wallet,destination:XmzAddress::parse(self.policy.xmz_network,&intent.destination)?,
+            amount:XmzAmount::from_atoms(intent.amount),account:intent.account,priority:intent.priority};
+        // Reject wrong/unfunded source wallets before committing an unusable one.
+        native.preflight(&request,&intent.genesis).await?;
+        self.check_bch_lock_for_native_funding(bch,now,safety_blocks).await?;
+        ensure!(std::time::Instant::now() < deadline,"BCH native quote expired during preflight");
+        let bytes = serde_json::to_vec(&intent)?;
+        self.metadata.retain(&intent_name,&bytes)?;
+        let digest = hash(INTENT,&bytes);
+        let prepared = native.prepare_native_lock_before(request,&intent.genesis,
+            XmzAmount::from_atoms(intent.maximum_fee),deadline).await?;
+        // Always retain a valid result, even if commercial validity elapsed while
+        // the wallet constructed it. Future relay must perform fresh checks.
+        let private = prepared.encode(digest)?;
+        // Native wallet metadata is opaque: a private orphan cannot prove which
+        // transaction the wallet returned. Pin its digest in trusted metadata
+        // first; a crash before private persistence must fail closed, not adopt
+        // arbitrary private bytes or construct a replacement.
+        let pin = Pin {schema:PIN.into(),intent:digest,prepared:hash("monzero-bch-native-prepared-v1",&private)};
+        self.metadata.retain(&record_name(self.quote,"native-pin"),&serde_json::to_vec(&pin)?)?;
+        Journal::open(&self.snapshots)?.retain(&record_name(self.quote,"native-prepared"),&private)?;
+        self.recover_bch_native_funding()
+    }
+
+    /// Offline historical recovery; never calls a wallet or extends the quote.
+    /// Returns only the public summary, despite the legacy summary type's name.
+    pub fn recover_bch_native_funding(&self) -> Result<RelayedTransfer> {
+        Ok(summary(&self.load_bch_native_funding()?))
+    }
+    pub(super) fn load_bch_native_funding(&self) -> Result<PreparedNativeLock> {
+        let (intent,intent_bytes) = self.retained_native_intent()?;
+        let binding = hash(INTENT,&intent_bytes);
+        let bytes = Zeroizing::new(Journal::open(&self.snapshots)?.read(&record_name(self.quote,"native-prepared"))
+            .context("BCH native preparation has no retained result; reconcile without constructing again")?);
+        let digest = hash("monzero-bch-native-prepared-v1",&bytes);
+        let pin = Pin {schema:PIN.into(),intent:binding,prepared:digest};
+        let pin_bytes = serde_json::to_vec(&pin)?;
+        let slot = record_name(self.quote,"native-pin");
+        let existing = self.metadata.read(&slot).context("missing trusted BCH native preparation pin")?;
+        ensure!(existing == pin_bytes,"BCH native preparation differs from trusted pin");
+        let prepared = PreparedNativeLock::decode(&bytes,binding,self.policy.xmz_network)?;
+        ensure!(prepared.terms() == json!({"genesis":intent.genesis,"wallet":intent.wallet,
+            "destination":intent.destination,"amountAtoms":intent.amount.to_string(),"account":intent.account,
+            "priority":intent.priority,"lockTxid":null}) && prepared.summary().fee.atoms() <= intent.maximum_fee,
+            "BCH native preparation differs from retained terms or fee ceiling");
+        Ok(prepared)
+    }
+}
