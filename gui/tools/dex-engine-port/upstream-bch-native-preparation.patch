+use super::*;
+use agreement::execution::funding::native::NativeFundingSource;
+use crate::native_funding_rpc::relay::lock_checkpoint::tests::Fixture;
+use std::sync::atomic::Ordering;
+
+fn source(wallet: &XmzAddress) -> NativeFundingSource {
+    NativeFundingSource {wallet:wallet.clone(),account:0,priority:1}
+}
+fn copy_store(from: &PrivateStore) -> Result<PrivateStore> {
+    let to = PrivateStore::new()?;
+    for entry in std::fs::read_dir(&from.0)? {
+        let entry = entry?;
+        ensure!(entry.file_type()?.is_file(),"unexpected fixture directory entry");
+        std::fs::copy(entry.path(),to.0.join(entry.file_name()))?;
+    }
+    Ok(to)
+}
+pub(super) async fn exercise(native: &mut AdmittedExecution<'_>,setup: &Setup,
+    metadata: &PrivateStore,snapshots: &PrivateStore,rpc: &BchRpc,server: &Server) -> Result<()> {
+    let wallet = XmzAddress::parse(setup.policy.xmz_network,&setup.quote.terms()["xmzPayout"])?;
+    let destination = native.restore_agreement()?.owned().wallet().address().clone();
+    let mut fixture = Fixture::new(wallet.clone(),destination.clone(),setup.policy.xmz_genesis.clone(),101_000,900).await?;
+    let slot = |suffix: &str| format!("{}.bch-funding-native-{suffix}",setup.quote.terms()["swapId"]);
+    let intent = metadata.0.join(slot("intent"));
+    *fixture.preparation_intent.lock().unwrap() = Some(intent.clone());
+    assert!(native.recover_bch_native_funding().is_err());
+    fixture.balance_available.store(false,Ordering::SeqCst);
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,1024).await.is_err());
+    assert!(!intent.exists());
+    fixture.balance_available.store(true,Ordering::SeqCst);
+    server.state.lock().unwrap().observation_mode = 21;
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,1024).await.is_err());
+    assert!(!intent.exists());
+    server.state.lock().unwrap().observation_mode = 0;
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,2000).await.is_err());
+    assert!(!intent.exists());
+    assert!(!fixture.calls.lock().unwrap().iter().any(|v|v=="transfer" || v=="relay_tx"));
+
+    // Separate copies model a process losing a wallet's response before retaining
+    // its result. The restarted process must not construct a replacement.
+    let lost_metadata = copy_store(metadata)?;
+    let lost_snapshots = copy_store(snapshots)?;
+    let mut lost = AdmittedExecution::resume(&lost_metadata.0,&lost_snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    let mut lost_fixture = Fixture::new(wallet.clone(),destination,setup.policy.xmz_genesis.clone(),101_000,900).await?;
+    *lost_fixture.preparation_intent.lock().unwrap() = Some(lost_metadata.0.join(slot("intent")));
+    lost_fixture.lose_preparation_reply.store(true,Ordering::SeqCst);
+    assert!(lost.prepare_bch_native_funding(&mut lost_fixture.relay,rpc,source(&wallet),5,1024).await.is_err());
+    assert!(lost_metadata.0.join(slot("intent")).is_file());
+    assert!(!lost_snapshots.0.join(slot("prepared")).exists());
+    drop(lost);
+    let mut lost = AdmittedExecution::resume(&lost_metadata.0,&lost_snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    let before = lost_fixture.calls.lock().unwrap().len();
+    assert!(lost.prepare_bch_native_funding(&mut lost_fixture.relay_client()?,rpc,source(&wallet),5,1025).await.is_err());
+    assert!(lost.recover_bch_native_funding().is_err());
+    assert_eq!(lost_fixture.calls.lock().unwrap().len(),before);
+    assert_eq!(lost_fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="transfer").count(),1);
+    assert!(!lost_fixture.calls.lock().unwrap().iter().any(|v|v=="relay_tx"));
+
+    let prepared = native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,1024).await?;
+    assert_eq!(prepared.txid,"ab".repeat(32));
+    assert_eq!(prepared.fee.atoms(),900);
+    assert_eq!(prepared.weight,2000);
+    let before = fixture.calls.lock().unwrap().len();
+    let restored = native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,2000).await?;
+    assert_eq!(restored.txid,prepared.txid);
+    assert_eq!(restored.fee,prepared.fee);
+    let changed = NativeFundingSource {wallet:wallet.clone(),account:0,priority:2};
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,changed,5,1025).await.is_err());
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),6,1025).await.is_err());
+    assert!(native.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,1023).await.is_err());
+
+    let private_path = snapshots.0.join(slot("prepared"));
