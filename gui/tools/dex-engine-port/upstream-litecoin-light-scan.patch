+use super::*;
+use crate::litecoin_light::session::tests::{server,reply,regtest_handshake};
+use bitcoin::{bip32::Xpriv,NetworkKind};
+fn account(network:LtcNetwork)->PublicAccount {
+    PublicAccount::from_master(&Xpriv::new_master(NetworkKind::Test,&[1;32]).unwrap(),network,0).unwrap()
+}
+fn used()->Value {json!([{"tx_hash":"11".repeat(32),"height":1}])}
+#[tokio::test]
+async fn scan_covers_allocations_and_resets_gap_after_reported_use()->Result<()> {
+    let account=account(LtcNetwork::Regtest);
+    let mut responses=regtest_handshake();
+    // Existing allocations 0..3 must not be skipped despite leading empties.
+    for (i,value) in [json!([]),json!([]),json!([]),used(),json!([]),used(),json!([]),json!([])].into_iter().enumerate() {
+        responses.push(reply(i as u64+3,value));
+    }
+    let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let scan=session.scan_branch(&account,Branch::Receive,4,2,10,10).await?;
+    assert_eq!(scan.stop(),ScanStop::ReportedGap);assert_eq!(scan.scanned(),8);
+    assert_eq!(scan.reported().iter().map(|entry|entry.index()).collect::<Vec<_>>(),[3,5]);
+    assert_eq!(scan.reported()[0].history().len(),1);
+    drop(session);let requests=task.await?;
+    for index in 0..8 {
+        assert_eq!(requests[index+2]["params"],json!([script_hash(account.derive(Branch::Receive,index as u32)?.address().script_pubkey())]));
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn scan_address_budget_is_not_reported_as_gap()->Result<()> {
+    let mut responses=regtest_handshake();responses.push(reply(3,json!([])));responses.push(reply(4,json!([])));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let scan=session.scan_branch(&account(LtcNetwork::Regtest),Branch::Change,4,2,2,10).await?;
+    assert_eq!(scan.stop(),ScanStop::AddressBudget);assert_eq!(scan.scanned(),2);assert!(scan.reported().is_empty());
+    drop(session);assert_eq!(task.await?.len(),4);Ok(())
+}
+#[tokio::test]
+async fn scan_total_history_budget_does_not_silently_truncate()->Result<()> {
+    let mut responses=regtest_handshake();responses.push(reply(3,used()));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    assert!(session.scan_branch(&account(LtcNetwork::Regtest),Branch::Receive,0,2,10,1).await.is_err());
+    drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
+#[tokio::test]
+async fn scan_wrong_network_and_invalid_limits_send_no_queries()->Result<()> {
+    let (stream,task)=server(regtest_handshake());let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    assert!(session.scan_branch(&account(LtcNetwork::Testnet),Branch::Receive,0,2,10,10).await.is_err());
+    for (allocated,gap,addresses,entries) in [(10001,2,10,10),(0,0,10,10),(0,1001,10,10),(0,2,0,10),(0,2,10001,10),(0,2,10,0),(0,2,10,10001)] {
+        assert!(session.scan_branch(&account(LtcNetwork::Regtest),Branch::Receive,allocated,gap,addresses,entries).await.is_err());
+    }
+    drop(session);assert_eq!(task.await?.len(),2);Ok(())
+}
