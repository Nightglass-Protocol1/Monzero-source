+//! Bounded public-account discovery from untrusted history reports.
+//! A reported gap is only a stopping policy, not proof of wallet completeness.
+use super::*;
+use super::history::ReportedTransaction;
+use crate::litecoin_light::account::{Branch, PublicAccount};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ScanStop { ReportedGap, AddressBudget }
+pub struct ReportedAddressHistory {
+    index: u32,
+    history: Vec<ReportedTransaction>,
+}
+impl ReportedAddressHistory {
+    pub fn index(&self) -> u32 { self.index }
+    pub fn history(&self) -> &[ReportedTransaction] { &self.history }
+}
+pub struct BranchScan {
+    scanned: u32,
+    stop: ScanStop,
+    reported: Vec<ReportedAddressHistory>,
+}
+impl BranchScan {
+    pub fn scanned(&self) -> u32 { self.scanned }
+    pub fn stop(&self) -> ScanStop { self.stop }
+    pub fn reported(&self) -> &[ReportedAddressHistory] { &self.reported }
+}
+
+impl<S: AsyncRead + AsyncWrite + Unpin> ReadSession<S> {
+    /// Scan from index zero, covering allocated_count before counting a gap.
+    /// All limits are explicit. No index is allocated or persisted by scanning.
+    /// The peer learns related script hashes; results remain unverified hints.
+    /// Errors return no partial scan; budget exhaustion is explicitly marked.
+    pub async fn scan_branch(&mut self, account: &PublicAccount, branch: Branch,
+        allocated_count: u32, gap: u32, maximum_addresses: u32,
+        maximum_entries: usize) -> Result<BranchScan> {
+        ensure!(account.network()==self.network && allocated_count<=10_000
+            && (1..=1000).contains(&gap) && (1..=10_000).contains(&maximum_addresses)
+            && (1..=10_000).contains(&maximum_entries), "invalid Litecoin discovery request");
+        let mut reported = Vec::new();
+        let mut empty = 0;
+        let mut entries = 0;
+        for index in 0..maximum_addresses {
+            let address = account.derive(branch,index)?;
+            // Conservative total-memory bound. Exhaustion never becomes a gap.
+            let remaining = maximum_entries-entries;
+            ensure!(remaining>0, "Litecoin discovery history budget exhausted");
+            let history = self.reported_history(address.address().script_pubkey(), remaining.min(1000)).await?;
+            if history.is_empty() && index>=allocated_count { empty+=1; } else { empty=0; }
+            entries+=history.len();
+            if !history.is_empty() { reported.push(ReportedAddressHistory {index,history}); }
+            if empty==gap {
+                return Ok(BranchScan {scanned:index+1,stop:ScanStop::ReportedGap,reported});
+            }
+        }
+        Ok(BranchScan {scanned:maximum_addresses,stop:ScanStop::AddressBudget,reported})
+    }
+}
