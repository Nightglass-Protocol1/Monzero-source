+++ b/swap-machine/src/native_negotiation.rs
@@ -0,0 +1,101 @@
+//! Quote-bound authenticated negotiation. No transport, durable cursor or funding authority.
+use anyhow::{Result, ensure};
+use ed25519_dalek::{Signature, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use crate::{common, native_trade_quote::{DeploymentPolicy, VerifiedQuote}};
+
+const DOMAIN: &str = "monzero-native-negotiation-v1";
+const MAX_FRAME: usize = 1_048_576;
+
+#[derive(Clone, Serialize, Deserialize)]
+pub enum Message {
+    Bob0(common::Message0), Alice1(common::Message1), Bob2(common::Message2),
+    Alice3(common::Message3), Bob4(common::Message4),
+}
+impl Message {
+    fn sequence(&self) -> u8 {
+        match self { Self::Bob0(_) => 0, Self::Alice1(_) => 1,
+            Self::Bob2(_) => 2, Self::Alice3(_) => 3, Self::Bob4(_) => 4 }
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Frame {
+    schema: String, quote_commitment: String, swap_id: String, sequence: u8,
+    previous: String, message: Message,
+}
+
+/// Both sides consume all five authenticated frames, including their own.
+/// On engine rejection, abort: this cursor does not replace engine validation.
+/// Never restore/reset this in-memory object to authorize replay after a crash.
+pub struct Transcript {
+    commitment: String, swap_id: String, keys: [VerifyingKey; 2],
+    next: u8, previous: [u8; 32],
+}
+
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+fn canonical<T: Serialize>(value: &T) -> Result<Vec<u8>> {
+    Ok(serde_json::to_vec(&serde_json::to_value(value)?)?)
+}
+
+/// Separate domain from commercial quote signatures. Contains protocol view-key
+/// shares and must not be logged or published as a public order-book artifact.
+pub fn signing_bytes(frame: &[u8]) -> Result<Vec<u8>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX_FRAME, "invalid negotiation frame size");
+    let mut bytes = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:", DOMAIN.len(), DOMAIN, frame.len()).into_bytes();
+    bytes.extend_from_slice(frame);
+    Ok(bytes)
+}
+
+impl Transcript {
+    pub fn new(quote: &VerifiedQuote, policy: &DeploymentPolicy, now: u64) -> Result<Self> {
+        quote.check_deployment(policy, now)?;
+        let key = |field: &str| -> Result<VerifyingKey> {
+            let text = &quote.terms()[field];
+            let mut bytes = [0; 32];
+            for (i, byte) in bytes.iter_mut().enumerate() {
+                *byte = u8::from_str_radix(&text[i * 2..i * 2 + 2], 16)?;
+            }
+            Ok(VerifyingKey::from_bytes(&bytes)?)
+        };
+        Ok(Self { commitment: hex(quote.commitment()), swap_id: quote.terms()["swapId"].clone(),
+            keys: [key("btcFunder")?, key("xmzFunder")?], next: 0, previous: [0; 32] })
+    }
+
+    pub fn prepare(&self, message: Message) -> Result<Vec<u8>> {
+        ensure!(self.next < 5 && message.sequence() == self.next, "wrong negotiation sequence");
+        if let Message::Bob0(ref first) = message {
+            ensure!(first.swap_id.to_string() == self.swap_id, "wrong engine swap identity");
+        }
+        let bytes = canonical(&Frame { schema: DOMAIN.into(), quote_commitment: self.commitment.clone(),
+            swap_id: self.swap_id.clone(), sequence: self.next, previous: hex(&self.previous), message })?;
+        ensure!(bytes.len() <= MAX_FRAME, "oversized negotiation frame");
+        Ok(bytes)
+    }
+
+    /// Failure never advances the cursor. Success authenticates and orders the
+    /// message; the engine must still validate proofs, transactions and policy.
+    pub fn accept(&mut self, bytes: &[u8], signature: &[u8]) -> Result<Message> {
+        ensure!(self.next < 5 && !bytes.is_empty() && bytes.len() <= MAX_FRAME,
+            "invalid negotiation frame");
+        let frame: Frame = serde_json::from_slice(bytes)?;
+        ensure!(frame.schema == DOMAIN && frame.quote_commitment == self.commitment
+            && frame.swap_id == self.swap_id && frame.sequence == self.next
+            && frame.previous == hex(&self.previous), "wrong negotiation context");
+        // Rebuilding rejects duplicate/unknown nested fields and noncanonical encodings.
+        ensure!(self.prepare(frame.message.clone())? == bytes, "noncanonical negotiation frame");
+        self.keys[usize::from(self.next % 2)].verify_strict(&signing_bytes(bytes)?,
+            &Signature::from_slice(signature)?)?;
+        let mut hash = Sha256::new();
+        hash.update(DOMAIN.as_bytes()); hash.update([0]); hash.update(bytes); hash.update(signature);
+        self.previous = hash.finalize().into();
+        self.next += 1;
+        Ok(frame.message)
+    }
+
+    pub fn completed_commitment(&self) -> Option<[u8; 32]> {
+        (self.next == 5).then_some(self.previous)
+    }
+}
