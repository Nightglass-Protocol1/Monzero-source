@@ -0,0 +1,80 @@
+use super::*;
+use bitcoin::{absolute, consensus::serialize, hashes::Hash, transaction::Version,
+    Amount, PubkeyHash, Sequence, Transaction, TxIn, TxOut, Txid, Witness};
+use ecdsa_fun::{ECDSA, fun::{Point, Scalar}};
+fn public(key: &Scalar) -> Point { ECDSA::verify_only().verification_key_for(key) }
+fn terms(bch: &Scalar, native: &Scalar) -> RecoveryTerms {
+    RecoveryTerms { locked_atoms: 100_000, lock_fee_atoms: 1000, recovery_fee_atoms: 2000,
+        minimum_output_atoms: 546, cancel_delay_blocks: 2, punish_delay_blocks: 5,
+        bch_funder_signing_key: PublicKey::from_slice(&public(bch).to_bytes()).unwrap(),
+        native_funder_signing_key: PublicKey::from_slice(&public(native).to_bytes()).unwrap(),
+        bch_funder_refund: ScriptBuf::new_p2pkh(&PubkeyHash::from_byte_array([3;20])),
+        native_funder_payout: ScriptBuf::new_p2pkh(&PubkeyHash::from_byte_array([4;20])) }
+}
+
+#[test]
+fn success_refund_and_punishment_follow_bound_stages() -> Result<()> {
+    let bch = Scalar::random(&mut rand::thread_rng()); let native = Scalar::random(&mut rand::thread_rng());
+    // Separate adaptor encryption shares; linking them to XMZ needs cross-curve proofs.
+    let bch_share = Scalar::random(&mut rand::thread_rng()); let native_share = Scalar::random(&mut rand::thread_rng());
+    let plan = RecoveryPlan::new(terms(&bch, &native))?;
+    let funding = Transaction { version: Version::TWO, lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn { previous_output: OutPoint { txid: Txid::from_byte_array([9;32]), vout: 1 },
+            script_sig: ScriptBuf::new(), sequence: Sequence::MAX, witness: Witness::new() }],
+        output: vec![TxOut { value: Amount::from_sat(plan.terms().locked_atoms), script_pubkey: plan.lock().script_pubkey() }] };
+    let raw = serialize(&funding);
+    let spend = plan.lock_spend_terms(OutPoint { txid: funding.compute_txid(), vout: 0 });
+    let encrypted = plan.lock().data_message().encrypted_sign(&bch, &public(&native_share));
+    let signature = plan.lock().data_message().decrypt(&public(&bch), &native_share, encrypted.clone())?;
+    let success = plan.lock().prepare_redemption(&raw, &spend, &signature)?;
+    assert_eq!(success.output[0].script_pubkey, plan.terms().native_funder_payout);
+    assert_eq!(success.output[0].value.to_sat(), 99_000);
+    let extracted = plan.lock().redemption_signature(&raw, &spend, &serialize(&success))?;
+    assert_eq!(plan.lock().data_message().recover(&public(&bch), &public(&native_share), &encrypted, &extracted)?.to_bytes(), native_share.to_bytes());
+
+    // Alternative branch, not a claim that conflicting transactions can coexist.
+    let cancel = plan.lock().prepare_timeout(&raw, &spend)?;
+    plan.lock().verify_timeout(&raw, &spend, &serialize(&cancel))?;
+    assert_eq!(cancel.input[0].sequence, Sequence(2));
+    assert_eq!(cancel.output[0].script_pubkey, plan.recovery().script_pubkey());
+    assert_eq!(cancel.output[0].value.to_sat(), plan.recovery_atoms());
+    let recovery_spend = plan.recovery_spend_terms(OutPoint { txid: cancel.compute_txid(), vout: 0 });
+    let encrypted = plan.recovery().data_message().encrypted_sign(&native, &public(&bch_share));
+    let signature = plan.recovery().data_message().decrypt(&public(&native), &bch_share, encrypted.clone())?;
+    let refund = plan.recovery().prepare_redemption(&serialize(&cancel), &recovery_spend, &signature)?;
+    assert_eq!(refund.output[0].script_pubkey, plan.terms().bch_funder_refund);
+    assert_eq!(refund.output[0].value.to_sat(), plan.final_recovery_atoms());
+    let extracted = plan.recovery().redemption_signature(&serialize(&cancel), &recovery_spend, &serialize(&refund))?;
+    assert_eq!(plan.recovery().data_message().recover(&public(&native), &public(&bch_share), &encrypted, &extracted)?.to_bytes(), bch_share.to_bytes());
+    let punish = plan.recovery().prepare_timeout(&serialize(&cancel), &recovery_spend)?;
+    assert_eq!(punish.input[0].sequence, Sequence(5));
+    assert_eq!(punish.output[0].script_pubkey, plan.terms().native_funder_payout);
+    assert_eq!(punish.output[0].value.to_sat(), 97_000);
+    plan.recovery().verify_timeout(&serialize(&cancel), &recovery_spend, &serialize(&punish))?;
+    Ok(())
+}
+
+#[test]
+fn insufficient_recovery_budget_and_substituted_stage_are_rejected() -> Result<()> {
+    let bch = Scalar::random(&mut rand::thread_rng()); let native = Scalar::random(&mut rand::thread_rng());
+    let agreed = terms(&bch, &native); let plan = RecoveryPlan::new(agreed.clone())?;
+    plan.verify_scripts(plan.lock().redeem_script(), plan.recovery().redeem_script())?;
+    let mut changed = agreed.clone(); changed.punish_delay_blocks = 7;
+    let other = RecoveryPlan::new(changed)?;
+    assert!(plan.verify_scripts(other.lock().redeem_script(), plan.recovery().redeem_script()).is_err());
+    assert!(plan.verify_scripts(plan.lock().redeem_script(), other.recovery().redeem_script()).is_err());
+    for amount in [0, 999, 2999, 3545, 2_100_000_000_000_001, u64::MAX] {
+        let mut invalid = agreed.clone(); invalid.locked_atoms = amount;
+        assert!(RecoveryPlan::new(invalid).is_err());
+    }
+    let mut exact = agreed.clone(); exact.locked_atoms = 3546;
+    assert_eq!(RecoveryPlan::new(exact)?.final_recovery_atoms(), 546);
+    let mut invalid = agreed.clone(); invalid.native_funder_signing_key = invalid.bch_funder_signing_key;
+    assert!(RecoveryPlan::new(invalid).is_err());
+    let mut invalid = agreed.clone(); invalid.lock_fee_atoms = 0; assert!(RecoveryPlan::new(invalid).is_err());
+    let mut invalid = agreed.clone(); invalid.recovery_fee_atoms = 0; assert!(RecoveryPlan::new(invalid).is_err());
+    let mut invalid = agreed.clone(); invalid.cancel_delay_blocks = 0; assert!(RecoveryPlan::new(invalid).is_err());
+    let mut invalid = agreed.clone(); invalid.punish_delay_blocks = 0; assert!(RecoveryPlan::new(invalid).is_err());
+    let mut invalid = agreed; invalid.minimum_output_atoms = 0; assert!(RecoveryPlan::new(invalid).is_err());
+    Ok(())
+}
