+//! The two BCH covenant stages and their amount flow. This is not a negotiated
+//! swap: authentication, cross-curve key proofs, chain observation, durable
+//! ownership and protocol release conditions are still caller responsibilities.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{OutPoint, Script, ScriptBuf, secp256k1::PublicKey};
+use super::{covenant::{Covenant, CovenantTerms}, spend::SpendTerms};
+
+#[derive(Clone, Debug)]
+pub struct RecoveryTerms {
+    pub locked_atoms: u64,
+    pub lock_fee_atoms: u64,
+    pub recovery_fee_atoms: u64,
+    pub minimum_output_atoms: u64,
+    pub cancel_delay_blocks: u16,
+    pub punish_delay_blocks: u16,
+    pub bch_funder_signing_key: PublicKey,
+    pub native_funder_signing_key: PublicKey,
+    pub bch_funder_refund: ScriptBuf,
+    pub native_funder_payout: ScriptBuf,
+}
+
+/// Success sends BCH to the native funder. Cancellation forwards it into the
+/// recovery contract. Its signed branch refunds the BCH funder; its later
+/// timeout sends BCH to the native funder if the refund signature is withheld.
+pub struct RecoveryPlan {
+    terms: RecoveryTerms,
+    lock: Covenant,
+    recovery: Covenant,
+    recovery_atoms: u64,
+    final_recovery_atoms: u64,
+}
+
+impl RecoveryPlan {
+    pub fn new(terms: RecoveryTerms) -> Result<Self> {
+        ensure!(terms.locked_atoms <= 2_100_000_000_000_000 && terms.minimum_output_atoms > 0,
+            "invalid BCH recovery amount policy");
+        ensure!(terms.bch_funder_signing_key != terms.native_funder_signing_key,
+            "BCH recovery requires distinct participant signing keys");
+        let recovery_atoms = terms.locked_atoms.checked_sub(terms.lock_fee_atoms)
+            .context("BCH cancellation fee exceeds lock")?;
+        let final_recovery_atoms = recovery_atoms.checked_sub(terms.recovery_fee_atoms)
+            .context("BCH recovery fee exceeds cancellation output")?;
+        ensure!(final_recovery_atoms >= terms.minimum_output_atoms,
+            "BCH recovery proceeds below agreed minimum output");
+        let recovery = Covenant::new(CovenantTerms {
+            fee_atoms: terms.recovery_fee_atoms, delay_blocks: terms.punish_delay_blocks,
+            signing_key: terms.native_funder_signing_key,
+            redeem_destination: terms.bch_funder_refund.clone(),
+            timeout_destination: terms.native_funder_payout.clone(),
+        })?;
+        let lock = Covenant::new(CovenantTerms {
+            fee_atoms: terms.lock_fee_atoms, delay_blocks: terms.cancel_delay_blocks,
+            signing_key: terms.bch_funder_signing_key,
+            redeem_destination: terms.native_funder_payout.clone(),
+            timeout_destination: recovery.script_pubkey(),
+        })?;
+        Ok(Self { terms, lock, recovery, recovery_atoms, final_recovery_atoms })
+    }
+
+    pub fn terms(&self) -> &RecoveryTerms { &self.terms }
+    pub fn lock(&self) -> &Covenant { &self.lock }
+    pub fn recovery(&self) -> &Covenant { &self.recovery }
+    pub fn recovery_atoms(&self) -> u64 { self.recovery_atoms }
+    pub fn final_recovery_atoms(&self) -> u64 { self.final_recovery_atoms }
+
+    pub fn verify_scripts(&self, lock: &Script, recovery: &Script) -> Result<()> {
+        self.lock.verify_script(lock)?;
+        self.recovery.verify_script(recovery)
+    }
+
+    pub fn lock_spend_terms(&self, outpoint: OutPoint) -> SpendTerms {
+        SpendTerms { outpoint, locked_atoms: self.terms.locked_atoms,
+            maximum_fee_atoms: self.terms.lock_fee_atoms,
+            minimum_output_atoms: self.terms.minimum_output_atoms }
+    }
+
+    pub fn recovery_spend_terms(&self, outpoint: OutPoint) -> SpendTerms {
+        SpendTerms { outpoint, locked_atoms: self.recovery_atoms,
+            maximum_fee_atoms: self.terms.recovery_fee_atoms,
+            minimum_output_atoms: self.terms.minimum_output_atoms }
+    }
+}
+
