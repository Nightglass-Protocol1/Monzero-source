@@ -0,0 +1,116 @@
+//! Separate approval for the exact saved XMZ payment. A durable attempt precedes
+//! dispatch; an uncertain result never grants permission to send again.
+use super::*;
+use serde_json::Value;
+
+const REVIEW: &str = "monzero-bch-native-relay-review-v1";
+const ATTEMPT: &str = "monzero-bch-native-relay-intent-v1";
+const ACK: &str = "monzero-bch-native-relay-ack-v1";
+pub struct NativeRelayReview { pub details: Value, pub commitment: [u8;32] }
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub enum NativeRelayState {
+    /// An attempt may have stopped before dispatch. Observe/reconcile the exact
+    /// txid; neither an absent wallet entry nor this state permits retransmission.
+    Attempted { txid: String },
+    /// Wallet acknowledgement only, not chain confirmation or settlement proof.
+    Acknowledged { txid: String },
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt { schema: String, review: [u8;32], approved_at: u64 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack { schema: String, attempt: [u8;32], txid: String }
+
+impl AdmittedExecution<'_> {
+    fn native_relay_materials(&self) -> Result<(NativeRelayReview,Intent,PreparedNativeLock)> {
+        let (intent,bytes) = self.retained_native_intent()?;
+        let prepared = self.load_bch_native_funding()?;
+        let binding = hash(INTENT,&bytes);
+        let payment = prepared.summary();
+        let details = json!({"schema":REVIEW,"action":"broadcast-xmz-funding",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),
+            "admission":intent.admission,"fundingReceipt":intent.receipt,"bchDeployment":intent.deployment,
+            "preparation":binding,"preparedPayment":hash("monzero-bch-native-prepared-v1",&prepared.encode(binding)?),
+            "network":self.quote.terms()["xmzNetwork"],"genesis":intent.genesis,
+            "wallet":intent.wallet,"account":intent.account,"priority":intent.priority,
+            "destination":intent.destination,"amountAtoms":intent.amount.to_string(),
+            "feeAtoms":payment.fee.atom_string(),"maximumFeeAtoms":intent.maximum_fee.to_string(),
+            "weight":payment.weight,"txid":payment.txid,"expiresAt":self.quote.terms()["expiresAt"],
+            "minimumBchConfirmations":self.policy.bch_confirmations,"cancellationMarginBlocks":intent.safety_blocks});
+        let commitment = hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((NativeRelayReview {details,commitment},intent,prepared))
+    }
+
+    /// Read-only review, with no transaction key or relay metadata exposed.
+    /// The caller must obtain explicit user approval of this exact commitment.
+    pub fn review_bch_native_relay(&self,bch: &BchRpc,now: u64) -> Result<NativeRelayReview> {
+        self.quote.check_policy(self.policy,now)?;
+        let (review,intent,_) = self.native_relay_materials()?;
+        ensure!(now >= intent.admitted_at && bch.deployment_commitment()? == intent.deployment,
+            "native relay predates preparation or changes BCH observer");
+        Ok(review)
+    }
+
+    fn native_relay_attempt(&self,review: &NativeRelayReview,prepared_at: u64)
+        -> Result<Option<(Attempt,[u8;32])>> {
+        let Some(bytes) = optional(&self.metadata,&record_name(self.quote,"native-relay-intent"))? else {return Ok(None)};
+        ensure!(bytes.len() <= 4096,"oversized native relay intent");
+        let attempt: Attempt = serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema == ATTEMPT && attempt.review == review.commitment
+            && attempt.approved_at >= prepared_at && serde_json::to_vec(&attempt)? == bytes,
+            "native relay intent differs from approved payment");
+        self.quote.check_policy(self.policy,attempt.approved_at)?;
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+
+    /// Historical local dispatch status only; available after commercial expiry.
+    pub fn bch_native_relay_state(&self) -> Result<Option<NativeRelayState>> {
+        let (review,intent,prepared) = self.native_relay_materials()?;
+        let ack = optional(&self.metadata,&record_name(self.quote,"native-relay-ack"))?;
+        let Some((_,attempt)) = self.native_relay_attempt(&review,intent.admitted_at)? else {
+            ensure!(ack.is_none(),"native relay acknowledgement lacks original attempt");
+            return Ok(None)
+        };
+        let txid = prepared.summary().txid.clone();
+        let Some(bytes) = ack else {return Ok(Some(NativeRelayState::Attempted {txid}))};
+        ensure!(bytes.len() <= 4096,"oversized native relay acknowledgement");
+        let ack: Ack = serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema == ACK && ack.attempt == attempt && ack.txid == txid
+            && serde_json::to_vec(&ack)? == bytes,"native relay acknowledgement changed");
+        Ok(Some(NativeRelayState::Acknowledged {txid}))
+    }
+
+    /// Relay only the retained payment after exact approval and fresh chain and
+    /// wallet checks. Any unresolved attempt refuses automatic retransmission.
+    pub async fn relay_bch_native_funding(&mut self,native: &mut NativeTransferRelay,bch: &BchRpc,
+        approved: &[u8;32],now: u64) -> Result<RelayedTransfer> {
+        let started = std::time::Instant::now();
+        let review = self.review_bch_native_relay(bch,now)?;
+        ensure!(review.commitment == *approved,"native payment relay approval is stale or mismatched");
+        let (original,intent,prepared) = self.native_relay_materials()?;
+        ensure!(original.commitment == *approved,"native payment changed after review");
+        let expires = self.quote.terms()["expiresAt"].parse::<u64>()?;
+        let deadline = started.checked_add(std::time::Duration::from_secs(expires.checked_sub(now)
+            .context("native relay quote expired")?)).context("native relay deadline overflow")?;
+        if let Some((attempt,_)) = self.native_relay_attempt(&review,intent.admitted_at)? {
+            ensure!(now >= attempt.approved_at,"native relay time moved backwards");
+        }
+        match self.bch_native_relay_state()? {
+            Some(NativeRelayState::Acknowledged {..}) => return Ok(summary(&prepared)),
+            Some(NativeRelayState::Attempted {..}) => anyhow::bail!("native relay has an uncertain result; reconcile without retransmitting"),
+            None => (),
+        }
+        native.preflight_native_lock(&prepared).await?;
+        self.check_bch_lock_for_native_funding(bch,now,intent.safety_blocks).await?;
+        ensure!(std::time::Instant::now() < deadline,"native quote expired during relay preflight");
+        let attempt = Attempt {schema:ATTEMPT.into(),review:*approved,approved_at:now};
+        let bytes = serde_json::to_vec(&attempt)?;
+        self.metadata.retain(&record_name(self.quote,"native-relay-intent"),&bytes)?;
+        let result = native.dispatch_native_lock_until(&prepared,deadline).await?;
+        ensure!(result.txid == prepared.summary().txid,"native relay returned another payment");
+        let ack = Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid:result.txid.clone()};
+        self.metadata.retain(&record_name(self.quote,"native-relay-ack"),&serde_json::to_vec(&ack)?)?;
+        Ok(result)
+    }
+}
