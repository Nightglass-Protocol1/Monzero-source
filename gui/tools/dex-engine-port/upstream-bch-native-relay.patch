+use super::*;
+use agreement::execution::funding::native::relay::NativeRelayState;
+
+pub(super) async fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    rpc: &BchRpc,server: &Server,fixture: &Fixture) -> Result<()> {
+    let slot = |suffix: &str| format!("{}.bch-funding-native-relay-{suffix}",setup.quote.terms()["swapId"]);
+    // A prepared payment already owns its selected inputs; unrelated remaining
+    // wallet balance is not a reason to construct a replacement during relay.
+    fixture.balance_available.store(false,Ordering::SeqCst);
+    for lose_reply in [false,true] {
+        let metadata = copy_store(metadata)?;
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let mut client = fixture.relay_client()?;
+        let intent = metadata.0.join(slot("intent")); let ack = metadata.0.join(slot("ack"));
+        *fixture.relay_intent.lock().unwrap() = Some(intent.clone());
+        let before = fixture.calls.lock().unwrap().len();
+        let review = execution.review_bch_native_relay(rpc,1025)?;
+        assert_eq!(review.details["action"],"broadcast-xmz-funding");
+        assert_eq!(review.details["amountAtoms"],"101000");
+        assert_eq!(review.details["feeAtoms"],"900");
+        assert_eq!(review.details["txid"],"ab".repeat(32));
+        assert_eq!(review.details["cancellationMarginBlocks"],5);
+        assert!(review.details.get("tx_key").is_none() && review.details.get("metadata").is_none());
+        assert!(execution.bch_native_relay_state()?.is_none());
+        assert_eq!(fixture.calls.lock().unwrap().len(),before);
+        assert!(!intent.exists());
+        if !lose_reply {
+            assert!(execution.relay_bch_native_funding(&mut client,rpc,&[0;32],1025).await.is_err());
+            assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1023).await.is_err());
+            assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,2000).await.is_err());
+            assert_eq!(fixture.calls.lock().unwrap().len(),before);
+            for mode in [1,3,21,22] {
+                server.state.lock().unwrap().observation_mode = mode;
+                assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1025).await.is_err());
+                assert!(!intent.exists() && !ack.exists());
+            }
+            server.state.lock().unwrap().observation_mode = 0;
+        }
+        let relays = fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="relay_tx").count();
+        fixture.lose_reply.store(lose_reply,Ordering::SeqCst);
+        let result = execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1025).await;
+        assert!(intent.is_file());
+        let expected = if lose_reply {
+            assert!(result.is_err()); assert!(!ack.exists());
+            NativeRelayState::Attempted {txid:"ab".repeat(32)}
+        } else {
+            assert_eq!(result?.txid,"ab".repeat(32)); assert!(ack.is_file());
+            NativeRelayState::Acknowledged {txid:"ab".repeat(32)}
+        };
+        assert_eq!(execution.bch_native_relay_state()?,Some(expected.clone()));
+        drop(execution);
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        assert_eq!(execution.bch_native_relay_state()?,Some(expected));
+        let after = fixture.calls.lock().unwrap().len();
+        let repeated = execution.relay_bch_native_funding(&mut fixture.relay_client()?,rpc,&review.commitment,1026).await;
+        if lose_reply {assert!(repeated.is_err());} else {assert_eq!(repeated?.txid,"ab".repeat(32));}
+        assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,2000).await.is_err());
+        assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1024).await.is_err());
+        if !lose_reply {
+            let saved = std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;
+            assert!(execution.bch_native_relay_state().is_err());
+            assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1026).await.is_err());
+            std::fs::write(&ack,saved)?;
+            std::fs::rename(&intent,metadata.0.join("saved-native-relay-intent"))?;
+            assert!(execution.bch_native_relay_state().is_err());
+            assert!(execution.relay_bch_native_funding(&mut client,rpc,&review.commitment,1026).await.is_err());
+            std::fs::rename(metadata.0.join("saved-native-relay-intent"),&intent)?;
+        }
+        assert_eq!(fixture.calls.lock().unwrap().len(),after);
+        assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="relay_tx").count(),relays+1);
+        assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="transfer").count(),1);
+    }
+    Ok(())
+}
