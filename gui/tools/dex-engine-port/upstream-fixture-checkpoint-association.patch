+#[test]
+fn association_rejects_loss_substitution_and_unknown_fields() -> Result<()> {
+    let expected=Some(Association {quote:[1;32],transcript:[2;32]});
+    let bytes=serde_json::to_vec(&expected)?;
+    check_association(&expected,&serde_json::from_slice(&bytes)?)?;
+    ensure!(check_association(&expected,&None).is_err(),"accepted association downgrade");
+    ensure!(check_association(&None,&expected).is_err(),"accepted unrequested association");
+    for changed in [Association {quote:[3;32],transcript:[2;32]},Association {quote:[1;32],transcript:[3;32]}] {
+        ensure!(check_association(&expected,&Some(changed)).is_err(),"accepted altered association");
+    }
+    let mut extra=serde_json::to_value(expected)?; extra["unknown"]=true.into();
+    ensure!(serde_json::from_value::<Association>(extra).is_err(),"accepted unknown association field");
+    Ok(())
+}
