+//! BIP39 recovery material, separate from legacy raw BIP32 seeds.
+//! No implicit conversion, persistence, networking or mnemonic logging.
+use super::*;
+use bip39::{Language, Mnemonic};
+
+/// Deliberately neither Debug, Clone nor Serialize. The dependency's zeroize
+/// feature erases its word indices on drop; callers must erase their copies.
+pub struct MnemonicMaterial(Mnemonic);
+impl MnemonicMaterial {
+    pub const ENCODING: &'static str = "bip39-english-v1";
+
+    /// New wallets use 256 bits of OS entropy and 24 English recovery words.
+    pub fn generate() -> Result<Self> {
+        let mut entropy = Zeroizing::new([0u8; 32]);
+        OsRng.try_fill_bytes(&mut *entropy).context("mnemonic entropy unavailable")?;
+        Self::from_entropy(&*entropy)
+    }
+
+    pub fn from_entropy(entropy: &[u8]) -> Result<Self> {
+        Mnemonic::from_entropy_in(Language::English, entropy)
+            .map(Self).map_err(|_| anyhow::anyhow!("invalid BIP39 entropy length"))
+    }
+
+    /// Import validates the word list, permitted count and checksum. Never
+    /// include a parser error or user-supplied phrase in diagnostics.
+    pub fn parse(phrase: &str) -> Result<Self> {
+        ensure!(!phrase.is_empty() && phrase.len() <= 1024, "invalid mnemonic size");
+        Mnemonic::parse_in(Language::English, phrase)
+            .map(Self).map_err(|_| anyhow::anyhow!("invalid English BIP39 recovery phrase"))
+    }
+
+    pub fn word_count(&self) -> usize { self.0.word_count() }
+
+    /// Explicit private reveal only; never insert this string in public status.
+    pub fn reveal(&self) -> Zeroizing<String> {
+        use std::fmt::Write;
+        let mut phrase = Zeroizing::new(String::with_capacity(256));
+        for (i, word) in self.0.words().enumerate() {
+            if i != 0 { phrase.push(' '); }
+            // String formatting cannot fail, and the capacity bounds all English words.
+            write!(&mut *phrase, "{word}").expect("writing a mnemonic word to String");
+        }
+        phrase
+    }
+
+    /// The optional BIP39 passphrase is distinct from the local vault password.
+    /// NFKD normalization and all 64 derived bytes are retained. Different
+    /// passphrases intentionally derive different wallets; none is a checksum.
+    pub fn derive_seed(&self, passphrase: &str) -> Result<Zeroizing<[u8; 64]>> {
+        ensure!(passphrase.len() <= 1024, "BIP39 passphrase exceeds supported limit");
+        Ok(Zeroizing::new(self.0.to_seed(passphrase)))
+    }
+
+    pub fn public_account(&self, network: impl Into<LightNetwork>, index: u32,
+                          passphrase: &str) -> Result<PublicAccount> {
+        let network = network.into();
+        let seed = self.derive_seed(passphrase)?;
+        let mut master = Xpriv::new_master(network.network_kind(), &*seed)?;
+        let account = PublicAccount::from_master(&master, network, index);
+        master.private_key.non_secure_erase();master.chain_code = [0u8; 32].into();
+        account
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::hashes::hex::FromHex;
+    use crate::litecoin_light::{account::Branch, network::{BtcNetwork, BchNetwork, DogeNetwork}};
+
+    #[test]
+    fn official_english_vectors_match_phrase_seed_and_master_key() -> Result<()> {
+        let vectors: Vec<Vec<String>> = serde_json::from_str(include_str!("mnemonic/english-vectors.json"))?;
+        assert_eq!(vectors.len(), 24);
+        for row in vectors {
+            let entropy = Vec::<u8>::from_hex(&row[0])?;
+            let material = MnemonicMaterial::from_entropy(&entropy)?;
+            assert_eq!(&*material.reveal(), &row[1]);
+            let parsed = MnemonicMaterial::parse(&row[1])?;
+            let seed = parsed.derive_seed("TREZOR")?;
+            assert_eq!(seed.as_slice(), Vec::<u8>::from_hex(&row[2])?);
+            assert_eq!(Xpriv::new_master(bitcoin::NetworkKind::Main, &*seed)?.to_string(), row[3]);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn checksum_counts_normalization_and_passphrase_are_enforced() -> Result<()> {
+        let material = MnemonicMaterial::from_entropy(&[0;32])?;
+        assert_eq!(material.word_count(), 24);
+        for invalid in ["", "abandon", "abandon ".repeat(12).as_str(), "xyzzy ".repeat(24).as_str(),
+                        "07".repeat(32).as_str()] {
+            assert!(MnemonicMaterial::parse(invalid).is_err());
+        }
+        assert_eq!(*material.derive_seed("caf\u{00e9}")?, *material.derive_seed("cafe\u{0301}")?);
+        assert_ne!(*material.derive_seed("")?, *material.derive_seed("TREZOR")?);
+        assert!(material.derive_seed(&"x".repeat(1025)).is_err());
+        for size in [16,20,24,28,32] {
+            let imported=MnemonicMaterial::from_entropy(&vec![1;size])?;
+            assert_eq!(MnemonicMaterial::parse(&imported.reveal())?.word_count(),size*3/4);
+        }
+        assert_eq!(MnemonicMaterial::generate()?.word_count(),24);
+        Ok(())
+    }
+
+    #[test]
+    fn recovery_preserves_each_chain_account_without_raw_seed_reinterpretation() -> Result<()> {
+        let material=MnemonicMaterial::from_entropy(&[7;32])?;
+        let imported=MnemonicMaterial::parse(&material.reveal())?;
+        let legacy=SecretSeed::from_bytes(Zeroizing::new([7;32]));
+        for network in [LightNetwork::Litecoin(LtcNetwork::Regtest), LightNetwork::Bitcoin(BtcNetwork::Regtest),
+            LightNetwork::BitcoinCash(BchNetwork::Regtest), LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+            let account=material.public_account(network,3,"")?;
+            let recovered=imported.public_account(network,3,"")?;
+            assert_eq!(serde_json::to_vec(&account.descriptor())?,serde_json::to_vec(&recovered.descriptor())?);
+            assert_eq!(account.derive(Branch::Receive,17)?.address(),recovered.derive(Branch::Receive,17)?.address());
+            assert_ne!(account.derive(Branch::Receive,17)?.address(),legacy.public_account(network,3)?.derive(Branch::Receive,17)?.address());
+        }
+        Ok(())
+    }
+}
