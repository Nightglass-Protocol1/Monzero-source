+//! Versioned local mnemonic storage. Never adopts or converts a legacy vault.
+//! Public callers must explicitly select this format; desktop activation is separate.
+use super::*;
+use std::path::Path;
+use crate::litecoin_rpc::reservation::Journal;
+// Share the retained filename so neither format can shadow the other.
+const RECORD: &str = super::super::NAME;
+const MAGIC: &[u8;8] = b"MZMNEM01";
+const HEADER: usize = 128;
+const MAX_PAYLOAD: usize = 1 + 32 + 2 + 1024;
+
+pub struct MnemonicVault {
+    journal: Journal,
+    network: LightNetwork,
+    wallet: Uuid,
+    bytes: Vec<u8>,
+}
+/// Neither Debug nor serializable. The passphrase and mnemonic are both private.
+pub struct UnlockedMnemonic {
+    material: MnemonicMaterial,
+    passphrase: Zeroizing<String>,
+}
+impl UnlockedMnemonic {
+    pub fn material(&self) -> &MnemonicMaterial { &self.material }
+    pub fn passphrase(&self) -> &str { &self.passphrase }
+    pub fn public_account(&self, network: impl Into<LightNetwork>, index: u32) -> Result<PublicAccount> {
+        self.material.public_account(network,index,&self.passphrase)
+    }
+}
+impl MnemonicVault {
+    pub fn create(directory: &Path, network: impl Into<LightNetwork>, wallet: Uuid,
+                  password: &[u8], material: &MnemonicMaterial, passphrase: &str) -> Result<Self> {
+        let network=network.into();
+        ensure!(!wallet.is_nil() && passphrase.len()<=1024,"invalid mnemonic vault context");
+        let journal=Journal::open(directory)?;
+        // An explicit new format must never silently shadow an existing raw wallet.
+        match journal.read(RECORD) {
+                Err(error) if error.downcast_ref::<std::io::Error>()
+                    .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{},
+                Err(error)=>return Err(error),
+                Ok(_)=>anyhow::bail!("wallet vault already exists"),
+        }
+        let entropy=Zeroizing::new(material.0.to_entropy());
+        let mut payload=Zeroizing::new(Vec::with_capacity(MAX_PAYLOAD+16));
+        payload.push(entropy.len() as u8);payload.extend_from_slice(&entropy);
+        payload.extend_from_slice(&(passphrase.len() as u16).to_be_bytes());
+        payload.extend_from_slice(passphrase.as_bytes());
+        let mut salt=[0u8;16];let mut nonce=[0u8;24];
+        OsRng.try_fill_bytes(&mut salt).context("mnemonic vault entropy unavailable")?;
+        OsRng.try_fill_bytes(&mut nonce).context("mnemonic vault entropy unavailable")?;
+        let mut bytes=Vec::with_capacity(HEADER+payload.len()+16);
+        bytes.extend_from_slice(MAGIC);bytes.extend_from_slice(network.storage_identity().as_bytes());
+        bytes.extend_from_slice(wallet.as_bytes());bytes.extend_from_slice(&salt);bytes.extend_from_slice(&nonce);
+        let key=super::super::key(password,&salt)?;
+        let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid mnemonic vault key"))?;
+        cipher.encrypt_in_place(XNonce::from_slice(&nonce),&bytes,&mut *payload)
+            .map_err(|_|anyhow::anyhow!("mnemonic vault encryption failed"))?;
+        bytes.extend_from_slice(&payload);
+        journal.retain(RECORD,&bytes)?;
+        Ok(Self {journal,network,wallet,bytes})
+    }
+
+    pub fn open(directory: &Path, network: impl Into<LightNetwork>, wallet: Uuid) -> Result<Self> {
+        let network=network.into();let journal=Journal::open(directory)?;
+        let bytes=journal.read(RECORD)?;check(&bytes,network,wallet)?;
+        journal.retain(RECORD,&bytes)?;
+        Ok(Self {journal,network,wallet,bytes})
+    }
+
+    pub fn unlock(&self,password:&[u8])->Result<UnlockedMnemonic> {
+        ensure!(self.journal.read(RECORD)?==self.bytes,"mnemonic vault changed; reopen required");
+        check(&self.bytes,self.network,self.wallet)?;
+        let key=super::super::key(password,&self.bytes[88..104])?;
+        let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid mnemonic vault key"))?;
+        let mut payload=Zeroizing::new(self.bytes[HEADER..].to_vec());
+        cipher.decrypt_in_place(XNonce::from_slice(&self.bytes[104..128]),&self.bytes[..HEADER],&mut *payload)
+            .map_err(|_|anyhow::anyhow!("mnemonic vault authentication failed"))?;
+        ensure!(!payload.is_empty(),"empty mnemonic payload");
+        let length=usize::from(payload[0]);
+        ensure!([16,20,24,28,32].contains(&length) && payload.len()>=length+3,"invalid mnemonic entropy record");
+        let pass_length=usize::from(u16::from_be_bytes(payload[length+1..length+3].try_into()?));
+        ensure!(pass_length<=1024 && payload.len()==length+3+pass_length,"invalid mnemonic passphrase record");
+        let material=MnemonicMaterial::from_entropy(&payload[1..length+1])?;
+        let passphrase=Zeroizing::new(std::str::from_utf8(&payload[length+3..])
+            .map_err(|_|anyhow::anyhow!("invalid mnemonic passphrase encoding"))?.to_owned());
+        Ok(UnlockedMnemonic {material,passphrase})
+    }
+}
+fn check(bytes:&[u8],network:LightNetwork,wallet:Uuid)->Result<()> {
+    ensure!(!wallet.is_nil() && bytes.len()>=HEADER+19+16 && bytes.len()<=HEADER+MAX_PAYLOAD+16
+        && &bytes[..8]==MAGIC && &bytes[8..72]==network.storage_identity().as_bytes()
+        && &bytes[72..88]==wallet.as_bytes(),"invalid mnemonic vault format or context");
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct Directory(std::path::PathBuf);
+    impl Drop for Directory {fn drop(&mut self) {let _=std::fs::remove_dir_all(&self.0);}}
+    #[test]
+    fn encrypted_mnemonic_reopens_without_changing_keys_or_accepting_legacy_format()->Result<()> {
+        use crate::litecoin_light::network::{BtcNetwork,BchNetwork,DogeNetwork};
+        for (network,length) in [(LightNetwork::Litecoin(LtcNetwork::Regtest),16),
+            (LightNetwork::Bitcoin(BtcNetwork::Regtest),20),(LightNetwork::BitcoinCash(BchNetwork::Regtest),24),
+            (LightNetwork::Dogecoin(DogeNetwork::Regtest),32)] {
+        let temp=Directory(std::env::temp_dir().join(format!("monzero-mnemonic-{}",Uuid::new_v4())));
+        std::fs::create_dir(&temp.0)?;
+        #[cfg(unix)] {use std::os::unix::fs::PermissionsExt;std::fs::set_permissions(&temp.0,std::fs::Permissions::from_mode(0o700))?;}
+        let wallet=Uuid::new_v4();
+        let material=MnemonicMaterial::from_entropy(&vec![7;length])?;let password=b"disposable encryption password";
+        let vault=MnemonicVault::create(&temp.0,network,wallet,password,&material,"test passphrase")?;
+        let expected=material.public_account(network,0,"test passphrase")?;
+        let unlocked=vault.unlock(password)?;
+        assert_eq!(serde_json::to_vec(&expected.descriptor())?,serde_json::to_vec(&unlocked.public_account(network,0)?.descriptor())?);
+        assert_eq!(&*unlocked.material().reveal(),&*material.reveal());assert_eq!(unlocked.passphrase(),"test passphrase");
+        assert!(vault.unlock(b"wrong").is_err());
+        let ciphertext=std::fs::read(temp.0.join(RECORD))?;
+        assert!(!ciphertext.windows(15).any(|b|b==b"test passphrase"));
+        drop(vault);
+        assert!(MnemonicVault::open(&temp.0,network,Uuid::new_v4()).is_err());
+        assert!(SeedVault::open(&temp.0,network,wallet).is_err());
+        assert!(MnemonicVault::create(&temp.0,network,wallet,password,&material,"").is_err());
+        let reopened=MnemonicVault::open(&temp.0,network,wallet)?;
+        assert_eq!(&*reopened.unlock(password)?.material().reveal(),&*material.reveal());
+        assert_eq!(std::fs::read(temp.0.join(RECORD))?,ciphertext);
+        drop(reopened);
+        let raw=SecretSeed::from_bytes(Zeroizing::new([7;32]));
+        assert!(SeedVault::create(&temp.0,network,wallet,password,&raw).is_err());
+        assert_eq!(std::fs::read(temp.0.join(RECORD))?,ciphertext);
+        }
+        Ok(())
+    }
+}
