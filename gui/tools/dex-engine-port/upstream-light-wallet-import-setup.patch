diff --git a/swap-machine/src/litecoin_light/vault/setup/import_tests.rs b/swap-machine/src/litecoin_light/vault/setup/import_tests.rs
new file mode 100644
--- /dev/null
+++ b/swap-machine/src/litecoin_light/vault/setup/import_tests.rs
@@ -0,0 +1,72 @@
+use super::*;
+use crate::litecoin_light::network::{BtcNetwork,BchNetwork,DogeNetwork};
+fn networks()->[LightNetwork;4] {[
+    LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+    LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)]}
+
+#[test]
+fn imported_setup_resumes_every_publication_without_replacing_keys()->Result<()> {
+    let material=MnemonicMaterial::from_entropy(&[19;16])?;
+    let different=MnemonicMaterial::from_entropy(&[20;16])?;
+    let passphrase="public import fixture passphrase";
+    for network in networks() {
+        for stage in [Publication::Intent,Publication::Vault,Publication::Addresses,Publication::Backup] {
+            let f=Fixture::new()?;
+            assert!(initialize_mode(&f.setup,&f.paths,network,f.wallet,7,PASSWORD,
+                SeedSource::ImportedMnemonic(&material,passphrase),|at| {
+                    if at==stage {anyhow::bail!("interrupted import")}Ok(())
+                }).is_err());
+            let original=fs::read(f.setup.join(INTENT))?;
+            assert!(!f.setup.join(COMPLETE).exists());
+            assert!(initialize_mnemonic(&f.setup,&f.paths,network,f.wallet,7,PASSWORD).is_err());
+            assert!(initialize_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,7,PASSWORD,&different,passphrase).is_err());
+            assert!(initialize_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,7,PASSWORD,&material,"wrong passphrase").is_err());
+            assert!(initialize_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,7,b"wrong password",&material,passphrase).is_err());
+            assert_eq!(fs::read(f.setup.join(INTENT))?,original);
+            assert!(!f.setup.join(COMPLETE).exists());
+            let ready=initialize_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,7,PASSWORD,&material,passphrase)?;
+            let expected=material.public_account(network,7,passphrase)?;
+            assert_eq!(serde_json::to_vec(&ready.account().descriptor())?,serde_json::to_vec(&expected.descriptor())?);
+            assert_eq!(ready.backup().allocated(),[0,0]);
+            let digest=ready.backup().digest();
+            assert_eq!(initialize_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,7,PASSWORD,&material,passphrase)?.backup().digest(),digest);
+            assert_eq!(fs::read(f.setup.join(INTENT))?,original);
+            let vault=MnemonicVault::open(&f.paths.vault,network,f.wallet)?;
+            let unlocked=vault.unlock_for_account(PASSWORD,&expected.descriptor())?;
+            assert_eq!(&*unlocked.material().reveal(),&*material.reveal());
+            assert_eq!(unlocked.passphrase(),passphrase);
+            for path in [&f.setup,&f.paths.vault,&f.paths.backup,&f.paths.addresses] {
+                for entry in fs::read_dir(path)? {
+                    let bytes=fs::read(entry?.path())?;
+                    for secret in [material.reveal().as_bytes(),passphrase.as_bytes()] {
+                        assert!(!bytes.windows(secret.len()).any(|window|window==secret));
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn imported_configuration_stays_pending_and_cannot_be_adopted_as_new_wallet()->Result<()> {
+    use configuration::{ConfigurationOptions,initialize_configured_imported_mnemonic,initialize_configured_mnemonic};
+    let material=MnemonicMaterial::from_entropy(&[21;32])?;
+    for network in networks() {
+        let f=Fixture::new()?;
+        for name in ["cache","spends"] {let path=f.root.join(name);fs::create_dir(&path)?;fs::set_permissions(path,fs::Permissions::from_mode(0o700))?;}
+        let options=ConfigurationOptions {cache:f.root.join("cache"),spends:f.root.join("spends"),maximum_height:1000,endpoint:None};
+        let ready=initialize_configured_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,2,PASSWORD,&options,&material,"")?;
+        let bytes=fs::read(ready.configuration_path())?;
+        let config:serde_json::Value=serde_json::from_slice(&bytes)?;
+        assert_eq!(config["schema"],format!("monzero-private-{}-light-recovery-pending-v1",network.tag()));
+        assert_eq!(config["recovery"]["status"],"discovery-required");
+        assert_eq!(config["recovery"]["activeSwapRecovery"],false);
+        assert_eq!(config["recovery"]["addressRecordsRestored"],false);
+        assert!(initialize_configured_mnemonic(&f.setup,&f.paths,network,f.wallet,2,PASSWORD,&options).is_err());
+        let retry=initialize_configured_imported_mnemonic(&f.setup,&f.paths,network,f.wallet,2,PASSWORD,&options,&material,"")?;
+        assert_eq!(retry.configuration_digest(),ready.configuration_digest());
+        assert_eq!(fs::read(ready.configuration_path())?,bytes);
+    }
+    Ok(())
+}
