@@ -0,0 +1,49 @@
+use super::*;
+use bitcoin::{consensus::{deserialize,serialize},Transaction};
+
+pub(super) fn exercise(bch: &mut AdmittedExecution<'_>,native: &mut AdmittedExecution<'_>,
+    setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,frame: &[u8]) -> Result<()> {
+    assert!(bch.retain_bch_redemption(2035).is_err());
+    assert!(bch.retained_bch_redemption().is_err());
+    assert!(native.retained_bch_redemption()?.is_none());
+    assert!(native.retain_bch_redemption(2032).is_err());
+    let prepared = native.retain_bch_redemption(2035)?;
+    assert_eq!(prepared.prepared_at(),2035);
+    assert_eq!(native.retain_bch_redemption(2036)?.commitment(),prepared.commitment());
+    assert!(native.retain_bch_redemption(2034).is_err());
+    let slot = format!("{}.bch-private-redemption",setup.quote.terms()["swapId"]);
+    let private = snapshots.0.join(&slot);
+    let bytes = zeroize::Zeroizing::new(std::fs::read(&private)?);
+    let record: Value = serde_json::from_slice(&bytes)?;
+    let raw: Vec<u8> = serde_json::from_value(record["transaction"].clone())?;
+    let transaction: Transaction = deserialize(&raw)?;
+    assert_eq!(transaction.compute_txid(),prepared.txid());
+    let funding = native.received_bch_funding_message()?.unwrap();
+    let plan = setup.quote.recovery_plan();let terms = plan.lock_spend_terms(funding.signed().lock_outpoint());
+    plan.lock().redemption_signature(&serialize(funding.signed().transaction()),&terms,&raw)?;
+    // Actual redemption reveals the native share needed by the BCH funder.
+    let message: Value = serde_json::from_slice(frame)?;
+    let encrypted = serde_json::from_value(message["encrypted"].clone())?;
+    let recovered = bch.restore_agreement()?.owned().recover_spend_key(&setup.quote,
+        &serialize(funding.signed().transaction()),funding.signed().lock_outpoint(),&raw,&encrypted)?;
+    let combined = setup.spend[0] + setup.spend[1];
+    assert_eq!(recovered.as_bytes(),combined.as_bytes());
+    let copied = copy_store(metadata)?;
+    let restored = AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    assert_eq!(restored.retained_bch_redemption()?.unwrap().txid(),prepared.txid());
+    std::fs::write(&private,b"{}")?;
+    assert!(native.retained_bch_redemption().is_err());
+    assert!(native.retain_bch_redemption(2036).is_err());
+    std::fs::write(&private,&*bytes)?;
+    let saved = snapshots.0.join("saved-private-redemption");std::fs::rename(&private,&saved)?;
+    assert!(native.retained_bch_redemption().is_err());
+    assert!(native.retain_bch_redemption(2036).is_err());
+    std::fs::rename(&saved,&private)?;
+    let pin = metadata.0.join(format!("{slot}-pin"));let saved_pin = metadata.0.join("saved-redemption-pin");
+    std::fs::rename(&pin,&saved_pin)?;
+    assert!(native.retained_bch_redemption().is_err());
+    assert!(native.retain_bch_redemption(2036).is_err());
+    std::fs::rename(&saved_pin,&pin)?;
+    assert_eq!(native.retained_bch_redemption()?.unwrap().commitment(),prepared.commitment());
+    Ok(())
+}
