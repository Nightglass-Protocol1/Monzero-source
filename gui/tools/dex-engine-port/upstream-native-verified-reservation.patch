index a12d0124a..db0b9a200 100644
--- a/swap-machine/src/native_quote_reservation.rs
+++ b/swap-machine/src/native_quote_reservation.rs
@@ -3,6 +3,23 @@ use anyhow::{Result, ensure};
 use std::path::Path;
 use uuid::Uuid;
 
+/// Read and validate commercial terms against trusted caller expectations.
+/// This is not a successful-approval acknowledgement, replay claim or funding
+/// permit. Recovery must not use this fresh-quote entry point.
+pub fn read_verified_quote(
+    directory: &Path, quote_id: Uuid, swap_id: Uuid, expected_commitment: &[u8; 32],
+    now: u64, btc_key: &[u8; 32], xmz_key: &[u8; 32],
+    btc_network: bitcoin::Network, xmz_network: swap_core::xmz_address::XmzNetwork,
+    policy: &crate::native_trade_quote::DeploymentPolicy,
+) -> Result<crate::native_trade_quote::VerifiedQuote> {
+    let bytes = read_record_bytes(directory, quote_id, swap_id)?;
+    let quote = crate::native_trade_quote::VerifiedQuote::from_gui_reservation(
+        &bytes, now, btc_key, xmz_key, btc_network, xmz_network)?;
+    ensure!(quote.commitment() == expected_commitment, "unexpected reservation commitment");
+    quote.check_deployment(policy, now)?;
+    Ok(quote)
+}
+
 /// The directory and its ancestors must be exclusively controlled by the caller.
 /// Returned bytes still require signature, deployment and freshness validation.
 /// No record is repaired, consumed or removed; a previous failed GUI fsync can
