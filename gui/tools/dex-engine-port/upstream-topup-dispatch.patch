@@ -0,0 +1,41 @@
+//! Orchestrates the buyer's top-up dispatch leg of the delayed-top-up
+//! candidate (see `DEX_BUYER_RESERVE_CANDIDATE.md`): given a confirmed,
+//! address-bound Bitcoin redemption outcome (`topup_journal::authorize_
+//! recovered_destination`, itself fed by `bob::State4::watch_for_redeem_
+//! btc_confirmed`), durably reserve then relay the buyer's own payment to
+//! the recovered swap destination. Mirrors `spendable.rs`'s
+//! journal -> prepare -> record_prepared -> relay_prepared -> record_relay
+//! sequence, but the buyer's wallet is the caller's own already-open
+//! wallet: no restore or lock-transaction import happens here, unlike the
+//! seller-side recovery spend.
+use super::relay::{NativeTransferRelay, RelayRequest, RelayedTransfer};
+use super::topup_journal::{TopUpJournal, TopUpRequest};
+use super::NativeFundingRpc;
+use anyhow::Result;
+use std::path::Path;
+
+pub struct TopUpOutcome {
+    pub transfer: RelayedTransfer,
+    pub receipt_persisted: bool,
+}
+
+/// Caller must have already called `topup_journal::authorize_recovered_
+/// destination` against this exact `request` -- this function does not
+/// re-derive or check the recovered swap key itself, only dispatches the
+/// already-approved payment. Caller also exclusively owns the wallet-rpc
+/// service across this call and that `request.buyer_wallet` is presently
+/// open there; neither is verified beyond `NativeTransferRelay`'s own
+/// preflight wallet-identity check.
+pub async fn dispatch_topup(client: NativeFundingRpc, journal_directory: &Path,
+    expected_genesis: &str, request: TopUpRequest) -> Result<TopUpOutcome> {
+    let journal = TopUpJournal::reserve(journal_directory, expected_genesis, &request)?;
+    let mut relay = NativeTransferRelay::new(client);
+    let transfer_request = RelayRequest { wallet: request.buyer_wallet.clone(),
+        destination: request.destination.clone(), amount: request.reserve,
+        account: request.account, priority: request.priority };
+    let prepared = relay.prepare(transfer_request, expected_genesis, request.maximum_fee).await?;
+    journal.record_prepared(&prepared)?;
+    let transfer = relay.relay_prepared(prepared).await?;
+    let receipt_persisted = journal.record_relay(&transfer).is_ok();
+    Ok(TopUpOutcome { transfer, receipt_persisted })
+}
