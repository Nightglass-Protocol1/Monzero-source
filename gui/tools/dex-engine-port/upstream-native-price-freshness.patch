 use anyhow::{Result, ensure};
 use num_bigint::BigUint;
 
+/// Caller-authenticated reference observation. This type does not prove provenance.
+/// Timestamps use the same caller-selected seconds clock as `contains_fresh`.
+pub struct ReferencePrice {
+    pub btc_satoshis: u64,
+    pub xmz_atoms: u64,
+    pub observed_at: u64,
+}
+
+/// Evaluate a new trade only against a non-future, sufficiently recent reference.
+/// All policy inputs are explicit. An expired reference is an error, not permission
+/// to trade without a band. Authentication, clock trust and reference update rules
+/// remain the caller's responsibility. Never use this to block settlement/refunds.
+pub fn contains_fresh(
+    btc_satoshis: u64,
+    xmz_atoms: u64,
+    reference: &ReferencePrice,
+    deviation_bps: u16,
+    maximum_age_seconds: u64,
+    now: u64,
+) -> Result<bool> {
+    ensure!(maximum_age_seconds > 0, "reference maximum age must be positive");
+    let age = now.checked_sub(reference.observed_at)
+        .ok_or_else(|| anyhow::anyhow!("reference observation is in the future"))?;
+    ensure!(age <= maximum_age_seconds, "reference price is stale");
+    contains(btc_satoshis, xmz_atoms, reference.btc_satoshis,
+        reference.xmz_atoms, deviation_bps)
+}
