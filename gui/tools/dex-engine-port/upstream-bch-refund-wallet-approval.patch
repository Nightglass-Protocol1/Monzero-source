+//! Public approval of local refund-wallet operations. No key export or payout grant.
+use super::*;
+use serde_json::Value;
+
+pub(super) const RESTORE_HEIGHT:u64=0;
+const REVIEW:&str="monzero-bch-native-refund-wallet-review-v1";
+#[derive(Clone,Copy,PartialEq,Eq)]
+pub enum RefundWalletAction {Restore,Open,Check}
+impl RefundWalletAction {
+    fn name(self)->&'static str {match self {Self::Restore=>"restore",Self::Open=>"open",Self::Check=>"check"}}
+}
+pub struct NativeRefundWalletReview {pub details:Value,pub commitment:[u8;32]}
+
+impl AdmittedExecution<'_> {
+    // Caller must first recover the opaque NativeRefund using fresh two-chain
+    // verification. It cannot be constructed from a desktop/helper JSON object.
+    pub fn review_recovered_bch_refund_wallet(&self,refund:&NativeRefund,
+        action:RefundWalletAction,session:&NativeWalletSession,now:u64)->Result<NativeRefundWalletReview> {
+        ensure!(refund.observed_at.elapsed()<=std::time::Duration::from_secs(30),"refund wallet observation expired");
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.refund_wallet_binding(refund,&id)?;
+        let record=self.refund_wallet_record(&binding,now)?;
+        ensure!(matches!((action,record),(RefundWalletAction::Restore,None)
+            |(RefundWalletAction::Open,Some(_))|(RefundWalletAction::Check,Some(_))),
+            "refund wallet action conflicts with retained attempt");
+        let state=match record {None=>"not-attempted",Some((_,false))=>"attempted",Some((_,true))=>"ready"};
+        let (deployment,_)=self.native_bch_observation_policy()?;
+        let details=json!({"schema":REVIEW,"action":action.name(),"state":state,
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),
+            "admission":self.admission_digest()?,"walletFile":id.filename(),"address":refund.address.to_string(),
+            "nativePayment":refund.native_txid,"refund":refund.refund,"walletBinding":binding,
+            "walletIntent":record.map(|(digest,_)|digest),"restoreHeight":RESTORE_HEIGHT,
+            "minimumBchConfirmations":self.policy.bch_confirmations,"minimumXmzConfirmations":self.policy.xmz_confirmations,
+            "bchDeployment":deployment,"bchNetwork":self.quote.terms()["bchNetwork"],
+            "bchGenesis":self.quote.terms()["bchGenesis"],"xmzNetwork":self.quote.terms()["xmzNetwork"],
+            "walletBackend":session.recovery_endpoint(&refund.address)?});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok(NativeRefundWalletReview {details,commitment})
+    }
+}
+
+impl AdmittedExecution<'_> {
+    pub async fn restore_approved_light_bch_refund_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        refund:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession,password:String,approved:&[u8;32])->Result<()> {
+        self.restore_bch_refund_wallet_with_observer(native,NativeFundingObserver::Walletless(bch),refund,block,now,session,password,Some(approved)).await
+    }
+    pub async fn open_approved_light_bch_refund_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        refund:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession,password:String,approved:&[u8;32])->Result<()> {
+        self.open_bch_refund_wallet_with_observer(native,NativeFundingObserver::Walletless(bch),refund,block,now,session,password,Some(approved)).await
+    }
+    pub async fn check_approved_light_bch_refund_wallet(&mut self,native:&impl FundingObserver,bch:&OwnedBchObserver,
+        refund:Txid,block:Option<BlockHash>,now:u64,session:&mut NativeWalletSession,approved:&[u8;32])->Result<()> {
+        self.check_bch_refund_wallet_with_observer(native,NativeFundingObserver::Walletless(bch),refund,block,now,session,Some(approved)).await
+    }
+    pub(super) fn check_refund_wallet_approval(&self,refund:&NativeRefund,action:RefundWalletAction,
+        session:&NativeWalletSession,now:u64,approved:Option<&[u8;32]>)->Result<()> {
+        if let Some(approved)=approved {
+            ensure!(self.review_recovered_bch_refund_wallet(refund,action,session,now)?.commitment==*approved,
+                "BCH refund wallet approval changed");
+        }
+        Ok(())
+    }
+}
