+//! Fresh production-helper observation; cloned stores must remain unchanged.
+use super::*;
+pub(super) fn exercise(native: &Value,setup: &Setup,original: &PrivateStore,snapshots: &PrivateStore,
+    pins: &NegotiationPins,base: u64,confirmed: bool,txid: &str,context: &Value) -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==digest,"observation helper changed");
+    let program=match (std::env::var_os("MONZERO_BCH_QT_NATIVE_OBSERVATION_PROBE"),
+        std::env::var_os("MONZERO_BCH_QT_NATIVE_OBSERVATION_PROBE_SHA256")) {
+        (None,None)=>helper.clone(),
+        (Some(path),Some(expected))=>{
+            let path=PathBuf::from(path);
+            ensure!(path.is_absolute() && path.canonicalize()?==path
+                && expected.to_str()==Some(hex(&Sha256::digest(std::fs::read(&path)?)).as_str()),"Qt native observation probe changed");path
+        },
+        _=>anyhow::bail!("incomplete Qt observation probe pin"),
+    };
+    let metadata=PrivateStore::new()?;let private=PrivateStore::new()?;let config=PrivateStore::new()?;
+    for (name,bytes) in contents(&original.0)? {save(&metadata.0.join(name),&bytes)?;}
+    for (name,bytes) in contents(&snapshots.0)? {save(&private.0.join(name),&bytes)?;}
+    let quote=config.0.join("quote.json");save(&quote,&setup.quote.record()?)?;
+    let admission=config.0.join("admission.json");
+    save(&admission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":digest,"quoteFile":quote,
+        "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"bch-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":private.0,"negotiationPins":pins}))?)?;
+    let login=config.0.join("observer-login");
+    save(&login,format!("{}:{}",native["observerUsername"].as_str().context("observer username")?,
+        native["observerPassword"].as_str().context("observer password")?).as_bytes())?;
+    let rpc=config.0.join("observer.json");
+    save(&rpc,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-rpc-v1",
+        "daemonPort":native["daemonPort"],"walletPort":native["observerPort"],"loginFile":login}))?)?;
+    let wrapper=config.0.join("observation.json");
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-observation-v1",
+        "admissionConfigFile":admission,"nativeRpcFile":rpc}))?)?;
+    // Derived by the controller from retained agreement/funding journals.
+    save(&PathBuf::from(format!("{}.public-context.json",wrapper.display())),&serde_json::to_vec(context)?)?;
+    let invoke=|success: bool| -> Result<Value> {
+        let id=uuid::Uuid::new_v4();
+        let request=json!({"schema":"monzero-bch-native-observation-request-v1","requestId":id});
+        let mut child=Command::new(&program).arg("--native-observation-stdio-v1").arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("observer stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty() && output.stdout.len()<=16384);
+        let value: Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(value.as_object().unwrap().len(),7);
+        assert_eq!(value["schema"],"monzero-bch-native-observation-response-v1");
+        assert_eq!(value["requestId"],id.to_string());assert_eq!(value["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(value["executable"],false);assert_eq!(value["chainObserved"],true);
+        assert_eq!(value["review"]["details"].as_object().unwrap().len(),13);
+        let observed=&value["observation"];assert_eq!(observed.as_object().unwrap().len(),10);
+        assert_eq!(observed["state"],"confirmed");assert_eq!(observed["txid"],txid);
+        assert_eq!(observed["destination"],value["review"]["details"]["destination"]);
+        assert_eq!(observed["amountAtoms"],setup.quote.terms()["xmzAtoms"]);
+        assert_eq!(observed["genesis"],setup.policy.xmz_genesis);
+        let number=|key: &str| -> Result<u64> {Ok(observed[key].as_str().context("observation count")?.parse()?)};
+        assert!(number("height")?>0 && number("tipHeight")?>=number("height")?);
+        assert_eq!(number("confirmations")?,number("tipHeight")?-number("height")?+1);
+        assert!(number("confirmations")?>=u64::from(setup.policy.xmz_confirmations));
+        assert!(number("observedAt")?>=base);Ok(value)
+    };
+    let before=contents(&metadata.0)?;let secrets=contents(&private.0)?;
+    invoke(confirmed)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&private.0)?,secrets);
+    // A missing backend cannot be replaced by previously observed chain status.
+    std::fs::remove_file(&login)?;invoke(false)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&private.0)?,secrets);
+    Ok(())
+}
