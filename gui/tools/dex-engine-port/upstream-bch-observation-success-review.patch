+use super::*;
+pub(super) fn exercise(setup: &Setup,original: &PrivateStore,snapshots: &PrivateStore,
+    pins: &NegotiationPins,base: u64,deployment: &[u8;32],details: &Value,commitment: &[u8;32],proof_review: &Value,context: &Value) -> Result<()> {
+    let helper=PathBuf::from(std::env::var("MONZERO_BCH_ADMISSION_HELPER")?);
+    let digest=std::env::var("MONZERO_BCH_ADMISSION_HELPER_SHA256")?;
+    ensure!(helper.is_absolute() && helper.canonicalize()?==helper
+        && hex(&Sha256::digest(std::fs::read(&helper)?))==digest,"success review helper changed");
+    let program=PathBuf::from(std::env::var("MONZERO_BCH_QT_SUCCESS_RELEASE_REVIEW_PROBE")?);
+    let expected=std::env::var("MONZERO_BCH_QT_SUCCESS_RELEASE_REVIEW_PROBE_SHA256")?;
+    ensure!(program.is_absolute() && program.canonicalize()?==program
+        && hex(&Sha256::digest(std::fs::read(&program)?))==expected,"Qt success release review probe changed");
+    let metadata=PrivateStore::new()?;let private=PrivateStore::new()?;let config=PrivateStore::new()?;
+    for (name,bytes) in contents(&original.0)? {save(&metadata.0.join(name),&bytes)?;}
+    for (name,bytes) in contents(&snapshots.0)? {save(&private.0.join(name),&bytes)?;}
+    let quote=config.0.join("quote.json");save(&quote,&setup.quote.record()?)?;
+    let admission=config.0.join("admission.json");
+    let admission_record=json!({"schema":"monzero-private-bch-admission-v1",
+        "helper":helper,"helperDigest":digest,"quoteFile":quote,
+        "quoteCommitment":hex(setup.quote.commitment()),"admittedAt":base,
+        "tradeId":setup.quote.terms()["swapId"],"identityPins":[
+            SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()],
+        "policy":setup.policy,"role":"bch-funder","metadataDirectory":metadata.0,
+        "snapshotDirectory":private.0,"negotiationPins":pins});
+    save(&admission,&serde_json::to_vec(&admission_record)?)?;
+    let wrapper=config.0.join("success-review.json");
+    let record=json!({"schema":"monzero-private-bch-success-release-review-v1",
+        "admissionConfigFile":admission,"deploymentCommitment":hex(deployment),"safetyBlocks":5});
+    save(&wrapper,&serde_json::to_vec(&record)?)?;
+    save(&PathBuf::from(format!("{}.public-context.json",wrapper.display())),&serde_json::to_vec(context)?)?;
+    save(&PathBuf::from(format!("{}.public-proof.json",wrapper.display())),&serde_json::to_vec(proof_review)?)?;
+    let invoke=|success: bool| -> Result<Value> {
+        let id=uuid::Uuid::new_v4();
+        let request=json!({"schema":"monzero-bch-success-release-review-request-v1","requestId":id});
+        let mut child=Command::new(&program).arg("--success-release-review-stdio-v1").arg(&wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        child.stdin.take().context("success review stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+        let output=child.wait_with_output()?;
+        assert_eq!(output.status.success(),success,"{}",String::from_utf8_lossy(&output.stderr));
+        if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+        assert!(output.stderr.is_empty() && output.stdout.len()<=16384);
+        let value: Value=serde_json::from_slice(&output.stdout)?;
+        assert_eq!(value.as_object().unwrap().len(),6);
+        assert_eq!(value["schema"],"monzero-bch-success-release-review-response-v1");
+        assert_eq!(value["requestId"],id.to_string());assert_eq!(value["tradeId"],setup.quote.terms()["swapId"]);
+        assert_eq!(value["executable"],false);assert_eq!(value["chainObserved"],false);
+        assert_eq!(value["review"],json!({"details":details,"commitment":hex(commitment)}));
+        Ok(value["review"].clone())
+    };
+    let before=contents(&metadata.0)?;let secrets=contents(&private.0)?;
+    let reviewed=invoke(true)?;assert_eq!(invoke(true)?,reviewed);
+    let mut changed=record.clone();changed["deploymentCommitment"]=json!("00".repeat(32));
+    save(&wrapper,&serde_json::to_vec(&changed)?)?;invoke(false)?;
+    changed=record.clone();changed["safetyBlocks"]=json!(0);
+    save(&wrapper,&serde_json::to_vec(&changed)?)?;invoke(false)?;
+    save(&wrapper,&serde_json::to_vec(&record)?)?;
+    let mut wrong_role=admission_record.clone();wrong_role["role"]=json!("native-funder");
+    save(&admission,&serde_json::to_vec(&wrong_role)?)?;invoke(false)?;
+    assert_eq!(contents(&metadata.0)?,before);assert_eq!(contents(&private.0)?,secrets);
+    Ok(())
+}
