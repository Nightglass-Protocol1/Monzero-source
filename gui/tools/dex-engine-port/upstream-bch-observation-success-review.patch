@@ -0,0 +1,49 @@
+//! Public consent before exposing any spend-enabling success adaptor bytes.
+use super::*;
+use serde_json::json;
+const REVIEW: &str="monzero-bch-success-release-review-v1";
+pub struct SuccessReleaseReview {pub details: serde_json::Value,pub commitment: [u8;32]}
+impl AdmittedExecution<'_> {
+    /// Offline review validates retained funding/proof/recovery state. It neither
+    /// constructs an adaptor nor establishes live chain approval.
+    pub fn review_bch_success_release(&self,deployment: &[u8;32],safety_blocks: u32,now: u64)
+        -> Result<SuccessReleaseReview> {
+        ensure!(self.policy.bch_confirmations>0 && self.policy.xmz_confirmations>0 && safety_blocks>0
+            && u64::from(self.policy.bch_confirmations)+u64::from(safety_blocks)<u64::from(self.policy.cancel_blocks),
+            "invalid BCH success release margin");
+        let context=self.success_context_for_deployment(deployment,now)?;
+        let prepared=self.load_success("prepared",&context)?;
+        let signed=self.load_success("signed",&context)?;
+        ensure!(signed.is_none() || prepared.is_some(),"signed BCH success lacks preparation");
+        if let Some(prepared)=&prepared {
+            ensure!(now>=prepared.at,"BCH success review predates preparation");
+            if let Some(signed)=&signed {
+                ensure!(signed.frame==prepared.frame && signed.at>=prepared.at && now>=signed.at,
+                    "BCH success review retained state changed");
+            }
+        }
+        let terms=self.quote.terms();let principal=terms["bchAtoms"].parse::<u64>()?;
+        let fee=terms["bchLockFeeAtoms"].parse::<u64>()?;
+        let payout=principal.checked_sub(fee).context("invalid BCH success payout")?;
+        ensure!(payout>0 && fee>0,"empty BCH success payout or fee");
+        let details=json!({"schema":REVIEW,"action":"prepare-bch-success-release",
+            "swapId":terms["swapId"],"quote":self.quote.commitment(),"agreement":context.agreement.commitment(),
+            "admission":context.admission,"nativeProof":context.receipt,"bchDeployment":deployment,
+            "bchFundingOutpoint":context.funding.lock_outpoint().to_string(),"bchAtoms":principal.to_string(),
+            "bchPayoutScript":terms["bchPayoutScript"],"bchPayoutAtoms":payout.to_string(),"bchFeeAtoms":fee.to_string(),
+            "nativeTxid":context.request.proof.tx_hash.0,"nativeDestination":context.request.address.to_string(),
+            "nativeAmountAtoms":context.request.amount.atom_string(),
+            "minimumBchConfirmations":self.policy.bch_confirmations,"minimumNativeConfirmations":self.policy.xmz_confirmations,
+            "cancellationMarginBlocks":safety_blocks});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok(SuccessReleaseReview {details,commitment})
+    }
+    /// Exact consent precedes adaptor construction. The existing production path
+    /// still reobserves both chains for every initial or repeated exposure.
+    pub async fn prepare_reviewed_bch_success_release(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64,approved: &[u8;32]) -> Result<Zeroizing<Vec<u8>>> {
+        let review=self.review_bch_success_release(&bch.deployment_commitment()?,safety_blocks,now)?;
+        ensure!(review.commitment==*approved,"BCH success release consent changed");
+        self.bch_success_signing_frame(native,bch,safety_blocks,now).await
+    }
+}
