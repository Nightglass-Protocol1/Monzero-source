@@ -0,0 +1,71 @@
+// Private recovery output. Never pass this response to public wallet status or
+// QML diagnostics. The desktop caller must explicitly reveal and then clear it.
+use super::*;
+use serde::Serialize;
+use swap_machine::litecoin_light::vault::recovery::{self as material,RecoverySeed};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct RevealRequest {
+    schema:String,
+    request_id:uuid::Uuid,
+    approved_config_digest:String,
+    reveal_approved:bool,
+    password:Password,
+}
+struct SeedHex<'a>(&'a RecoverySeed);
+impl std::fmt::Display for SeedHex<'_> {
+    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result {
+        for byte in self.0.expose_bytes() {write!(f,"{byte:02x}")?;} Ok(())
+    }
+}
+impl Serialize for SeedHex<'_> {
+    fn serialize<S:serde::Serializer>(&self,serializer:S)->std::result::Result<S::Ok,S::Error> {
+        serializer.collect_str(self)
+    }
+}
+#[derive(Serialize)]
+#[serde(rename_all="camelCase")]
+struct RevealResponse<'a> {
+    schema:String,
+    request_id:uuid::Uuid,
+    coin:&'a str,
+    network:&'a str,
+    wallet_id:uuid::Uuid,
+    account:u32,
+    seed_encoding:&'static str,
+    seed_hex:SeedHex<'a>,
+    active_swap_recovery:bool,
+}
+
+pub(super) fn reveal(path:&Path)->Result<()> {
+    let mut input=Zeroizing::new(Vec::with_capacity(8193));
+    std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid recovery request size");
+    let request:RevealRequest=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-wallet-recovery-request-v1"))
+        .context("invalid recovery schema")?;
+    ensure!(!request.request_id.is_nil() && request.reveal_approved,"missing recovery reveal approval");
+    let (_lease,raw)=private_config(path)?;
+    let approved:sha256::Hash=request.approved_config_digest.parse()?;
+    ensure!(approved.to_string()==request.approved_config_digest && sha256::Hash::hash(&raw)==approved,
+        "recovery configuration differs from approval");
+    let config:Config=serde_json::from_slice(&raw)?;
+    ensure!(config.schema==format!("monzero-private-{tag}-light-v1"),"wrong recovery chain");
+    let network=network_for(tag,&config.network)?;
+    let wallet=config.wallet.as_ref().context("missing recovery wallet")?;
+    let public=PublicAccount::from_descriptor(&wallet.account,network)?;
+    let vault_config=wallet.vault.as_ref().context("missing recovery vault")?;
+    let vault=SeedVault::open(&vault_config.directory,network,vault_config.wallet_id)?;
+    let seed=material::reveal(&vault,request.password.0.as_bytes(),&wallet.account)?;
+    let response=RevealResponse {schema:format!("monzero-{tag}-light-wallet-recovery-response-v1"),
+        request_id:request.request_id,coin:tag,network:&config.network,wallet_id:vault_config.wallet_id,
+        account:public.account_index(),seed_encoding:RecoverySeed::ENCODING,seed_hex:SeedHex(&seed),active_swap_recovery:false};
+    // Fixed capacity exceeds the bounded response; avoid reallocating secrets.
+    let mut output=Zeroizing::new(Vec::with_capacity(4096));
+    serde_json::to_writer(&mut *output,&response)?;
+    ensure!(output.len()<=4096,"oversized private recovery response");
+    std::io::stdout().write_all(&output)?;
+    Ok(())
+}
