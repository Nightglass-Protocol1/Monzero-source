+//! Explicit, password-authenticated recovery of existing raw BIP32 seed wallets.
+//! Existing vaults were not generated from BIP39; never relabel their seed as a
+//! BIP39 mnemonic. Callers must use a private reveal channel, not public status,
+//! logs, clipboard automation or a network transport. Not an active-trade backup.
+use super::*;
+
+/// Neither Clone, Debug nor Serialize. Callers explicitly expose bytes only
+/// inside a consented local recovery view and erase owned buffers afterwards.
+pub struct RecoverySeed(Zeroizing<[u8;32]>);
+impl RecoverySeed {
+    pub const ENCODING:&'static str="raw-bip32-seed-hex-v1";
+    pub fn expose_bytes(&self)->&[u8;32] {&self.0}
+    /// Strict 32-byte lowercase hex. This is raw BIP32 seed material, NOT a
+    /// private spending key or BIP39 entropy. Never guess a recovery format.
+    pub fn from_hex(value:&str)->Result<Self> {
+        ensure!(value.len()==64,"invalid recovery seed length");
+        let mut bytes=Zeroizing::new([0u8;32]);
+        for (i,pair) in value.as_bytes().chunks_exact(2).enumerate() {
+            let digit=|c:u8|->Result<u8> {match c {b'0'..=b'9'=>Ok(c-b'0'),b'a'..=b'f'=>Ok(c-b'a'+10),_=>anyhow::bail!("invalid recovery seed encoding")}};
+            bytes[i]=(digit(pair[0])?<<4)|digit(pair[1])?;
+        }
+        Ok(Self(bytes))
+    }
+    /// Recover the same public account before publishing any restored wallet.
+    /// The caller separately restores address allocations and trade journals.
+    pub fn public_account(&self,network:impl Into<LightNetwork>,index:u32)->Result<PublicAccount> {
+        SecretSeed::from_bytes(Zeroizing::new(*self.0)).public_account(network,index)
+    }
+    pub fn into_seed(self)->SecretSeed {SecretSeed::from_bytes(Zeroizing::new(*self.0))}
+}
+
+/// Authenticate the password and expected public account before exposing seed
+/// bytes. This never writes plaintext, contacts a server or changes the vault.
+pub fn reveal(vault:&SeedVault,password:&[u8],expected:&PublicAccountDescriptor)->Result<RecoverySeed> {
+    let seed=vault.unlock_for_account(password,expected)?;
+    Ok(RecoverySeed(Zeroizing::new(*seed.0)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::litecoin_light::network::{BtcNetwork,BchNetwork,DogeNetwork};
+    use crate::litecoin_light::account::Branch;
+
+    struct Directory(std::path::PathBuf);
+    impl Drop for Directory {fn drop(&mut self) {let _=std::fs::remove_dir_all(&self.0);}}
+
+    #[test]
+    fn raw_recovery_round_trip_is_chain_bound_and_read_only()->Result<()> {
+        for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+            LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+            let temporary=Directory(std::env::temp_dir().join(format!("monzero-local-recovery-{}",Uuid::new_v4())));
+            let directory=temporary.0.clone();std::fs::create_dir(&directory)?;
+            #[cfg(unix)] {use std::os::unix::fs::PermissionsExt;std::fs::set_permissions(&directory,std::fs::Permissions::from_mode(0o700))?;}
+            let seed=SecretSeed::from_bytes(Zeroizing::new([7;32]));
+            let account=seed.public_account(network,3)?;
+            let wallet=Uuid::new_v4();let password=b"disposable recovery test password";
+            let vault=SeedVault::create(&directory,network,wallet,password,&seed)?;
+            let before=std::fs::read(directory.join(NAME))?;
+            let recovered=reveal(&vault,password,&account.descriptor())?;
+            assert_eq!(recovered.expose_bytes(),&[7;32]);
+            let from_text=RecoverySeed::from_hex(&"07".repeat(32))?;
+            let restored=from_text.public_account(network,3)?;
+            assert_eq!(serde_json::to_vec(&restored.descriptor())?,serde_json::to_vec(&account.descriptor())?);
+            assert_eq!(restored.derive(Branch::Receive,17)?.address(),account.derive(Branch::Receive,17)?.address());
+            assert!(reveal(&vault,b"wrong password",&account.descriptor()).is_err());
+            let other=SecretSeed::from_bytes(Zeroizing::new([8;32])).public_account(network,3)?;
+            assert!(reveal(&vault,password,&other.descriptor()).is_err());
+            assert_eq!(std::fs::read(directory.join(NAME))?,before);
+        }
+        Ok(())
+    }
+    #[test]
+    fn recovery_rejects_ambiguous_encoding() {
+        for text in [String::new(),"0".repeat(63),"0".repeat(65),"AA".repeat(32),"gg".repeat(32),
+            " 07".repeat(32),"abandon ".repeat(24)] {assert!(RecoverySeed::from_hex(&text).is_err());}
+        assert!(RecoverySeed::from_hex(&"00".repeat(32)).is_ok());
+    }
+}
