+//! Native funder's exact punishment review. No maturity or relay authority.
+use super::*;
+use crate::{bch_rpc::BchRpc,xmz_funding::FundingRequest};
+use serde_json::{Value,json};
+
+const REVIEW: &str="monzero-bch-punish-relay-review-v1";
+pub struct PunishRelayReview {pub details: Value,pub commitment: [u8;32]}
+struct PunishMaterials {
+    review: PunishRelayReview,cancel: Transaction,transaction: Transaction,
+    payment: FundingRequest,prepared_at: u64,deployment: [u8;32],
+}
+impl AdmittedExecution<'_> {
+    fn punish_relay_materials(&self) -> Result<PunishMaterials> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH punishment role");
+        let funding=self.received_bch_funding_message()?.context("missing authenticated BCH funding")?;
+        let (payment,binding,prepared_at,deployment)=self.native_refund_payment()?;
+        self.bch_native_relay_state()?;
+        let plan=self.quote.recovery_plan();let signed=funding.signed();
+        let cancel=plan.lock().prepare_timeout(&serialize(signed.transaction()),&plan.lock_spend_terms(signed.lock_outpoint()))?;
+        let source=OutPoint {txid:cancel.compute_txid(),vout:0};
+        let transaction=plan.recovery().prepare_timeout(&serialize(&cancel),&plan.recovery_spend_terms(source))?;
+        ensure!(transaction.input.len()==1 && transaction.output.len()==1
+            && transaction.input[0].previous_output==source
+            && transaction.input[0].sequence.to_consensus_u32()==u32::from(plan.terms().punish_delay_blocks),
+            "BCH punishment source or delay changed");
+        let output=&transaction.output[0];
+        let fee=plan.recovery_atoms().checked_sub(output.value.to_sat()).context("invalid BCH punishment fee")?;
+        ensure!(output.value.to_sat()==plan.final_recovery_atoms() && fee==plan.terms().recovery_fee_atoms
+            && output.script_pubkey==plan.terms().native_funder_payout,"BCH punishment destination or accounting changed");
+        let details=json!({"schema":REVIEW,"action":"broadcast-bch-punishment","swapId":self.quote.terms()["swapId"],
+            "quote":self.quote.commitment(),"admission":self.admission_digest()?,"nativePayment":binding,
+            "nativeFundingTxid":payment.proof.tx_hash.0,"bchDeployment":deployment,
+            "bchNetwork":self.quote.terms()["bchNetwork"],"bchGenesis":self.quote.terms()["bchGenesis"],
+            "fundingOutpoint":signed.lock_outpoint(),"recoveryOutpoint":source,"txid":transaction.compute_txid(),
+            "destinationScript":output.script_pubkey.to_hex_string(),"payoutAtoms":output.value.to_sat().to_string(),
+            "feeAtoms":fee.to_string(),"punishDelayBlocks":plan.terms().punish_delay_blocks,"preparedAt":prepared_at,
+            "minimumBchConfirmations":self.policy.bch_confirmations,"minimumXmzConfirmations":self.policy.xmz_confirmations});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok(PunishMaterials {review:PunishRelayReview {details,commitment},cancel,transaction,payment,prepared_at,deployment})
+    }
+    /// Historical review survives commercial expiry. Current confirmed native
+    /// payment, unspent recovery output and punishment maturity need fresh checks
+    /// before any future dispatch; no secrets are exposed by this review.
+    pub fn review_bch_punish_relay(&self,bch: &BchRpc,now: u64) -> Result<PunishRelayReview> {
+        let materials=self.punish_relay_materials()?;
+        ensure!(now>=materials.prepared_at && bch.deployment_commitment()?==materials.deployment,
+            "BCH punishment review predates preparation or changes observer");
+        Ok(materials.review)
+    }
+}
