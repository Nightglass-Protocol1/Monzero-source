+use super::*;
+use crate::{bch_quote::tests::{fixture,signed},common::CROSS_CURVE_PROOF_SYSTEM};
+use swap_core::compat::IntoDalekNg;
+use ed25519_dalek::{Signer,SigningKey};
+use ecdsa_fun::fun::Scalar;
+use bitcoin::{absolute,consensus::serialize,hashes::Hash,transaction::Version,
+    Amount,Sequence,Transaction,TxIn,TxOut,Txid,Witness};
+fn sign(bytes: &[u8], role: Role) -> Vec<u8> {
+    let key = SigningKey::from_bytes(&[match role { Role::BchFunder=>1,Role::NativeFunder=>2 };32]);
+    key.sign(&signing_bytes(bytes,role).unwrap()).to_bytes().to_vec()
+}
+fn parent(script: bitcoin::ScriptBuf, atoms: u64) -> Transaction {
+    Transaction { version:Version::TWO, lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn { previous_output:OutPoint { txid:Txid::from_byte_array([7;32]),vout:0 },
+            script_sig:bitcoin::ScriptBuf::new(), sequence:Sequence::MAX,witness:Witness::new() }],
+        output:vec![TxOut { value:Amount::from_sat(atoms),script_pubkey:script }] }
+}
+
+#[test]
+fn authenticated_proofs_recover_native_shares_from_quoted_success_and_refund() -> Result<()> {
+    let (policy,terms) = fixture(); let quote = signed(&terms,&policy,1000)?;
+    let plan = quote.recovery_plan();
+    let funding = parent(plan.lock().script_pubkey(),plan.terms().locked_atoms);
+    let funding_raw = serialize(&funding);
+    let funding_outpoint = OutPoint { txid:funding.compute_txid(),vout:0 };
+    let cancel = plan.lock().prepare_timeout(&funding_raw,&plan.lock_spend_terms(funding_outpoint))?;
+    let cancel_raw = serialize(&cancel);
+    for role in [Role::NativeFunder,Role::BchFunder] {
+        let native = monero::Scalar::random(&mut rand::thread_rng());
+        let original = monero::PrivateKey::from_scalar(native);
+        let (proof,(adaptor,edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&native.into_dalek_ng(),&mut rand::thread_rng());
+        let bytes = frame(&quote,role,adaptor.into(),edwards.compress().to_bytes(),proof)?;
+        let accepted = AuthenticatedNativeAdaptor::verify(&bytes,&sign(&bytes,role),&quote,&policy,1000,role)?;
+        let (covenant,raw,outpoint,secret_tag) = match role {
+            Role::NativeFunder => (plan.lock(),&funding_raw,funding_outpoint,3),
+            Role::BchFunder => (plan.recovery(),&cancel_raw,OutPoint { txid:cancel.compute_txid(),vout:0 },4),
+        };
+        let secret = Scalar::from_bytes([secret_tag;32]).unwrap().non_zero().unwrap();
+        let mut scalar = original.as_bytes(); scalar.reverse();
+        let decrypt = Scalar::from_bytes(scalar).unwrap().non_zero().unwrap();
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize()).unwrap();
+        let encrypted = covenant.data_message().encrypted_sign(&secret,&adaptor);
+        let der = covenant.data_message().decrypt(&signer,&decrypt,encrypted.clone())?;
+        let spend_terms = match role { Role::NativeFunder=>plan.lock_spend_terms(outpoint),
+            Role::BchFunder=>plan.recovery_spend_terms(outpoint) };
+        let spend = covenant.prepare_redemption(raw,&spend_terms,&der)?;
+        assert_eq!(accepted.recover_from_spend(&quote,raw,outpoint,&serialize(&spend),&encrypted)?.as_bytes(),original.as_bytes());
+        let mut changed = spend.clone(); changed.output[0].value = Amount::from_sat(spend.output[0].value.to_sat()-1);
+        assert!(accepted.recover_from_spend(&quote,raw,outpoint,&serialize(&changed),&encrypted).is_err());
+        let wrong = OutPoint { txid:outpoint.txid,vout:1 };
+        assert!(accepted.recover_from_spend(&quote,raw,wrong,&serialize(&spend),&encrypted).is_err());
+        let timeout = covenant.prepare_timeout(raw,&spend_terms)?;
+        assert!(accepted.recover_from_spend(&quote,raw,outpoint,&serialize(&timeout),&encrypted).is_err());
+        let mut changed_terms = terms.clone(); changed_terms.insert("bchLockFeeAtoms".into(),"1001".into());
+        let other_quote = signed(&changed_terms,&policy,1000)?;
+        assert!(accepted.recover_from_spend(&other_quote,raw,outpoint,&serialize(&spend),&encrypted).is_err());
+    }
+    Ok(())
+}
+
+#[test]
+fn role_quote_identity_expiry_and_proof_are_all_required() -> Result<()> {
+    let (policy,terms) = fixture(); let quote = signed(&terms,&policy,1000)?;
+    let role = Role::NativeFunder;
+    let native = monero::Scalar::random(&mut rand::thread_rng());
+    let (proof,(adaptor,edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&native.into_dalek_ng(),&mut rand::thread_rng());
+    let bytes = frame(&quote,role,adaptor.into(),edwards.compress().to_bytes(),proof)?;
+    let signature = sign(&bytes,role);
+    assert!(AuthenticatedNativeAdaptor::verify(&bytes,&signature,&quote,&policy,1000,role).is_ok());
+    assert!(AuthenticatedNativeAdaptor::verify(&bytes,&signature,&quote,&policy,1000,Role::BchFunder).is_err());
+    assert!(AuthenticatedNativeAdaptor::verify(&bytes,&signature,&quote,&policy,2000,role).is_err());
+    assert!(AuthenticatedNativeAdaptor::verify(&bytes,&sign(&bytes,Role::BchFunder),&quote,&policy,1000,role).is_err());
+    let mut other_terms = terms.clone(); other_terms.insert("bchLockFeeAtoms".into(),"1001".into());
+    let other = signed(&other_terms,&policy,1000)?;
+    assert!(AuthenticatedNativeAdaptor::verify(&bytes,&signature,&other,&policy,1000,role).is_err());
+    let mut invalid: Frame = serde_json::from_slice(&bytes)?;
+    invalid.native_spend_key = [0;32];
+    let invalid_bytes = canonical(&invalid)?;
+    assert!(AuthenticatedNativeAdaptor::verify(&invalid_bytes,&sign(&invalid_bytes,role),&quote,&policy,1000,role).is_err());
+    invalid = serde_json::from_slice(&bytes)?;
+    invalid.native_spend_key = monero::PublicKey::from_private_key(&monero::PrivateKey::from_scalar(
+        monero::Scalar::random(&mut rand::thread_rng()))).decompress().compress().to_bytes();
+    let invalid_bytes = canonical(&invalid)?;
+    assert!(AuthenticatedNativeAdaptor::verify(&invalid_bytes,&sign(&invalid_bytes,role),&quote,&policy,1000,role).is_err());
+    let value: serde_json::Value = serde_json::from_slice(&bytes)?;
+    let mut duplicate = bytes.clone(); duplicate.splice(1..1,b"\"schema\":\"ignored\",".iter().copied());
+    for invalid_bytes in [Vec::new(),vec![b' ';MAX_FRAME+1],duplicate,serde_json::to_vec_pretty(&value)?] {
+        let sig = if invalid_bytes.is_empty() || invalid_bytes.len()>MAX_FRAME { vec![0;64] } else { sign(&invalid_bytes,role) };
+        assert!(AuthenticatedNativeAdaptor::verify(&invalid_bytes,&sig,&quote,&policy,1000,role).is_err());
+    }
+    Ok(())
+}
