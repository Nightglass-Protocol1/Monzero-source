+//! Public adaptor proof frames bound to a jointly signed quote and role.
+//! This is not a complete key exchange: local secret ownership, combined native
+//! wallet/view keys, durable transcript state and release policy remain separate.
+use anyhow::{Context, Result, ensure};
+use bitcoin::OutPoint;
+use ed25519_dalek::{Signature, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use ecdsa_fun::{adaptor::EncryptedSignature, fun::Point};
+use sigma_fun::ext::dl_secp256k1_ed25519_eq::CrossCurveDLEQProof;
+use swap_core::{bitcoin::PublicKey, monero};
+use crate::bch_quote::{Policy, VerifiedBchQuote};
+use super::ProvenNativeAdaptor;
+
+const DOMAIN: &str = "monzero-bch-xmz-native-proof-v1";
+const MAX_FRAME: usize = 200_000;
+
+#[derive(Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all="kebab-case")]
+pub enum Role { BchFunder, NativeFunder }
+impl Role {
+    fn identity(self) -> &'static str {
+        match self { Self::BchFunder => "bchFunder", Self::NativeFunder => "xmzFunder" }
+    }
+    fn domain(self) -> &'static str {
+        match self { Self::BchFunder => "bch-funder", Self::NativeFunder => "xmz-funder" }
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all="camelCase")]
+struct Frame {
+    schema: String, quote_commitment: String, swap_id: String, role: Role,
+    adaptor_key: PublicKey, native_spend_key: [u8;32], proof: CrossCurveDLEQProof,
+}
+
+/// A checked public proof and role association, not a chain observation.
+/// Do not construct this from serialized state without revalidating the quote
+/// and signed proof against the independently retained admission context.
+pub struct AuthenticatedNativeAdaptor {
+    quote_commitment: [u8;32], role: Role, binding: ProvenNativeAdaptor,
+}
+
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+fn canonical(frame: &Frame) -> Result<Vec<u8>> {
+    Ok(serde_json::to_vec(&serde_json::to_value(frame)?)?)
+}
+
+/// Prepare a public frame for the participant to sign with its pinned identity.
+/// Proof validity is enforced on acceptance, not inferred from this encoding.
+pub fn frame(quote: &VerifiedBchQuote, role: Role, adaptor: PublicKey,
+    native: [u8;32], proof: CrossCurveDLEQProof) -> Result<Vec<u8>> {
+    let bytes = canonical(&Frame { schema: DOMAIN.into(), quote_commitment:hex(quote.commitment()),
+        swap_id:quote.terms()["swapId"].clone(), role, adaptor_key:adaptor, native_spend_key:native, proof })?;
+    ensure!(bytes.len() <= MAX_FRAME, "oversized BCH native proof frame");
+    Ok(bytes)
+}
+
+pub fn signing_bytes(bytes: &[u8], role: Role) -> Result<Vec<u8>> {
+    ensure!(!bytes.is_empty() && bytes.len() <= MAX_FRAME, "invalid BCH native proof frame size");
+    let domain = format!("{DOMAIN}-{}",role.domain());
+    let mut message = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",domain.len(),domain,bytes.len()).into_bytes();
+    message.extend_from_slice(bytes); Ok(message)
+}
+
+impl AuthenticatedNativeAdaptor {
+    pub fn verify(bytes: &[u8], signature: &[u8], quote: &VerifiedBchQuote,
+        policy: &Policy, now: u64, role: Role) -> Result<Self> {
+        quote.check_policy(policy,now)?;
+        let message = signing_bytes(bytes,role)?;
+        let frame: Frame = serde_json::from_slice(bytes)?;
+        ensure!(frame.schema == DOMAIN && frame.role == role
+            && frame.quote_commitment == hex(quote.commitment()) && frame.swap_id == quote.terms()["swapId"],
+            "BCH native proof belongs to another role or quote");
+        ensure!(canonical(&frame)? == bytes, "noncanonical BCH native proof frame");
+        let identity = &quote.terms()[role.identity()];
+        let mut pin = [0;32];
+        for (i,byte) in pin.iter_mut().enumerate() { *byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?; }
+        VerifyingKey::from_bytes(&pin)?.verify_strict(&message,&Signature::from_slice(signature)?)?;
+        let adaptor: Point = frame.adaptor_key.into();
+        let plan = quote.recovery_plan();
+        ensure!(adaptor.to_bytes() != plan.terms().bch_funder_signing_key.serialize()
+            && adaptor.to_bytes() != plan.terms().native_funder_signing_key.serialize(),
+            "BCH contract signing key reused as a native adaptor");
+        let binding = ProvenNativeAdaptor::verify(adaptor,frame.native_spend_key,&frame.proof)?;
+        Ok(Self { quote_commitment:*quote.commitment(),role,binding })
+    }
+
+    /// Inspect the exact signed spend using the quoted contract and derive the
+    /// appropriate native share. No confirmation, canonical-chain membership or
+    /// permission to import/spend the recovered share is implied by this result.
+    /// The native funder's share is revealed by success; the BCH funder's share
+    /// is revealed by the signed refund from the second covenant stage.
+    pub fn recover_from_spend(&self, quote: &VerifiedBchQuote, funding: &[u8], outpoint: OutPoint,
+        spend: &[u8], encrypted: &EncryptedSignature) -> Result<monero::PrivateKey> {
+        ensure!(self.quote_commitment == *quote.commitment(), "BCH proof recovery quote mismatch");
+        let plan = quote.recovery_plan();
+        let (covenant, terms) = match self.role {
+            Role::NativeFunder => (plan.lock(),plan.lock_spend_terms(outpoint)),
+            Role::BchFunder => (plan.recovery(),plan.recovery_spend_terms(outpoint)),
+        };
+        let signature = covenant.redemption_signature(funding,&terms,spend)?;
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize())
+            .context("invalid quoted BCH contract public key")?;
+        self.binding.recover_share(&covenant.data_message(),&signer,encrypted,&signature)
+    }
+}
