+    /// Public signed material only. Storage must separately persist trusted
+    /// admission pins and apply private-journal durability/ownership rules.
+    pub fn record(&self) -> Result<Vec<u8>> {
+        let hex = |value: &[u8]| -> String { value.iter().map(|b| format!("{b:02x}")).collect() };
+        Ok(serde_json::to_vec(&serde_json::json!({
+            "schema": "monzero-bch-quote-record-v1", "admittedAt": self.admitted_at,
+            "commitment": hex(&self.commitment), "terms": self.terms,
+            "bchSignature": hex(&self.bch_signature), "xmzSignature": hex(&self.xmz_signature),
+        }))?)
+    }
+
+    /// Revalidate against the independently retained original admission context.
+    /// Restoring an expired quote permits inspecting its historical contracts,
+    /// not new funding or spending: those require their own policy/chain checks.
+    pub fn restore_record(record: &[u8], policy: &Policy, admitted_at: u64,
+        bch_pin: &[u8;32], xmz_pin: &[u8;32], commitment: &[u8;32]) -> Result<Self> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields, rename_all="camelCase")]
+        struct Record {
+            schema: String, admitted_at: u64, commitment: String,
+            terms: BTreeMap<String,String>, bch_signature: String, xmz_signature: String,
+        }
+        ensure!(!record.is_empty() && record.len() <= 16_384, "invalid retained BCH quote size");
+        let saved: Record = serde_json::from_slice(record)?;
+        ensure!(saved.schema == "monzero-bch-quote-record-v1" && saved.admitted_at == admitted_at
+            && bytes(&saved.commitment,32)?.as_slice() == commitment,
+            "retained BCH quote differs from pinned admission context");
+        let quote = Self::verify(&serde_json::to_vec(&saved.terms)?, admitted_at, policy,
+            bch_pin, xmz_pin, &bytes(&saved.bch_signature,64)?, &bytes(&saved.xmz_signature,64)?)?;
+        ensure!(quote.commitment() == commitment && quote.record()? == record,
+            "altered or noncanonical retained BCH quote");
+        Ok(quote)
+    }
