+#[test]
+fn historical_record_revalidates_admission_without_renewing_funding() -> Result<()> {
+    let (policy, terms) = fixture(); let original = signed(&terms,&policy,1000)?;
+    let record = original.record()?; let commitment = *original.commitment();
+    let b = SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes();
+    let x = SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes();
+    drop(original);
+    let restored = VerifiedBchQuote::restore_record(&record,&policy,1000,&b,&x,&commitment)?;
+    assert_eq!(restored.record()?,record);
+    assert_eq!(restored.terms(),&terms);
+    assert_eq!(restored.recovery_plan().final_recovery_atoms(),97_000);
+    let fresh = signed(&terms,&policy,1000)?;
+    fresh.recovery_plan().verify_scripts(restored.recovery_plan().lock().redeem_script(),
+        restored.recovery_plan().recovery().redeem_script())?;
+    assert!(restored.check_policy(&policy,2000).is_err());
+    assert!(signed(&terms,&policy,2000).is_err());
+    // The caller must retain the exact admission time, not substitute a later
+    // otherwise-valid time from the record or use current wall-clock time.
+    for time in [999,1001,2000] {
+        assert!(VerifiedBchQuote::restore_record(&record,&policy,time,&b,&x,&commitment).is_err());
+    }
+    assert!(VerifiedBchQuote::restore_record(&record,&policy,1000,&x,&b,&commitment).is_err());
+    assert!(VerifiedBchQuote::restore_record(&record,&policy,1000,&b,&x,&[0;32]).is_err());
+    Ok(())
+}
