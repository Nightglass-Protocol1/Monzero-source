+#[test]
+fn retained_record_rejects_tampering_and_ambiguous_encodings() -> Result<()> {
+    let (mut policy, terms) = fixture(); let original = signed(&terms,&policy,1000)?;
+    let record = original.record()?; let commitment = *original.commitment();
+    let b = SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes();
+    let x = SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes();
+    let value: serde_json::Value = serde_json::from_slice(&record)?;
+    let mut variants = vec![Vec::new(),vec![b' ';16_385],serde_json::to_vec_pretty(&value)?];
+    let mut duplicate = record.clone();
+    duplicate.splice(1..1,b"\"admittedAt\":1000,".iter().copied()); variants.push(duplicate);
+    let mut duplicate_term = String::from_utf8(record.clone())?;
+    duplicate_term = duplicate_term.replace("\"terms\":{","\"terms\":{\"bchAtoms\":\"1\",");
+    variants.push(duplicate_term.into_bytes());
+    for (field,replacement) in [("schema",serde_json::json!("monzero-ltc-quote-record-v1")),
+        ("admittedAt",serde_json::json!(1001)), ("commitment",serde_json::json!("00".repeat(32))),
+        ("bchSignature",serde_json::json!("00".repeat(64))),
+        ("xmzSignature",serde_json::json!("00".repeat(63))), ("extra",serde_json::json!(true))] {
+        let mut changed = value.clone(); changed[field] = replacement;
+        variants.push(serde_json::to_vec(&changed)?);
+    }
+    let mut changed = value.clone(); changed["terms"]["bchLockFeeAtoms"] = "1001".into();
+    variants.push(serde_json::to_vec(&changed)?);
+    let mut swapped = value.clone(); swapped["bchSignature"] = value["xmzSignature"].clone();
+    swapped["xmzSignature"] = value["bchSignature"].clone(); variants.push(serde_json::to_vec(&swapped)?);
+    for (index, invalid) in variants.iter().enumerate() {
+        assert!(VerifiedBchQuote::restore_record(invalid,&policy,1000,&b,&x,&commitment).is_err(),
+            "accepted record variant {index}");
+    }
+    // Another genuinely signed quote must not replace the checkpoint's quote.
+    let mut other_terms = terms.clone(); other_terms.insert("bchLockFeeAtoms".into(),"1001".into());
+    let other_record = signed(&other_terms,&policy,1000)?.record()?;
+    assert!(VerifiedBchQuote::restore_record(&other_record,&policy,1000,&b,&x,&commitment).is_err());
+    policy.maximum_bch_atoms = 99_999;
+    assert!(VerifiedBchQuote::restore_record(&record,&policy,1000,&b,&x,&commitment).is_err());
+    Ok(())
+}
