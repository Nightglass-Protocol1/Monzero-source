+//! Fresh reviews through pinned helper and desktop worker, without wallet mutation.
+use super::*;
+
+async fn call(program:&Path,wrapper:&Path,action:&str,success:bool)->Result<(Value,u64,u64)> {
+    let program=program.to_owned();let wrapper=wrapper.to_owned();let action=action.to_owned();
+    // Let the Tokio RPC listeners progress while the subprocess waits for them.
+    tokio::task::spawn_blocking(move || ->Result<(Value,u64,u64)> {
+        let now=|| ->Result<u64> {Ok(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs())};
+        let id=uuid::Uuid::new_v4();let started=now()?;
+        let request=json!({"schema":"monzero-bch-native-refund-wallet-review-request-v1","requestId":id,"action":action});
+        let mut child=Command::new(program).env_clear()
+            .envs(std::env::vars_os().filter(|(key,_)|matches!(key.to_str(),Some("PATH"|"LD_LIBRARY_PATH"))))
+            .arg("--native-refund-wallet-review-stdio-v1").arg(wrapper)
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+        if let Err(error)=child.stdin.take().context("missing review stdin")?.write_all(&serde_json::to_vec(&request)?) {
+            let _=child.kill();let _=child.wait();return Err(error.into())
+        }
+        let output=child.wait_with_output()?;let finished=now()?;
+        if !success {
+            ensure!(!output.status.success() && output.stdout.is_empty(),"invalid chain evidence was accepted");
+            return Ok((Value::Null,started,finished));
+        }
+        ensure!(output.status.success(),"review adapter failed: {}",String::from_utf8_lossy(&output.stderr));
+        ensure!(output.stderr.is_empty() && output.stdout.len()<=16384,"invalid review process output");
+        let value:Value=serde_json::from_slice(&output.stdout)?;
+        ensure!(value["requestId"]==id.to_string(),"review request correlation changed");
+        Ok((value,started,finished))
+    }).await?
+}
+
+pub(super) async fn exercise(config:&Path,status:&Path,metadata:&PrivateStore,snapshots:&PrivateStore,
+    setup:&Setup,rpc:&OwnedBchObserver,refund:Txid,fixture:&Fixture,server:&Server,wallet:&WalletFixture,
+    helper:&Path,helper_pin:&str,probe:&Path,probe_pin:&str,saved:&Value)->Result<()> {
+    let observer=fixture.funding_client()?;
+    let session=wallet.payout_session(&observer)?;
+    let address=XmzAddress::parse(setup.policy.xmz_network,saved["address"].as_str().context("missing refund address")?)?;
+    let endpoint=session.recovery_endpoint(&address)?;
+    let cookie=config.join("cookie");save(&cookie,b"user:pass\n")?;
+    let bch=config.join("bch.json");
+    save(&bch,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-observer-rpc-v1",
+        "port":server.port,"cookieFile":cookie,"checkpointHeight":1,"checkpoint":"07".repeat(32),
+        "subversion":"/Bitcoin Cash Node:29.0.0/"}))?)?;
+    let login=config.join("login");save(&login,b"fixture:fixture\n")?;
+    let native=config.join("native.json");
+    save(&native,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-rpc-v1",
+        "daemonPort":endpoint["daemonPort"],"walletPort":endpoint["walletPort"],"loginFile":login}))?)?;
+    let wrapper=config.join("review.json");
+    save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-native-refund-wallet-review-v1",
+        "statusConfigFile":status,"bchRpcFile":bch,"nativeRpcFile":native}))?)?;
+    let before=contents(config)?;let records=contents(&metadata.0)?;let secrets=contents(&snapshots.0)?;
+    let wallet_calls=wallet.state.lock().unwrap().calls.clone();
+    let actions=if saved["state"]=="not-attempted" {vec![("restore",RefundWalletAction::Restore)]}
+        else {vec![("open",RefundWalletAction::Open),("check",RefundWalletAction::Check)]};
+    for (name,action) in actions {
+        let expected={
+            let execution=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+            let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+            let recovered=execution.recover_light_bch_native_refund(&observer,rpc,refund,None,now).await?;
+            let review=execution.review_recovered_bch_refund_wallet(&recovered,action,&session,now)?;
+            json!({"details":review.details,"commitment":hex(&review.commitment)})
+        }; // Release journal lease before the independent helper resumes it.
+        for (program,pin) in [(helper,helper_pin),(probe,probe_pin)] {
+            let native_calls=fixture.calls.lock().unwrap().len();
+            let (response,started,finished)=call(program,&wrapper,name,true).await?;
+            assert!(fixture.calls.lock().unwrap().len()>native_calls);
+            let observed=response["observedAt"].as_u64().context("missing review observation time")?;
+            ensure!(observed>=started && observed<=finished && finished-observed<=30,"review is not fresh");
+            assert_eq!(response,json!({"schema":"monzero-bch-native-refund-wallet-review-response-v1",
+                "requestId":response["requestId"],"tradeId":setup.quote.terms()["swapId"],
+                "executable":false,"chainObserved":true,"observedAt":observed,"review":expected}));
+            server.state.lock().unwrap().redemption_confirmation_mode=1;
+            let rejected=call(program,&wrapper,name,false).await;
+            server.state.lock().unwrap().redemption_confirmation_mode=0;
+            rejected?;
+            fixture.confirmed.store(false,Ordering::SeqCst);
+            let rejected=call(program,&wrapper,name,false).await;
+            fixture.confirmed.store(true,Ordering::SeqCst);
+            rejected?;
+            assert_eq!(hex(&Sha256::digest(std::fs::read(program)?)),pin);
+            assert_eq!(wallet.state.lock().unwrap().calls,wallet_calls);
+            assert_eq!(contents(config)?,before);assert_eq!(contents(&metadata.0)?,records);
+            assert_eq!(contents(&snapshots.0)?,secrets);
+        }
+    }
+    Ok(())
+}
