+use super::*;
+use bitcoin::hex::{DisplayHex,FromHex};
+
+#[derive(Deserialize)]
+struct SignedReply { hex: String, complete: bool, errors: Option<Value> }
+impl BchRpc {
+    /// Crate-private: the executor must retain approval and intent first.
+    /// No retry, unlock, broadcast or caller-provided previous-output override.
+    pub(crate) async fn sign_funding(&self, preview: &FundingPreview) -> Result<Vec<u8>> {
+        ensure!(preview.previous_outputs().iter().all(|o|o.script_pubkey.is_p2pkh()),
+            "BCH signing currently requires P2PKH inputs");
+        let raw = serialize(preview.transaction()).to_lower_hex_string();
+        let reply = self.rpc(true,"signrawtransactionwithwallet",json!([raw,[],"ALL|FORKID"])).await?;
+        let reply: SignedReply = serde_json::from_str(reply.get())?;
+        ensure!(reply.complete && reply.errors.is_none() && reply.hex.len() <= 1_000_000,
+            "BCH wallet signing incomplete, rejected or oversized");
+        let bytes = Vec::<u8>::from_hex(&reply.hex).context("invalid BCH signed transaction hex")?;
+        preview.verify_signed(&bytes)?;
+        Ok(bytes)
+    }
+}
