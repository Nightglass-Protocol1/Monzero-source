+//! Sign-only approval and immutable exact signed funding. No relay permission.
+//! An uncertain signing attempt cannot be retried: legacy signatures set txid.
+use super::*;
+use crate::bch_rpc::BchRpc;
+use swap_core::bch::funding::SignedFunding;
+use serde_json::{Value,json};
+
+const REVIEW: &str = "monzero-bch-funding-signing-review-v1";
+const ATTEMPT: &str = "monzero-bch-funding-signing-intent-v1";
+const SIGNED: &str = "monzero-bch-signed-funding-v1";
+
+pub struct SigningReview { pub details: Value, pub commitment: [u8;32] }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent { schema: String, review: [u8;32], approved_at: u64 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record { schema: String, intent: [u8;32], raw: Vec<u8> }
+
+fn optional(journal: &Journal, name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+impl AdmittedExecution<'_> {
+    fn signing_review(&self) -> Result<(SigningReview,PreparedBchFunding,locks::Intent)> {
+        let prepared = self.prepared_bch_funding()?.context("BCH funding preparation is absent")?;
+        ensure!(prepared.preview().previous_outputs().iter().all(|o|o.script_pubkey.is_p2pkh()),
+            "BCH signing currently requires P2PKH inputs");
+        let (locked,lock_digest) = self.funding_lock_intent(&prepared)?;
+        let preview = prepared.preview();
+        let inputs: Vec<_> = preview.transaction().input.iter().zip(preview.previous_outputs()).map(|(i,o)|json!({
+            "txid":i.previous_output.txid,"vout":i.previous_output.vout,"atoms":o.value.to_sat(),
+            "script":o.script_pubkey.to_hex_string()})).collect();
+        let outputs: Vec<_> = preview.transaction().output.iter().enumerate().map(|(i,o)|json!({
+            "vout":i,"atoms":o.value.to_sat(),"script":o.script_pubkey.to_hex_string()})).collect();
+        let details = json!({"schema":REVIEW,"action":"sign-only","swapId":self.quote.terms()["swapId"],
+            "quote":self.quote.commitment(),"admission":self.admission_digest()?,"preparation":prepared.commitment,
+            "walletLockIntent":lock_digest,"deployment":locked.deployment,
+            "network":self.quote.terms()["bchNetwork"],"genesis":self.quote.terms()["bchGenesis"],
+            "expiresAt":self.quote.terms()["expiresAt"],"inputs":inputs,"outputs":outputs,
+            "contractVout":preview.lock_vout(),"feeAtoms":preview.fee().to_sat(),
+            "changeAddress":locked.change_address,"minimumConfirmations":locked.minimum_confirmations});
+        let commitment = hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((SigningReview {details,commitment},prepared,locked))
+    }
+
+    /// Render this exact review in the approval UI. Preparing a review does not
+    /// approve anything or assert that advisory locks still exist in the wallet.
+    pub fn review_bch_funding_signing(&self, backend: &BchRpc, now: u64) -> Result<SigningReview> {
+        self.quote.check_policy(self.policy,now)?;
+        let (review,_,locked) = self.signing_review()?;
+        ensure!(now >= locked.admitted_at && backend.deployment_commitment()? == locked.deployment,
+            "BCH signing deployment or time differs from retained wallet lock intent");
+        Ok(review)
+    }
+
+    /// Restore exact signed funding after historical validation, including after
+    /// quote expiry. None does not grant retry rights: inspect the signing intent
+    /// through sign_bch_funding, which refuses any uncertain previous attempt.
+    pub fn signed_bch_funding(&self) -> Result<Option<SignedFunding>> {
+        Ok(self.restore_signed_bch_funding()?.map(|(signed,_)|signed))
+    }
+
+    fn restore_signed_bch_funding(&self) -> Result<Option<(SignedFunding,u64)>> {
+        let Some(bytes) = optional(&self.metadata,&record_name(self.quote,"signed"))? else {return Ok(None)};
+        let (review,prepared,locked) = self.signing_review()?;
+        let intent_bytes = self.metadata.read(&record_name(self.quote,"signing-intent"))?;
+        ensure!(intent_bytes.len() <= 4096,"oversized BCH signing intent");
+        let intent: Intent = serde_json::from_slice(&intent_bytes)?;
+        ensure!(intent.schema == ATTEMPT && intent.review == review.commitment
+            && intent.approved_at >= locked.admitted_at && serde_json::to_vec(&intent)? == intent_bytes,
+            "BCH signing intent differs from retained approval");
+        self.quote.check_policy(self.policy,intent.approved_at)?;
+        let record: Record = serde_json::from_slice(&bytes)?;
+        ensure!(record.schema == SIGNED && record.intent == hash(ATTEMPT,&intent_bytes)
+            && serde_json::to_vec(&record)? == bytes,"BCH signed funding record changed");
+        Ok(Some((prepared.preview().verify_signed(&record.raw)?,intent.approved_at)))
+    }
+
+    /// The approved digest must come from an explicit user action over the
+    /// separately displayed review. No automatic approval or transaction relay.
+    /// Persist the attempt before RPC; persist verified signed bytes before
+    /// returning them. Any attempt without a retained result requires manual
+    /// reconciliation, never another signature or an input replacement.
+    pub async fn sign_bch_funding(&mut self, backend: &BchRpc, approved: &[u8;32], now: u64)
+        -> Result<SignedFunding> {
+        let review = self.review_bch_funding_signing(backend,now)?;
+        ensure!(review.commitment == *approved,"BCH signing approval is stale or mismatched");
+        if let Some((signed,approved_at)) = self.restore_signed_bch_funding()? {
+            ensure!(now >= approved_at,"BCH signing request predates retained approval");
+            return Ok(signed)
+        }
+        let name = record_name(self.quote,"signing-intent");
+        ensure!(optional(&self.metadata,&name)?.is_none(),
+            "BCH signing attempt has no retained result; reconcile manually without signing again");
+        let (_,prepared,locked) = self.signing_review()?;
+        backend.observe_funding_inputs(prepared.preview(),&locked.change_address,locked.minimum_confirmations).await?;
+        let wallet_locks = backend.locked_outpoints().await?;
+        ensure!(prepared.preview().transaction().input.iter().all(|i|wallet_locks.contains(&i.previous_output)),
+            "BCH funding inputs are not wallet-locked; reconcile locks explicitly first");
+        let intent = Intent {schema:ATTEMPT.into(),review:*approved,approved_at:now};
+        let intent_bytes = serde_json::to_vec(&intent)?;
+        self.metadata.retain(&name,&intent_bytes)?;
+        let raw = backend.sign_funding(prepared.preview()).await?;
+        let record = Record {schema:SIGNED.into(),intent:hash(ATTEMPT,&intent_bytes),raw};
+        self.metadata.retain(&record_name(self.quote,"signed"),&serde_json::to_vec(&record)?)?;
+        self.signed_bch_funding()?.context("BCH signed funding was not retained")
+    }
+}
