+use super::*;
+use bitcoin::{consensus::deserialize,hex::{DisplayHex,FromHex},hashes::sha256d,
+    sighash::{SighashCache,EcdsaSighashType},secp256k1};
+use std::os::unix::fs::PermissionsExt;
+
+pub(super) fn reply(request: &Value,script: &bitcoin::ScriptBuf,state: &mut State) -> Result<Option<Value>> {
+    ensure!(request["params"].as_array().is_some_and(|p|p.len()==3)
+        && request["params"][1] == json!([]) && request["params"][2] == "ALL|FORKID","unexpected signing parameters");
+    let intent: Value = serde_json::from_slice(&std::fs::read(state.sign_intent.as_ref().context("missing signing intent path")?)?)?;
+    ensure!(intent["schema"] == "monzero-bch-funding-signing-intent-v1" && state.locked,
+        "approval intent and wallet locks must precede signing");
+    state.sign_calls += 1;
+    let raw = Vec::<u8>::from_hex(request["params"][0].as_str().context("missing template")?)?;
+    let mut tx: Transaction = deserialize(&raw)?;
+    ensure!(tx.input.len()==1 && tx.input[0].script_sig.is_empty(),"unexpected signing template");
+    if state.sign_mode == 2 { tx.output[1].value -= Amount::from_sat(1); }
+    if state.sign_mode != 3 {
+        // Independent Bitcoin BIP143 encoder with BCH's 0x41 suffix. Production
+        // verifier builds its own preimage, also checked against BCHN vectors.
+        let mut preimage = Vec::new();
+        SighashCache::new(&tx).segwit_v0_encode_signing_data_to(&mut preimage,0,script,
+            Amount::from_sat(111_000),EcdsaSighashType::All)?;
+        let end = preimage.len(); preimage[end-4..].copy_from_slice(&0x41u32.to_le_bytes());
+        let secp = secp256k1::Secp256k1::new(); let secret = secp256k1::SecretKey::from_slice(&[5;32])?;
+        let signature = secp.sign_ecdsa(&secp256k1::Message::from_digest(sha256d::Hash::hash(&preimage).to_byte_array()),&secret).serialize_der();
+        let key = secp256k1::PublicKey::from_secret_key(&secp,&secret).serialize();
+        let mut bytes = vec![(signature.len()+1) as u8]; bytes.extend(signature.as_ref());
+        bytes.push(if state.sign_mode == 7 {1} else {0x41}); bytes.push(33); bytes.extend(key);
+        tx.input[0].script_sig = bitcoin::ScriptBuf::from_bytes(bytes);
+    }
+    if state.sign_mode == 4 { return Ok(None); } // Signed, reply lost.
+    let mut reply = json!({"hex":serialize(&tx).to_lower_hex_string(),"complete":state.sign_mode!=1});
+    if state.sign_mode == 5 {reply["errors"] = json!([{"error":"fixture"}]);}
+    if state.sign_mode == 6 {reply["hex"] = json!("invalid-hex");}
+    Ok(Some(reply))
+}
+
+pub(super) async fn exercise(mut execution: AdmittedExecution<'_>,setup: &Setup,metadata: &PrivateStore,
+    snapshots: &PrivateStore,server: &Server,rpc: &BchRpc) -> Result<()> {
+    let review = execution.review_bch_funding_signing(rpc,1011)?;
+    assert_eq!(review.details["action"],"sign-only");
+    assert_eq!(review.details["feeAtoms"],1000);
+    let intent_name = format!("{}.bch-funding-signing-intent",setup.quote.terms()["swapId"]);
+    let signed_name = format!("{}.bch-funding-signed",setup.quote.terms()["swapId"]);
+    let intent = metadata.0.join(&intent_name); let signed_path = metadata.0.join(&signed_name);
+    server.state.lock().unwrap().sign_intent = Some(intent.clone());
+    assert!(execution.sign_bch_funding(rpc,&[0;32],1011).await.is_err());
+    assert!(execution.sign_bch_funding(rpc,&review.commitment,2000).await.is_err());
+    assert!(execution.sign_bch_funding(rpc,&review.commitment,1006).await.is_err());
+    // Previous wallet-lock test left the selected input unlocked.
+    assert!(execution.sign_bch_funding(rpc,&review.commitment,1011).await.is_err());
+    assert!(!intent.exists()); assert_eq!(server.state.lock().unwrap().sign_calls,0);
+    server.state.lock().unwrap().ignore = false;
+    execution.lock_bch_funding_inputs(rpc,1011,"bchreg:qchange",3).await?;
+    assert_eq!(execution.review_bch_funding_signing(rpc,1011)?.commitment,review.commitment);
+    // Keep a pre-signing fixture for isolated failure scenarios below.
+    let baseline: Vec<_> = std::fs::read_dir(&metadata.0)?.map(|entry| {
+        let entry = entry?; Ok((entry.file_name(),std::fs::read(entry.path())?))
+    }).collect::<std::io::Result<_>>()?;
+    let signed = execution.sign_bch_funding(rpc,&review.commitment,1012).await?;
+    let raw = serialize(signed.transaction()); let outpoint = signed.lock_outpoint();
+    assert!(signed_path.is_file()); assert_eq!(server.state.lock().unwrap().sign_calls,1);
+    assert_eq!(execution.sign_bch_funding(rpc,&review.commitment,1013).await?.lock_outpoint(),outpoint);
+    assert_eq!(server.state.lock().unwrap().sign_calls,1);
+    assert!(execution.sign_bch_funding(rpc,&review.commitment,1011).await.is_err());
+    drop(execution);
+    let execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    assert_eq!(serialize(execution.signed_bch_funding()?.unwrap().transaction()),raw);
+    assert!(execution.review_bch_funding_signing(rpc,2000).is_err());
+    let record = std::fs::read(&signed_path)?;
+    std::fs::write(&signed_path,b"{}")?;
+    assert!(execution.signed_bch_funding().is_err());
+    std::fs::write(&signed_path,&record)?;
+    let approval = std::fs::read(&intent)?; std::fs::remove_file(&intent)?;
+    assert!(execution.signed_bch_funding().is_err());
+    std::fs::write(&intent,&approval)?; std::fs::set_permissions(&intent,std::fs::Permissions::from_mode(0o600))?;
+    assert_eq!(execution.signed_bch_funding()?.unwrap().lock_outpoint(),outpoint);
+    drop(execution);
+    for mode in 1..=7 {
+        let metadata = PrivateStore::new()?;
+        for (name,bytes) in &baseline {
+            let path = metadata.0.join(name); std::fs::write(&path,bytes)?;
+            std::fs::set_permissions(path,std::fs::Permissions::from_mode(0o600))?;
+        }
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        server.state.lock().unwrap().sign_mode = mode;
+        server.state.lock().unwrap().sign_intent = Some(metadata.0.join(&intent_name));
+        let calls = server.state.lock().unwrap().sign_calls;
+        assert!(execution.sign_bch_funding(rpc,&review.commitment,1012).await.is_err(),"mode {mode}");
+        assert_eq!(server.state.lock().unwrap().sign_calls,calls+1);
+        assert!(metadata.0.join(&intent_name).is_file());
+        assert!(!metadata.0.join(&signed_name).exists());
+        drop(execution);
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        assert!(execution.sign_bch_funding(rpc,&review.commitment,1013).await.is_err());
+        assert_eq!(server.state.lock().unwrap().sign_calls,calls+1); // No signing retry after restart.
+    }
+    Ok(())
+}
