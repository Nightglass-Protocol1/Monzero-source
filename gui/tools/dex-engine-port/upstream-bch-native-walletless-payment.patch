+//! Internal dispatch only; no persisted schema or authority migration.
+use super::*;
+pub(super) enum NativeFundingObserver<'a> {
+    Node(&'a BchRpc),
+    Walletless(&'a OwnedBchObserver),
+}
+impl NativeFundingObserver<'_> {
+    pub(super) fn deployment_commitment(&self)->Result<[u8;32]> {
+        match self {Self::Node(rpc)=>rpc.deployment_commitment(),Self::Walletless(observer)=>observer.deployment_commitment()}
+    }
+    pub(super) async fn check(&self,execution:&AdmittedExecution<'_>,now:u64,safety_blocks:u32)->Result<()> {
+        match self {
+            Self::Node(rpc)=>{execution.check_bch_lock_for_native_funding(rpc,now,safety_blocks).await?;},
+            Self::Walletless(observer)=>{execution.check_light_bch_lock_for_native_funding(observer,now,safety_blocks).await?;},
+        }
+        Ok(())
+    }
+}
