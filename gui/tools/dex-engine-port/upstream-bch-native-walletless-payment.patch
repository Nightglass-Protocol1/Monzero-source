+//! Native wallet fixture with BCH reads through the distinct owned observer.
+use super::*;
+use crate::bch_rpc::observer::OwnedBchObserver;
+use agreement::execution::funding::native::relay::NativeRelayState;
+
+pub(super) async fn exercise(setup:&Setup,original_metadata:&PrivateStore,original_snapshots:&PrivateStore,
+    rpc:&BchRpc,server:&Server)->Result<()> {
+    let observer=OwnedBchObserver::new(server.port,"user".into(),"pass".into(),rpc.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+    let deployment=observer.deployment_commitment()?;
+    let wallet=XmzAddress::parse(setup.policy.xmz_network,&setup.quote.terms()["xmzPayout"])?;
+    let slot=|suffix:&str|format!("{}.bch-funding-native-{suffix}",setup.quote.terms()["swapId"]);
+    for lose_preparation in [true,false] {
+        let metadata=copy_store(original_metadata)?;let snapshots=copy_store(original_snapshots)?;
+        let mut execution=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let destination=execution.restore_agreement()?.owned().wallet().address().clone();
+        let mut fixture=Fixture::new(wallet.clone(),destination,setup.policy.xmz_genesis.clone(),101_000,900).await?;
+        let intent=metadata.0.join(slot("intent"));
+        *fixture.preparation_intent.lock().unwrap()=Some(intent.clone());
+        let review=execution.review_bch_native_preparation(&source(&wallet),deployment,5,1024)?;
+        let wrong=execution.review_bch_native_preparation(&source(&wallet),rpc.deployment_commitment()?,5,1024)?;
+        assert_ne!(wrong.commitment,review.commitment);
+        assert!(execution.prepare_reviewed_light_bch_native_funding(&mut fixture.relay,&observer,source(&wallet),5,1024,&wrong.commitment).await.is_err());
+        assert!(fixture.calls.lock().unwrap().is_empty());assert!(!intent.exists());
+        fixture.balance_available.store(false,Ordering::SeqCst);
+        assert!(execution.prepare_reviewed_light_bch_native_funding(&mut fixture.relay,&observer,source(&wallet),5,1024,&review.commitment).await.is_err());
+        assert!(!intent.exists());fixture.balance_available.store(true,Ordering::SeqCst);
+        server.state.lock().unwrap().observation_mode=21;
+        assert!(execution.prepare_reviewed_light_bch_native_funding(&mut fixture.relay,&observer,source(&wallet),5,1024,&review.commitment).await.is_err());
+        assert!(!intent.exists());server.state.lock().unwrap().observation_mode=0;
+        assert!(!fixture.calls.lock().unwrap().iter().any(|v|v=="transfer" || v=="relay_tx"));
+        fixture.lose_preparation_reply.store(lose_preparation,Ordering::SeqCst);
+        let prepared=execution.prepare_reviewed_light_bch_native_funding(&mut fixture.relay,&observer,source(&wallet),5,1024,&review.commitment).await;
+        assert!(intent.is_file());
+        if lose_preparation {assert!(prepared.is_err());}else{assert_eq!(prepared?.txid,"ab".repeat(32));}
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let before=fixture.calls.lock().unwrap().len();
+        assert!(execution.prepare_bch_native_funding(&mut fixture.relay,rpc,source(&wallet),5,1025).await.is_err());
+        let restored=execution.prepare_light_bch_native_funding(&mut fixture.relay,&observer,source(&wallet),5,2000).await;
+        if lose_preparation {
+            assert!(restored.is_err());assert!(execution.saved_bch_native_preparation()?.unwrap().payment.is_none());
+        }else{
+            assert_eq!(restored?.txid,"ab".repeat(32));
+            assert_eq!(execution.saved_bch_native_preparation()?.unwrap().review.commitment,review.commitment);
+        }
+        assert_eq!(fixture.calls.lock().unwrap().len(),before);
+        assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="transfer").count(),1);
+        if lose_preparation {continue}
+        drop(execution);
+        for lose_reply in [false,true] {
+            let relay_metadata=copy_store(&metadata)?;
+            let mut execution=AdmittedExecution::resume(&relay_metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+            let relay_intent=relay_metadata.0.join(slot("relay-intent"));
+            *fixture.relay_intent.lock().unwrap()=Some(relay_intent.clone());
+            let review=execution.review_bch_native_relay_for_deployment(&deployment,1025)?;
+            let before=fixture.calls.lock().unwrap().len();
+            assert!(execution.relay_bch_native_funding(&mut fixture.relay,rpc,&review.commitment,1025).await.is_err());
+            assert!(execution.relay_light_bch_native_funding(&mut fixture.relay,&observer,&[0;32],1025).await.is_err());
+            assert!(execution.relay_light_bch_native_funding(&mut fixture.relay,&observer,&review.commitment,2000).await.is_err());
+            assert_eq!(fixture.calls.lock().unwrap().len(),before);
+            for mode in [1,3,21,22] {
+                server.state.lock().unwrap().observation_mode=mode;
+                assert!(execution.relay_light_bch_native_funding(&mut fixture.relay,&observer,&review.commitment,1025).await.is_err());
+                assert!(!relay_intent.exists());
+            }
+            server.state.lock().unwrap().observation_mode=0;
+            fixture.balance_available.store(false,Ordering::SeqCst);
+            fixture.lose_reply.store(lose_reply,Ordering::SeqCst);
+            let relays=fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="relay_tx").count();
+            let result=execution.relay_light_bch_native_funding(&mut fixture.relay,&observer,&review.commitment,1025).await;
+            let expected=if lose_reply {assert!(result.is_err());NativeRelayState::Attempted {txid:"ab".repeat(32)}}
+                else {assert_eq!(result?.txid,"ab".repeat(32));NativeRelayState::Acknowledged {txid:"ab".repeat(32)}};
+            assert_eq!(execution.bch_native_relay_state()?,Some(expected.clone()));
+            drop(execution);
+            let mut execution=AdmittedExecution::resume(&relay_metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+            assert_eq!(execution.bch_native_relay_state()?,Some(expected));
+            let before=fixture.calls.lock().unwrap().len();
+            let repeated=execution.relay_light_bch_native_funding(&mut fixture.relay_client()?,&observer,&review.commitment,1026).await;
+            if lose_reply {assert!(repeated.is_err());}else{assert_eq!(repeated?.txid,"ab".repeat(32));}
+            assert_eq!(fixture.calls.lock().unwrap().len(),before);
+            assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="relay_tx").count(),relays+1);
+            assert_eq!(fixture.calls.lock().unwrap().iter().filter(|v|v.as_str()=="transfer").count(),1);
+        }
+    }
+    Ok(())
+}
