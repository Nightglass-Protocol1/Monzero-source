+
+pub(super) async fn exercise(metadata: &PrivateStore,snapshots: &PrivateStore,setup: &Setup,
+    fixture: &Fixture,rpc: &OwnedBchObserver,server: &Server,cancel:&Transaction,transaction: &Transaction) -> Result<()> {
+    {let mut state=server.state.lock().unwrap();
+        ensure!(state.cancel.is_none() && state.punish.is_none() && !state.punishment_mature
+            && !state.recovery_output_spent && state.relay_mode==0 && state.redemption_confirmation_mode==0,"unexpected punishment fixture state");
+        state.cancel=Some(cancel.clone());state.punishment_mature=true;}
+    ensure!(!fixture.incoming.load(Ordering::SeqCst) && !fixture.confirmed.load(Ordering::SeqCst),"unexpected native fixture state");
+    fixture.incoming.store(true,Ordering::SeqCst);fixture.confirmed.store(true,Ordering::SeqCst);
+    let relay=OwnedBchContractRelay::new(rpc);
+    let original_intent=server.state.lock().unwrap().relay_intent.clone();
+    let observer=fixture.funding_client()?;let block=Some(BlockHash::from_byte_array([6;32]));let txid=transaction.compute_txid();
+    for mode in [0,1,2] {
+        let private=copy_store(snapshots)?;
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {let entry=entry?;ensure!(entry.file_type()?.is_file(),"unexpected fixture directory entry");std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let intent=copied.0.join(format!("{}.bch-punish-relay-intent",setup.quote.terms()["swapId"]));
+        let ack=copied.0.join(format!("{}.bch-punish-relay-ack",setup.quote.terms()["swapId"]));
+        {let mut state=server.state.lock().unwrap();state.punish=Some(transaction.clone());state.relay_intent=Some(intent.clone());state.relay_mode=mode;}
+        let calls=server.state.lock().unwrap().punish_relay_calls;
+        let review=execution.review_light_bch_punish_relay(rpc,2031)?;
+        let changed=OwnedBchObserver::new(1,"user".into(),"pass".into(),rpc.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+        assert!(execution.review_light_bch_punish_relay(&changed,2031).is_err());
+        assert!(execution.observe_light_bch_punish_window(&observer,&changed,block,2031).await.err()
+            .context("changed observer accepted")?.to_string().contains("changes observer"));
+        assert!(execution.relay_light_bch_punish(&observer,&OwnedBchContractRelay::new(&changed),block,&review.commitment,2032).await.err()
+            .context("changed relay observer accepted")?.to_string().contains("changes observer"));
+        if mode==0 {
+            fixture.confirmed.store(false,Ordering::SeqCst);
+            assert!(execution.observe_light_bch_punish_window(&observer,rpc,block,2031).await.is_err());
+            fixture.confirmed.store(true,Ordering::SeqCst);
+            let window=execution.observe_light_bch_punish_window(&observer,rpc,block,2031).await?;
+            assert_eq!(window.review(),&review.commitment);
+            assert_eq!(window.recovery_output().confirmations(),30);
+            assert_eq!(server.state.lock().unwrap().punish_relay_calls,calls);
+        }
+
+        assert!(execution.observe_light_bch_punish(rpc,block).await.is_err());
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_light_bch_punish(&observer,&relay,block,&bad,2032).await.is_err());assert!(!intent.exists());
+        if mode==0 {
