+        assert!(restored.relay_light_bch_punish(&observer,&relay,None,&review.commitment,2031).await.err()
+            .context("backwards punishment time accepted")?.to_string().contains("time moved backwards"));
+        assert!(restored.observe_light_bch_punish(&changed,block).await.err()
+            .context("changed confirmation observer accepted")?.to_string().contains("observer changed"));
+        let result=restored.relay_light_bch_punish(&observer,&relay,None,&review.commitment,2033).await;
+        if mode==0 {assert_eq!(result?,txid);} else {assert!(result.err().context("uncertain punishment retried")?.to_string().contains("outcome uncertain"));}
+        assert_eq!(server.state.lock().unwrap().punish_relay_calls,calls+1);
+        assert_eq!(restored.observe_light_bch_punish(rpc,block).await?.confirmation().transaction(),transaction);
+        assert_eq!(restored.observe_light_bch_punish(rpc,None).await?.review(),&review.commitment);
+        assert_eq!(restored.bch_punish_relay_state()?,Some(expected));
+        if mode==0 {
+            for invalid in [1,2,3] {server.state.lock().unwrap().redemption_confirmation_mode=invalid;assert!(restored.observe_light_bch_punish(rpc,block).await.is_err());}
+            server.state.lock().unwrap().redemption_confirmation_mode=0;
