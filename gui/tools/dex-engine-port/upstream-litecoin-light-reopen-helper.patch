+    /// Look up an existing operation without allocating an address. Missing
+    /// identity is absence, never permission to create recovery change.
+    pub fn reserved(&self,request:Uuid,branch:Branch)->Result<Option<DerivedAddress>> {
+        ensure!(!request.is_nil(),"missing Litecoin address request identity");
+        ensure!(self.usable && self.journal.read(NAME)?==self.bytes,
+            "Litecoin address book requires validated reopen");
+        match self.record.entries.iter().find(|entry|entry.request==request) {
+            Some(entry)=>{
+                ensure!(entry.branch==branch.index() as u8,"Litecoin address request reused for another branch");
+                Ok(Some(self.account.derive(branch,entry.index)?))
+            },
+            None=>Ok(None),
+        }
+    }
