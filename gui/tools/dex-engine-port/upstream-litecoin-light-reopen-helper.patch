+
+#[test]
+fn reserved_lookup_never_allocates_and_checks_saved_record()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    let operation=Uuid::new_v4();let first=fs::read(dir.0.join(NAME))?;
+    assert!(book.reserved(operation,Branch::Change)?.is_none());
+    assert_eq!(fs::read(dir.0.join(NAME))?,first);
+    let address=book.reserve(operation,Branch::Change)?.address().to_string();drop(book);
+    let book=AddressBook::open(&dir.0,standard())?;let bytes=fs::read(dir.0.join(NAME))?;
+    assert_eq!(book.reserved(operation,Branch::Change)?.unwrap().address().to_string(),address);
+    assert!(book.reserved(operation,Branch::Receive).is_err());assert!(book.reserved(Uuid::nil(),Branch::Change).is_err());
+    assert!(book.reserved(Uuid::new_v4(),Branch::Change)?.is_none());
+    assert_eq!(fs::read(dir.0.join(NAME))?,bytes);
+    fs::write(dir.0.join(NAME),b"{}")?;assert!(book.reserved(operation,Branch::Change).is_err());Ok(())
+}
