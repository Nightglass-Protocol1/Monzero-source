     assert_eq!(book.allocated_count(Branch::Receive)?,2);assert_eq!(book.allocated_count(Branch::Change)?,3);
     assert_eq!(book.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string(),"84'/1'/0'/1/3");Ok(())
