+//! Read-only status from the independently configured owned BCHN deployment.
+//! Not an SPV proof, a release decision, a maturity check or a relay permit.
+use super::*;
+use bitcoin::Txid;
+use swap_core::bch::funding::SignedFunding;
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum FundingStatus {
+    ConfirmedUnspent { confirmations: u64 },
+    Mempool { lock_output_unspent: bool },
+    /// Includes unknown, evicted, conflicted, or confirmed-and-already-spent.
+    /// Never evidence that this transaction was not previously broadcast.
+    Unobserved,
+}
+pub struct FundingObservation { txid: Txid, tip: BlockHash, status: FundingStatus }
+impl FundingObservation {
+    pub fn txid(&self) -> Txid { self.txid }
+    pub fn tip(&self) -> BlockHash { self.tip }
+    pub fn status(&self) -> FundingStatus { self.status }
+}
+#[derive(Deserialize)]
+struct MempoolEntry { size: u64 }
+
+impl BchRpc {
+    /// Inspect the exact signed legacy ID and its contract output, including
+    /// mempool spends. Mempool state can change without a change of chain tip.
+    /// A later action must reobserve and apply its own protocol release policy.
+    pub async fn observe_funding(&self,signed: &SignedFunding) -> Result<FundingObservation> {
+        let chain = self.chain_state().await?; let tip = chain.bestblockhash; self.wallet_ready().await?;
+        let outpoint = signed.lock_outpoint();
+        let expected = &signed.transaction().output[outpoint.vout as usize];
+        let raw = self.rpc(false,"gettxout",json!([outpoint.txid,outpoint.vout,true])).await?;
+        let output: Option<Output> = serde_json::from_str(raw.get())?;
+        if let Some(output) = &output {
+            ensure!(output.bestblock == tip && output.confirmations <= chain.blocks+1 && !output.coinbase && output.tokens.is_none()
+                && atoms(output.value.get())? == expected.value.to_sat()
+                && ScriptBuf::from_hex(&output.script.hex)? == expected.script_pubkey,
+                "BCH observed funding output differs from retained transaction");
+        }
+        let status = match output.as_ref() {
+            Some(output) if output.confirmations > 0 => FundingStatus::ConfirmedUnspent {confirmations:output.confirmations},
+            _ => {
+                let raw = self.rpc_optional(false,"getmempoolentry",json!([outpoint.txid]),true).await?;
+                match raw {
+                    Some(raw) => {
+                        let entry: MempoolEntry = serde_json::from_str(raw.get())?;
+                        // BCH legacy txid binds these exact bytes. A witness
+                        // alternative with the same ID is already unsupported.
+                        ensure!(entry.size == serialize(signed.transaction()).len() as u64,
+                            "BCH mempool entry differs from retained transaction size");
+                        FundingStatus::Mempool {lock_output_unspent:output.is_some()}
+                    },
+                    None => {
+                        ensure!(output.is_none(),"BCH funding output/mempool observations contradict each other");
+                        FundingStatus::Unobserved
+                    },
+                }
+            },
+        };
+        self.wallet_ready().await?;
+        ensure!(self.chain().await? == tip,"BCH tip changed during funding observation");
+        Ok(FundingObservation {txid:outpoint.txid,tip,status})
+    }
+}
