+use super::*;
+use crate::bch_rpc::observation::FundingStatus;
+use swap_core::bch::funding::SignedFunding;
+
+pub(super) fn output(request: &Value,state: &State) -> Result<Value> {
+    let tx = state.observed.as_ref().context("missing observed funding fixture")?;
+    ensure!(request["params"] == json!([tx.compute_txid(),state.observed_vout,true]),"wrong observed contract output");
+    let mode = state.observation_mode;
+    if matches!(mode,2|3|9|10|11|12|13|15|16|17|19) {return Ok(Value::Null)}
+    let expected = &tx.output[state.observed_vout as usize];
+    ensure!(expected.value.to_sat()==100_000,"unexpected fixture amount");
+    let mut output = json!({"bestblock":"08".repeat(32),"confirmations":if mode==1 || mode==14 {0} else {3},
+        "coinbase":mode==7,"value":0.001,"scriptPubKey":{"hex":expected.script_pubkey.to_hex_string(),"addresses":[]}});
+    match mode {
+        4 => output["scriptPubKey"]["hex"] = json!("51"),
+        5 => output["value"] = json!(0.001001),
+        6 => output["tokenData"] = json!({"category":"01".repeat(32)}),
+        8 => output["bestblock"] = json!("09".repeat(32)),
+        18 => output["confirmations"] = json!(-1),
+        20 => output["confirmations"] = json!(999),
+        _ => (),
+    }
+    Ok(output)
+}
+pub(super) fn mempool(request: &Value,state: &State) -> Result<(Value,Value,&'static str)> {
+    let tx = state.observed.as_ref().context("missing observed funding fixture")?;
+    ensure!(request["params"] == json!([tx.compute_txid()]),"wrong mempool transaction");
+    let mode = state.observation_mode;
+    if matches!(mode,2|9|10|14|15|19) {
+        return Ok((if mode==15 {json!({})} else {Value::Null},
+            json!({"code":if mode==9 {-28} else {-5},"message":"fixture"}),
+            if mode==10 {"401 Unauthorized"} else if mode==19 {"200 OK"} else {"500 Internal Server Error"}))
+    }
+    let result = if mode==13 {Value::Null} else {json!({"size":serialize(tx).len()+usize::from(mode==12)})};
+    Ok((result,Value::Null,if mode==16 {"500 Internal Server Error"} else {"200 OK"}))
+}
+
+pub(super) async fn exercise(execution: &AdmittedExecution<'_>,rpc: &BchRpc,server: &Server,
+    signed: &SignedFunding) -> Result<()> {
+    for mode in 0..=20 {
+        {
+            let mut state = server.state.lock().unwrap();
+            state.observed = Some(signed.transaction().clone()); state.observed_vout = signed.lock_outpoint().vout;
+            state.observation_mode = mode; state.observation_chain_calls = 0;
+        }
+        let observed = execution.observe_signed_bch_funding(rpc).await;
+        let expected = match mode {
+            0 => Some(FundingStatus::ConfirmedUnspent {confirmations:3}),
+            1 => Some(FundingStatus::Mempool {lock_output_unspent:true}),
+            2|19 => Some(FundingStatus::Unobserved),
+            3 => Some(FundingStatus::Mempool {lock_output_unspent:false}),
+            _ => None,
+        };
+        if let Some(expected) = expected {
+            let observed = observed?;
+            assert_eq!(observed.status(),expected); assert_eq!(observed.txid(),signed.lock_outpoint().txid);
+            assert_eq!(observed.tip(),BlockHash::from_byte_array([8;32]));
+        } else {assert!(observed.is_err(),"observation case {mode}");}
+    }
+    let mut state = server.state.lock().unwrap(); state.observed = None; state.observation_mode = 0;
+    assert_eq!(state.sign_calls,1); // All observations stayed read-only.
+    Ok(())
+}
