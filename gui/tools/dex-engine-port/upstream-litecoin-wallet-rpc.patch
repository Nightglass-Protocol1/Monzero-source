+//! Bounded transport envelope for fresh, mutually signed Litecoin quotes.
+//! Signatures are public; secret keys and historical acceptance are never imported.
+use super::*;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct Envelope { schema:String,payload:String,ltc_signature:String,xmz_signature:String }
+fn signature(text:&str)->Result<[u8;64]> {
+    ensure!(text.len()==128 && text.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid Litecoin envelope signature encoding");
+    let mut bytes=[0;64];
+    for (i,byte) in bytes.iter_mut().enumerate() {*byte=u8::from_str_radix(&text[i*2..i*2+2],16)?;}
+    Ok(bytes)
+}
+impl VerifiedLtcQuote {
+    pub fn to_envelope(&self)->Result<Vec<u8>> {
+        let bytes=serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-signed-quote-envelope-v1",
+            "payload":serde_json::to_string(&self.terms)?,"ltcSignature":hex(&self.ltc_signature),
+            "xmzSignature":hex(&self.xmz_signature)}))?;
+        ensure!(bytes.len()<=16384,"oversized Litecoin quote envelope");
+        Ok(bytes)
+    }
+    /// This is fresh verification against independently configured pins/policy.
+    /// Importing a signed envelope does not supply user consent or chain evidence.
+    pub fn from_envelope(bytes:&[u8],now:u64,policy:&Policy,pins:[[u8;32];2])->Result<Self> {
+        ensure!(!bytes.is_empty() && bytes.len()<=16384,"invalid Litecoin quote envelope length");
+        let value:serde_json::Value=serde_json::from_slice(bytes)?;
+        ensure!(serde_json::to_vec(&value)?==bytes,"noncanonical Litecoin quote envelope");
+        let envelope:Envelope=serde_json::from_value(value)?;
+        ensure!(envelope.schema=="monzero-ltc-signed-quote-envelope-v1","invalid Litecoin quote envelope schema");
+        Self::verify(envelope.payload.as_bytes(),now,policy,&pins[0],&pins[1],
+            &signature(&envelope.ltc_signature)?,&signature(&envelope.xmz_signature)?)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fresh_envelope_preserves_signatures_and_rejects_context_or_encoding_changes()->Result<()> {
+        let (policy,terms)=super::super::tests::fixture();
+        let quote=super::super::tests::signed(&terms,&policy,1000)?;
+        let pins=[ed25519_dalek::SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            ed25519_dalek::SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()];
+        let bytes=quote.to_envelope()?;
+        let imported=VerifiedLtcQuote::from_envelope(&bytes,1000,&policy,pins)?;
+        assert_eq!(imported.terms(),quote.terms());assert_eq!(imported.commitment(),quote.commitment());
+        assert_eq!(imported.to_envelope()?,bytes);
+        assert!(VerifiedLtcQuote::from_envelope(&bytes,2000,&policy,pins).is_err());
+        assert!(VerifiedLtcQuote::from_envelope(&bytes,1000,&policy,[pins[1],pins[0]]).is_err());
+        let mut wrong_policy=policy.clone();wrong_policy.xmz_genesis="b".repeat(64);
+        assert!(VerifiedLtcQuote::from_envelope(&bytes,1000,&wrong_policy,pins).is_err());
+        let mut spaced=bytes.clone();spaced.push(b' ');
+        let mut duplicate=bytes.clone();duplicate.splice(1..1,b"\"schema\":\"other\",".iter().copied());
+        for changed in [vec![],vec![b' ';16385],spaced,duplicate] {
+            assert!(VerifiedLtcQuote::from_envelope(&changed,1000,&policy,pins).is_err());
+        }
+        let original:serde_json::Value=serde_json::from_slice(&bytes)?;
+        for (field,value) in [("schema",serde_json::json!("other")),("privateKey",serde_json::json!("forbidden")),
+            ("payload",serde_json::json!("{}")),("ltcSignature",serde_json::json!("AA".repeat(64))),
+            ("xmzSignature",serde_json::json!("0".repeat(128)))] {
+            let mut altered=original.clone();altered[field]=value;
+            assert!(VerifiedLtcQuote::from_envelope(&serde_json::to_vec(&altered)?,1000,&policy,pins).is_err());
+        }
+        Ok(())
+    }
+}
