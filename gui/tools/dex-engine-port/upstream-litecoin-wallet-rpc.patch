+//! Authenticated LTC/XMZ key exchange, not funding authority. Transport and
+//! durable secret/cursor storage belong to the execution driver. Frames contain
+//! private view-key shares: never log them or publish them with order-book data.
+use anyhow::{Context, Result, ensure};
+use swap_core::compat::IntoDalekNg;
+use ed25519_dalek::{Signature, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use curve25519_dalek_ng::{edwards::{CompressedEdwardsY, EdwardsPoint}, scalar::Scalar, traits::Identity};
+use sigma_fun::ext::dl_secp256k1_ed25519_eq::CrossCurveDLEQProof;
+use swap_core::{bitcoin::{PublicKey, SecretKey, build_shared_output_descriptor}, monero,
+    litecoin_address::LtcSegwitAddress, xmz_address::XmzAddress};
+use crate::{common::CROSS_CURVE_PROOF_SYSTEM, litecoin_quote::{Policy, VerifiedLtcQuote}};
+
+const DOMAIN: &str = "monzero-ltc-xmz-key-exchange-v1";
+const MAX_FRAME: usize = 200_000;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct KeyShare {
+    pub contract_key: PublicKey,
+    pub adaptor_key: PublicKey,
+    pub native_spend_key: [u8;32],
+    pub view_share: [u8;32],
+    pub proof: CrossCurveDLEQProof,
+}
+
+/// Secret state must remain available until settlement/recovery is complete.
+/// No Debug or implicit serialization. Explicit checkpoints contain secrets;
+/// their durable private storage remains the driver's responsibility.
+pub struct LocalKeys { contract: SecretKey, spend: monero::Scalar, view: monero::PrivateViewKey, share: KeyShare }
+impl LocalKeys {
+    pub fn generate<R: rand::RngCore + rand::CryptoRng>(rng: &mut R) -> (Self, KeyShare) {
+        let contract = SecretKey::new_random(rng);
+        let spend = monero::Scalar::random(rng);
+        let view = monero::PrivateViewKey::new_random(rng);
+        let (proof, (secp, edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&spend.into_dalek_ng(), rng);
+        let share = KeyShare { contract_key:contract.public(), adaptor_key:secp.into(),
+            native_spend_key:edwards.compress().to_bytes(), view_share:view.0.as_bytes(), proof };
+        (Self { contract, spend, view, share:share.clone() }, share)
+    }
+    /// Rebuild a share from caller-owned secret storage. Replaying a prior
+    /// transcript additionally requires its original proof/frame bytes.
+    pub fn from_secrets<R: rand::RngCore + rand::CryptoRng>(contract: SecretKey,
+        spend: monero::Scalar, view: monero::PrivateViewKey, rng: &mut R) -> Result<(Self, KeyShare)> {
+        let scalar=spend.into_dalek_ng();
+        ensure!(scalar != Scalar::zero() && scalar.as_bytes()[31] & 0x10 == 0,
+            "native spend secret is outside the cross-curve proof range");
+        let (proof,(secp,edwards))=CROSS_CURVE_PROOF_SYSTEM.prove(&scalar,rng);
+        let share=KeyShare { contract_key:contract.public(), adaptor_key:secp.into(),
+            native_spend_key:edwards.compress().to_bytes(), view_share:view.0.as_bytes(), proof };
+        validate_share(&share)?;
+        Ok((Self { contract,spend,view,share:share.clone() },share))
+    }
+    pub fn contract_secret(&self) -> &SecretKey { &self.contract }
+    pub fn native_spend_secret(&self) -> &monero::Scalar { &self.spend }
+    pub fn private_view_share(&self) -> &monero::PrivateViewKey { &self.view }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all="camelCase")]
+struct Frame { schema: String, quote_commitment: String, swap_id: String, sequence: u8,
+    previous: String, share: KeyShare }
+
+/// Both peers accept the same two frames, including their own. A failed frame
+/// does not advance this in-memory cursor. Restart must not reset it to authorize
+/// replay against an already-funded trade.
+#[derive(Clone, Copy)]
+pub enum LocalRole { LitecoinFunder, NativeFunder }
+
+pub struct KeyExchange {
+    commitment: [u8;32], swap: uuid::Uuid, policy: Policy, pins: [VerifyingKey;2],
+    local_sequence: u8, local_share: Vec<u8>, quote_record: Vec<u8>,
+    expiry: u64, started_at: u64, next: u8, previous: [u8;32], shares: Vec<KeyShare>,
+    accepted: Vec<secret_state::AcceptedFrame>,
+}
+
+/// Validated key material only. Recovery signatures and native funding evidence
+/// are separate protocol steps. Private view material must remain private.
+pub struct VerifiedKeys {
+    commitment: [u8;32], swap: uuid::Uuid, transcript: [u8;32], local_sequence: u8,
+    a: PublicKey, b: PublicKey, adaptor_a: PublicKey, adaptor_b: PublicKey,
+    contract: LtcSegwitAddress, native_address: XmzAddress, view: [u8;32],
+}
+impl VerifiedKeys {
+    pub(crate) fn require_ltc_funder(&self) -> Result<()> {
+        ensure!(self.local_sequence==0,"native-funder key context cannot sign Litecoin funding");
+        Ok(())
+    }
+    pub fn check_quote(&self, quote: &VerifiedLtcQuote) -> Result<()> {
+        ensure!(self.commitment == *quote.commitment() && self.swap.to_string() == quote.terms()["swapId"],
+            "Litecoin keys belong to another signed quote");
+        Ok(())
+    }
+    #[cfg(unix)]
+    pub fn recovery_policy(&self, quote: &VerifiedLtcQuote, policy: &Policy, now: u64)
+        -> Result<crate::litecoin_rpc::reservation::RecoveryPolicy> {
+        self.check_quote(quote)?;
+        let a: bitcoin::PublicKey = self.a.try_into()?;
+        let b: bitcoin::PublicKey = self.b.try_into()?;
+        quote.recovery_policy(policy, now, a.to_string(), b.to_string())
+    }
+    /// Public binding only, never the private view shares or local secrets.
+    pub(crate) fn public_record(&self, quote: &VerifiedLtcQuote) -> Result<Vec<u8>> {
+        self.check_quote(quote)?;
+        canonical(&serde_json::json!({"schema":"monzero-ltc-key-binding-v1",
+            "swapId":self.swap.to_string(), "quoteCommitment":hex(&self.commitment),
+            "transcript":hex(&self.transcript), "contract":self.contract.to_string(),
+            "nativeAddress":self.native_address.to_string(),
+            "contractA":self.a, "contractB":self.b,
+            "adaptorA":self.adaptor_a, "adaptorB":self.adaptor_b}))
+    }
+    pub fn contract_keys(&self) -> (PublicKey, PublicKey) { (self.a,self.b) }
+    pub fn adaptor_keys(&self) -> (PublicKey, PublicKey) { (self.adaptor_a,self.adaptor_b) }
+    pub fn contract_address(&self) -> &LtcSegwitAddress { &self.contract }
+    pub fn native_address(&self) -> &XmzAddress { &self.native_address }
+    pub fn private_view_key(&self) -> &[u8;32] { &self.view }
+    pub fn transcript_commitment(&self) -> &[u8;32] { &self.transcript }
+}
+
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+fn canonical<T: Serialize>(value: &T) -> Result<Vec<u8>> {
+    fn sorted(value: serde_json::Value) -> serde_json::Value {
+        match value {
+            serde_json::Value::Object(map) => serde_json::Value::Object(map.into_iter()
+                .collect::<std::collections::BTreeMap<_,_>>().into_iter().map(|(k,v)|(k,sorted(v))).collect()),
+            serde_json::Value::Array(values) => serde_json::Value::Array(values.into_iter().map(sorted).collect()),
+            value => value,
+        }
+    }
+    Ok(serde_json::to_vec(&sorted(serde_json::to_value(value)?))?)
+}
+
+pub fn signing_bytes(frame: &[u8]) -> Result<Vec<u8>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX_FRAME, "invalid Litecoin proof frame size");
+    let mut bytes = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",DOMAIN.len(),DOMAIN,frame.len()).into_bytes();
+    bytes.extend_from_slice(frame); Ok(bytes)
+}
+fn validate_share(share: &KeyShare) -> Result<(EdwardsPoint, Scalar)> {
+    ensure!(share.contract_key != share.adaptor_key, "Litecoin contract key reused as adaptor key");
+    let native = CompressedEdwardsY(share.native_spend_key).decompress().context("invalid native proof key")?;
+    ensure!(native.compress().to_bytes() == share.native_spend_key && native.is_torsion_free()
+        && native != EdwardsPoint::identity(), "noncanonical or degenerate native proof key");
+    let view = Scalar::from_canonical_bytes(share.view_share).context("invalid private view-key share")?;
+    ensure!(view != Scalar::zero(), "zero private view-key share");
+    ensure!(CROSS_CURVE_PROOF_SYSTEM.verify(&share.proof,(share.adaptor_key.into(),native)),
+        "Litecoin/native cross-curve proof does not verify");
+    Ok((native,view))
+}
+
+impl KeyExchange {
+    pub fn new(quote: &VerifiedLtcQuote, policy: &Policy, now: u64, role: LocalRole, keys: &LocalKeys) -> Result<Self> {
+        quote.check_policy(policy,now)?;
+        let pin = |field: &str| -> Result<VerifyingKey> {
+            let value = &quote.terms()[field]; let mut bytes=[0u8;32];
+            for (i,byte) in bytes.iter_mut().enumerate() { *byte=u8::from_str_radix(&value[i*2..i*2+2],16)?; }
+            Ok(VerifyingKey::from_bytes(&bytes)?)
+        };
+        Ok(Self { commitment:*quote.commitment(),swap:quote.terms()["swapId"].parse()?,policy:policy.clone(),
+            pins:[pin("ltcFunder")?,pin("xmzFunder")?],expiry:quote.terms()["expiresAt"].parse()?,
+            local_sequence:match role { LocalRole::LitecoinFunder=>0, LocalRole::NativeFunder=>1 },
+            local_share:canonical(&keys.share)?, quote_record:quote.record()?, started_at:now, next:0,previous:[0;32],shares:Vec::new(),accepted:Vec::new() })
+    }
+    fn prepare(&self, share: KeyShare) -> Result<Vec<u8>> {
+        ensure!(self.next < 2, "Litecoin key exchange already complete");
+        let bytes=canonical(&Frame { schema:DOMAIN.into(),quote_commitment:hex(&self.commitment),swap_id:self.swap.to_string(),
+            sequence:self.next,previous:hex(&self.previous),share })?;
+        ensure!(bytes.len()<=MAX_FRAME,"oversized Litecoin proof frame"); Ok(bytes)
+    }
+    /// Produce only this node's own frame, in its turn, while the quote is live.
+    pub fn prepare_local(&self, now: u64) -> Result<Vec<u8>> {
+        ensure!(self.next==self.local_sequence && now>=self.started_at && now<self.expiry,
+            "wrong turn or expired Litecoin local frame");
+        let share=serde_json::from_slice(&self.local_share)
+            .map_err(|_|anyhow::anyhow!("invalid held Litecoin key share"))?;
+        self.prepare(share)
+    }
+    pub fn accept(&mut self, bytes: &[u8], signature: &[u8], now: u64) -> Result<()> {
+        ensure!(self.next < 2 && now < self.expiry && now >= self.accepted.last().map_or(self.started_at,|f|f.accepted_at) && !bytes.is_empty() && bytes.len() <= MAX_FRAME,
+            "expired or completed Litecoin key exchange");
+        let frame: Frame=serde_json::from_slice(bytes).map_err(|_| anyhow::anyhow!("invalid Litecoin proof frame encoding"))?;
+        ensure!(frame.schema==DOMAIN && frame.quote_commitment==hex(&self.commitment)
+            && frame.swap_id==self.swap.to_string() && frame.sequence==self.next && frame.previous==hex(&self.previous),
+            "wrong Litecoin proof exchange context");
+        ensure!(self.prepare(frame.share.clone())? == bytes,"noncanonical Litecoin proof frame");
+        self.pins[usize::from(self.next)].verify_strict(&signing_bytes(bytes)?,&Signature::from_slice(signature)?)?;
+        if self.next == self.local_sequence {
+            ensure!(canonical(&frame.share)? == self.local_share, "Litecoin local frame differs from held secrets");
+        }
+        validate_share(&frame.share)?;
+        if let Some(first)=self.shares.first() {
+            for key in [frame.share.contract_key,frame.share.adaptor_key] {
+                ensure!(key!=first.contract_key && key!=first.adaptor_key,"Litecoin peer key reuse across roles");
+            }
+            let (left,left_view)=validate_share(first)?; let (right,right_view)=validate_share(&frame.share)?;
+            ensure!(left+right!=EdwardsPoint::identity() && left_view+right_view!=Scalar::zero(),
+                "degenerate combined native keys");
+        }
+        let mut digest=Sha256::new(); digest.update(DOMAIN); digest.update([0]); digest.update(bytes); digest.update(signature);
+        self.previous=digest.finalize().into(); self.shares.push(frame.share);
+        self.accepted.push(secret_state::AcceptedFrame { bytes:bytes.to_vec(),signature:signature.to_vec(),accepted_at:now });
+        self.next+=1; Ok(())
+    }
+    pub fn finish(self) -> Result<VerifiedKeys> {
+        ensure!(self.next==2 && self.shares.len()==2,"incomplete Litecoin key exchange");
+        let (bob,alice)=(&self.shares[0],&self.shares[1]);
+        let (b_native,b_view)=validate_share(bob)?; let (a_native,a_view)=validate_share(alice)?;
+        let view=a_view+b_view;
+        let spend=monero_oxide_ext::PublicKey::from_slice(&(a_native+b_native).compress().to_bytes())?;
+        let public_view=monero_oxide_ext::PublicKey::from_slice(&(&view * &curve25519_dalek_ng::constants::ED25519_BASEPOINT_TABLE).compress().to_bytes())?;
+        let native_address=XmzAddress::new(self.policy.xmz_network,monero_address::AddressType::Legacy,spend.decompress(),public_view.decompress())?;
+        let descriptor=build_shared_output_descriptor(alice.contract_key.into(),bob.contract_key.into())?;
+        Ok(VerifiedKeys { commitment:self.commitment,swap:self.swap,transcript:self.previous,local_sequence:self.local_sequence,
