+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum RefundAction { Send, Retransmit }
+impl RefundAction {
+    fn label(self)->&'static str {match self {Self::Send=>"send",Self::Retransmit=>"retransmit"}}
+}
+/// Public review only. This token does not authenticate a user gesture by itself;
+/// the GUI must present the review and obtain deliberate approval for this action.
+pub struct RefundReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+fn commitment(details:&serde_json::Value)->Result<[u8;32]> {
+    let mut digest=Sha256::new();
+    digest.update(b"MONZERO-LTC-NATIVE-REFUND-APPROVAL-V1\0");
+    digest.update(serde_json::to_vec(details)?);
+    Ok(digest.finalize().into())
+}
+impl Execution {
+    /// Recover and bind existing preparation; never construct a new payment or
+    /// broadcast. May finish publication of a retained preparation after a crash.
+    pub fn review_native_refund_payment(&mut self,action:RefundAction)->Result<RefundReview> {
+        let prepared=self.load_prepared_native_refund_payout()?;
+        let (head,bytes,_,_,_)=self.load()?;
+        let dispatch=match action {
+            RefundAction::Send=>{
+                ensure!(head.native_refund_payout_dispatch.is_none(),"refund already attempted; explicit retransmission review required");
+                match self.metadata.read(&super::refund_payout_relay::dispatch_name(self.claim.trade)) {
+                    Ok(_)=>anyhow::bail!("retained refund attempt requires explicit retransmission review"),
+                    Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                    Err(e)=>return Err(e),
+                }
+                None
+            },
+            RefundAction::Retransmit=>Some(self.checked_refund_payout_dispatch(&head)?),
+        };
+        let terms=prepared.terms();
+        let amount=prepared.preview().recipient.atoms().checked_add(prepared.preview().reserve_return.atoms())
+            .context("refund recipient amount overflow")?;
+        ensure!(terms["destination"]==terms["reserveReturn"],"refund has split destinations");
+        let details=serde_json::json!({"schema":"monzero-ltc-native-refund-review-v1",
+            "tradeId":head.trade,"quoteCommitment":hex(&head.quote),"journalCommitment":hex(&Sha256::digest(&bytes)),
+            "preparedCommitment":hex(&head.native_refund_payout.context("refund lacks preparation")?),
+            "dispatchCommitment":dispatch.map(|value|hex(&value)),"action":action.label(),
+            "txid":terms["txid"],"destination":terms["destination"],"refundAtoms":amount.to_string(),
+            "feeAtoms":prepared.preview().network_fee.atom_string(),"maximumFeeAtoms":terms["maximumFeeAtoms"],
+            "lockedAtoms":terms["lockedAtoms"],"chainObserved":false});
+        Ok(RefundReview {commitment:commitment(&details)?,details})
+    }
+    /// Native GUI bridge entry point. The caller supplies the exact displayed
+    /// commitment after consent; fresh two-chain preflight still happens below.
+    pub async fn relay_reviewed_native_refund(&mut self,action:RefundAction,approved:[u8;32],
+        native:&mut NativeTransferRelay,ltc:&LitecoinRpc,block:bitcoin::BlockHash)->Result<RelayedTransfer> {
+        let current=self.review_native_refund_payment(action)?;
