+//! Alice's exact native-funding preparation, retained before any relay API.
+//! Wallet ownership is caller supplied. Construction may retry under the same
+//! intent until exact prepared bytes exist; preparation never broadcasts.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::relay::{NativeTransferRelay,RelayRequest,RelayedTransfer,
+    lock_checkpoint::PreparedNativeLock}};
+use swap_core::xmz::XmzAmount;
+use zeroize::Zeroizing;
+
+/// Caller-selected source wallet; recipient and principal come only from the
+/// authenticated quote and completed key exchange, never these options.
+pub struct NativeFundingSource { pub wallet:XmzAddress,pub account:u32,pub priority:u32 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema:String,checkpoint:[u8;32],quote:[u8;32],genesis:String,wallet:String,destination:String,
+    amount:u64,maximum_fee:u64,account:u32,priority:u32,admitted_at:u64,
+}
+pub(super) fn intent_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-lock-intent") }
+pub(super) fn prepared_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-lock-prepared") }
+fn summary(prepared:&PreparedNativeLock)->RelayedTransfer {
+    let value=prepared.summary();
+    RelayedTransfer { txid:value.txid.clone(),fee:value.fee,weight:value.weight }
+}
+fn missing(error:&anyhow::Error)->bool {
+    error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)
+}
+impl Execution {
+    /// Prepare once, with broadcast disabled. The intent is pinned before asking
+    /// the wallet to construct anything. Retained preparations are never replaced.
+    pub async fn prepare_native_lock(&mut self,relay:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        source:NativeFundingSource,safety_blocks:u32,now:u64)->Result<RelayedTransfer> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong native funding role");
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        ensure!(source.wallet.network()==self.policy.xmz_network && (1..=4).contains(&source.priority),
+            "invalid native funding source");
+        let filename=intent_name(self.claim.trade);
+        let retained=match self.metadata.read(&filename) {
+            Ok(bytes)=>{
+                let saved:Intent=serde_json::from_slice(&bytes)?;
+                ensure!(saved.wallet==source.wallet.to_string() && saved.account==source.account
+                    && saved.priority==source.priority,"native funding source already committed");
+                let prepared=Journal::open(&self.snapshots)?.read(&prepared_name(self.claim.trade)).map(Zeroizing::new);
+                match prepared {
+                    Ok(_)=>return self.recover_prepared_native_lock(),
+                    Err(e) if missing(&e)=>ensure!(head.native_lock.is_none(),"committed preparation is missing"),
+                    Err(e)=>return Err(e),
+                }
+                Some((bytes,saved.admitted_at))
+            },
+            Err(e) if missing(&e)=>None,
+            Err(e)=>return Err(e),
+        };
+        quote.check_policy(&self.policy,now)?;
+        let (_,agreement_at)=self.recovery_admission(&head)?;
+        ensure!(now>=agreement_at,"native funding predates recovery agreement");
+        let amount=quote.terms()["xmzAtoms"].parse()?;
+        let maximum_fee=quote.terms()["xmzNativeFeeMaxAtoms"].parse()?;
+        let intent=Intent {schema:"monzero-ltc-native-lock-intent-v1".into(),checkpoint:head.checkpoint,
+            quote:self.claim.quote,genesis:self.policy.xmz_genesis.clone(),wallet:source.wallet.to_string(),
+            destination:keys.native_address().to_string(),amount,maximum_fee,account:source.account,
+            priority:source.priority,admitted_at:retained.as_ref().map(|(_,at)|*at).unwrap_or(now)};
+        let bytes=serde_json::to_vec(&intent)?;
+        ensure!(intent.admitted_at>=agreement_at && intent.admitted_at<=now,"invalid native preparation admission time");
+        if let Some((saved,_))=retained { ensure!(saved==bytes,"retained native funding intent differs from trade"); }
+        let digest=Sha256::digest(&bytes).into();
+        if let Some(expected)=head.native_lock_intent { ensure!(expected==digest,"native funding intent differs from head"); }
+        self.observe_live_lock(ltc,safety_blocks).await?;
+        self.metadata.retain(&filename,&bytes)?;
+        head.native_lock_intent=Some(digest);
+        self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        let request=RelayRequest { wallet:source.wallet,destination:keys.native_address().clone(),
+            amount:XmzAmount::from_atoms(amount),account:source.account,priority:source.priority };
+        let prepared=relay.prepare_native_lock(request,&intent.genesis,XmzAmount::from_atoms(maximum_fee)).await?;
+        // No relay has occurred. Retain exact private bytes even if the quote or
+        // chain window expires during construction; future relay must check anew.
+        Journal::open(&self.snapshots)?.retain(&prepared_name(self.claim.trade),&prepared.encode(digest)?)?;
+        self.recover_prepared_native_lock()
+    }
+
+    /// Offline exact recovery. No wallet construction, signing or broadcast.
+    /// Missing bytes are not recoverable here; only prepare_native_lock may
+    /// reconstruct, after fresh checks and only if no preparation was committed.
+    pub fn recover_prepared_native_lock(&mut self)->Result<RelayedTransfer> {
+        Ok(summary(&self.load_prepared_native_lock()?))
+    }
+
+    pub(super) fn load_prepared_native_lock(&mut self)->Result<PreparedNativeLock> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong native funding recovery role");
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        let intent_bytes=self.metadata.read(&intent_name(self.claim.trade))?;
+        let intent:Intent=serde_json::from_slice(&intent_bytes)?;
+        let intent_digest=Sha256::digest(&intent_bytes).into();
+        let (agreement,agreement_at)=self.recovery_admission(&head)?;
+        quote.check_policy(&agreement,intent.admitted_at)?;
+        ensure!(serde_json::to_vec(&intent)?==intent_bytes && intent.schema=="monzero-ltc-native-lock-intent-v1"
+            && intent.checkpoint==head.checkpoint && intent.quote==self.claim.quote && intent.admitted_at>=agreement_at
+            && intent.genesis==quote.terms()["xmzGenesis"] && intent.destination==keys.native_address().to_string()
+            && intent.amount==quote.terms()["xmzAtoms"].parse::<u64>()?
+            && intent.maximum_fee==quote.terms()["xmzNativeFeeMaxAtoms"].parse::<u64>()?,
+            "native funding intent differs from agreed trade");
+        if let Some(expected)=head.native_lock_intent { ensure!(expected==intent_digest,"native funding intent differs from head"); }
+        let bytes=Zeroizing::new(Journal::open(&self.snapshots)?.read(&prepared_name(self.claim.trade))?);
+        let prepared=PreparedNativeLock::decode(&bytes,intent_digest,agreement.xmz_network)?;
+        ensure!(prepared.terms()==serde_json::json!({"genesis":intent.genesis,"wallet":intent.wallet,
+            "destination":intent.destination,"amountAtoms":intent.amount.to_string(),"account":intent.account,
+            "priority":intent.priority,"lockTxid":null}) && prepared.summary().fee.atoms()<=intent.maximum_fee,
+            "prepared native funding differs from intent");
+        let digest=Sha256::digest(&*bytes).into();
+        if let Some(expected)=head.native_lock { ensure!(expected==digest,"prepared native funding differs from head"); }
+        self.metadata.retain(&intent_name(self.claim.trade),&intent_bytes)?;
+        Journal::open(&self.snapshots)?.retain(&prepared_name(self.claim.trade),&bytes)?;
+        if head.native_lock_intent.is_none() || head.native_lock.is_none() {
+            head.native_lock_intent=Some(intent_digest);head.native_lock=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(prepared)
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn canonical_test_head(value:serde_json::Value)->Result<Vec<u8>> {
+    Ok(serde_json::to_vec(&serde_json::from_value::<Head>(value)?)?)
+}
