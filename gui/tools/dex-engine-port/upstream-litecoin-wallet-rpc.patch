+        let block=BlockHash::from_byte_array([7;32]);let txid=tx.compute_txid();
+        let good=||RawTransaction {in_active_chain:true,hex:serialize_hex(&tx),txid,
+            hash:tx.compute_wtxid(),blockhash:block,confirmations:3};
+        let header=||Header {hash:block,confirmations:3};
+        assert_eq!(validate(good(),header(),txid,block,3)?,tx);
+        assert!(validate(good(),header(),txid,block,0).is_err());
+        assert!(validate(good(),header(),txid,block,4).is_err());
+        for case in 0..6 {
+            let mut raw=good();let mut h=header();
+            match case {
+                0=>raw.in_active_chain=false,
+                1=>raw.blockhash=BlockHash::from_byte_array([8;32]),
+                2=>h.confirmations=-1,
+                3=>h.confirmations=4,
+                4=>raw.hash=Wtxid::from_byte_array([9;32]),
+                _=>{let mut other=tx.clone();other.input[0].witness=bitcoin::Witness::new();raw.hex=serialize_hex(&other);},
+            }
+            assert!(validate(raw,h,txid,block,3).is_err(),"invalid case {case}");
+        }
+        Ok(())
+    }
+    #[tokio::test]
