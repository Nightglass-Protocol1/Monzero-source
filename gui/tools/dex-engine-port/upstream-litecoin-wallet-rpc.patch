+#[cfg(target_os="linux")]
+fn owned_execution_lifecycle(payout_v2:bool,payout_relay:bool) -> Result<()> {
+    use std::os::unix::fs::DirBuilderExt;
+    use execution::Execution;
+    let root=std::env::temp_dir().canonicalize()?.join(format!("ltc-driver-{}",uuid::Uuid::new_v4()));
+    std::fs::DirBuilder::new().mode(0o700).create(&root)?;
+    for name in ["bob-meta","bob-secrets","alice-meta","alice-secrets"] { std::fs::DirBuilder::new().mode(0o700).create(root.join(name))?; }
+    let bm=root.join("bob-meta");let bs=root.join("bob-secrets");let am=root.join("alice-meta");let als=root.join("alice-secrets");
+    let (policy,quote,_,_)=setup();
+    let base=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+    let mut terms=quote.terms().clone();terms.insert("expiresAt".into(),(base+3500).to_string());
+    if payout_v2 {
+        terms.insert("schema".into(),crate::litecoin_quote::PAYOUT_DOMAIN.into());
+        for (field,value) in [("xmzPayoutAtoms","499000000"),("xmzClaimFeeMaxAtoms","100000"),("xmzRefundFeeMaxAtoms","90000")] {
+            terms.insert(field.into(),value.into());
+        }
+        terms.insert("xmzPayout".into(),include_str!("../../../swap-core/src/xmz_address_vectors.txt").lines().nth(1).unwrap().into());
+    }
+    let quote=crate::litecoin_quote::tests::signed(&terms,&policy,base)?;
+    let trade=quote.terms()["swapId"].parse()?;
+    let ltc=SigningKey::from_bytes(&[1;32]);let native=SigningKey::from_bytes(&[2;32]);
+    let pins=[ltc.verifying_key().to_bytes(),native.verifying_key().to_bytes()];
+    let mut rng=rand::rngs::StdRng::seed_from_u64(451);
+    let mut bob=Execution::begin(&bm,&bs,&quote,&policy,LocalRole::LitecoinFunder,quote.commitment(),base,&mut rng)?;
+    assert!(Execution::resume(&bm,&bs,trade,&policy,LocalRole::LitecoinFunder,pins).is_err());
+    let mut alice=Execution::begin(&am,&als,&quote,&policy,LocalRole::NativeFunder,quote.commitment(),base,&mut rng)?;
+    assert!(alice.outgoing(&native,base).is_err());
+    let before=bob.checkpoint()?;
+    // Crash after signed frame retention, before the driver head was advanced.
+    let first=storage::prepare_outgoing(&bs,&quote,&policy,LocalRole::LitecoinFunder,&before,&ltc,base)?;
+    drop(bob);
+    let mut bob=Execution::resume(&bm,&bs,trade,&policy,LocalRole::LitecoinFunder,pins)?;
+    let recovered=bob.recover_outgoing()?;
+    assert_eq!(first.bytes(),recovered.bytes());assert_eq!(first.signature(),recovered.signature());
+    let first_head=bob.checkpoint()?;
+    assert_ne!(before,first_head);
+    drop(bob);
+    assert!(Execution::begin(&bm,&bs,&quote,&policy,LocalRole::LitecoinFunder,quote.commitment(),base,&mut rng).is_err());
+    let mut bob=Execution::resume(&bm,&bs,trade,&policy,LocalRole::LitecoinFunder,pins)?;
+    assert_eq!(bob.checkpoint()?,first_head);
+    let retry=bob.outgoing(&ltc,base+3500)?;
+    assert_eq!(retry.bytes(),first.bytes());assert_eq!(retry.signature(),first.signature());
+    let before_peer=alice.checkpoint()?;
+    storage::retain_incoming(&als,&quote,&policy,LocalRole::NativeFunder,&before_peer,first.bytes(),first.signature(),base)?;
+    drop(alice);
+    let mut alice=Execution::resume(&am,&als,trade,&policy,LocalRole::NativeFunder,pins)?;
+    assert!(quote.check_policy(&policy,base+3500).is_err());
+    let peer_head=alice.recover_peer()?;
+    assert_eq!(peer_head,alice.recover_peer()?);
+    assert_eq!(peer_head,alice.accept_peer(first.bytes(),first.signature(),base+3500)?);
+    assert!(alice.outgoing(&native,base+3500).is_err());
+    let second=alice.outgoing(&native,base+1)?;
+    let complete=bob.accept_peer(second.bytes(),second.signature(),base+1)?;
+    assert_eq!(complete,bob.accept_peer(second.bytes(),second.signature(),base+3500)?);
+    assert_eq!(bob.completed_keys()?.transcript_commitment(),alice.completed_keys()?.transcript_commitment());
+    // Each controller retains its own signatures and verifies peer recovery.
+    use bitcoin::hashes::Hash;
+    let keys=bob.completed_keys()?;
+    let tx=bitcoin::Transaction { version:bitcoin::transaction::Version::TWO,
+        lock_time:bitcoin::absolute::LockTime::ZERO,
+        input:vec![bitcoin::TxIn { previous_output:bitcoin::OutPoint::new(bitcoin::Txid::from_byte_array([7;32]),0),
