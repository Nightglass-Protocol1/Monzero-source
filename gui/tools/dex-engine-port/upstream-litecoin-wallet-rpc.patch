+#[test]
+fn enforces_principal_change_fee_and_unsigned_segwit_inputs() {
+    assert_eq!(validate(fixture(), "0.00001000", 1, 1_000).unwrap().fee.to_sat(), 1_000);
+    assert!(validate(fixture(), "0.00001000", 1, 999).is_err());
+    assert!(validate(fixture(), "0.00001001", 1, 2_000).is_err());
+    assert!(validate(fixture(), "0.00001000", -1, 2_000).is_err());
+    assert!(validate(fixture(), "0.00001000", 0, 2_000).is_err());
+    let mut no_change = fixture(); no_change.unsigned_tx.output.pop(); no_change.outputs.pop();
+    assert!(validate(no_change, "0.00010000", -1, 10_000).is_ok());
+    let mut duplicate = fixture();
+    duplicate.unsigned_tx.input.push(duplicate.unsigned_tx.input[0].clone());
+    duplicate.inputs.push(duplicate.inputs[0].clone());
+    assert!(validate(duplicate, "0.00101000", 1, 101_000).is_err());
+    let cases: Vec<Box<dyn Fn(&mut Psbt)>> = vec![
+        Box::new(|p| p.unsigned_tx.input[0].sequence = Sequence::ENABLE_RBF_NO_LOCKTIME),
+        Box::new(|p| p.unsigned_tx.lock_time = absolute::LockTime::from_consensus(1)),
+        Box::new(|p| p.unsigned_tx.version = transaction::Version::ONE),
+        Box::new(|p| p.unsigned_tx.output[0].value = Amount::from_sat(89_999)),
+        Box::new(|p| p.unsigned_tx.output[1].script_pubkey = script(4,20)),
+        Box::new(|p| p.unsigned_tx.output[1].script_pubkey = script(2,32)),
+        Box::new(|p| p.inputs[0].witness_utxo = None),
+        Box::new(|p| p.inputs[0].witness_utxo.as_mut().unwrap().script_pubkey = ScriptBuf::from_hex("51").unwrap()),
+        Box::new(|p| p.inputs[0].final_script_witness = Some(Witness::new())),
+        Box::new(|p| p.inputs[0].final_script_sig = Some(ScriptBuf::new())),
+        Box::new(|p| p.inputs[0].redeem_script = Some(ScriptBuf::new())),
+        Box::new(|p| { p.unsigned_tx.input.push(p.unsigned_tx.input[0].clone()); p.inputs.push(p.inputs[0].clone()); }),
+        Box::new(|p| p.inputs[0].non_witness_utxo = Some(p.unsigned_tx.clone())),
+        Box::new(|p| { p.unsigned_tx.output.push(p.unsigned_tx.output[1].clone()); p.outputs.push(p.outputs[1].clone()); }),
+    ];
+    for (index, mutate) in cases.into_iter().enumerate() {
+        let mut p = fixture(); mutate(&mut p);
+        assert!(validate(p, "0.00001000", 1, 2_000).is_err(), "unsafe fixture case {index}");
+    }
+}
