+/// Refunds use the existing single-lock payout machinery with both accounting
+/// portions directed to the signed refund address. The actual recipient gets
+/// locked minus the actual bounded fee; the minimum portion is locked minus cap.
+pub(super) struct BoundRefund {pub(super) request:crate::native_funding_rpc::full_proceeds::ExactNetRequest,pub(super) genesis:String}
+impl BoundRefund {
+    pub(super) fn from_quote(quote:&VerifiedLtcQuote,wallet:&XmzAddress,txid:&str)->Result<Self> {
+        use crate::native_funding_rpc::full_proceeds::{ExactNetRequest,FullProceedsRequest};
+        use swap_core::xmz::XmzAmount;
+        let terms=quote.native_payout_terms()?;
+        let destination=quote.destinations().xmz_refund.clone();
+        ensure!(wallet.network()==destination.network() && wallet!=&destination,"invalid native refund wallet or destination");
+        let minimum=terms.refund_atoms(terms.refund_fee_max_atoms())?;
+        ensure!(minimum>0,"native refund fee consumes lock");
+        Ok(Self {genesis:quote.terms()["xmzGenesis"].clone(),request:ExactNetRequest {
+            source:FullProceedsRequest {wallet:wallet.clone(),destination:destination.clone(),lock_txid:txid.into(),
+                locked:XmzAmount::from_atoms(terms.locked_atoms()),maximum_fee:XmzAmount::from_atoms(terms.refund_fee_max_atoms()),account:0,priority:1},
+            principal:XmzAmount::from_atoms(minimum),reserve_return:destination}})
+    }
+}
+
+/// Recovered wallet material, with no authority to construct or relay a payment.
+/// Native refund payout must separately enforce the signed recipient and fee cap.
+pub struct PreparedNativeRefund {keys:NativeClaimKeys,id:SwapWalletId,address:XmzAddress,txid:String}
+impl PreparedNativeRefund {
+    pub fn address(&self)->&XmzAddress {&self.address}
+    pub fn wallet_filename(&self)->String {self.id.filename()}
+    pub async fn restore_wallet(&self,session:&mut NativeWalletSession,password:String)->Result<()> {
+        session.restore(&self.id,hex(self.keys.spend_key()),hex(self.keys.view_key()),0,password,&self.address).await?;
+        session.verify_spend_key(self.keys.spend_key(),&self.address).await?;
+        session.import_transaction(&self.txid,&self.address).await
+    }
+    pub async fn open_wallet(&self,session:&mut NativeWalletSession,password:String)->Result<()> {
+        session.open(&self.id,password,&self.address).await?;
+        session.verify_spend_key(self.keys.spend_key(),&self.address).await?;
+        session.import_transaction(&self.txid,&self.address).await
+    }
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Refund {schema:String,checkpoint:[u8;32],quote:[u8;32],native_lock:[u8;32],recovery:[u8;32],transaction:bitcoin::Transaction}
+pub(super) fn record_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-native-refund")}
+fn select_witness(candidate:Refund,retained:Option<&[u8]>,pin:Option<[u8;32]>)->Result<Refund> {
+    let Some(bytes)=retained else {ensure!(pin.is_none(),"committed native refund is missing");return Ok(candidate);};
+    if let Some(pin)=pin {ensure!(<[u8;32]>::from(Sha256::digest(bytes))==pin,"native refund differs from head");}
+    let saved:Refund=serde_json::from_slice(bytes)?;
+    ensure!(*Zeroizing::new(serde_json::to_vec(&saved)?)==bytes && saved.schema==candidate.schema
+        && saved.checkpoint==candidate.checkpoint && saved.quote==candidate.quote && saved.native_lock==candidate.native_lock
+        && saved.recovery==candidate.recovery && super::redeem::same_redemption_effect(&saved.transaction,&candidate.transaction),
+        "retained refund differs from observed transaction");
+    Ok(saved)
+}
+impl Execution {
+    pub(super) fn retained_native_refund(&mut self)->Result<bitcoin::Transaction> {
+        let (head,_,_,_,_)=self.load()?;
+        ensure!(head.native_refund.is_some(),"missing committed native refund");
+        let bytes=Zeroizing::new(Journal::open(&self.snapshots)?.read(&record_name(self.claim.trade))?);
+        let record:Refund=serde_json::from_slice(&bytes)?;
+        ensure!(record.schema=="monzero-ltc-native-refund-v1" && record.checkpoint==head.checkpoint
+            && record.quote==head.quote && Some(record.native_lock)==head.native_lock
+            && Some(record.recovery)==head.recovery_intent,"native refund context differs");
+        Ok(record.transaction)
+    }
+    /// Fresh observations on both chains precede key release. Commercial expiry
+    /// never disables recovery of an existing funded agreement.
+    pub async fn prepare_native_refund(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash)->Result<PreparedNativeRefund> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong native refund role");
+        self.reconcile_native_lock(native).await?;
+        let prepared=self.load_prepared_native_lock()?;
+        let release=self.recover_recovery_outgoing()?;
+        let (plan,local)=self.recovery_plan()?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.confirmed_transaction(plan.refund_txid(),block,minimum).await?;
+        ensure!(observed.network()==self.policy.ltc_network,"wrong native refund Litecoin network");
+        let candidate=Refund {schema:"monzero-ltc-native-refund-v1".into(),checkpoint:head.checkpoint,quote:head.quote,
+            native_lock:head.native_lock.context("native refund lacks funding preparation")?,
+            recovery:head.recovery_intent.context("native refund lacks recovery agreement")?,transaction:observed.transaction().clone()};
+        let retained=match Journal::open(&self.snapshots)?.read(&record_name(self.claim.trade)) {
+            Ok(bytes)=>Some(Zeroizing::new(bytes)),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>None,
+            Err(e)=>return Err(e),
+        };
+        let record=select_witness(candidate,retained.as_ref().map(|b|b.as_slice()),head.native_refund)?;
+        let recovered=plan.recover_native_refund_keys(&local,&keys,release.bytes(),release.signature(),record.transaction.clone())?;
+        let native_minimum=quote.terms()["xmzConfirmations"].parse::<u64>()?.max(u64::from(self.policy.xmz_confirmations));
+        native.confirm_native_lock(&prepared,native_minimum).await?;
+        let bytes=Zeroizing::new(serde_json::to_vec(&record)?);let digest=Sha256::digest(&*bytes).into();
+        Journal::open(&self.snapshots)?.retain(&record_name(self.claim.trade),&bytes)?;
+        if head.native_refund.is_none() {
+            head.native_refund=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(PreparedNativeRefund {keys:recovered,id:SwapWalletId::new(self.claim.trade)?,
+            address:keys.native_address().clone(),txid:prepared.summary().txid.clone()})
+    }
+}
