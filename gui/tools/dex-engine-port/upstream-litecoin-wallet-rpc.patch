+        match String::deserialize(d)?.as_str() {
+            "ltc-mainnet"=>Ok(LtcNetwork::Mainnet),"ltc-testnet"=>Ok(LtcNetwork::Testnet),"ltc-regtest"=>Ok(LtcNetwork::Regtest),
+            _=>Err(serde::de::Error::custom("invalid Litecoin deployment")),
+        }
+    }
+}
