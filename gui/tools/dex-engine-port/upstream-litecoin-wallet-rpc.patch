+#[cfg(target_os="linux")]
+fn live_release_node(outpoint:bitcoin::OutPoint,script:bitcoin::ScriptBuf)
+    ->Result<(crate::litecoin_rpc::LitecoinRpc,std::sync::Arc<std::sync::atomic::AtomicBool>,std::thread::JoinHandle<Result<()>>)> {
+    use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},sync::{Arc,atomic::{AtomicBool,Ordering}},time::Duration};
+    let listener=TcpListener::bind("127.0.0.1:0")?;
+    let port=listener.local_addr()?.port();listener.set_nonblocking(true)?;
+    let stop=Arc::new(AtomicBool::new(false));let stopped=stop.clone();
+    let server=std::thread::spawn(move || ->Result<()> {
+        for id in 0..5 {
+            let (mut socket,_)=loop {
+                ensure!(!stopped.load(Ordering::SeqCst),"live-release test node stopped early");
+                match listener.accept() {
+                    Ok(value)=>break value,
+                    Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>std::thread::sleep(Duration::from_millis(5)),
+                    Err(e)=>return Err(e.into()),
+                }
+            };
+            socket.set_read_timeout(Some(Duration::from_secs(5)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);let mut size=0usize;
+            loop {
+                let mut line=String::new();reader.read_line(&mut line)?;
+                if line=="\r\n" { break; }
+                if let Some(v)=line.to_ascii_lowercase().strip_prefix("content-length:") { size=v.trim().parse()?; }
+            }
+            ensure!(size<4096,"oversized test request");let mut body=vec![0;size];reader.read_exact(&mut body)?;
+            let request:serde_json::Value=serde_json::from_slice(&body)?;
+            let result=match id {
+                0|3=>{
+                    ensure!(request["method"]=="getblockchaininfo","wrong live-release RPC method");
+                    serde_json::json!({"chain":"regtest","bestblockhash":"03".repeat(32),"initialblockdownload":false,
+                        "softforks":{"csv":{"active":true},"segwit":{"active":true}}})
+                },
+                1|4=>{
+                    ensure!(request["method"]=="getblockhash","wrong live-release RPC method");
+                    serde_json::json!(swap_core::litecoin_address::LtcNetwork::Regtest.genesis())
+                },
+                _=>{
+                    ensure!(request["method"]=="gettxout" && request["params"]==serde_json::json!([outpoint.txid.to_string(),outpoint.vout,true]),
+                        "live-release omitted mempool spends or changed outpoint");
+                    serde_json::json!({"bestblock":"03".repeat(32),"confirmations":2,"value":1,"scriptPubKey":{"hex":script.to_hex_string()}})
+                },
+            };
+            let body=serde_json::json!({"id":request["id"],"error":null,"result":result}).to_string();
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",body.len(),body)?;
+        }
+        Ok(())
+    });
+    let anchor=swap_core::litecoin_address::LtcSegwitAddress::from_script(swap_core::litecoin_address::LtcNetwork::Regtest,
+        &bitcoin::ScriptBuf::from_bytes([vec![0,20],vec![9;20]].concat()))?;
+    let rpc=crate::litecoin_rpc::LitecoinRpc::new(port,"fixture".into(),"fixture".into(),swap_core::litecoin_address::LtcNetwork::Regtest,"fixture".into(),anchor)?;
+    Ok((rpc,stop,server))
+}
