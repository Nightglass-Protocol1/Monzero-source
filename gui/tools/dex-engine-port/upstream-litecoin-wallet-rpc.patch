+//! A wallet-import capability derived from a committed native claim.
+use super::*;
+use crate::native_funding_rpc::wallet_session::{NativeWalletSession,SwapWalletId};
+use crate::litecoin_negotiation::recovery::native_claim::NativeClaimKeys;
+use crate::native_funding_rpc::{NativeFundingRpc,full_proceeds::{ExactNetRequest,FullProceedsRequest,lock_payout}};
+use swap_core::xmz::XmzAmount;
+
+pub(super) struct BoundPayout {pub(super) request:ExactNetRequest,pub(super) genesis:String}
+impl BoundPayout {
+    pub(super) fn from_quote(quote:&VerifiedLtcQuote,wallet:&XmzAddress,txid:&str)->Result<Self> {
+        let terms=quote.native_payout_terms()?;
+        ensure!(wallet.network()==quote.destinations().xmz_payout.network(),"native payout wallet network mismatch");
+        Ok(Self {genesis:quote.terms()["xmzGenesis"].clone(),request:ExactNetRequest {
+            source:FullProceedsRequest {wallet:wallet.clone(),destination:quote.destinations().xmz_payout.clone(),
+                lock_txid:txid.into(),locked:XmzAmount::from_atoms(terms.locked_atoms()),
+                maximum_fee:XmzAmount::from_atoms(terms.claim_fee_max_atoms()),account:0,priority:1},
+            principal:XmzAmount::from_atoms(terms.payout_atoms()),reserve_return:quote.destinations().xmz_refund.clone()}})
+    }
+}
+
+/// Contains private native keys. No Debug, Clone or implicit serialization.
+/// Restoring/opening a wallet gives no permission to construct or relay a spend.
+pub struct PreparedNativeClaim {
+    keys:NativeClaimKeys,id:SwapWalletId,address:XmzAddress,txid:String,payout:Option<BoundPayout>,commitment:[u8;32],
+}
+impl PreparedNativeClaim {
+    pub(super) fn new(keys:NativeClaimKeys,quote:&VerifiedLtcQuote,address:XmzAddress,txid:String)->Result<Self> {
+        ensure!(txid.len()==64 && txid!="0".repeat(64)
+            && txid.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid native claim transaction identity");
+        let payout=if quote.terms()["schema"]==crate::litecoin_quote::PAYOUT_DOMAIN {
+            Some(BoundPayout::from_quote(quote,&address,&txid)?)
+        } else {None};
+        Ok(Self {keys,id:SwapWalletId::new(quote.terms()["swapId"].parse()?)?,address,txid,payout,commitment:*quote.commitment()})
+    }
+    pub fn address(&self)->&XmzAddress { &self.address }
+    pub fn wallet_filename(&self)->String { self.id.filename() }
+
+    /// Requires an exclusively owned, empty dedicated wallet RPC session.
+    /// Errors may have created the wallet; explicitly open it to reconcile.
+    /// Scanning from zero preserves recovery across native reorganisations.
+    pub async fn restore_wallet(&self,session:&mut NativeWalletSession,password:String)->Result<()> {
+        session.restore(&self.id,hex(self.keys.spend_key()),hex(self.keys.view_key()),0,password,&self.address).await?;
+        session.verify_spend_key(self.keys.spend_key(),&self.address).await?;
+        session.import_transaction(&self.txid,&self.address).await
+    }
+
+    /// Explicit recovery after an uncertain restore, or a later process restart.
+    /// Never replaces a failed open with a fresh wallet or different key material.
+    pub async fn open_wallet(&self,session:&mut NativeWalletSession,password:String)->Result<()> {
+        session.open(&self.id,password,&self.address).await?;
+        session.verify_spend_key(self.keys.spend_key(),&self.address).await?;
+        session.import_transaction(&self.txid,&self.address).await
+    }
+
+    // Low-level isolated-wallet fixture only. Production construction goes
+    // through Execution::prepare_native_payout and its immutable intent.
+    #[cfg(test)]
+    async fn prepare_payout(&self,client:&NativeFundingRpc,priority:u32)->Result<lock_payout::PreparedLockPayout> {
+        let bound=self.payout.as_ref().context("native payout requires a v2 claim capability")?;
+        ensure!((1..=4).contains(&priority),"invalid native payout priority");
+        let mut request=bound.request.clone();request.source.priority=priority;
+        lock_payout::prepare(client,&request,&bound.genesis).await
+    }
+
+    #[cfg(test)]
+    pub(crate) fn spend_key(&self)->&[u8;32] {self.keys.spend_key()}
+    #[cfg(test)]
+    pub(crate) fn view_key(&self)->&[u8;32] {self.keys.view_key()}
+}
