+//! Private immutable snapshots. The execution driver must durably record the
+//! returned commitment before acknowledging progress or funding. No scan for a
+//! "latest" file and no fallback to a new exchange are permitted by this API.
+use super::*;
+use crate::litecoin_rpc::reservation::Journal;
+use std::path::Path;
+use zeroize::Zeroizing;
+
+fn names(quote: &VerifiedLtcQuote, role: LocalRole, commitment: &[u8;32]) -> (String,String) {
+    names_for_trade(&quote.terms()["swapId"],role,commitment)
+}
+fn names_for_trade(trade: &str, role: LocalRole, commitment: &[u8;32]) -> (String,String) {
+    let role=match role { LocalRole::LitecoinFunder=>0,LocalRole::NativeFunder=>1 };
+    (format!("{trade}.ltc-protocol-keys-{role}"),
+        format!("{trade}.ltc-protocol-frame-{role}-{}",hex(commitment)))
+}
+
+/// Atomically publish immutable private key and transcript files. Each file is
+/// synced before publication and the directory is synced before success. A
+/// crash between files may leave unused keys; it cannot authorize a new trade.
+/// The caller owns the private canonical directory and its retention lifecycle.
+pub fn persist(directory: &Path, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, keys: &LocalKeys, exchange: &KeyExchange) -> Result<[u8;32]> {
+    let journal=Journal::open(directory)?;
+    persist_locked(&journal,quote,policy,role,keys,exchange)
+}
+
+fn persist_locked(journal: &Journal, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, keys: &LocalKeys, exchange: &KeyExchange) -> Result<[u8;32]> {
+    ensure!(canonical(&keys.share)?==exchange.local_share,"checkpoint keys differ from local exchange keys");
+    let secret=keys.secret_checkpoint(quote,role)?;
+    let (transcript,commitment)=exchange.transcript_checkpoint()?;
+    // Reject a mismatched quote, role, policy, keys or cursor before any write.
+    KeyExchange::restore_transcript_checkpoint(&transcript,&commitment,quote,policy,role,keys)?;
+    let (key_name,frame_name)=names(quote,role,&commitment);
+    journal.retain(&key_name,&secret)?;
+    journal.retain(&frame_name,&transcript)?;
+    Ok(commitment)
+}
+
+/// Load the exact checkpoint referenced by the trusted execution record. There
+/// is deliberately no automatic discovery, deletion, regeneration or downgrade.
+/// This recovers protocol material; user approval and funding remain separate.
+pub fn restore(directory: &Path, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, expected_commitment: &[u8;32]) -> Result<(LocalKeys,KeyExchange)> {
+    let journal=Journal::open(directory)?;
+    restore_locked(&journal,quote,policy,role,expected_commitment)
+}
+
+fn restore_locked(journal: &Journal, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, expected_commitment: &[u8;32]) -> Result<(LocalKeys,KeyExchange)> {
+    let (key_name,frame_name)=names(quote,role,expected_commitment);
+    let secret=Zeroizing::new(journal.read(&key_name)?);
+    let transcript=Zeroizing::new(journal.read(&frame_name)?);
+    let (keys,_)=LocalKeys::restore_secret_checkpoint(&secret,quote,role)?;
+    let exchange=KeyExchange::restore_transcript_checkpoint(&transcript,expected_commitment,quote,policy,role,&keys)?;
+    Ok((keys,exchange))
+}
+
+/// Contains private view material. No Debug, public serialization, or automatic
+/// transmission. Retention is not peer acceptance or permission to fund.
+pub struct OutgoingFrame { bytes: Zeroizing<Vec<u8>>, signature: [u8;64] }
+impl OutgoingFrame {
+    pub fn bytes(&self) -> &[u8] { &self.bytes }
+    pub fn signature(&self) -> &[u8;64] { &self.signature }
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OutgoingRecord {
+    schema: String, checkpoint: [u8;32], prepared_at: u64,
+    bytes: Vec<u8>, signature: Vec<u8>,
+}
+fn outgoing_name(quote: &VerifiedLtcQuote, role: LocalRole, checkpoint: &[u8;32]) -> String {
+    format!("{}.outgoing",names(quote,role,checkpoint).0)
+}
+fn checked_outgoing(bytes: &[u8], checkpoint: &[u8;32], mut exchange: KeyExchange) -> Result<(OutgoingFrame,KeyExchange)> {
+    let record: OutgoingRecord=serde_json::from_slice(bytes)
+        .map_err(|_|anyhow::anyhow!("invalid Litecoin outgoing frame record"))?;
+    ensure!(record.schema=="monzero-ltc-key-outgoing-v1" && &record.checkpoint==checkpoint,
+        "Litecoin outgoing frame checkpoint mismatch");
+    ensure!(serde_json::to_vec(&record)?==bytes,"noncanonical Litecoin outgoing frame record");
+    ensure!(exchange.prepare_local(record.prepared_at)?==record.bytes,"Litecoin outgoing frame differs from held keys");
+    exchange.accept(&record.bytes,&record.signature,record.prepared_at)?;
+    let signature=record.signature.try_into().map_err(|_|anyhow::anyhow!("invalid outgoing signature size"))?;
+    Ok((OutgoingFrame { bytes:Zeroizing::new(record.bytes),signature },exchange))
+}
+
+/// Retain the exact signed local frame before returning it for transmission.
+/// At most one outgoing key frame exists for each trade/role. Repeated calls
+/// return its original bytes; they cannot advance or replace the checkpoint.
+/// The driver must serialize this with funding and its latest-state commit.
+pub fn prepare_outgoing(directory: &Path, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, checkpoint: &[u8;32], identity: &ed25519_dalek::SigningKey, now: u64) -> Result<OutgoingFrame> {
+    use ed25519_dalek::Signer;
+    let journal=Journal::open(directory)?;
+    let (_,mut exchange)=restore_locked(&journal,quote,policy,role,checkpoint)?;
+    ensure!(identity.verifying_key()==exchange.pins[usize::from(exchange.local_sequence)],
+        "Litecoin outgoing signing identity differs from quote pin");
+    let name=outgoing_name(quote,role,checkpoint);
+    match journal.read(&name) {
+        Ok(bytes)=> {
+            let (outgoing,_)=checked_outgoing(&bytes,checkpoint,exchange)?;
+            journal.retain(&name,&bytes)?;
+            return Ok(outgoing);
+        }
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+        Err(e)=>return Err(e),
+    }
+    let bytes=exchange.prepare_local(now)?;
+    let signature=identity.sign(&signing_bytes(&bytes)?).to_bytes();
+    exchange.accept(&bytes,&signature,now)?;
+    let record=OutgoingRecord { schema:"monzero-ltc-key-outgoing-v1".into(),checkpoint:*checkpoint,
+        prepared_at:now,bytes:bytes.clone(),signature:signature.to_vec() };
+    journal.retain(&name,&serde_json::to_vec(&record)?)?;
+    Ok(OutgoingFrame { bytes:Zeroizing::new(bytes),signature })
+}
+
+/// Recover an already-retained frame without requiring the identity secret or
+/// a fresh quote. The caller decides whether to reconcile or retransmit it.
+pub fn load_outgoing(directory: &Path, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, checkpoint: &[u8;32]) -> Result<OutgoingFrame> {
+    let journal=Journal::open(directory)?;
+    let (_,exchange)=restore_locked(&journal,quote,policy,role,checkpoint)?;
+    Ok(checked_outgoing(&journal.read(&outgoing_name(quote,role,checkpoint))?,checkpoint,exchange)?.0)
+}
+
+/// Cold-start recovery without a live in-memory quote. The caller supplies the
+/// exact latest commitment, trade identity, deployment and pinned signers from
+/// its trusted execution record. Old terms are recovered, never refreshed.
+pub fn restore_cold(directory: &Path, trade: uuid::Uuid, deployment: &Policy,
+    ltc_pin: &[u8;32], xmz_pin: &[u8;32], role: LocalRole, checkpoint: &[u8;32])
+    -> Result<(VerifiedLtcQuote,LocalKeys,KeyExchange)> {
+    ensure!(!trade.is_nil(),"invalid Litecoin recovery trade");
+    let journal=Journal::open(directory)?;
+    let (key_name,frame_name)=names_for_trade(&trade.to_string(),role,checkpoint);
+    let transcript=Zeroizing::new(journal.read(&frame_name)?);
+    let quote=KeyExchange::quote_from_checkpoint(&transcript,checkpoint,ltc_pin,xmz_pin)?;
+    ensure!(quote.terms()["swapId"]==trade.to_string(),"Litecoin recovery trade differs from quote");
+    let secret=Zeroizing::new(journal.read(&key_name)?);
+    let (keys,_)=LocalKeys::restore_secret_checkpoint(&secret,&quote,role)?;
+    let exchange=KeyExchange::restore_transcript_checkpoint(&transcript,checkpoint,&quote,deployment,role,&keys)?;
+    Ok((quote,keys,exchange))
+}
+
+/// Recover local acceptance from the already-retained outgoing frame at its
+/// original admission time. This does not claim that the peer received it.
+/// Returns a durable successor snapshot; the execution driver must commit that
+/// exact successor as its latest state before acknowledging further progress.
+/// Repeating the same recovery returns the same successor, without re-signing.
+pub fn recover_outgoing_acceptance(directory: &Path, quote: &VerifiedLtcQuote, policy: &Policy,
+    role: LocalRole, checkpoint: &[u8;32]) -> Result<[u8;32]> {
+    let journal=Journal::open(directory)?;
+    let (keys,exchange)=restore_locked(&journal,quote,policy,role,checkpoint)?;
+    let name=outgoing_name(quote,role,checkpoint);
+    let bytes=Zeroizing::new(journal.read(&name)?);
+    let (_,accepted)=checked_outgoing(&bytes,checkpoint,exchange)?;
+    // Re-sync a record possibly left by an interrupted writer before retaining
+    // any state that depends on it. The directory lock spans both operations.
+    journal.retain(&name,&bytes)?;
+    persist_locked(&journal,quote,policy,role,&keys,&accepted)
+}
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct IncomingRecord { schema:String,checkpoint:[u8;32],accepted_at:u64,bytes:Vec<u8>,signature:Vec<u8> }
+fn incoming_name(quote:&VerifiedLtcQuote,role:LocalRole,checkpoint:&[u8;32])->String {
+    format!("{}.incoming",names(quote,role,checkpoint).0)
+}
+fn checked_incoming(bytes:&[u8],checkpoint:&[u8;32],mut exchange:KeyExchange)->Result<(IncomingRecord,KeyExchange)> {
+    let record:IncomingRecord=serde_json::from_slice(bytes)
+        .map_err(|_|anyhow::anyhow!("invalid retained Litecoin peer frame"))?;
+    ensure!(record.schema=="monzero-ltc-key-incoming-v1" && &record.checkpoint==checkpoint
+        && serde_json::to_vec(&record)?==bytes,"Litecoin incoming checkpoint mismatch");
+    ensure!(exchange.next==1-exchange.local_sequence,"Litecoin checkpoint is not waiting for peer frame");
+    exchange.accept(&record.bytes,&record.signature,record.accepted_at)?;
+    Ok((record,exchange))
+}
+
+/// Retain a validated peer frame and its admission time before creating the
+/// successor. A retry can finish the same operation after quote expiry, but
+/// cannot replace it with different bytes or adopt another predecessor.
+pub fn retain_incoming(directory:&Path,quote:&VerifiedLtcQuote,policy:&Policy,role:LocalRole,
+    checkpoint:&[u8;32],bytes:&[u8],signature:&[u8],now:u64)->Result<[u8;32]> {
+    let journal=Journal::open(directory)?;
+    let (keys,exchange)=restore_locked(&journal,quote,policy,role,checkpoint)?;
+    let name=incoming_name(quote,role,checkpoint);
+    let record_bytes=match journal.read(&name) {
+        Ok(existing)=>existing,
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=> {
+            ensure!(bytes.len()<=MAX_FRAME && signature.len()==64,"invalid incoming Litecoin frame size");
+            serde_json::to_vec(&IncomingRecord { schema:"monzero-ltc-key-incoming-v1".into(),checkpoint:*checkpoint,
+                accepted_at:now,bytes:bytes.to_vec(),signature:signature.to_vec() })?
+        }
+        Err(e)=>return Err(e),
+    };
+    let (record,accepted)=checked_incoming(&record_bytes,checkpoint,exchange)?;
+    ensure!(record.bytes==bytes && record.signature==signature,"conflicting retained Litecoin peer frame");
+    journal.retain(&name,&record_bytes)?;
+    persist_locked(&journal,quote,policy,role,&keys,&accepted)
+}
+
+/// Complete a retained incoming operation without requiring another delivery.
+pub fn recover_incoming(directory:&Path,quote:&VerifiedLtcQuote,policy:&Policy,role:LocalRole,
+    checkpoint:&[u8;32])->Result<[u8;32]> {
+    let journal=Journal::open(directory)?;
+    let (keys,exchange)=restore_locked(&journal,quote,policy,role,checkpoint)?;
+    let name=incoming_name(quote,role,checkpoint);
+    let bytes=Zeroizing::new(journal.read(&name)?);
+    let (_,accepted)=checked_incoming(&bytes,checkpoint,exchange)?;
+    journal.retain(&name,&bytes)?;
+    persist_locked(&journal,quote,policy,role,&keys,&accepted)
+}
