+    fn journal_reopens_exact_records_and_rejects_conflicts_and_unsafe_files() -> Result<()> {
+        let path = std::env::temp_dir().canonicalize()?.join(format!("ltc-reservation-{}", uuid::Uuid::new_v4()));
+        std::fs::DirBuilder::new().mode(0o700).create(&path)?;
+        let journal = Journal::open(&path)?;
+        assert!(Journal::open(&path).is_err());
+        journal.file("interrupted.tmp", libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL)?.write_all(b"partial")?;
+        journal.retain("trade.intent", b"original")?;
+        assert_eq!(journal.file("trade.intent", libc::O_RDONLY)?.metadata()?.nlink(), 1);
+        let inode = journal.file("trade.intent", libc::O_RDONLY)?.metadata()?.ino();
+        journal.retain("trade.intent", b"original")?;
+        assert!(journal.retain("trade.intent", b"changed").is_err());
+        assert_eq!(journal.file("trade.intent", libc::O_RDONLY)?.metadata()?.ino(), inode);
+        drop(journal);
+        let journal = Journal::open(&path)?;
+        assert_eq!(journal.read("trade.intent")?, b"original");
+        std::os::unix::fs::symlink("trade.intent", path.join("linked.intent"))?;
+        assert!(journal.read("linked.intent").is_err());
+        std::fs::hard_link(path.join("trade.intent"), path.join("hardlink.intent"))?;
+        assert!(journal.read("trade.intent").is_err());
+        std::fs::remove_file(path.join("hardlink.intent"))?;
+        std::fs::set_permissions(path.join("trade.intent"), std::fs::Permissions::from_mode(0o644))?;
+        assert!(journal.read("trade.intent").is_err());
+        drop(journal);
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755))?;
+        assert!(Journal::open(&path).is_err());
+        std::fs::remove_dir_all(path)?;
+        Ok(())
+    }
