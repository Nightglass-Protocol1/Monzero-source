+//! Native key recovery from the agreed Litecoin redemption. No chain authority.
+use super::*;
+use super::super::{VerifiedKeys,monero};
+use zeroize::Zeroizing;
+
+/// Private wallet material. Never log, expose through order-book data, or treat
+/// possession as evidence that either chain has confirmed settlement.
+pub struct NativeClaimKeys {
+    spend:Zeroizing<[u8;32]>,view:Zeroizing<[u8;32]>,
+}
+impl NativeClaimKeys {
+    pub fn spend_key(&self)->&[u8;32] { &self.spend }
+    pub fn view_key(&self)->&[u8;32] { &self.view }
+}
+impl RecoveryPlan {
+    /// The release must be Bob's retained authenticated frame and native_txid
+    /// must come from the committed funding proof. The caller separately checks
+    /// the redemption's chain inclusion before initiating a native claim.
+    pub fn recover_native_claim_keys(&self,local:&LocalKeys,keys:&VerifiedKeys,native_txid:&str,
+        release:&[u8],signature:&[u8],redeemed:Transaction)->Result<NativeClaimKeys> {
+        self.check_local(local,0)?;
+        ensure!(keys.local_sequence==0 && keys.commitment==self.binding.quote
+            && keys.transcript==self.binding.transcript,"native claim key context mismatch");
+        ensure!(redeemed.compute_txid()==self.redeem.txid(),"native claim redemption differs from agreement");
+        let encrypted=self.checked_redeem(native_txid,release,signature)?;
+        let signature=self.redeem.extract_signature_by_key(std::sync::Arc::new(redeemed),self.keys[0])?;
+        let secret=contract::recover(self.adaptors[1],signature,encrypted)?;
+        let mut bytes=Zeroizing::new(secret.to_bytes());bytes.reverse();
+        let peer=monero::PrivateKey::from_slice(bytes.as_ref())
+            .map_err(|_|anyhow::anyhow!("recovered native share is not canonical"))?;
+        ensure!(peer.as_bytes()==*bytes,"recovered native share was reduced");
+        let spend=peer+monero::PrivateKey::from_scalar(*local.native_spend_secret());
+        let view=monero::PrivateKey::from_slice(keys.private_view_key())
+            .map_err(|_|anyhow::anyhow!("invalid negotiated native view key"))?;
+        let address=swap_core::xmz_address::XmzAddress::new(keys.native_address().network(),
+            monero_address::AddressType::Legacy,monero::PublicKey::from_private_key(&spend).decompress(),
+            monero::PublicKey::from_private_key(&view).decompress())?;
+        ensure!(&address==keys.native_address(),"recovered native keys differ from negotiated address");
+        Ok(NativeClaimKeys {spend:Zeroizing::new(spend.as_bytes()),view:Zeroizing::new(view.as_bytes())})
+    }
+}
+
+impl RecoveryPlan {
+    /// Alice recovers Bob's share from the exact agreed Litecoin refund. The
+    /// caller must separately establish current refund inclusion and native
+    /// funding before using these keys; this method grants no chain authority.
+    pub fn recover_native_refund_keys(&self,local:&LocalKeys,keys:&VerifiedKeys,
+        retained_release:&[u8],identity_signature:&[u8],refunded:Transaction)->Result<NativeClaimKeys> {
+        self.check_local(local,1)?;
+        ensure!(keys.local_sequence==1 && keys.commitment==self.binding.quote
+            && keys.transcript==self.binding.transcript,"native refund key context mismatch");
+        ensure!(refunded.compute_txid()==self.refund.txid(),"native refund differs from agreement");
+        self.verify_local_message(retained_release,identity_signature)?;
+        let frame=self.verify_peer(retained_release,identity_signature,1)?;
+        let retained=frame.refund.context("missing retained refund adaptor signature")?;
+        // The existing core extractor reconstructs the deterministic encrypted
+        // signature. Require it to equal Alice's authenticated retained release.
+        let expected=local.contract_secret().encsign(self.adaptors[0],self.refund.digest());
+        ensure!(serde_json::to_vec(&retained)?==serde_json::to_vec(&expected)?,"refund adaptor differs from retained release");
+        let recovered=self.refund.extract_monero_private_key(std::sync::Arc::new(refunded),
+            0u64.into(),local.contract_secret().clone(),self.adaptors[0])?;
+        // Ask the legacy core extractor for only the peer share, then combine
+        // using the native scalar representation already owned by this protocol.
+        let recovered_bytes=Zeroizing::new(recovered.to_bytes());
+        let peer=monero::PrivateKey::from_slice(recovered_bytes.as_ref())
+            .map_err(|_|anyhow::anyhow!("invalid recovered native refund share"))?;
+        let spend=peer+monero::PrivateKey::from_scalar(*local.native_spend_secret());
+        let view=monero::PrivateKey::from_slice(keys.private_view_key())
+            .map_err(|_|anyhow::anyhow!("invalid negotiated refund view key"))?;
+        let address=swap_core::xmz_address::XmzAddress::new(keys.native_address().network(),
+            monero_address::AddressType::Legacy,monero::PublicKey::from_private_key(&spend).decompress(),
+            monero::PublicKey::from_private_key(&view).decompress())?;
+        ensure!(&address==keys.native_address(),"recovered refund keys differ from negotiated address");
+        Ok(NativeClaimKeys {spend:Zeroizing::new(spend.as_bytes()),view:Zeroizing::new(view.as_bytes())})
+    }
+}
