+//! Native GUI journal, retained-payment review and explicit isolated-chain submission.
+//! Payment review may finish publication of an already retained preparation.
+#[cfg(target_os="linux")]
+mod linux {
+    use anyhow::{ensure,Context,Result};
+    use serde::Deserialize;
+    use std::{fs::{File,OpenOptions},io::{Read,Write},os::unix::fs::{MetadataExt,OpenOptionsExt},path::{Path,PathBuf}};
+    use swap_machine::{litecoin_quote::Policy,litecoin_negotiation::{LocalRole,execution::Execution}};
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields,rename_all="camelCase")]
+    struct Config {
+        schema:String,helper:PathBuf,helper_digest:String,metadata_directory:PathBuf,snapshot_directory:PathBuf,
+        trade_id:uuid::Uuid,role:String,pins:[[u8;32];2],policy:Policy,
+        #[serde(default)] refund_rpc_file:Option<PathBuf>,
+        #[serde(default)] payout_rpc_file:Option<PathBuf>,
+        #[serde(default)] funding_rpc_file:Option<PathBuf>,
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields,rename_all="camelCase")]
+    struct Request {schema:String,request_id:uuid::Uuid,#[serde(default)] action:Option<Action>,
+        #[serde(default)] commitment:Option<String>,#[serde(default)] safety_blocks:Option<u32>}
+    #[derive(Deserialize)]
+    #[serde(rename_all="lowercase")]
+    enum Action {Send,Retransmit}
+    fn valid_request(request:&Request,mode:&str)->bool {
+        let (schema,action,approval,funding)=match mode {
+            "--snapshot-stdio-v1"=>("monzero-ltc-journal-request-v1",false,false,false),
+            "--refund-review-stdio-v1"=>("monzero-ltc-refund-review-request-v1",true,false,false),
+            "--refund-submit-stdio-v1"=>("monzero-ltc-refund-submit-request-v1",true,true,false),
+            "--refund-check-stdio-v1"=>("monzero-ltc-refund-check-request-v1",false,false,false),
+            "--payout-review-stdio-v1"=>("monzero-ltc-payout-review-request-v1",true,false,false),
+            "--payout-submit-stdio-v1"=>("monzero-ltc-payout-submit-request-v1",true,true,false),
+            "--payout-check-stdio-v1"=>("monzero-ltc-payout-check-request-v1",false,false,false),
+            "--funding-review-stdio-v1"=>("monzero-ltc-funding-review-request-v1",true,false,true),
+            "--funding-check-stdio-v1"=>("monzero-ltc-funding-check-request-v1",false,false,true),
+            "--funding-submit-stdio-v1"=>("monzero-ltc-funding-submit-request-v1",true,true,true),
+            _=>return false,
+        };
+        !request.request_id.is_nil() && request.schema==schema && request.action.is_some()==action
+            && if approval {request.commitment.as_deref().is_some_and(|value|parse_commitment(value).is_ok())}
+                else {request.commitment.is_none()}
+            && if funding {request.safety_blocks.is_some_and(|blocks|blocks>0)} else {request.safety_blocks.is_none()}
+    }
+    fn private_bytes(path:&Path,credential:bool)->Result<(File,zeroize::Zeroizing<Vec<u8>>)> {
+        ensure!(path.is_absolute() && path.canonicalize()?==path,"invalid configuration path");
+        let file=OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW|libc::O_NONBLOCK|libc::O_CLOEXEC).open(path)?;
+        let before=file.metadata()?;
+        // SAFETY: geteuid has no pointer arguments or memory preconditions.
+        let uid=unsafe {libc::geteuid()};
+        let mode=before.mode()&0o7777;
+        ensure!(before.is_file() && before.uid()==uid && before.nlink()==1
+            && (mode==0o600 || (credential && mode==0o400))
+            && before.len()>0 && before.len()<=if credential {1024} else {16384},"unsafe private file");
+        // Configuration files provide an execution lease. Credential files are
+        // producer-owned readable data, not a lease we may take from the daemon.
+        if !credential {file.try_lock()?;}
+        let mut bytes=zeroize::Zeroizing::new(Vec::new());(&file).take(16385).read_to_end(&mut bytes)?;
+        let after=file.metadata()?;
+        let named=std::fs::symlink_metadata(path)?;
+        ensure!(named.is_file() && (named.dev(),named.ino())==(before.dev(),before.ino()),"private file replaced");
+        ensure!(bytes.len() as u64==before.len() && before.len()==after.len()
+            && (before.mtime(),before.mtime_nsec(),before.ctime(),before.ctime_nsec())
+                ==(after.mtime(),after.mtime_nsec(),after.ctime(),after.ctime_nsec()),"configuration changed");
+        Ok((file,bytes))
+    }
+    fn valid_config_mode(schema:&str,role:&str,refund:bool,payout:bool,funding:bool)->bool {
+        match schema {
+            "monzero-private-ltc-journal-v1"=>!refund && !payout && !funding
+                && (role=="native-funder" || role=="litecoin-funder"),
+            "monzero-private-ltc-journal-v2"=>refund && !payout && !funding && role=="native-funder",
+            "monzero-private-ltc-journal-v3"=>payout && !refund && !funding && role=="litecoin-funder",
+            "monzero-private-ltc-journal-v4"=>funding && !refund && !payout && role=="native-funder",
+            _=>false,
+        }
+    }
+    fn load(path:&Path)->Result<(File,Config)> {
+        let (file,bytes)=private_bytes(path,false)?;
+        let config:Config=serde_json::from_slice(&bytes)?;
+        ensure!(!config.trade_id.is_nil() && valid_config_mode(&config.schema,&config.role,
+            config.refund_rpc_file.is_some(),config.payout_rpc_file.is_some(),config.funding_rpc_file.is_some()),
+            "invalid configuration schema or trade");
+        ensure!(config.helper.is_absolute() && config.helper.canonicalize()?==std::env::current_exe()?.canonicalize()?,"wrong configured helper");
+        ensure!(config.helper_digest.len()==64 && config.helper_digest.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid helper digest");
+        // The launcher must independently hash/check its trusted executable before
+        // starting it. A process cannot establish its own provenance from this file.
+        Ok((file,config))
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields,rename_all="camelCase")]
+    struct RefundRpc {
+        schema:String,ltc_port:u16,ltc_wallet:String,ltc_anchor:String,ltc_cookie_file:PathBuf,
+        native_daemon_port:u16,native_wallet_port:u16,native_login_file:PathBuf,ltc_refund_block:bitcoin::BlockHash,
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields,rename_all="camelCase")]
+    struct PayoutRpc {
+        schema:String,ltc_port:u16,ltc_wallet:String,ltc_anchor:String,ltc_cookie_file:PathBuf,
+        native_daemon_port:u16,native_wallet_port:u16,native_login_file:PathBuf,ltc_redeem_block:bitcoin::BlockHash,
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields,rename_all="camelCase")]
+    struct FundingRpc {
+        schema:String,ltc_port:u16,ltc_wallet:String,ltc_anchor:String,ltc_cookie_file:PathBuf,
+        native_daemon_port:u16,native_wallet_port:u16,native_login_file:PathBuf,
+    }
+    fn credentials(path:&Path)->Result<(File,String,String)> {
+        let (lease,bytes)=private_bytes(path,true)?;
+        ensure!(bytes.len()<=1024,"oversized RPC credentials");
+        let (user,password)=std::str::from_utf8(&bytes)?.trim_end().split_once(':').context("invalid RPC credentials")?;
+        ensure!(!user.is_empty() && !password.is_empty(),"empty RPC credentials");
+        Ok((lease,user.into(),password.into()))
+    }
+    fn parse_commitment(text:&str)->Result<[u8;32]> {
+        ensure!(text.len()==64 && text.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid review commitment");
+        let mut result=[0;32];
+        for (i,byte) in result.iter_mut().enumerate() {*byte=u8::from_str_radix(&text[2*i..2*i+2],16)?;}
+        Ok(result)
+    }
+    async fn isolated_native(port:u16)->Result<()> {
+        let client=reqwest::Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none())
+            .timeout(std::time::Duration::from_secs(15)).build()?;
+        let mut response=client.post(format!("http://127.0.0.1:{port}/json_rpc"))
+            .json(&serde_json::json!({"jsonrpc":"2.0","id":"isolated-refund-check","method":"get_info"})).send().await?;
+        ensure!(response.status().is_success(),"native isolation check failed");
+        let mut bytes=Vec::new();
+        while let Some(chunk)=response.chunk().await? {ensure!(bytes.len()+chunk.len()<=65536,"oversized isolation response");bytes.extend_from_slice(&chunk);}
+        let envelope:serde_json::Value=serde_json::from_slice(&bytes)?;
+        ensure!(envelope["id"]=="isolated-refund-check" && envelope.get("error").is_none(),"invalid isolation response");
+        let info=&envelope["result"];
+        ensure!(info["nettype"]=="fakechain" && info["offline"]==true
+            && info["incoming_connections_count"].as_u64()==Some(0)
+            && info["outgoing_connections_count"].as_u64()==Some(0),"refund GUI requires offline native fakechain");
+        Ok(())
+    }
+    async fn refund_rpc(config:&Config,execution:&mut Execution,request:&Request,checking:bool)->Result<serde_json::Value> {
+        use swap_machine::{litecoin_rpc::LitecoinRpc,native_funding_rpc::{NativeFundingRpc,relay::NativeTransferRelay},
+            litecoin_negotiation::execution::refund_approval::RefundAction};
+        use swap_core::litecoin_address::{LtcNetwork,LtcSegwitAddress};
+        ensure!(config.role=="native-funder" && config.policy.ltc_network==LtcNetwork::Regtest,
+            "refund GUI submission is limited to isolated-chain development");
+        let approval=if checking {None} else {
+            let approved=parse_commitment(request.commitment.as_deref().context("missing refund approval")?)?;
