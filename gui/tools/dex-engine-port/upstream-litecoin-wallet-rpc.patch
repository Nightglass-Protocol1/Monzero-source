+//! Durable recovery-signature operations under the execution metadata lease.
+use super::*;
+use crate::litecoin_negotiation::recovery::{RecoveryPlan, SignedRecovery};
+use bitcoin::{psbt::Psbt, Transaction};
+use std::str::FromStr;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent { schema:String,checkpoint:[u8;32],psbt:String,policy:Policy,admitted_at:u64 }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Message { bytes:Vec<u8>,signature:Vec<u8> }
+
+/// Retained recovery only; this is not a funding permit or chain observation.
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryTransactions {
+    pub cancel:Transaction,
+    pub refund:Option<Transaction>,
+    pub punish:Option<Transaction>,
+}
+fn name(trade:uuid::Uuid,suffix:&str)->String { format!("{trade}.ltc-recovery-{suffix}") }
+fn missing(error:&anyhow::Error)->bool {
+    error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)
+}
+impl Execution {
+    pub(super) fn recovery_admission(&self,head:&Head)->Result<(Policy,u64)> {
+        let bytes=self.metadata.read(&name(self.claim.trade,"intent"))?;
+        let intent:Intent=serde_json::from_slice(&bytes)?;
+        let digest:[u8;32]=Sha256::digest(&bytes).into();
+        ensure!(serde_json::to_vec(&intent)?==bytes && intent.schema=="monzero-ltc-recovery-intent-v1"
+            && intent.checkpoint==head.checkpoint && head.step==2 && head.recovery_intent==Some(digest),
+            "invalid committed recovery agreement");
+        Ok((intent.policy,intent.admitted_at))
+    }
+
+    pub(super) fn recovery_plan(&self)->Result<(RecoveryPlan,LocalKeys)> {
+        let (head,_,quote,local,exchange)=self.load()?;
+        let bytes=self.metadata.read(&name(self.claim.trade,"intent"))?;
+        let intent:Intent=serde_json::from_slice(&bytes)?;
+        ensure!(serde_json::to_vec(&intent)?==bytes && intent.schema=="monzero-ltc-recovery-intent-v1"
+            && intent.checkpoint==head.checkpoint && head.step==2
+            && head.recovery_intent==Some(Sha256::digest(&bytes).into()),
+            "invalid retained Litecoin recovery intent");
+        ensure!(exchange.accepted.last().is_some_and(|frame|frame.accepted_at<=intent.admitted_at),
+            "recovery predates completed key exchange");
+        let keys=exchange.finish()?;
+        let plan=RecoveryPlan::new(&quote,&intent.policy,intent.admitted_at,&keys,Psbt::from_str(&intent.psbt)?)?;
+        self.metadata.retain(&name(self.claim.trade,"intent"),&bytes)?;
+        Ok((plan,local))
+    }
+
+    /// Commit the exact lock and outgoing recovery message before returning it.
+    /// A retained message can be retried after expiry; it gives no funding permission.
+    pub fn prepare_recovery(&mut self,psbt:&Psbt,identity:&ed25519_dalek::SigningKey,now:u64)->Result<SignedRecovery> {
+        ensure!(identity.verifying_key().to_bytes()==self.claim.pins[usize::from(self.claim.role)],
+            "wrong local recovery identity");
+        let (mut head,previous,_,_,_)=self.load()?;
+        let intent_name=name(self.claim.trade,"intent");
+        match self.metadata.read(&intent_name) {
+            Ok(bytes)=>{
+                let intent:Intent=serde_json::from_slice(&bytes)?;
+                ensure!(intent.psbt==psbt.to_string(),"recovery already bound to another lock");
+            },
+            Err(e) if missing(&e)=>{
+                let (head,_,quote,_,exchange)=self.load()?;
+                ensure!(head.step==2 && exchange.accepted.last().is_some_and(|frame|frame.accepted_at<=now),
+                    "recovery requires a completed key exchange");
+                let keys=exchange.finish()?;
+                RecoveryPlan::new(&quote,&self.policy,now,&keys,psbt.clone())?;
+                let intent=Intent { schema:"monzero-ltc-recovery-intent-v1".into(),checkpoint:head.checkpoint,
+                    psbt:psbt.to_string(),policy:self.policy.clone(),admitted_at:now };
+                self.metadata.retain(&intent_name,&serde_json::to_vec(&intent)?)?;
+            },
+            Err(e)=>return Err(e),
+        }
+        let retained=self.metadata.read(&intent_name)?;
+        let digest=Sha256::digest(&retained).into();
+        if let Some(expected)=head.recovery_intent {
+            ensure!(expected==digest,"recovery intent differs from committed head");
+        } else {
+            head.recovery_intent=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        let outgoing_name=name(self.claim.trade,"outgoing");
+        match self.metadata.read(&outgoing_name) {
+            Ok(_)=>return self.recover_recovery_outgoing(),
+            Err(e) if missing(&e)=>(),
+            Err(e)=>return Err(e),
+        }
+        // Only already-retained signatures may bypass fresh quote admission.
+        let (_,_,quote,_,_)=self.load()?;
+        quote.check_policy(&self.policy,now)?;
+        let intent:Intent=serde_json::from_slice(&retained)?;
+        ensure!(now>=intent.admitted_at,"recovery signing predates admission");
+        let (plan,local)=self.recovery_plan()?;
+        let signed=plan.sign(&local,identity)?;
+        let message=Message { bytes:signed.bytes().to_vec(),signature:signed.signature().to_vec() };
+        self.metadata.retain(&outgoing_name,&serde_json::to_vec(&message)?)?;
+        Ok(signed)
+    }
+
+    /// Recover identical signed bytes without needing the identity signing key.
+    pub fn recover_recovery_outgoing(&self)->Result<SignedRecovery> {
+        let (plan,_)=self.recovery_plan()?;
+        let filename=name(self.claim.trade,"outgoing");
+        let bytes=self.metadata.read(&filename)?;
+        let message:Message=serde_json::from_slice(&bytes)?;
+        ensure!(serde_json::to_vec(&message)?==bytes,"noncanonical retained recovery message");
+        plan.verify_local_message(&message.bytes,&message.signature)?;
+        self.metadata.retain(&filename,&bytes)?;
+        Ok(SignedRecovery::from_verified(message.bytes,message.signature.try_into()
+            .map_err(|_|anyhow::anyhow!("invalid recovery signature length"))?))
+    }
+
+    fn complete_recovery(&self,bytes:&[u8],signature:&[u8])->Result<RecoveryTransactions> {
+        self.recover_recovery_outgoing()?;
+        let (plan,local)=self.recovery_plan()?;
+        match self.role {
+            LocalRole::LitecoinFunder=>{
+                let result=plan.complete_funder(&local,bytes,signature)?;
+                Ok(RecoveryTransactions { cancel:result.cancel,refund:Some(result.refund),punish:None })
+            },
+            LocalRole::NativeFunder=>{
+                let result=plan.complete_native(&local,bytes,signature)?;
+                Ok(RecoveryTransactions { cancel:result.cancel,refund:None,punish:Some(result.punish) })
+            },
+        }
+    }
+
+    /// Persist the peer message before the completed transactions. An interrupted
+    /// publication is recovered from that exact message, never a replacement lock.
+    pub fn accept_recovery(&mut self,bytes:&[u8],signature:&[u8])->Result<RecoveryTransactions> {
+        let transactions=self.complete_recovery(bytes,signature)?;
+        let peer=Message { bytes:bytes.to_vec(),signature:signature.to_vec() };
+        self.metadata.retain(&name(self.claim.trade,"incoming"),&serde_json::to_vec(&peer)?)?;
+        self.metadata.retain(&name(self.claim.trade,"completed"),&serde_json::to_vec(&transactions)?)?;
+        Ok(transactions)
+    }
+
+    /// Reobserve the exact recovered lock, including pending spends, before
+    /// considering redeem-signature release. Native funding must also be checked.
+    pub async fn observe_live_lock(&mut self,rpc:&crate::litecoin_rpc::LitecoinRpc,
+        safety_blocks:u32)->Result<crate::litecoin_rpc::VerifiedLiveLock> {
+        let (_,_,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        let recovery=self.recover_recovery()?;
+        let outpoint=recovery.cancel.input.first().context("missing cancellation input")?.previous_output;
+        let required=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let evidence=rpc.verify_live_lock(outpoint,keys.contract_address().script_pubkey(),
+            bitcoin::Amount::from_sat(quote.terms()["ltcAtoms"].parse()?),required,
+            quote.terms()["cancelBlocks"].parse()?,safety_blocks).await?;
+        ensure!(evidence.network()==self.policy.ltc_network,"wrong Litecoin observation network");
+        Ok(evidence)
+    }
+
+    /// Sign only the reserved lock backed by this controller's retained peer
+    /// recovery. The wallet independently checks its reservation, keys, exact
+    /// recovery transactions and fresh quote before requesting wallet signatures.
+    /// This does not relay funds or authorize the remaining native-chain leg.
+    pub async fn sign_recovered_lock(&mut self,rpc:&crate::litecoin_rpc::LitecoinRpc,
+        reservation_directory:&Path,now:u64)->Result<crate::litecoin_rpc::reservation::SignedLock> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"only Litecoin funder may sign its lock");
+        let (_,_,quote,_,exchange)=self.load()?;
+        quote.check_policy(&self.policy,now)?;
+        let keys=exchange.finish()?;
+        let recovery=self.recover_recovery()?;
+        ensure!(recovery.punish.is_none(),"unexpected funder punishment transaction");
+        let refund=recovery.refund.context("retained funder recovery lacks refund")?;
+        rpc.sign_reserved_lock_for_exchange(reservation_directory,self.claim.trade,&quote,
+            &self.policy,now,&keys,&recovery.cancel,&refund).await
+    }
+
+    /// Cold recovery revalidates the original signatures, then completes any
+    /// interrupted receipt publication. It never refreshes quote validity.
+    pub fn recover_recovery(&mut self)->Result<RecoveryTransactions> {
+        let bytes=self.metadata.read(&name(self.claim.trade,"incoming"))?;
+        let peer:Message=serde_json::from_slice(&bytes)?;
+        ensure!(serde_json::to_vec(&peer)?==bytes,"noncanonical retained peer recovery");
+        self.accept_recovery(&peer.bytes,&peer.signature)
+    }
+}
