+//! Transport for owner-validated, immutable Litecoin redemption bytes.
+use super::*;
+use bitcoin::{Transaction,consensus::encode::serialize_hex};
+
+impl LitecoinRpc {
+    pub(crate) fn network(&self)->LtcNetwork {self.network}
+
+    pub(crate) async fn preflight_contract_spend(&self,transaction:&Transaction)->Result<()> {
+        ensure!(transaction.input.len()==1 && transaction.output.len()==1
+            && !transaction.input[0].witness.is_empty(),"invalid completed redemption shape");
+        let before=self.chain().await?;
+        let accepted:Vec<Value>=serde_json::from_str(self.rpc(false,"testmempoolaccept",
+            json!([[serialize_hex(transaction)]])).await?.get())?;
+        ensure!(accepted.len()==1 && accepted[0]["txid"]==transaction.compute_txid().to_string()
+            && accepted[0]["allowed"]==true,"completed redemption is not currently acceptable");
+        ensure!(self.chain().await?==before,"Litecoin chain changed during redemption preflight");
+        Ok(())
+    }
+
+    /// The execution owner must durably commit dispatch before calling this.
+    /// Any transport failure or unexpected reply is an uncertain broadcast.
+    pub(crate) async fn dispatch_contract_spend(&self,transaction:&Transaction)->bool {
+        match self.rpc(false,"sendrawtransaction",json!([serialize_hex(transaction)])).await {
+            Ok(reply)=>serde_json::from_str::<bitcoin::Txid>(reply.get()).ok()==Some(transaction.compute_txid()),
+            Err(_)=>false,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{io::{Read,Write},os::unix::fs::OpenOptionsExt};
+    use serde::Deserialize;
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Request {port:u16,anchor:String,transaction:String}
+    #[tokio::test]
+    #[ignore="requires caller-owned Litecoin regtest node and signed fixture transaction"]
+    async fn actual_completed_redeem_transport()->Result<()> {
