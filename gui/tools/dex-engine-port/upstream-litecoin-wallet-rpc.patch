+fn rejected_frames_do_not_advance_cursor() -> Result<()> {
+    let (policy,quote,bob,alice) = setup();
+    let mut exchange = KeyExchange::new(&quote,&policy,1000,LocalRole::NativeFunder,&alice)?;
+    let valid = exchange.prepare(bob.share.clone())?;
+    assert!(exchange.accept(&valid,&signature(&valid,2),1000).is_err());
+    assert!(exchange.accept(&valid,&signature(&valid,1),2000).is_err());
+    let mut spaced=valid.clone(); spaced.push(b' ');
+    assert!(exchange.accept(&spaced,&signature(&spaced,1),1000).is_err());
+    for field in ["schema","quoteCommitment","swapId","previous"] {
+        let mut frame: serde_json::Value=serde_json::from_slice(&valid)?;
+        frame[field]="wrong".into(); let bytes=canonical(&frame)?;
+        assert!(exchange.accept(&bytes,&signature(&bytes,1),1000).is_err());
+    }
+    for case in 0..5 {
+        let mut bad=bob.share.clone();
+        match case {
+            0 => bad.native_spend_key=EdwardsPoint::identity().compress().to_bytes(),
+            1 => bad.view_share=[0;32],
+            2 => bad.view_share=[255;32],
+            3 => bad.proof=alice.share.proof.clone(),
+            _ => bad.contract_key=bad.adaptor_key,
+        }
+        let bytes=exchange.prepare(bad)?;
+        assert!(exchange.accept(&bytes,&signature(&bytes,1),1000).is_err());
+    }
+    assert_eq!(exchange.prepare(bob.share.clone())?,valid);
+    exchange.accept(&valid,&signature(&valid,1),1000)?;
+    // Even a valid signature from our own pinned identity must not substitute
+    // fresh keys whose secrets this instance does not hold.
+    let mut rng=rand::rngs::StdRng::seed_from_u64(55);
+    let (_,other)=LocalKeys::generate(&mut rng);
+    let substitute=exchange.prepare(other)?;
+    assert!(exchange.accept(&substitute,&signature(&substitute,2),1000).is_err());
+    let reused=exchange.prepare(bob.share.clone())?;
+    assert!(exchange.accept(&reused,&signature(&reused,2),1000).is_err());
+    let bytes=exchange.prepare(alice.share.clone())?;
+    exchange.accept(&bytes,&signature(&bytes,2),1000)?;
+    exchange.finish()?;
+    assert!(KeyExchange::new(&quote,&policy,2000,LocalRole::NativeFunder,&alice).is_err());
+    assert!(KeyExchange::new(&quote,&policy,1000,LocalRole::NativeFunder,&alice)?.finish().is_err());
+    Ok(())
