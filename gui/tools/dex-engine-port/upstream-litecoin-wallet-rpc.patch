+//! Durable Bob redeem release, gated by current evidence from both chains.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,xmz_funding::FundingObserver};
+use crate::litecoin_negotiation::recovery::redeem::SignedRedeem;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Release { schema:String,checkpoint:[u8;32],quote:[u8;32],native_proof:[u8;32],bytes:Vec<u8>,signature:Vec<u8> }
+pub(super) fn release_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-redeem-outgoing") }
+impl Execution {
+    pub async fn release_redeem(&mut self,native:&impl FundingObserver,ltc:&LitecoinRpc,
+        safety_blocks:u32,identity:&ed25519_dalek::SigningKey)->Result<SignedRedeem> {
+        ensure!(identity.verifying_key().to_bytes()==self.claim.pins[0],"wrong redeem identity");
+        self.checked_release(native,ltc,safety_blocks,Some(identity)).await
+    }
+
+    /// An identity-free retry still checks current funding, the live lock and
+    /// cancellation margin. A saved frame never bypasses either chain check.
+    pub async fn recover_redeem_release(&mut self,native:&impl FundingObserver,ltc:&LitecoinRpc,
+        safety_blocks:u32)->Result<SignedRedeem> {
+        self.checked_release(native,ltc,safety_blocks,None).await
+    }
+
+    async fn checked_release(&mut self,native:&impl FundingObserver,ltc:&LitecoinRpc,
+        safety_blocks:u32,identity:Option<&ed25519_dalek::SigningKey>)->Result<SignedRedeem> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong redeem release role");
+        let filename=release_name(self.claim.trade);
+        let retained=match self.metadata.read(&filename) {
+            Ok(bytes)=>Some(bytes),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                ensure!(identity.is_some(),"no retained redeem release");None
+            },
+            Err(e)=>return Err(e),
+        };
+        // Load/revalidate slow proof state before the final chain observations.
+        let (plan,local)=self.recovery_plan()?;
+        let evidence=self.recover_native_funding(native).await?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        evidence.check_trade(&keys,&quote)?;
+        let snapshot=evidence.funding().snapshot();
+        let depth=snapshot.tip_height.checked_sub(evidence.funding().height())
+            .and_then(|v|v.checked_add(1)).context("invalid native funding depth")?;
+        ensure!(depth>=u64::from(self.policy.xmz_confirmations),"native evidence below current confirmation policy");
+        let live=self.observe_live_lock(ltc,safety_blocks).await?;
+        ensure!(native.snapshot().await?==*snapshot,"native chain changed before redeem release");
+        ensure!(live.observation().script==*keys.contract_address().script_pubkey()
+            && live.observation().amount.to_sat()==quote.terms()["ltcAtoms"].parse::<u64>()?,
+            "redeem release live lock differs from quote");
+        // Binding to the exact recovered outpoint also prevents a future caller
+        // from substituting another output with an identical script and amount.
+        ensure!(live.outpoint()==plan.lock_outpoint(),"redeem release outpoint mismatch");
+        let native_txid=&evidence.funding().request().proof.tx_hash.0;
+        let native_proof=head.native_proof.context("native proof is not committed")?;
+        let (record,bytes)=if let Some(bytes)=retained {
+            let record:Release=serde_json::from_slice(&bytes)?;
+            ensure!(serde_json::to_vec(&record)?==bytes,"noncanonical retained redeem release");
+            (record,bytes)
+        } else {
+            ensure!(head.redeem_outgoing.is_none(),"committed redeem release is missing");
+            let signed=plan.prepare_redeem(&local,identity.context("missing redeem identity")?,native_txid)?;
+            let record=Release { schema:"monzero-ltc-redeem-release-v1".into(),checkpoint:head.checkpoint,
+                quote:self.claim.quote,native_proof,bytes:signed.bytes().to_vec(),signature:signed.signature().to_vec() };
+            let bytes=serde_json::to_vec(&record)?;(record,bytes)
+        };
+        ensure!(record.schema=="monzero-ltc-redeem-release-v1" && record.checkpoint==head.checkpoint
+            && record.quote==self.claim.quote && record.native_proof==native_proof,
+            "retained redeem release context mismatch");
+        plan.checked_redeem(native_txid,&record.bytes,&record.signature)?;
+        let signature:[u8;64]=record.signature.try_into().map_err(|_|anyhow::anyhow!("invalid redeem identity signature length"))?;
+        let digest=Sha256::digest(&bytes).into();
+        if let Some(expected)=head.redeem_outgoing { ensure!(expected==digest,"redeem release differs from head"); }
+        self.metadata.retain(&filename,&bytes)?;
+        if head.redeem_outgoing.is_none() {
+            head.redeem_outgoing=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(SignedRedeem::from_verified(record.bytes,signature))
+    }
+}
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeClaim {
+    schema:String,checkpoint:[u8;32],quote:[u8;32],native_proof:[u8;32],release:[u8;32],
+    transaction:bitcoin::Transaction,
+}
+pub(super) fn claim_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-claim") }
+impl Execution {
+    /// Recover private native wallet material only after observing the exact
+    /// redemption and native funding. Retain the redemption witness before keys
+    /// leave this operation. This prepares a claim; it does not relay a payment.
+    /// Retries reobserve both chains rather than trusting retained confirmations.
+    pub async fn prepare_native_claim(&mut self,native:&impl FundingObserver,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash)->Result<super::native_claim_wallet::PreparedNativeClaim> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong native claim role");
+        let (plan,local)=self.recovery_plan()?;
+        let evidence=self.recover_native_funding(native).await?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;evidence.check_trade(&keys,&quote)?;
+        let snapshot=evidence.funding().snapshot();
+        let depth=snapshot.tip_height.checked_sub(evidence.funding().height())
+            .and_then(|v|v.checked_add(1)).context("invalid native claim funding depth")?;
+        ensure!(depth>=u64::from(self.policy.xmz_confirmations),"native claim funding below current confirmation policy");
+        let native_proof=head.native_proof.context("native claim lacks committed proof")?;
+        let release=head.redeem_outgoing.context("native claim lacks committed redeem release")?;
+        let bytes=self.metadata.read(&release_name(self.claim.trade))?;
+        let release_record:Release=serde_json::from_slice(&bytes)?;
+        ensure!(serde_json::to_vec(&release_record)?==bytes && <[u8;32]>::from(Sha256::digest(&bytes))==release
+            && release_record.schema=="monzero-ltc-redeem-release-v1" && release_record.checkpoint==head.checkpoint
+            && release_record.quote==self.claim.quote && release_record.native_proof==native_proof,
+            "native claim redeem release context mismatch");
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.confirmed_transaction(plan.redeem_txid(),block,minimum).await?;
+        ensure!(observed.network()==self.policy.ltc_network,"wrong native claim Litecoin network");
+        let candidate=NativeClaim {schema:"monzero-ltc-native-claim-v1".into(),checkpoint:head.checkpoint,
+            quote:self.claim.quote,native_proof,release,transaction:observed.transaction().clone()};
+        let retained=match Journal::open(&self.snapshots)?.read(&claim_name(self.claim.trade)) {
+            Ok(bytes)=>Some(zeroize::Zeroizing::new(bytes)),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>None,
+            Err(e)=>return Err(e),
+        };
+        let record=select_claim_witness(candidate,retained.as_ref().map(|v|v.as_slice()),head.native_claim)?;
+        // Revalidate the original extraction witness against the retained signed
+        // release. The currently confirmed witness need not repeat those bytes.
+        let recovered=plan.recover_native_claim_keys(&local,&keys,&evidence.funding().request().proof.tx_hash.0,
+            &release_record.bytes,&release_record.signature,record.transaction.clone())?;
+        ensure!(native.snapshot().await?==*snapshot,"native chain changed during claim preparation");
+        let bytes=zeroize::Zeroizing::new(serde_json::to_vec(&record)?);
+        let digest=Sha256::digest(&*bytes).into();
+        if let Some(expected)=head.native_claim {ensure!(expected==digest,"native claim differs from committed redemption");}
+        Journal::open(&self.snapshots)?.retain(&claim_name(self.claim.trade),&bytes)?;
+        if head.native_claim.is_none() {
+            head.native_claim=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        super::native_claim_wallet::PreparedNativeClaim::new(recovered,&quote,keys.native_address().clone(),
+            evidence.funding().request().proof.tx_hash.0.clone())
+    }
+}
+
+impl Execution {
+    /// Retained validated witness, not current chain evidence. Used only to bind
+    /// a fresh observation to the exact redemption that authorized claim recovery.
+    pub(super) fn retained_native_redemption(&self)->Result<bitcoin::Transaction> {
+        let (head,_,_,_,_)=self.load()?;
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong native redemption recovery role");
+        let bytes=zeroize::Zeroizing::new(Journal::open(&self.snapshots)?.read(&claim_name(self.claim.trade))?);
+        let record:NativeClaim=serde_json::from_slice(&bytes)?;
+        ensure!(Some(<[u8;32]>::from(Sha256::digest(&*bytes)))==head.native_claim
+            && *zeroize::Zeroizing::new(serde_json::to_vec(&record)?)==*bytes
+            && record.schema=="monzero-ltc-native-claim-v1" && record.checkpoint==head.checkpoint
+            && record.quote==self.claim.quote && Some(record.native_proof)==head.native_proof
+            && Some(record.release)==head.redeem_outgoing,"retained redemption context mismatch");
+        Ok(record.transaction)
+    }
+}
+
+/// Witness-independent transaction equality. Chain inclusion still comes only
+/// from confirmed_transaction; this helper grants no authority to arbitrary bytes.
+pub(super) fn same_redemption_effect(expected:&bitcoin::Transaction,observed:&bitcoin::Transaction)->bool {
+    expected.version==observed.version && expected.lock_time==observed.lock_time && expected.output==observed.output
+        && expected.input.len()==observed.input.len() && expected.input.iter().zip(&observed.input).all(|(a,b)|
+            a.previous_output==b.previous_output && a.script_sig==b.script_sig && a.sequence==b.sequence)
+}
+fn select_claim_witness(candidate:NativeClaim,retained:Option<&[u8]>,pin:Option<[u8;32]>)->Result<NativeClaim> {
+    let Some(bytes)=retained else {
+        ensure!(pin.is_none(),"committed native claim is missing");
+        return Ok(candidate);
+    };
+    if let Some(expected)=pin {ensure!(<[u8;32]>::from(Sha256::digest(bytes))==expected,"native claim differs from head");}
+    let saved:NativeClaim=serde_json::from_slice(bytes)?;
+    ensure!(*zeroize::Zeroizing::new(serde_json::to_vec(&saved)?)==bytes
+        && saved.schema==candidate.schema && saved.checkpoint==candidate.checkpoint
+        && saved.quote==candidate.quote && saved.native_proof==candidate.native_proof && saved.release==candidate.release
+        && same_redemption_effect(&saved.transaction,&candidate.transaction),"retained claim differs from observed redemption");
+    Ok(saved)
+}
+
+#[cfg(test)]
+mod witness_tests {
+    use super::*;
+    fn claim()->NativeClaim {
+        NativeClaim {schema:"monzero-ltc-native-claim-v1".into(),checkpoint:[1;32],quote:[2;32],native_proof:[3;32],release:[4;32],
+            transaction:bitcoin::Transaction {version:bitcoin::transaction::Version::TWO,lock_time:bitcoin::absolute::LockTime::ZERO,
+                input:vec![bitcoin::TxIn {previous_output:bitcoin::OutPoint::null(),script_sig:Default::default(),
+                    sequence:bitcoin::Sequence::MAX,witness:bitcoin::Witness::from_slice(&[b"original-fixture-witness"])}],
+                output:vec![bitcoin::TxOut {value:bitcoin::Amount::from_sat(100),script_pubkey:bitcoin::ScriptBuf::new()}]}}
+    }
+    #[test]
+    fn retained_witness_survives_same_transaction_witness_replacement()->Result<()> {
+        // These are serialization fixtures, not valid signatures or chain evidence.
+        let saved=claim();let bytes=serde_json::to_vec(&saved)?;let pin=Sha256::digest(&bytes).into();
+        let mut candidate=claim();candidate.transaction.input[0].witness=bitcoin::Witness::from_slice(&[b"replacement-fixture-witness"]);
+        assert_eq!(saved.transaction.compute_txid(),candidate.transaction.compute_txid());
+        assert_ne!(saved.transaction.compute_wtxid(),candidate.transaction.compute_wtxid());
+        assert!(same_redemption_effect(&saved.transaction,&candidate.transaction));
+        let recovered=select_claim_witness(candidate,Some(&bytes),Some(pin))?;
+        assert_eq!(serde_json::to_vec(&recovered)?,bytes);
+        assert_eq!(serde_json::to_vec(&select_claim_witness(claim(),Some(&bytes),None)?)?,bytes);
+        assert!(select_claim_witness(claim(),None,Some(pin)).is_err());
+        assert!(select_claim_witness(claim(),Some(&bytes),Some([9;32])).is_err());
+        for field in 0..6 {
+            let mut bad=claim();
+            match field {0=>bad.quote[0]^=1,1=>bad.checkpoint[0]^=1,2=>bad.native_proof[0]^=1,
+                3=>bad.release[0]^=1,4=>bad.schema.push('x'),_=>bad.transaction.output[0].value=bitcoin::Amount::from_sat(99)}
+            assert!(select_claim_witness(bad,Some(&bytes),Some(pin)).is_err());
+        }
+        Ok(())
+    }
+    #[test]
+    fn witness_equivalence_rejects_every_nonwitness_transaction_change() {
+        let expected=claim().transaction;
+        for field in 0..7 {
+            let mut changed=expected.clone();
+            match field {0=>changed.version=bitcoin::transaction::Version::ONE,
+                1=>changed.lock_time=bitcoin::absolute::LockTime::from_consensus(1),
+                2=>changed.input[0].previous_output.vout=0,
+                3=>changed.input[0].script_sig=bitcoin::ScriptBuf::from_bytes(vec![0]),
+                4=>changed.input[0].sequence=bitcoin::Sequence::ZERO,
+                5=>changed.input.push(changed.input[0].clone()),
+                _=>changed.output[0].script_pubkey=bitcoin::ScriptBuf::from_bytes(vec![0])}
+            assert!(!same_redemption_effect(&expected,&changed),"accepted changed field {field}");
+        }
+    }
+}
