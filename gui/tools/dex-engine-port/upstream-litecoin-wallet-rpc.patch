+fn private_checkpoint_storage_survives_reopen_and_fails_closed() -> Result<()> {
+    use std::os::unix::fs::{DirBuilderExt,PermissionsExt};
+    let path=std::env::temp_dir().canonicalize()?.join(format!("ltc-protocol-store-{}",uuid::Uuid::new_v4()));
+    std::fs::DirBuilder::new().mode(0o700).create(&path)?;
+    let (policy,quote,bob,alice)=setup();
+    let mut exchange=KeyExchange::new(&quote,&policy,1000,LocalRole::LitecoinFunder,&bob)?;
+    assert!(storage::persist(&path,&quote,&policy,LocalRole::LitecoinFunder,&alice,&exchange).is_err());
+    assert_eq!(std::fs::read_dir(&path)?.count(),0);
+    let frame=exchange.prepare(bob.share.clone())?;
+    exchange.accept(&frame,&signature(&frame,1),1000)?;
+    let checkpoint=storage::persist(&path,&quote,&policy,LocalRole::LitecoinFunder,&bob,&exchange)?;
+    drop(exchange); drop(bob);
+    let (keys,mut restored)=storage::restore(&path,&quote,&policy,LocalRole::LitecoinFunder,&checkpoint)?;
+    assert!(restored.accept(&frame,&signature(&frame,1),1000).is_err());
+    let second=restored.prepare(alice.share.clone())?;
+    restored.accept(&second,&signature(&second,2),1001)?;
+    let completed=storage::persist(&path,&quote,&policy,LocalRole::LitecoinFunder,&keys,&restored)?;
+    assert_ne!(completed,checkpoint);
+    let (_,again)=storage::restore(&path,&quote,&policy,LocalRole::LitecoinFunder,&completed)?;
+    assert_eq!(restored.finish()?.transcript_commitment(),again.finish()?.transcript_commitment());
+    assert!(storage::restore(&path,&quote,&policy,LocalRole::LitecoinFunder,&[0;32]).is_err());
+    assert!(storage::restore(&path,&quote,&policy,LocalRole::NativeFunder,&completed).is_err());
+    for entry in std::fs::read_dir(&path)? {
+        assert_eq!(entry?.metadata()?.permissions().mode()&0o777,0o600);
+    }
+    std::fs::set_permissions(&path,std::fs::Permissions::from_mode(0o755))?;
+    assert!(storage::restore(&path,&quote,&policy,LocalRole::LitecoinFunder,&completed).is_err());
+    std::fs::set_permissions(&path,std::fs::Permissions::from_mode(0o700))?;
+    // Missing committed state must not fall back to the older valid checkpoint.
+    let newest=std::fs::read_dir(&path)?.map(|e|e.unwrap().path())
+        .find(|p|p.file_name().unwrap().to_string_lossy().ends_with(&hex(&completed))).unwrap();
+    std::fs::remove_file(newest)?;
+    assert!(storage::restore(&path,&quote,&policy,LocalRole::LitecoinFunder,&completed).is_err());
+    std::fs::remove_dir_all(path)?;
+    Ok(())
+}
