+//! Retained native transfer proofs, with fresh chain observation on every use.
+use super::*;
+use crate::litecoin_negotiation::native_funding::{verify_new_funding,VerifiedNativeFunding};
+use crate::xmz_funding::FundingObserver;
+use swap_core::monero::TransferProof;
+use zeroize::Zeroizing;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeProof {
+    schema:String,checkpoint:[u8;32],quote:[u8;32],policy:Policy,agreement_at:u64,admitted_at:u64,proof:TransferProof,
+}
+pub(super) fn proof_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-proof") }
+fn missing(error:&anyhow::Error)->bool {
+    error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)
+}
+impl Execution {
+    /// Validate a peer proof against the committed recovery agreement, even if
+    /// confirmation arrives after quote expiry. This is observation only: new
+    /// Litecoin signing still checks freshness, and redeem release separately
+    /// requires a live Litecoin lock and fresh evidence from both chains.
+    pub async fn admit_native_funding(&mut self,observer:&impl FundingObserver,
+        proof:TransferProof,now:u64)->Result<VerifiedNativeFunding> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong native-observation role");
+        self.recover_recovery()?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let last=exchange.accepted.last().context("missing key exchange")?.accepted_at;
+        let keys=exchange.finish()?;
+        let filename=proof_name(self.claim.trade);
+        let retained={ let journal=Journal::open(&self.snapshots)?;journal.read(&filename).map(Zeroizing::new) };
+        if let Ok(bytes)=&retained {
+            let record:NativeProof=serde_json::from_slice(bytes)?;
+            ensure!(record.proof==proof,"native funding already bound to another proof");
+            return self.recover_native_funding(observer).await;
+        }
+        if let Err(e)=retained { if !missing(&e) { return Err(e); } }
+        let (agreement,agreement_at)=self.recovery_admission(&head)?;
+        ensure!(head.native_proof.is_none() && now>=last && now>=agreement_at,"invalid native funding admission state");
+        let verified=verify_new_funding(observer,&keys,&quote,&agreement,agreement_at,proof.clone()).await?;
+        let record=NativeProof { schema:"monzero-ltc-native-proof-v2".into(),checkpoint:head.checkpoint,
+            quote:self.claim.quote,policy:agreement,agreement_at,admitted_at:now,proof };
+        let bytes=Zeroizing::new(serde_json::to_vec(&record)?);
+        Journal::open(&self.snapshots)?.retain(&filename,&bytes)?;
+        head.native_proof=Some(Sha256::digest(&*bytes).into());
+        self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        Ok(verified)
+    }
+
+    /// Offline identity only, never proof of current confirmation or spendability.
+    /// Requires a digest already committed by the execution owner.
+    pub(super) fn retained_native_txid(&self)->Result<String> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong native proof recovery role");
+        let (head,_,_,_,exchange)=self.load()?;
+        let bytes=Zeroizing::new(Journal::open(&self.snapshots)?.read(&proof_name(self.claim.trade))?);
+        ensure!(Some(<[u8;32]>::from(Sha256::digest(&*bytes)))==head.native_proof,
+            "native payout requires committed funding proof");
+        let record:NativeProof=serde_json::from_slice(&bytes)?;
+        let (agreement,agreement_at)=self.recovery_admission(&head)?;
+        ensure!(*Zeroizing::new(serde_json::to_vec(&record)?)==*bytes
+            && record.schema=="monzero-ltc-native-proof-v2" && record.quote==self.claim.quote
+            && record.checkpoint==head.checkpoint && record.agreement_at==agreement_at
+            && record.admitted_at>=agreement_at
+            && serde_json::to_vec(&record.policy)?==serde_json::to_vec(&agreement)?
+            && exchange.accepted.last().is_some_and(|frame|frame.accepted_at<=record.admitted_at),
+            "invalid retained payout funding context");
+        Ok(record.proof.tx_hash.0)
+    }
+
+    /// Restore the exact proof and check current native chain state. Stored
+    /// confirmations are never treated as evidence. Also completes publication
+    /// if the process stopped after proof retention but before head replacement.
+    pub async fn recover_native_funding(&mut self,observer:&impl FundingObserver)->Result<VerifiedNativeFunding> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong native-observation role");
+        self.recover_recovery()?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let filename=proof_name(self.claim.trade);
+        let bytes=Zeroizing::new(Journal::open(&self.snapshots)?.read(&filename)?);
+        let record:NativeProof=serde_json::from_slice(&bytes)?;
+        let canonical=Zeroizing::new(serde_json::to_vec(&record)?);
+        let (agreement,agreement_at)=self.recovery_admission(&head)?;
+        ensure!(*canonical==*bytes && record.schema=="monzero-ltc-native-proof-v2"
+            && record.agreement_at==agreement_at && record.admitted_at>=agreement_at
+            && serde_json::to_vec(&record.policy)?==serde_json::to_vec(&agreement)?
+            && record.quote==self.claim.quote && record.checkpoint==head.checkpoint
+            && exchange.accepted.last().is_some_and(|frame|frame.accepted_at<=record.admitted_at),
+            "invalid retained native proof context");
+        let digest=Sha256::digest(&*bytes).into();
+        if let Some(expected)=head.native_proof { ensure!(expected==digest,"native proof differs from head"); }
+        let keys=exchange.finish()?;
+        let verified=verify_new_funding(observer,&keys,&quote,&record.policy,record.agreement_at,record.proof).await?;
+        Journal::open(&self.snapshots)?.retain(&filename,&bytes)?;
+        if head.native_proof.is_none() {
+            head.native_proof=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(verified)
+    }
+}
