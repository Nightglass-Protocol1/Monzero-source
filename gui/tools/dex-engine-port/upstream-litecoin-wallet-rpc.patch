+        }
+        if let Some(expected)=head.native_refund_payout_dispatch {
+            ensure!(head.native_refund_payout.is_some(),"payout dispatch lacks prepared payment");
+            let retained=self.metadata.read(&refund_payout_relay::dispatch_name(self.claim.trade))?;
+            ensure!(<[u8;32]>::from(Sha256::digest(&retained))==expected,"missing or altered payout dispatch");
+        }
+        if let Some(expected)=head.native_refund_payout_receipt {
+            ensure!(head.native_refund_payout_dispatch.is_some(),"payout receipt lacks dispatch intent");
+            let retained=self.metadata.read(&refund_payout_relay::receipt_name(self.claim.trade))?;
+            ensure!(<[u8;32]>::from(Sha256::digest(&retained))==expected,"missing or altered payout receipt");
