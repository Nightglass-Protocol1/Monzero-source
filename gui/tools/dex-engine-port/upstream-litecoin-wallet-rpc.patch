+//! Native funding evidence bound to the negotiated Litecoin trade. This is
+//! point-in-time observation, not durable consent or permission to relay funds.
+use super::VerifiedKeys;
+use crate::{litecoin_quote::{Policy,VerifiedLtcQuote},xmz_funding::{self,FundingObserver,FundingRequest,VerifiedFunding}};
+use anyhow::{Result,ensure};
+use swap_core::{monero::TransferProof,xmz::XmzAmount};
+
+pub struct VerifiedNativeFunding {
+    quote:[u8;32],
+    transcript:[u8;32],
+    funding:VerifiedFunding,
+}
+impl VerifiedNativeFunding {
+    pub fn funding(&self)->&VerifiedFunding { &self.funding }
+
+    pub fn check_trade(&self,keys:&VerifiedKeys,quote:&VerifiedLtcQuote)->Result<()> {
+        keys.check_quote(quote)?;
+        keys.require_ltc_funder()?;
+        ensure!(self.quote==*quote.commitment() && self.transcript==*keys.transcript_commitment()
+            && self.funding.request().address==*keys.native_address()
+            && self.funding.request().amount.atoms()==quote.terms()["xmzAtoms"].parse::<u64>()?,
+            "native funding belongs to another Litecoin trade");
+        Ok(())
+    }
+}
+
+/// Admission for a new live funding observation. Recovery of an already-funded
+/// expired trade needs its committed historical context, not a refreshed quote.
+/// The observer must be caller-owned and verify native data independently of
+/// the peer. Recheck after delays/restarts/reorgs before releasing signatures.
+pub async fn verify_new_funding(observer:&impl FundingObserver,keys:&VerifiedKeys,
+    quote:&VerifiedLtcQuote,policy:&Policy,now:u64,proof:TransferProof)->Result<VerifiedNativeFunding> {
+    keys.check_quote(quote)?;
+    keys.require_ltc_funder()?;
+    quote.check_policy(policy,now)?;
+    let request=FundingRequest { address:keys.native_address().clone(),
+        amount:XmzAmount::from_atoms(quote.terms()["xmzAtoms"].parse()?),proof };
+    let funding=xmz_funding::verify(observer,request,&policy.xmz_genesis,u64::from(policy.xmz_confirmations)).await?;
+    Ok(VerifiedNativeFunding { quote:*quote.commitment(),transcript:*keys.transcript_commitment(),funding })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::litecoin_negotiation::{KeyExchange,LocalRole,tests::{setup,signature}};
+    use crate::xmz_funding::{ChainSnapshot,FundingObservation};
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    use swap_core::monero::{PrivateKey,TxHash};
+    use swap_core::monero::Scalar;
+
+    struct Observer { snapshot:ChainSnapshot,observation:FundingObservation,calls:AtomicUsize }
+    #[async_trait::async_trait]
+    impl FundingObserver for Observer {
+        async fn snapshot(&self)->Result<ChainSnapshot> {
+            self.calls.fetch_add(1,Ordering::SeqCst);
+            Ok(self.snapshot.clone())
+        }
+        async fn observe(&self,request:&FundingRequest)->Result<FundingObservation> {
+            // Assert what the adapter actually asks its trusted backend to verify.
+            ensure!(request.address.to_string()==self.observation.address
+                && request.amount.atoms()==500_000_000,"wrong native verification request");
+            Ok(self.observation.clone())
+        }
+    }
+    fn proof()->TransferProof { TransferProof::new(TxHash("ab".repeat(32)),PrivateKey::from_scalar(Scalar::ONE)) }
+
+    #[tokio::test]
+    async fn native_observation_is_bound_to_quote_role_and_shared_address()->Result<()> {
+        let (policy,quote,bob,alice)=setup();
+        let mut be=KeyExchange::new(&quote,&policy,1000,LocalRole::LitecoinFunder,&bob)?;
+        let mut ae=KeyExchange::new(&quote,&policy,1000,LocalRole::NativeFunder,&alice)?;
+        for (share,role) in [(bob.share.clone(),1),(alice.share.clone(),2)] {
+            let bytes=be.prepare(share)?;let sig=signature(&bytes,role);
+            be.accept(&bytes,&sig,1000)?;ae.accept(&bytes,&sig,1000)?;
+        }
+        let bk=be.finish()?;let ak=ae.finish()?;
+        assert_ne!(bk.native_address(),&quote.destinations().xmz_payout);
+        let mut observer=Observer { snapshot:ChainSnapshot { genesis:policy.xmz_genesis.clone(),
+            tip_hash:"ef".repeat(32),tip_height:109 },
+            observation:FundingObservation { txid:"ab".repeat(32),address:bk.native_address().to_string(),
+                received_atoms:500_000_000,in_pool:false,height:100,confirmations:10 },calls:AtomicUsize::new(0) };
+        let verified=verify_new_funding(&observer,&bk,&quote,&policy,1000,proof()).await?;
+        verified.check_trade(&bk,&quote)?;
+        assert!(verified.check_trade(&ak,&quote).is_err());
+        assert_eq!(verified.funding().request().address,*bk.native_address());
+        assert_eq!(observer.calls.load(Ordering::SeqCst),2);
+        observer.calls.store(0,Ordering::SeqCst);
+        assert!(verify_new_funding(&observer,&ak,&quote,&policy,1000,proof()).await.is_err());
+        assert!(verify_new_funding(&observer,&bk,&quote,&policy,2000,proof()).await.is_err());
+        let mut wrong=policy.clone();wrong.xmz_genesis="b".repeat(64);
+        assert!(verify_new_funding(&observer,&bk,&quote,&wrong,1000,proof()).await.is_err());
+        let mut changed=quote.terms().clone();changed.insert("quoteId".into(),uuid::Uuid::new_v4().to_string());
+        let other=crate::litecoin_quote::tests::signed(&changed,&policy,1000)?;
+        assert!(verified.check_trade(&bk,&other).is_err());
+        assert!(verify_new_funding(&observer,&bk,&other,&policy,1000,proof()).await.is_err());
+        assert_eq!(observer.calls.load(Ordering::SeqCst),0);
+        observer.observation.received_atoms-=1;
+        assert!(verify_new_funding(&observer,&bk,&quote,&policy,1000,proof()).await.is_err());
+        observer.observation.received_atoms+=1;
+        observer.observation.address=quote.destinations().xmz_payout.to_string();
+        assert!(verify_new_funding(&observer,&bk,&quote,&policy,1000,proof()).await.is_err());
+        Ok(())
+    }
+}
