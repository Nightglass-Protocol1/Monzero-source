+#[cfg(target_os="linux")]
+// Produce a second valid Alice signature without changing the redemption's
+// transaction ID. Bob's adaptor-derived signature remains exactly as released.
+fn alternate_claim_witness(tx:&bitcoin::Transaction,secret:&swap_core::bitcoin::SecretKey,
+    amount:u64)->Result<bitcoin::Transaction> {
+    use bitcoin::{hashes::Hash,secp256k1::{Secp256k1,SecretKey,PublicKey,Message,ecdsa::Signature},
+        sighash::{SighashCache,EcdsaSighashType}};
+    let secp=Secp256k1::new();let secret=SecretKey::from_slice(&secret.to_bytes())?;
+    let public=PublicKey::from_secret_key(&secp,&secret);
+    let mut witness=tx.input[0].witness.to_vec();
+    let script=bitcoin::ScriptBuf::from_bytes(witness.last().context("missing redeem script")?.clone());
+    let digest=SighashCache::new(tx).p2wsh_signature_hash(0,&script,bitcoin::Amount::from_sat(amount),EcdsaSighashType::All)?;
+    let message=Message::from_digest(digest.to_byte_array());
+    let mut replaced=0;
+    for item in &mut witness {
+        if item.last()!=Some(&1) {continue;}
+        let Ok(signature)=Signature::from_der(&item[..item.len()-1]) else {continue;};
+        if secp.verify_ecdsa(&message,&signature,&public).is_err() {continue;}
+        let alternate=secp.sign_ecdsa_with_noncedata(&message,&secret,&[42;32]);
+        secp.verify_ecdsa(&message,&alternate,&public)?;
+        let mut encoded=alternate.serialize_der().to_vec();encoded.push(1);
+        ensure!(*item!=encoded,"alternate signature repeated original witness");
+        *item=encoded;replaced+=1;
+    }
+    ensure!(replaced==1,"expected exactly one Alice signature");
+    let mut changed=tx.clone();changed.input[0].witness=bitcoin::Witness::from_slice(&witness);
+    assert_eq!(changed.compute_txid(),tx.compute_txid());
+    assert_ne!(changed.compute_wtxid(),tx.compute_wtxid());
+    Ok(changed)
+}
