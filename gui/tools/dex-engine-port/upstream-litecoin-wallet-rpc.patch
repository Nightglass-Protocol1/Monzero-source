+fn transcript_restore_preserves_sequence_and_revalidates_signatures() -> Result<()> {
+    let (policy,quote,bob,alice)=setup();
+    let mut original=KeyExchange::new(&quote,&policy,1000,LocalRole::LitecoinFunder,&bob)?;
+    let (empty,empty_commitment)=original.transcript_checkpoint()?;
+    assert!(KeyExchange::restore_transcript_checkpoint(&empty,&empty_commitment,&quote,&policy,
+        LocalRole::LitecoinFunder,&alice).is_err());
+    let first=original.prepare_local(1000)?;
+    assert!(original.prepare_local(999).is_err());
+    assert!(original.prepare_local(2000).is_err());
+    original.accept(&first,&signature(&first,1),1000)?;
+    assert!(original.prepare_local(1000).is_err());
+    let (bytes,commitment)=original.transcript_checkpoint()?;
+    let mut restored=KeyExchange::restore_transcript_checkpoint(&bytes,&commitment,&quote,&policy,
+        LocalRole::LitecoinFunder,&bob)?;
+    assert!(restored.accept(&first,&signature(&first,1),1000).is_err());
+    let mut tightened=policy.clone(); tightened.maximum_ltc_atoms=1;
+    KeyExchange::restore_transcript_checkpoint(&bytes,&commitment,&quote,&tightened,
+        LocalRole::LitecoinFunder,&bob)?;
+    tightened.xmz_genesis="b".repeat(64);
+    assert!(KeyExchange::restore_transcript_checkpoint(&bytes,&commitment,&quote,&tightened,
+        LocalRole::LitecoinFunder,&bob).is_err());
+    let second=original.prepare(alice.share.clone())?;
+    assert_eq!(restored.prepare(alice.share.clone())?,second);
+    assert!(restored.accept(&second,&signature(&second,2),2000).is_err());
+    restored.accept(&second,&signature(&second,2),1001)?;
+    original.accept(&second,&signature(&second,2),1001)?;
+    let (complete,complete_commitment)=restored.transcript_checkpoint()?;
+    let again=KeyExchange::restore_transcript_checkpoint(&complete,&complete_commitment,&quote,&policy,
+        LocalRole::LitecoinFunder,&bob)?;
+    assert_eq!(again.finish()?.transcript_commitment(),original.finish()?.transcript_commitment());
+    assert!(KeyExchange::restore_transcript_checkpoint(&bytes,&complete_commitment,&quote,&policy,
+        LocalRole::LitecoinFunder,&bob).is_err());
+    // Change a signature while keeping struct field order, and recompute the
+    // outer checksum: cryptographic verification must independently reject it.
+    let mut changed=bytes.to_vec();
+    let text=std::str::from_utf8(&changed)?;
+    let start=text.find("\"signature\":[").unwrap()+"\"signature\":[".len();
+    let end=start+text[start..].find(',').unwrap();
+    let old:u8=text[start..end].parse()?;
+    changed.splice(start..end,old.wrapping_add(1).to_string().bytes());
+    let digest: [u8;32]=Sha256::digest(&changed).into();
+    assert!(KeyExchange::restore_transcript_checkpoint(&changed,&digest,&quote,&policy,
+        LocalRole::LitecoinFunder,&bob).is_err());
+    Ok(())
+}
