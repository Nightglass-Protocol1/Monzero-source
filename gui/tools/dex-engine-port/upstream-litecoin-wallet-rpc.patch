+        }
+        if let Some(expected)=head.native_payout_intent {
+            ensure!(self.claim.role==0 && head.native_claim.is_some(),"native payout intent lacks committed claim");
+            let retained=self.metadata.read(&native_payout::intent_name(self.claim.trade))?;
