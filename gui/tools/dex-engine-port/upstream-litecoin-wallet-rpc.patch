+    }
+
+    fn advance(&self,mut head:Head,previous:&[u8],checkpoint:[u8;32],outgoing_source:Option<[u8;32]>)->Result<[u8;32]> {
+        let (quote,_,exchange)=storage::restore_cold(&self.snapshots,self.claim.trade,&self.policy,
+            &self.claim.pins[0],&self.claim.pins[1],self.role,&checkpoint)?;
+        ensure!(quote.commitment()==&self.claim.quote && exchange.next==head.step+1,"invalid Litecoin execution successor");
+        head.checkpoint=checkpoint;head.step=exchange.next;head.outgoing_source=outgoing_source;
+        self.metadata.replace_execution_head(self.claim.trade,previous,&serde_json::to_vec(&head)?)?;
+        Ok(checkpoint)
+    }
+
+    pub fn checkpoint(&self)->Result<[u8;32]> { Ok(self.load()?.0.checkpoint) }
+
+    /// Commit local acceptance before returning any frame for transport. Retries
+    /// recover the same previously retained bytes, including after quote expiry.
+    pub fn outgoing(&mut self,identity:&ed25519_dalek::SigningKey,now:u64)->Result<storage::OutgoingFrame> {
+        ensure!(identity.verifying_key().to_bytes()==self.claim.pins[usize::from(self.claim.role)],"wrong local signing identity");
+        let (head,previous,quote,_,_)=self.load()?;
+        if let Some(source)=head.outgoing_source {
+            return storage::load_outgoing(&self.snapshots,&quote,&self.policy,self.role,&source);
+        }
+        let source=head.checkpoint;
+        let outgoing=storage::prepare_outgoing(&self.snapshots,&quote,&self.policy,self.role,&source,identity,now)?;
+        let successor=storage::recover_outgoing_acceptance(&self.snapshots,&quote,&self.policy,self.role,&source)?;
+        self.advance(head,&previous,successor,Some(source))?;
+        Ok(outgoing)
+    }
+
+    /// Recover the exact retained outgoing operation without an identity key.
+    /// If the prior process stopped before head publication, complete that
+    /// publication before returning the saved frame. No new frame is created.
+    pub fn recover_outgoing(&mut self)->Result<storage::OutgoingFrame> {
+        let (head,previous,quote,_,_)=self.load()?;
+        let source=head.outgoing_source.unwrap_or(head.checkpoint);
+        let outgoing=storage::load_outgoing(&self.snapshots,&quote,&self.policy,self.role,&source)?;
+        if head.outgoing_source.is_none() {
+            let successor=storage::recover_outgoing_acceptance(&self.snapshots,&quote,&self.policy,self.role,&source)?;
+            self.advance(head,&previous,successor,Some(source))?;
+        }
+        Ok(outgoing)
+    }
+
+    /// Acknowledge only after the exact peer frame and successor head are durable.
+    /// Repeated delivery of the already-committed peer frame is idempotent.
+    pub fn accept_peer(&mut self,bytes:&[u8],signature:&[u8],now:u64)->Result<[u8;32]> {
+        let (head,previous,quote,_,exchange)=self.load()?;
+        let peer=1-self.claim.role;
+        if let Some(accepted)=exchange.accepted.get(usize::from(peer)) {
+            ensure!(accepted.bytes==bytes && accepted.signature==signature,"conflicting repeated Litecoin peer frame");
+            return Ok(head.checkpoint);
+        }
+        ensure!(exchange.next==peer,"Litecoin execution is waiting for its local frame");
+        let checkpoint=storage::retain_incoming(&self.snapshots,&quote,&self.policy,self.role,&head.checkpoint,bytes,signature,now)?;
+        let outgoing=head.outgoing_source;
+        self.advance(head,&previous,checkpoint,outgoing)
+    }
+
+    /// Resume a peer-frame admission interrupted before head publication.
+    /// No fresh peer message or current quote admission is required.
+    pub fn recover_peer(&mut self)->Result<[u8;32]> {
+        let (head,previous,quote,_,exchange)=self.load()?;
+        if exchange.accepted.get(usize::from(1-self.claim.role)).is_some() { return Ok(head.checkpoint); }
+        let checkpoint=storage::recover_incoming(&self.snapshots,&quote,&self.policy,self.role,&head.checkpoint)?;
+        let outgoing=head.outgoing_source;
+        self.advance(head,&previous,checkpoint,outgoing)
+    }
+
+    /// Completed keys are still not a funding permit. Recovery transactions and
+    /// native-chain funding evidence must be negotiated and verified separately.
+    pub fn completed_keys(&self)->Result<VerifiedKeys> { self.load()?.4.finish() }
+}
