+//! Two-party recovery signatures. This API neither persists material nor authorizes
+//! funding: the execution driver must durably retain verified recovery first.
+use super::{LocalKeys, VerifiedKeys, canonical};
+use crate::litecoin_quote::{Policy, VerifiedLtcQuote};
+use anyhow::{Context, Result, ensure};
+use bitcoin::{Amount, Transaction, psbt::Psbt};
+use ed25519_dalek::{Signer, SigningKey, VerifyingKey};
+use ecdsa_fun::adaptor::{Adaptor, HashTranscript};
+use ecdsa_fun::nonce::Deterministic;
+use serde::{Deserialize, Serialize};
+use sha2::Sha256;
+use swap_core::bitcoin::{self as contract, CancelTimelock, PunishTimelock, TxCancel,
+    TxFullRefund, TxLock, TxPunish};
+use swap_core::monero::ScalarExt;
+
+const DOMAIN: &str = "monzero-ltc-xmz-recovery-v1";
+const MAX_FRAME: usize = 16_384;
+
+pub struct RecoveryPlan {
+    binding: Binding,
+    role: u8,
+    pins: [VerifyingKey; 2],
+    keys: [contract::PublicKey; 2],
+    adaptors: [contract::PublicKey; 2],
+    cancel: TxCancel,
+    refund: TxFullRefund,
+    punish: TxPunish,
+    redeem: contract::TxRedeem,
+}
+
+#[derive(Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    schema: String,
+    quote: [u8;32],
+    transcript: [u8;32],
+    lock: bitcoin::OutPoint,
+    cancel: bitcoin::Txid,
+    refund: bitcoin::Txid,
+    punish: bitcoin::Txid,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    binding: Binding,
+    role: u8,
+    cancel: contract::Signature,
+    refund: Option<contract::EncryptedSignature>,
+    punish: Option<contract::Signature>,
+}
+
+pub struct SignedRecovery {
+    bytes: Vec<u8>,
+    signature: [u8;64],
+}
+impl SignedRecovery {
+    pub(super) fn from_verified(bytes:Vec<u8>,signature:[u8;64])->Self { Self { bytes,signature } }
+    pub fn bytes(&self) -> &[u8] { &self.bytes }
+    pub fn signature(&self) -> &[u8;64] { &self.signature }
+}
+
+pub struct FunderRecovery { pub cancel: Transaction, pub refund: Transaction }
+pub struct NativeRecovery { pub cancel: Transaction, pub punish: Transaction }
+
+impl RecoveryPlan {
+    pub(crate) fn refund_txid(&self)->bitcoin::Txid {self.refund.txid()}
+    pub(crate) fn lock_outpoint(&self)->bitcoin::OutPoint { self.binding.lock }
+    /// The PSBT must also be independently checked against the owned reservation
+    /// by the funding driver. Witness UTXO descriptions here are not chain evidence.
+    pub fn new(quote: &VerifiedLtcQuote, policy: &Policy, now: u64,
+        keys: &VerifiedKeys, psbt: Psbt) -> Result<Self> {
+        keys.check_quote(quote)?;
+        quote.check_policy(policy, now)?;
+        let n=|name: &str| -> Result<u64> { Ok(quote.terms()[name].parse()?) };
+        let tx=&psbt.unsigned_tx;
+        ensure!(!tx.input.is_empty() && tx.input.len()==psbt.inputs.len()
+            && tx.output.len()==psbt.outputs.len() && tx.output.len()<=2,
+            "invalid Litecoin recovery funding shape");
+        let mut seen=std::collections::HashSet::new();
+        let mut input_total=0u64;
+        for (input, data) in tx.input.iter().zip(&psbt.inputs) {
+            ensure!(seen.insert(input.previous_output) && !input.previous_output.is_null()
+                && input.script_sig.is_empty() && input.witness.is_empty()
+                && !input.sequence.is_rbf() && data.final_script_sig.is_none()
+                && data.redeem_script.is_none(), "unstable Litecoin recovery funding input");
+            let utxo=data.witness_utxo.as_ref().context("missing Litecoin witness UTXO")?;
+            ensure!(utxo.script_pubkey.is_p2wpkh() || utxo.script_pubkey.is_p2wsh()
+                || utxo.script_pubkey.is_p2tr(), "non-SegWit Litecoin recovery input");
+            if let Some(previous)=&data.non_witness_utxo {
+                ensure!(previous.compute_txid()==input.previous_output.txid
+                    && previous.output.get(input.previous_output.vout as usize)==Some(utxo),
+                    "inconsistent Litecoin recovery UTXO");
+            }
+            input_total=input_total.checked_add(utxo.value.to_sat()).context("input amount overflow")?;
+        }
+        let output_total=tx.output.iter().try_fold(0u64,|sum,o| sum.checked_add(o.value.to_sat()))
+            .context("output amount overflow")?;
+        let fee=input_total.checked_sub(output_total).context("negative funding fee")?;
+        ensure!(fee<=n("ltcFundingFeeMaxAtoms")?, "funding fee exceeds quote");
+        let (a,b)=keys.contract_keys();
+        let lock=TxLock::from_psbt(psbt,a,b,Amount::from_sat(n("ltcAtoms")?))?;
+        let destinations=quote.destinations();
+        ensure!(destinations.ltc_refund.script_pubkey()!=&lock.script_pubkey()
+            && destinations.ltc_payout.script_pubkey()!=&lock.script_pubkey(),
+            "recovery pays shared contract");
+        let cancel=TxCancel::new(&lock,CancelTimelock::new(policy.cancel_blocks),a,b,
+            Amount::from_sat(n("ltcCancelFeeAtoms")?))?;
+        let refund=TxFullRefund::new_to_script(&cancel,destinations.ltc_refund.script_pubkey(),
+            Amount::from_sat(n("ltcRefundFeeAtoms")?));
+        let punish=TxPunish::new_to_script(&cancel,destinations.ltc_payout.script_pubkey(),
+            PunishTimelock::new(policy.punish_blocks),Amount::from_sat(n("ltcPunishFeeAtoms")?));
+        let redeem=contract::TxRedeem::new_to_script(&lock,destinations.ltc_payout.script_pubkey(),
+            Amount::from_sat(n("ltcRedeemFeeAtoms")?));
+        let pin=|field: &str| -> Result<VerifyingKey> {
+            let s=&quote.terms()[field];
+            let mut bytes=[0u8;32];
+            for (i,byte) in bytes.iter_mut().enumerate() { *byte=u8::from_str_radix(&s[i*2..i*2+2],16)?; }
+            Ok(VerifyingKey::from_bytes(&bytes)?)
+        };
+        let (sa,sb)=keys.adaptor_keys();
+        Ok(Self { binding:Binding { schema:DOMAIN.into(),quote:*quote.commitment(),
+            transcript:*keys.transcript_commitment(),lock:lock.as_outpoint(),
+            cancel:cancel.txid(),refund:refund.txid(),punish:punish.txid() },
+            role:keys.local_sequence,pins:[pin("ltcFunder")?,pin("xmzFunder")?],
+            keys:[b,a],adaptors:[sb,sa],cancel,refund,punish,redeem })
+    }
+
+    fn check_local(&self, local: &LocalKeys, role: u8) -> Result<()> {
+        ensure!(self.role==role && local.contract_secret().public()==self.keys[usize::from(role)]
+            && contract::PublicKey::from(local.native_spend_secret().to_secpfun_scalar())==self.adaptors[usize::from(role)],
+            "wrong local recovery role or keys");
+        Ok(())
+    }
+
+    /// Caller must retain the returned bytes before sending them to the peer.
+    pub fn sign(&self, local: &LocalKeys, identity: &SigningKey) -> Result<SignedRecovery> {
+        self.check_local(local,self.role)?;
+        ensure!(identity.verifying_key()==self.pins[usize::from(self.role)], "wrong recovery identity");
+        let frame=Frame { binding:self.binding.clone(),role:self.role,
+            cancel:local.contract_secret().sign(self.cancel.digest()),
+            refund:if self.role==1 { Some(local.contract_secret().encsign(self.adaptors[0],self.refund.digest())) } else { None },
+            punish:if self.role==0 { Some(local.contract_secret().sign(self.punish.digest())) } else { None } };
+        let bytes=canonical(&frame)?;
+        let signature=identity.sign(&signing_bytes(&bytes)?).to_bytes();
+        Ok(SignedRecovery { bytes,signature })
+    }
+
+    fn verify_peer(&self, bytes: &[u8], signature: &[u8], role: u8) -> Result<Frame> {
+        self.pins[usize::from(role)].verify_strict(&signing_bytes(bytes)?,
+            &ed25519_dalek::Signature::from_slice(signature)?)?;
+        let frame: Frame=serde_json::from_slice(bytes)?;
+        ensure!(canonical(&frame)?==bytes && frame.binding==self.binding && frame.role==role,
+            "wrong recovery transcript or noncanonical frame");
+        ensure!(frame.refund.is_some()==(role==1) && frame.punish.is_some()==(role==0),
+            "wrong recovery signature set");
+        contract::verify_sig(&self.keys[usize::from(role)],&self.cancel.digest(),&frame.cancel)?;
+        Ok(frame)
+    }
+
+    pub(super) fn verify_local_message(&self,bytes:&[u8],signature:&[u8])->Result<()> {
+        let frame=self.verify_peer(bytes,signature,self.role)?;
+        if let Some(encrypted)=frame.refund {
+            contract::verify_encsig(self.keys[1],self.adaptors[0],&self.refund.digest(),&encrypted)?;
+        }
+        if let Some(signature)=frame.punish {
+            contract::verify_sig(&self.keys[0],&self.punish.digest(),&signature)?;
+        }
+        Ok(())
+    }
+
+    pub fn complete_funder(self, local: &LocalKeys, bytes: &[u8], signature: &[u8]) -> Result<FunderRecovery> {
+        self.check_local(local,0)?;
+        let frame=self.verify_peer(bytes,signature,1)?;
+        let encrypted=frame.refund.context("missing refund adaptor signature")?;
+        contract::verify_encsig(self.keys[1],self.adaptors[0],&self.refund.digest(),&encrypted)?;
+        let adaptor=Adaptor::<HashTranscript<Sha256>,Deterministic<Sha256>>::default();
+        let sig_a=adaptor.decrypt_signature(&local.native_spend_secret().to_secpfun_scalar(),encrypted);
+        let sig_b=local.contract_secret().sign(self.refund.digest());
+        let refund=self.refund.add_signatures((self.keys[1],sig_a),(self.keys[0],sig_b))?;
+        let cancel=self.cancel.complete_as_bob(self.keys[1],local.contract_secret().clone(),frame.cancel)?;
+        Ok(FunderRecovery { cancel,refund })
+    }
+
+    pub fn complete_native(self, local: &LocalKeys, bytes: &[u8], signature: &[u8]) -> Result<NativeRecovery> {
+        self.check_local(local,1)?;
+        let frame=self.verify_peer(bytes,signature,0)?;
+        let punish_signature=frame.punish.context("missing punish signature")?;
+        contract::verify_sig(&self.keys[0],&self.punish.digest(),&punish_signature)?;
+        let punish=self.punish.complete(punish_signature,local.contract_secret().clone(),self.keys[0])?;
+        let cancel=self.cancel.complete_as_alice(local.contract_secret().clone(),self.keys[0],frame.cancel)?;
+        Ok(NativeRecovery { cancel,punish })
+    }
+}
+
+fn signing_bytes(bytes: &[u8]) -> Result<Vec<u8>> {
+    ensure!(!bytes.is_empty() && bytes.len()<=MAX_FRAME,"invalid recovery frame size");
+    let mut result=DOMAIN.as_bytes().to_vec();
+    result.push(0);
+    result.extend_from_slice(&(bytes.len() as u64).to_be_bytes());
+    result.extend_from_slice(bytes);
+    Ok(result)
+}
