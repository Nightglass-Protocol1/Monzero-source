+//! Explicit submission of the retained Litecoin cancellation/recovery transactions.
+use super::*;
+use crate::litecoin_rpc::LitecoinRpc;
+use bitcoin::{Transaction,Txid,Wtxid,BlockHash};
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq,PartialOrd,Ord,Serialize,Deserialize)]
+#[serde(rename_all="camelCase")]
+pub enum RecoverySpend {Cancel,Refund,Punish}
+impl RecoverySpend {
+    pub(super) fn label(self)->&'static str {match self {Self::Cancel=>"cancel",Self::Refund=>"refund",Self::Punish=>"punish"}}
+    pub(super) fn allowed(self,role:u8)->bool {match self {Self::Cancel=>role<=1,Self::Refund=>role==0,Self::Punish=>role==1}}
+}
+#[derive(Debug,PartialEq,Eq)]
+pub enum RecoveryRelayOutcome {Acknowledged {txid:Txid},Uncertain {txid:Txid}}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Dispatch {schema:String,trade:uuid::Uuid,quote:[u8;32],checkpoint:[u8;32],recovery:[u8;32],kind:RecoverySpend,txid:Txid,wtxid:Wtxid}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Receipt {schema:String,dispatch:[u8;32],txid:Txid}
+pub(super) fn dispatch_name(trade:uuid::Uuid,kind:RecoverySpend)->String {format!("{trade}.ltc-{}-dispatch",kind.label())}
+pub(super) fn receipt_name(trade:uuid::Uuid,kind:RecoverySpend)->String {format!("{trade}.ltc-{}-receipt",kind.label())}
+fn dispatch_bytes(head:&Head,kind:RecoverySpend,tx:&Transaction)->Result<Vec<u8>> {
+    ensure!(head.step==2,"recovery relay precedes completed keys");
+    serde_json::to_vec(&Dispatch {schema:"monzero-ltc-recovery-dispatch-v1".into(),trade:head.trade,quote:head.quote,
+        checkpoint:head.checkpoint,recovery:head.recovery_intent.context("missing recovery agreement")?,kind,
+        txid:tx.compute_txid(),wtxid:tx.compute_wtxid()}).map_err(Into::into)
+}
+impl Execution {
+    fn recovery_transaction(&mut self,kind:RecoverySpend)->Result<Transaction> {
+        ensure!(kind.allowed(self.claim.role),"wrong Litecoin recovery spend role");
+        let retained=self.recover_recovery()?;
+        match kind {
+            RecoverySpend::Cancel=>Ok(retained.cancel),
+            RecoverySpend::Refund=>retained.refund.context("missing agreed refund"),
+            RecoverySpend::Punish=>retained.punish.context("missing agreed punishment"),
+        }
+    }
+    /// No native-funding or commercial-expiry gate: these are already-agreed
+    /// recovery obligations. The Litecoin node enforces current spendability and
+    /// relative timelocks before the owner records its first broadcast attempt.
+    pub async fn relay_recovery_spend(&mut self,ltc:&LitecoinRpc,kind:RecoverySpend)->Result<RecoveryRelayOutcome> {
+        self.submit_recovery_spend(ltc,kind,false).await
+    }
+    /// An explicit retry never changes the signed bytes or creates new keys.
+    pub async fn retransmit_recovery_spend(&mut self,ltc:&LitecoinRpc,kind:RecoverySpend)->Result<RecoveryRelayOutcome> {
+        self.submit_recovery_spend(ltc,kind,true).await
+    }
+    async fn submit_recovery_spend(&mut self,ltc:&LitecoinRpc,kind:RecoverySpend,retry:bool)->Result<RecoveryRelayOutcome> {
+        let transaction=self.recovery_transaction(kind)?;
+        let (mut head,previous,_,_,_)=self.load()?;
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong recovery Litecoin network");
+        let bytes=dispatch_bytes(&head,kind,&transaction)?;
+        let digest:[u8;32]=Sha256::digest(&bytes).into();
+        match self.metadata.read(&dispatch_name(self.claim.trade,kind)) {
+            Ok(saved)=>{ensure!(retry,"recovery already attempted; reconcile or explicitly retry");ensure!(saved==bytes,"recovery dispatch changed");},
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                ensure!(!retry && !head.recovery_dispatch.contains_key(&kind),"missing recovery dispatch");
+            },
+            Err(e)=>return Err(e),
+        }
+        if let Some(pin)=head.recovery_dispatch.get(&kind) {ensure!(*pin==digest,"recovery dispatch differs from head");}
+        ltc.preflight_contract_spend(&transaction).await?;
+        self.metadata.retain(&dispatch_name(self.claim.trade,kind),&bytes)?;
+        head.recovery_dispatch.insert(kind,digest);
+        let dispatched=serde_json::to_vec(&head)?;
+        self.metadata.replace_execution_head(self.claim.trade,&previous,&dispatched)?;
+        let txid=transaction.compute_txid();
+        if !ltc.dispatch_contract_spend(&transaction).await {return Ok(RecoveryRelayOutcome::Uncertain {txid});}
+        let receipt=serde_json::to_vec(&Receipt {schema:"monzero-ltc-recovery-receipt-v1".into(),dispatch:digest,txid})?;
+        self.metadata.retain(&receipt_name(self.claim.trade,kind),&receipt)?;
+        head.recovery_receipts.insert(kind,Sha256::digest(&receipt).into());
+        self.metadata.replace_execution_head(self.claim.trade,&dispatched,&serde_json::to_vec(&head)?)?;
+        Ok(RecoveryRelayOutcome::Acknowledged {txid})
+    }
+    /// Fresh chain evidence, including when the peer broadcast the shared
+    /// cancellation first. An acknowledgement or saved depth never suffices.
+    pub async fn observe_recovery_spend(&mut self,ltc:&LitecoinRpc,kind:RecoverySpend,block:BlockHash)->Result<u64> {
+        let transaction=self.recovery_transaction(kind)?;
+        let (_,_,quote,_,_)=self.load()?;
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong recovery observation network");
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.confirmed_transaction(transaction.compute_txid(),block,minimum).await?;
+        ensure!(super::redeem::same_redemption_effect(&transaction,observed.transaction()),"observed recovery differs from agreement");
+        Ok(observed.confirmations())
+    }
+}
