+//! Deliberate local-role approval before generating and retaining trade keys.
+use super::*;
+
+pub struct StartReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+fn commitment(details:&serde_json::Value)->Result<[u8;32]> {
+    let mut digest=Sha256::new();digest.update(b"MONZERO-LTC-TRADE-START-APPROVAL-V1\0");
+    digest.update(serde_json::to_vec(details)?);Ok(digest.finalize().into())
+}
+/// No keys are generated, no state is written and no service is contacted.
+pub fn review_start(quote:&VerifiedLtcQuote,policy:&Policy,role:LocalRole,now:u64)->Result<StartReview> {
+    quote.check_policy(policy,now)?;
+    ensure!(quote.terms()["schema"]==crate::litecoin_quote::PAYOUT_DOMAIN,
+        "new trade setup requires explicit native payout and reserve terms");
+    let details=serde_json::json!({"schema":"monzero-ltc-trade-start-review-v1",
+        "role":match role {LocalRole::NativeFunder=>"native-funder",LocalRole::LitecoinFunder=>"litecoin-funder"},
+        "quoteCommitment":hex(quote.commitment()),"terms":quote.terms(),"policy":policy,
+        "chainObserved":false,"executable":false});
+    Ok(StartReview {commitment:commitment(&details)?,details})
+}
+impl Execution {
+    /// The role, full commercial terms and independently configured policy must
+    /// still match the displayed approval. Expiry is checked again at start.
+    pub fn begin_reviewed<R:rand::RngCore+rand::CryptoRng>(metadata:&Path,snapshots:&Path,
+        quote:&VerifiedLtcQuote,policy:&Policy,role:LocalRole,approved:[u8;32],now:u64,rng:&mut R)->Result<Self> {
+        ensure!(review_start(quote,policy,role,now)?.commitment==approved,"trade start approval changed");
+        Self::begin(metadata,snapshots,quote,policy,role,quote.commitment(),now,rng)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn start_approval_binds_role_full_terms_and_policy_before_any_filesystem_access()->Result<()> {
+        let (policy,mut terms)=crate::litecoin_quote::tests::fixture();
+        let old=crate::litecoin_quote::tests::signed(&terms,&policy,1000)?;
+        assert!(review_start(&old,&policy,LocalRole::NativeFunder,1000).is_err());
+        terms.insert("schema".into(),crate::litecoin_quote::PAYOUT_DOMAIN.into());
+        terms.insert("xmzPayoutAtoms".into(),"300000000".into());
+        terms.insert("xmzClaimFeeMaxAtoms".into(),"100000".into());
+        terms.insert("xmzRefundFeeMaxAtoms".into(),"100000".into());
+        let quote=crate::litecoin_quote::tests::signed(&terms,&policy,1000)?;
+        let review=review_start(&quote,&policy,LocalRole::NativeFunder,1000)?;
+        assert_ne!(review.commitment,review_start(&quote,&policy,LocalRole::LitecoinFunder,1000)?.commitment);
+        let mut changed=policy.clone();changed.maximum_xmz_atoms+=1;
+        assert_ne!(review.commitment,review_start(&quote,&changed,LocalRole::NativeFunder,1000)?.commitment);
+        for field in review.details.as_object().unwrap().keys() {
+            let mut altered=review.details.clone();altered[field]=serde_json::json!("changed");
+            assert_ne!(review.commitment,commitment(&altered)?);
+        }
+        let mut rng=rand::rngs::OsRng;
+        // Nonexistent paths demonstrate that approval fails before storage opens.
+        let absent=std::env::temp_dir().join(format!("absent-start-{}",uuid::Uuid::new_v4()));
+        for (role,approved,now) in [(LocalRole::LitecoinFunder,review.commitment,1000),
+            (LocalRole::NativeFunder,[0;32],1000),(LocalRole::NativeFunder,review.commitment,2000)] {
+            let error=Execution::begin_reviewed(&absent,&absent,&quote,&policy,role,approved,now,&mut rng).err()
+                .context("invalid trade start accepted")?;
+            assert!(error.to_string().contains(if now==2000 {"validity window"} else {"approval changed"}));
+            assert!(!absent.exists());
+        }
+        // Import the same v2 envelope without changing consent or signature context.
+        let pins=[ed25519_dalek::SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+            ed25519_dalek::SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes()];
+        let imported=VerifiedLtcQuote::from_envelope(&quote.to_envelope()?,1000,&policy,pins)?;
+        assert_eq!(review.commitment,review_start(&imported,&policy,LocalRole::NativeFunder,1000)?.commitment);
+        Ok(())
+    }
+}
