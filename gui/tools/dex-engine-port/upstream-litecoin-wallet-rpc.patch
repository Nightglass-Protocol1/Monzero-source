+fn confirmed_claim_node(tx:bitcoin::Transaction,active:bool)->Result<(crate::litecoin_rpc::LitecoinRpc,
+    bitcoin::BlockHash,std::sync::Arc<std::sync::atomic::AtomicBool>,std::thread::JoinHandle<Result<()>>)> {
+    claim_node(tx,active,None)
+}
+fn claim_node(tx:bitcoin::Transaction,active:bool,relay:Option<(std::path::PathBuf,bool)>)->Result<(crate::litecoin_rpc::LitecoinRpc,
+    bitcoin::BlockHash,std::sync::Arc<std::sync::atomic::AtomicBool>,std::thread::JoinHandle<Result<()>>)> {
+    contract_spend_node(tx,active,relay.map(|(path,lose)|(path,lose,"/redeem_dispatch")))
+}
