+//! Funding signing with verified, durable cancellation/refund bytes.
+//! Policy is trusted caller input, never a peer-provided approval. Commercial
+//! quote authentication and native-chain proof negotiation must precede this API.
+//! Signing and relay are separate explicit operations on immutable bytes. Keep recovery
+//! records private: publishing the signed refund can reveal the native-chain
+//! adaptor secret to the counterparty before the refund is due.
+use super::*;
+use bitcoin::{Transaction, hashes::Hash, consensus::encode::{deserialize_hex, serialize_hex}};
+use swap_core::bitcoin::{PublicKey, TxLock, TxCancel, TxFullRefund, CancelTimelock, build_shared_output_descriptor};
+
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryPolicy {
+    pub key_a: String, pub key_b: String, pub refund_address: String,
+    pub cancel_blocks: u32, pub cancel_fee: u64, pub refund_fee: u64,
+    pub minimum_relay_fee_atoms_per_kb: u64, pub minimum_output_atoms: u64,
+}
+
+/// Signed bytes whose unsigned transaction matches the immutable reservation.
+/// The caller must persist peer protocol state before any later relay operation.
+pub struct SignedLock { transaction: Transaction }
+impl SignedLock { pub fn transaction(&self) -> &Transaction { &self.transaction } }
+
+/// Acknowledgement is not confirmation. Any prior or uncertain attempt must be
+/// reconciled against the exact lock, never repriced or replaced automatically.
+#[derive(Debug, Serialize)]
+#[serde(tag = "state", rename_all = "camelCase")]
+pub enum RelayOutcome {
+    Submitted { txid: bitcoin::Txid, receipt_persisted: bool },
+    Reconcile { txid: bitcoin::Txid },
+    Uncertain { txid: bitcoin::Txid },
+    Observed { observation: LockObservation },
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SigningRecord {
+    schema: String, trade: uuid::Uuid, policy: RecoveryPolicy,
+    cancel: String, refund: String, unsigned_txid: bitcoin::Txid,
+    #[serde(default, skip_serializing_if="Option::is_none")]
+    quote_record_hash: Option<String>,
+    #[serde(default, skip_serializing_if="Option::is_none")]
+    exchange_record_hash: Option<String>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SignedRecord { schema: String, txid: bitcoin::Txid, hex: String }
+
+impl LitecoinRpc {
+    /// Trusted caller must already have authenticated/approved the negotiated
+    /// trade and persisted peer recovery state. This API does not grant approval.
+    /// At most one automatic send attempt per trade, with intent synced first.
+    pub async fn relay_reserved_lock(&self, directory: &Path, trade: uuid::Uuid,
+        expected_txid: bitcoin::Txid) -> Result<RelayOutcome> {
+        self.relay_lock_inner(directory, trade, expected_txid, false).await
+    }
+
+    /// Explicit recovery may retransmit only the identical persisted bytes when
+    /// the transaction is unobserved and its exact inputs remain available.
+    /// This cannot create a second payment, reprice, or replace the lock txid.
+    pub async fn resume_reserved_relay(&self, directory: &Path, trade: uuid::Uuid,
+        expected_txid: bitcoin::Txid) -> Result<RelayOutcome> {
+        let observation = self.observe_lock(directory, trade).await?;
+        let txid = match &observation {
+            LockObservation::Confirmed { txid, .. } | LockObservation::ConfirmedOutput { txid, .. }
+            | LockObservation::Mempool { txid, .. } | LockObservation::WalletReportsConflict { txid, .. }
+            | LockObservation::Unobserved { txid, .. } => *txid,
+        };
+        ensure!(txid == expected_txid, "Litecoin recovery differs from approved transaction");
+        if matches!(observation, LockObservation::Unobserved { inputs_available:true, .. }) {
+            return self.relay_lock_inner(directory, trade, expected_txid, true).await;
+        }
+        Ok(RelayOutcome::Observed { observation })
+    }
+
+    async fn relay_lock_inner(&self, directory: &Path, trade: uuid::Uuid,
+        expected_txid: bitcoin::Txid, resume: bool) -> Result<RelayOutcome> {
+        ensure!(!trade.is_nil(), "invalid Litecoin relay trade");
+        let journal = Journal::open(directory)?;
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade, "Litecoin relay trade mismatch");
+        let preview = self.validate_intent(&intent)?;
+        let txid = preview.psbt.unsigned_tx.compute_txid();
+        ensure!(txid == expected_txid, "Litecoin relay differs from approved transaction");
+        let signed: SignedRecord = serde_json::from_slice(&journal.read(&format!("{trade}.signed"))?)?;
+        ensure!(signed.schema == "monzero-ltc-signed-v1" && signed.txid == txid, "invalid Litecoin relay record");
+        let transaction = checked_signed(&signed.hex, &preview.psbt)?;
+        let signing: SigningRecord = serde_json::from_slice(&journal.read(&format!("{trade}.signing"))?)?;
+        ensure!(signing.schema == "monzero-ltc-signing-v1" && signing.trade == trade && signing.unsigned_txid == txid,
+            "Litecoin relay recovery context mismatch");
+        ensure!(signing.quote_record_hash == retained_quote_hash(&journal, trade)?, "Litecoin relay signed quote record changed");
+        ensure!(signing.exchange_record_hash == retained_record_hash(&journal, trade, "exchange")?,
+            "Litecoin relay key exchange record changed");
+        verify_recovery(&intent, &preview.psbt, self.network, &signing.policy,
+            &deserialize_hex(&signing.cancel)?, &deserialize_hex(&signing.refund)?)?;
+        let attempt = serde_json::to_vec(&json!({"schema":"monzero-ltc-relay-intent-v1", "trade":trade,
+            "genesis":intent.genesis, "wallet":intent.wallet, "txid":txid,
+            "wtxid":transaction.compute_wtxid()}))?;
+        let name = format!("{trade}.relay");
+        match journal.read(&name) {
+            Ok(bytes) => {
+                ensure!(bytes == attempt, "conflicting Litecoin relay intent");
+                if !resume { return Ok(RelayOutcome::Reconcile { txid }); }
+            }
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => {
+                ensure!(!resume, "no pending Litecoin relay to resume");
+            }
+            Err(e) => return Err(e),
+        }
+        if !resume {
+            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+            require_fresh_quote_for_first_relay(&journal, trade, now)?;
+        }
+        // Check durable input ownership and restore volatile wallet locks before
+        // consuming relay intent. No signing or replacement construction here.
+        let owner = format!("{trade}:{txid}");
+        for input in &preview.psbt.unsigned_tx.input {
+            let key = format!("{}:{}", intent.genesis, input.previous_output);
+            ensure!(journal.read(&format!("{:x}.input", Sha256::digest(key.as_bytes())))? == owner.as_bytes(),
+                "Litecoin relay input claim mismatch");
+        }
+        self.restore_reservation(&journal, &intent, preview).await?;
+        let raw = serialize_hex(&transaction);
+        let acceptance: Vec<Value> = serde_json::from_str(self.rpc(false, "testmempoolaccept", json!([[raw]])).await?.get())?;
+        ensure!(acceptance.len() == 1 && acceptance[0]["txid"] == txid.to_string() && acceptance[0]["allowed"] == true,
+            "Litecoin funding not currently acceptable for relay");
+        journal.retain(&name, &attempt)?;
+        // Once intent exists, even transport/RPC failure is ambiguous. Never
+        // erase it and never present an error as permission to create a new lock.
+        let acknowledged = match self.rpc(false, "sendrawtransaction", json!([raw])).await {
+            Ok(reply) => serde_json::from_str::<bitcoin::Txid>(reply.get()).ok() == Some(txid),
+            Err(_) => false,
+        };
+        if !acknowledged { return Ok(RelayOutcome::Uncertain { txid }); }
+        let receipt = serde_json::to_vec(&json!({"schema":"monzero-ltc-relay-receipt-v1", "txid":txid}))?;
+        let receipt_persisted = journal.retain(&format!("{trade}.relay-receipt"), &receipt).is_ok();
+        Ok(RelayOutcome::Submitted { txid, receipt_persisted })
+    }
+
+    /// Read-only validation against the exact saved reservation. This neither
+    /// restores Core locks nor creates signing authority; signing repeats these
+    /// checks under its own journal lease before any wallet RPC.
+    pub fn check_reserved_recovery(&self,directory:&Path,trade:uuid::Uuid,
+        policy:&RecoveryPolicy,cancel:&Transaction,refund:&Transaction)->Result<()> {
+        let journal=Journal::open(directory)?;
+        let intent:Intent=serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade==trade,"Litecoin recovery reservation identity mismatch");
+        let preview=self.validate_intent(&intent)?;
+        verify_recovery(&intent,&preview.psbt,self.network,policy,cancel,refund)
+    }
+
+    /// Fresh signed commercial terms constrain wallet preparation. Counterparty
+    /// contract keys still require authenticated proof negotiation, and the caller
+    /// must separately persist user approval before invoking this operation.
+    pub async fn sign_reserved_lock_for_quote(&self, directory: &Path, trade: uuid::Uuid,
+        quote: &crate::litecoin_quote::VerifiedLtcQuote, policy: &crate::litecoin_quote::Policy,
+        now: u64, key_a: String, key_b: String, cancel: &Transaction, refund: &Transaction) -> Result<SignedLock> {
+        ensure!(self.network == policy.ltc_network, "Litecoin signer quote deployment mismatch");
+        let recovery = quote.recovery_policy(policy, now, key_a, key_b)?;
+        let journal = Journal::open(directory)?;
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade, "Litecoin quote reservation identity mismatch");
+        let preview = self.validate_intent(&intent)?;
+        quote.check_funding(policy, now, trade, intent.amount, intent.maximum_fee)?;
+        verify_recovery(&intent, &preview.psbt, self.network, &recovery, cancel, refund)?;
+        let record=quote.record()?;
+        check_signing_context(&journal,trade,&recovery,cancel,refund,preview.psbt.unsigned_tx.compute_txid(),
+            Some(format!("{:x}",Sha256::digest(&record))),retained_record_hash(&journal,trade,"exchange")?)?;
+        journal.retain(&format!("{trade}.quote"), &record)?;
+        self.sign_reserved_lock_inner(&journal, trade, &recovery, cancel, refund).await
+    }
+
+    /// Sign using keys from the authenticated exchange. The caller still owns
+    /// user approval, durable secret storage and the remaining native protocol.
+    /// The public exchange commitment is retained before wallet signing; no
+    /// private view material is written into this funding journal.
+    pub async fn sign_reserved_lock_for_exchange(&self, directory: &Path, trade: uuid::Uuid,
+        quote: &crate::litecoin_quote::VerifiedLtcQuote, policy: &crate::litecoin_quote::Policy,
+        now: u64, keys: &crate::litecoin_negotiation::VerifiedKeys,
+        cancel: &Transaction, refund: &Transaction) -> Result<SignedLock> {
+        let recovery = keys.recovery_policy(quote, policy, now)?;
+        ensure!(self.network == policy.ltc_network, "Litecoin exchange signer deployment mismatch");
+        keys.require_ltc_funder()?;
+        let journal = Journal::open(directory)?;
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade && intent.contract == keys.contract_address().to_string(),
+            "Litecoin reservation differs from negotiated contract");
+        let preview = self.validate_intent(&intent)?;
+        quote.check_funding(policy, now, trade, intent.amount, intent.maximum_fee)?;
+        verify_recovery(&intent, &preview.psbt, self.network, &recovery, cancel, refund)?;
+        let quote_record=quote.record()?; let exchange_record=keys.public_record(quote)?;
+        check_signing_context(&journal,trade,&recovery,cancel,refund,preview.psbt.unsigned_tx.compute_txid(),
+            Some(format!("{:x}",Sha256::digest(&quote_record))),Some(format!("{:x}",Sha256::digest(&exchange_record))))?;
+        journal.compatible(&format!("{trade}.quote"),&quote_record)?;
+        journal.compatible(&format!("{trade}.exchange"),&exchange_record)?;
+        journal.retain(&format!("{trade}.quote"), &quote_record)?;
+        journal.retain(&format!("{trade}.exchange"), &exchange_record)?;
+        self.sign_reserved_lock_inner(&journal, trade, &recovery, cancel, refund).await
+    }
+
+    /// Persist a fixed recovery package before requesting signatures, then
+    /// persist signed funding bytes before returning. Reopening cannot reprice,
+    /// replace inputs, change recovery policy or construct a second payment.
+    pub async fn sign_reserved_lock(&self, directory: &Path, trade: uuid::Uuid,
+        policy: &RecoveryPolicy, cancel: &Transaction, refund: &Transaction) -> Result<SignedLock> {
+        ensure!(!trade.is_nil(), "invalid Litecoin signing trade");
+        let journal = Journal::open(directory)?;
+        self.sign_reserved_lock_inner(&journal, trade, policy, cancel, refund).await
+    }
+
+    async fn sign_reserved_lock_inner(&self, journal: &Journal, trade: uuid::Uuid,
+        policy: &RecoveryPolicy, cancel: &Transaction, refund: &Transaction) -> Result<SignedLock> {
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade, "Litecoin signing trade mismatch");
+        let preview = self.validate_intent(&intent)?;
+        verify_recovery(&intent, &preview.psbt, self.network, policy, cancel, refund)?;
+        let txid = preview.psbt.unsigned_tx.compute_txid();
+        let owner = format!("{trade}:{txid}");
+        for input in &preview.psbt.unsigned_tx.input {
+            let key = format!("{}:{}", intent.genesis, input.previous_output);
+            ensure!(journal.read(&format!("{:x}.input", Sha256::digest(key.as_bytes())))? == owner.as_bytes(),
+                "Litecoin signing input claim mismatch");
+        }
+        let signing = serde_json::to_vec(&SigningRecord { schema:"monzero-ltc-signing-v1".into(), trade,
+            policy:policy.clone(), cancel:serialize_hex(cancel), refund:serialize_hex(refund), unsigned_txid:txid,
+            quote_record_hash:retained_quote_hash(&journal, trade)?,
+            exchange_record_hash:retained_record_hash(&journal, trade, "exchange")? })?;
+        let signing_name = format!("{trade}.signing");
+        journal.compatible(&signing_name, &signing)?;
+        let signed_name = format!("{trade}.signed");
+        match journal.read(&signed_name) {
+            Ok(bytes) => {
+                ensure!(journal.read(&signing_name)? == signing, "signed Litecoin recovery context mismatch");
+                let saved: SignedRecord = serde_json::from_slice(&bytes)?;
+                ensure!(saved.schema == "monzero-ltc-signed-v1" && saved.txid == txid, "invalid signed Litecoin record");
+                let transaction = checked_signed(&saved.hex, &preview.psbt)?;
+                self.restore_reservation(&journal, &intent, preview).await?;
+                return Ok(SignedLock { transaction });
+            }
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => (),
+            Err(e) => return Err(e),
+        }
+        #[derive(Deserialize)] struct RelayPolicy { relayfee: Box<RawValue> }
+        let current: RelayPolicy = serde_json::from_str(self.rpc(false, "getnetworkinfo", json!([])).await?.get())?;
+        ensure!(policy.minimum_relay_fee_atoms_per_kb >= decimal_atoms(current.relayfee.get())?,
+            "Litecoin recovery fee policy is below the current node relay floor");
+        self.owned_address(&LtcSegwitAddress::parse(self.network, &policy.refund_address)?).await?;
+        let reserved = self.restore_reservation(&journal, &intent, preview).await?;
+        journal.retain(&signing_name, &signing)?;
+        // walletprocesspsbt signs only; it does not relay or register a payment.
+        // A lost response can be retried only for this identical unsigned txid.
+        #[derive(Deserialize)] struct SignedPsbt { psbt: String, complete: bool }
+        let signed: SignedPsbt = serde_json::from_str(self.rpc(true, "walletprocesspsbt",
+            json!([reserved.psbt().to_string(), true, "ALL", false])).await?.get())?;
+        ensure!(signed.complete && Psbt::from_str(&signed.psbt)?.unsigned_tx == reserved.psbt().unsigned_tx,
+            "Litecoin signer changed transaction or left signatures incomplete");
+        #[derive(Deserialize)] struct Finalized { hex: String, complete: bool }
+        let finalized: Finalized = serde_json::from_str(self.rpc(false, "finalizepsbt", json!([signed.psbt, true])).await?.get())?;
+        ensure!(finalized.complete, "Litecoin funding finalization incomplete");
+        let transaction = checked_signed(&finalized.hex, reserved.psbt())?;
+        let acceptance: Vec<Value> = serde_json::from_str(self.rpc(false, "testmempoolaccept", json!([[finalized.hex]])).await?.get())?;
+        ensure!(acceptance.len() == 1 && acceptance[0]["txid"] == txid.to_string() && acceptance[0]["allowed"] == true,
+            "Litecoin signed funding rejected by local consensus or policy");
+        let record = SignedRecord { schema:"monzero-ltc-signed-v1".into(), txid, hex:serialize_hex(&transaction) };
+        journal.retain(&signed_name, &serde_json::to_vec(&record)?)?;
+        Ok(SignedLock { transaction })
+    }
+}
+
+fn require_fresh_quote_for_first_relay(journal: &Journal, trade: uuid::Uuid, now: u64) -> Result<()> {
+    match journal.read(&format!("{trade}.quote")) {
+        Ok(bytes) => {
+            let record: Value = serde_json::from_slice(&bytes)?;
+            ensure!(record["schema"] == "monzero-ltc-quote-record-v1", "invalid retained Litecoin quote schema");
+            let expiry: u64 = record["terms"]["expiresAt"].as_str().context("missing retained quote expiry")?.parse()?;
+            ensure!(expiry > now, "Litecoin quote expired before first relay");
+        }
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => (),
+        Err(e) => return Err(e),
+    }
+    Ok(())
+}
+
+fn check_signing_context(journal: &Journal, trade: uuid::Uuid, policy: &RecoveryPolicy,
+    cancel: &Transaction, refund: &Transaction, unsigned_txid: bitcoin::Txid,
+    quote_record_hash: Option<String>, exchange_record_hash: Option<String>) -> Result<()> {
+    let bytes=serde_json::to_vec(&SigningRecord { schema:"monzero-ltc-signing-v1".into(),trade,
+        policy:policy.clone(),cancel:serialize_hex(cancel),refund:serialize_hex(refund),unsigned_txid,
+        quote_record_hash,exchange_record_hash })?;
+    journal.compatible(&format!("{trade}.signing"),&bytes)
+}
+
+fn retained_quote_hash(journal: &Journal, trade: uuid::Uuid) -> Result<Option<String>> {
+    retained_record_hash(journal, trade, "quote")
+}
+
+fn retained_record_hash(journal: &Journal, trade: uuid::Uuid, suffix: &str) -> Result<Option<String>> {
+    match journal.read(&format!("{trade}.{suffix}")) {
+        Ok(bytes) => Ok(Some(format!("{:x}", Sha256::digest(bytes)))),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+
+fn checked_signed(hex: &str, reserved: &Psbt) -> Result<Transaction> {
+    let tx: Transaction = deserialize_hex(hex)?;
+    ensure!(tx.input.iter().all(|i| !i.witness.is_empty()), "Litecoin funding lacks witness signatures");
+    let wallet = WalletTransaction { txid:tx.compute_txid(), hex:hex.into(), confirmations:0, blockhash:None };
+    validate_observed_transaction(&wallet, reserved)?;
+    Ok(tx)
+}
+
+fn verify_recovery(intent: &Intent, psbt: &Psbt, network: LtcNetwork, policy: &RecoveryPolicy,
+    cancel: &Transaction, refund: &Transaction) -> Result<()> {
+    ensure!((1..=0xffff).contains(&policy.cancel_blocks) && policy.cancel_fee > 0 && policy.refund_fee > 0
+        && policy.cancel_fee.checked_add(policy.refund_fee).is_some_and(|fee| fee < intent.amount),
+        "invalid Litecoin recovery timelock or fees");
+    ensure!(policy.minimum_relay_fee_atoms_per_kb > 0 && policy.minimum_output_atoms > 0
+        && intent.amount - policy.cancel_fee >= policy.minimum_output_atoms
+        && intent.amount - policy.cancel_fee - policy.refund_fee >= policy.minimum_output_atoms,
+        "Litecoin recovery output is below deployment policy");
+    for (transaction, fee) in [(cancel, policy.cancel_fee), (refund, policy.refund_fee)] {
+        ensure!(u128::from(fee) * 1000 >= u128::from(policy.minimum_relay_fee_atoms_per_kb) * transaction.vsize() as u128,
+            "Litecoin recovery fee is below deployment relay policy");
+    }
+    let parse = |key: &str| -> Result<PublicKey> {
+        let parsed = bitcoin::PublicKey::from_str(key)?;
+        ensure!(parsed.compressed && parsed.to_string() == key, "noncanonical Litecoin recovery key");
+        Ok(PublicKey::try_from(parsed)?)
+    };
+    let (a, b) = (parse(&policy.key_a)?, parse(&policy.key_b)?);
+    ensure!(policy.key_a != policy.key_b, "duplicate Litecoin recovery keys");
+    let descriptor = build_shared_output_descriptor(a.into(), b.into())?;
+    let contract = LtcSegwitAddress::parse(network, &intent.contract)?;
+    let destination = LtcSegwitAddress::parse(network, &policy.refund_address)?;
+    ensure!(descriptor.script_pubkey() == *contract.script_pubkey() && destination != contract,
+        "Litecoin recovery contract or destination mismatch");
+    let lock = TxLock::from_psbt(psbt.clone(), a, b, Amount::from_sat(intent.amount))?;
+    let expected_cancel = TxCancel::new(&lock, CancelTimelock::new(policy.cancel_blocks), a, b, Amount::from_sat(policy.cancel_fee))?;
+    let expected_refund = TxFullRefund::new_to_script(&expected_cancel, destination.script_pubkey(), Amount::from_sat(policy.refund_fee));
+    let witness_script = descriptor.explicit_script()?;
+    verify_witness(cancel, expected_cancel.txid(), expected_cancel.digest().to_byte_array(), &witness_script, a, b)?;
+    verify_witness(refund, expected_refund.txid(), expected_refund.digest().to_byte_array(), &witness_script, a, b)?;
+    Ok(())
+}
+
+fn verify_witness(tx: &Transaction, expected: bitcoin::Txid, digest: [u8;32], script: &ScriptBuf,
+    a: PublicKey, b: PublicKey) -> Result<()> {
+    ensure!(tx.compute_txid() == expected && tx.input.len() == 1, "Litecoin recovery transaction differs from policy");
+    let witness = tx.input[0].witness.to_vec();
+    ensure!(witness.len() == 3 && witness[2] == script.as_bytes(), "Litecoin recovery witness script mismatch");
+    // The shared script is A CHECKSIGVERIFY B CHECKSIG: A is consumed first
+    // from the top of the witness stack, therefore signatures are [B, A].
+    let secp = bitcoin::secp256k1::Secp256k1::verification_only();
+    for (signature, key) in [(&witness[0], b), (&witness[1], a)] {
+        let signature = bitcoin::ecdsa::Signature::from_slice(signature)?;
+        ensure!(signature.sighash_type == bitcoin::EcdsaSighashType::All, "unsafe Litecoin recovery sighash");
+        let key = bitcoin::PublicKey::try_from(key)?;
+        secp.verify_ecdsa(&bitcoin::secp256k1::Message::from_digest(digest), &signature.signature, &key.inner)?;
+    }
+    Ok(())
+}
+
