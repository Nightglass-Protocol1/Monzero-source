+//! Explicit private checkpoint for one prepared shared-address payment.
+//! The execution journal binds these bytes to its durable intent before use.
+use super::*;
+use serde::{Deserialize,Serialize};
+use swap_core::{monero::{PrivateKey,TransferProof,TxHash},xmz_address::XmzNetwork};
+use zeroize::{Zeroize,Zeroizing};
+
+pub(crate) struct PreparedNativeLock { transfer:PreparedTransfer,proof:TransferProof }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    schema:String,binding:[u8;32],genesis:String,wallet:String,destination:String,
+    amount:u64,account:u32,priority:u32,fee:u64,weight:u64,metadata:String,proof:TransferProof,
+}
+impl Drop for Record { fn drop(&mut self) { self.metadata.zeroize(); } }
+fn encode_record(record:&Record)->Result<Zeroizing<Vec<u8>>> {
+    // Bound the checkpoint and avoid reallocating secret-bearing serialization
+    // buffers. Ordinary serde fields/scalar copies are not all zeroizing types.
+    let mut bytes=Zeroizing::new(Vec::with_capacity(600_000));
+    serde_json::to_writer(&mut *bytes,record)?;
+    ensure!(bytes.len()<=600_000,"oversized native lock checkpoint");
+    Ok(bytes)
+}
+impl PreparedNativeLock {
+    pub(crate) fn summary(&self)->&RelayedTransfer { self.transfer.summary() }
+    pub(crate) fn terms(&self)->Value { self.transfer.journal_terms() }
+    pub(crate) fn proof(&self)->&TransferProof { &self.proof }
+    pub(crate) fn encode(&self,binding:[u8;32])->Result<Zeroizing<Vec<u8>>> {
+        let p=&self.transfer;
+        ensure!(p.lock_txid.is_none(),"native funding checkpoint is not a recovery spend");
+        let record=Record { schema:"monzero-prepared-native-lock-v1".into(),binding,
+            genesis:p.genesis.clone(),wallet:p.request.wallet.to_string(),destination:p.request.destination.to_string(),
+            amount:p.request.amount.atoms(),account:p.request.account,priority:p.request.priority,
+            fee:p.summary.fee.atoms(),weight:p.summary.weight,metadata:p.metadata.to_string(),proof:self.proof.clone() };
+        encode_record(&record)
+    }
+    pub(crate) fn decode(bytes:&[u8],binding:[u8;32],network:XmzNetwork)->Result<Self> {
+        ensure!(bytes.len()<=600_000,"oversized native lock checkpoint");
+        let record:Record=serde_json::from_slice(bytes)?;
+        ensure!(*encode_record(&record)?==bytes
+            && record.schema=="monzero-prepared-native-lock-v1" && record.binding==binding,
+            "native lock checkpoint context mismatch");
+        ensure!(canonical_hash(&record.genesis) && nonzero_hash(&record.proof.tx_hash.0)
+            && record.proof.tx_key.as_bytes()!=[0;32] && record.amount>0 && record.fee>0
+            && record.amount.checked_add(record.fee).is_some() && record.weight>0
+            && (1..=4).contains(&record.priority),"invalid native lock checkpoint terms");
+        ensure!(!record.metadata.is_empty() && record.metadata.len()<=524288 && record.metadata.len()%2==0
+            && record.metadata.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+            "invalid native lock checkpoint metadata");
+        let request=RelayRequest {wallet:XmzAddress::parse(network,&record.wallet)?,
+            destination:XmzAddress::parse(network,&record.destination)?,amount:XmzAmount::from_atoms(record.amount),
+            account:record.account,priority:record.priority};
+        Ok(Self { transfer:PreparedTransfer {request,genesis:record.genesis.clone(),
+            summary:RelayedTransfer {txid:record.proof.tx_hash.0.clone(),fee:XmzAmount::from_atoms(record.fee),weight:record.weight},
+            metadata:Zeroizing::new(record.metadata.clone()),lock_txid:None},proof:record.proof.clone() })
+    }
+}
+fn nonzero_hash(value:&str)->bool { canonical_hash(value) && value!="0".repeat(64) }
+fn take_proof(response:&mut Value)->Result<TransferProof> {
+    let key=match response.get_mut("tx_key").map(Value::take) {
+        Some(Value::String(value))=>Zeroizing::new(value),
+        _=>anyhow::bail!("missing native transfer key"),
+    };
+    ensure!(nonzero_hash(&key),"invalid native transfer key");
+    let mut bytes=Zeroizing::new([0u8;32]);
+    for (i,byte) in bytes.iter_mut().enumerate() { *byte=u8::from_str_radix(&key[i*2..i*2+2],16)?; }
+    let secret=PrivateKey::from_slice(bytes.as_ref()).map_err(|_|anyhow::anyhow!("invalid native transfer scalar"))?;
+    ensure!(*Zeroizing::new(secret.as_bytes())==*bytes,"noncanonical native transfer scalar");
+    let txid=string(response,"tx_hash")?;
+    ensure!(nonzero_hash(&txid),"invalid native transfer identity");
+    response["tx_key"]=json!("");
+    Ok(TransferProof::new(TxHash(txid),secret))
+}
+impl NativeTransferRelay {
+    /// Exact-byte relay primitive. The execution driver must retain dispatch
+    /// intent and recheck the peer lock/quote before calling this method.
+    #[cfg(test)]
+    pub(crate) async fn relay_native_lock(&mut self,prepared:&PreparedNativeLock)->Result<RelayedTransfer> {
+        self.preflight_native_lock(prepared).await?;
+        self.dispatch_native_lock(prepared).await
+    }
+
+    pub(crate) async fn preflight_native_lock(&self,prepared:&PreparedNativeLock)->Result<()> {
+        ensure!(!self.dispatched,"native lock relay already dispatched; reconcile before retrying");
+        let transfer=&prepared.transfer;
+        let before=self.client.snapshot().await?;
+        ensure!(before.genesis==transfer.genesis && canonical_hash(&before.tip_hash),"unexpected prepared native chain");
+        self.check_wallet(&transfer.request).await?;
+        ensure!(self.client.snapshot().await?==before,"native chain changed during prepared relay preflight");
+        // This transaction already selects its inputs. Wallet/daemon relay checks
+        // those exact inputs; unused balance is not authority for a replacement
+        // and may have fallen after an earlier uncertain submission.
+        Ok(())
+    }
+
+    /// Called only after the driver's final live-lock observation and durable
+    /// dispatch record. Use wall time again here, after all slow proof/RPC work.
+    pub(crate) async fn dispatch_native_lock_before(&mut self,prepared:&PreparedNativeLock,
+        expires_at:u64)->Result<RelayedTransfer> {
+        let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+        ensure!(now<expires_at,"native funding quote expired before dispatch");
+        self.dispatch_native_lock(prepared).await
+    }
+
+    async fn dispatch_native_lock(&mut self,prepared:&PreparedNativeLock)->Result<RelayedTransfer> {
+        ensure!(!self.dispatched,"native lock relay already dispatched; reconcile before retrying");
+        let transfer=&prepared.transfer;
+        let summary=RelayedTransfer {txid:transfer.summary.txid.clone(),fee:transfer.summary.fee,weight:transfer.summary.weight};
+        self.dispatched=true;
+        classify_prepared_broadcast(self.client.rpc(self.client.wallet,"relay_tx",
+            json!({"hex":transfer.metadata.as_str()})).await,summary)
+    }
+
+    /// Current source-wallet and tx-key evidence for this exact payment. A saved
+    /// relay acknowledgement never substitutes for confirmation at a stable tip.
+    pub(crate) async fn confirm_native_lock(&self,prepared:&PreparedNativeLock,minimum:u64)->Result<u64> {
+        ensure!(minimum>0,"zero native funding confirmation requirement");
+        let transfer=&prepared.transfer;
+        let before=self.client.snapshot().await?;
+        ensure!(before.genesis==transfer.genesis && canonical_hash(&before.tip_hash),"unexpected native funding chain");
+        self.check_wallet(&transfer.request).await?;
+        let response=self.client.rpc(self.client.wallet,"get_transfer_by_txid",
+            json!({"txid":transfer.summary.txid,"account_index":transfer.request.account})).await?;
+        let observed=&response["transfer"];
+        ensure!(observed["type"]=="out" && observed["txid"]==transfer.summary.txid
+            && number(observed,"amount")?==transfer.request.amount.atoms()
+            && number(observed,"fee")?==transfer.summary.fee.atoms() && number(observed,"unlock_time")?==0
+            && number(&observed["subaddr_index"],"major")?==u64::from(transfer.request.account),
+            "native funding history differs from prepared payment");
+        let destinations=observed["destinations"].as_array().context("missing native funding destinations")?;
+        ensure!(destinations.len()==1 && destinations[0]["address"]==transfer.request.destination.to_string()
+            && number(&destinations[0],"amount")?==transfer.request.amount.atoms(),"native funding destination mismatch");
+        let height=number(observed,"height")?;let confirmations=number(observed,"confirmations")?;
+        ensure!(height>0 && confirmations>=minimum
+            && before.tip_height.checked_sub(height).and_then(|v|v.checked_add(1))==Some(confirmations),
+            "native funding is not sufficiently confirmed");
+        let key=Zeroizing::new(prepared.proof.tx_key.to_string());
+        let checked=self.client.rpc(self.client.wallet,"check_tx_key",json!({"txid":transfer.summary.txid,
+            "tx_key":key.as_str(),"address":transfer.request.destination.to_string()})).await?;
+        ensure!(checked["in_pool"]==false && number(&checked,"received")?==transfer.request.amount.atoms()
+            && number(&checked,"confirmations")?==confirmations,"native funding proof disagrees with wallet history");
+        self.check_wallet(&transfer.request).await?;
+        ensure!(self.client.snapshot().await?==before,"native chain changed during funding reconciliation");
+        Ok(confirmations)
+    }
+    /// No broadcast. Caller must reserve its immutable funding intent first.
+    pub(crate) async fn prepare_native_lock(&mut self,request:RelayRequest,genesis:&str,
+        maximum_fee:XmzAmount)->Result<PreparedNativeLock> {
+        ensure!(maximum_fee.atoms()>0,"zero native lock fee ceiling");
+        self.preflight(&request,genesis).await?;
+        let mut params=prepare_params(&request);params["get_tx_key"]=json!(true);
+        let mut response=self.client.rpc(self.client.wallet,"transfer",params).await?;
+        let proof=take_proof(&mut response)?;
+        let (summary,metadata)=parse_prepared(response,request.amount,maximum_fee)?;
+        self.check_wallet(&request).await?;
+        Ok(PreparedNativeLock {transfer:PreparedTransfer {request,genesis:genesis.into(),summary,metadata,lock_txid:None},proof})
+    }
+}
