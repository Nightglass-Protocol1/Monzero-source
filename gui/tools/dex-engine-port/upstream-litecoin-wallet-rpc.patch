+    use serde::{Deserialize,Serializer,Deserializer};
+    pub fn serialize<S: Serializer>(value: &XmzNetwork,s: S)->Result<S::Ok,S::Error> {
+        s.serialize_str(match value { XmzNetwork::Mainnet=>"xmz-mainnet",XmzNetwork::Testnet=>"xmz-testnet",XmzNetwork::Stagenet=>"xmz-stagenet" })
+    }
+    pub fn deserialize<'de,D: Deserializer<'de>>(d: D)->Result<XmzNetwork,D::Error> {
+        match String::deserialize(d)?.as_str() {
+            "xmz-mainnet"=>Ok(XmzNetwork::Mainnet),"xmz-testnet"=>Ok(XmzNetwork::Testnet),"xmz-stagenet"=>Ok(XmzNetwork::Stagenet),
+            _=>Err(serde::de::Error::custom("invalid native deployment")),
