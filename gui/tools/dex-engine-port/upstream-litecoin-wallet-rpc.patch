+                    stream.write_all(header.as_bytes()).await?;stream.write_all(&bytes).await?;
+                }
+            }));
+        }
+        Ok(Self {client:NativeFundingRpc::new(ports[0],ports[1],"fixture".into(),"fixture".into())?,calls,fail,lose_reply,confirmed,ports,tasks})
+    }
+}
