+//! Non-relaying refund payment preparation owned by the durable execution journal.
+use super::*;
+use super::native_refund::BoundRefund;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::{NativeFundingRpc,
+    full_proceeds::lock_payout::{self,PreparedLockPayout}},native_funding_rpc::relay::NativeTransferRelay};
+use zeroize::Zeroizing;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {schema:String,checkpoint:[u8;32],quote:[u8;32],refund:[u8;32],priority:u32}
+pub(super) fn intent_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-native-refund-payout-intent")}
+pub(super) fn prepared_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-native-refund-payout-prepared")}
+fn missing(error:&anyhow::Error)->bool {
+    error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)
+}
+impl Intent {
+    fn new(head:&Head,priority:u32)->Result<Self> {
+        ensure!((1..=4).contains(&priority),"invalid native payout priority");
+        Ok(Self {schema:"monzero-ltc-native-refund-payout-intent-v1".into(),checkpoint:head.checkpoint,
+            quote:head.quote,refund:head.native_refund.context("native payout lacks committed refund")?,priority})
+    }
+    fn decode(bytes:&[u8],head:&Head)->Result<Self> {
+        let intent:Self=serde_json::from_slice(bytes)?;
+        ensure!(serde_json::to_vec(&Self::new(head,intent.priority)?)?==bytes,
+            "native payout intent differs from committed refund");
+        if let Some(expected)=head.native_refund_payout_intent {
+            ensure!(<[u8;32]>::from(Sha256::digest(bytes))==expected,"native payout intent differs from head");
+        }
+        Ok(intent)
+    }
+}
+impl Execution {
+    /// Persist intent before construction and exact private bytes before returning
+    /// accounting. Existing preparations recover offline; never construct a replacement.
+    pub async fn prepare_native_refund_payout(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash,client:&NativeFundingRpc,priority:u32)->Result<serde_json::Value> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong native payout role");
+        ensure!((1..=4).contains(&priority),"invalid native payout priority");
+        let (head,_,_,_,_)=self.load()?;
+        match self.metadata.read(&intent_name(self.claim.trade)) {
+            Ok(bytes)=>{
+                let intent=Intent::decode(&bytes,&head)?;
+                ensure!(intent.priority==priority,"native payout priority already committed");
+                let retained={Journal::open(&self.snapshots)?.read(&prepared_name(self.claim.trade)).map(Zeroizing::new)};
+                match retained {
+                    Ok(_)=>{},
+                    Err(e) if missing(&e)=>{
+                        ensure!(head.native_refund_payout.is_none(),"committed payout is missing");
+                        return self.construct_native_refund_payout(native,ltc,block,client,priority).await;
+                    },
+                    Err(e)=>return Err(e),
+                }
+                self.recover_prepared_native_refund_payout()
+            },
+            Err(e) if missing(&e)=>self.construct_native_refund_payout(native,ltc,block,client,priority).await,
+            Err(e)=>Err(e),
+        }
+    }
+    async fn construct_native_refund_payout(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash,client:&NativeFundingRpc,priority:u32)->Result<serde_json::Value> {
+        // Reobserve both chains before every construction attempt. No expiry check:
+        // this spends an existing claim, not admission of a new funded trade.
+        let refund=self.prepare_native_refund(native,ltc,block).await?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        // Reject legacy quotes before retaining an intent that cannot be fulfilled.
+        let mut bound=BoundRefund::from_quote(&quote,keys.native_address(),&self.load_prepared_native_lock()?.summary().txid)?;
+        bound.request.source.priority=priority;
+        ensure!(refund.address()==&bound.request.source.wallet,"native refund wallet mismatch");
+        let bytes=serde_json::to_vec(&Intent::new(&head,priority)?)?;
+        self.metadata.retain(&intent_name(self.claim.trade),&bytes)?;
+        let binding=Sha256::digest(&bytes).into();
+        head.native_refund_payout_intent=Some(binding);
+        self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        let prepared=lock_payout::prepare(client,&bound.request,&bound.genesis).await?;
+        let bytes=prepared.encode(binding)?;
+        // Validate using the recovery path before occupying an immutable slot.
+        PreparedLockPayout::decode(&bytes,binding,Sha256::digest(&*bytes).into(),&bound.request,&bound.genesis)?;
+        Journal::open(&self.snapshots)?.retain(&prepared_name(self.claim.trade),&bytes)?;
+        self.recover_prepared_native_refund_payout()
+    }
+    /// Exact offline recovery. Saved metadata is not current chain evidence and
+    /// this method never broadcasts. Missing committed bytes fail closed.
+    pub fn recover_prepared_native_refund_payout(&mut self)->Result<serde_json::Value> {
+        Ok(self.load_prepared_native_refund_payout()?.terms().clone())
+    }
+    pub(super) fn load_prepared_native_refund_payout(&mut self)->Result<PreparedLockPayout> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong native payout recovery role");
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        let intent_bytes=self.metadata.read(&intent_name(self.claim.trade))?;
+        let intent=Intent::decode(&intent_bytes,&head)?;
+        let binding=Sha256::digest(&intent_bytes).into();
+        let mut bound=BoundRefund::from_quote(&quote,keys.native_address(),&self.load_prepared_native_lock()?.summary().txid)?;
+        bound.request.source.priority=intent.priority;
+        let bytes=Zeroizing::new(Journal::open(&self.snapshots)?.read(&prepared_name(self.claim.trade))?);
+        let actual=Sha256::digest(&*bytes).into();
+        // Before head publication, the owner-only immutable file is the local
+        // crash-recovery candidate. After publication only the committed pin works.
+        let expected=head.native_refund_payout.unwrap_or(actual);
+        let prepared=PreparedLockPayout::decode(&bytes,binding,expected,&bound.request,&bound.genesis)?;
+        self.metadata.retain(&intent_name(self.claim.trade),&intent_bytes)?;
+        Journal::open(&self.snapshots)?.retain(&prepared_name(self.claim.trade),&bytes)?;
+        if head.native_refund_payout_intent.is_none() || head.native_refund_payout.is_none() {
+            head.native_refund_payout_intent=Some(binding);head.native_refund_payout=Some(actual);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(prepared)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn head()->Head {
+        serde_json::from_value(serde_json::json!({"schema":"monzero-ltc-execution-head-v1",
+            "trade":uuid::Uuid::from_u128(1),"quote":vec![2;32],"checkpoint":vec![3;32],"step":2,
+            "native_refund":vec![4;32]})).unwrap()
+    }
+    #[test]
+    fn refund_intent_retains_priority_and_exact_refund_context()->Result<()> {
+        for priority in 1..=4 {
+            let mut head=head();
+            let bytes=serde_json::to_vec(&Intent::new(&head,priority)?)?;
+            head.native_refund_payout_intent=Some(Sha256::digest(&bytes).into());
+            assert_eq!(Intent::decode(&bytes,&head)?.priority,priority);
+            head.native_refund=Some([5;32]);assert!(Intent::decode(&bytes,&head).is_err());
+            head.native_refund=Some([4;32]);head.quote=[6;32];assert!(Intent::decode(&bytes,&head).is_err());
+            head.quote=[2;32];head.checkpoint=[7;32];assert!(Intent::decode(&bytes,&head).is_err());
+            head.checkpoint=[3;32];head.native_refund_payout_intent=Some([8;32]);assert!(Intent::decode(&bytes,&head).is_err());
+        }
+        let mut head=head();
+        assert!(Intent::new(&head,0).is_err());assert!(Intent::new(&head,5).is_err());
+        head.native_refund=None;assert!(Intent::new(&head,1).is_err());
+        Ok(())
+    }
+}
