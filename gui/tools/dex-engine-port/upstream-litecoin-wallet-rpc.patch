+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Head { schema:String,trade:uuid::Uuid,quote:[u8;32],checkpoint:[u8;32],step:u8,
+    outgoing_source:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    recovery_intent:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_proof:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    redeem_outgoing:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_lock_intent:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_lock:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_dispatch:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_receipt:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    redeem_completed:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_claim:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_payout_intent:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_payout:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_payout_dispatch:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_payout_receipt:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    redeem_dispatch:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    redeem_receipt:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_refund:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_refund_payout_intent:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_refund_payout:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    native_refund_payout_dispatch:Option<[u8;32]>,
+    #[serde(default,skip_serializing_if="Option::is_none")]
