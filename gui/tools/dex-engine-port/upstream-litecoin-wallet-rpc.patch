+            ensure!(<[u8;32]>::from(Sha256::digest(&*retained))==expected,"missing or altered prepared native lock");
+        }
+        if let Some(expected)=head.native_dispatch {
+            ensure!(head.native_lock.is_some(),"native dispatch lacks prepared payment");
+            let retained=self.metadata.read(&native_relay::dispatch_name(self.claim.trade))?;
+            ensure!(<[u8;32]>::from(Sha256::digest(&retained))==expected,"missing or altered native dispatch intent");
+        }
+        if let Some(expected)=head.native_receipt {
