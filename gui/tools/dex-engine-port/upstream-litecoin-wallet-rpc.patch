+//! Confirmed transparent transactions from a caller-owned Litecoin node.
+use super::*;
+use bitcoin::{Transaction,Txid,Wtxid,consensus::encode::{deserialize,serialize_hex}};
+use bitcoin::hex::FromHex;
+
+/// Point-in-time node evidence, never a deserializable peer assertion.
+pub struct ConfirmedTransaction {
+    network:LtcNetwork,tip:BlockHash,block:BlockHash,confirmations:u64,transaction:Transaction,
+}
+impl ConfirmedTransaction {
+    pub fn network(&self)->LtcNetwork { self.network }
+    pub fn tip(&self)->BlockHash { self.tip }
+    pub fn block(&self)->BlockHash { self.block }
+    pub fn confirmations(&self)->u64 { self.confirmations }
+    pub fn transaction(&self)->&Transaction { &self.transaction }
+}
+#[derive(Deserialize)]
+struct RawTransaction { in_active_chain:bool,hex:String,txid:Txid,hash:Wtxid,blockhash:BlockHash,confirmations:u64 }
+#[derive(Deserialize)]
+struct Header { hash:BlockHash,confirmations:i64 }
+fn validate(raw:RawTransaction,header:Header,txid:Txid,block:BlockHash,minimum:u64)->Result<Transaction> {
+    ensure!(minimum>0 && raw.in_active_chain && raw.txid==txid && raw.blockhash==block
+        && header.hash==block && header.confirmations>0
+        && u64::try_from(header.confirmations)?==raw.confirmations && raw.confirmations>=minimum,
+        "Litecoin transaction is not confirmed in the requested active block");
+    ensure!(!raw.hex.is_empty() && raw.hex.len()<=400_000,"invalid transparent transaction size");
+    let transaction:Transaction=deserialize(&Vec::<u8>::from_hex(&raw.hex)?)?;
+    ensure!(serialize_hex(&transaction)==raw.hex && transaction.compute_txid()==txid
+        && transaction.compute_wtxid()==raw.hash,"Litecoin transaction bytes differ from node identity");
+    Ok(transaction)
+}
+impl LitecoinRpc {
+    /// Explicit block lookup avoids requiring a transaction index. The supplied
+    /// block is only a search hint; active-chain membership is checked by RPC.
+    pub async fn confirmed_transaction(&self,txid:Txid,block:BlockHash,minimum:u64)->Result<ConfirmedTransaction> {
+        ensure!(minimum>0,"zero Litecoin transaction confirmation requirement");
+        let tip=self.chain().await?;
+        let raw:RawTransaction=serde_json::from_str(self.rpc(false,"getrawtransaction",
+            json!([txid.to_string(),true,block.to_string()])).await?.get())?;
+        let header:Header=serde_json::from_str(self.rpc(false,"getblockheader",
+            json!([block.to_string(),true])).await?.get())?;
+        let confirmations=raw.confirmations;
+        let transaction=validate(raw,header,txid,block,minimum)?;
+        ensure!(self.chain().await?==tip,"Litecoin tip changed during transaction observation");
+        Ok(ConfirmedTransaction {network:self.network,tip,block,confirmations,transaction})
+    }
+}
+#[cfg(test)]
+mod tests {
