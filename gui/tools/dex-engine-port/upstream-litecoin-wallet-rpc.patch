+    let wrong=ltc.sign(&signing_bytes(&payload,false)?).to_bytes();
+    assert!(VerifiedLtcQuote::verify(&payload,1000,&policy,&l,&x,&wrong,&xs).is_err());
+    let mut duplicate=payload.clone(); duplicate.splice(1..1,b"\"ltcAtoms\":\"1\",".iter().copied());
+    let mut spaced=payload.clone(); spaced.push(b' ');
+    let unordered=format!("{{{}}}",terms.iter().rev().map(|(key,value)|
+        format!("{}:{}",serde_json::to_string(key).unwrap(),serde_json::to_string(value).unwrap())).collect::<Vec<_>>().join(",")).into_bytes();
+    // Both parties sign each malformed encoding: rejection must come from the
+    // canonical format boundary, not merely from an invalid signature.
+    for bytes in [duplicate,spaced,unordered] {
+        let left=ltc.sign(&signing_bytes(&bytes,true)?).to_bytes();
+        let right=xmz.sign(&signing_bytes(&bytes,false)?).to_bytes();
+        assert!(VerifiedLtcQuote::verify(&bytes,1000,&policy,&l,&x,&left,&right).is_err());
