+//! Explicit sensitive key checkpoints. These bytes are not safe for logs or
+//! public journals. This codec does not write/fsync files, encrypt secrets, or
+//! provide durable storage. The caller must atomically persist the key and
+//! transcript checkpoints with the latest trusted execution record.
+use super::*;
+use swap_core::monero::ScalarExt;
+use zeroize::Zeroizing;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SecretState {
+    schema: String,
+    quote_commitment: [u8;32],
+    local_sequence: u8,
+    contract_secret: [u8;32],
+    native_secret: [u8;32],
+    view_secret: [u8;32],
+    share: KeyShare,
+}
+fn sequence(role: LocalRole) -> u8 {
+    match role { LocalRole::LitecoinFunder=>0, LocalRole::NativeFunder=>1 }
+}
+impl LocalKeys {
+    /// Contains spending secrets and the original proof. Protect and durably
+    /// retain this before publishing a frame. Zeroizing the returned buffer
+    /// does not imply that all serializer/internal copies are zeroized.
+    pub fn secret_checkpoint(&self, quote: &VerifiedLtcQuote, role: LocalRole)
+        -> Result<Zeroizing<Vec<u8>>> {
+        let contract: swap_core::bitcoin::Scalar=self.contract.clone().into();
+        let state=SecretState { schema:"monzero-ltc-local-keys-v1".into(),
+            quote_commitment:*quote.commitment(),local_sequence:sequence(role),
+            contract_secret:contract.to_bytes(),native_secret:self.spend.into_dalek_ng().to_bytes(),
+            view_secret:self.view.0.as_bytes(),share:self.share.clone() };
+        let bytes=serde_json::to_vec(&state)?;
+        ensure!(bytes.len()<=MAX_FRAME,"oversized Litecoin secret checkpoint");
+        Ok(Zeroizing::new(bytes))
+    }
+
+    /// Restore original proof bytes without proof regeneration. This restores
+    /// keys only; it never grants funding authority or resets a trade cursor.
+    /// Quote expiry must not prevent recovering already-funded transactions.
+    pub fn restore_secret_checkpoint(bytes: &[u8], quote: &VerifiedLtcQuote, role: LocalRole)
+        -> Result<(Self,KeyShare)> {
+        ensure!(!bytes.is_empty() && bytes.len()<=MAX_FRAME,"invalid Litecoin secret checkpoint size");
+        let state: SecretState=serde_json::from_slice(bytes)
+            .map_err(|_|anyhow::anyhow!("invalid Litecoin secret checkpoint encoding"))?;
+        ensure!(state.schema=="monzero-ltc-local-keys-v1" && state.quote_commitment==*quote.commitment()
+            && state.local_sequence==sequence(role),"Litecoin secret checkpoint context mismatch");
+        ensure!(serde_json::to_vec(&state)?==bytes,"noncanonical Litecoin secret checkpoint");
+        let scalar=swap_core::bitcoin::Scalar::from_bytes(state.contract_secret)
+            .context("invalid Litecoin contract secret")?.non_zero().context("zero Litecoin contract secret")?;
+        let contract=SecretKey::from(scalar);
+        let spend=monero::Scalar::read(&mut &state.native_secret[..])
+            .map_err(|_|anyhow::anyhow!("invalid native spend secret"))?;
+        let native=spend.into_dalek_ng();
+        ensure!(native!=Scalar::zero() && native.as_bytes()[31]&0x10==0,"invalid native proof secret range");
+        let view=monero::PrivateViewKey(monero_oxide_ext::PrivateKey::from_slice(&state.view_secret)
+            .map_err(|_|anyhow::anyhow!("invalid native view secret"))?);
+        let native_public=(&native * &curve25519_dalek_ng::constants::ED25519_BASEPOINT_TABLE).compress().to_bytes();
+        ensure!(contract.public()==state.share.contract_key
+            && SecretKey::from(spend.to_secpfun_scalar()).public()==state.share.adaptor_key
+            && native_public==state.share.native_spend_key && view.0.as_bytes()==state.share.view_share,
+            "Litecoin checkpoint secrets do not match advertised keys");
+        validate_share(&state.share)?;
+        let share=state.share;
+        Ok((Self { contract,spend,view,share:share.clone() },share))
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct AcceptedFrame {
+    pub(super) bytes: Vec<u8>,
+    pub(super) signature: Vec<u8>,
+    pub(super) accepted_at: u64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TranscriptState {
+    schema: String, quote_commitment: [u8;32], local_sequence: u8,
+    started_at: u64, next: u8, previous: [u8;32], accepted: Vec<AcceptedFrame>,
+    local_share_digest: [u8;32], policy: Policy, quote_record: Vec<u8>,
+}
+const MAX_TRANSCRIPT: usize=2_000_000;
+impl KeyExchange {
+    /// Sensitive accepted frames plus an integrity commitment. The caller must
+    /// atomically retain these with its latest execution state. Neither this
+    /// codec nor a hash stored beside the bytes provides rollback protection.
+    pub fn transcript_checkpoint(&self) -> Result<(Zeroizing<Vec<u8>>,[u8;32])> {
+        let state=TranscriptState { schema:"monzero-ltc-key-transcript-v1".into(),
+            quote_commitment:self.commitment,local_sequence:self.local_sequence,started_at:self.started_at,
+            next:self.next,previous:self.previous,accepted:self.accepted.clone(),
+            local_share_digest:Sha256::digest(&self.local_share).into(),policy:self.policy.clone(),quote_record:self.quote_record.clone() };
+        let bytes=serde_json::to_vec(&state)?;
+        ensure!(bytes.len()<=MAX_TRANSCRIPT,"oversized Litecoin transcript checkpoint");
+        let commitment=Sha256::digest(&bytes).into();
+        Ok((Zeroizing::new(bytes),commitment))
+    }
+
+    /// Bootstrap the signed quote from an exactly committed snapshot. Pins
+    /// come from the trusted execution identity configuration, not this file.
+    pub(crate) fn quote_from_checkpoint(bytes: &[u8], expected_commitment: &[u8;32],
+        ltc_pin: &[u8;32], xmz_pin: &[u8;32]) -> Result<VerifiedLtcQuote> {
+        ensure!(!bytes.is_empty() && bytes.len()<=MAX_TRANSCRIPT,"invalid Litecoin checkpoint size");
+        let digest: [u8;32]=Sha256::digest(bytes).into();
+        ensure!(&digest==expected_commitment,"Litecoin checkpoint commitment mismatch");
+        let state: TranscriptState=serde_json::from_slice(bytes)
+            .map_err(|_|anyhow::anyhow!("invalid Litecoin checkpoint encoding"))?;
+        ensure!(state.schema=="monzero-ltc-key-transcript-v1" && serde_json::to_vec(&state)?==bytes,
+            "noncanonical Litecoin checkpoint");
+        VerifiedLtcQuote::restore_record(&state.quote_record,&state.policy,state.started_at,
+            ltc_pin,xmz_pin,&state.quote_commitment)
+    }
+
+    /// Revalidate every original signature, proof and predecessor at its saved
+    /// admission time, even after quote expiry. New acceptance and funding still
+    /// enforce current expiry. The supplied commitment must come from the
+    /// driver's latest trusted execution record, never the peer or these bytes.
+    pub fn restore_transcript_checkpoint(bytes: &[u8], expected_commitment: &[u8;32],
+        quote: &VerifiedLtcQuote, policy: &Policy, role: LocalRole, keys: &LocalKeys) -> Result<Self> {
+        ensure!(!bytes.is_empty() && bytes.len()<=MAX_TRANSCRIPT,"invalid Litecoin transcript checkpoint size");
+        let digest: [u8;32]=Sha256::digest(bytes).into();
+        ensure!(&digest==expected_commitment,"Litecoin transcript checkpoint commitment mismatch");
+        let state: TranscriptState=serde_json::from_slice(bytes)
+            .map_err(|_|anyhow::anyhow!("invalid Litecoin transcript checkpoint encoding"))?;
+        ensure!(state.schema=="monzero-ltc-key-transcript-v1" && state.quote_commitment==*quote.commitment()
+            && state.local_sequence==sequence(role) && state.accepted.len()<=2
+            && usize::from(state.next)==state.accepted.len(),"Litecoin transcript checkpoint context mismatch");
+        ensure!(serde_json::to_vec(&state)?==bytes,"noncanonical Litecoin transcript checkpoint");
+        ensure!(state.quote_record==quote.record()?,"checkpoint signed quote record mismatch");
+        let local_share_digest: [u8;32]=Sha256::digest(canonical(&keys.share)?).into();
+        ensure!(state.local_share_digest==local_share_digest,"restored Litecoin keys differ from committed local share");
+        ensure!(state.policy.ltc_network==policy.ltc_network && state.policy.xmz_network==policy.xmz_network
+            && state.policy.xmz_genesis==policy.xmz_genesis,"Litecoin recovery deployment mismatch");
+        // Recover obligations using their committed historical policy; current
+        // admission limits still apply separately to any new funding request.
+        let mut restored=Self::new(quote,&state.policy,state.started_at,role,keys)?;
+        for frame in state.accepted {
+            restored.accept(&frame.bytes,&frame.signature,frame.accepted_at)?;
+        }
+        ensure!(restored.next==state.next && restored.previous==state.previous,"Litecoin transcript checkpoint cursor mismatch");
+        Ok(restored)
+    }
+}
