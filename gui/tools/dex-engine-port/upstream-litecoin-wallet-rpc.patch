+    let sign=if terms["schema"]==PAYOUT_DOMAIN {payout_signing_bytes} else {signing_bytes};
+    VerifiedLtcQuote::verify(&payload, now, policy, &ltc.verifying_key().to_bytes(), &xmz.verifying_key().to_bytes(),
+        &ltc.sign(&sign(&payload,true)?).to_bytes(), &xmz.sign(&sign(&payload,false)?).to_bytes())
+}
