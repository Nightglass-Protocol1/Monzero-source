+//! Alice's private, durable completed redemption. Completion does not relay.
+use super::*;
+use bitcoin::Transaction;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Completed {
+    schema:String,checkpoint:[u8;32],quote:[u8;32],prepared:[u8;32],
+    bytes:Vec<u8>,signature:Vec<u8>,transaction:Transaction,
+}
+pub(super) fn completed_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-redeem-completed") }
+impl Execution {
+    /// Retain the verified peer release and completed transaction before returning
+    /// spendable bytes. The native identity comes only from our own saved payment.
+    pub fn complete_redeem(&mut self,bytes:&[u8],signature:&[u8])->Result<Transaction> {
+        self.checked_redeem_completion(Some((bytes,signature)))
+    }
+
+    /// Offline recovery revalidates the same peer release and exact transaction.
+    pub fn recover_completed_redeem(&mut self)->Result<Transaction> {
+        self.checked_redeem_completion(None)
+    }
+
+    fn checked_redeem_completion(&mut self,incoming:Option<(&[u8],&[u8])>)->Result<Transaction> {
+        ensure!(matches!(self.role,LocalRole::NativeFunder),"wrong redeem completion role");
+        let prepared=self.load_prepared_native_lock()?;
+        self.recover_recovery()?;
+        let (mut head,previous,_,_,_)=self.load()?;
+        ensure!(head.native_dispatch.is_some(),"native payment has not been dispatched");
+        let name=completed_name(self.claim.trade);
+        let retained=match Journal::open(&self.snapshots)?.read(&name) {
+            Ok(bytes)=>Some(zeroize::Zeroizing::new(bytes)),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>None,
+            Err(e)=>return Err(e),
+        };
+        let (plan,local)=self.recovery_plan()?;
+        let native_txid=&prepared.summary().txid;
+        let record=if let Some(bytes)=&retained {
+            let record:Completed=serde_json::from_slice(bytes)?;
+            ensure!(serde_json::to_vec(&record)?==**bytes,"noncanonical completed redeem");
+            if let Some((bytes,signature))=incoming {
+                ensure!(record.bytes==bytes && record.signature==signature,"redeem already bound to another peer release");
+            }
+            let transaction=plan.complete_redeem(&local,native_txid,&record.bytes,&record.signature)?;
+            ensure!(transaction==record.transaction,"retained redeem transaction differs from agreement");
+            record
+        } else {
+            ensure!(head.redeem_completed.is_none(),"committed completed redeem is missing");
+            let (bytes,signature)=incoming.context("no retained completed redeem")?;
+            let transaction=plan.complete_redeem(&local,native_txid,bytes,signature)?;
+            Completed { schema:"monzero-ltc-completed-redeem-v1".into(),checkpoint:head.checkpoint,
+                quote:self.claim.quote,prepared:head.native_lock.context("missing native preparation")?,
+                bytes:bytes.to_vec(),signature:signature.to_vec(),transaction }
+        };
+        ensure!(record.schema=="monzero-ltc-completed-redeem-v1" && record.checkpoint==head.checkpoint
+            && record.quote==self.claim.quote && Some(record.prepared)==head.native_lock,
+            "completed redeem context mismatch");
+        let bytes=zeroize::Zeroizing::new(serde_json::to_vec(&record)?);
+        let digest=Sha256::digest(&*bytes).into();
+        if let Some(expected)=head.redeem_completed { ensure!(expected==digest,"completed redeem differs from head"); }
+        Journal::open(&self.snapshots)?.retain(&name,&bytes)?;
+        if head.redeem_completed.is_none() {
+            head.redeem_completed=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(record.transaction)
+    }
+}
