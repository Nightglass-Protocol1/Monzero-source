+//! Native funding dispatch under the execution lease. No payment reconstruction.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::relay::{NativeTransferRelay,RelayedTransfer,
+    lock_checkpoint::PreparedNativeLock}};
+use swap_core::monero::TransferProof;
+
+#[derive(Serialize)]
+struct Dispatch { schema:&'static str,trade:uuid::Uuid,quote:[u8;32],checkpoint:[u8;32],prepared:[u8;32] }
+#[derive(Serialize)]
+struct Receipt { schema:&'static str,dispatch:[u8;32],txid:String,fee:u64,weight:u64 }
+pub(super) fn dispatch_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-dispatch") }
+pub(super) fn receipt_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-native-receipt") }
+fn clock()->Result<u64> { Ok(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs()) }
+impl Execution {
+    fn native_dispatch_bytes(&self,head:&Head)->Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&Dispatch { schema:"monzero-ltc-native-dispatch-v1",trade:self.claim.trade,
+            quote:self.claim.quote,checkpoint:head.checkpoint,prepared:head.native_lock.context("native payment is not committed")? })?)
+    }
+
+    pub(super) fn checked_native_dispatch(&self,head:&Head)->Result<[u8;32]> {
+        let bytes=self.native_dispatch_bytes(head)?;
+        let digest=Sha256::digest(&bytes).into();
+        ensure!(head.native_dispatch==Some(digest)
+            && self.metadata.read(&dispatch_name(self.claim.trade))?==bytes,"native dispatch context mismatch");
+        self.metadata.retain(&dispatch_name(self.claim.trade),&bytes)?;
+        Ok(digest)
+    }
+
+    /// Send the exact retained native transaction once. An uncertain result
+    /// leaves dispatch occupied; calling this initial operation again is refused.
+    pub async fn relay_native_lock(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        safety_blocks:u32)->Result<RelayedTransfer> {
+        self.dispatch_native_lock(native,ltc,safety_blocks,false).await
+    }
+
+    /// Explicit retransmission only, under fresh quote/live-lock checks. The
+    /// caller supplies a fresh RPC relay instance; no replacement is constructed.
+    pub async fn retransmit_native_lock(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        safety_blocks:u32)->Result<RelayedTransfer> {
+        self.dispatch_native_lock(native,ltc,safety_blocks,true).await
+    }
+
+    async fn dispatch_native_lock(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        safety_blocks:u32,retry:bool)->Result<RelayedTransfer> {
+        let prepared=self.load_prepared_native_lock()?;
+        let (mut head,previous,quote,_,exchange)=self.load()?;
+        if retry { self.checked_native_dispatch(&head)?; }
+        else { ensure!(head.native_dispatch.is_none(),"native payment already attempted; reconcile or explicitly retransmit"); }
+        let recovery=self.recover_recovery()?;
+        let keys=exchange.finish()?;
+        let outpoint=recovery.cancel.input.first().context("missing Litecoin cancellation input")?.previous_output;
+        let required=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let amount=bitcoin::Amount::from_sat(quote.terms()["ltcAtoms"].parse()?);
+        let cancel=quote.terms()["cancelBlocks"].parse()?;
+        quote.check_policy(&self.policy,clock()?)?;
+        native.preflight_native_lock(&prepared).await?;
+        // Expensive proof restoration is finished before these final observations.
+        let live=ltc.verify_live_lock(outpoint,keys.contract_address().script_pubkey(),amount,
+            required,cancel,safety_blocks).await?;
+        ensure!(live.network()==self.policy.ltc_network,"wrong Litecoin funding observation network");
+        let bytes=self.native_dispatch_bytes(&head)?;
+        let digest=Sha256::digest(&bytes).into();
+        // RPC observations can outlast the signed quote window. Refuse before
+        // publishing an attempted dispatch; the relay also checks after commit.
+        quote.check_policy(&self.policy,clock()?)?;
+        self.metadata.retain(&dispatch_name(self.claim.trade),&bytes)?;
+        if head.native_dispatch.is_none() {
+            head.native_dispatch=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        let acknowledged=native.dispatch_native_lock_before(&prepared,quote.terms()["expiresAt"].parse()?).await?;
+        self.retain_native_receipt(&prepared)
+            .context("native broadcast acknowledged, but saving its receipt failed; reconcile the saved payment")?;
+        Ok(acknowledged)
+    }
+
+    fn retain_native_receipt(&mut self,prepared:&PreparedNativeLock)->Result<()> {
+        let (mut head,previous,_,_,_)=self.load()?;
+        let dispatch=self.checked_native_dispatch(&head)?;
+        let summary=prepared.summary();
+        let bytes=serde_json::to_vec(&Receipt {schema:"monzero-ltc-native-receipt-v1",dispatch,
+            txid:summary.txid.clone(),fee:summary.fee.atoms(),weight:summary.weight})?;
+        let digest=Sha256::digest(&bytes).into();
+        if let Some(expected)=head.native_receipt { ensure!(expected==digest,"native receipt differs from prepared payment"); }
+        self.metadata.retain(&receipt_name(self.claim.trade),&bytes)?;
+        if head.native_receipt.is_none() {
+            head.native_receipt=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(())
+    }
+
+    /// Reconcile the exact attempted payment, including a lost relay reply.
+    /// Every call verifies current confirmation and tx-key evidence; a retained
+    /// receipt is only an acknowledgement, never cached chain authority.
+    /// The returned proof is private peer-protocol data and must not be logged.
+    pub async fn reconcile_native_lock(&mut self,native:&NativeTransferRelay)->Result<TransferProof> {
+        Ok(self.reconcile_native_lock_observed(native).await?.0)
+    }
+
+    /// Public confirmation depth only. Does not expose the private transaction
+    /// proof to presentation callers and never broadcasts a payment.
+    pub async fn reconcile_native_lock_confirmations(&mut self,native:&NativeTransferRelay)->Result<u64> {
+        Ok(self.reconcile_native_lock_observed(native).await?.1)
+    }
+
+    async fn reconcile_native_lock_observed(&mut self,native:&NativeTransferRelay)->Result<(TransferProof,u64)> {
+        let prepared=self.load_prepared_native_lock()?;
+        let (head,_,quote,_,_)=self.load()?;
+        self.checked_native_dispatch(&head)?;
+        ensure!(quote.terms()["xmzGenesis"]==self.policy.xmz_genesis
+            && quote.destinations().xmz_refund.network()==self.policy.xmz_network,
+            "native reconciliation deployment mismatch");
+        let minimum=quote.terms()["xmzConfirmations"].parse::<u64>()?.max(u64::from(self.policy.xmz_confirmations));
+        let depth=native.confirm_native_lock(&prepared,minimum).await?;
+        self.retain_native_receipt(&prepared)?;
+        Ok((prepared.proof().clone(),depth))
+    }
+}
