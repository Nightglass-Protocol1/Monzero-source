+        ensure!(self.chain().await? == tip, "Litecoin tip changed during lock reconciliation");
+        Ok(observation)
+    }
+
+    fn validate_intent(&self, intent: &Intent) -> Result<LockPreview> {
+        ensure!(intent.schema == "monzero-ltc-reservation-v1" && intent.genesis == self.network.genesis()
+            && intent.wallet == self.wallet && intent.anchor == self.anchor.to_string()
+            && intent.amount > 0 && intent.amount <= 84_000_000 * 100_000_000
+            && intent.maximum_fee > 0 && intent.maximum_fee < intent.amount,
+            "Litecoin reservation deployment or policy mismatch");
+        let contract = LtcSegwitAddress::parse(self.network, &intent.contract)?;
+        let change = LtcSegwitAddress::parse(self.network, &intent.change)?;
+        ensure!(contract.script_pubkey().is_p2wsh() && contract != change, "invalid Litecoin reservation destinations");
+        validate_preview(Funded { psbt: intent.psbt.clone(), fee: RawValue::from_string(coin_string(intent.fee))?,
+            changepos: {
+                let psbt = Psbt::from_str(&intent.psbt)?;
+                match psbt.unsigned_tx.output.iter().position(|o| o.script_pubkey == *change.script_pubkey()) {
+                    Some(n) => n as i32, None => -1,
+                }
+            } }, contract.script_pubkey(), change.script_pubkey(), Amount::from_sat(intent.amount), Amount::from_sat(intent.maximum_fee))
+    }
+
+    async fn locked_outpoints(&self) -> Result<Vec<OutPoint>> {
+        #[derive(Deserialize)] struct CoreOutpoint { txid: bitcoin::Txid, vout: u32 }
+        let values: Vec<CoreOutpoint> = serde_json::from_str(self.rpc(true, "listlockunspent", json!([])).await?.get())?;
+        Ok(values.into_iter().map(|v| OutPoint { txid:v.txid, vout:v.vout }).collect())
+    }
+
+    async fn restore_reservation(&self, journal: &Journal, intent: &Intent, preview: LockPreview) -> Result<ReservedLock> {
+        self.wallet_ready().await?;
+        self.owned_address(&LtcSegwitAddress::parse(self.network, &intent.change)?).await?;
+        let txid = preview.psbt.unsigned_tx.compute_txid();
+        let owner = format!("{}:{txid}", intent.trade);
+        let mut claims = Vec::new();
+        for input in &preview.psbt.unsigned_tx.input {
+            // Chain/outpoint scope deliberately excludes wallet and trade: a
+            // second wallet controlling the same coin must not obtain a claim.
+            let key = format!("{}:{}", intent.genesis, input.previous_output);
+            let name = format!("{:x}.input", Sha256::digest(key.as_bytes()));
+            journal.compatible(&name, owner.as_bytes())?;
+            claims.push(name);
+        }
+        let tip = self.chain().await?;
+        let mut outpoints = Vec::new();
+        for (input, metadata) in preview.psbt.unsigned_tx.input.iter().zip(&preview.psbt.inputs) {
+            let output = self.unspent(input.previous_output).await?.context("reserved Litecoin input is not confirmed unspent")?;
+            let expected = metadata.witness_utxo.as_ref().context("missing reserved Litecoin UTXO")?;
+            ensure!(output.tip == tip && output.amount == expected.value && output.script == expected.script_pubkey,
+                "reserved Litecoin input differs from chain");
+            self.owned_address(&LtcSegwitAddress::from_script(self.network, &output.script)?).await?;
+            // Confirmed view alone misses a conflicting mempool spend.
+            let current = self.rpc(false, "gettxout", json!([input.previous_output.txid.to_string(), input.previous_output.vout, true])).await?;
+            ensure!(current.get() != "null", "reserved Litecoin input has a mempool spend");
+            outpoints.push(json!({"txid":input.previous_output.txid.to_string(), "vout":input.previous_output.vout}));
+        }
+        ensure!(self.chain().await? == tip, "Litecoin tip changed during reservation");
+        for name in claims { journal.retain(&name, owner.as_bytes())?; }
+        let observed = self.locked_outpoints().await?;
+        let pending: Vec<_> = outpoints.into_iter().filter(|v| {
+            !observed.iter().any(|o| v["txid"] == o.txid.to_string() && v["vout"] == o.vout)
+        }).collect();
+        if !pending.is_empty() {
+            let locked: bool = serde_json::from_str(self.rpc(true, "lockunspent", json!([false, pending])).await?.get())?;
+            ensure!(locked, "Litecoin wallet rejected coin locks");
+        }
+        let observed = self.locked_outpoints().await?;
+        ensure!(preview.psbt.unsigned_tx.input.iter().all(|i| observed.contains(&i.previous_output)),
+            "Litecoin coin locks were not retained");
+        self.wallet_ready().await?;
+        Ok(ReservedLock { preview })
+    }
+}
