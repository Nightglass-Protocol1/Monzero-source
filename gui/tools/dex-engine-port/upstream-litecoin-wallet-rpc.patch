+//! Explicit native payout accounting; these signed values are not relay authority.
+use super::*;
+
+pub struct NativePayoutTerms {locked:u64,payout:u64,reserve:u64,claim_fee:u64,refund_fee:u64}
+impl NativePayoutTerms {
+    pub fn locked_atoms(&self)->u64 {self.locked}
+    pub fn payout_atoms(&self)->u64 {self.payout}
+    pub fn reserve_atoms(&self)->u64 {self.reserve}
+    pub fn claim_fee_max_atoms(&self)->u64 {self.claim_fee}
+    pub fn refund_fee_max_atoms(&self)->u64 {self.refund_fee}
+    /// Successful settlement pays the exact principal to xmzPayout and this
+    /// unused reserve to xmzRefund, in the same transaction. No app fee.
+    pub fn unused_reserve_atoms(&self,actual_fee:u64)->Result<u64> {
+        ensure!(actual_fee>0 && actual_fee<=self.claim_fee,"native claim fee exceeds signed ceiling");
+        self.reserve.checked_sub(actual_fee).ok_or_else(||anyhow::anyhow!("native claim reserve exhausted"))
+    }
+    /// Cancellation returns the locked amount less only its disclosed miner fee.
+    pub fn refund_atoms(&self,actual_fee:u64)->Result<u64> {
+        ensure!(actual_fee>0 && actual_fee<=self.refund_fee,"native refund fee exceeds signed ceiling");
+        self.locked.checked_sub(actual_fee).ok_or_else(||anyhow::anyhow!("native refund fee consumes lock"))
+    }
+}
+impl VerifiedLtcQuote {
+    /// V1 remains recoverable under its original lock terms; it does not acquire
+    /// new payout permission merely because a newer engine can read it.
+    pub fn native_payout_terms(&self)->Result<NativePayoutTerms> {
+        ensure!(self.terms["schema"]==PAYOUT_DOMAIN,"native payout requires explicit v2 signed terms");
+        let locked=number(&self.terms,"xmzAtoms")?;
+        let payout=number(&self.terms,"xmzPayoutAtoms")?;
+        let reserve=locked.checked_sub(payout).ok_or_else(||anyhow::anyhow!("native payout exceeds lock"))?;
+        let claim_fee=number(&self.terms,"xmzClaimFeeMaxAtoms")?;
+        let refund_fee=number(&self.terms,"xmzRefundFeeMaxAtoms")?;
+        ensure!(reserve>=claim_fee && reserve>=refund_fee,"native fee reserve is insufficient");
+        Ok(NativePayoutTerms {locked,payout,reserve,claim_fee,refund_fee})
+    }
+}
