+//! Validated journal presentation; never current chain or execution authority.
+use super::*;
+
+fn payment(prepared:bool,attempted:bool,acknowledged:bool)->serde_json::Value {
+    serde_json::json!({"prepared":prepared,"attempted":attempted,"acknowledged":acknowledged})
+}
+impl Execution {
+    /// Revalidate the cold checkpoint and every committed artifact before exposing
+    /// public presentation data. No wallet RPC, journal repairs or broadcasts.
+    pub fn saved_status(&self)->Result<serde_json::Value> {
+        let (head,_,quote,_,_)=self.load()?;
+        let recovery:std::collections::BTreeMap<_,_>=[recovery_relay::RecoverySpend::Cancel,
+            recovery_relay::RecoverySpend::Refund,recovery_relay::RecoverySpend::Punish].into_iter()
+            .filter(|kind|kind.allowed(self.claim.role))
+            .map(|kind|(kind.label(),serde_json::json!({"attempted":head.recovery_dispatch.contains_key(&kind),
+                "acknowledged":head.recovery_receipts.contains_key(&kind)}))).collect();
+        Ok(serde_json::json!({"schema":"monzero-ltc-journal-status-v1","tradeId":head.trade,
+            "quoteCommitment":hex(&head.quote),"role":if self.claim.role==0 {"litecoin-funder"} else {"native-funder"},
+            "ltcNetwork":quote.terms()["ltcNetwork"],"xmzGenesis":self.policy.xmz_genesis,
+            "ltcAtoms":quote.terms()["ltcAtoms"],"xmzAtoms":quote.terms()["xmzAtoms"],
+            "ltcPayout":quote.terms()["ltcPayout"],"ltcRefund":quote.terms()["ltcRefund"],
+            "xmzPayout":quote.terms()["xmzPayout"],"xmzRefund":quote.terms()["xmzRefund"],
+            "keysReady":head.step==2,"recoveryIntentRetained":head.recovery_intent.is_some(),
+            "nativeClaimRetained":head.native_claim.is_some(),"nativeRefundRetained":head.native_refund.is_some(),
+            "nativeFunding":payment(head.native_lock.is_some(),head.native_dispatch.is_some(),head.native_receipt.is_some()),
+            "litecoinRedemption":payment(head.redeem_completed.is_some(),head.redeem_dispatch.is_some(),head.redeem_receipt.is_some()),
+            "nativePayout":payment(head.native_payout.is_some(),head.native_payout_dispatch.is_some(),head.native_payout_receipt.is_some()),
+            "nativeRefundPayout":payment(head.native_refund_payout.is_some(),head.native_refund_payout_dispatch.is_some(),head.native_refund_payout_receipt.is_some()),
+            "litecoinRecovery":recovery,"journalValidated":true,"chainObserved":false,"executable":false}))
+    }
+}
