+/// State transitions require exclusive mutable access, so safe Rust cannot
+/// interleave competing commits through one shared controller instance.
+pub struct Execution {
+    metadata:Journal,snapshots:PathBuf,claim:Claim,policy:Policy,role:LocalRole,
+}
+fn role_number(role: LocalRole)->u8 { match role { LocalRole::LitecoinFunder=>0,LocalRole::NativeFunder=>1 } }
+fn claim_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-execution-claim") }
+fn head_name(trade:uuid::Uuid)->String { format!("{trade}.ltc-execution-head") }
+fn open_metadata(metadata:&Path,snapshots:&Path)->Result<Journal> {
+    let journal=Journal::open(metadata)?;
+    let a=std::fs::metadata(metadata)?;let b=std::fs::metadata(snapshots)?;
+    ensure!((a.dev(),a.ino())!=(b.dev(),b.ino()),"execution metadata and secret snapshots must be separate");
+    drop(Journal::open(snapshots)?);
+    Ok(journal)
+}
+impl Execution {
+    /// A failed begin may retain an attempt record. Never delete it to retry or
+    /// silently create replacement keys. A new trade requires a new consent/ID.
+    pub fn begin<R:rand::RngCore+rand::CryptoRng>(metadata:&Path,snapshots:&Path,
+        quote:&VerifiedLtcQuote,policy:&Policy,role:LocalRole,reviewed_commitment:&[u8;32],now:u64,rng:&mut R)->Result<Self> {
+        quote.check_policy(policy,now)?;
+        ensure!(quote.commitment()==reviewed_commitment,"Litecoin execution consent commitment mismatch");
+        let journal=open_metadata(metadata,snapshots)?;
+        let trade=quote.terms()["swapId"].parse()?;
+        match journal.read(&claim_name(trade)) {
+            Ok(_)=>anyhow::bail!("Litecoin execution already attempted; resume its retained state"),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+            Err(e)=>return Err(e),
+        }
+        let pin=|field:&str|->Result<[u8;32]> {
+            let text=&quote.terms()[field];
+            ensure!(text.len()==64 && text.is_ascii(),"invalid Litecoin quote identity");
+            let mut bytes=[0;32];for (i,byte) in bytes.iter_mut().enumerate() { *byte=u8::from_str_radix(&text[i*2..i*2+2],16)?; }
+            Ok(bytes)
+        };
+        let claim=Claim { schema:"monzero-ltc-execution-v1".into(),trade,quote:*reviewed_commitment,
+            role:role_number(role),pins:[pin("ltcFunder")?,pin("xmzFunder")?] };
+        journal.retain(&claim_name(trade),&serde_json::to_vec(&claim)?)?;
+        let (keys,_)=LocalKeys::generate(rng);
+        let exchange=KeyExchange::new(quote,policy,now,role,&keys)?;
+        let checkpoint=storage::persist(snapshots,quote,policy,role,&keys,&exchange)?;
+        let head=Head { schema:"monzero-ltc-execution-head-v1".into(),trade,quote:*reviewed_commitment,
+            checkpoint,step:0,outgoing_source:None,recovery_intent:None,native_proof:None,redeem_outgoing:None,native_lock_intent:None,native_lock:None,native_dispatch:None,native_receipt:None,redeem_completed:None,native_claim:None,native_payout_intent:None,native_payout:None,native_payout_dispatch:None,native_payout_receipt:None,redeem_dispatch:None,redeem_receipt:None,native_refund:None,native_refund_payout_intent:None,native_refund_payout:None,native_refund_payout_dispatch:None,native_refund_payout_receipt:None,recovery_dispatch:Default::default(),recovery_receipts:Default::default() };
+        journal.retain(&head_name(trade),&serde_json::to_vec(&head)?)?;
+        Ok(Self { metadata:journal,snapshots:snapshots.into(),claim,policy:policy.clone(),role })
+    }
+
+    /// Cold recovery is read-only until an explicit operation is requested.
+    /// The directory, trade, role and signer pins are caller-trusted context.
+    pub fn resume(metadata:&Path,snapshots:&Path,trade:uuid::Uuid,policy:&Policy,
+        role:LocalRole,pins:[[u8;32];2])->Result<Self> {
+        ensure!(!trade.is_nil(),"invalid Litecoin execution trade");
+        let journal=open_metadata(metadata,snapshots)?;
+        let bytes=journal.read(&claim_name(trade))?;
+        let claim:Claim=serde_json::from_slice(&bytes)?;
+        ensure!(claim.schema=="monzero-ltc-execution-v1" && claim.trade==trade && claim.role==role_number(role)
+            && claim.pins==pins && serde_json::to_vec(&claim)?==bytes,"Litecoin execution identity mismatch");
+        let execution=Self {metadata:journal,snapshots:snapshots.into(),claim,policy:policy.clone(),role};
+        execution.load()?;
+        Ok(execution)
+    }
+
+    fn load(&self)->Result<(Head,Vec<u8>,VerifiedLtcQuote,LocalKeys,KeyExchange)> {
+        let bytes=self.metadata.read(&head_name(self.claim.trade))?;
+        let head:Head=serde_json::from_slice(&bytes)?;
+        ensure!(head.schema=="monzero-ltc-execution-head-v1" && head.trade==self.claim.trade
+            && head.quote==self.claim.quote && head.step<=2 && serde_json::to_vec(&head)?==bytes,
+            "invalid Litecoin execution head");
+        if let Some(expected)=head.recovery_intent {
+            ensure!(head.step==2,"recovery intent precedes completed keys");
+            let retained=self.metadata.read(&format!("{}.ltc-recovery-intent",self.claim.trade))?;
+            let actual:[u8;32]=Sha256::digest(&retained).into();
+            ensure!(actual==expected,"missing or altered committed recovery intent");
+        }
+        if let Some(expected)=head.native_proof {
+            ensure!(self.claim.role==0 && head.step==2 && head.recovery_intent.is_some(),
+                "native proof precedes recovery agreement");
+            let retained=zeroize::Zeroizing::new(Journal::open(&self.snapshots)?
+                .read(&native_funding::proof_name(self.claim.trade))?);
+            let actual:[u8;32]=Sha256::digest(&*retained).into();
+            ensure!(actual==expected,"missing or altered committed native proof");
+        }
+        if let Some(expected)=head.native_lock_intent {
+            ensure!(self.claim.role==1 && head.step==2 && head.recovery_intent.is_some(),
+                "native lock intent precedes recovery agreement");
+            let retained=self.metadata.read(&lock_funding::intent_name(self.claim.trade))?;
+            ensure!(<[u8;32]>::from(Sha256::digest(&retained))==expected,"missing or altered native lock intent");
+        }
+        if let Some(expected)=head.native_lock {
+            ensure!(head.native_lock_intent.is_some(),"native lock lacks funding intent");
+            let retained=zeroize::Zeroizing::new(Journal::open(&self.snapshots)?
