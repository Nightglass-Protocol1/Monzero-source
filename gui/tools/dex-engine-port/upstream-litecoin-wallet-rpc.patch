+//! Authenticated RPC for caller-owned loopback Litecoin Core services.
+//! Unsigned funding previews, durable reservations and UTXO observations.
+//! Recovery-gated durable signing and explicit journaled relay are available;
+//! no automatic broadcast retries. Callers must hold
+//! exclusive wallet ownership and persist execution intent before adding a
+//! funding/signing path. A preview is not a durable input lease or trade approval.
+//! The caller must authenticate the local service before supplying credentials;
+//! chain identity checks cannot authenticate the process listening on the port.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{Amount, BlockHash, OutPoint, ScriptBuf, psbt::Psbt};
+use serde::Deserialize;
+use serde_json::{Value, json, value::RawValue};
+use std::{collections::HashSet, str::FromStr, sync::atomic::{AtomicU64, Ordering}};
+use swap_core::litecoin_address::{LtcNetwork, LtcSegwitAddress};
+use zeroize::Zeroizing;
+
+pub struct LitecoinRpc {
+    client: reqwest::Client,
+    port: u16,
+    username: Zeroizing<String>,
+    password: Zeroizing<String>,
+    network: LtcNetwork,
+    wallet: String,
+    anchor: LtcSegwitAddress,
+    request_id: AtomicU64,
+}
+
+/// Contains wallet transaction data; deliberately not Debug or Serialize.
+pub struct LockPreview { pub psbt: Psbt, pub fee: Amount, change: ScriptBuf }
+
+pub struct ObservedOutput {
+    pub tip: BlockHash,
+    pub confirmations: u64,
+    pub amount: Amount,
+    pub script: ScriptBuf,
+}
+
+/// Evidence from the configured Litecoin node, never deserializable peer input.
+pub struct VerifiedLiveLock { network:LtcNetwork,outpoint:OutPoint,observed:ObservedOutput }
+impl VerifiedLiveLock {
+    pub fn network(&self)->LtcNetwork { self.network }
+    pub fn outpoint(&self)->OutPoint { self.outpoint }
+    pub fn observation(&self)->&ObservedOutput { &self.observed }
+}
+
+fn validate_live_lock(observed:&ObservedOutput,script:&ScriptBuf,amount:Amount,
+    confirmations:u64,cancel_blocks:u32,safety_blocks:u32)->Result<()> {
+    ensure!(confirmations>0 && safety_blocks>0 && cancel_blocks<=0xffff
+        && confirmations.checked_add(u64::from(safety_blocks)).is_some_and(|d|d<u64::from(cancel_blocks)),
+        "invalid Litecoin confirmation or cancellation safety policy");
+    ensure!(observed.script==*script && observed.amount==amount,"live Litecoin lock differs from agreement");
+    ensure!(observed.confirmations>=confirmations
+        && observed.confirmations.checked_add(u64::from(safety_blocks)).is_some_and(|d|d<u64::from(cancel_blocks)),
+        "Litecoin lock is shallow or too close to cancellation");
+    Ok(())
+}
+
+#[derive(Deserialize)]
+struct Envelope { id: u64, error: Option<Value>, result: Box<RawValue> }
+#[derive(Deserialize)]
+struct ChainInfo {
+    chain: String,
+    bestblockhash: BlockHash,
+    initialblockdownload: bool,
+    softforks: Value,
+}
+#[derive(Deserialize)]
+struct Funded { psbt: String, fee: Box<RawValue>, changepos: i32 }
+
+impl LitecoinRpc {
+    pub fn new(port: u16, username: String, password: String, network: LtcNetwork,
+        wallet: String, anchor: LtcSegwitAddress) -> Result<Self> {
+        let username = Zeroizing::new(username);
+        let password = Zeroizing::new(password);
+        ensure!(port != 0 && !username.is_empty() && !password.is_empty()
+            && username.len() + password.len() <= 1024 && !username.contains(':'), "invalid Litecoin RPC credentials or port");
+        ensure!(!wallet.is_empty() && wallet.len() <= 64
+            && wallet.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'),
+            "invalid Litecoin wallet name");
+        ensure!(anchor.network() == network, "wrong Litecoin wallet anchor network");
+        // Proof verification can occupy the caller between RPCs longer than
+        // Core keeps idle HTTP connections alive. Open a fresh connection for
+        // each request; never retry an ambiguous wallet mutation automatically.
+        Ok(Self { client: reqwest::Client::builder().no_proxy().pool_max_idle_per_host(0)
+            .redirect(reqwest::redirect::Policy::none()).timeout(std::time::Duration::from_secs(15)).build()?,
+            port, username, password, network, wallet, anchor, request_id: AtomicU64::new(0) })
+    }
+
+    async fn rpc(&self, wallet: bool, method: &str, params: Value) -> Result<Box<RawValue>> {
+        self.rpc_lookup(wallet, method, params, false).await?.context("missing required Litecoin RPC result")
+    }
+
+    async fn rpc_lookup(&self, wallet: bool, method: &str, params: Value, missing_allowed: bool) -> Result<Option<Box<RawValue>>> {
+        ensure!(!missing_allowed || matches!(method, "gettransaction" | "getmempoolentry"), "invalid optional Litecoin RPC method");
+        let id = self.request_id.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+            |v| v.checked_add(1)).map_err(|_| anyhow::anyhow!("RPC identity exhausted"))?;
+        let endpoint = if wallet { format!("/wallet/{}", self.wallet) } else { String::new() };
+        let mut response = self.client.post(format!("http://127.0.0.1:{}{}", self.port, endpoint))
+            .basic_auth(self.username.as_str(), Some(self.password.as_str()))
+            .json(&json!({"jsonrpc":"1.0", "id":id, "method":method, "params":params}))
+            .send().await.map_err(|error| anyhow::anyhow!(
+                "Litecoin local RPC transport failed (timeout={}, connect={}, request={}, body={})",
+                error.is_timeout(),error.is_connect(),error.is_request(),error.is_body()))?;
+        let status = response.status();
+        ensure!(status.is_success() || (missing_allowed && status.as_u16() == 500), "Litecoin local RPC HTTP rejection");
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| anyhow::anyhow!("Litecoin RPC body failed"))? {
+            ensure!(bytes.len() + chunk.len() <= 2_000_000, "oversized Litecoin RPC response");
+            bytes.extend_from_slice(&chunk);
+        }
+        let reply: Envelope = serde_json::from_slice(&bytes).context("invalid Litecoin RPC envelope")?;
+        ensure!(reply.id == id, "Litecoin RPC rejection or identity mismatch");
+        if missing_allowed && status.as_u16() == 500 && reply.error.as_ref().is_some_and(|e| e["code"].as_i64() == Some(-5)
+            && e["message"].is_string()) && reply.result.get() == "null" {
+            return Ok(None);
+        }
+        ensure!(status.is_success() && reply.error.is_none(), "Litecoin RPC rejection or identity mismatch");
+        Ok(Some(reply.result))
+    }
+
+    async fn chain(&self) -> Result<BlockHash> {
+        let info: ChainInfo = serde_json::from_str(self.rpc(false, "getblockchaininfo", json!([])).await?.get())?;
+        let genesis: String = serde_json::from_str(self.rpc(false, "getblockhash", json!([0])).await?.get())?;
+        self.network.verify_chain(&info.chain, &genesis)?;
+        ensure!(!info.initialblockdownload && info.softforks["csv"]["active"] == true
+            && info.softforks["segwit"]["active"] == true, "Litecoin chain not ready for contract settlement");
+        Ok(info.bestblockhash)
+    }
+
+    async fn owned_address(&self, address: &LtcSegwitAddress) -> Result<()> {
+        ensure!(address.network() == self.network, "wrong Litecoin destination network");
+        let value: Value = serde_json::from_str(self.rpc(true, "getaddressinfo", json!([address.to_string()])).await?.get())?;
+        ensure!(value["ismine"] == true && value["iswatchonly"] == false
+            && value["scriptPubKey"].as_str() == Some(address.script_pubkey().to_hex_string().as_str()),
+            "Litecoin address is not owned by the expected wallet");
+        Ok(())
+    }
+
+    async fn wallet_ready(&self) -> Result<()> {
+        self.chain().await?;
+        let value: Value = serde_json::from_str(self.rpc(true, "getwalletinfo", json!([])).await?.get())?;
+        ensure!(value["walletname"].as_str() == Some(self.wallet.as_str())
+            && value["private_keys_enabled"] == true && value["scanning"] == false,
+            "unexpected or unready Litecoin wallet");
+        self.owned_address(&self.anchor).await
+    }
+
+    /// Construct an unsigned PSBT. Allocates a fresh wallet change address.
+    /// Does not lock coins, sign, or broadcast.
+    /// The caller binds the supplied P2WSH contract address to negotiated keys.
+    pub async fn preview_lock(&self, contract: &LtcSegwitAddress, amount: Amount,
+        fee_rate_atoms_per_kb: u64, maximum_fee: Amount) -> Result<LockPreview> {
+        ensure!(contract.network() == self.network && contract.script_pubkey().is_p2wsh(),
+            "wrong Litecoin contract network or script");
+        ensure!(amount.to_sat() > 0 && amount.to_sat() <= 84_000_000 * 100_000_000
+            && maximum_fee > Amount::ZERO && maximum_fee < amount && fee_rate_atoms_per_kb > 0,
+            "invalid Litecoin amount or fee policy");
+        self.wallet_ready().await?;
+        let change: String = serde_json::from_str(self.rpc(true, "getrawchangeaddress", json!(["bech32"])).await?.get())?;
+        let change = LtcSegwitAddress::parse(self.network, &change)?;
+        ensure!(change != *contract, "change pays shared contract");
+        self.owned_address(&change).await?;
+        let mut output = serde_json::Map::new();
+        output.insert(contract.to_string(), Value::String(coin_string(amount.to_sat())));
+        let raw = self.rpc(true, "walletcreatefundedpsbt", json!([[], [output], 0, {
+            "changeAddress":change.to_string(), "lockUnspents":false, "includeWatching":false, "replaceable":false,
+            "feeRate":coin_string(fee_rate_atoms_per_kb)
+        }, false])).await?;
+        let funded: Funded = serde_json::from_str(raw.get())?;
+        let preview = validate_preview(funded, contract.script_pubkey(), change.script_pubkey(), amount, maximum_fee)?;
+        // Wallet or deployment changes during construction invalidate this preview.
+        self.wallet_ready().await?;
+        Ok(preview)
+    }
+
+    /// Confirmed-chain UTXO view, excluding mempool transactions.
+    /// None does not identify the spending transaction or prove a refund.
+    /// A returned output may already have an unconfirmed competing spend.
+    pub async fn unspent(&self, outpoint: OutPoint) -> Result<Option<ObservedOutput>> {
+        self.observe_unspent(outpoint,false).await
+    }
+
+    /// Point-in-time lock evidence including pending spends. The explicit
+    /// safety margin reserves blocks before CSV cancellation becomes possible.
+    /// Reobserve after delays; this is not a transaction relay permit.
+    pub async fn verify_live_lock(&self,outpoint:OutPoint,script:&ScriptBuf,amount:Amount,
+        confirmations:u64,cancel_blocks:u32,safety_blocks:u32)->Result<VerifiedLiveLock> {
+        ensure!(!outpoint.is_null() && script.is_p2wsh() && amount>Amount::ZERO,
+            "invalid Litecoin lock expectation");
+        let observed=self.observe_unspent(outpoint,true).await?.context("Litecoin lock absent or spent")?;
+        validate_live_lock(&observed,script,amount,confirmations,cancel_blocks,safety_blocks)?;
+        Ok(VerifiedLiveLock { network:self.network,outpoint,observed })
+    }
+
+    async fn observe_unspent(&self,outpoint:OutPoint,include_mempool:bool)->Result<Option<ObservedOutput>> {
+        let tip = self.chain().await?;
+        let raw = self.rpc(false, "gettxout", json!([outpoint.txid.to_string(), outpoint.vout, include_mempool])).await?;
+        ensure!(self.chain().await? == tip, "Litecoin tip changed during observation");
+        if raw.get() == "null" { return Ok(None); }
+        #[derive(Deserialize)]
+        struct Script { hex: String }
+        #[derive(Deserialize)]
+        struct Output { bestblock: BlockHash, confirmations: u64, value: Box<RawValue>,
+            #[serde(rename="scriptPubKey")] script: Script }
+        let output: Output = serde_json::from_str(raw.get())?;
+        ensure!(output.bestblock == tip && output.confirmations > 0, "stale Litecoin output observation");
+        Ok(Some(ObservedOutput { tip, confirmations: output.confirmations,
+            amount: Amount::from_sat(decimal_atoms(output.value.get())?), script: ScriptBuf::from_hex(&output.script.hex)? }))
+    }
+}
+
+fn coin_string(atoms: u64) -> String { format!("{}.{:08}", atoms / 100_000_000, atoms % 100_000_000) }
+
+/// Core emits fixed-point JSON coin amounts. No binary floating-point conversion.
+fn decimal_atoms(raw: &str) -> Result<u64> {
+    let (whole, fraction) = raw.split_once('.').unwrap_or((raw, ""));
+    ensure!(!whole.is_empty() && whole.bytes().all(|b| b.is_ascii_digit())
+        && fraction.len() <= 8 && fraction.bytes().all(|b| b.is_ascii_digit())
+        && (!raw.contains('.') || !fraction.is_empty()), "invalid exact Litecoin amount");
+    let whole: u64 = whole.parse()?;
+    let fraction: u64 = if fraction.is_empty() { 0 } else { fraction.parse()? };
+    whole.checked_mul(100_000_000).and_then(|n| n.checked_add(fraction * 10u64.pow(8 - raw.split_once('.').map_or(0, |(_, f)| f.len()) as u32)))
+        .context("Litecoin amount overflow")
+}
+
+fn validate_preview(funded: Funded, contract: &ScriptBuf, change: &ScriptBuf,
+    amount: Amount, maximum_fee: Amount) -> Result<LockPreview> {
+    let psbt = Psbt::from_str(&funded.psbt).context("invalid Litecoin funding PSBT")?;
+    let tx = &psbt.unsigned_tx;
+    ensure!(!tx.input.is_empty() && psbt.inputs.len() == tx.input.len()
+        && (tx.output.len() == 1 || tx.output.len() == 2), "unexpected Litecoin funding shape");
+    ensure!(tx.version == bitcoin::transaction::Version::TWO && tx.lock_time == bitcoin::absolute::LockTime::ZERO,
+        "unexpected Litecoin funding version or lock time");
+    let mut seen = HashSet::new();
+    for (input, metadata) in tx.input.iter().zip(&psbt.inputs) {
+        ensure!(!input.sequence.is_rbf() && seen.insert(input.previous_output) && input.script_sig.is_empty()
+            && input.witness.is_empty() && metadata.redeem_script.is_none()
+            && metadata.final_script_sig.is_none() && metadata.final_script_witness.is_none()
+            && metadata.partial_sigs.is_empty() && metadata.tap_key_sig.is_none()
+            && metadata.tap_script_sigs.is_empty(), "unstable, duplicate or signed Litecoin funding input");
+        let utxo = metadata.witness_utxo.as_ref().context("missing Litecoin witness UTXO")?;
+        ensure!(utxo.script_pubkey.is_p2wpkh() || utxo.script_pubkey.is_p2wsh() || utxo.script_pubkey.is_p2tr(),
+            "Litecoin funding requires native SegWit inputs");
+        if let Some(previous) = &metadata.non_witness_utxo {
+            ensure!(previous.compute_txid() == input.previous_output.txid
+                && previous.output.get(input.previous_output.vout as usize) == Some(utxo), "inconsistent Litecoin funding UTXO");
+        }
+    }
+    let locks: Vec<_> = tx.output.iter().enumerate().filter(|(_, o)| &o.script_pubkey == contract).collect();
+    ensure!(locks.len() == 1 && locks[0].1.value == amount, "wrong Litecoin lock principal or script");
+    if tx.output.len() == 1 {
+        ensure!(funded.changepos == -1, "unexpected Litecoin change position");
+    } else {
+        ensure!(funded.changepos >= 0 && funded.changepos < 2
+            && funded.changepos as usize != locks[0].0, "invalid Litecoin change position");
+        let change_output = &tx.output[funded.changepos as usize];
+        ensure!(&change_output.script_pubkey == change && change_output.value > Amount::ZERO,
+            "unexpected Litecoin change destination");
+    }
+    let fee = psbt.fee().context("invalid Litecoin funding accounting")?;
+    ensure!(fee > Amount::ZERO && fee <= maximum_fee
+        && fee.to_sat() == decimal_atoms(funded.fee.get())?, "Litecoin funding fee exceeds policy or disagrees with PSBT");
+    Ok(LockPreview { psbt, fee, change: change.clone() })
+}
