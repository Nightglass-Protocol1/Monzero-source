+//! LTC/XMZ commercial terms with independent role signatures and caller-pinned
+//! deployments. This is neither user approval nor proof of protocol negotiation.
+use anyhow::{Result, ensure};
+use ed25519_dalek::{Signature, VerifyingKey};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use swap_core::{litecoin_address::{LtcNetwork, LtcSegwitAddress}, xmz_address::{XmzAddress, XmzNetwork}};
+
+pub const DOMAIN: &str = "monzero-native-ltc-xmz-quote-v1";
+pub const PAYOUT_DOMAIN: &str = "monzero-native-ltc-xmz-quote-v2";
+const PAYOUT_FIELDS:&[&str]=&["xmzPayoutAtoms","xmzClaimFeeMaxAtoms","xmzRefundFeeMaxAtoms"];
+pub mod payout;
+pub mod envelope;
+const FIELDS: &[&str] = &[
+    "schema", "quoteId", "swapId", "ltcFunder", "xmzFunder", "ltcGenesis", "xmzGenesis",
+    "ltcNetwork", "xmzNetwork", "ltcAtoms", "xmzAtoms", "ltcPayout", "ltcRefund", "xmzPayout", "xmzRefund",
+    "ltcFundingFeeMaxAtoms", "xmzNativeFeeMaxAtoms", "ltcCancelFeeAtoms", "ltcRefundFeeAtoms",
+    "ltcRedeemFeeAtoms", "ltcPunishFeeAtoms", "ltcEarlyRefundFeeAtoms", "ltcConfirmations", "xmzConfirmations", "cancelBlocks",
+    "punishBlocks", "expiresAt", "appFeeXmzAtoms", "ltcMinimumOutputAtoms", "ltcMinimumRelayFeeAtomsPerKb",
+];
+
+/// Operator configuration; never infer it from a peer's proposed quote.
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Policy {
+    #[serde(with="policy_ltc_network")]
+    pub ltc_network: LtcNetwork,
+    #[serde(with="policy_xmz_network")]
+    pub xmz_network: XmzNetwork, pub xmz_genesis: String,
+    pub ltc_confirmations: u32, pub xmz_confirmations: u32, pub cancel_blocks: u32, pub punish_blocks: u32,
+    pub maximum_ltc_atoms: u64, pub maximum_xmz_atoms: u64,
+    pub maximum_ltc_funding_fee: u64, pub maximum_ltc_recovery_fee: u64, pub maximum_xmz_fee: u64,
+    pub minimum_ltc_output: u64, pub minimum_relay_fee_atoms_per_kb: u64,
+}
+
+pub struct Destinations {
+    pub ltc_payout: LtcSegwitAddress, pub ltc_refund: LtcSegwitAddress,
+    pub xmz_payout: XmzAddress, pub xmz_refund: XmzAddress,
+}
+
+pub struct VerifiedLtcQuote { terms: BTreeMap<String,String>, commitment: [u8;32], destinations: Destinations,
+    ltc_signature: Vec<u8>, xmz_signature: Vec<u8> }
+
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+fn hash(value: &str) -> bool {
+    value.len() == 64 && value != "0".repeat(64)
+        && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn number(terms: &BTreeMap<String,String>, field: &str) -> Result<u64> {
+    let text = terms.get(field).ok_or_else(|| anyhow::anyhow!("missing Litecoin quote field"))?;
+    let value: u64 = text.parse()?;
+    ensure!(value > 0 && value.to_string() == *text, "noncanonical positive Litecoin quote amount");
+    Ok(value)
+}
+
+/// Role separation is independent of BTC quote and negotiation domains.
+pub fn signing_bytes(payload: &[u8], ltc_funder: bool) -> Result<Vec<u8>> {
+    signing_bytes_for(payload,ltc_funder,DOMAIN)
+}
+/// Separate signature domain for explicit native payout/reserve terms.
+pub fn payout_signing_bytes(payload:&[u8],ltc_funder:bool)->Result<Vec<u8>> {
+    signing_bytes_for(payload,ltc_funder,PAYOUT_DOMAIN)
+}
+fn signing_bytes_for(payload:&[u8],ltc_funder:bool,version:&str)->Result<Vec<u8>> {
+    ensure!(!payload.is_empty() && payload.len() <= 8192, "invalid Litecoin quote length");
+    let role = if ltc_funder { "ltc-funder" } else { "xmz-funder" };
+    let domain = format!("{version}-{role}");
+    let mut bytes = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:", domain.len(), domain, payload.len()).into_bytes();
+    bytes.extend_from_slice(payload);
+    Ok(bytes)
+}
+
+impl VerifiedLtcQuote {
+    pub fn verify(payload: &[u8], now: u64, policy: &Policy, ltc_pin: &[u8;32], xmz_pin: &[u8;32],
+        ltc_signature: &[u8], xmz_signature: &[u8]) -> Result<Self> {
+        ensure!(!payload.is_empty() && payload.len() <= 8192 && ltc_pin != xmz_pin, "invalid Litecoin quote context");
+        let value: serde_json::Value = serde_json::from_slice(payload)?;
+        ensure!(serde_json::to_vec(&value)? == payload, "noncanonical Litecoin signed quote");
+        let terms: BTreeMap<String,String> = serde_json::from_value(value)?;
+        ensure!(serde_json::to_vec(&terms)? == payload, "unsorted Litecoin quote keys");
+        let domain=match terms.get("schema").map(String::as_str) {
+            Some(DOMAIN)=>DOMAIN,Some(PAYOUT_DOMAIN)=>PAYOUT_DOMAIN,
+            _=>anyhow::bail!("unsupported Litecoin quote schema"),
+        };
+        let extra=if domain==PAYOUT_DOMAIN {PAYOUT_FIELDS} else {&[]};
+        ensure!(terms.len()==FIELDS.len()+extra.len() && FIELDS.iter().chain(extra).all(|f|terms.contains_key(*f)),
+            "unexpected Litecoin quote fields");
+        ensure!(terms["ltcFunder"] == hex(ltc_pin)
+            && terms["xmzFunder"] == hex(xmz_pin), "wrong Litecoin quote signing identity");
+        VerifyingKey::from_bytes(ltc_pin)?.verify_strict(&signing_bytes_for(payload, true,domain)?, &Signature::from_slice(ltc_signature)?)?;
+        VerifyingKey::from_bytes(xmz_pin)?.verify_strict(&signing_bytes_for(payload, false,domain)?, &Signature::from_slice(xmz_signature)?)?;
+        for field in ["quoteId", "swapId"] {
+            let id: uuid::Uuid = terms[field].parse()?;
+            ensure!(!id.is_nil() && id.to_string() == terms[field], "invalid Litecoin quote identifier");
+        }
+        ensure!(terms["appFeeXmzAtoms"] == "0", "unsupported Litecoin application fee");
+        let destinations = Destinations {
+            ltc_payout:LtcSegwitAddress::parse(policy.ltc_network, &terms["ltcPayout"] )?,
+            ltc_refund:LtcSegwitAddress::parse(policy.ltc_network, &terms["ltcRefund"] )?,
+            xmz_payout:XmzAddress::parse(policy.xmz_network, &terms["xmzPayout"] )?,
+            xmz_refund:XmzAddress::parse(policy.xmz_network, &terms["xmzRefund"] )?,
+        };
+        let mut digest = Sha256::new(); digest.update(domain); digest.update([0]); digest.update(payload);
+        let quote = Self { terms, commitment:digest.finalize().into(), destinations,
+            ltc_signature:ltc_signature.to_vec(), xmz_signature:xmz_signature.to_vec() };
+        quote.check_policy(policy, now)?;
+        Ok(quote)
+    }
+
+    pub fn check_policy(&self, policy: &Policy, now: u64) -> Result<()> {
+        let ltc = match policy.ltc_network { LtcNetwork::Mainnet => "ltc-mainnet", LtcNetwork::Testnet => "ltc-testnet", LtcNetwork::Regtest => "ltc-regtest" };
+        let xmz = match policy.xmz_network { XmzNetwork::Mainnet => "xmz-mainnet", XmzNetwork::Testnet => "xmz-testnet", XmzNetwork::Stagenet => "xmz-stagenet" };
+        ensure!(hash(&policy.xmz_genesis) && self.terms["ltcGenesis"] == policy.ltc_network.genesis()
+            && self.terms["xmzGenesis"] == policy.xmz_genesis && self.terms["ltcGenesis"] != self.terms["xmzGenesis"]
+            && self.terms["ltcNetwork"] == ltc && self.terms["xmzNetwork"] == xmz, "Litecoin quote deployment mismatch");
+        let n = |field| number(&self.terms, field);
+        let expiry = n("expiresAt")?;
+        ensure!(expiry > now && expiry - now <= 3600, "Litecoin quote outside validity window");
+        if self.terms["schema"]==PAYOUT_DOMAIN {
+            let payout=self.native_payout_terms()?;
+            ensure!(payout.claim_fee_max_atoms()<=policy.maximum_xmz_fee
+                && payout.refund_fee_max_atoms()<=policy.maximum_xmz_fee,"native settlement fee exceeds policy");
+        }
+        let principal = n("ltcAtoms")?;
+        ensure!(principal <= 84_000_000 * 100_000_000 && principal <= policy.maximum_ltc_atoms
+            && n("xmzAtoms")? <= policy.maximum_xmz_atoms, "Litecoin quote principal exceeds policy");
+        ensure!(n("ltcFundingFeeMaxAtoms")? <= policy.maximum_ltc_funding_fee
+            && n("ltcFundingFeeMaxAtoms")? < principal && n("xmzNativeFeeMaxAtoms")? <= policy.maximum_xmz_fee,
+            "Litecoin quote funding fee exceeds policy");
+        for (field, expected) in [("ltcConfirmations",u64::from(policy.ltc_confirmations)), ("xmzConfirmations",u64::from(policy.xmz_confirmations)),
+            ("cancelBlocks",u64::from(policy.cancel_blocks)), ("punishBlocks",u64::from(policy.punish_blocks)),
+            ("ltcMinimumOutputAtoms",policy.minimum_ltc_output), ("ltcMinimumRelayFeeAtomsPerKb",policy.minimum_relay_fee_atoms_per_kb)] {
+            ensure!(n(field)? == expected, "Litecoin quote consensus or fee policy mismatch");
+        }
+        ensure!(policy.ltc_confirmations <= 1000 && policy.xmz_confirmations <= 1000
+            && policy.cancel_blocks > policy.ltc_confirmations && policy.cancel_blocks <= 65535
+            && policy.punish_blocks > policy.ltc_confirmations && policy.punish_blocks <= 65535,
+            "invalid Litecoin confirmation or timeout policy");
+        let cancel = n("ltcCancelFeeAtoms")?;
+        for field in ["ltcCancelFeeAtoms", "ltcRefundFeeAtoms", "ltcRedeemFeeAtoms", "ltcPunishFeeAtoms", "ltcEarlyRefundFeeAtoms"] {
+            let fee = n(field)?;
+            // All current recovery paths have one shared P2WSH input and one
+            // native witness output. 256 vbytes conservatively covers this shape
+            // with maximum-length DER signatures and the largest allowed output.
+            let floor = (u128::from(policy.minimum_relay_fee_atoms_per_kb) * 256).div_ceil(1000);
+            ensure!(fee <= policy.maximum_ltc_recovery_fee && u128::from(fee) >= floor,
+                "Litecoin recovery fee outside deployment policy");
+            let total = if matches!(field, "ltcRefundFeeAtoms" | "ltcPunishFeeAtoms") { fee.checked_add(cancel) } else { Some(fee) };
+            ensure!(total.and_then(|f| principal.checked_sub(f)).is_some_and(|v| v >= policy.minimum_ltc_output),
+                "Litecoin recovery fees consume principal or output floor");
+        }
+        Ok(())
+    }
+
+    pub(crate) fn record(&self) -> Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-quote-record-v1",
+            "commitment":hex(&self.commitment),"terms":self.terms,
+            "ltcSignature":hex(&self.ltc_signature),"xmzSignature":hex(&self.xmz_signature)}))?)
+    }
+
+    /// Revalidate historical signed terms against caller-pinned identities and
+    /// the committed admission context. New funding must still check real time.
+    pub(crate) fn restore_record(bytes: &[u8], policy: &Policy, admitted_at: u64,
+        ltc_pin: &[u8;32], xmz_pin: &[u8;32], expected_commitment: &[u8;32]) -> Result<Self> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields,rename_all="camelCase")]
+        struct Record { schema:String,commitment:String,terms:BTreeMap<String,String>,ltc_signature:String,xmz_signature:String }
+        ensure!(!bytes.is_empty() && bytes.len()<=16_384,"invalid retained Litecoin quote size");
+        let record: Record=serde_json::from_slice(bytes)?;
+        ensure!(record.schema=="monzero-ltc-quote-record-v1" && record.commitment==hex(expected_commitment),
+            "retained Litecoin quote context mismatch");
+        let signature=|text: &str| -> Result<Vec<u8>> {
+            ensure!(text.len()==128 && text.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+                "invalid retained Litecoin quote signature");
+            (0..64).map(|i|Ok(u8::from_str_radix(&text[i*2..i*2+2],16)?)).collect()
+        };
+        let quote=Self::verify(&serde_json::to_vec(&record.terms)?,admitted_at,policy,ltc_pin,xmz_pin,
+            &signature(&record.ltc_signature)?,&signature(&record.xmz_signature)?)?;
+        ensure!(quote.commitment()==expected_commitment && quote.record()?==bytes,
+            "noncanonical or altered retained Litecoin quote");
+        Ok(quote)
+    }
+
+    pub fn terms(&self) -> &BTreeMap<String,String> { &self.terms }
+    pub fn commitment(&self) -> &[u8;32] { &self.commitment }
+    pub fn destinations(&self) -> &Destinations { &self.destinations }
+
+    /// Binds the wallet preparation to signed commercial terms, but does not
+    /// authenticate contract keys or prove completed cross-curve negotiation.
+    pub fn check_funding(&self, policy: &Policy, now: u64, trade: uuid::Uuid, principal: u64, fee_cap: u64) -> Result<()> {
+        self.check_policy(policy, now)?;
+        ensure!(trade.to_string() == self.terms["swapId"] && principal == number(&self.terms, "ltcAtoms")?
+            && fee_cap > 0 && fee_cap <= number(&self.terms, "ltcFundingFeeMaxAtoms")?, "funding differs from signed Litecoin quote");
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    pub fn recovery_policy(&self, policy: &Policy, now: u64, key_a: String, key_b: String)
+        -> Result<crate::litecoin_rpc::reservation::RecoveryPolicy> {
+        self.check_policy(policy, now)?;
+        Ok(crate::litecoin_rpc::reservation::RecoveryPolicy { key_a, key_b,
+            refund_address:self.destinations.ltc_refund.to_string(), cancel_blocks:policy.cancel_blocks,
+            cancel_fee:number(&self.terms,"ltcCancelFeeAtoms")?, refund_fee:number(&self.terms,"ltcRefundFeeAtoms")?,
+            minimum_relay_fee_atoms_per_kb:policy.minimum_relay_fee_atoms_per_kb, minimum_output_atoms:policy.minimum_ltc_output })
+    }
+}
+
