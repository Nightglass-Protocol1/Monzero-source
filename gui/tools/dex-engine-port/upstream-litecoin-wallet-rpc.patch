+//! Explicit native-UI consent bound to one retained payout payment and action.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::relay::{NativeTransferRelay,RelayedTransfer}};
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum PayoutAction { Send, Retransmit }
+impl PayoutAction {
+    fn label(self)->&'static str {match self {Self::Send=>"send",Self::Retransmit=>"retransmit"}}
+}
+/// Public review only. This token does not authenticate a user gesture by itself;
+/// the GUI must present the review and obtain deliberate approval for this action.
+pub struct PayoutReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+fn commitment(details:&serde_json::Value)->Result<[u8;32]> {
+    let mut digest=Sha256::new();
+    digest.update(b"MONZERO-LTC-NATIVE-PAYOUT-APPROVAL-V1\0");
+    digest.update(serde_json::to_vec(details)?);
+    Ok(digest.finalize().into())
+}
+impl Execution {
+    /// Recover and bind existing preparation; never construct a new payment or
+    /// broadcast. May finish publication of a retained preparation after a crash.
+    pub fn review_native_payout_payment(&mut self,action:PayoutAction)->Result<PayoutReview> {
+        let prepared=self.load_prepared_native_payout()?;
+        let (head,bytes,_,_,_)=self.load()?;
+        let dispatch=match action {
+            PayoutAction::Send=>{
+                ensure!(head.native_payout_dispatch.is_none(),"payout already attempted; explicit retransmission review required");
+                match self.metadata.read(&super::payout_relay::dispatch_name(self.claim.trade)) {
+                    Ok(_)=>anyhow::bail!("retained payout attempt requires explicit retransmission review"),
+                    Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                    Err(e)=>return Err(e),
+                }
+                None
+            },
+            PayoutAction::Retransmit=>Some(self.checked_payout_dispatch(&head)?),
+        };
+        let terms=prepared.terms();
+        // Principal and unused reserve can have distinct destinations. Approval
+        // binds both independently, including a zero reserve-return amount.
+        let details=serde_json::json!({"schema":"monzero-ltc-native-payout-review-v1",
+            "tradeId":head.trade,"quoteCommitment":hex(&head.quote),"journalCommitment":hex(&Sha256::digest(&bytes)),
+            "preparedCommitment":hex(&head.native_payout.context("payout lacks preparation")?),
+            "dispatchCommitment":dispatch.map(|value|hex(&value)),"action":action.label(),
+            "txid":terms["txid"],"destination":terms["destination"],"payoutAtoms":prepared.preview().recipient.atom_string(),
+            "reserveDestination":terms["reserveReturn"],"reserveReturnAtoms":prepared.preview().reserve_return.atom_string(),
+            "feeAtoms":prepared.preview().network_fee.atom_string(),"maximumFeeAtoms":terms["maximumFeeAtoms"],
+            "lockedAtoms":terms["lockedAtoms"],"chainObserved":false});
+        Ok(PayoutReview {commitment:commitment(&details)?,details})
+    }
+    /// Native GUI bridge entry point. The caller supplies the exact displayed
+    /// commitment after consent; fresh two-chain preflight still happens below.
+    pub async fn relay_reviewed_native_payout(&mut self,action:PayoutAction,approved:[u8;32],
+        native:&mut NativeTransferRelay,ltc:&LitecoinRpc,block:bitcoin::BlockHash)->Result<RelayedTransfer> {
+        let current=self.review_native_payout_payment(action)?;
+        ensure!(current.commitment==approved,"payout approval is stale or differs from the retained payment/action");
+        match action {
+            PayoutAction::Send=>self.relay_native_payout(native,ltc,block).await,
+            PayoutAction::Retransmit=>self.retransmit_native_payout(native,ltc,block).await,
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn payout_approval_binds_payment_action_and_journal_context()->Result<()> {
+        let original=serde_json::json!({"schema":"monzero-ltc-native-payout-review-v1","tradeId":"trade-a",
+            "quoteCommitment":"quote-a","journalCommitment":"head-a","preparedCommitment":"prepared-a",
+            "dispatchCommitment":null,"action":"send","txid":"tx-a","destination":"recipient-a",
+            "payoutAtoms":"100","reserveDestination":"reserve-a","reserveReturnAtoms":"8","feeAtoms":"2","maximumFeeAtoms":"3","lockedAtoms":"110","chainObserved":false});
+        let expected=commitment(&original)?;
+        for key in original.as_object().unwrap().keys() {
+            let mut modified=original.clone();modified[key]=serde_json::json!("changed");
+            assert_ne!(commitment(&modified)?,expected,"unbound field {key}");
+        }
+        let mut retry=original.clone();retry["action"]=serde_json::json!(PayoutAction::Retransmit.label());
+        assert_ne!(commitment(&retry)?,expected);
+        assert_eq!(commitment(&original)?,expected);
+        let mut refund_domain=Sha256::new();
+        refund_domain.update(b"MONZERO-LTC-NATIVE-REFUND-APPROVAL-V1\0");
+        refund_domain.update(serde_json::to_vec(&original)?);
+        let refund_token:[u8;32]=refund_domain.finalize().into();
+        assert_ne!(refund_token,expected,"refund approval must not authorize a success payout");
+        Ok(())
+    }
+}
