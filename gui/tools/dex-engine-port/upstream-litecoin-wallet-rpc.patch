+    #[serde(default)] action: Option<String>,
+    #[serde(default)] trade: Option<uuid::Uuid>,
+    #[serde(default)] observe: Option<OutPoint>,
+    #[serde(default)] block: Option<bitcoin::BlockHash>,
+    #[serde(default)] minimum_confirmations: Option<u64>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RecoveryRequest {
+    policy: swap_machine::litecoin_rpc::reservation::RecoveryPolicy,
+    cancel: String, refund: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all="camelCase")]
+struct QuoteRequest { payload: String, ltc_signature: String, xmz_signature: String }
+fn fixture_quote_policy() -> swap_machine::litecoin_quote::Policy {
+    use swap_core::xmz_address::XmzNetwork;
+    swap_machine::litecoin_quote::Policy { ltc_network:LtcNetwork::Regtest, xmz_network:XmzNetwork::Mainnet,
+        xmz_genesis:"a".repeat(64), ltc_confirmations:1, xmz_confirmations:10, cancel_blocks:10, punish_blocks:7,
+        maximum_ltc_atoms:1_000_000_000, maximum_xmz_atoms:2_000_000_000, maximum_ltc_funding_fee:100_000,
+        maximum_ltc_recovery_fee:20_000, maximum_xmz_fee:100_000, minimum_ltc_output:100_000,
+        minimum_relay_fee_atoms_per_kb:1000 }
+}
+fn fixture_signature(text: &str) -> Result<Vec<u8>> {
+    ensure!(text.len()==128 && text.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)), "invalid quote signature");
+    (0..64).map(|i| Ok(u8::from_str_radix(&text[i*2..i*2+2],16)?)).collect()
+}
+
+#[tokio::test]
+#[ignore = "requires owned Litecoin regtest node and private cookie"]
+async fn export_litecoin_wallet_rpc() -> Result<()> {
+    let request = std::env::var_os("MONZERO_LTC_WALLET_REQUEST").context("request path")?;
+    let response = std::env::var_os("MONZERO_LTC_WALLET_RESPONSE").context("response path")?;
+    let cookie = std::env::var_os("MONZERO_LTC_WALLET_COOKIE").context("cookie path")?;
+    let mut bytes = Vec::new();
+    std::fs::File::open(request)?.take(16385).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() <= 16384, "oversized wallet fixture request");
+    let request: Request = serde_json::from_slice(&bytes)?;
+    let mut cookie_bytes = Zeroizing::new(Vec::new());
+    std::fs::File::open(cookie)?.take(1025).read_to_end(&mut cookie_bytes)?;
+    ensure!(cookie_bytes.len() <= 1024, "oversized fixture cookie");
+    let (username, password) = std::str::from_utf8(&cookie_bytes)?.trim().split_once(':').context("cookie format")?;
+    let anchor = LtcSegwitAddress::parse(LtcNetwork::Regtest, &request.anchor)?;
+    let contract = LtcSegwitAddress::parse(LtcNetwork::Regtest, &request.contract)?;
+    let rpc = LitecoinRpc::new(request.port, username.to_owned(), password.to_owned(),
+        LtcNetwork::Regtest, request.wallet, anchor)?;
+    let result = if matches!(request.action.as_deref(), Some("relay" | "resumeRelay")) {
+        let directory = std::path::PathBuf::from(std::env::var_os("MONZERO_LTC_RESERVATION_DIRECTORY").context("reservation directory")?);
+        let trade = request.trade.context("reservation trade")?;
+        let txid = request.expected_txid.context("expected funding identity")?;
+        let outcome = if request.action.as_deref() == Some("resumeRelay") {
+            rpc.resume_reserved_relay(&directory, trade, txid).await?
+        } else { rpc.relay_reserved_lock(&directory, trade, txid).await? };
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false, "outcome":outcome})
+    } else if matches!(request.action.as_deref(), Some("sign" | "signQuote" | "signExchange")) {
+        let directory = std::path::PathBuf::from(std::env::var_os("MONZERO_LTC_RESERVATION_DIRECTORY").context("reservation directory")?);
+        let recovery = request.recovery.context("missing recovery package")?;
+        let cancel = bitcoin::consensus::encode::deserialize_hex(&recovery.cancel)?;
+        let refund = bitcoin::consensus::encode::deserialize_hex(&recovery.refund)?;
+        let trade = request.trade.context("reservation trade")?;
+        let signed = if matches!(request.action.as_deref(), Some("signQuote" | "signExchange")) {
+            let supplied = request.quote.context("missing signed commercial quote")?;
+            let policy = fixture_quote_policy();
+            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs();
+            // Public, fixed test identities. Never use these pins in live trading.
+            let ltc = ed25519_dalek::SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes();
+            let xmz = ed25519_dalek::SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes();
+            let quote = swap_machine::litecoin_quote::VerifiedLtcQuote::verify(supplied.payload.as_bytes(),now,&policy,
+                &ltc,&xmz,&fixture_signature(&supplied.ltc_signature)?,&fixture_signature(&supplied.xmz_signature)?)?;
+            ensure!(quote.recovery_policy(&policy,now,recovery.policy.key_a.clone(),recovery.policy.key_b.clone())? == recovery.policy,
+                "fixture recovery terms differ from signed quote");
+            if request.action.as_deref() == Some("signExchange") {
+                quote.check_funding(&policy,now,trade,request.amount_atoms,request.maximum_fee_atoms)?;
+                rpc.check_reserved_recovery(&directory,trade,&recovery.policy,&cancel,&refund)?;
+                let (mut bob,mut alice)=fixture_exchange(&directory,&quote,&policy,now)?;
+                let keys=bob.completed_keys()?;
+                ensure!(keys.recovery_policy(&quote,&policy,now)? == recovery.policy,
+                    "fixture recovery keys differ from authenticated exchange");
+                let reserved=rpc.resume_lock(&directory,trade).await?;
+                let bob_message=bob.prepare_recovery(reserved.psbt(),&ed25519_dalek::SigningKey::from_bytes(&[1;32]),now)?;
+                let alice_message=alice.prepare_recovery(reserved.psbt(),&ed25519_dalek::SigningKey::from_bytes(&[2;32]),now)?;
+                let retained=bob.accept_recovery(alice_message.bytes(),alice_message.signature())?;
+                let native=alice.accept_recovery(bob_message.bytes(),bob_message.signature())?;
+                ensure!(retained.cancel==cancel && retained.refund.as_ref()==Some(&refund)
+                    && native.cancel==cancel && native.punish.is_some(),
+                    "independent fixture recovery differs from retained peer signatures");
+                bob.sign_recovered_lock(&rpc,&directory,now).await?
+            } else {
+                rpc.sign_reserved_lock_for_quote(&directory,trade,&quote,&policy,now,
+                    recovery.policy.key_a, recovery.policy.key_b,&cancel,&refund).await?
+            }
+        } else { rpc.sign_reserved_lock(&directory,trade,&recovery.policy,&cancel,&refund).await? };
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false,
+            "hex":bitcoin::consensus::encode::serialize_hex(signed.transaction()),
+            "txid":signed.transaction().compute_txid().to_string()})
+    } else if request.action.as_deref() == Some("confirmedTransaction") {
+        let observed=rpc.confirmed_transaction(request.expected_txid.context("missing observed txid")?,
+            request.block.context("missing observed block")?,request.minimum_confirmations.context("missing confirmation policy")?).await?;
+        json!({"schema":"monzero-ltc-wallet-fixture-v1","executable":false,
+            "txid":observed.transaction().compute_txid().to_string(),
+            "hex":bitcoin::consensus::encode::serialize_hex(observed.transaction()),
+            "confirmations":observed.confirmations(),"tip":observed.tip().to_string(),"block":observed.block().to_string()})
+    } else if request.action.as_deref() == Some("liveLock") {
+        let policy=fixture_quote_policy();
+        let evidence=rpc.verify_live_lock(request.observe.context("missing live lock outpoint")?,
+            contract.script_pubkey(),Amount::from_sat(request.amount_atoms),u64::from(policy.ltc_confirmations),
+            policy.cancel_blocks,1).await?;
+        json!({"schema":"monzero-ltc-wallet-fixture-v1","executable":false,
+            "confirmations":evidence.observation().confirmations,"tip":evidence.observation().tip.to_string()})
+    } else if request.action.as_deref() == Some("observeLock") {
+        let directory = std::path::PathBuf::from(std::env::var_os("MONZERO_LTC_RESERVATION_DIRECTORY").context("reservation directory")?);
+        let observation = rpc.observe_lock(&directory, request.trade.context("reservation trade")?).await?;
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false, "observation":observation})
+    } else if request.action.as_deref() == Some("resume") {
+        let directory = std::path::PathBuf::from(std::env::var_os("MONZERO_LTC_RESERVATION_DIRECTORY").context("reservation directory")?);
+        let reserved = rpc.resume_lock(&directory, request.trade.context("reservation trade")?).await?;
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false, "psbt":reserved.psbt().to_string(), "reserved":true})
+    } else if let Some(outpoint) = request.observe {
+        let output = rpc.unspent(outpoint).await?;
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false,
+            "output":output.map(|o| json!({"tip":o.tip.to_string(), "confirmations":o.confirmations,
+                "amountAtoms":o.amount.to_sat().to_string(), "scriptPubKey":o.script.to_hex_string()}))})
+    } else {
+        let preview = rpc.preview_lock(&contract, Amount::from_sat(request.amount_atoms),
+            request.fee_rate_atoms_per_kb, Amount::from_sat(request.maximum_fee_atoms)).await?;
+        let reserved = match request.action.as_deref() {
+            Some("reserve") => {
+                let directory = std::path::PathBuf::from(std::env::var_os("MONZERO_LTC_RESERVATION_DIRECTORY").context("reservation directory")?);
+                rpc.reserve_lock(&directory, request.trade.context("reservation trade")?, &contract,
+                    Amount::from_sat(request.amount_atoms), Amount::from_sat(request.maximum_fee_atoms), &preview).await?;
+                true
+            }
+            None => false,
+            _ => anyhow::bail!("unknown wallet fixture action"),
+        };
+        json!({"schema":"monzero-ltc-wallet-fixture-v1", "executable":false,
+            "psbt":preview.psbt.to_string(), "feeAtoms":preview.fee.to_sat().to_string(), "reserved":reserved})
+    };
+    let mut file = std::fs::OpenOptions::new().create_new(true).write(true).mode(0o600).open(response)?;
+    file.write_all(&serde_json::to_vec(&result)?)?;
+    file.sync_all()?;
+    Ok(())
+}
+
+// Public deterministic test secrets only, matching the independent swap-core
+// transaction builder. Never use this seed scheme or identity pins in trading.
+fn fixture_exchange(directory: &std::path::Path,quote: &swap_machine::litecoin_quote::VerifiedLtcQuote,
+    policy: &swap_machine::litecoin_quote::Policy, now: u64)
+    -> Result<(swap_machine::litecoin_negotiation::execution::Execution,swap_machine::litecoin_negotiation::execution::Execution)> {
+    use rand::SeedableRng;
+    use sha2::{Digest,Sha256};
+    use ed25519_dalek::SigningKey;
+    use std::os::unix::fs::DirBuilderExt;
+    use swap_machine::litecoin_negotiation::{LocalRole,execution::Execution};
+    let trade: uuid::Uuid=quote.terms()["swapId"].parse()?;
+    let root=directory.join(format!("execution-protocol-{trade}"));
+    let fresh=match std::fs::DirBuilder::new().mode(0o700).create(&root) {
+        Ok(())=>true,
+        Err(e) if e.kind()==std::io::ErrorKind::AlreadyExists=>false,
+        Err(e)=>return Err(e.into()),
+    };
+    let bm=root.join("bob-metadata");let bs=root.join("bob-secrets");
+    let am=root.join("alice-metadata");let als=root.join("alice-secrets");
+    if fresh { for path in [&bm,&bs,&am,&als] { std::fs::DirBuilder::new().mode(0o700).create(path)?; } }
+    let ltc=SigningKey::from_bytes(&[1;32]);let native=SigningKey::from_bytes(&[2;32]);
+    let pins=[ltc.verifying_key().to_bytes(),native.verifying_key().to_bytes()];
+    let rng=|role: &str| rand_chacha::ChaCha20Rng::from_seed(
+        Sha256::digest(format!("monzero-ltc-execution-fixture-v1/{role}")).into());
+    let mut bob=if fresh {
+        Execution::begin(&bm,&bs,quote,policy,LocalRole::LitecoinFunder,quote.commitment(),now,&mut rng("bob"))?
+    } else { Execution::resume(&bm,&bs,trade,policy,LocalRole::LitecoinFunder,pins)? };
+    let mut alice=if fresh {
+        Execution::begin(&am,&als,quote,policy,LocalRole::NativeFunder,quote.commitment(),now,&mut rng("alice"))?
+    } else { Execution::resume(&am,&als,trade,policy,LocalRole::NativeFunder,pins)? };
+    if fresh {
+        let first=bob.outgoing(&ltc,now)?;
+        alice.accept_peer(first.bytes(),first.signature(),now)?;
+        let second=alice.outgoing(&native,now)?;
+        bob.accept_peer(second.bytes(),second.signature(),now)?;
+    }
+    let left=bob.completed_keys()?;let right=alice.completed_keys()?;
+    left.check_quote(quote)?;
+    ensure!(left.transcript_commitment()==right.transcript_commitment(),"fixture peer transcript disagreement");
+    Ok((bob,alice))
+}
