+//! Private payout checkpoint. Expected context and digest come from the owner journal.
+use super::*;
+use serde::{Deserialize,Serialize};
+use sha2::{Digest,Sha256};
+use zeroize::Zeroize;
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {schema:String,binding:[u8;32],terms:Value,metadata:String,
+    #[serde(default,skip_serializing_if="Option::is_none")]
+    tx_keys:Option<String>}
+impl Drop for Record {fn drop(&mut self) {self.metadata.zeroize();if let Some(keys)=&mut self.tx_keys {keys.zeroize();}}}
+fn encode_record(record:&Record)->Result<Zeroizing<Vec<u8>>> {
+    let mut bytes=Zeroizing::new(Vec::with_capacity(600_000));
+    serde_json::to_writer(&mut *bytes,record)?;
+    ensure!(bytes.len()<=600_000,"oversized native payout checkpoint");
+    Ok(bytes)
+}
+impl PreparedLockPayout {
+    pub(crate) fn encode(&self,binding:[u8;32])->Result<Zeroizing<Vec<u8>>> {
+        encode_record(&Record {schema:if self.tx_keys.is_some() {"monzero-native-payout-checkpoint-v2".into()} else {"monzero-native-payout-checkpoint-v1".into()},binding,
+            terms:self.terms.clone(),metadata:self.metadata.to_string(),tx_keys:self.tx_keys.as_ref().map(|v|v.to_string())})
+    }
+    /// Offline restoration only. A successful decode supplies neither current
+    /// confirmations nor permission to replace or broadcast a transaction.
+    pub(crate) fn decode(bytes:&[u8],binding:[u8;32],digest:[u8;32],request:&ExactNetRequest,genesis:&str)->Result<Self> {
+        ensure!(!bytes.is_empty() && bytes.len()<=600_000,"invalid native payout checkpoint size");
+        ensure!(<[u8;32]>::from(Sha256::digest(bytes))==digest,"native payout checkpoint digest mismatch");
+        payout_params(request)?;
+        ensure!(hash(genesis) && genesis!="0".repeat(64) && hash(&request.source.lock_txid)
+            && request.source.lock_txid!="0".repeat(64),"invalid native payout checkpoint context");
+        let mut record:Record=serde_json::from_slice(bytes)?;
+        ensure!(*encode_record(&record)?==bytes && record.schema==if record.tx_keys.is_some() {"monzero-native-payout-checkpoint-v2"} else {"monzero-native-payout-checkpoint-v1"}
+            && record.binding==binding,"native payout checkpoint binding mismatch");
+        ensure!(!record.metadata.is_empty() && record.metadata.len()<=524288 && record.metadata.len()%2==0
+            && record.metadata.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid saved payout metadata");
+        if let Some(keys)=&record.tx_keys {
+            ensure!(request.source.account==0,"proof payout requires dedicated account zero");
+            validate_tx_keys(keys)?;
+        } else {exact_net_params(request)?;}
+        let atoms=|field:&str|->Result<u64> {
+            let text=record.terms[field].as_str().context("missing saved payout amount")?;
+            let value:u64=text.parse()?;
+            ensure!(value.to_string()==text,"noncanonical saved payout amount");Ok(value)
+        };
+        let fee=atoms("feeAtoms")?;let returned=atoms("reserveReturnAtoms")?;
+        ensure!(fee>0 && (returned>0 || record.tx_keys.is_some())
+            && fee<=request.source.maximum_fee.atoms() && request.principal.atoms().checked_add(returned)
+            .and_then(|v|v.checked_add(fee))==Some(request.source.locked.atoms()),"saved payout accounting mismatch");
+        let txid=record.terms["txid"].as_str().context("missing saved payout identity")?;
+        let weight=number(&record.terms,"weight")?;
+        ensure!(hash(txid) && txid!="0".repeat(64) && weight>0,"invalid saved payout identity or weight");
+        let preview=ExactNetPreview {recipient:request.principal,reserve_return:XmzAmount::from_atoms(returned),network_fee:XmzAmount::from_atoms(fee)};
+        ensure!(accounting(request,genesis,&preview,txid,weight)==record.terms,"saved payout differs from expected request");
+        Ok(Self {request:request.clone(),preview,terms:record.terms.clone(),metadata:Zeroizing::new(std::mem::take(&mut record.metadata)),tx_keys:record.tx_keys.take().map(Zeroizing::new)})
+    }
+}
