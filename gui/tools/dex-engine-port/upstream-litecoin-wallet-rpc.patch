+    assert!(LocalKeys::restore_secret_checkpoint(&serde_json::to_vec(&changed)?,&quote,LocalRole::LitecoinFunder).is_err());
+    // Keep struct field order so rejection checks secret/key consistency,
+    // rather than the canonical encoding boundary.
+    let mut corrupt=bytes.to_vec();
+    let text=std::str::from_utf8(&corrupt)?;
+    let start=text.find("\"contract_secret\":[").unwrap()+"\"contract_secret\":[".len();
