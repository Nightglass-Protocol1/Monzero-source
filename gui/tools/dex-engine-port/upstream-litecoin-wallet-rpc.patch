+#[tokio::test]
+async fn rejects_rpc_errors_wrong_ids_redirects_and_oversized_bodies() {
+    use std::{net::TcpListener, io::{BufRead, BufReader, Read, Write}};
+    let cases = [
+        (200, r#"{"id":0,"error":null,"result":"ok"}"#.to_owned(), true, false),
+        (200, r#"{"id":1,"error":null,"result":"ok"}"#.to_owned(), false, false),
+        (200, r#"{"id":0,"error":{"code":-1},"result":null}"#.to_owned(), false, false),
+        (200, "{".to_owned(), false, false),
+        (200, json!({"id":0,"error":null,"result":"x".repeat(2_000_001)}).to_string(), false, false),
+        (302, r#"{"id":0,"error":null,"result":"ok"}"#.to_owned(), false, false),
+        (401, r#"{"id":0,"error":null,"result":"ok"}"#.to_owned(), false, false),
+        (500, r#"{"id":0,"error":{"code":-5,"message":"missing"},"result":null}"#.to_owned(), true, true),
+        (500, r#"{"id":0,"error":{"code":-5,"message":"missing"},"result":null}"#.to_owned(), false, false),
+        (500, r#"{"id":1,"error":{"code":-5,"message":"missing"},"result":null}"#.to_owned(), false, true),
+        (200, r#"{"id":0,"error":{"code":-5,"message":"missing"},"result":null}"#.to_owned(), false, true),
+        (500, r#"{"id":0,"error":{"code":-4,"message":"failure"},"result":null}"#.to_owned(), false, true),
+        (500, r#"{"id":0,"error":{"code":-5,"message":"missing"},"result":1}"#.to_owned(), false, true),
+    ];
+    for (status, body, accepted, missing_allowed) in cases {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let server = std::thread::spawn(move || {
+            let (mut socket, _) = listener.accept().unwrap();
+            socket.set_read_timeout(Some(std::time::Duration::from_secs(5))).unwrap();
+            let mut reader = BufReader::new(socket.try_clone().unwrap());
+            let mut size = 0;
+            loop {
+                let mut line = String::new(); reader.read_line(&mut line).unwrap();
+                if line == "\r\n" { break; }
+                if let Some(value) = line.to_ascii_lowercase().strip_prefix("content-length:") { size = value.trim().parse().unwrap(); }
+            }
+            assert!(size < 4096);
+            reader.read_exact(&mut vec![0u8;size]).unwrap();
+            let reply = format!("HTTP/1.1 {status} Test\r\nContent-Length: {}\r\nLocation: http://127.0.0.1:1/\r\nConnection: close\r\n\r\n{body}",body.len());
+            let _ = socket.write_all(reply.as_bytes());
+        });
+        let anchor = LtcSegwitAddress::from_script(LtcNetwork::Regtest, &script(1,20)).unwrap();
+        let rpc = LitecoinRpc::new(port,"fixture".into(),"fixture".into(),LtcNetwork::Regtest,"fixture".into(),anchor).unwrap();
