+//! Deliberate consent for the exact retained native funding transaction.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::relay::{NativeTransferRelay,RelayedTransfer}};
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum FundingAction {Send,Retransmit}
+impl FundingAction {
+    fn label(self)->&'static str {match self {Self::Send=>"send",Self::Retransmit=>"retransmit"}}
+}
+/// Public terms only. The caller must display these terms and obtain consent;
+/// possession of this commitment alone does not authenticate a user gesture.
+pub struct FundingReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+fn commitment(details:&serde_json::Value)->Result<[u8;32]> {
+    let mut digest=Sha256::new();
+    digest.update(b"MONZERO-LTC-NATIVE-FUNDING-APPROVAL-V1\0");
+    digest.update(serde_json::to_vec(details)?);
+    Ok(digest.finalize().into())
+}
+impl Execution {
+    /// Review retained bytes without signing or contacting either chain. May
+    /// finish publication of a previously retained preparation after a crash.
+    pub fn review_native_lock_payment(&mut self,action:FundingAction,safety_blocks:u32)->Result<FundingReview> {
+        let prepared=self.load_prepared_native_lock()?;
+        let (head,bytes,quote,_,exchange)=self.load()?;
+        let required=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let cancel=quote.terms()["cancelBlocks"].parse::<u64>()?;
+        ensure!(safety_blocks>0 && required.checked_add(u64::from(safety_blocks)).is_some_and(|depth|depth<cancel),
+            "invalid funding safety window");
+        let dispatch=match action {
+            FundingAction::Send=>{
+                ensure!(head.native_dispatch.is_none(),"funding already attempted; explicit retransmission review required");
+                match self.metadata.read(&super::native_relay::dispatch_name(self.claim.trade)) {
+                    Ok(_)=>anyhow::bail!("retained funding attempt requires explicit retransmission review"),
+                    Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                    Err(e)=>return Err(e),
+                }
+                None
+            },
+            FundingAction::Retransmit=>Some(self.checked_native_dispatch(&head)?),
+        };
+        let terms=prepared.terms();let summary=prepared.summary();
+        let amount=quote.terms()["xmzAtoms"].parse::<u64>()?;
+        let debit=amount.checked_add(summary.fee.atoms()).context("native funding debit overflow")?;
+        let details=serde_json::json!({"schema":"monzero-ltc-native-funding-review-v1",
+            "tradeId":head.trade,"quoteCommitment":hex(&head.quote),"journalCommitment":hex(&Sha256::digest(&bytes)),
+            "preparedCommitment":hex(&head.native_lock.context("funding lacks preparation")?),
+            "dispatchCommitment":dispatch.map(|value|hex(&value)),"action":action.label(),
+            "txid":summary.txid,"wallet":terms["wallet"],"account":terms["account"],"priority":terms["priority"],
+            "destination":terms["destination"],"amountAtoms":amount.to_string(),"feeAtoms":summary.fee.atom_string(),
+            "maximumFeeAtoms":quote.terms()["xmzNativeFeeMaxAtoms"],"totalDebitAtoms":debit.to_string(),
+            "ltcContract":exchange.finish()?.contract_address().to_string(),"ltcAtoms":quote.terms()["ltcAtoms"],
+            "safetyBlocks":safety_blocks.to_string(),"expiresAt":quote.terms()["expiresAt"],"chainObserved":false});
+        Ok(FundingReview {commitment:commitment(&details)?,details})
+    }
+    /// Consent is checked before RPC. The existing relay then independently
+    /// enforces quote expiry, wallet identity and a fresh live Litecoin lock.
+    pub async fn relay_reviewed_native_lock(&mut self,action:FundingAction,approved:[u8;32],
+        native:&mut NativeTransferRelay,ltc:&LitecoinRpc,safety_blocks:u32)->Result<RelayedTransfer> {
+        let current=self.review_native_lock_payment(action,safety_blocks)?;
+        ensure!(current.commitment==approved,"funding approval is stale or differs from the retained payment/action");
+        match action {
+            FundingAction::Send=>self.relay_native_lock(native,ltc,safety_blocks).await,
+            FundingAction::Retransmit=>self.retransmit_native_lock(native,ltc,safety_blocks).await,
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn funding_approval_binds_source_payment_safety_window_and_action()->Result<()> {
+        let original=serde_json::json!({"schema":"monzero-ltc-native-funding-review-v1","tradeId":"trade-a",
+            "quoteCommitment":"quote-a","journalCommitment":"head-a","preparedCommitment":"prepared-a",
+            "dispatchCommitment":null,"action":"send","txid":"tx-a","wallet":"source-a","account":0,"priority":1,
+            "destination":"lock-a","amountAtoms":"100","feeAtoms":"2","maximumFeeAtoms":"3","totalDebitAtoms":"102",
+            "ltcContract":"contract-a","ltcAtoms":"500","safetyBlocks":"2","expiresAt":"1000","chainObserved":false});
+        let expected=commitment(&original)?;
+        for key in original.as_object().unwrap().keys() {
+            let mut modified=original.clone();modified[key]=serde_json::json!("changed");
+            assert_ne!(commitment(&modified)?,expected,"unbound field {key}");
+        }
+        for domain in [b"MONZERO-LTC-NATIVE-PAYOUT-APPROVAL-V1\0".as_slice(),b"MONZERO-LTC-NATIVE-REFUND-APPROVAL-V1\0".as_slice()] {
+            let mut digest=Sha256::new();digest.update(domain);digest.update(serde_json::to_vec(&original)?);
+            let other:[u8;32]=digest.finalize().into();assert_ne!(other,expected);
+        }
+        assert_eq!(commitment(&original)?,expected);
+        Ok(())
+    }
+}
