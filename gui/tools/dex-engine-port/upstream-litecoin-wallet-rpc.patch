+    let (restored,share)=LocalKeys::restore_secret_checkpoint(&bytes,&quote,LocalRole::LitecoinFunder)?;
+    let before=KeyExchange::new(&quote,&policy,1000,LocalRole::LitecoinFunder,&bob)?;
