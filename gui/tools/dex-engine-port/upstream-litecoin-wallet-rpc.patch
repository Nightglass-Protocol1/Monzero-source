+//! Durable native payout dispatch. Saved bytes are never reconstructed here.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::{relay::{NativeTransferRelay,RelayedTransfer},
+    full_proceeds::lock_payout::PreparedLockPayout}};
+
+#[derive(Serialize)]
+struct Dispatch {schema:&'static str,trade:uuid::Uuid,quote:[u8;32],checkpoint:[u8;32],claim:[u8;32],prepared:[u8;32]}
+#[derive(Serialize)]
+struct Receipt {schema:&'static str,dispatch:[u8;32],txid:String,fee:u64,weight:u64}
+pub(super) fn dispatch_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-payout-dispatch")}
+pub(super) fn receipt_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-payout-receipt")}
+fn summary(prepared:&PreparedLockPayout)->Result<RelayedTransfer> {
+    Ok(RelayedTransfer {txid:prepared.terms()["txid"].as_str().context("missing payout identity")?.into(),
+        fee:prepared.preview().network_fee,weight:prepared.terms()["weight"].as_u64().context("missing payout weight")?})
+}
+impl Execution {
+    fn payout_dispatch_bytes(&self,head:&Head)->Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&Dispatch {schema:"monzero-ltc-payout-dispatch-v1",trade:self.claim.trade,
+            quote:self.claim.quote,checkpoint:head.checkpoint,claim:head.native_claim.context("missing committed claim")?,
+            prepared:head.native_payout.context("missing committed payout")?})?)
+    }
+    pub(super) fn checked_payout_dispatch(&self,head:&Head)->Result<[u8;32]> {
+        let bytes=self.payout_dispatch_bytes(head)?;
+        let digest=Sha256::digest(&bytes).into();
+        ensure!(self.metadata.read(&dispatch_name(self.claim.trade))?==bytes,"payout dispatch context mismatch");
+        if let Some(expected)=head.native_payout_dispatch {ensure!(expected==digest,"payout dispatch differs from head");}
+        self.metadata.retain(&dispatch_name(self.claim.trade),&bytes)?;
+        Ok(digest)
+    }
+    /// First explicit send. Any retained attempt requires reconciliation or the
+    /// separate retransmit API, even after an interrupted head publication.
+    pub async fn relay_native_payout(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash)->Result<RelayedTransfer> {
+        self.dispatch_native_payout(native,ltc,block,false).await
+    }
+    /// Explicit retry of the identical saved transaction using a fresh backend.
+    /// A prior acknowledgement is not confirmation and does not forbid retry.
+    pub async fn retransmit_native_payout(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash)->Result<RelayedTransfer> {
+        self.dispatch_native_payout(native,ltc,block,true).await
+    }
+    async fn dispatch_native_payout(&mut self,native:&mut NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash,retry:bool)->Result<RelayedTransfer> {
+        let prepared=self.load_prepared_native_payout()?;
+        let redemption=self.retained_native_redemption()?;
+        let (mut head,previous,quote,_,_)=self.load()?;
+        if retry {self.checked_payout_dispatch(&head)?;}
+        else {
+            ensure!(head.native_payout_dispatch.is_none(),"payout already attempted; reconcile or explicitly retransmit");
+            match self.metadata.read(&dispatch_name(self.claim.trade)) {
+                Ok(_)=>anyhow::bail!("retained payout attempt requires reconciliation or explicit retransmission"),
+                Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>(),
+                Err(e)=>return Err(e),
+            }
+        }
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        native.preflight_native_payout(&prepared).await?;
+        // All slow secret/quote restoration precedes the final LTC observation.
+        // This is settlement of existing obligations; commercial expiry does not
+        // authorize abandonment or new terms for an already-funded trade.
+        let observed=ltc.confirmed_transaction(redemption.compute_txid(),block,minimum).await?;
+        ensure!(observed.network()==self.policy.ltc_network && super::redeem::same_redemption_effect(&redemption,observed.transaction()),
+            "payout redemption differs from retained claim");
+        let bytes=self.payout_dispatch_bytes(&head)?;
+        let digest=Sha256::digest(&bytes).into();
+        self.metadata.retain(&dispatch_name(self.claim.trade),&bytes)?;
+        if head.native_payout_dispatch.is_none() {
+            head.native_payout_dispatch=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        let acknowledged=native.dispatch_native_payout(&prepared).await?;
+        self.retain_payout_receipt(&prepared)
+            .context("payout broadcast acknowledged, but saving its receipt failed; reconcile the saved transaction")?;
+        Ok(acknowledged)
+    }
+    fn retain_payout_receipt(&mut self,prepared:&PreparedLockPayout)->Result<()> {
+        let (mut head,previous,_,_,_)=self.load()?;
+        let dispatch=self.checked_payout_dispatch(&head)?;
+        let summary=summary(prepared)?;
+        let bytes=serde_json::to_vec(&Receipt {schema:"monzero-ltc-payout-receipt-v1",dispatch,
+            txid:summary.txid,fee:summary.fee.atoms(),weight:summary.weight})?;
+        let digest=Sha256::digest(&bytes).into();
+        if let Some(expected)=head.native_payout_receipt {ensure!(expected==digest,"payout receipt differs from saved transaction");}
+        self.metadata.retain(&receipt_name(self.claim.trade),&bytes)?;
+        if head.native_payout_dispatch.is_none() || head.native_payout_receipt.is_none() {
+            head.native_payout_dispatch=Some(dispatch);head.native_payout_receipt=Some(digest);
+            self.metadata.replace_execution_head(self.claim.trade,&previous,&serde_json::to_vec(&head)?)?;
+        }
+        Ok(())
+    }
+    /// Observe current LTC redemption and the exact native payout. The returned
+    /// native depth is an observation at this call, never a cached completion flag.
+    pub async fn reconcile_native_payout(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc,
+        block:bitcoin::BlockHash)->Result<u64> {
+        let prepared=self.load_prepared_native_payout()?;
+        let redemption=self.retained_native_redemption()?;
+        let (head,_,quote,_,_)=self.load()?;
+        self.checked_payout_dispatch(&head)?;
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.confirmed_transaction(redemption.compute_txid(),block,minimum).await?;
+        ensure!(observed.network()==self.policy.ltc_network && super::redeem::same_redemption_effect(&redemption,observed.transaction()),
+            "payout reconciliation redemption differs from claim");
+        let minimum=quote.terms()["xmzConfirmations"].parse::<u64>()?.max(u64::from(self.policy.xmz_confirmations));
+        let depth=native.confirm_native_payout(&prepared,minimum).await?;
+        self.retain_payout_receipt(&prepared)?;
+        Ok(depth)
+    }
+}
