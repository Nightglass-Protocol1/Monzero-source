+    let old: u8=text[start..end].parse()?;
+    corrupt.splice(start..end,old.wrapping_add(1).to_string().bytes());
+    assert!(LocalKeys::restore_secret_checkpoint(&corrupt,&quote,LocalRole::LitecoinFunder).is_err());
+    Ok(())
