+#[cfg(target_os="linux")]
+fn contract_spend_node(tx:bitcoin::Transaction,active:bool,relay:Option<(std::path::PathBuf,bool,&'static str)>)->Result<(crate::litecoin_rpc::LitecoinRpc,
+    bitcoin::BlockHash,std::sync::Arc<std::sync::atomic::AtomicBool>,std::thread::JoinHandle<Result<()>>)> {
+    use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},sync::{Arc,atomic::{AtomicBool,Ordering}},time::Duration};
+    use bitcoin::hashes::Hash;
+    use swap_core::litecoin_address::{LtcNetwork,LtcSegwitAddress};
+    let block=bitcoin::BlockHash::from_byte_array([7;32]);
+    let anchor=LtcSegwitAddress::from_script(LtcNetwork::Regtest,&tx.output[0].script_pubkey)?;
+    let listener=TcpListener::bind("127.0.0.1:0")?;let port=listener.local_addr()?.port();listener.set_nonblocking(true)?;
+    let stop=Arc::new(AtomicBool::new(false));let stopped=stop.clone();
+    let server=std::thread::spawn(move ||->Result<()> {
+        while !stopped.load(Ordering::SeqCst) {
+            let (mut socket,_)=match listener.accept() {
+                Ok(value)=>value,
+                Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>{std::thread::sleep(Duration::from_millis(5));continue;},
+                Err(e)=>return Err(e.into()),
+            };
+            socket.set_read_timeout(Some(Duration::from_secs(10)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();let mut length=None;
+            loop {line.clear();ensure!(reader.read_line(&mut line)?>0,"missing claim RPC headers");
+                if line=="\r\n" {break;}
+                if let Some(value)=line.to_ascii_lowercase().strip_prefix("content-length:") {length=Some(value.trim().parse::<usize>()?);}}
+            let length=length.context("missing claim request length")?;ensure!(length<4096,"oversized claim request");
+            let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;
+            let request:serde_json::Value=serde_json::from_slice(&bytes)?;
+            let result=match request["method"].as_str().context("missing claim method")? {
+                "getblockchaininfo"=>serde_json::json!({"chain":"regtest","bestblockhash":"08".repeat(32),"initialblockdownload":false,
+                    "softforks":{"csv":{"active":true},"segwit":{"active":true}}}),
+                "getblockhash"=>serde_json::json!(LtcNetwork::Regtest.genesis()),
+                "testmempoolaccept"=>{
+                    ensure!(relay.is_some() && request["params"]==serde_json::json!([[bitcoin::consensus::encode::serialize_hex(&tx)]]),"wrong redemption preflight bytes");
+                    serde_json::json!([{"txid":tx.compute_txid(),"allowed":true}])
+                },
+                "sendrawtransaction"=>{
+                    let (path,lose,pointer)=relay.as_ref().context("unexpected contract spend relay")?;
+                    let head:serde_json::Value=serde_json::from_slice(&std::fs::read(path)?)?;
+                    ensure!(head.pointer(pointer).is_some_and(serde_json::Value::is_array),"contract spend sent before durable dispatch");
+                    ensure!(request["params"]==serde_json::json!([bitcoin::consensus::encode::serialize_hex(&tx)]),"redemption relay bytes changed");
+                    if *lose {continue;}
+                    serde_json::json!(tx.compute_txid())
+                },
+                "getrawtransaction"=>{ensure!(request["params"]==serde_json::json!([tx.compute_txid().to_string(),true,block.to_string()]),"wrong claim transaction");
+                    serde_json::json!({"in_active_chain":active,"hex":bitcoin::consensus::encode::serialize_hex(&tx),"txid":tx.compute_txid(),
+                        "hash":tx.compute_wtxid(),"blockhash":block,"confirmations":3})},
+                "getblockheader"=>serde_json::json!({"hash":block,"confirmations":3}),
+                _=>anyhow::bail!("unexpected claim RPC method"),
+            };
+            let bytes=serde_json::to_vec(&serde_json::json!({"id":request["id"],"error":null,"result":result}))?;
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",bytes.len())?;socket.write_all(&bytes)?;
+        }
+        Ok(())
+    });
+    Ok((crate::litecoin_rpc::LitecoinRpc::new(port,"fixture".into(),"fixture".into(),LtcNetwork::Regtest,"fixture".into(),anchor)?,block,stop,server))
+}
