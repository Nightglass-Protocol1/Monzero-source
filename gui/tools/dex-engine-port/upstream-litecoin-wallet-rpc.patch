+//! Single-lock exact-principal native payout preparation. Never broadcasts.
+use super::*;
+use zeroize::Zeroizing;
+
+/// Private prepared bytes require a durable journal and fresh outcome checks
+/// before relay. This type is not accepted by the legacy top-up relay path.
+pub struct PreparedLockPayout {
+    pub(in crate::native_funding_rpc) request:ExactNetRequest,
+    pub(in crate::native_funding_rpc) preview:ExactNetPreview,
+    pub(in crate::native_funding_rpc) terms:Value,
+    pub(in crate::native_funding_rpc) metadata:Zeroizing<String>,
+    pub(in crate::native_funding_rpc) tx_keys:Option<Zeroizing<String>>,
+}
+impl PreparedLockPayout {
+    pub fn preview(&self)->&ExactNetPreview {&self.preview}
+    pub fn terms(&self)->&Value {&self.terms}
+    pub(crate) fn into_parts(self)->(ExactNetRequest,Value,Zeroizing<String>) {
+        (self.request,self.terms,self.metadata)
+    }
+}
+
+/// Caller owns the dedicated restored wallet and derives the request from signed
+/// payout terms. Coincident recipients receive one combined payment; accounting
+/// still separates the signed principal, returned reserve and network fee.
+pub(crate) async fn prepare(client:&NativeFundingRpc,request:&ExactNetRequest,genesis:&str)->Result<PreparedLockPayout> {
+    let source=&request.source;
+    ensure!(source.account==0,"single-lock payout requires dedicated account zero");
+    let mut params=payout_params(request)?;
+    ensure!(hash(genesis) && genesis!="0".repeat(64) && hash(&source.lock_txid)
+        && source.lock_txid!="0".repeat(64),"invalid single-lock payout context");
+    let before=client.snapshot().await?;
+    ensure!(before.genesis==genesis && hash(&before.tip_hash),"unexpected native payout chain");
+    ensure!(client.opened_wallet(source.wallet.network()).await?.as_ref()==Some(&source.wallet),"unexpected native payout wallet");
+    let incoming=client.rpc(client.wallet,"incoming_transfers",
+        json!({"transfer_type":"available","account_index":source.account})).await?;
+    let inputs=lock_inputs(&incoming,source)?;
+    if source.destination!=request.reserve_return
+        && source.locked.atoms()-request.principal.atoms()==source.maximum_fee.atoms() {
+        // At the signed fee boundary a two-destination transfer cannot represent
+        // a zero reserve output. Probe the single-destination fee without keeping
+        // signing artifacts; choose it only when the principal remains exact.
+        let probe=client.rpc(client.wallet,"transfer",super::params(source)).await?;
+        let estimate=check_response(&probe,source,&inputs)?;
+        if estimate.network_fee==source.maximum_fee {params=super::params(source);}
+        revalidate_exact_net(client,&source.wallet,&before).await?;
+    }
+    params["get_tx_metadata"]=json!(true);
+    params["get_tx_key"]=json!(true);
+    let response=client.rpc(client.wallet,"transfer",params).await?;
+    let prepared=checked_response(response,request,genesis,&inputs)?;
+    revalidate_exact_net(client,&source.wallet,&before).await?;
+    Ok(prepared)
+}
+
+fn payout_params(request:&ExactNetRequest)->Result<Value> {
+    let source=&request.source;
+    let reserve=source.locked.atoms().checked_sub(request.principal.atoms())
+        .context("payout principal exceeds lock")?;
+    ensure!(request.principal.atoms()>0 && source.maximum_fee.atoms()>0
+        && reserve>=source.maximum_fee.atoms() && (1..=4).contains(&source.priority),"invalid payout principal or reserve");
+    ensure!(source.wallet.network()==source.destination.network()
+        && source.wallet.network()==request.reserve_return.network()
+        && source.wallet!=source.destination && source.wallet!=request.reserve_return,"invalid payout destinations");
+    if source.destination==request.reserve_return {return Ok(params(source));}
+    Ok(json!({"destinations":[
+        {"address":source.destination.to_string(),"amount":request.principal.atoms()},
+        {"address":request.reserve_return.to_string(),"amount":reserve}],
+        "account_index":source.account,"priority":source.priority,"unlock_time":0,
+        "subtract_fee_from_outputs":[1],"do_not_relay":true,
+        "get_tx_key":false,"get_tx_hex":false,"get_tx_metadata":false}))
+}
+
+fn checked_response(mut response:Value,request:&ExactNetRequest,genesis:&str,inputs:&BTreeSet<String>)->Result<PreparedLockPayout> {
+    let metadata=match response.get_mut("tx_metadata").map(Value::take) {
+        Some(Value::String(value))=>Zeroizing::new(value),
+        _=>anyhow::bail!("missing native payout metadata"),
+    };
+    ensure!(!metadata.is_empty() && metadata.len()<=524288 && metadata.len()%2==0
+        && metadata.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid native payout metadata");
+    let tx_keys=match response.get_mut("tx_key").map(Value::take) {
+        Some(Value::String(value))=>Zeroizing::new(value),
+        _=>anyhow::bail!("missing native payout proof keys"),
+    };
+    validate_tx_keys(&tx_keys)?;
+    response["tx_key"]=json!("");
+    response["tx_metadata"]=json!("");
+    ensure!(response["tx_hash"]!="0".repeat(64),"invalid native payout transaction identity");
+    let single=response["amounts_by_dest"]["amounts"].as_array().is_some_and(|v|v.len()==1);
+    let preview=if single {
+        let checked=check_response(&response,&request.source,inputs)?;
+        let returned=checked.recipient.atoms().checked_sub(request.principal.atoms())
+            .context("combined payout below signed principal")?;
+        ensure!(returned==0 || request.source.destination==request.reserve_return,
+            "single-destination payout redirected unused reserve");
+        ExactNetPreview {recipient:request.principal,reserve_return:XmzAmount::from_atoms(returned),network_fee:checked.network_fee}
+    } else {
+        ensure!(request.source.destination!=request.reserve_return,"combined payout has unexpected destination count");
+        check_exact_net(&response,request,inputs)?
+    };
+    let terms=accounting(request,genesis,&preview,response["tx_hash"].as_str().context("missing payout identity")?,number(&response,"weight")?);
+    Ok(PreparedLockPayout {request:request.clone(),preview,terms,metadata,tx_keys:Some(tx_keys)})
+}
+
+// Primary and additional transaction keys use canonical native secret scalars.
+// Bound the bundle independently of metadata; never put it in public accounting.
+fn validate_tx_keys(value:&str)->Result<()> {
+    // Two distinct destinations, or one combined destination plus the wallet
+    // dummy output: one primary key or primary plus two output keys.
+    ensure!(matches!(value.len(),64|192)
+        && value.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid native payout proof keys");
+    for scalar in value.as_bytes().chunks_exact(64) {
+        let text=std::str::from_utf8(scalar)?;
+        let mut bytes=Zeroizing::new([0u8;32]);
+        for (i,byte) in bytes.iter_mut().enumerate() {*byte=u8::from_str_radix(&text[i*2..i*2+2],16)?;}
+        let key=swap_core::monero::PrivateKey::from_slice(bytes.as_ref())
+            .map_err(|_|anyhow::anyhow!("invalid native payout proof scalar"))?;
+        ensure!(*bytes!=[0;32] && *Zeroizing::new(key.as_bytes())==*bytes,"noncanonical native payout proof scalar");
+    }
+    Ok(())
+}
+
+fn accounting(request:&ExactNetRequest,genesis:&str,preview:&ExactNetPreview,txid:&str,weight:u64)->Value {
+    let source=&request.source;
+    json!({"schema":"monzero-native-single-lock-payout-v1","genesis":genesis,
+        "wallet":source.wallet.to_string(),"lockTxid":source.lock_txid,"lockedAtoms":source.locked.atom_string(),
+        "payoutAtoms":request.principal.atom_string(),"destination":source.destination.to_string(),
+        "reserveReturn":request.reserve_return.to_string(),"reserveReturnAtoms":preview.reserve_return.atom_string(),
+        "maximumFeeAtoms":source.maximum_fee.atom_string(),"feeAtoms":preview.network_fee.atom_string(),
+        "account":source.account,"priority":source.priority,"txid":txid,"weight":weight})
+}
+
+mod checkpoint;
+
