+#[derive(Deserialize)]
+struct WalletTransaction {
+    txid: bitcoin::Txid, hex: String, confirmations: i64,
+    #[serde(default)] blockhash: Option<BlockHash>,
+}
+
+fn validate_observed_transaction(wallet: &WalletTransaction, reserved: &Psbt) -> Result<()> {
+    let mut transaction: bitcoin::Transaction = bitcoin::consensus::encode::deserialize_hex(&wallet.hex)?;
+    ensure!(wallet.txid == reserved.unsigned_tx.compute_txid() && transaction.compute_txid() == wallet.txid,
+        "Litecoin wallet returned a different transaction");
+    for input in &mut transaction.input { input.witness = bitcoin::Witness::new(); }
+    ensure!(transaction == reserved.unsigned_tx, "Litecoin observed funding differs from reserved transaction");
+    Ok(())
+}
