+//! Durable preparation only: no signing, broadcasting or automatic unlock.
+//! One canonical private directory must serve every trade using these wallets.
+//! Caller owns the wallets exclusively. Core coin locks are advisory and are
+//! restored from this journal after restart; they are not a consensus guarantee.
+use super::*;
+use serde::{Deserialize, Serialize};
+use std::{fs::{File, OpenOptions}, io::{Read, Write}, os::{fd::AsRawFd,
+    unix::fs::{MetadataExt, OpenOptionsExt}}, path::Path};
+use sha2::{Digest, Sha256};
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema: String, trade: uuid::Uuid, genesis: String, wallet: String, anchor: String,
+    contract: String, change: String, amount: u64, maximum_fee: u64, fee: u64, psbt: String,
+}
+
+/// Evidence at one chain tip, never authorization to replace or relay funds.
+/// Mempool state can change without a tip change. Unknown is not proof that the
+/// transaction was never broadcast; available inputs do not grant retry rights.
+/// WalletReportsConflict is the wallet's report, not independent conflict proof.
+/// ConfirmedOutput is chain UTXO evidence when full wallet history is absent.
+#[derive(Debug, Serialize)]
+#[serde(tag = "state", rename_all = "camelCase")]
+pub enum LockObservation {
+    Confirmed { txid: bitcoin::Txid, tip: BlockHash, block: BlockHash, confirmations: u64 },
+    Mempool { txid: bitcoin::Txid, tip: BlockHash },
+    WalletReportsConflict { txid: bitcoin::Txid, tip: BlockHash },
+    ConfirmedOutput { txid: bitcoin::Txid, tip: BlockHash, confirmations: u64 },
+    Unobserved { txid: bitcoin::Txid, tip: BlockHash, inputs_available: bool, wallet_has_transaction: bool },
+}
+
+/// A successfully restored reservation, not peer approval or signing authority.
+pub struct ReservedLock { preview: LockPreview }
+impl ReservedLock {
+    pub fn psbt(&self) -> &Psbt { &self.preview.psbt }
+}
+
+/// Holds a nonblocking process lock over the complete journal/RPC operation.
+pub(crate) struct Journal { directory: File }
+impl Journal {
+    pub(crate) fn open(path: &Path) -> Result<Self> {
+        ensure!(path.is_absolute() && path.canonicalize()? == path, "noncanonical Litecoin journal");
+        let directory = OpenOptions::new().read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC).open(path)?;
+        let metadata = directory.metadata()?;
+        ensure!(metadata.uid() == unsafe { libc::geteuid() } && metadata.mode() & 0o077 == 0,
+            "Litecoin journal must be private and owned");
+        ensure!(unsafe { libc::flock(directory.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } == 0,
+            "Litecoin journal is busy");
+        Ok(Self { directory })
+    }
+    fn file(&self, name: &str, flags: i32) -> Result<File> {
+        use std::os::fd::FromRawFd;
+        let name = std::ffi::CString::new(name)?;
+        let fd = unsafe { libc::openat(self.directory.as_raw_fd(), name.as_ptr(),
+            flags | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK, 0o600) };
+        if fd < 0 { return Err(std::io::Error::last_os_error().into()); }
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+    pub(crate) fn read(&self, name: &str) -> Result<Vec<u8>> {
+        let file = self.file(name, libc::O_RDONLY)?;
+        let metadata = file.metadata()?;
+        ensure!(metadata.is_file() && metadata.uid() == unsafe { libc::geteuid() }
+            && metadata.mode() & 0o077 == 0 && metadata.nlink() == 1 && metadata.len() <= 2_000_000,
+            "invalid Litecoin journal record");
+        let mut bytes = Vec::new(); file.take(2_000_001).read_to_end(&mut bytes)?;
+        ensure!(bytes.len() <= 2_000_000, "oversized Litecoin journal record");
+        Ok(bytes)
+    }
+    fn compatible(&self, name: &str, bytes: &[u8]) -> Result<()> {
+        match self.read(name) {
+            Ok(existing) => ensure!(existing == bytes, "conflicting or incomplete Litecoin reservation"),
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) => (),
+            Err(e) => return Err(e),
+        }
+        Ok(())
+    }
+    pub(crate) fn retain(&self, name: &str, bytes: &[u8]) -> Result<()> {
+        ensure!(bytes.len() <= 2_000_000, "oversized Litecoin intent");
+        self.compatible(name, bytes)?;
+        // Publish only complete, synced contents. A crash leaves either the
+        // original immutable record, a complete new record, or an unused temp.
+        let temporary = format!("{}.tmp", uuid::Uuid::new_v4());
+        let mut file = self.file(&temporary, libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL)?;
+        let source = std::ffi::CString::new(temporary)?;
+        if let Err(error) = file.write_all(bytes).and_then(|_| file.sync_all()) {
+            unsafe { libc::unlinkat(self.directory.as_raw_fd(), source.as_ptr(), 0); }
+            return Err(error.into());
+        }
+        let target = std::ffi::CString::new(name)?;
+        #[cfg(target_os = "linux")]
+        let status = unsafe { libc::renameat2(self.directory.as_raw_fd(), source.as_ptr(),
+            self.directory.as_raw_fd(), target.as_ptr(), libc::RENAME_NOREPLACE) };
+        #[cfg(not(target_os = "linux"))]
+        let status = { anyhow::bail!("atomic Litecoin reservation publication requires Linux") };
+        if status != 0 {
+            let error = std::io::Error::last_os_error();
+            unsafe { libc::unlinkat(self.directory.as_raw_fd(), source.as_ptr(), 0); }
+            if error.kind() != std::io::ErrorKind::AlreadyExists { return Err(error.into()); }
+            self.compatible(name, bytes)?;
+            self.file(name, libc::O_RDONLY)?.sync_all()?;
+        }
+        self.directory.sync_all()?;
+        Ok(())
+    }
+
+    #[cfg(target_os="linux")]
+    pub(crate) fn sync_execution_head(&self, trade: uuid::Uuid, expected: &[u8]) -> Result<()> {
+        let name=format!("{trade}.ltc-execution-head");
+        ensure!(self.read(&name)?==expected,"Litecoin execution head changed before sync");
+        self.file(&name,libc::O_RDONLY)?.sync_all()?;
+        self.directory.sync_all()?;
+        Ok(())
+    }
+
+    /// Only execution-head metadata is mutable. The directory flock makes the
+    /// comparison and atomic replacement exclusive across cooperative drivers.
+    #[cfg(target_os="linux")]
+    pub(crate) fn replace_execution_head(&self, trade: uuid::Uuid, expected: &[u8], replacement: &[u8]) -> Result<()> {
+        ensure!(!trade.is_nil() && replacement.len()<=4096,"invalid Litecoin execution head");
+        let name=format!("{trade}.ltc-execution-head");
+        ensure!(self.read(&name)?==expected,"Litecoin execution head changed");
+        let temporary=std::ffi::CString::new(format!("{}.tmp",uuid::Uuid::new_v4()))?;
+        let mut file=self.file(temporary.to_str()?,libc::O_WRONLY|libc::O_CREAT|libc::O_EXCL)?;
+        if let Err(error)=file.write_all(replacement).and_then(|_|file.sync_all()) {
+            unsafe { libc::unlinkat(self.directory.as_raw_fd(),temporary.as_ptr(),0); }
+            return Err(error.into());
+        }
+        let target=std::ffi::CString::new(name)?;
+        if unsafe { libc::renameat2(self.directory.as_raw_fd(),temporary.as_ptr(),self.directory.as_raw_fd(),target.as_ptr(),0) }!=0 {
+            let error=std::io::Error::last_os_error();
+            unsafe { libc::unlinkat(self.directory.as_raw_fd(),temporary.as_ptr(),0); }
+            return Err(error.into());
+        }
+        self.directory.sync_all()?;
+        Ok(())
+    }
+
+}
+
+impl LitecoinRpc {
+    /// Persist exact preparation and exclusive input claims before locking Core
+    /// coins. An error retains any written records: no replacement or repricing.
+    pub async fn reserve_lock(&self, directory: &Path, trade: uuid::Uuid,
+        contract: &LtcSegwitAddress, amount: Amount, maximum_fee: Amount,
+        preview: &LockPreview) -> Result<ReservedLock> {
+        ensure!(!trade.is_nil() && contract.network() == self.network && contract.script_pubkey().is_p2wsh(),
+            "invalid Litecoin reservation identity");
+        let intent = Intent { schema: "monzero-ltc-reservation-v1".into(), trade,
+            genesis: self.network.genesis().into(), wallet: self.wallet.clone(), anchor: self.anchor.to_string(),
+            contract: contract.to_string(), change: LtcSegwitAddress::from_script(self.network, &preview.change)?.to_string(),
+            amount: amount.to_sat(), maximum_fee: maximum_fee.to_sat(), fee: preview.fee.to_sat(), psbt: preview.psbt.to_string() };
+        let validated = self.validate_intent(&intent)?;
+        let journal = Journal::open(directory)?;
+        journal.retain(&format!("{trade}.intent"), &serde_json::to_vec(&intent)?)?;
+        self.restore_reservation(&journal, &intent, validated).await
+    }
+
+    /// Reopen only the original immutable intent. Wallet restart cannot approve
+    /// new inputs, fees or outputs. Missing/spent inputs require reconciliation.
+    pub async fn resume_lock(&self, directory: &Path, trade: uuid::Uuid) -> Result<ReservedLock> {
+        ensure!(!trade.is_nil(), "invalid Litecoin trade");
+        let journal = Journal::open(directory)?;
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade, "Litecoin reservation trade mismatch");
+        let preview = self.validate_intent(&intent)?;
+        self.restore_reservation(&journal, &intent, preview).await
+    }
+
+    /// Inspect the exact reserved transaction after an ambiguous broadcast or
+    /// restart, even if its contract output has already been spent. Read-only.
+    pub async fn observe_lock(&self, directory: &Path, trade: uuid::Uuid) -> Result<LockObservation> {
+        ensure!(!trade.is_nil(), "invalid Litecoin trade");
+        let journal = Journal::open(directory)?;
+        let intent: Intent = serde_json::from_slice(&journal.read(&format!("{trade}.intent"))?)?;
+        ensure!(intent.trade == trade, "Litecoin reservation trade mismatch");
+        let preview = self.validate_intent(&intent)?;
+        let txid = preview.psbt.unsigned_tx.compute_txid();
+        let owner = format!("{trade}:{txid}");
+        for input in &preview.psbt.unsigned_tx.input {
+            let key = format!("{}:{}", intent.genesis, input.previous_output);
+            ensure!(journal.read(&format!("{:x}.input", Sha256::digest(key.as_bytes())))? == owner.as_bytes(),
+                "Litecoin observation input claim mismatch");
+        }
+        self.wallet_ready().await?;
+        let tip = self.chain().await?;
+        let raw = self.rpc_lookup(true, "gettransaction", json!([txid.to_string()]), true).await?;
+        let wallet = raw.map(|r| serde_json::from_str::<WalletTransaction>(r.get())).transpose()?;
+        if let Some(wallet) = &wallet { validate_observed_transaction(wallet, &preview.psbt)?; }
+        let wallet_has_transaction = wallet.is_some();
+        let observation = match wallet {
+            Some(wallet) if wallet.confirmations > 0 => {
+                let block = wallet.blockhash.context("confirmed Litecoin lock lacks block identity")?;
+                #[derive(Deserialize)] struct Header { hash: BlockHash, confirmations: i64 }
+                let header: Header = serde_json::from_str(self.rpc(false, "getblockheader", json!([block.to_string(), true])).await?.get())?;
+                ensure!(header.hash == block && header.confirmations == wallet.confirmations,
+                    "Litecoin lock confirmation evidence disagrees");
+                LockObservation::Confirmed { txid, tip, block, confirmations: wallet.confirmations as u64 }
+            }
+            Some(wallet) if wallet.confirmations < 0 => LockObservation::WalletReportsConflict { txid, tip },
+            _ => {
+                let pool = self.rpc_lookup(false, "getmempoolentry", json!([txid.to_string()]), true).await?;
+                if let Some(pool) = pool {
+                    let value: Value = serde_json::from_str(pool.get())?;
+                    let _: bitcoin::Wtxid = value["wtxid"].as_str().context("missing Litecoin mempool witness identity")?.parse()?;
+                    LockObservation::Mempool { txid, tip }
+                } else {
+                    let contract = LtcSegwitAddress::parse(self.network, &intent.contract)?;
+                    let vout = preview.psbt.unsigned_tx.output.iter().position(|o| o.script_pubkey == *contract.script_pubkey())
+                        .context("missing reserved contract output")? as u32;
+                    if let Some(output) = self.unspent(OutPoint { txid, vout }).await? {
+                        ensure!(output.tip == tip && output.amount.to_sat() == intent.amount
+                            && output.script == *contract.script_pubkey(), "Litecoin lock UTXO differs from reservation");
+                        ensure!(self.chain().await? == tip, "Litecoin tip changed during lock reconciliation");
+                        return Ok(LockObservation::ConfirmedOutput { txid, tip, confirmations: output.confirmations });
+                    }
+                    let mut inputs_available = true;
+                    for (input, metadata) in preview.psbt.unsigned_tx.input.iter().zip(&preview.psbt.inputs) {
+                        let output = self.unspent(input.previous_output).await?;
+                        let expected = metadata.witness_utxo.as_ref().context("missing Litecoin reserved UTXO")?;
+                        if let Some(output) = output {
+                            ensure!(output.tip == tip && output.amount == expected.value && output.script == expected.script_pubkey,
+                                "Litecoin observation input metadata differs");
+                            let current = self.rpc(false, "gettxout", json!([input.previous_output.txid.to_string(), input.previous_output.vout, true])).await?;
+                            inputs_available &= current.get() != "null";
+                        } else { inputs_available = false; }
+                    }
+                    // Detect a lock which entered the mempool while probing
+                    // inputs. This still is point-in-time evidence, not a lease.
+                    if let Some(pool) = self.rpc_lookup(false, "getmempoolentry", json!([txid.to_string()]), true).await? {
+                        let value: Value = serde_json::from_str(pool.get())?;
+                        let _: bitcoin::Wtxid = value["wtxid"].as_str().context("missing Litecoin mempool witness identity")?.parse()?;
+                        LockObservation::Mempool { txid, tip }
+                    } else {
