+//! Exporter for a caller-owned disposable Litecoin regtest wallet.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{Amount, OutPoint};
+use serde::Deserialize;
+use serde_json::json;
+use std::{io::{Read, Write}, os::unix::fs::OpenOptionsExt};
+use swap_core::litecoin_address::{LtcNetwork, LtcSegwitAddress};
+use swap_machine::litecoin_rpc::LitecoinRpc;
+use zeroize::Zeroizing;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all="camelCase")]
+struct Request {
+    port: u16, wallet: String, anchor: String, contract: String,
+    amount_atoms: u64, fee_rate_atoms_per_kb: u64, maximum_fee_atoms: u64,
