+        match action {
+            RefundAction::Send=>self.relay_native_refund_payout(native,ltc,block).await,
+            RefundAction::Retransmit=>self.retransmit_native_refund_payout(native,ltc,block).await,
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn refund_approval_binds_payment_action_and_journal_context()->Result<()> {
+        let original=serde_json::json!({"schema":"monzero-ltc-native-refund-review-v1","tradeId":"trade-a",
+            "quoteCommitment":"quote-a","journalCommitment":"head-a","preparedCommitment":"prepared-a",
+            "dispatchCommitment":null,"action":"send","txid":"tx-a","destination":"recipient-a",
+            "refundAtoms":"108","feeAtoms":"2","maximumFeeAtoms":"3","lockedAtoms":"110","chainObserved":false});
+        let expected=commitment(&original)?;
+        for key in original.as_object().unwrap().keys() {
+            let mut modified=original.clone();modified[key]=serde_json::json!("changed");
+            assert_ne!(commitment(&modified)?,expected,"unbound field {key}");
+        }
+        let mut retry=original.clone();retry["action"]=serde_json::json!(RefundAction::Retransmit.label());
+        assert_ne!(commitment(&retry)?,expected);
+        assert_eq!(commitment(&original)?,expected);
+        Ok(())
+    }
+}
