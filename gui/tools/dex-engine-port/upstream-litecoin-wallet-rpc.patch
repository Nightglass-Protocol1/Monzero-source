+//! Redeem signature encoding and verification. Creation remains crate-private:
+//! the driver must first gate release on fresh evidence from both chains and
+//! retain the outgoing frame before returning it for transport.
+use super::*;
+
+const DOMAIN:&str="monzero-ltc-xmz-redeem-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    schema:String,binding:Binding,redeem:bitcoin::Txid,native_txid:String,
+    encrypted:contract::EncryptedSignature,
+}
+pub struct SignedRedeem { bytes:Vec<u8>,signature:[u8;64] }
+impl SignedRedeem {
+    pub(crate) fn from_verified(bytes:Vec<u8>,signature:[u8;64])->Self { Self { bytes,signature } }
+    pub fn bytes(&self)->&[u8] { &self.bytes }
+    pub fn signature(&self)->&[u8;64] { &self.signature }
+}
+fn check_txid(txid:&str)->Result<()> {
+    ensure!(txid.len()==64 && txid!="0".repeat(64)
+        && txid.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid native funding transaction identity");
+    Ok(())
+}
+fn signing_bytes(bytes:&[u8])->Result<Vec<u8>> {
+    ensure!(!bytes.is_empty() && bytes.len()<=MAX_FRAME,"invalid redeem frame size");
+    let mut result=DOMAIN.as_bytes().to_vec();result.push(0);
+    result.extend_from_slice(&(bytes.len() as u64).to_be_bytes());result.extend_from_slice(bytes);
+    Ok(result)
+}
+impl RecoveryPlan {
+    pub(crate) fn redeem_txid(&self)->bitcoin::Txid { self.redeem.txid() }
+    pub(crate) fn prepare_redeem(&self,local:&LocalKeys,identity:&SigningKey,native_txid:&str)->Result<SignedRedeem> {
+        self.check_local(local,0)?;
+        ensure!(identity.verifying_key()==self.pins[0],"wrong redeem signing identity");
+        check_txid(native_txid)?;
+        let frame=Frame { schema:DOMAIN.into(),binding:self.binding.clone(),redeem:self.redeem.txid(),
+            native_txid:native_txid.into(),encrypted:local.contract_secret().encsign(self.adaptors[1],self.redeem.digest()) };
+        let bytes=canonical(&frame)?;let signature=identity.sign(&signing_bytes(&bytes)?).to_bytes();
+        Ok(SignedRedeem { bytes,signature })
+    }
+
+    pub(crate) fn checked_redeem(&self,native_txid:&str,bytes:&[u8],signature:&[u8])->Result<contract::EncryptedSignature> {
+        check_txid(native_txid)?;
+        self.pins[0].verify_strict(&signing_bytes(bytes)?,&ed25519_dalek::Signature::from_slice(signature)?)?;
+        let frame:Frame=serde_json::from_slice(bytes)?;
+        ensure!(canonical(&frame)?==bytes && frame.schema==DOMAIN && frame.binding==self.binding
+            && frame.redeem==self.redeem.txid() && frame.native_txid==native_txid,
+            "redeem signature differs from agreed trade or native funding");
+        contract::verify_encsig(self.keys[0],self.adaptors[1],&self.redeem.digest(),&frame.encrypted)?;
+        Ok(frame.encrypted)
+    }
+
+    /// The caller must derive native_txid from its own retained funding operation,
+    /// not from the received message. Completion is not relay authorization.
+    pub fn complete_redeem(self,local:&LocalKeys,native_txid:&str,bytes:&[u8],signature:&[u8])->Result<Transaction> {
+        self.check_local(local,1)?;
+        let encrypted=self.checked_redeem(native_txid,bytes,signature)?;
+        self.redeem.complete(encrypted,local.contract_secret().clone(),
+            local.native_spend_secret().to_secpfun_scalar(),self.keys[0])
+    }
+}
+
+#[cfg(test)]
+pub(super) fn corrupt_signature(plan:&RecoveryPlan,local:&LocalKeys,identity:&SigningKey,native_txid:&str)->Result<SignedRedeem> {
+    let frame=Frame { schema:DOMAIN.into(),binding:plan.binding.clone(),redeem:plan.redeem.txid(),native_txid:native_txid.into(),
+        encrypted:local.contract_secret().encsign(plan.adaptors[1],plan.refund.digest()) };
+    let bytes=canonical(&frame)?;let signature=identity.sign(&signing_bytes(&bytes)?).to_bytes();
+    Ok(SignedRedeem { bytes,signature })
+}
