+#[tokio::test]
+async fn sequential_rpc_calls_do_not_reuse_idle_connections() -> Result<()> {
+    use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},time::{Duration,Instant}};
+    let listener=TcpListener::bind("127.0.0.1:0")?;
+    let port=listener.local_addr()?.port();
+    listener.set_nonblocking(true)?;
+    let server=std::thread::spawn(move || -> std::io::Result<()> {
+        let mut retained=Vec::new();
+        for id in 0..2 {
+            let deadline=Instant::now()+Duration::from_secs(5);
+            let (mut socket,_)=loop {
+                match listener.accept() {
+                    Ok(value)=>break value,
+                    Err(e) if e.kind()==std::io::ErrorKind::WouldBlock && Instant::now()<deadline=>{
+                        std::thread::sleep(Duration::from_millis(5));
+                    },
+                    Err(e)=>return Err(e),
+                }
+            };
+            socket.set_read_timeout(Some(Duration::from_secs(5)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);
+            let mut size=0usize;
+            loop {
+                let mut line=String::new();reader.read_line(&mut line)?;
+                if line=="\r\n" { break; }
+                if let Some(value)=line.to_ascii_lowercase().strip_prefix("content-length:") {
+                    size=value.trim().parse().unwrap();
+                }
+            }
+            assert!(size<4096);
+            reader.read_exact(&mut vec![0;size])?;
+            let body=json!({"id":id,"error":null,"result":"ok"}).to_string();
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: keep-alive\r\n\r\n{}",body.len(),body)?;
+            // Keep the previous connection open but serve each request only on
+            // a newly accepted socket. Reusing idle transport makes this fail.
+            retained.push(socket);
+        }
+        Ok(())
+    });
+    let anchor=LtcSegwitAddress::from_script(LtcNetwork::Regtest,&script(1,20))?;
+    let rpc=LitecoinRpc::new(port,"fixture".into(),"fixture".into(),LtcNetwork::Regtest,"fixture".into(),anchor)?;
+    let first=rpc.rpc(false,"getblockcount",json!([])).await;
+    std::thread::sleep(Duration::from_millis(50));
+    let second=rpc.rpc(false,"getblockcount",json!([])).await;
+    server.join().unwrap()?;
+    assert_eq!(first?.get(),"\"ok\"");
+    assert_eq!(second?.get(),"\"ok\"");
+    Ok(())
+}
