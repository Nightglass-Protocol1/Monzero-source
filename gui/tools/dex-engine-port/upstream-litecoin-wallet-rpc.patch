+//! Exact-byte payout primitives. Only the execution owner may authorize dispatch.
+use super::*;
+use crate::native_funding_rpc::full_proceeds::lock_payout::PreparedLockPayout;
+
+fn summary(prepared:&PreparedLockPayout)->Result<RelayedTransfer> {
+    Ok(RelayedTransfer {txid:string(&prepared.terms,"txid")?,fee:prepared.preview.network_fee,
+        weight:number(&prepared.terms,"weight")?})
+}
+impl NativeTransferRelay {
+    pub(crate) async fn preflight_native_payout(&self,prepared:&PreparedLockPayout)->Result<()> {
+        ensure!(!self.dispatched,"native payout already dispatched; reconcile before retrying");
+        let before=self.client.snapshot().await?;
+        ensure!(prepared.terms["genesis"]==before.genesis && canonical_hash(&before.tip_hash),"unexpected native payout chain");
+        let wallet=&prepared.request.source.wallet;
+        ensure!(self.client.opened_wallet(wallet.network()).await?.as_ref()==Some(wallet),"unexpected native payout wallet");
+        ensure!(self.client.snapshot().await?==before,"native chain changed during payout preflight");
+        // Do not require unused inputs/balance: an earlier uncertain broadcast
+        // may have spent them. Only the retained transaction may be retransmitted.
+        Ok(())
+    }
+
+    /// The owner must first persist dispatch intent and reobserve the exact LTC
+    /// redemption. This instance becomes occupied before awaiting the wallet.
+    pub(crate) async fn dispatch_native_payout(&mut self,prepared:&PreparedLockPayout)->Result<RelayedTransfer> {
+        ensure!(!self.dispatched,"native payout already dispatched; reconcile before retrying");
+        // The owner's LTC observation and journal fsyncs may have taken time
+        // since preflight. Recheck the current native wallet/chain at dispatch.
+        self.preflight_native_payout(prepared).await?;
+        let summary=summary(prepared)?;
+        self.dispatched=true;
+        classify_prepared_broadcast(self.client.rpc(self.client.wallet,"relay_tx",
+            json!({"hex":prepared.metadata.as_str()})).await,summary)
+    }
+
+    /// Current authenticated source-wallet evidence, not a cached relay receipt.
+    /// No construction, replacement, or automatic retransmission occurs here.
+    pub(crate) async fn confirm_native_payout(&self,prepared:&PreparedLockPayout,minimum:u64)->Result<u64> {
+        ensure!(minimum>0,"zero payout confirmation requirement");
+        let before=self.client.snapshot().await?;
+        ensure!(prepared.terms["genesis"]==before.genesis && canonical_hash(&before.tip_hash),"unexpected native payout chain");
+        let request=&prepared.request.source;
+        ensure!(self.client.opened_wallet(request.wallet.network()).await?.as_ref()==Some(&request.wallet),"unexpected native payout wallet");
+        let confirmations=if let Some(keys)=&prepared.tx_keys {
+            // Older daemon RPC versions make wallet proof depth depend on a
+            // cached height. Require transaction-specific daemon confirmations.
+            let version=self.client.rpc(self.client.daemon,"get_version",json!({})).await?;
+            ensure!(number(&version,"version")?>=(3u64<<16|7),"native payout proof requires daemon RPC 3.7 or newer");
+            let payout=self.client.rpc(self.client.wallet,"check_tx_key",json!({"txid":prepared.terms["txid"],
+                "tx_key":keys.as_str(),"address":request.destination.to_string()})).await?;
+            let reserve=self.client.rpc(self.client.wallet,"check_tx_key",json!({"txid":prepared.terms["txid"],
+                "tx_key":keys.as_str(),"address":prepared.request.reserve_return.to_string()})).await?;
+            checked_payment_proofs(&payout,&reserve,prepared,before.tip_height,minimum)?
+        } else {
+            // Legacy checkpoints have no retained proof bundle. Preserve their
+            // strict history checks; never silently invent keys or replace bytes.
+            let response=self.client.rpc(self.client.wallet,"get_transfer_by_txid",
+                json!({"txid":prepared.terms["txid"],"account_index":request.account})).await?;
+            checked_history(&response["transfer"],prepared,before.tip_height,minimum)?
+        };
+        ensure!(self.client.opened_wallet(request.wallet.network()).await?.as_ref()==Some(&request.wallet),"native payout wallet changed");
+        ensure!(self.client.snapshot().await?==before,"native chain changed during payout reconciliation");
+        Ok(confirmations)
+    }
+}
+fn checked_payment_proofs(payout:&Value,reserve:&Value,prepared:&PreparedLockPayout,tip:u64,minimum:u64)->Result<u64> {
+    let confirmations=number(payout,"confirmations")?;
+    let combined=prepared.request.source.destination==prepared.request.reserve_return;
+    let payout_atoms=if combined {prepared.preview.recipient.atoms().checked_add(prepared.preview.reserve_return.atoms())
+        .context("combined payout overflow")?} else {prepared.preview.recipient.atoms()};
+    let reserve_atoms=if combined {payout_atoms} else {prepared.preview.reserve_return.atoms()};
+    ensure!(minimum>0 && confirmations>=minimum && confirmations<=tip
+        && number(reserve,"confirmations")?==confirmations && payout["in_pool"]==false && reserve["in_pool"]==false
+        && number(payout,"received")?==payout_atoms
+        && number(reserve,"received")?==reserve_atoms,"native payout payment proofs differ from saved terms");
+    Ok(confirmations)
+}
+
+fn checked_history(observed:&Value,prepared:&PreparedLockPayout,tip:u64,minimum:u64)->Result<u64> {
+    ensure!(minimum>0,"zero payout confirmation requirement");
+    let request=&prepared.request;let preview=&prepared.preview;
+    let amount=preview.recipient.atoms().checked_add(preview.reserve_return.atoms()).context("payout amount overflow")?;
+    ensure!(observed["type"]=="out" && observed["txid"]==prepared.terms["txid"]
+        && number(observed,"amount")?==amount && number(observed,"fee")?==preview.network_fee.atoms()
+        && number(observed,"unlock_time")?==0 && number(&observed["subaddr_index"],"major")?==u64::from(request.source.account),
+        "native payout history differs from saved payment");
+    let mut actual=std::collections::BTreeMap::new();
+    for item in observed["destinations"].as_array().context("missing payout destinations")? {
+        let address=string(item,"address")?;
+        ensure!(actual.insert(address,number(item,"amount")?).is_none(),"duplicate payout history destination");
+    }
+    let expected=if request.source.destination==request.reserve_return {
+        std::collections::BTreeMap::from([(request.source.destination.to_string(),amount)])
+    } else {
+        std::collections::BTreeMap::from([(request.source.destination.to_string(),preview.recipient.atoms()),
+            (request.reserve_return.to_string(),preview.reserve_return.atoms())])
+    };
+    ensure!(actual==expected,"native payout destinations differ from saved payment");
+    let height=number(observed,"height")?;let confirmations=number(observed,"confirmations")?;
+    ensure!(height>0 && confirmations>=minimum && tip.checked_sub(height).and_then(|v|v.checked_add(1))==Some(confirmations),
+        "native payout is not sufficiently confirmed");
+    Ok(confirmations)
+}
