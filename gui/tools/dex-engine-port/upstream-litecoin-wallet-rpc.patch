+//! Alice's durable completed-redemption submission and fresh reconciliation.
+use super::*;
+use crate::{litecoin_rpc::LitecoinRpc,native_funding_rpc::relay::NativeTransferRelay};
+use bitcoin::{Transaction,Txid,Wtxid,BlockHash};
+
+#[derive(Debug,PartialEq,Eq)]
+pub enum RedeemRelayOutcome { Acknowledged {txid:Txid}, Uncertain {txid:Txid} }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Dispatch {schema:String,trade:uuid::Uuid,quote:[u8;32],checkpoint:[u8;32],completed:[u8;32],txid:Txid,wtxid:Wtxid}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Receipt {schema:String,dispatch:[u8;32],txid:Txid}
+pub(super) fn dispatch_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-redeem-dispatch")}
+pub(super) fn receipt_name(trade:uuid::Uuid)->String {format!("{trade}.ltc-redeem-receipt")}
+fn dispatch_bytes(head:&Head,transaction:&Transaction)->Result<Vec<u8>> {
+    serde_json::to_vec(&Dispatch {schema:"monzero-ltc-redeem-dispatch-v1".into(),trade:head.trade,quote:head.quote,
+        checkpoint:head.checkpoint,completed:head.redeem_completed.context("missing committed redemption")?,
+        txid:transaction.compute_txid(),wtxid:transaction.compute_wtxid()}).map_err(Into::into)
+}
+impl Execution {
+    /// First submission requires currently confirmed native funding. The saved
+    /// peer release and completed transaction are revalidated before any RPC.
+    pub async fn relay_completed_redeem(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc)->Result<RedeemRelayOutcome> {
+        self.submit_completed_redeem(native,ltc,false).await
+    }
+    /// Explicit retry submits only the retained bytes. Already-mined or pooled
+    /// transactions should be reconciled, not replaced or re-signed.
+    pub async fn retransmit_completed_redeem(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc)->Result<RedeemRelayOutcome> {
+        self.submit_completed_redeem(native,ltc,true).await
+    }
+    async fn submit_completed_redeem(&mut self,native:&NativeTransferRelay,ltc:&LitecoinRpc,retry:bool)->Result<RedeemRelayOutcome> {
+        let transaction=self.recover_completed_redeem()?;
+        self.reconcile_native_lock(native).await?;
+        let (mut head,previous,_,_,_)=self.load()?;
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong redemption Litecoin network");
+        let bytes=dispatch_bytes(&head,&transaction)?;
+        let digest:[u8;32]=Sha256::digest(&bytes).into();
+        match self.metadata.read(&dispatch_name(self.claim.trade)) {
+            Ok(saved)=>{
+                ensure!(retry,"redemption already attempted; reconcile or explicitly retry");
+                ensure!(saved==bytes,"redemption dispatch context changed");
+            },
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+                ensure!(!retry && head.redeem_dispatch.is_none(),"missing redemption dispatch");
+            },
+            Err(e)=>return Err(e),
+        }
+        if let Some(pin)=head.redeem_dispatch {ensure!(pin==digest,"redemption dispatch differs from head");}
+        ltc.preflight_contract_spend(&transaction).await?;
+        self.metadata.retain(&dispatch_name(self.claim.trade),&bytes)?;
+        head.redeem_dispatch=Some(digest);
+        let dispatched_head=serde_json::to_vec(&head)?;
+        self.metadata.replace_execution_head(self.claim.trade,&previous,&dispatched_head)?;
+        let txid=transaction.compute_txid();
+        if !ltc.dispatch_contract_spend(&transaction).await {return Ok(RedeemRelayOutcome::Uncertain {txid});}
+        let receipt=serde_json::to_vec(&Receipt {schema:"monzero-ltc-redeem-receipt-v1".into(),dispatch:digest,txid})?;
+        self.metadata.retain(&receipt_name(self.claim.trade),&receipt)?;
+        head.redeem_receipt=Some(Sha256::digest(&receipt).into());
+        self.metadata.replace_execution_head(self.claim.trade,&dispatched_head,&serde_json::to_vec(&head)?)?;
+        Ok(RedeemRelayOutcome::Acknowledged {txid})
+    }
+    /// A receipt never substitutes for fresh chain evidence. A reorg may change
+    /// the witness while retaining the exact redemption's transaction effects.
+    pub async fn reconcile_completed_redeem(&mut self,ltc:&LitecoinRpc,block:BlockHash)->Result<u64> {
+        let transaction=self.recover_completed_redeem()?;
+        let (head,_,quote,_,_)=self.load()?;
+        let bytes=dispatch_bytes(&head,&transaction)?;
+        ensure!(head.redeem_dispatch==Some(Sha256::digest(&bytes).into())
+            && self.metadata.read(&dispatch_name(self.claim.trade))?==bytes,"redemption lacks committed dispatch");
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong redemption reconciliation network");
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.confirmed_transaction(transaction.compute_txid(),block,minimum).await?;
+        ensure!(super::redeem::same_redemption_effect(&transaction,observed.transaction()),"observed redemption differs from agreement");
+        Ok(observed.confirmations())
+    }
+}
