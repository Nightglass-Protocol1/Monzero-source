+use super::*;
+use bitcoin::{Sequence, Transaction, TxIn, TxOut, Txid, Witness, absolute, transaction};
+use bitcoin::hashes::Hash;
+
+fn script(tag: u8, size: usize) -> ScriptBuf {
+    ScriptBuf::new_witness_program(&bitcoin::WitnessProgram::new(bitcoin::WitnessVersion::V0,
+        &vec![tag; size]).unwrap())
+}
+pub(super) fn fixture() -> Psbt {
+    let tx = Transaction {
+        version: transaction::Version::TWO, lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn { previous_output: OutPoint { txid: Txid::from_byte_array([1;32]), vout:0 },
+            script_sig: ScriptBuf::new(), sequence: Sequence::MAX, witness: Witness::new() }],
+        output: vec![TxOut { value:Amount::from_sat(90_000), script_pubkey:script(2,32) },
+            TxOut { value:Amount::from_sat(9_000), script_pubkey:script(3,20) }],
+    };
+    let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+    psbt.inputs[0].witness_utxo = Some(TxOut { value:Amount::from_sat(100_000), script_pubkey:script(1,20) });
+    psbt
+}
+fn validate(psbt: Psbt, fee: &str, changepos: i32, ceiling: u64) -> Result<LockPreview> {
+    validate_preview(Funded { psbt:psbt.to_string(), fee:RawValue::from_string(fee.to_owned()).unwrap(), changepos },
+        &script(2,32), &script(3,20), Amount::from_sat(90_000), Amount::from_sat(ceiling))
+}
