+//! Read-only observations from a caller-authenticated, loopback Dogecoin Core node.
+//! RPC shape follows dogecoin/dogecoin v1.14.9 src/rpc/{blockchain,rawtransaction}.cpp.
+//! This boundary neither signs nor broadcasts and cannot authorize settlement.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{BlockHash, Transaction, Txid, consensus::encode::{deserialize, serialize_hex}, hex::FromHex};
+use serde::{Deserialize, de::DeserializeOwned};
+use serde_json::{Value, json, value::RawValue};
+use std::sync::atomic::{AtomicU64, Ordering};
+use swap_core::dogecoin::DogeNetwork;
+use zeroize::Zeroizing;
+
+pub struct DogecoinRpc {
+    client: reqwest::Client,
+    port: u16,
+    username: Zeroizing<String>,
+    password: Zeroizing<String>,
+    network: DogeNetwork,
+    request_id: AtomicU64,
+}
+
+/// Ephemeral evidence; cannot be manufactured by deserializing peer input.
+/// A later operation must reobserve it, especially following a reorganisation.
+pub struct ConfirmedTransaction {
+    network: DogeNetwork,
+    tip: BlockHash,
+    block: BlockHash,
+    confirmations: u64,
+    transaction: Transaction,
+}
+impl ConfirmedTransaction {
+    pub fn network(&self) -> DogeNetwork { self.network }
+    pub fn tip(&self) -> BlockHash { self.tip }
+    pub fn block(&self) -> BlockHash { self.block }
+    pub fn confirmations(&self) -> u64 { self.confirmations }
+    pub fn transaction(&self) -> &Transaction { &self.transaction }
+}
+
+#[derive(Deserialize)]
+struct Envelope { id: u64, error: Option<Value>, result: Box<RawValue> }
+#[derive(Deserialize)]
+struct ChainInfo {
+    chain: String, bestblockhash: BlockHash, blocks: u64, headers: u64,
+    initialblockdownload: bool,
+}
+#[derive(Deserialize)]
+struct RawTransaction {
+    hex: String, txid: Txid, hash: Txid, blockhash: BlockHash, confirmations: u64,
+}
+#[derive(Deserialize)]
+struct Header { hash: BlockHash, height: u64, confirmations: i64 }
+
+impl DogecoinRpc {
+    /// The caller authenticates ownership of the service before handing over
+    /// credentials. Matching chain data does not authenticate the listening process.
+    pub fn new(port: u16, username: String, password: String, network: DogeNetwork) -> Result<Self> {
+        let username = Zeroizing::new(username);
+        let password = Zeroizing::new(password);
+        ensure!(port != 0 && !username.is_empty() && !password.is_empty()
+            && username.len() + password.len() <= 1024 && !username.contains(':'),
+            "invalid Dogecoin RPC credentials or port");
+        let client = reqwest::Client::builder().no_proxy().pool_max_idle_per_host(0)
+            .redirect(reqwest::redirect::Policy::none())
+            .timeout(std::time::Duration::from_secs(15)).build()?;
+        Ok(Self { client, port, username, password, network, request_id: AtomicU64::new(0) })
+    }
+
+    async fn rpc<T: DeserializeOwned>(&self, method: &str, params: Value) -> Result<T> {
+        ensure!(matches!(method, "getblockchaininfo" | "getblockhash" | "getrawtransaction" | "getblockheader"),
+            "unsupported Dogecoin observation RPC");
+        let id = self.request_id.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |v| v.checked_add(1))
+            .map_err(|_| anyhow::anyhow!("Dogecoin RPC identity exhausted"))?;
+        let mut response = self.client.post(format!("http://127.0.0.1:{}", self.port))
+            .basic_auth(self.username.as_str(), Some(self.password.as_str()))
+            .json(&json!({"jsonrpc":"1.0", "id":id, "method":method, "params":params}))
+            .send().await.map_err(|_| anyhow::anyhow!("Dogecoin local RPC transport failed"))?;
+        ensure!(response.status().is_success(), "Dogecoin local RPC HTTP rejection");
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| anyhow::anyhow!("Dogecoin RPC body failed"))? {
+            ensure!(bytes.len() + chunk.len() <= 2_000_000, "oversized Dogecoin RPC response");
+            bytes.extend_from_slice(&chunk);
+        }
+        let reply: Envelope = serde_json::from_slice(&bytes).context("invalid Dogecoin RPC envelope")?;
+        ensure!(reply.id == id && reply.error.is_none(), "Dogecoin RPC rejection or identity mismatch");
+        serde_json::from_str(reply.result.get()).context("invalid Dogecoin RPC result")
+    }
+
+    async fn chain(&self) -> Result<ChainInfo> {
+        let info: ChainInfo = self.rpc("getblockchaininfo", json!([])).await?;
+        let genesis: String = self.rpc("getblockhash", json!([0])).await?;
+        self.network.verify_chain(&info.chain, &genesis)?;
+        ensure!(!info.initialblockdownload && info.blocks == info.headers, "Dogecoin node is not synchronized");
+        Ok(info)
+    }
+
+    /// Requires the node's transaction index for spent historical transactions.
+    /// An expected block is a binding, not evidence of active-chain membership.
+    /// Does not prove unspentness, CLTV activation, maturity or swap completion.
+    pub async fn confirmed_transaction(&self, txid: Txid, block: BlockHash, minimum: u64) -> Result<ConfirmedTransaction> {
+        ensure!(minimum > 0, "zero Dogecoin confirmation requirement");
+        let before = self.chain().await?;
+        // Dogecoin 1.14.9 accepts only txid and verbose, unlike Litecoin's block argument.
+        let raw: RawTransaction = self.rpc("getrawtransaction", json!([txid.to_string(), true])).await?;
+        let header: Header = self.rpc("getblockheader", json!([block.to_string(), true])).await?;
+        let confirmations = raw.confirmations;
+        let transaction = validate(raw, header, txid, block, minimum, before.blocks)?;
+        let after = self.chain().await?;
+        ensure!(before.bestblockhash == after.bestblockhash && before.blocks == after.blocks,
+            "Dogecoin tip changed during observation");
+        Ok(ConfirmedTransaction { network: self.network, tip: before.bestblockhash, block, confirmations, transaction })
+    }
+}
+
+fn validate(raw: RawTransaction, header: Header, txid: Txid, block: BlockHash, minimum: u64, height: u64) -> Result<Transaction> {
+    let depth = height.checked_sub(header.height).and_then(|n| n.checked_add(1)).context("invalid Dogecoin block height")?;
+    ensure!(minimum > 0 && raw.txid == txid && raw.hash == txid && raw.blockhash == block
+        && header.hash == block && header.confirmations > 0
+        && u64::try_from(header.confirmations)? == raw.confirmations
+        && raw.confirmations == depth && raw.confirmations >= minimum,
+        "Dogecoin transaction is not confirmed in the requested active block");
+    ensure!(!raw.hex.is_empty() && raw.hex.len() <= 400_000, "invalid Dogecoin legacy transaction size");
+    let transaction: Transaction = deserialize(&Vec::<u8>::from_hex(&raw.hex)?)?;
+    ensure!(serialize_hex(&transaction) == raw.hex && transaction.compute_txid() == txid
+        && transaction.input.iter().all(|input| input.witness.is_empty()),
+        "Dogecoin legacy transaction bytes differ from node identity");
+    Ok(transaction)
+}
+
