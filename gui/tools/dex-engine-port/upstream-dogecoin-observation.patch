@@ -0,0 +1,126 @@
+use super::*;
+use bitcoin::{hashes::Hash, Amount, ScriptBuf, TxIn, TxOut, absolute, transaction::Version};
+
+fn transaction() -> Transaction {
+    Transaction { version: Version::ONE, lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn::default()], output: vec![TxOut {value: Amount::from_sat(999_000_000), script_pubkey: ScriptBuf::new()}] }
+}
+
+#[test]
+fn rejects_inconsistent_confirmation_and_legacy_bytes() -> Result<()> {
+    let tx = transaction(); let txid = tx.compute_txid(); let block = BlockHash::from_byte_array([7;32]);
+    let raw = || RawTransaction {hex: serialize_hex(&tx), txid, hash: txid, blockhash: block, confirmations: 3};
+    let header = || Header {hash: block, height: 98, confirmations: 3};
+    assert_eq!(validate(raw(), header(), txid, block, 3, 100)?, tx);
+    assert!(validate(raw(), header(), txid, block, 0, 100).is_err());
+    assert!(validate(raw(), header(), txid, block, 4, 100).is_err());
+    for case in 0..9 {
+        let mut r = raw(); let mut h = header();
+        match case {
+            0 => r.confirmations = 0,
+            1 => r.blockhash = BlockHash::from_byte_array([8;32]),
+            2 => h.confirmations = -1,
+            3 => h.height = 97,
+            4 => h.height = 101,
+            5 => r.hash = Txid::from_byte_array([8;32]),
+            6 => r.hex.push_str("00"),
+            7 => {let mut changed = tx.clone(); changed.input[0].witness.push([1]); r.hex = serialize_hex(&changed);},
+            _ => {let mut changed = tx.clone(); changed.output[0].value = Amount::from_sat(1); r.hex = serialize_hex(&changed);},
+        }
+        assert!(validate(r, h, txid, block, 3, 100).is_err(), "case {case}");
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn observation_checks_rpc_context_and_stable_tip() -> Result<()> {
+    use std::{net::TcpListener, io::{BufRead, BufReader, Read, Write}};
+    for case in 0..8 {
+        let tx = transaction(); let txid = tx.compute_txid(); let block = BlockHash::from_byte_array([7;32]);
+        let listener = TcpListener::bind("127.0.0.1:0")?; let port = listener.local_addr()?.port();
+        listener.set_nonblocking(true)?;
+        let server = std::thread::spawn(move || -> Result<()> {
+            let methods = ["getblockchaininfo", "getblockhash", "getrawtransaction", "getblockheader", "getblockchaininfo", "getblockhash"];
+            let count = match case { 2..=4 => 2, 5..=7 => 1, _ => 6 };
+            for (i, method) in methods.iter().take(count).enumerate() {
+                let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+                let (mut socket, _) = loop {
+                    match listener.accept() {
+                        Ok(connection) => break connection,
+                        Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                            ensure!(std::time::Instant::now() < deadline, "missing expected RPC request");
+                            std::thread::sleep(std::time::Duration::from_millis(10));
+                        }
+                        Err(error) => return Err(error.into()),
+                    }
+                };
+                socket.set_read_timeout(Some(std::time::Duration::from_secs(10)))?;
+                let mut reader = BufReader::new(socket.try_clone()?); let mut line = String::new(); let mut length = None;
+                loop {
+                    line.clear(); ensure!(reader.read_line(&mut line)? > 0, "missing RPC headers");
+                    if line == "\r\n" { break; }
+                    if let Some(value) = line.to_ascii_lowercase().strip_prefix("content-length:") { length = Some(value.trim().parse::<usize>()?); }
+                }
+                let length = length.context("missing RPC length")?; ensure!(length < 4096, "oversized request");
+                let mut body = vec![0;length]; reader.read_exact(&mut body)?; let request: Value = serde_json::from_slice(&body)?;
+                ensure!(request["method"] == *method, "unexpected RPC method");
+                let result = match *method {
+                    "getblockchaininfo" => json!({"chain":"regtest", "blocks":100, "headers":if case == 4 {101} else {100}, "initialblockdownload":case == 3,
+                        "bestblockhash": if case == 1 && i == 4 { "09".repeat(32) } else { "08".repeat(32) }}),
+                    "getblockhash" => {ensure!(request["params"] == json!([0]), "wrong genesis request"); json!(if case == 2 {DogeNetwork::Mainnet.genesis()} else {DogeNetwork::Regtest.genesis()})},
+                    "getrawtransaction" => {ensure!(request["params"] == json!([txid.to_string(),true]), "wrong raw lookup");
+                        json!({"hex":serialize_hex(&tx), "txid":txid, "hash":txid, "blockhash":block, "confirmations":3})},
+                    _ => {ensure!(request["params"] == json!([block.to_string(),true]), "wrong block lookup");
+                        json!({"hash":block, "height":98, "confirmations":3})},
+                };
+                let mut envelope = json!({"id":request["id"], "error":null, "result":result});
+                if case == 5 { envelope["id"] = json!(999); }
+                if case == 6 { envelope["error"] = json!({"code":-1,"message":"fixture"}); }
+                if case == 7 { envelope["result"].as_object_mut().unwrap().remove("initialblockdownload"); }
+                let body = serde_json::to_vec(&envelope)?;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?; socket.write_all(&body)?;
+            }
+            Ok(())
+        });
+        let rpc = DogecoinRpc::new(port,"fixture".into(),"fixture".into(),DogeNetwork::Regtest)?;
+        let result = rpc.confirmed_transaction(txid,block,3).await;
+        server.join().unwrap()?;
+        if case != 0 { assert!(result.is_err(), "case {case}"); } else {
+            let observed = result?; assert_eq!(observed.transaction().compute_txid(),txid); assert_eq!(observed.confirmations(),3);
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+#[ignore = "requires owned Dogecoin regtest request and response paths"]
+#[cfg(unix)]
+async fn actual_dogecoin_observation_fixture() -> Result<()> {
+    use std::{io::{Read, Write}, os::unix::fs::OpenOptionsExt};
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields, rename_all = "camelCase")]
+    struct Request { schema: String, request_id: uuid::Uuid, port: u16, cookie: String,
+        txid: Txid, block: BlockHash, minimum: u64, expected_hex: String }
+    let input = std::env::var_os("MONZERO_DOGE_OBSERVATION_REQUEST").context("missing observation request")?;
+    let output = std::env::var_os("MONZERO_DOGE_OBSERVATION_RESPONSE").context("missing observation response")?;
+    let mut bytes = Vec::new(); std::fs::File::open(input)?.take(500_001).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() <= 500_000, "oversized observation request");
+    let request: Request = serde_json::from_slice(&bytes)?;
+    ensure!(request.schema == "monzero-doge-observation-request-v1" && !request.request_id.is_nil(), "wrong fixture context");
+    let cookie = Zeroizing::new(request.cookie);
+    let (user, password) = cookie.trim().split_once(':').context("invalid owned-node cookie")?;
+    let rpc = DogecoinRpc::new(request.port, user.into(), password.into(), DogeNetwork::Regtest)?;
+    let evidence = rpc.confirmed_transaction(request.txid, request.block, request.minimum).await;
+    let result = match evidence {
+        Ok(observed) => {
+            ensure!(serialize_hex(observed.transaction()) == request.expected_hex, "observed different transaction bytes");
+            json!({"confirmed":true,"confirmations":observed.confirmations(),"block":observed.block(),"tip":observed.tip()})
+        }
+        Err(_) => json!({"confirmed":false}),
+    };
+    let response = json!({"schema":"monzero-doge-observation-response-v1", "requestId":request.request_id,
+        "observation":result,"executable":false});
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(output)?;
+    file.write_all(&serde_json::to_vec(&response)?)?; file.sync_all()?;
+    Ok(())
+}
