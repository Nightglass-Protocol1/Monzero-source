+use super::*;
+use super::super::tests::{fixture,Directory};
+fn policy()->PreparationPolicy {PreparationPolicy {fee:Amount::from_sat(1000),minimum_change:Amount::from_sat(1000),minimum_confirmations:1}}
+fn account_copy(account:&PublicAccount)->Result<PublicAccount> {PublicAccount::from_descriptor(&account.descriptor(),account.network())}
+#[test]
+fn preparation_reuses_allocated_change_and_claims_after_restart()->Result<()> {
+    let (seed,account,chain,credit,payment)=fixture()?;
+    let inputs=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    let addresses=Directory::new()?;let claims=Directory::new()?;let operation=Uuid::new_v4();
+    let mut book=AddressBook::create(&addresses.0,account_copy(&account)?)?;
+    // An earlier change allocation ensures preparation uses the reserved index,
+    // rather than the preflight placeholder.
+    book.reserve(Uuid::new_v4(),Branch::Change)?;
+    let prepared=prepare_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&mut book,&claims.0,operation)?;
+    assert_eq!(&prepared.transaction().output[1].script_pubkey,account.derive(Branch::Change,1)?.address().script_pubkey());
+    let commitment=prepared.signing_commitment();let tx=prepared.transaction().clone();
+    assert_eq!(book.allocated_count(Branch::Change)?,2);drop(prepared);drop(book);
+    let mut book=AddressBook::open(&addresses.0,account_copy(&account)?)?;
+    let resumed=prepare_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&mut book,&claims.0,operation)?;
+    assert_eq!(resumed.transaction(),&tx);assert_eq!(resumed.signing_commitment(),commitment);
+    assert_eq!(book.allocated_count(Branch::Change)?,2);
+    assert!(resumed.approve_and_sign_on(&chain,&observed,&seed,commitment)?.input.iter().all(|input|input.witness.len()==2));Ok(())
+}
+#[test]
+fn preparation_preflights_policy_and_account_but_preserves_allocation_on_claim_conflict()->Result<()> {
+    let (seed,account,chain,credit,payment)=fixture()?;
+    let inputs=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    let addresses=Directory::new()?;let claims=Directory::new()?;let wrong_addresses=Directory::new()?;
+    let mut wrong=AddressBook::create(&wrong_addresses.0,seed.public_account(LtcNetwork::Regtest,3)?)?;
+    assert!(prepare_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&mut wrong,&claims.0,Uuid::new_v4()).is_err());
+    assert_eq!(wrong.allocated_count(Branch::Change)?,0);
+    let mut book=AddressBook::create(&addresses.0,account_copy(&account)?)?;
+    let mut too_large=payment.clone();too_large.value=Amount::from_sat(200000);
+    assert!(prepare_payment(&chain,&observed,&account,&inputs,&too_large,&policy(),&mut book,&claims.0,Uuid::new_v4()).is_err());
+    assert_eq!(book.allocated_count(Branch::Change)?,0);
+    let first=prepare_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&mut book,&claims.0,Uuid::new_v4())?;drop(first);
+    let conflicting=Uuid::new_v4();
+    for _ in 0..2 {
+        assert!(prepare_payment(&chain,&observed,&account,&inputs,&payment,&policy(),&mut book,&claims.0,conflicting).is_err());
+        assert_eq!(book.allocated_count(Branch::Change)?,2);
+    }
+    // An exact-match payment needs no change address.
+    let fresh_claims=Directory::new()?;let mut exact=payment.clone();exact.value=Amount::from_sat(129000);
+    let exact=prepare_payment(&chain,&observed,&account,&inputs,&exact,&policy(),&mut book,&fresh_claims.0,Uuid::new_v4())?;
+    assert_eq!(exact.transaction().output.len(),1);assert_eq!(book.allocated_count(Branch::Change)?,2);Ok(())
+}
