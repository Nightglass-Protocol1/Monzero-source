+//! Bind payment selection to durable change allocation and input retention.
+use super::*;
+use crate::litecoin_light::account::allocation::AddressBook;
+use super::super::claimed::ObservedClaimedSpend;
+use bitcoin::bip32::ChildNumber;
+
+pub struct PreparationPolicy {
+    pub fee:Amount,
+    pub minimum_change:Amount,
+    pub minimum_confirmations:u64,
+}
+/// The operation ID is also the address-book retry identity. Both stores must
+/// remain available for recovery. They are separately durable, not atomically
+/// committed together: a failed claim can leave an allocated change address.
+/// Do not clear that allocation or retry with a fresh identity automatically.
+/// There is no implicit signing or broadcast approval.
+pub fn prepare_payment(chain:&HeaderSequence,observed:&ObservedWallet,account:&PublicAccount,
+    candidates:&[IncludedInput<'_>],payment:&TxOut,policy:&PreparationPolicy,
+    book:&mut AddressBook,directory:&Path,operation:Uuid)->Result<ObservedClaimedSpend> {
+    ensure!(!operation.is_nil(),"missing Litecoin payment operation");
+    let (descriptor,_)=book.backup_parts()?;
+    ensure!(serde_json::to_vec(&descriptor)?==serde_json::to_vec(&account.descriptor())?,
+        "Litecoin change address book account mismatch");
+    // Preflight all selection/policy failures before allocating an address.
+    let mut selection=PaymentPolicy {fee:policy.fee,minimum_change:policy.minimum_change,
+        change_index:0,minimum_confirmations:policy.minimum_confirmations};
+    let mut review=ConfirmedSpendReview::select_payment(chain,observed,account,candidates,payment,&selection)?;
+    if review.transaction().output.len()==2 {
+        let change=book.reserve(operation,Branch::Change)?;
+        let Some(ChildNumber::Normal {index})=change.path().as_ref().last() else {
+            anyhow::bail!("invalid Litecoin reserved change derivation")
+        };
+        selection.change_index=*index;
+        review=ConfirmedSpendReview::select_payment(chain,observed,account,candidates,payment,&selection)?;
+        ensure!(&review.transaction().output[1].script_pubkey==change.address().script_pubkey(),
+            "Litecoin reserved change script mismatch");
+    }
+    review.retain_observed(chain,observed,directory,operation)
+}
+#[cfg(test)]
+mod tests;
