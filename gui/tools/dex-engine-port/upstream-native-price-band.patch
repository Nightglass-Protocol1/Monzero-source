+//! Exact price-band arithmetic only. Does not authenticate or refresh reference prices.
+use anyhow::{Result, ensure};
+use num_bigint::BigUint;
+
+/// Compare BTC-satoshi/XMZ-atom ratios with inclusive symmetric basis-point bounds.
+/// No decimal rounding, reference price, or policy default is supplied here.
+/// The caller must verify reference provenance/freshness and the selected policy
+/// before using this result to admit a new trade. Never gate an existing refund.
+pub fn contains(
+    btc_satoshis: u64, xmz_atoms: u64,
+    reference_btc_satoshis: u64, reference_xmz_atoms: u64,
+    deviation_bps: u16,
+) -> Result<bool> {
+    ensure!(btc_satoshis > 0 && xmz_atoms > 0 && reference_btc_satoshis > 0
+        && reference_xmz_atoms > 0, "price ratios must be positive");
+    ensure!(deviation_bps < 10000, "price band must be smaller than 100 percent");
+    // Even bounded uint64 inputs can exceed uint128 after the basis-point factor.
+    let actual = BigUint::from(btc_satoshis) * BigUint::from(reference_xmz_atoms) * 10000u32;
+    let reference = BigUint::from(reference_btc_satoshis) * BigUint::from(xmz_atoms);
+    let lower = &reference * (10000u32 - u32::from(deviation_bps));
+    let upper = reference * (10000u32 + u32::from(deviation_bps));
+    Ok(actual >= lower && actual <= upper)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exact_edges_and_one_satoshi_outside() {
+        // Illustrative test price only, never a deployment default.
+        for (sats, expected) in [(89, false), (90, true), (100, true), (110, true), (111, false)] {
+            assert_eq!(contains(sats, 100_000_000_000, 100, 100_000_000_000, 1000).unwrap(), expected);
+        }
+        assert!(contains(200, 200_000_000_000, 100, 100_000_000_000, 0).unwrap());
+        assert!(!contains(199, 200_000_000_000, 100, 100_000_000_000, 0).unwrap());
+    }
+    #[test]
+    fn fractional_prices_and_extreme_inputs_are_exact() {
+        assert!(contains(2, 6, 1, 3, 0).unwrap());
+        assert!(!contains(2, 7, 1, 3, 1000).unwrap());
+        assert!(!contains(2, 5, 1, 3, 1000).unwrap());
+        assert!(contains(u64::MAX, u64::MAX, u64::MAX, u64::MAX, 9999).unwrap());
+        assert!(contains(u64::MAX, u64::MAX, 1, 1, 0).unwrap());
+        assert!(!contains(u64::MAX, 1, 1, u64::MAX, 9999).unwrap());
+        assert!(!contains(1, u64::MAX, u64::MAX, 1, 9999).unwrap());
+    }
+    #[test]
+    fn invalid_ratios_and_bands_are_rejected() {
+        for zero in 0..4 {
+            let mut values = [1; 4]; values[zero] = 0;
+            assert!(contains(values[0], values[1], values[2], values[3], 1000).is_err());
+        }
+        for band in [10000, u16::MAX] { assert!(contains(1, 1, 1, 1, band).is_err()); }
+    }
+}
