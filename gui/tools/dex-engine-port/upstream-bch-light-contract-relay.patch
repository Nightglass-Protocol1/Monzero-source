+}
+async fn refund(execution:&mut AdmittedExecution<'_>,metadata:&std::path::Path,snapshots:&std::path::Path,
+    setup:&Setup,fixture:&Fixture,recovery:&PrivateRecovery,lost:bool)->Result<()> {
+    let observer=&fixture.observer;let relay=OwnedBchContractRelay::new(observer);let block=Some(BlockHash::from_byte_array([6;32]));
+    let trade=&setup.quote.terms()["swapId"];let intent=metadata.join(format!("{trade}.bch-refund-relay-intent"));
+    let ack=metadata.join(format!("{trade}.bch-refund-relay-ack"));
+    let transaction:Transaction=bitcoin::consensus::deserialize(recovery.refund_bytes())?;let txid=transaction.compute_txid();
+    let review=execution.review_light_bch_refund_relay(observer,12014,5)?;
+    assert_eq!(review.details["schema"],"monzero-bch-light-refund-relay-review-v1");
+    assert_eq!(review.details["fundingSource"],"local-wallet");assert_eq!(review.details["revealsNativeSpendShare"],true);
+    assert!(execution.light_bch_refund_relay_state(observer,12014)?.is_none());
+    assert!(execution.observe_light_bch_refund(observer,block,12014).await.is_err());
+    *fixture.relay.lock().unwrap()=Some(RelayAttempt {transaction:transaction.clone(),intent:intent.clone(),
+        schema:"monzero-bch-refund-relay-intent-v1",lose_reply:lost,calls:0});
+    let calls=fixture.calls.load(Ordering::Relaxed);
+    assert!(execution.relay_light_bch_refund(&relay,block,&[0;32],12015,5).await.is_err());
+    let (node,changed)=alternate_endpoints(observer)?;
+    assert!(execution.review_bch_refund_relay(&node,12015,5).is_err());
+    assert!(execution.relay_bch_refund(&node,block,&review.commitment,12015,5).await.is_err());
+    assert!(execution.relay_light_bch_refund(&OwnedBchContractRelay::new(&changed),block,&review.commitment,12015,5).await.is_err());
+    assert!(execution.relay_light_bch_refund(&relay,block,&review.commitment,12015,0).await.is_err());
+    assert_eq!(fixture.calls.load(Ordering::Relaxed),calls);assert!(!intent.exists());
+    fixture.recovery_output_mode.store(1,Ordering::SeqCst);
+    assert!(execution.relay_light_bch_refund(&relay,block,&review.commitment,12015,5).await.is_err());assert!(!intent.exists());
+    fixture.recovery_output_mode.store(0,Ordering::SeqCst);
+    let sent=execution.relay_light_bch_refund(&relay,block,&review.commitment,12015,5).await;
+    let state=if lost {assert!(sent.is_err());assert!(!ack.exists());RefundRelayState::Attempted {txid}}
+        else {assert_eq!(sent?,txid);assert!(ack.exists());RefundRelayState::Acknowledged {txid}};
+    assert!(intent.exists());assert_eq!(fixture.relay.lock().unwrap().as_ref().unwrap().calls,1);
+    // Reopen a separate exact copy so the original execution keeps its lease.
+    let copied_public=copied(metadata)?;let copied_private=copied(snapshots)?;
+    let mut reopened=AdmittedExecution::resume(&copied_public.0,&copied_private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    let calls=fixture.calls.load(Ordering::Relaxed);
