+//! Explicit dispatch capability, separate from read-only chain observation.
+//! Only admitted executors may publish exact, approved, retained contract bytes.
+use super::*;
+use bitcoin::{Transaction,Txid,hex::DisplayHex};
+
+pub struct OwnedBchContractRelay<'a> {observer:&'a observer::OwnedBchObserver}
+impl<'a> OwnedBchContractRelay<'a> {
+    /// Explicit API selection, not approval. The admitted executor validates
+    /// consent, current chain evidence and durable intent before dispatch.
+    pub fn new(observer:&'a observer::OwnedBchObserver)->Self {Self {observer}}
+    pub fn observer(&self)->&observer::OwnedBchObserver {self.observer}
+    pub(crate) async fn relay_cancellation(&self,transaction:&Transaction,deadline:std::time::Instant)->Result<Txid> {
+        self.dispatch(transaction,deadline).await
+    }
+    pub(crate) async fn relay_refund(&self,transaction:&Transaction,deadline:std::time::Instant)->Result<Txid> {
+        self.dispatch(transaction,deadline).await
+    }
+    async fn dispatch(&self,transaction:&Transaction,deadline:std::time::Instant)->Result<Txid> {
+        ensure!(std::time::Instant::now()<deadline,"BCH contract spend observations expired before dispatch");
+        let raw=Zeroizing::new(serialize(transaction).to_lower_hex_string());
+        let reply=tokio::time::timeout_at(deadline.into(),self.observer.rpc(None,"sendrawtransaction",json!([raw.as_str(),false])))
+            .await.context("BCH contract spend dispatch deadline exceeded; result is uncertain")??;
+        let txid:Txid=serde_json::from_str(reply.get()).map_err(|_|anyhow::anyhow!("invalid BCH contract relay acknowledgement"))?;
+        ensure!(txid==transaction.compute_txid(),"BCH contract spend relay returned another transaction ID");
+        Ok(txid)
+    }
+}
