+        assert_eq!(fixture.calls.load(Ordering::Relaxed),calls);assert!(!cancel_intent.exists());
+        fixture.depth.store(usize::from(setup.policy.cancel_blocks)-1,Ordering::SeqCst);
+        assert!(execution.relay_light_bch_cancel(&relay,&review.commitment,12011).await.is_err());assert!(!cancel_intent.exists());
+        fixture.depth.store(usize::from(setup.policy.cancel_blocks),Ordering::SeqCst);
