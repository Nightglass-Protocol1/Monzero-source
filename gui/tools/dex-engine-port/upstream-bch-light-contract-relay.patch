+use super::*;
+use bitcoin::{absolute,transaction,Amount,OutPoint,Sequence,TxIn,Witness};
+use std::{io::{BufRead,BufReader,Read,Write},net::TcpListener,time::{Duration,Instant}};
+#[tokio::test]
+async fn owned_contract_relay_checks_deadline_exact_bytes_ack_and_lost_reply()->Result<()> {
+    let transaction=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([1;32]),vout:0},script_sig:ScriptBuf::new(),
+            sequence:Sequence::ZERO,witness:Witness::new()}],output:vec![TxOut {value:Amount::from_sat(1000),script_pubkey:ScriptBuf::from_bytes(vec![0x51])}]};
+    for mode in 0..6 {
+        let listener=TcpListener::bind("127.0.0.1:0")?;listener.set_nonblocking(true)?;let port=listener.local_addr()?.port();
+        let observer=observer::OwnedBchObserver::new(port,"fixture".into(),"fixture".into(),
+            BchNetwork::Regtest {checkpoint_height:1,checkpoint:BlockHash::from_byte_array([7;32])},"/Bitcoin Cash Node:29.0.0/".into())?;
+        let relay=OwnedBchContractRelay::new(&observer);
+        if mode==3 {
+            assert!(relay.relay_refund(&transaction,Instant::now()).await.is_err());
+            assert!(listener.accept().is_err());continue;
+        }
+        let expected=transaction.clone();
+        let server=std::thread::spawn(move ||->Result<()> {
+            let deadline=Instant::now()+Duration::from_secs(5);
+            let (mut socket,_)=loop {match listener.accept() {
+                Ok(pair)=>break pair,
+                Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>{ensure!(Instant::now()<deadline,"missing relay request");std::thread::sleep(Duration::from_millis(1));},
+                Err(e)=>return Err(e.into()),
+            }};
+            socket.set_read_timeout(Some(Duration::from_secs(5)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();reader.read_line(&mut line)?;
+            ensure!(line.starts_with("POST / HTTP/"),"contract relay must use root RPC");
+            let mut length=None;let mut auth=false;
+            loop {line.clear();ensure!(reader.read_line(&mut line)?>0,"missing relay headers");if line=="\r\n" {break;}
+                let lower=line.to_ascii_lowercase();
+                if let Some(value)=lower.strip_prefix("content-length:") {length=Some(value.trim().parse::<usize>()?);}
+                if lower.starts_with("authorization:") {auth=line.trim().ends_with("Basic Zml4dHVyZTpmaXh0dXJl");}
+            }
+            ensure!(auth,"wrong contract relay credentials");let length=length.context("missing relay length")?;ensure!(length<4096,"oversized fixture request");
+            let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;let request:Value=serde_json::from_slice(&bytes)?;
+            ensure!(request["method"]=="sendrawtransaction" && request["params"]==json!([serialize(&expected).to_lower_hex_string(),false]),"wrong contract relay bytes or fee policy");
+            if mode==2 {return Ok(());}
+            let txid=if mode==1 {Txid::all_zeros()}else{expected.compute_txid()};
+            let raw=serialize(&expected).to_lower_hex_string();
+            let envelope=if mode==4 {json!({"id":request["id"],"error":{"code":-26,"message":raw},"result":null})}
+                else if mode==5 {json!({"id":request["id"],"error":null,"result":raw})}
+                else {json!({"id":request["id"],"error":null,"result":txid})};
+            let body=serde_json::to_vec(&envelope)?;
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;socket.write_all(&body)?;
+            Ok(())
+        });
+        let sent=relay.relay_cancellation(&transaction,Instant::now()+Duration::from_secs(5)).await;
+        server.join().unwrap()?;
+        if mode==0 {assert_eq!(sent?,transaction.compute_txid());}else{
+            let error=sent.err().context("unsafe reply must fail")?;
+            assert!(!format!("{error:#}").contains(&serialize(&transaction).to_lower_hex_string()));
+        }
+    }
+    Ok(())
+}
