+//! Sealed source dispatch for the existing recovery approval state machines.
+use super::*;
+use crate::bch_rpc::{BchRpc,observer::OwnedBchObserver,contract_relay::OwnedBchContractRelay,
+    confirmed::ConfirmedTransaction,unspent::ConfirmedUnspentOutput};
+use swap_core::bch::funding::SignedFunding;
+use bitcoin::BlockHash;
+#[derive(Clone,Copy)]
+pub(super) enum RecoveryRelay<'a,'b> {Node(&'a BchRpc),Local(&'a OwnedBchContractRelay<'b>)}
+impl RecoveryRelay<'_,'_> {
+    pub fn local_observer(&self)->Option<&OwnedBchObserver> {match self {Self::Node(_)=>None,Self::Local(relay)=>Some(relay.observer())}}
+    pub fn deployment(&self)->Result<[u8;32]> {match self {Self::Node(rpc)=>rpc.deployment_commitment(),Self::Local(relay)=>relay.observer().deployment_commitment()}}
+    pub async fn require_cancel_maturity(&self,funding:&SignedFunding,minimum:u64,delay:u32)->Result<()> {
+        match self {
+            Self::Node(rpc)=>rpc.observe_funding(funding).await?.require_cancel_maturity(minimum,delay),
+            Self::Local(relay)=>{
+                let observer=relay.observer();observer.observe_funding(funding).await?.for_deployment(&observer.deployment_commitment()?)?
+                    .require_cancel_maturity(minimum,delay)
+            },
+        }
+    }
+    pub async fn confirmed_transaction(&self,txid:Txid,block:Option<BlockHash>,minimum:u64)->Result<ConfirmedTransaction> {
+        match self {
+            Self::Node(rpc)=>match block {Some(block)=>rpc.confirmed_transaction(txid,block,minimum).await,None=>rpc.indexed_confirmed_transaction(txid,minimum).await},
+            Self::Local(relay)=>match block {Some(block)=>relay.observer().confirmed_transaction(txid,block,minimum).await,None=>relay.observer().indexed_confirmed_transaction(txid,minimum).await},
+        }
+    }
+    pub async fn confirmed_unspent_output(&self,parent:&ConfirmedTransaction,vout:u32)->Result<ConfirmedUnspentOutput> {
+        match self {Self::Node(rpc)=>rpc.confirmed_unspent_output(parent,vout).await,Self::Local(relay)=>relay.observer().confirmed_unspent_output(parent,vout).await}
+    }
+    pub async fn relay_cancellation(&self,transaction:&Transaction,deadline:std::time::Instant)->Result<Txid> {
+        match self {Self::Node(rpc)=>rpc.relay_cancellation(transaction,deadline).await,Self::Local(relay)=>relay.relay_cancellation(transaction,deadline).await}
+    }
+    pub async fn relay_refund(&self,transaction:&Transaction,deadline:std::time::Instant)->Result<Txid> {
+        match self {Self::Node(rpc)=>rpc.relay_refund(transaction,deadline).await,Self::Local(relay)=>relay.relay_refund(transaction,deadline).await}
+    }
+}
