+    assert_eq!(reopened.review_light_bch_refund_relay(observer,12016,5)?.commitment,review.commitment);
+    assert!(reopened.observe_light_bch_refund(observer,block,12014).await.is_err());
+    assert!(reopened.relay_light_bch_refund(&relay,block,&review.commitment,12014,5).await.is_err());
+    let retry=reopened.relay_light_bch_refund(&relay,block,&review.commitment,12016,5).await;
+    if lost {assert!(retry.is_err());}else{assert_eq!(retry?,txid);}
+    assert_eq!(fixture.calls.load(Ordering::Relaxed),calls);
+    let public=hashes(&copied_public.0)?;let private=hashes(&copied_private.0)?;
