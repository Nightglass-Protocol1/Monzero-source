+    assert_eq!(reopened.light_bch_refund_relay_state(observer,12017)?,Some(state));
+    assert_eq!(hashes(&copied_public.0)?,public);assert_eq!(hashes(&copied_private.0)?,private);
+    Ok(())
+}
