+//! Authenticate a backup without requiring a surviving wallet configuration.
+//! Header identities are untrusted until the existing format verifier succeeds.
+use super::*;
+use crate::litecoin_light::vault::mnemonic::storage::backup as mnemonic_backup;
+use bitcoin::hashes::{Hash, sha256};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BackupFormat { RawSeed, Mnemonic }
+impl BackupFormat {
+    pub fn encoding(self) -> &'static str {
+        match self { Self::RawSeed => "raw-bip32-seed-hex-v1", Self::Mnemonic => "bip39-english-v1" }
+    }
+}
+/// Contains encrypted bytes and authenticated public metadata, never plaintext
+/// recovery material. Deliberately not deserializable: only inspection creates it.
+pub struct InspectedBackup {
+    encrypted: Vec<u8>,
+    format: BackupFormat,
+    network: LightNetwork,
+    wallet: Uuid,
+    account: PublicAccountDescriptor,
+    allocated: [u32; 2],
+    digest: sha256::Hash,
+}
+impl InspectedBackup {
+    pub fn format(&self) -> BackupFormat { self.format }
+    pub fn network(&self) -> LightNetwork { self.network }
+    pub fn wallet_id(&self) -> Uuid { self.wallet }
+    pub fn account(&self) -> &PublicAccountDescriptor { &self.account }
+    pub fn allocated(&self) -> [u32; 2] { self.allocated }
+    pub fn digest(&self) -> sha256::Hash { self.digest }
+
+    /// Explicit publication into separately chosen private directories. Existing
+    /// format restorers preflight both records and preserve exact retry bytes.
+    /// This does not publish a configuration or recover spend/trade journals.
+    pub fn restore_into(&self, vault: &Path, addresses: &Path, password: &[u8]) -> Result<()> {
+        match self.format {
+            BackupFormat::RawSeed => { drop(super::restore(vault, addresses, self.network, self.wallet, password, &self.encrypted)?); }
+            BackupFormat::Mnemonic => { drop(mnemonic_backup::restore(vault, addresses, self.network, self.wallet, password, &self.encrypted)?); }
+        }
+        Ok(())
+    }
+}
+/// The caller selects the coin/network. Never infer it from untrusted bytes or
+/// silently try another format after authentication fails. No filesystem writes.
+pub fn inspect(bundle: &[u8], password: &[u8], network: impl Into<LightNetwork>) -> Result<InspectedBackup> {
+    let network = network.into();
+    ensure!(bundle.len() > 144 && bundle.len() <= 2_000_000, "invalid recovery backup size");
+    let format = match &bundle[..8] {
+        b"MZLTCB01" => BackupFormat::RawSeed,
+        b"MZMNBK01" => BackupFormat::Mnemonic,
+        _ => anyhow::bail!("unsupported recovery backup format"),
+    };
+    let wallet = Uuid::from_slice(&bundle[72..88])?;
+    let (account, allocated) = match format {
+        BackupFormat::RawSeed => {
+            let verified = super::storage::inspect(bundle, password, network, wallet)?;
+            (verified.account().descriptor(), verified.allocated())
+        }
+        BackupFormat::Mnemonic => {
+            let verified = mnemonic_backup::inspect(bundle, password, network, wallet)?;
+            (verified.account().descriptor(), verified.allocated())
+        }
+    };
+    Ok(InspectedBackup { encrypted: bundle.to_vec(), format, network, wallet, account,
+        allocated, digest: sha256::Hash::hash(bundle) })
+}
+/// The backup remains local, bounded and read under the existing private-file
+/// journal checks. Successful inspection does not establish allocation freshness.
+pub fn load(directory: &Path, password: &[u8], network: impl Into<LightNetwork>) -> Result<InspectedBackup> {
+    let journal = Journal::open(directory)?;
+    inspect(&journal.read("litecoin-wallet.backup")?, password, network)
+}
