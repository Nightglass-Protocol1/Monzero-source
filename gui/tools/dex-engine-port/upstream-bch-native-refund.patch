@@ -0,0 +1,69 @@
+//! Private XMZ recovery from the confirmed BCH refund signature.
+//! This is not permission to import a wallet, construct a payout or broadcast.
+use super::*;
+use bitcoin::BlockHash;
+use crate::{bch_rpc::BchRpc,xmz_funding::{self,FundingObserver}};
+use serde_json::json;
+
+/// Keys remain private; wallet operations must use an owned local session.
+/// No Debug, Clone or Serialize implementation.
+pub struct NativeRefund {
+    quote: [u8;32],admission: [u8;32],payment: [u8;32],observed_at: std::time::Instant,
+    spend: Zeroizing<[u8;32]>,view: Zeroizing<[u8;32]>,address: XmzAddress,
+    native_txid: String,refund: Txid,block: BlockHash,commitment: [u8;32],
+}
+impl NativeRefund {
+    #[cfg(test)]
+    pub(crate) fn spend_key(&self) -> &[u8;32] {&self.spend}
+    #[cfg(test)]
+    pub(crate) fn view_key(&self) -> &[u8;32] {&self.view}
+    pub fn address(&self) -> &XmzAddress {&self.address}
+    pub fn native_txid(&self) -> &str {&self.native_txid}
+    pub fn refund_txid(&self) -> Txid {self.refund}
+    pub fn block(&self) -> BlockHash {self.block}
+    pub fn commitment(&self) -> &[u8;32] {&self.commitment}
+}
+impl AdmittedExecution<'_> {
+    /// Refund txid and block are untrusted search hints. Recover only from this
+    /// quote's exact recovery covenant and the original authenticated adaptor.
+    /// A lost native relay reply must not strand a confirmed payment.
+    pub async fn recover_bch_native_refund(&self,native: &impl FundingObserver,bch: &BchRpc,
+        refund: Txid,block: Option<BlockHash>,now: u64) -> Result<NativeRefund> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH native refund owner");
+        let agreed=self.restore_agreement()?;
+        let (outgoing,signed_at)=self.outgoing_bch_refund_record()?.context("missing original BCH refund adaptor")?;
+        let encrypted=agreed.check_signed_refund(self.quote,outgoing.frame(),outgoing.signature())?;
+        let funding=self.received_bch_funding_message()?.context("missing authenticated BCH funding")?;
+        let (request,payment,prepared_at,deployment)=self.native_refund_payment()?;
+        ensure!(now>=signed_at && now>=prepared_at,"native refund recovery predates retained payment or adaptor");
+        ensure!(bch.deployment_commitment()?==deployment,"BCH native refund observer changed");
+        self.bch_native_relay_state()?; // Validate any local dispatch history; acknowledgement is not confirmation.
+        let admission=self.admission_digest()?;
+        let plan=self.quote.recovery_plan();
+        let cancel=plan.lock().prepare_timeout(&serialize(funding.signed().transaction()),
+            &plan.lock_spend_terms(funding.signed().lock_outpoint()))?;
+        let source=OutPoint {txid:cancel.compute_txid(),vout:0};
+        let native_txid=request.proof.tx_hash.0.clone();
+        // Finish historical restoration before observing either chain.
+        let evidence=xmz_funding::verify(native,request,&self.policy.xmz_genesis,
+            u64::from(self.policy.xmz_confirmations)).await?;
+        let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmed=match block {
+            Some(block)=>bch.confirmed_transaction(refund,block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(refund,minimum).await?,
+        };
+        ensure!(confirmed.deployment()==&deployment,"BCH native refund deployment changed");
+        ensure!(native.snapshot().await?==*evidence.snapshot(),"native chain changed during BCH refund recovery");
+        let observed_at=std::time::Instant::now();
+        let raw=Zeroizing::new(serialize(confirmed.transaction()));
+        let spend=agreed.owned().recover_spend_key(self.quote,&serialize(&cancel),source,&raw,&encrypted)?;
+        let wallet=agreed.owned().wallet();let address=wallet.address().clone();
+        let commitment=hash("monzero-bch-native-refund-v1",&serde_json::to_vec(&json!({
+            "quote":self.quote.commitment(),"admission":admission,"payment":payment,
+            "nativePayment":native_txid,"address":address.to_string(),"refund":refund,
+            "refundBlock":confirmed.block(),"bchDeployment":deployment}))?);
+        Ok(NativeRefund {quote:*self.quote.commitment(),admission,payment,observed_at,
+            spend:Zeroizing::new(spend.as_bytes()),view:Zeroizing::new(wallet.private_view_key().0.as_bytes()),
+            address,native_txid,refund,block:confirmed.block(),commitment})
+    }
+}
