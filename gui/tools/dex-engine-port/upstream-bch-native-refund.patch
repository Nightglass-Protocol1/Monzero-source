+use super::*;
+
+pub(super) async fn exercise(bch: &AdmittedExecution<'_>,native: &AdmittedExecution<'_>,
+    setup: &Setup,fixture: &Fixture,rpc: &BchRpc,server: &Server) -> Result<()> {
+    let recovery=bch.retained_bch_recovery()?.context("missing refund recovery fixture")?;
+    let transaction: Transaction=bitcoin::consensus::deserialize(recovery.refund_bytes())?;
+    let txid=transaction.compute_txid();let block=Some(BlockHash::from_byte_array([6;32]));
+    {let mut state=server.state.lock().unwrap();state.refund=Some(transaction);}
+    let calls=fixture.calls.lock().unwrap().len();
+    let observer=fixture.funding_client()?;
+    assert!(bch.recover_bch_native_refund(&observer,rpc,txid,block,2030).await.is_err());
+    fixture.incoming.store(true,Ordering::SeqCst);fixture.confirmed.store(false,Ordering::SeqCst);
+    assert!(native.recover_bch_native_refund(&observer,rpc,txid,block,2030).await.is_err());
+    fixture.confirmed.store(true,Ordering::SeqCst);
+    assert!(native.recover_bch_native_refund(&observer,rpc,txid,block,1000).await.is_err());
+    let claim=native.recover_bch_native_refund(&observer,rpc,txid,block,2030).await?;
+    assert_eq!(claim.spend_key(),&(setup.spend[0]+setup.spend[1]).as_bytes());
+    assert_eq!(claim.view_key(),&native.restore_agreement()?.owned().wallet().private_view_key().0.as_bytes());
+    assert_eq!(claim.native_txid(),"ab".repeat(32));assert_eq!(claim.refund_txid(),txid);
+    assert_eq!(claim.address(),native.restore_agreement()?.owned().wallet().address());
+    assert_eq!(native.recover_bch_native_refund(&observer,rpc,txid,None,2031).await?.commitment(),claim.commitment());
+    for invalid in [1,2,3] {
+        server.state.lock().unwrap().redemption_confirmation_mode=invalid;
+        assert!(native.recover_bch_native_refund(&observer,rpc,txid,block,2031).await.is_err());
+    }
+    server.state.lock().unwrap().redemption_confirmation_mode=0;
+    fixture.incoming_unlock.store(500,Ordering::SeqCst);
+    assert!(native.recover_bch_native_refund(&observer,rpc,txid,block,2031).await.is_err());
+    fixture.incoming_unlock.store(0,Ordering::SeqCst);
+    fixture.incoming.store(false,Ordering::SeqCst);fixture.confirmed.store(false,Ordering::SeqCst);
+    server.state.lock().unwrap().refund=None;
+    // Recovery is read-only: no source-wallet construction or relay calls.
+    assert!(!fixture.calls.lock().unwrap()[calls..].iter().any(|v|v=="transfer" || v=="relay_tx"));
+    Ok(())
+}
