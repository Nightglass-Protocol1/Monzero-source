+use super::*;
+use crate::litecoin_light::MerkleMatch;
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("ltc-selection-{}",Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn fixture()->Result<(SecretSeed,PublicAccount,HeaderSequence,IncludedTransaction,TxOut)> {
+    // Policy-only injected inclusion, not a consensus-valid funding fixture.
+    let (seed,account,mut credit,prevout)=super::super::super::super::tests::fixture()?;
+    let chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    credit.output=vec![TxOut {value:Amount::from_sat(50000),script_pubkey:prevout.script_pubkey.clone()},
+        TxOut {value:Amount::from_sat(80000),script_pubkey:prevout.script_pubkey}];
+    let included=IncludedTransaction::new(MerkleMatch {txid:credit.compute_txid(),
+        block_hash:chain.header(0).unwrap().block_hash(),claimed_height:0},&credit)?;
+    let payment=TxOut {value:Amount::from_sat(119000),script_pubkey:account.derive(Branch::Receive,4)?.address().script_pubkey().clone()};
+    Ok((seed,account,chain,included,payment))
+}
+fn policy()->PaymentPolicy {PaymentPolicy {fee:Amount::from_sat(1000),minimum_change:Amount::from_sat(1000),change_index:0,minimum_confirmations:1}}
+#[test]
+fn selected_payment_has_exact_fee_change_and_retained_signatures()->Result<()> {
+    let (seed,account,chain,credit,payment)=fixture()?;
+    let mut inputs=vec![IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    let review=ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy())?;
+    assert_eq!(review.fee().to_sat(),1000);assert_eq!(review.transaction().input[0].previous_output.vout,1);
+    assert_eq!(review.transaction().output[0],payment);assert_eq!(review.transaction().output[1].value.to_sat(),10000);
+    assert_eq!(&review.transaction().output[1].script_pubkey,account.derive(Branch::Change,0)?.address().script_pubkey());
+    inputs.reverse();let reversed=ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy())?;
+    assert_eq!(review.transaction(),reversed.transaction());
+    let directory=Directory::new()?;let retained=review.retain_observed(&chain,&observed,&directory.0,Uuid::new_v4())?;
+    let signed=retained.approve_and_sign_on(&chain,&observed,&seed,retained.signing_commitment())?;
+    assert!(signed.input.iter().all(|input|input.witness.len()==2));
+    assert_eq!(signed.compute_txid(),reversed.transaction().compute_txid());Ok(())
+}
+#[test]
+fn selection_preserves_exact_fee_and_rejects_tiny_change_overflow_and_wrong_ownership()->Result<()> {
+    let (_,account,chain,credit,mut payment)=fixture()?;
+    let inputs=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let observed=ObservedWallet::reconcile(&chain,&[credit.outputs()[0].script_pubkey.clone()],std::slice::from_ref(&credit))?;
+    payment.value=Amount::from_sat(129000);
+    assert_eq!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy())?.transaction().output.len(),1);
+    payment.value=Amount::from_sat(128999);
+    assert!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy()).err().unwrap().to_string().contains("cannot meet"));
+    payment.value=Amount::from_sat(u64::MAX);
+    assert!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy()).err().unwrap().to_string().contains("overflow"));
+    payment.value=Amount::from_sat(79000);
+    let wrong=[IncludedInput {transaction:&credit,vout:1,branch:Branch::Change,index:3}];
+    assert!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&wrong,&payment,&policy()).err().unwrap().to_string().contains("ownership"));Ok(())
+}
+#[test]
+fn selection_excludes_pending_inputs_and_insufficient_depth_and_rejects_duplicates()->Result<()> {
+    let (_,account,chain,credit,payment)=fixture()?;
+    let inputs=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:1,branch:Branch::Receive,index:3}];
+    let script=credit.outputs()[0].script_pubkey.clone();
+    let observed=ObservedWallet::reconcile(&chain,&[script.clone()],std::slice::from_ref(&credit))?;
+    let review=ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&policy())?;
+    let pending=ObservedWallet::reconcile_with_pending(&chain,&[script],std::slice::from_ref(&credit),&[review.transaction().clone()])?;
+    assert!(ConfirmedSpendReview::select_payment(&chain,&pending,&account,&inputs,&payment,&policy()).is_err());
+    let mut deeper=policy();deeper.minimum_confirmations=2;
+    assert!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&inputs,&payment,&deeper).is_err());
+    let duplicates=[IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3},IncludedInput {transaction:&credit,vout:0,branch:Branch::Receive,index:3}];
+    assert!(ConfirmedSpendReview::select_payment(&chain,&observed,&account,&duplicates,&payment,&policy()).err().unwrap().to_string().contains("duplicate"));Ok(())
+}
