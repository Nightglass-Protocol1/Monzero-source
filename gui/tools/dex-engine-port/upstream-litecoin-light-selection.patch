+//! Deterministic largest-first selection with explicit absolute fee policy.
+//! No fee estimation, relay-policy assertion, address allocation or broadcasting.
+use super::*;
+use crate::litecoin_light::accounting::ObservedWallet;
+use bitcoin::{absolute,transaction,TxIn,ScriptBuf,Sequence};
+use std::collections::{BTreeMap,BTreeSet};
+
+pub struct PaymentPolicy {
+    pub fee:Amount,
+    /// Caller-selected change threshold, not a hardcoded network dust rule.
+    pub minimum_change:Amount,
+    /// Must already be reserved in the wallet's durable address book.
+    pub change_index:u32,
+    pub minimum_confirmations:u64,
+}
+impl ConfirmedSpendReview {
+    /// Validate candidates, then select largest first with outpoint tie-breaking.
+    /// Does not search every subset, consult other operations' journal claims,
+    /// or establish complete/fresh history. The result still needs retention
+    /// and explicit signing approval. No network calls or writes occur here.
+    pub fn select_payment(chain:&HeaderSequence,observed:&ObservedWallet,account:&PublicAccount,
+        candidates:&[IncludedInput<'_>],payment:&TxOut,policy:&PaymentPolicy)->Result<Self> {
+        ensure!(chain.network()==account.network() && policy.minimum_confirmations>0
+            && policy.minimum_change.to_sat()>0 && !candidates.is_empty() && candidates.len()<=1000,
+            "invalid Litecoin payment selection policy");
+        ensure!(payment.value.to_sat()>0 && !payment.script_pubkey.is_empty() && payment.script_pubkey.len()<=10000,
+            "invalid Litecoin payment");
+        ensure!(observed.height()==chain.height() && chain.contains(observed.height(),observed.tip()),
+            "Litecoin observation tip differs from payment selection");
+        let change_script=account.derive(Branch::Change,policy.change_index)?.address().script_pubkey().clone();
+        let required=payment.value.to_sat().checked_add(policy.fee.to_sat()).context("Litecoin payment plus fee overflow")?;
+        let coins=observed.coins().iter().map(|coin|(coin.outpoint(),coin)).collect::<BTreeMap<_,_>>();
+        let mut seen=BTreeSet::new();let mut eligible=Vec::new();
+        for candidate in candidates {
+            let outpoint=OutPoint {txid:candidate.transaction.txid(),vout:candidate.vout};
+            ensure!(seen.insert(outpoint),"duplicate Litecoin selection candidate");
+            let depth=candidate.transaction.confirmations_on(chain).context("orphaned Litecoin selection candidate")?;
+            let prevout=candidate.transaction.outputs().get(candidate.vout as usize).context("missing Litecoin selection output")?;
+            ensure!(prevout.value.to_sat()>0 && account.matches_script(candidate.branch,candidate.index,&prevout.script_pubkey)?,
+                "Litecoin selection ownership mismatch");
+            let Some(coin)=coins.get(&outpoint) else {continue};
+            ensure!(coin.amount()==prevout.value && coin.confirmations()==depth
+                && coin.is_coinbase()==candidate.transaction.is_coinbase(),"Litecoin selection observation mismatch");
+            if depth>=policy.minimum_confirmations && coin.maturity_satisfied() {
+                eligible.push((prevout.value.to_sat(),outpoint,candidate));
+            }
+        }
+        eligible.sort_by(|a,b|b.0.cmp(&a.0).then_with(||a.1.cmp(&b.1)));
+        let mut selected=Vec::new();let mut total=0u64;let mut change=None;
+        for (value,_,candidate) in eligible {
+            total=total.checked_add(value).context("Litecoin selected amount overflow")?;
+            selected.push(IncludedInput {transaction:candidate.transaction,vout:candidate.vout,
+                branch:candidate.branch,index:candidate.index});
+            if total>=required {
+                let remainder=total-required;
+                if remainder==0 || remainder>=policy.minimum_change.to_sat() {change=Some(remainder);break;}
+            }
+        }
+        let change=change.context("Litecoin candidates cannot meet exact payment, fee and change policy")?;
+        let input=selected.iter().map(|candidate|TxIn {
+            previous_output:OutPoint {txid:candidate.transaction.txid(),vout:candidate.vout},
+            script_sig:ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new(),
+        }).collect();
+        let mut output=vec![payment.clone()];
+        if change>0 {output.push(TxOut {value:Amount::from_sat(change),script_pubkey:change_script});}
+        let transaction=Transaction {version:transaction::Version::TWO,lock_time:absolute::LockTime::ZERO,input,output};
+        let review=Self::new(chain,account,transaction,&selected,payment,
+            if change>0 {Some(policy.change_index)}else{None},policy.fee,policy.minimum_confirmations)?;
+        ensure!(review.fee()==policy.fee,"Litecoin selected fee mismatch");Ok(review)
+    }
+}
+#[cfg(test)]
+mod tests;
