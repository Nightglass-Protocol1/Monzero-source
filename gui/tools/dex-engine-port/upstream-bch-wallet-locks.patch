+//! An immutable intent precedes wallet mutation. Failed/ambiguous operations
+//! leave it intact for explicit reconciliation, never unlock or input reselection.
+use super::*;
+use crate::bch_rpc::{BchRpc,FundingInputsObservation};
+
+const LOCK: &str = "monzero-bch-wallet-lock-intent-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema: String, admission: [u8;32], preparation: [u8;32], deployment: [u8;32],
+    change_address: String, minimum_confirmations: u64, admitted_at: u64,
+}
+
+impl AdmittedExecution<'_> {
+    /// The caller must exclusively control the wallet and use one metadata
+    /// directory for all trades. BCHN locks are advisory and disappear on node
+    /// restart; another wallet controller can override them. A returned snapshot
+    /// is not signing/relay authority. Call again explicitly to reconcile after
+    /// an ambiguous result; only missing original inputs are ever locked.
+    pub async fn lock_bch_funding_inputs(&mut self, backend: &BchRpc, now: u64,
+        change_address: &str, minimum_confirmations: u64) -> Result<FundingInputsObservation> {
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(backend.network().quote_name() == self.quote.terms()["bchNetwork"]
+            && backend.network().genesis() == self.quote.terms()["bchGenesis"],
+            "BCH backend differs from admitted quote chain");
+        let prepared = self.prepared_bch_funding()?.context("BCH funding preparation is absent")?;
+        ensure!(now >= prepared.prepared_at,"BCH wallet locking predates preparation");
+        ensure!(minimum_confirmations > 0 && change_address.len() <= 200,"invalid BCH wallet lock policy");
+        let mut intent = Intent {schema:LOCK.into(),admission:self.admission_digest()?,
+            preparation:prepared.commitment,deployment:backend.deployment_commitment()?,
+            change_address:change_address.into(),minimum_confirmations,admitted_at:now};
+        let name = record_name(self.quote,"wallet-lock-intent");
+        let existing = match self.metadata.read(&name) {
+            Ok(bytes) => {
+                ensure!(bytes.len() <= 4096,"oversized BCH wallet lock intent");
+                let retained: Intent = serde_json::from_slice(&bytes)?;
+                ensure!(retained.admitted_at >= prepared.prepared_at && now >= retained.admitted_at,
+                    "BCH wallet lock time moved backwards");
+                intent.admitted_at = retained.admitted_at;
+                ensure!(serde_json::to_vec(&intent)? == bytes,"BCH wallet lock intent changed");
+                true
+            },
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => false,
+            Err(error) => return Err(error),
+        };
+        backend.observe_funding_inputs(prepared.preview(),change_address,minimum_confirmations).await?;
+        let selected: Vec<_> = prepared.preview().transaction().input.iter().map(|i|i.previous_output).collect();
+        let locked = backend.locked_outpoints().await?;
+        ensure!(existing || selected.iter().all(|p| !locked.contains(p)),
+            "BCH inputs are already locked without this trade's wallet lock intent");
+        self.metadata.retain(&name,&serde_json::to_vec(&intent)?)?;
+        let missing: Vec<_> = selected.iter().filter(|p| !locked.contains(p)).copied().collect();
+        if !missing.is_empty() { backend.lock_inputs(&missing).await?; }
+        let observed = backend.observe_funding_inputs(prepared.preview(),change_address,minimum_confirmations).await?;
+        let locked = backend.locked_outpoints().await?;
+        ensure!(selected.iter().all(|p| locked.contains(p)),"BCH wallet locks were not retained");
+        Ok(observed)
+    }
+}
