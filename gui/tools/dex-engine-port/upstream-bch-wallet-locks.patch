+//! Advisory wallet locks; no signing, relay, unlock or implicit RPC retry.
+use super::*;
+use bitcoin::OutPoint;
+use std::collections::BTreeSet;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RpcOutPoint { txid: bitcoin::Txid, vout: u32 }
+
+impl BchRpc {
+    /// Stable deployment binding, deliberately excluding rotatable credentials.
+    pub(crate) fn deployment_commitment(&self) -> Result<[u8;32]> {
+        let (height, checkpoint) = self.network.checkpoint()?;
+        let bytes = serde_json::to_vec(&json!({
+            "schema":"monzero-bch-wallet-deployment-v1", "host":"127.0.0.1", "port":self.port,
+            "network":self.network.quote_name(), "genesis":self.network.genesis(),
+            "checkpointHeight":height, "checkpoint":checkpoint, "wallet":self.wallet,
+            "anchor":self.anchor_address, "script":self.anchor_script.to_hex_string(), "subversion":self.subversion
+        }))?;
+        Ok(sha256::Hash::hash(&bytes).to_byte_array())
+    }
+
+    pub(crate) async fn locked_outpoints(&self) -> Result<BTreeSet<OutPoint>> {
+        let raw = self.rpc(true,"listlockunspent",json!([])).await?;
+        let parsed: Vec<RpcOutPoint> = serde_json::from_str(raw.get())?;
+        let outputs: Vec<_> = parsed.into_iter().map(|p|OutPoint {txid:p.txid,vout:p.vout}).collect();
+        let unique: BTreeSet<_> = outputs.iter().copied().collect();
+        ensure!(unique.len() == outputs.len() && outputs.iter().all(|p| !p.is_null()),
+            "invalid or duplicate BCH wallet locks");
+        Ok(unique)
+    }
+
+    pub(crate) async fn lock_inputs(&self, outputs: &[OutPoint]) -> Result<()> {
+        ensure!(!outputs.is_empty() && outputs.len() <= 128
+            && outputs.iter().all(|p| !p.is_null())
+            && outputs.iter().copied().collect::<BTreeSet<_>>().len() == outputs.len(),
+            "invalid BCH wallet lock request");
+        let outputs: Vec<_> = outputs.iter().map(|p|json!({"txid":p.txid,"vout":p.vout})).collect();
+        let raw = self.rpc(true,"lockunspent",json!([false,outputs])).await?;
+        ensure!(serde_json::from_str::<bool>(raw.get())?,"BCH wallet did not acknowledge input locks");
+        Ok(())
+    }
+}
