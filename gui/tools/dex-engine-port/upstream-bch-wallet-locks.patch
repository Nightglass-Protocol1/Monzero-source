+use super::*;
+use agreement::execution::{AdmittedExecution,NegotiationPins};
+use crate::bch_rpc::{BchNetwork,BchRpc};
+use bitcoin::BlockHash;
+use serde_json::{json,Value};
+use std::{io::{BufRead,BufReader,Read,Write},net::TcpListener,
+    sync::{Arc,Mutex,atomic::{AtomicBool,Ordering}}};
+
+#[derive(Default)]
+struct State { locked: bool, calls: usize, ambiguous: bool, ignore: bool, malformed: u8 }
+struct Server {
+    port: u16, state: Arc<Mutex<State>>, stop: Arc<AtomicBool>,
+    thread: Option<std::thread::JoinHandle<Result<()>>>,
+}
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.stop.store(true,Ordering::Relaxed);
+        self.thread.take().unwrap().join().unwrap().unwrap();
+    }
+}
+impl Server {
+    fn start(script: bitcoin::ScriptBuf, outpoint: OutPoint, intent: std::path::PathBuf,
+        network: BchNetwork) -> Result<Self> {
+        let listener = TcpListener::bind("127.0.0.1:0")?;
+        listener.set_nonblocking(true)?;
+        let port = listener.local_addr()?.port();
+        let state = Arc::new(Mutex::new(State::default())); let shared = state.clone();
+        let stop = Arc::new(AtomicBool::new(false)); let signal = stop.clone();
+        let thread = std::thread::spawn(move || -> Result<()> {
+            while !signal.load(Ordering::Relaxed) {
+                let (mut socket,_) = match listener.accept() {
+                    Ok(pair) => pair,
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(std::time::Duration::from_millis(2)); continue;
+                    }, Err(e) => return Err(e.into()),
+                };
+                socket.set_read_timeout(Some(std::time::Duration::from_secs(3)))?;
+                socket.set_write_timeout(Some(std::time::Duration::from_secs(3)))?;
+                let mut reader = BufReader::new(socket.try_clone()?);
+                let mut line = String::new(); reader.read_line(&mut line)?;
+                let path = line.split_whitespace().nth(1).context("missing path")?.to_owned();
+                let mut length = None;
+                loop {
+                    line.clear(); ensure!(reader.read_line(&mut line)? > 0,"missing headers");
+                    if line == "\r\n" { break; }
+                    if let Some(v) = line.to_ascii_lowercase().strip_prefix("content-length:") {
+                        length = Some(v.trim().parse::<usize>()?);
+                    }
+                }
+                let length = length.context("missing length")?; ensure!(length < 4096,"large request");
+                let mut body = vec![0;length]; reader.read_exact(&mut body)?;
+                let request: Value = serde_json::from_slice(&body)?;
+                let method = request["method"].as_str().context("missing method")?;
+                let wallet = matches!(method,"getwalletinfo"|"getaddressinfo"|"listlockunspent"|"lockunspent");
+                ensure!(path == if wallet {"/wallet/test"} else {"/"},"incorrect wallet path");
+                let mut state = shared.lock().unwrap();
+                let point = json!({"txid":outpoint.txid,"vout":outpoint.vout});
+                let result = match method {
+                    "getnetworkinfo" => json!({"subversion":"/Bitcoin Cash Node:29.0.0/","networkactive":true}),
+                    "getblockchaininfo" => json!({"chain":"regtest","blocks":200,"headers":200,
+                        "initialblockdownload":false,"bestblockhash":"08".repeat(32)}),
+                    "getblockhash" => json!(if request["params"][0] == 0 {network.genesis().into()} else {"07".repeat(32)}),
+                    "getwalletinfo" => json!({"walletname":"test","private_keys_enabled":true}),
+                    "getaddressinfo" => json!({"ismine":true,"iswatchonly":false,"scriptPubKey":script.to_hex_string()}),
+                    "gettxout" => {
+                        ensure!(request["params"] == json!([outpoint.txid,outpoint.vout,true]),"wrong funding input");
+                        json!({"bestblock":"08".repeat(32),"confirmations":100,"value":0.00111,"coinbase":false,
+                            "scriptPubKey":{"hex":script.to_hex_string(),"addresses":["bchreg:qinput"]}})
+                    },
+                    "listlockunspent" => match state.malformed {
+                        1 => Value::Null, 2 => json!([point.clone(),point]),
+                        3 => json!([{"txid":"00".repeat(32),"vout":4294967295u32}]),
+                        4 => json!([outpoint.to_string()]),
+                        _ => if state.locked {json!([point])} else {json!([])},
+                    },
+                    "lockunspent" => {
+                        ensure!(request["params"] == json!([false,[point]]),"unlock or changed lock inputs");
+                        ensure!(!state.locked && intent.is_file(),"intent must precede wallet mutation");
+                        let retained: Value = serde_json::from_slice(&std::fs::read(&intent)?)?;
+                        ensure!(retained["schema"] == "monzero-bch-wallet-lock-intent-v1","invalid intent");
+                        state.calls += 1;
+                        if !state.ignore { state.locked = true; }
+                        if state.ambiguous { state.ambiguous = false; continue; } // Applied, reply lost.
+                        json!(true)
+                    },
+                    _ => anyhow::bail!("unexpected method: {method}"),
+                };
+                let body = serde_json::to_vec(&json!({"id":request["id"],"error":null,"result":result}))?;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;
+                socket.write_all(&body)?;
+            }
+            Ok(())
+        });
+        Ok(Self {port,state,stop,thread:Some(thread)})
+    }
+}
+
+#[tokio::test]
+async fn durable_bch_wallet_locks_reconcile_ambiguous_results_and_wallet_restart() -> Result<()> {
+    let network = BchNetwork::Regtest {checkpoint_height:1,checkpoint:BlockHash::from_byte_array([7;32])};
+    let setup = Setup::with_network(Some(network))?;
+    let snapshots = PrivateStore::new()?; let metadata = PrivateStore::new()?;
+    let (selected,own,initial) = selected_with_outgoing(&setup,&snapshots.0,0)?;
+    let (_,peer,_) = selected_with_outgoing(&setup,&snapshots.0,1)?;
+    let (wallet,received) = selected.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+        1003,own.commitment(),peer.frame(),peer.signature())?;
+    let ack = wallet.acknowledgement(&setup.quote)?;
+    let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder,&agreed)?;
+    let pins = NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+    let mut execution = AdmittedExecution::admit(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,
+        Role::BchFunder,setup.quote.commitment(),pins,1005)?;
+    let script = setup.quote.recovery_plan().recovery().terms().redeem_destination.clone();
+    let parent = Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:bitcoin::ScriptBuf::new(),sequence:Sequence::MAX,witness:Witness::new()}],
+        output:vec![TxOut {value:Amount::from_sat(111_000),script_pubkey:script.clone()}]};
+    let outpoint = OutPoint {txid:parent.compute_txid(),vout:0};
+    let mut funding = parent.clone(); funding.input[0].previous_output = outpoint;
+    funding.output = vec![TxOut {value:Amount::from_sat(100_000),script_pubkey:setup.quote.recovery_plan().lock().script_pubkey()},
+        TxOut {value:Amount::from_sat(10_000),script_pubkey:script.clone()}];
+    execution.retain_bch_funding_preparation(1006,&serialize(&funding),&[&serialize(&parent)],&script,1000,546)?;
+    let intent = metadata.0.join(format!("{}.bch-funding-wallet-lock-intent",setup.quote.terms()["swapId"]));
+    let server = Server::start(script.clone(),outpoint,intent.clone(),network)?;
+    let backend = |wallet: &str,password: &str| BchRpc::new(server.port,"user".into(),password.into(),network,
+        wallet.into(),"bchreg:qanchor".into(),script.clone(),"/Bitcoin Cash Node:29.0.0/".into());
+    let rpc = backend("test","pass")?;
+    assert_eq!(BchNetwork::Mainnet.quote_name(),"bch-mainnet");
+    assert_eq!(BchNetwork::Testnet.quote_name(),"bch-testnet");
+    execution.observe_bch_funding_inputs(&rpc,1007,"bchreg:qchange",3).await?;
+    // Refuse unrelated pre-existing locks and malformed wallet responses before retaining intent.
+    server.state.lock().unwrap().locked = true;
+    assert!(execution.lock_bch_funding_inputs(&rpc,1007,"bchreg:qchange",3).await.is_err());
+    server.state.lock().unwrap().locked = false;
+    for malformed in 1..=4 {
+        server.state.lock().unwrap().malformed = malformed;
+        assert!(execution.lock_bch_funding_inputs(&rpc,1007,"bchreg:qchange",3).await.is_err());
+    }
+    server.state.lock().unwrap().malformed = 0;
+    assert!(!intent.exists()); assert_eq!(server.state.lock().unwrap().calls,0);
+    server.state.lock().unwrap().ambiguous = true;
+    assert!(execution.lock_bch_funding_inputs(&rpc,1007,"bchreg:qchange",3).await.is_err());
+    assert!(intent.exists()); assert_eq!(server.state.lock().unwrap().calls,1);
+    let original = std::fs::read(&intent)?;
+    drop(execution);
+    let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    execution.lock_bch_funding_inputs(&rpc,1008,"bchreg:qchange",3).await?;
+    assert_eq!(server.state.lock().unwrap().calls,1); // Already applied: no second mutation.
+    assert!(execution.lock_bch_funding_inputs(&backend("other","pass")?,1008,"bchreg:qchange",3).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(&rpc,1008,"bchreg:qother",3).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(&rpc,1008,"bchreg:qchange",4).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(&rpc,1006,"bchreg:qchange",3).await.is_err());
+    assert!(execution.lock_bch_funding_inputs(&rpc,2000,"bchreg:qchange",3).await.is_err());
+    // Wallet restart drops advisory locks; credential rotation does not change deployment.
+    server.state.lock().unwrap().locked = false;
+    execution.lock_bch_funding_inputs(&backend("test","rotated")?,1009,"bchreg:qchange",3).await?;
+    assert_eq!(server.state.lock().unwrap().calls,2);
+    server.state.lock().unwrap().locked = false; server.state.lock().unwrap().ignore = true;
+    assert!(execution.lock_bch_funding_inputs(&rpc,1010,"bchreg:qchange",3).await.is_err());
+    assert_eq!(server.state.lock().unwrap().calls,3); // Acknowledgement alone is insufficient.
+    assert_eq!(std::fs::read(&intent)?,original);
+    Ok(())
+}
