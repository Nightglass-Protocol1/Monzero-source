+    /// Fixture-only crash after a synced negotiated-state checkpoint.
+    /// The parent never reads the checkpoint or obtains Alice's private state.
+    pub fn restart_from_checkpoint(&mut self)->Result<()> {
+        let acknowledged: bool=self.wire.borrow_mut().call("checkpoint",())?;
+        ensure!(acknowledged,"Alice checkpoint was not acknowledged");
+        self.owner.child.kill()?;
+        self.owner.child.wait()?;
+        let path=self.owner.directory.join("peer");
+        std::fs::remove_file(&path)?;
+        let listener=UnixListener::bind(&path)?;
+        listener.set_nonblocking(true)?;
+        let id=self.wire.borrow().id;
+        let sequence=self.wire.borrow().sequence;
+        self.owner.child=Command::new(std::env::current_exe()?)
+            .args(["--exact","alice_peer_process","--ignored"])
+            .env("MONZERO_TEST_ALICE_SOCKET",&path)
+            .env("MONZERO_TEST_ALICE_ID",id.to_string())
+            .env("MONZERO_TEST_ALICE_RESUME","1")
+            .env("MONZERO_TEST_ALICE_SEQUENCE",sequence.to_string())
+            .stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null()).spawn()?;
+        let deadline=Instant::now()+Duration::from_secs(15);
+        let socket=loop {
+            match listener.accept() {
+                Ok((socket,_))=>break socket,
+                Err(error) if error.kind()==std::io::ErrorKind::WouldBlock=>{
+                    ensure!(Instant::now()<deadline && self.owner.child.try_wait()?.is_none(),
+                        "Alice fixture did not resume");
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                Err(error)=>return Err(error.into()),
+            }
+        };
+        socket.set_read_timeout(Some(Duration::from_secs(30)))?;
+        socket.set_write_timeout(Some(Duration::from_secs(30)))?;
+        let mut wire=Wire {socket,id,sequence};
+        let funding: (monero_oxide_ext::PublicKey,monero_oxide_ext::PublicKey)=wire.receive("resume")?;
+        ensure!(funding==self.funding,"Alice resumed with different funding keys");
+        wire.sequence+=1;
+        self.wire=RefCell::new(wire);
+        Ok(())
+    }
