+use super::*;
+use agreement::execution::funding::message;
+
+pub(super) async fn exercise(sender: &mut AdmittedExecution<'_>,setup: &Setup,snapshots: &PrivateStore,
+    rpc: &BchRpc,server: &Server,txid: Txid) -> Result<()> {
+    let (n,nv,initial) = selected_with_outgoing(setup,&snapshots.0,1)?;
+    let (_,bv,_) = selected_with_outgoing(setup,&snapshots.0,0)?;
+    let (wallet,received) = n.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+        1003,nv.commitment(),bv.frame(),bv.signature())?;
+    let ack = wallet.acknowledgement(&setup.quote)?;
+    let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder,&agreed)?;
+    let pins = NegotiationPins {initial,selection:*n.commitment(),outgoing:*nv.commitment(),received,agreement};
+    let metadata = PrivateStore::new()?;
+    let mut native = AdmittedExecution::admit(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,
+        Role::NativeFunder,setup.quote.commitment(),pins,1005)?;
+    let key = SigningKey::from_bytes(&[1;32]); let wrong = SigningKey::from_bytes(&[2;32]);
+    assert!(sender.prepare_bch_funding_message(1017).is_err());
+    let frame = sender.prepare_bch_funding_message(1020)?;
+    assert_eq!(sender.prepare_bch_funding_message(1021)?,frame);
+    assert!(sender.prepare_bch_funding_message(1019).is_err());
+    assert!(native.prepare_bch_funding_message(1020).is_err());
+    let signature = key.sign(&message::signing_bytes(&frame)?).to_bytes();
+    assert!(sender.retain_outgoing_bch_funding_message(1021,&wrong.sign(&message::signing_bytes(&frame)?).to_bytes()).is_err());
+    let outgoing = sender.retain_outgoing_bch_funding_message(1021,&signature)?;
+    assert_eq!(outgoing.signed().lock_outpoint().txid,txid);
+    assert_eq!(sender.outgoing_bch_funding_message()?.unwrap().frame(),frame);
+    assert!(sender.accept_bch_funding_message(1022,&frame,&signature).is_err());
+    assert!(native.accept_bch_funding_message(1022,&frame,&signature).is_err());
+    let refund = native.prepare_bch_refund_adaptor(1006)?;
+    let refund_signature = wrong.sign(&agreement::refund::signing_bytes(&refund)?).to_bytes();
+    native.retain_outgoing_bch_refund(1007,&refund_signature)?;
+    assert!(native.accept_bch_funding_message(1022,&frame,&wrong.sign(&message::signing_bytes(&frame)?).to_bytes()).is_err());
+    for field in ["schema","quote","agreement","swap","signed","sources","maximum_fee","minimum_change"] {
+        let mut changed: Value = serde_json::from_slice(&frame)?;
+        changed[field] = match field {
+            "schema"|"swap" => json!("changed"), "maximum_fee" => json!(5001), "minimum_change" => json!(1),
+            _ => json!([]),
+        };
+        let bytes = serde_json::to_vec(&changed)?;
+        let signature = key.sign(&message::signing_bytes(&bytes)?).to_bytes();
+        assert!(native.accept_bch_funding_message(1022,&bytes,&signature).is_err(),"changed {field}");
+    }
+    let mut noncanonical = frame.clone(); noncanonical.push(b' ');
+    let bad_signature = key.sign(&message::signing_bytes(&noncanonical)?).to_bytes();
+    assert!(native.accept_bch_funding_message(1022,&noncanonical,&bad_signature).is_err());
+    assert!(native.accept_bch_funding_message(1006,&frame,&signature).is_err());
+    assert!(native.accept_bch_funding_message(2000,&frame,&signature).is_err());
+    let received = native.accept_bch_funding_message(1022,&frame,&signature)?;
+    assert_eq!(received.signed().lock_outpoint().txid,txid);
+    assert_eq!(native.accept_bch_funding_message(1023,&frame,&signature)?.frame(),frame);
+    assert!(native.accept_bch_funding_message(1021,&frame,&signature).is_err());
+    server.state.lock().unwrap().observation_mode = 0;
+    assert_eq!(native.observe_received_bch_funding(rpc).await?.status(),
+        crate::bch_rpc::observation::FundingStatus::ConfirmedUnspent {confirmations:3});
+    drop(native);
+    let native = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    assert_eq!(native.received_bch_funding_message()?.unwrap().frame(),frame);
+    let record = metadata.0.join(format!("{}.bch-funding-message-received",setup.quote.terms()["swapId"]));
+    let saved = std::fs::read(&record)?; std::fs::write(&record,b"{}")?;
+    assert!(native.received_bch_funding_message().is_err());
+    assert!(native.observe_received_bch_funding(rpc).await.is_err());
+    std::fs::write(&record,saved)?;
+    assert_eq!(native.received_bch_funding_message()?.unwrap().signed().lock_outpoint().txid,txid);
+    server.state.lock().unwrap().observation_mode = 2;
+    Ok(())
+}
