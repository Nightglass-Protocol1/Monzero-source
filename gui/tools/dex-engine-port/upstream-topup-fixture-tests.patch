+#[cfg(unix)]
+#[tokio::test]
+#[ignore = "requires an open buyer fixture wallet holding at least the reserve"]
+async fn native_topup_dispatch() -> Result<()> {
+    use swap_machine::native_funding_rpc::topup_dispatch::dispatch_topup;
+    use swap_machine::native_funding_rpc::topup_journal::TopUpRequest;
+    use swap_core::{xmz::XmzAmount, xmz_address::{XmzAddress, XmzNetwork}};
+    let address = |name| -> Result<XmzAddress> {
+        Ok(XmzAddress::parse(XmzNetwork::Mainnet, &std::env::var(name)?)?)
+    };
+    let buyer_wallet = address("MONZERO_TEST_TOPUP_BUYER_WALLET")?;
+    let destination = address("MONZERO_TEST_TOPUP_DESTINATION")?;
+    anyhow::ensure!(buyer_wallet != destination, "fixture requires distinct buyer wallet and destination");
+    let lock_txid = std::env::var("MONZERO_TEST_TOPUP_LOCK")?;
+    anyhow::ensure!(lock_txid.len() == 64, "invalid topup fixture lock txid");
+    let reserve = XmzAmount::from_atom_string(&std::env::var("MONZERO_TEST_TOPUP_RESERVE_ATOMS")?)
+        .map_err(|_| anyhow::anyhow!("invalid topup fixture reserve"))?;
+    let maximum_fee = XmzAmount::from_atom_string(&std::env::var("MONZERO_TEST_TOPUP_MAX_FEE_ATOMS")?)
+        .map_err(|_| anyhow::anyhow!("invalid topup fixture fee ceiling"))?;
+    let genesis = "84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4";
+    let journal_directory = std::path::PathBuf::from(std::env::var_os("MONZERO_TEST_TOPUP_JOURNAL")
+        .context("missing topup fixture journal directory")?);
+    let request = TopUpRequest { buyer_wallet: buyer_wallet.clone(), destination: destination.clone(),
+        lock_txid: lock_txid.clone(), reserve, maximum_fee, account: 0, priority: 1 };
+
+    // Wrong chain must fail before broadcast; the buyer's wallet stays untouched.
+    let error = dispatch_topup(native_rpc::authenticated_fixture()?, &journal_directory,
+        &"0".repeat(64), request.clone()).await.err().context("accepted wrong topup chain")?;
+    anyhow::ensure!(error.to_string() == "unexpected relay chain", "unexpected topup chain rejection");
+
+    let outcome = dispatch_topup(native_rpc::authenticated_fixture()?, &journal_directory,
+        genesis, request.clone()).await?;
+    anyhow::ensure!(outcome.receipt_persisted, "topup receipt not persisted");
+    anyhow::ensure!(outcome.transfer.fee.atoms() > 0 && outcome.transfer.weight > 0, "invalid dispatched topup transfer");
+
+    // The same approved intent must never dispatch a second payment: the
+    // durable reservation itself rejects it before any RPC call.
+    let error = dispatch_topup(native_rpc::authenticated_fixture()?, &journal_directory,
+        genesis, request).await.err().context("accepted duplicate topup dispatch")?;
+    anyhow::ensure!(error.downcast_ref::<std::io::Error>().map(std::io::Error::kind)
+        == Some(std::io::ErrorKind::AlreadyExists), "unexpected duplicate-dispatch rejection: {error}");
+
+    anyhow::ensure!(export_fixture("MONZERO_TEST_TOPUP_RESULT", &format!("{}\n", outcome.transfer.txid))?,
+        "missing topup fixture result path");
+    Ok(())
+}
