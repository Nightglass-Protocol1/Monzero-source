+use super::*;
+use crate::bch::covenant::CovenantTerms;
+use bitcoin::{hashes::Hash, Txid, secp256k1::PublicKey};
+
+fn fixture() -> Result<(CovenantTerms, Vec<u8>, Transaction)> {
+    let v: serde_json::Value = serde_json::from_str(include_str!("../reference-covenant.json"))?;
+    let sig: serde_json::Value = serde_json::from_str(include_str!("../reference-signature.json"))?;
+    let terms = CovenantTerms { fee_atoms: 1000, delay_blocks: 2,
+        signing_key: PublicKey::from_slice(&hex::decode(v["publicKey"].as_str().unwrap())?)?,
+        redeem_destination: ScriptBuf::from_bytes(hex::decode(v["redeemDestination"].as_str().unwrap())?),
+        timeout_destination: ScriptBuf::from_bytes(hex::decode(v["timeoutDestination"].as_str().unwrap())?) };
+    let reference: Transaction = deserialize(&hex::decode(include_str!("../reference-redemption.hex").trim())?)?;
+    Ok((terms, hex::decode(sig["signature"].as_str().unwrap())?, reference))
+}
+fn funding(contract: &Covenant, amount: u64) -> (Transaction, SpendTerms) {
+    let tx = Transaction { version: Version::TWO, lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn { previous_output: OutPoint { txid: Txid::from_byte_array([9;32]), vout: 1 },
+            script_sig: ScriptBuf::new(), sequence: Sequence::MAX, witness: Witness::new() }],
+        output: vec![TxOut { value: Amount::from_sat(amount), script_pubkey: contract.script_pubkey() }] };
+    let terms = SpendTerms { outpoint: OutPoint { txid: tx.compute_txid(), vout: 0 }, locked_atoms: amount,
+        maximum_fee_atoms: contract.terms().fee_atoms, minimum_output_atoms: 546 };
+    (tx, terms)
+}
+
+#[test]
+fn redemption_matches_reference_except_synthetic_parent() -> Result<()> {
+    let (terms, signature, mut reference) = fixture()?;
+    let contract = Covenant::new(terms)?;
+    let (parent, spend) = funding(&contract, reference.output[0].value.to_sat()+1000);
+    reference.input[0].previous_output = spend.outpoint;
+    let tx = contract.prepare_redemption(&serialize(&parent), &spend, &signature)?;
+    assert_eq!(serialize(&tx), serialize(&reference));
+    assert!(contract.prepare_redemption(&serialize(&parent), &spend, &[]).is_err());
+    let mut damaged = signature; damaged.push(1);
+    assert!(contract.prepare_redemption(&serialize(&parent), &spend, &damaged).is_err());
+    Ok(())
+}
+
+#[test]
+fn timeout_stages_use_their_own_delays_and_exact_remaining_amounts() -> Result<()> {
+    let (mut refund_terms, _, _) = fixture()?;
+    refund_terms.delay_blocks = 5; refund_terms.fee_atoms = 2000;
+    let refund = Covenant::new(refund_terms.clone())?;
+    let mut lock_terms = refund_terms; lock_terms.delay_blocks = 2; lock_terms.fee_atoms = 1000;
+    lock_terms.timeout_destination = refund.script_pubkey();
+    let lock = Covenant::new(lock_terms)?;
+    let (parent, spend) = funding(&lock, 100_000);
+    let first = lock.prepare_timeout(&serialize(&parent), &spend)?;
+    assert_eq!(first.input[0].sequence, Sequence(2));
+    assert_eq!(first.output[0].value.to_sat(), 99_000);
+    assert_eq!(first.output[0].script_pubkey, refund.script_pubkey());
+    let next = SpendTerms { outpoint: OutPoint { txid: first.compute_txid(), vout: 0 },
+        locked_atoms: 99_000, maximum_fee_atoms: 2000, minimum_output_atoms: 546 };
+    let second = refund.prepare_timeout(&serialize(&first), &next)?;
+    assert_eq!(second.input[0].sequence, Sequence(5));
+    assert_eq!(second.output[0].value.to_sat(), 97_000);
+    assert_eq!(second.output[0].script_pubkey, refund.terms().timeout_destination);
+    for (tx, contract) in [(&first, &lock), (&second, &refund)] {
+        assert_eq!(tx.version, Version::TWO); assert_eq!(tx.lock_time, absolute::LockTime::ZERO);
+        assert_eq!(tx.input.len(), 1); assert_eq!(tx.output.len(), 1);
+        assert!(tx.input[0].witness.is_empty());
+        assert_eq!(tx.input[0].script_sig, Builder::new().push_slice(
+            PushBytesBuf::try_from(contract.redeem_script().as_bytes().to_vec())?).into_script());
+    }
+    Ok(())
+}
+
+#[test]
+fn funding_and_spend_policy_rejections_apply_to_both_branches() -> Result<()> {
+    let (terms, signature, _) = fixture()?; let contract = Covenant::new(terms)?;
+    let (parent, mut spend) = funding(&contract, 100_000);
+    let rejected = |raw: &[u8], terms: &SpendTerms| {
+        assert!(contract.prepare_timeout(raw, terms).is_err());
+        assert!(contract.prepare_redemption(raw, terms, &signature).is_err());
+    };
+    spend.maximum_fee_atoms = 999; rejected(&serialize(&parent), &spend); spend.maximum_fee_atoms = 1000;
+    spend.minimum_output_atoms = 99_001; rejected(&serialize(&parent), &spend); spend.minimum_output_atoms = 0;
+    rejected(&serialize(&parent), &spend); spend.minimum_output_atoms = 546;
+    spend.locked_atoms -= 1; rejected(&serialize(&parent), &spend); spend.locked_atoms += 1;
+    spend.outpoint.vout = 1; rejected(&serialize(&parent), &spend); spend.outpoint.vout = 0;
+    let mut changed = parent.clone(); changed.output[0].value = Amount::from_sat(99_999);
+    rejected(&serialize(&changed), &spend); // Changed identity.
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend); // Changed amount.
+    changed = parent.clone(); changed.output[0].script_pubkey = ScriptBuf::new();
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend);
+    changed = parent.clone(); changed.input[0].witness.push([1]);
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend);
+    changed = parent.clone(); changed.input[0].previous_output = OutPoint::null();
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend);
+    // Even an unrelated token-bearing output rejects this native-only boundary.
+    changed = parent.clone(); changed.output.push(TxOut { value: Amount::ZERO,
+        script_pubkey: ScriptBuf::from_bytes([vec![0xef], vec![0xbb;32], vec![0x10,1,0x51]].concat()) });
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend);
+    changed = parent.clone(); changed.output.push(TxOut { value: Amount::from_sat(MAX_MONEY_ATOMS), script_pubkey: ScriptBuf::new() });
+    spend.outpoint.txid = changed.compute_txid(); rejected(&serialize(&changed), &spend);
+    let (small, policy) = funding(&contract, 999); rejected(&serialize(&small), &policy);
+    spend.outpoint.txid = parent.compute_txid(); let mut raw = serialize(&parent); raw.push(0);
+    rejected(&raw, &spend); rejected(&[], &spend);
+    Ok(())
+}
