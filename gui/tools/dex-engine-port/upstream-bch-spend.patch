+//! Native-BCH covenant spends. Returned transactions are unobserved and must not
+//! be relayed without authenticated terms, approval and current chain checks.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{absolute, consensus::{deserialize, serialize}, transaction::Version,
+    Amount, OutPoint, ScriptBuf, Sequence, Transaction, TxIn, TxOut, Witness,
+    script::{Builder, PushBytesBuf}};
+use ecdsa_fun::fun::Point;
+use super::covenant::Covenant;
+
+const MAX_MONEY_ATOMS: u64 = 2_100_000_000_000_000;
+const MAX_FUNDING_BYTES: usize = 2_000_000;
+
+pub struct SpendTerms {
+    pub outpoint: OutPoint,
+    pub locked_atoms: u64,
+    pub maximum_fee_atoms: u64,
+    pub minimum_output_atoms: u64,
+}
+
+impl Covenant {
+    /// Forward to the agreed timeout destination with this stage's CSV delay.
+    /// This checks neither the chain's activation state nor actual maturity.
+    pub fn prepare_timeout(&self, funding_raw: &[u8], terms: &SpendTerms) -> Result<Transaction> {
+        let script_sig = Builder::new()
+            .push_slice(PushBytesBuf::try_from(self.redeem_script().as_bytes().to_vec())?).into_script();
+        self.prepare_spend(funding_raw, terms, script_sig,
+            Sequence(u32::from(self.terms().delay_blocks)), self.terms().timeout_destination.clone())
+    }
+
+    /// Embeds a verified CHECKDATASIG signature. Publishing the result may reveal
+    /// an adaptor decryption key; callers must enforce the protocol release gate.
+    pub fn prepare_redemption(&self, funding_raw: &[u8], terms: &SpendTerms,
+        signature_der: &[u8]) -> Result<Transaction> {
+        let public = Point::from_bytes(self.terms().signing_key.serialize())
+            .context("invalid BCH covenant signing point")?;
+        self.data_message().verify_der(&public, signature_der)?;
+        let script_sig = Builder::new().push_slice(PushBytesBuf::try_from(signature_der.to_vec())?)
+            .push_slice(PushBytesBuf::try_from(self.redeem_script().as_bytes().to_vec())?).into_script();
+        self.prepare_spend(funding_raw, terms, script_sig, Sequence::ZERO,
+            self.terms().redeem_destination.clone())
+    }
+
+    fn prepare_spend(&self, funding_raw: &[u8], terms: &SpendTerms, script_sig: ScriptBuf,
+        sequence: Sequence, destination: ScriptBuf) -> Result<Transaction> {
+        ensure!(funding_raw.len() <= MAX_FUNDING_BYTES, "oversized BCH funding transaction");
+        let funding: Transaction = deserialize(funding_raw).context("invalid BCH funding bytes")?;
+        ensure!(!funding.input.is_empty() && !funding.output.is_empty() && !funding.is_coinbase()
+            && funding.input.iter().all(|input| !input.previous_output.is_null() && input.witness.is_empty()),
+            "BCH swap funding requires non-coinbase legacy inputs");
+        ensure!(serialize(&funding) == funding_raw, "noncanonical BCH funding encoding");
+        // In an unmodified Bitcoin-format decoder the token prefix is retained
+        // at the beginning of the serialized output script field. Never strip it.
+        // https://cashtokens.org/docs/spec/chip/#token-encoding
+        ensure!(funding.output.iter().all(|output| output.script_pubkey.as_bytes().first() != Some(&0xef)),
+            "CashToken-bearing funding is not supported for native BCH swaps");
+        let total = funding.output.iter().try_fold(0u64, |sum, output| sum.checked_add(output.value.to_sat()))
+            .context("BCH funding output total overflow")?;
+        ensure!(total <= MAX_MONEY_ATOMS, "BCH funding exceeds monetary range");
+        ensure!(funding.compute_txid() == terms.outpoint.txid, "BCH funding transaction identity mismatch");
+        let output = funding.output.get(terms.outpoint.vout as usize).context("missing BCH funding output")?;
+        ensure!(output.script_pubkey == self.script_pubkey() && output.value.to_sat() == terms.locked_atoms,
+            "BCH funding output differs from covenant terms");
+        let fee = self.terms().fee_atoms;
+        ensure!(fee <= terms.maximum_fee_atoms && terms.minimum_output_atoms > 0,
+            "BCH spend exceeds fee policy or lacks minimum output");
+        let amount = terms.locked_atoms.checked_sub(fee).context("BCH covenant fee exceeds lock")?;
+        ensure!(amount >= terms.minimum_output_atoms, "BCH covenant spend below minimum output");
+        Ok(Transaction { version: Version::TWO, lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn { previous_output: terms.outpoint, script_sig, sequence, witness: Witness::new() }],
+            output: vec![TxOut { value: Amount::from_sat(amount), script_pubkey: destination }] })
+    }
+}
