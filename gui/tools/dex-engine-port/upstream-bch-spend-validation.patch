+#[test]
+fn received_spends_bind_every_transaction_field_before_signature_extraction() -> Result<()> {
+    let (terms, signature, _) = fixture()?; let contract = Covenant::new(terms)?;
+    let (parent, spend) = funding(&contract, 100_000); let funding_raw = serialize(&parent);
+    let redeem = contract.prepare_redemption(&funding_raw, &spend, &signature)?;
+    let timeout = contract.prepare_timeout(&funding_raw, &spend)?;
+    assert_eq!(contract.redemption_signature(&funding_raw, &spend, &serialize(&redeem))?, signature);
+    contract.verify_timeout(&funding_raw, &spend, &serialize(&timeout))?;
+    assert!(contract.redemption_signature(&funding_raw, &spend, &serialize(&timeout)).is_err());
+    assert!(contract.verify_timeout(&funding_raw, &spend, &serialize(&redeem)).is_err());
+    for tx in [redeem, timeout] {
+        let mut mutations = Vec::new();
+        let mut changed = tx.clone(); changed.version = Version::ONE; mutations.push(changed);
+        let mut changed = tx.clone(); changed.lock_time = absolute::LockTime::from_height(1)?; mutations.push(changed);
+        let mut changed = tx.clone(); changed.input[0].previous_output.vout += 1; mutations.push(changed);
+        let mut changed = tx.clone(); changed.input[0].previous_output.txid = Txid::from_byte_array([8;32]); mutations.push(changed);
+        let mut changed = tx.clone(); changed.input[0].sequence = Sequence(12); mutations.push(changed);
+        let mut changed = tx.clone(); changed.input[0].witness.push([1]); mutations.push(changed);
+        let mut changed = tx.clone(); changed.input.push(changed.input[0].clone()); mutations.push(changed);
+        let mut changed = tx.clone(); changed.input.clear(); mutations.push(changed);
+        let mut changed = tx.clone(); changed.output[0].value = Amount::from_sat(98_999); mutations.push(changed);
+        let mut changed = tx.clone(); changed.output[0].script_pubkey = ScriptBuf::new(); mutations.push(changed);
+        let mut changed = tx.clone(); changed.output.push(changed.output[0].clone()); mutations.push(changed);
+        let mut changed = tx.clone(); changed.output.clear(); mutations.push(changed);
+        let mut changed = tx.clone(); changed.input[0].script_sig = ScriptBuf::new(); mutations.push(changed);
+        let mut changed = tx.clone(); let mut script = changed.input[0].script_sig.clone().into_bytes();
+        script.push(0x61); changed.input[0].script_sig = ScriptBuf::from_bytes(script); mutations.push(changed);
+        // Keep the same signature and script but use a nonminimal PUSHDATA1.
+        let mut changed = tx.clone(); let script = changed.input[0].script_sig.as_bytes();
+        if script[0] < 0x4c {
+            changed.input[0].script_sig = ScriptBuf::from_bytes([vec![0x4c, script[0]], script[1..].to_vec()].concat());
+            mutations.push(changed);
+        }
+        for changed in mutations {
+            let raw = serialize(&changed);
+            assert!(contract.redemption_signature(&funding_raw, &spend, &raw).is_err());
+            assert!(contract.verify_timeout(&funding_raw, &spend, &raw).is_err());
+        }
+        let mut trailing = serialize(&tx); trailing.push(0);
+        assert!(contract.redemption_signature(&funding_raw, &spend, &trailing).is_err());
+        assert!(contract.verify_timeout(&funding_raw, &spend, &trailing).is_err());
+    }
