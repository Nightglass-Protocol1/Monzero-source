 impl Covenant {
+    /// Validate exact timeout bytes, including the agreed funding identity,
+    /// sequence, destination and absolute fee. This is not chain observation.
+    pub fn verify_timeout(&self, funding_raw: &[u8], terms: &SpendTerms,
+        proposed: &[u8]) -> Result<()> {
+        let expected = self.prepare_timeout(funding_raw, terms)?;
+        ensure!(serialize(&expected) == proposed, "BCH timeout differs from agreed spend");
+        Ok(())
+    }
+
+    /// Extract a data signature only after validating the complete redemption.
+    /// An untrusted peer can supply these bytes before broadcast: callers must
+    /// separately establish chain confirmation before treating this as payment.
+    pub fn redemption_signature(&self, funding_raw: &[u8], terms: &SpendTerms,
+        proposed: &[u8]) -> Result<Vec<u8>> {
+        ensure!(proposed.len() <= 10_000, "oversized BCH covenant redemption");
+        let transaction: Transaction = deserialize(proposed).context("invalid BCH redemption bytes")?;
+        ensure!(transaction.input.len() == 1, "BCH redemption requires exactly one input");
+        let first = transaction.input[0].script_sig.instructions_minimal().next()
+            .context("missing BCH redemption data signature")??;
+        let signature = match first {
+            bitcoin::script::Instruction::PushBytes(bytes) => bytes.as_bytes(),
+            _ => anyhow::bail!("BCH redemption signature is not a data push"),
+        };
+        let expected = self.prepare_redemption(funding_raw, terms, signature)?;
+        ensure!(serialize(&expected) == proposed, "BCH redemption differs from agreed spend");
+        Ok(signature.to_vec())
+    }
