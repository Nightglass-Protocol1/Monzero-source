+//! Real helper refund relay against the owned loopback RPC fixture.
+use super::*;
+use swap_core::bch::funding::SignedFunding;
+fn invoke(helper: &std::path::Path,path: &std::path::Path,action: &str,
+    commitment: Option<&str>,success: bool) -> Result<Value> {
+    let id=uuid::Uuid::new_v4();
+    let mut request=json!({"schema":format!("monzero-bch-refund-{action}-request-v1"),"requestId":id});
+    if let Some(commitment)=commitment {request["commitment"]=json!(commitment);}
+    let mut child=Command::new(helper).arg(format!("--refund-{action}-stdio-v1")).arg(path)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("missing helper stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    assert_eq!(output.status.success(),success,"unexpected refund {action}: {}",String::from_utf8_lossy(&output.stderr));
+    if !success {assert!(output.stdout.is_empty());return Ok(Value::Null)}
+    assert!(output.stderr.is_empty());assert!(output.stdout.len()<=16384);
+    let response:Value=serde_json::from_slice(&output.stdout)?;
+    assert_eq!(response.as_object().unwrap().len(),8);
+    assert_eq!(response["schema"],format!("monzero-bch-refund-{action}-response-v1"));
+    assert_eq!(response["requestId"],id.to_string());assert_eq!(response["executable"],false);
+    assert_eq!(response["chainObserved"],action=="observe");
+    Ok(response)
+}
+pub(super) fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: &Server,rpc: &BchRpc,signed: &SignedFunding,helper: &std::path::Path,
+    admission: &std::path::Path,script: &bitcoin::Script) -> Result<()> {
+    let program=match (std::env::var_os("MONZERO_BCH_QT_REFUND_PROBE"),std::env::var_os("MONZERO_BCH_QT_REFUND_PROBE_SHA256")) {
+        (None,None)=>helper.to_path_buf(),
+        (Some(path),Some(expected))=>{
+            let path=PathBuf::from(path);
+            ensure!(path.is_absolute() && path.canonicalize()?==path
+                && expected.to_str()==Some(hex(&Sha256::digest(std::fs::read(&path)?)).as_str()),"invalid Qt refund probe pin");
+            path
+        }
+        _=>anyhow::bail!("incomplete Qt refund probe configuration"),
+    };
+    let via_qt=program!=helper;
+    let secrets=contents(&snapshots.0)?;
+    let original:Value=serde_json::from_slice(&std::fs::read(admission)?)?;
+    for mode in [0,1] {
+        let copied=PrivateStore::new()?;let config=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {
+            let entry=entry?;std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;
+        }
+        let mut value=original.clone();value["metadataDirectory"]=json!(copied.0);
+        let admission=config.0.join("admission.json");save(&admission,&serde_json::to_vec(&value)?)?;
+        let wrapper=config.0.join("refund.json");
+        save(&wrapper,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-refund-v1",
+            "admissionConfigFile":admission,"deploymentCommitment":hex(&rpc.deployment_commitment()?),"safetyBlocks":5}))?)?;
+        let cookie=config.0.join("cookie");save(&cookie,b"user:pass\n")?;
+        let rpc_path=config.0.join("rpc.json");
+        save(&rpc_path,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-funding-rpc-v1",
+            "port":server.port,"wallet":"test","anchor":"bchreg:qanchor","anchorScript":script.to_hex_string(),
+            "cookieFile":cookie,"checkpointHeight":1,"checkpoint":"07".repeat(32),"subversion":"/Bitcoin Cash Node:29.0.0/"}))?)?;
+        let submission=config.0.join("submission.json");
+        save(&submission,&serde_json::to_vec(&json!({"schema":"monzero-private-bch-refund-submission-v1",
+            "refundConfigFile":wrapper,"rpcFile":rpc_path}))?)?;
+        let execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let recovery=execution.retained_bch_recovery()?.context("missing recovery")?;
+        let cancel=recovery.cancel().clone();
+        let refund: Transaction=bitcoin::consensus::deserialize(recovery.refund_bytes())?;drop(execution);
+        let txid=refund.compute_txid().to_string();let trade=&setup.quote.terms()["swapId"];
+        let intent=copied.0.join(format!("{trade}.bch-refund-relay-intent"));
+        {
+            let mut state=server.state.lock().unwrap();state.cancel=Some(cancel);state.refund=Some(refund);state.relay_mode=mode;
+            state.observed=Some(signed.transaction().clone());state.observed_vout=signed.lock_outpoint().vout;
+            state.observation_mode=23;state.observation_chain_calls=0;state.relay_intent=Some(intent.clone());state.locked=true;
+        }
+        let calls=server.state.lock().unwrap().refund_relay_calls;
+        let before=contents(&copied.0)?;
+        let reviewed=invoke(&program,&wrapper,"review",None,true)?;
+        let approval=reviewed["review"]["commitment"].as_str().context("missing commitment")?;
+        assert_eq!(reviewed["review"]["details"]["txid"],txid);
+        assert_eq!(invoke(&program,&wrapper,"status",None,true)?["relay"]["state"],"not-attempted");
+        invoke(&program,&submission,"submit",Some(&"00".repeat(32)),false)?;
+        assert_eq!(contents(&copied.0)?,before);
+        server.state.lock().unwrap().recovery_output_spent=true;
+        invoke(&program,&submission,"submit",Some(approval),false)?;
+        assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls);
+        server.state.lock().unwrap().recovery_output_spent=false;
+        server.state.lock().unwrap().redemption_confirmation_mode=1;
+        invoke(&program,&submission,"submit",Some(approval),false)?;
+        assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls);
+        server.state.lock().unwrap().redemption_confirmation_mode=0;
+        invoke(&program,&submission,"submit",Some(approval),mode==0)?;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls+1);
+        let state=if mode==0 {"acknowledged"} else {"attempted"};
+        assert_eq!(invoke(&program,&wrapper,"status",None,true)?["relay"],json!({"state":state,"txid":txid,"confirmed":false}));
+        // An acknowledged helper retry returns the saved result without another relay.
+        invoke(&program,&submission,"submit",Some(approval),mode==0 && !via_qt)?;
+        assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls+1);
+        let original_wrapper=std::fs::read(&wrapper)?;
+        let mut changed:Value=serde_json::from_slice(&original_wrapper)?;changed["safetyBlocks"]=json!(6);
+        std::fs::write(&wrapper,serde_json::to_vec(&changed)?)?;
+        invoke(&program,&wrapper,"status",None,false)?;
+        invoke(&program,&submission,"observe",None,false)?;
+        invoke(&program,&submission,"submit",Some(approval),false)?;
+        std::fs::write(&wrapper,&original_wrapper)?;
+        let observed=invoke(&program,&submission,"observe",None,true)?;
+        assert_eq!(observed["observation"]["txid"],txid);assert_eq!(observed["observation"]["confirmations"],"3");
+        assert_eq!(observed["relay"]["state"],state);
+        server.state.lock().unwrap().redemption_confirmation_mode=1;
+        invoke(&program,&submission,"observe",None,false)?;
+        server.state.lock().unwrap().redemption_confirmation_mode=0;
+        assert_eq!(invoke(&program,&wrapper,"status",None,true)?["relay"]["state"],state);
+        assert_eq!(server.state.lock().unwrap().refund_relay_calls,calls+1);
+        assert_eq!(contents(&snapshots.0)?,secrets);
+    }
+    Ok(())
+}
