+    /// Return only the retained payment's inputs from this verified account scan.
+    /// Reject stale chains, insufficient depth and any prior submission before
+    /// exposing evidence for trade send review. This grants no relay consent.
+    pub fn funding_inputs_on(&self,chain:&HeaderSequence,prepared:&ObservedClaimedSpend,
+        minimum_confirmations:u64)->Result<Vec<IncludedInput<'_>>> {
+        ensure!(self.account.network()==chain.network()
+            && (1..=1000).contains(&minimum_confirmations)
+            && (1..=1000).contains(&prepared.transaction().input.len()),"invalid funding input context");
+        let candidates=self.payment_inputs()?;
+        let by_outpoint=candidates.iter().map(|input|(bitcoin::OutPoint {txid:input.transaction.txid(),vout:input.vout},input))
+            .collect::<BTreeMap<_,_>>();
+        let inputs=prepared.transaction().input.iter().map(|input| {
+            let found=by_outpoint.get(&input.previous_output).context("funding source is absent or observed spent")?;
+            Ok(IncludedInput {transaction:found.transaction,vout:found.vout,branch:found.branch,index:found.index})
+        }).collect::<Result<Vec<_>>>()?;
+        prepared.check_funding_inputs_on(chain,self.accounting(),&inputs,minimum_confirmations)?;
+        Ok(inputs)
+    }
