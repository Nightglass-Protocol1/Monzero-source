+//! Same-tip observed-input policy combined with durable claims and signing.
+//! An incomplete or stale server view can omit spends; no freshness or complete
+//! unspentness guarantee, broadcast permission or automatic release is implied.
+use super::*;
+use crate::litecoin_light::accounting::ObservedWallet;
+use super::super::claims::ClaimedSpend;
+use bitcoin::hashes::sha256;
+use std::collections::BTreeMap;
+
+pub struct ObservedClaimedSpend {
+    claimed:ClaimedSpend,
+    network:LtcNetwork,height:u32,tip:BlockHash,
+    inputs:Vec<(OutPoint,Amount)>,
+}
+fn require_observed(chain:&HeaderSequence,observed:&ObservedWallet,network:LtcNetwork,
+    height:u32,tip:BlockHash,inputs:&[(OutPoint,Amount)])->Result<()> {
+    ensure!(chain.network()==network && chain.height()==height && chain.contains(height,tip),
+        "Litecoin chain changed; repeat spend review");
+    ensure!(observed.height()==height && observed.tip()==tip,"Litecoin observation tip differs from spend review");
+    let coins=observed.coins().iter().map(|coin|(coin.outpoint(),coin)).collect::<BTreeMap<_,_>>();
+    for (outpoint,amount) in inputs {
+        let coin=coins.get(outpoint).context("Litecoin reviewed input is absent or observed spent")?;
+        ensure!(coin.amount()==*amount && coin.maturity_satisfied(),"Litecoin reviewed input observation mismatch");
+    }
+    Ok(())
+}
+impl ConfirmedSpendReview {
+    /// Consume the inclusion review and claim its exact inputs only if they
+    /// remain present in the supplied same-tip confirmed/pending observation.
+    pub fn retain_observed(self,chain:&HeaderSequence,observed:&ObservedWallet,
+        directory:&Path,operation:Uuid)->Result<ObservedClaimedSpend> {
+        let inputs=self.review.inputs.iter().map(|input|(input.outpoint,input.prevout.value)).collect::<Vec<_>>();
+        require_observed(chain,observed,self.network,self.height,self.tip,&inputs)?;
+        let claimed=ClaimedSpend::retain(directory,operation,self.review)?;
+        Ok(ObservedClaimedSpend {claimed,network:self.network,height:self.height,tip:self.tip,inputs})
+    }
+}
+impl ObservedClaimedSpend {
+    pub fn transaction(&self)->&Transaction {self.claimed.transaction()}
+    pub fn fee(&self)->Amount {self.claimed.fee()}
+    pub fn signing_commitment(&self)->sha256::Hash {self.claimed.signing_commitment()}
+    /// Require a current caller-supplied observation even on retry. A caller
+    /// must refresh it; equality of tips alone cannot prove wall-clock freshness.
+    /// The lower-level recovery API can inspect previously retained bytes.
+    pub fn approve_and_sign_on(&self,chain:&HeaderSequence,observed:&ObservedWallet,
+        seed:&SecretSeed,expected:sha256::Hash)->Result<Transaction> {
+        require_observed(chain,observed,self.network,self.height,self.tip,&self.inputs)?;
+        self.claimed.approve_and_sign(seed,expected)
+    }
+}
+#[cfg(test)]
+mod tests;
