+use super::*;
+use crate::litecoin_light::MerkleMatch;
+use bitcoin::{consensus::deserialize,hex::FromHex};
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("ltc-observed-{}",Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+#[test]
+fn observed_claim_checks_pending_spends_before_retention_and_signing()->Result<()> {
+    // Injected policy inclusion identity, not a Merkle/consensus fixture.
+    let (seed,account,mut spend,prevout)=super::super::super::super::tests::fixture()?;
+    let chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut credit=spend.clone();credit.output=vec![prevout.clone()];
+    let included=IncludedTransaction::new(MerkleMatch {txid:credit.compute_txid(),
+        block_hash:chain.header(0).unwrap().block_hash(),claimed_height:0},&credit)?;
+    spend.input[0].previous_output=OutPoint {txid:included.txid(),vout:0};
+    let payment=spend.output[0].clone();
+    let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:3}];
+    let review=||ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(1000),1);
+    let observed=ObservedWallet::reconcile(&chain,&[prevout.script_pubkey.clone()],std::slice::from_ref(&included))?;
+    let spent=ObservedWallet::reconcile_with_pending(&chain,&[prevout.script_pubkey],std::slice::from_ref(&included),&[spend.clone()])?;
+    let directory=Directory::new()?;let operation=Uuid::new_v4();
+    assert!(review()?.retain_observed(&chain,&spent,&directory.0,operation).is_err());
+    assert_eq!(fs::read_dir(&directory.0)?.count(),0);
+    let retained=review()?.retain_observed(&chain,&observed,&directory.0,operation)?;
+    let count=fs::read_dir(&directory.0)?.count();let commitment=retained.signing_commitment();
+    assert!(retained.approve_and_sign_on(&chain,&spent,&seed,commitment).unwrap_err().to_string().contains("observed spent"));
+    assert_eq!(fs::read_dir(&directory.0)?.count(),count);
+    assert_eq!(retained.approve_and_sign_on(&chain,&observed,&seed,commitment)?.input[0].witness.len(),2);
+    assert!(retained.approve_and_sign_on(&chain,&spent,&seed,commitment).is_err());Ok(())
+}
+#[test]
+fn independent_inclusion_can_be_claimed_but_changed_tip_rejects_signing()->Result<()> {
+    use crate::litecoin_light::{InclusionRequest,match_merkle_proof};
+    let fixture:serde_json::Value=serde_json::from_str(include_str!("../../../../../session/wallet/fixture.json"))?;
+    let blocks=fixture["blocks"].as_array().unwrap();let block=&blocks[0];
+    let header=Vec::from_hex(block["header"].as_str().unwrap())?;let raw=Vec::from_hex(block["transaction"].as_str().unwrap())?;
+    let credit:Transaction=deserialize(&raw)?;let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    chain.append(&header,u64::MAX-7200)?;
+    let request=InclusionRequest {id:7,txid:credit.compute_txid(),height:1,block_hash:chain.header(1).unwrap().block_hash()};
+    let proof=match_merkle_proof(&request,&header,&raw,&serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":7,"result":{"block_height":1,"pos":0,"merkle":[]}}))?)?;
+    let included=IncludedTransaction::new(proof,&credit)?;
+    let master=Xpriv::new_master(NetworkKind::Test,&(0u8..16).collect::<Vec<_>>())?;
+    let account=PublicAccount::from_master(&master,LtcNetwork::Regtest,0)?;
+    let spend:Transaction=deserialize(&Vec::from_hex(blocks[1]["transaction"].as_str().unwrap())?)?;
+    let payment=spend.output[0].clone();let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:0}];
+    let review=||ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(40000),1);
+    let script=credit.output[0].script_pubkey.clone();
+    let observed=ObservedWallet::reconcile(&chain,&[script.clone()],std::slice::from_ref(&included))?;
+    let stale=ObservedWallet::reconcile(&HeaderSequence::new(LtcNetwork::Regtest)?,&[script],&[])?;
+    let directory=Directory::new()?;
+    assert!(review()?.retain_observed(&chain,&stale,&directory.0,Uuid::new_v4()).is_err());
+    let retained=review()?.retain_observed(&chain,&observed,&directory.0,Uuid::new_v4())?;
+    chain.append(&Vec::from_hex(blocks[1]["header"].as_str().unwrap())?,u64::MAX-7200)?;
+    let wrong_seed=SecretSeed::from_bytes(Zeroizing::new([42;32]));
+    let error=retained.approve_and_sign_on(&chain,&observed,&wrong_seed,retained.signing_commitment()).unwrap_err();
+    assert!(error.to_string().contains("chain changed"));Ok(())
+}
