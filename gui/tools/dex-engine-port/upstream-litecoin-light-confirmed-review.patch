+use super::*;
+use crate::litecoin_light::{InclusionRequest,match_merkle_proof};
+use bitcoin::{consensus::deserialize,hex::FromHex};
+#[test]
+fn confirmed_review_uses_independent_inclusion_fixture_and_rejects_chain_change()->Result<()> {
+    // PUBLIC BIP32 seed used by the independent funded refresh fixture.
+    // Its synthetic external input is not a consensus-valid funding history.
+    let fixture:serde_json::Value=serde_json::from_str(include_str!("../../../../session/wallet/fixture.json"))?;
+    let blocks=fixture["blocks"].as_array().unwrap();let block=&blocks[0];
+    let header=Vec::from_hex(block["header"].as_str().unwrap())?;
+    let raw=Vec::from_hex(block["transaction"].as_str().unwrap())?;
+    let credit:Transaction=deserialize(&raw)?;
+    let mut chain=HeaderSequence::new(LtcNetwork::Regtest)?;chain.append(&header,u64::MAX-7200)?;
+    let request=InclusionRequest {id:7,txid:credit.compute_txid(),height:1,block_hash:chain.header(1).unwrap().block_hash()};
+    let proof=match_merkle_proof(&request,&header,&raw,&serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":7,"result":{"block_height":1,"pos":0,"merkle":[]}}))?)?;
+    let included=IncludedTransaction::new(proof,&credit)?;
+    let master=Xpriv::new_master(NetworkKind::Test,&(0u8..16).collect::<Vec<_>>())?;
+    let account=PublicAccount::from_master(&master,LtcNetwork::Regtest,0)?;
+    let spend:Transaction=deserialize(&Vec::from_hex(blocks[1]["transaction"].as_str().unwrap())?)?;
+    let payment=spend.output[0].clone();
+    let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:0}];
+    let review=ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(40000),1)?;
+    assert_eq!(review.fee(),Amount::from_sat(40000));assert_eq!(review.transaction(),&spend);
+    assert!(ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(40000),2).is_err());
+    let genesis=HeaderSequence::new(LtcNetwork::Regtest)?;
+    assert!(ConfirmedSpendReview::new(&genesis,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(40000),1).is_err());
+    let seed=SecretSeed::from_bytes(Zeroizing::new([42;32]));
+    assert!(review.sign_on(&genesis,&seed).unwrap_err().to_string().contains("chain changed"));
+    chain.append(&Vec::from_hex(blocks[1]["header"].as_str().unwrap())?,u64::MAX-7200)?;
+    assert!(review.sign_on(&chain,&seed).unwrap_err().to_string().contains("chain changed"));Ok(())
+}
+
+#[test]
+fn confirmed_review_signs_matching_seed_and_rejects_immature_coinbase()->Result<()> {
+    // Policy-only injected inclusion identity, not a Merkle/consensus fixture.
+    // The separate independent fixture above exercises actual Merkle matching.
+    use crate::litecoin_light::MerkleMatch;
+    let (seed,account,mut spend,prevout)=super::super::super::tests::fixture()?;
+    let chain=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut credit=spend.clone();credit.output=vec![prevout];
+    let included=|tx:&Transaction|IncludedTransaction::new(MerkleMatch {
+        txid:tx.compute_txid(),block_hash:chain.header(0).unwrap().block_hash(),claimed_height:0},tx);
+    let receipt=included(&credit)?;spend.input[0].previous_output=OutPoint {txid:receipt.txid(),vout:0};
+    let payment=spend.output[0].clone();
+    let inputs=[IncludedInput {transaction:&receipt,vout:0,branch:Branch::Receive,index:3}];
+    let review=ConfirmedSpendReview::new(&chain,&account,spend.clone(),&inputs,&payment,None,Amount::from_sat(1000),1)?;
+    let signed=review.sign_on(&chain,&seed)?;assert_eq!(signed.compute_txid(),spend.compute_txid());
+    assert_eq!(signed.input[0].witness.len(),2);
+    credit.input[0].previous_output=OutPoint::null();let coinbase=included(&credit)?;
+    spend.input[0].previous_output.txid=coinbase.txid();
+    let inputs=[IncludedInput {transaction:&coinbase,vout:0,branch:Branch::Receive,index:3}];
+    let result=ConfirmedSpendReview::new(&chain,&account,spend,&inputs,&payment,None,Amount::from_sat(1000),1);
+    assert!(result.err().unwrap().to_string().contains("immature"));Ok(())
+}
