+//! Review anchored to selected-chain transaction inclusions. This does not
+//! establish current unspentness, complete history, reservations or consent.
+use super::*;
+use crate::litecoin_light::{headers::HeaderSequence,transaction::IncludedTransaction};
+use bitcoin::BlockHash;
+pub struct IncludedInput<'a> {
+    pub transaction:&'a IncludedTransaction,
+    pub vout:u32,
+    pub branch:Branch,
+    pub index:u32,
+}
+pub struct ConfirmedSpendReview {
+    review:SpendReview,
+    network:LtcNetwork,
+    height:u32,
+    tip:BlockHash,
+}
+impl ConfirmedSpendReview {
+    pub fn new(chain:&HeaderSequence,account:&PublicAccount,transaction:Transaction,
+        inputs:&[IncludedInput<'_>],payment:&TxOut,change_index:Option<u32>,
+        maximum_fee:Amount,minimum_confirmations:u64)->Result<Self> {
+        ensure!(chain.network()==account.network() && minimum_confirmations>0
+            && !inputs.is_empty() && inputs.len()<=1000,"invalid Litecoin inclusion review context");
+        let mut owned=Vec::with_capacity(inputs.len());
+        for input in inputs {
+            let confirmations=input.transaction.confirmations_on(chain).context("Litecoin funding input is orphaned")?;
+            ensure!(confirmations>=minimum_confirmations
+                && (!input.transaction.is_coinbase() || confirmations>=100),"Litecoin funding input is immature");
+            let prevout=input.transaction.outputs().get(input.vout as usize).context("missing Litecoin funding output")?.clone();
+            owned.push(OwnedInput {outpoint:OutPoint {txid:input.transaction.txid(),vout:input.vout},
+                prevout,branch:input.branch,index:input.index});
+        }
+        let review=SpendReview::new(account,transaction,owned,payment,change_index,maximum_fee)?;
+        Ok(Self {review,network:chain.network(),height:chain.height(),
+            tip:chain.header(chain.height()).context("missing Litecoin selected tip")?.block_hash()})
+    }
+    pub fn transaction(&self)->&Transaction {self.review.transaction()}
+    pub fn fee(&self)->Amount {self.review.fee()}
+    /// Even a chain extension requires a fresh review. Matching this saved tip
+    /// is not evidence of wall-clock freshness or absence of later spends.
+    pub fn sign_on(&self,chain:&HeaderSequence,seed:&SecretSeed)->Result<Transaction> {
+        ensure!(chain.network()==self.network && chain.height()==self.height
+            && chain.contains(self.height,self.tip),"Litecoin chain changed; repeat spend review");
+        self.review.sign(seed)
+    }
+}
+#[cfg(test)]
+mod tests;
