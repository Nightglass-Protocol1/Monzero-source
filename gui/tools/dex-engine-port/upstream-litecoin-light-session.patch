+//! Read-only Electrum 1.4 requests over a caller-supplied stream.
+//! Production callers must supply an authenticated TLS stream. This module
+//! does not create connections, authenticate servers or validate chain work.
+//! Matching reported genesis prevents accidental wrong-network use, not lies.
+use super::*;
+use serde::de::DeserializeOwned;
+use serde_json::{Value, json, value::RawValue};
+use std::time::Duration;
+use swap_core::litecoin_address::LtcNetwork;
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncWrite, AsyncWriteExt, BufReader};
+
+pub struct ReadSession<S> {
+    stream: BufReader<S>,
+    next_id: u64,
+    usable: bool,
+    timeout: Duration,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Reply {
+    jsonrpc: String,
+    id: u64,
+    result: Box<RawValue>,
+    error: Option<Value>,
+}
+#[derive(Deserialize)]
+struct Features { genesis_hash: String, hash_function: String }
+
+impl<S: AsyncRead + AsyncWrite + Unpin> ReadSession<S> {
+    /// Negotiates only protocol 1.4. No addresses or wallet data are queried
+    /// before the server's claimed genesis and script-hash function match.
+    pub async fn negotiate(stream: S, network: LtcNetwork) -> Result<Self> {
+        Self::negotiate_with_timeout(stream, network, Duration::from_secs(15)).await
+    }
+    async fn negotiate_with_timeout(stream: S, network: LtcNetwork, timeout: Duration) -> Result<Self> {
+        let mut session = Self { stream: BufReader::new(stream), next_id: 1, usable: true, timeout };
+        let (_, bytes) = session.exchange("server.version", json!(["Monzero", "1.4"]), MAX_RESPONSE).await?;
+        let version: [String; 2] = result(&bytes)?;
+        ensure!(!version[0].is_empty() && version[0].len() <= 256 && version[1] == "1.4",
+            "unsupported Electrum protocol");
+        let (_, bytes) = session.exchange("server.features", json!([]), MAX_RESPONSE).await?;
+        let features: Features = result(&bytes)?;
+        ensure!(features.genesis_hash == network.genesis() && features.hash_function == "sha256",
+            "wrong Electrum network or script hashing");
+        Ok(session)
+    }
+
+    /// Fetch a header, raw transparent transaction and inclusion branch.
+    /// The expected block hash and height must come from independent chain
+    /// validation, not from this server. Returns no confirmation/unspent claim.
+    pub async fn inclusion(&mut self, height: u32, block_hash: BlockHash, txid: Txid) -> Result<MerkleMatch> {
+        let matched = self.inclusion_inner(height, block_hash, txid).await;
+        if matched.is_err() { self.usable = false; }
+        matched
+    }
+    async fn inclusion_inner(&mut self, height: u32, block_hash: BlockHash, txid: Txid) -> Result<MerkleMatch> {
+        let (_, bytes) = self.exchange("blockchain.block.header", json!([height]), 1024).await?;
+        let header = decode_hex(&result::<String>(&bytes)?, 80)?;
+        ensure!(header.len() == 80, "invalid Electrum header length");
+        let parsed: Header = deserialize(&header)?;
+        ensure!(parsed.block_hash() == block_hash, "Electrum header differs from requested chain anchor");
+        let (_, bytes) = self.exchange("blockchain.transaction.get", json!([txid.to_string(), false]),
+            MAX_TRANSACTION * 2 + 1024).await?;
+        let raw = decode_hex(&result::<String>(&bytes)?, MAX_TRANSACTION)?;
+        let transaction: Transaction = deserialize(&raw)?;
+        ensure!(transaction.compute_txid() == txid, "Electrum returned another transaction");
+        let (id, proof) = self.exchange("blockchain.transaction.get_merkle", json!([txid.to_string(), height]),
+            MAX_RESPONSE).await?;
+        match_merkle_proof(&InclusionRequest { id, height, block_hash, txid }, &header, &raw, &proof)
+    }
+
+    async fn exchange(&mut self, method: &str, params: Value, limit: usize) -> Result<(u64, Vec<u8>)> {
+        ensure!(self.usable, "Electrum session requires a new connection");
+        // Set before the first await so dropping a pending future also poisons
+        // this stream. A late reply must never be consumed by another request.
+        self.usable = false;
+        let id = self.next_id;
+        self.next_id = id.checked_add(1).context("Electrum request identity exhausted")?;
+        let mut request = serde_json::to_vec(&json!({"jsonrpc":"2.0","id":id,"method":method,"params":params}))?;
+        request.push(b'\n');
+        let bytes = tokio::time::timeout(self.timeout, async {
+            self.stream.get_mut().write_all(&request).await?;
+            self.stream.get_mut().flush().await?;
+            let mut bytes = Vec::new();
+            loop {
+                let buffer = self.stream.fill_buf().await?;
+                ensure!(!buffer.is_empty(), "Electrum disconnected before completing response");
+                let end = buffer.iter().position(|b| *b == b'\n');
+                let consumed = end.map_or(buffer.len(), |end| end + 1);
+                ensure!(bytes.len() + consumed <= limit, "oversized Electrum response");
+                bytes.extend_from_slice(&buffer[..consumed]);
+                self.stream.consume(consumed);
+                if end.is_some() { break; }
+            }
+            Ok::<_, anyhow::Error>(bytes)
+        }).await.context("Electrum request deadline exceeded")??;
+        let reply: Reply = serde_json::from_slice(&bytes).context("malformed Electrum response")?;
+        ensure!(reply.jsonrpc == "2.0" && reply.id == id && reply.error.is_none(),
+            "Electrum response identity mismatch or server error");
+        self.usable = true;
+        Ok((id, bytes))
+    }
+}
+fn result<T: DeserializeOwned>(bytes: &[u8]) -> Result<T> {
+    let reply: Reply = serde_json::from_slice(bytes)?;
+    serde_json::from_str(reply.result.get()).context("invalid Electrum result")
+}
+fn decode_hex(value: &str, maximum: usize) -> Result<Vec<u8>> {
+    ensure!(!value.is_empty() && value.len() <= maximum * 2 && value.len() % 2 == 0
+        && value.bytes().all(|b| b.is_ascii_hexdigit()), "invalid Electrum hexadecimal data");
+    (0..value.len()).step_by(2).map(|i|u8::from_str_radix(&value[i..i+2],16)
+        .context("invalid Electrum hexadecimal data")).collect()
+}
+
