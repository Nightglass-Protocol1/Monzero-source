+use super::*;
+use tokio::io::{AsyncReadExt, DuplexStream};
+use tokio::task::JoinHandle;
+
+fn reply(id: u64, result: Value) -> Vec<u8> {
+    let mut bytes = serde_json::to_vec(&json!({"jsonrpc":"2.0","id":id,"result":result})).unwrap();
+    bytes.push(b'\n'); bytes
+}
+fn handshake() -> Vec<Vec<u8>> {
+    vec![reply(1,json!(["fixture","1.4"])),reply(2,json!({
+        "genesis_hash":LtcNetwork::Mainnet.genesis(),"hash_function":"sha256",
+        "server_version":"fixture","protocol_min":"1.4","protocol_max":"1.4.3","hosts":{}}))]
+}
+fn server(responses: Vec<Vec<u8>>) -> (DuplexStream, JoinHandle<Vec<Value>>) {
+    let (client, stream) = tokio::io::duplex(256);
+    let task = tokio::spawn(async move {
+        let mut stream = BufReader::new(stream);
+        let mut requests = Vec::new();
+        for response in responses {
+            let mut line = String::new();
+            assert!(stream.read_line(&mut line).await.unwrap() > 0);
+            requests.push(serde_json::from_str(&line).unwrap());
+            // Fragment replies across reads, including their trailing newline.
+            for part in response.chunks(17) {
+                if stream.get_mut().write_all(part).await.is_err() { return requests; }
+            }
+        }
+        let mut extra = Vec::new(); stream.read_to_end(&mut extra).await.unwrap();
+        assert!(extra.is_empty(), "unexpected request after failure or completion");
+        requests
+    });
+    (client, task)
+}
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b|format!("{b:02x}")).collect() }
+
+#[tokio::test]
+async fn session_fetches_fragmented_proof_only_after_network_handshake() -> Result<()> {
+    let (request, header, raw, mut proof) = super::super::tests::fixture();
+    let mut responses = handshake();
+    responses.push(reply(3,json!(hex(&header)))); responses.push(reply(4,json!(hex(&raw))));
+    proof["id"] = json!(5); responses.push(serde_json::to_vec(&proof)?); responses.last_mut().unwrap().push(b'\n');
+    let (stream, task) = server(responses);
+    let mut session = ReadSession::negotiate(stream,LtcNetwork::Mainnet).await?;
+    let matched = session.inclusion(request.height,request.block_hash,request.txid).await?;
+    assert_eq!(matched.txid(),request.txid); drop(session);
+    let requests = task.await?;
+    assert_eq!(requests.iter().map(|r|r["method"].as_str().unwrap()).collect::<Vec<_>>(),
+        ["server.version","server.features","blockchain.block.header","blockchain.transaction.get","blockchain.transaction.get_merkle"]);
+    assert_eq!(requests[0]["params"],json!(["Monzero","1.4"]));
+    assert_eq!(requests[2]["params"],json!([request.height]));
+    assert_eq!(requests[3]["params"],json!([request.txid.to_string(),false]));
+    assert_eq!(requests[4]["params"],json!([request.txid.to_string(),request.height]));
+    Ok(())
+}
+#[tokio::test]
+async fn session_rejects_wrong_network_or_hash_function_before_wallet_queries() -> Result<()> {
+    for (genesis, hash) in [(LtcNetwork::Testnet.genesis(),"sha256"),
+        (LtcNetwork::Regtest.genesis(),"sha256"),(LtcNetwork::Mainnet.genesis(),"scrypt")] {
+        let mut responses = handshake(); responses[1] = reply(2,json!({"genesis_hash":genesis,"hash_function":hash}));
+        let (stream, task) = server(responses);
+        assert!(ReadSession::negotiate(stream,LtcNetwork::Mainnet).await.is_err());
+        assert_eq!(task.await?.len(),2);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn session_refuses_unnegotiated_versions_wrong_ids_and_errors() -> Result<()> {
+    for response in [reply(1,json!(["fixture","1.4.3"])),reply(1,json!(["fixture","1.3"])),
+        reply(8,json!(["fixture","1.4"])),b"{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null,\"error\":{\"code\":-1}}\n".to_vec(),
+        b"{\"jsonrpc\":\"2.0\",\"id\":1,\"id\":1,\"result\":[\"fixture\",\"1.4\"]}\n".to_vec()] {
+        let (stream,task) = server(vec![response]);
+        assert!(ReadSession::negotiate(stream,LtcNetwork::Mainnet).await.is_err());
+        assert_eq!(task.await?.len(),1);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn session_wrong_header_permanently_stops_further_requests() -> Result<()> {
+    let (request,mut header,_,_) = super::super::tests::fixture(); header[76] ^= 1;
+    let mut responses = handshake(); responses.push(reply(3,json!(hex(&header))));
+    let (stream,task) = server(responses);
+    let mut session = ReadSession::negotiate(stream,LtcNetwork::Mainnet).await?;
+    assert!(session.inclusion(request.height,request.block_hash,request.txid).await.is_err());
+    assert!(session.inclusion(request.height,request.block_hash,request.txid).await.is_err());
+    drop(session); assert_eq!(task.await?.len(),3);
+    Ok(())
+}
+#[tokio::test]
+async fn session_rejects_unterminated_and_oversized_lines() -> Result<()> {
+    let (stream,mut peer) = tokio::io::duplex(32768);
+    let task = tokio::spawn(async move {
+        let mut buf = [0;512]; let _ = peer.read(&mut buf).await?;
+        peer.write_all(b"{\"jsonrpc\":\"2.0\"").await?;
+        Ok::<_,std::io::Error>(())
+    });
+    assert!(ReadSession::negotiate(stream,LtcNetwork::Mainnet).await.is_err()); task.await??;
+    let (stream,task) = server(vec![vec![b' ';MAX_RESPONSE+1]]);
+    assert!(ReadSession::negotiate(stream,LtcNetwork::Mainnet).await.is_err()); task.await?;
+    Ok(())
+}
+#[tokio::test]
+async fn session_timeout_and_cancelled_future_cannot_reuse_stream() -> Result<()> {
+    // A caller-owned stream with no reply proves the whole-request deadline.
+    let (stream,_peer) = tokio::io::duplex(4096);
+    assert!(ReadSession::negotiate_with_timeout(stream,LtcNetwork::Mainnet,Duration::from_millis(20)).await.is_err());
+    let (stream,_peer) = tokio::io::duplex(4096);
+    let mut session = ReadSession {stream:BufReader::new(stream),next_id:1,usable:true,timeout:Duration::from_secs(1)};
+    let timed = tokio::time::timeout(Duration::from_millis(20),session.exchange("server.features",json!([]),MAX_RESPONSE)).await;
+    assert!(timed.is_err()); assert!(!session.usable);
+    assert!(session.exchange("server.features",json!([]),MAX_RESPONSE).await.is_err());
+    Ok(())
+}
