+//! Authenticated TLS connector for the read-only Litecoin Electrum session.
+//! Trust roots follow the platform store (including its configured certificate
+//! environment). There is no plaintext fallback or certificate-verification bypass.
+use super::session::ReadSession;
+use anyhow::{Context, Result, ensure};
+use std::{net::IpAddr, sync::Arc, time::Duration};
+use swap_core::litecoin_address::LtcNetwork;
+use tokio::net::TcpStream;
+use tokio_rustls::{TlsConnector, client::TlsStream, rustls::{ClientConfig, RootCertStore,
+    crypto::ring, pki_types::ServerName}};
+
+pub struct TlsEndpoint {
+    host: String,
+    port: u16,
+    network: LtcNetwork,
+}
+impl TlsEndpoint {
+    /// A host and explicit port, not a URL. No credentials, paths or defaults.
+    pub fn new(host: String, port: u16, network: LtcNetwork) -> Result<Self> {
+        ensure!(port != 0 && !host.is_empty() && host.len() <= 253, "invalid Electrum TLS endpoint");
+        if let Ok(ip) = host.parse::<IpAddr>() {
+            ensure!(ip.to_string() == host, "noncanonical Electrum IP address");
+        } else {
+            ensure!(host.is_ascii() && host == host.to_ascii_lowercase()
+                && host.split('.').all(|label| !label.is_empty() && label.len() <= 63
+                    && !label.starts_with('-') && !label.ends_with('-')
+                    && label.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')),
+                "invalid Electrum DNS name");
+        }
+        ServerName::try_from(host.clone()).context("invalid Electrum TLS server name")?;
+        Ok(Self { host, port, network })
+    }
+
+    /// The certificate authenticates this host, not the truth of its chain data.
+    /// Litecoin header validation and independent chain selection remain required.
+    pub async fn connect(&self) -> Result<ReadSession<TlsStream<TcpStream>>> {
+        let roots = tokio::task::spawn_blocking(system_roots).await.context("TLS trust-store loader failed")??;
+        self.connect_with_roots(roots, Duration::from_secs(30)).await
+    }
+
+    async fn connect_with_roots(&self, roots: RootCertStore, deadline: Duration)
+        -> Result<ReadSession<TlsStream<TcpStream>>> {
+        ensure!(!roots.is_empty(), "empty Electrum TLS trust store");
+        let config = ClientConfig::builder_with_provider(Arc::new(ring::default_provider()))
+            .with_safe_default_protocol_versions()?
+            .with_root_certificates(roots).with_no_client_auth();
+        let connector = TlsConnector::from(Arc::new(config));
+        let name = ServerName::try_from(self.host.clone()).context("invalid Electrum TLS server name")?;
+        tokio::time::timeout(deadline, async {
+            let socket = TcpStream::connect((self.host.as_str(), self.port)).await
+                .context("Electrum TCP connection failed")?;
+            socket.set_nodelay(true)?;
+            let tls = connector.connect(name, socket).await.context("Electrum TLS authentication failed")?;
+            ReadSession::negotiate(tls, self.network).await
+        }).await.context("Electrum connection deadline exceeded")?
+    }
+}
+fn system_roots() -> Result<RootCertStore> {
+    let loaded = rustls_native_certs::load_native_certs();
+    ensure!(loaded.errors.is_empty() && !loaded.certs.is_empty(), "unable to load complete system TLS trust store");
+    let mut roots = RootCertStore::empty();
+    for cert in loaded.certs { roots.add(cert).context("invalid system TLS root certificate")?; }
+    Ok(roots)
+}
