+/// Experimental exact-net accounting, not authority to fund or settle a quote.
+/// The caller supplies the approved reserve owner; this module never chooses it.
+pub struct ExactNetRequest {
+    pub source: FullProceedsRequest,
+    pub principal: XmzAmount,
+    pub reserve_return: XmzAddress,
+}
+
+pub struct ExactNetPreview {
+    pub recipient: XmzAmount,
+    pub reserve_return: XmzAmount,
+    pub network_fee: XmzAmount,
+}
+
+/// Constructs but never exports or broadcasts a transaction. Fees are deducted
+/// exclusively from the reserve-return output, never the exact-net payout.
+pub async fn preview_exact_net(client: &NativeFundingRpc, request: &ExactNetRequest,
+    genesis: &str) -> Result<ExactNetPreview> {
+    let source = &request.source;
+    let params = exact_net_params(request)?;
+    ensure!(hash(genesis) && hash(&source.lock_txid), "invalid exact-net chain or lock");
+    let before = client.snapshot().await?;
+    ensure!(before.genesis == genesis && hash(&before.tip_hash), "unexpected exact-net chain");
+    ensure!(client.opened_wallet(source.wallet.network()).await?.as_ref() == Some(&source.wallet),
+        "unexpected exact-net wallet");
+    let incoming = client.rpc(client.wallet, "incoming_transfers",
+        json!({"transfer_type":"available", "account_index":source.account})).await?;
+    let inputs = lock_inputs(&incoming, source)?;
+    let response = client.rpc(client.wallet, "transfer", params).await?;
+    let preview = check_exact_net(&response, request, &inputs)?;
+    ensure!(client.opened_wallet(source.wallet.network()).await?.as_ref() == Some(&source.wallet),
+        "exact-net wallet changed");
+    ensure!(client.snapshot().await? == before, "exact-net chain changed");
+    Ok(preview)
+}
+
+fn exact_net_params(request: &ExactNetRequest) -> Result<Value> {
+    let source = &request.source;
+    let reserve = source.locked.atoms().checked_sub(request.principal.atoms())
+        .context("exact-net principal exceeds lock")?;
+    ensure!(request.principal.atoms() > 0 && source.maximum_fee.atoms() > 0
+        && reserve > source.maximum_fee.atoms() && (1..=4).contains(&source.priority),
+        "invalid exact-net principal or reserve");
+    ensure!(source.wallet.network() == source.destination.network()
+        && source.wallet.network() == request.reserve_return.network()
+        && source.wallet != source.destination && source.wallet != request.reserve_return
+        && source.destination != request.reserve_return, "invalid exact-net destinations");
+    Ok(json!({"destinations":[
+        {"address":source.destination.to_string(),"amount":request.principal.atoms()},
+        {"address":request.reserve_return.to_string(),"amount":reserve}],
+        "account_index":source.account,"priority":source.priority,"unlock_time":0,
+        "subtract_fee_from_outputs":[1],"do_not_relay":true,
+        "get_tx_key":false,"get_tx_hex":false,"get_tx_metadata":false}))
+}
+
+fn check_exact_net(response: &Value, request: &ExactNetRequest,
+    inputs: &BTreeSet<String>) -> Result<ExactNetPreview> {
+    let amounts = response["amounts_by_dest"]["amounts"].as_array()
+        .context("missing exact-net destinations")?;
+    ensure!(amounts.len() == 2 && amounts[0].as_u64() == Some(request.principal.atoms()),
+        "exact-net payout differs from principal");
+    let returned = amounts[1].as_u64().context("invalid exact-net reserve return")?;
+    ensure!(returned > 0 && request.principal.atoms().checked_add(returned)
+        == Some(number(response, "amount")?), "invalid exact-net destination total");
+    // Reuse full-lock input, fee and artifact checks after validating the
+    // distinct output amounts. This copy contains no permitted signing data.
+    let mut accounting = response.clone();
+    accounting["amounts_by_dest"]["amounts"] = json!([number(response, "amount")?]);
+    let checked = check_response(&accounting, &request.source, inputs)?;
+    Ok(ExactNetPreview { recipient: request.principal,
+        reserve_return: XmzAmount::from_atoms(returned), network_fee: checked.network_fee })
+}
+
