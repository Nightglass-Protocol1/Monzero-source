+        for amounts in [json!([89,11]),json!([90,9]),json!([90,0]),json!([100]),json!([90,9,1])] {
+            let mut changed = value.clone(); changed["amounts_by_dest"]["amounts"] = amounts;
+            assert!(check_exact_net(&changed,&request,&expected).is_err());
