+use super::*;
+use crate::litecoin_light::{vault::mnemonic::MnemonicMaterial,network::{BtcNetwork,BchNetwork,DogeNetwork},
+    session::tests::{reply,server}};
+use std::{fs,path::PathBuf,os::unix::fs::PermissionsExt};
+use uuid::Uuid;
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().join(format!("recovery-backup-{}",Uuid::new_v4()));
+    fs::create_dir(&path)?;fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))}}
+impl Drop for Directory {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
+const PASSWORD:&[u8]=b"disposable recovery coordination password";
+async fn scan(network:LightNetwork,account:&PublicAccount)->Result<(HeaderSequence,WalletObservation)> {
+    let mut responses=vec![reply(1,json!(["fixture","1.4"])),reply(2,json!({"genesis_hash":network.genesis(),
+        "hash_function":"sha256","server_version":"fixture","protocol_min":"1.4","protocol_max":"1.4.3","hosts":{}}))];
+    for id in 3..10 {responses.push(reply(id,json!([])));}
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,network).await?;
+    let chain=HeaderSequence::new(network)?;
+    let observation=session.refresh_wallet(&chain,account,[2,1],
+        &RefreshLimits {gap:2,addresses_per_branch:10,history_entries_per_branch:10}).await?;
+    drop(session);task.await?;Ok((chain,observation))
+}
+#[tokio::test]
+async fn authenticated_recovery_coordinates_interrupted_allocations_and_backup_on_four_chains()->Result<()> {
+    let cases=[(LightNetwork::Litecoin(LtcNetwork::Regtest),Stage::Context),
+        (LightNetwork::Bitcoin(BtcNetwork::Regtest),Stage::Allocations),
+        (LightNetwork::BitcoinCash(BchNetwork::Regtest),Stage::Backup),
+        (LightNetwork::Dogecoin(DogeNetwork::Regtest),Stage::Complete)];
+    for (network,stop) in cases {
+        let source=Directory::new()?;let addresses=Directory::new()?;let journal=Directory::new()?;
+        let destination=Directory::new()?;let initial=Directory::new()?;
+        let material=MnemonicMaterial::from_entropy(&[42;32])?;let wallet=Uuid::new_v4();
+        let account=||material.public_account(network,1,"optional recovery passphrase");
+        let vault=MnemonicVault::create(&source.0,network,wallet,PASSWORD,&material,"optional recovery passphrase")?;
+        let mut book=AddressBook::create(&addresses.0,account()?)?;
+        let request=Uuid::new_v4();let first=book.reserve(request,Branch::Receive)?.address().to_string();
+        let original=backup::export(&vault,&book,PASSWORD)?;
+        backup::save_verified(&initial.0,&original,PASSWORD,network,wallet)?;
+        let (chain,observation)=scan(network,&account()?).await?;
+        let coverage=observation.review_recovery_coverage(&chain,&book,[2,1])?;
+        let approval=Approval {coverage:coverage.commitment(),configuration:sha256::Hash::hash(b"reviewed pending config")};
+        let destinations=Destinations {journal:&journal.0,backup:&destination.0};
+        let before=fs::read(addresses.0.join("litecoin-address-book.json"))?;
+        assert!(coverage.retain_mnemonic_recovery(&destinations,&chain,&mut book,&vault,b"wrong",&approval).is_err());
+        assert_eq!(fs::read_dir(&journal.0)?.count(),0);assert_eq!(fs::read_dir(&destination.0)?.count(),0);
+        assert_eq!(fs::read(addresses.0.join("litecoin-address-book.json"))?,before);
+        assert!(coverage.retain_mnemonic_recovery(&Destinations {journal:&journal.0,backup:&initial.0},
+            &chain,&mut book,&vault,PASSWORD,&approval).is_err());
+        assert_eq!(fs::read_dir(&journal.0)?.count(),0);
+        let result=coordinate(Some(&coverage),&destinations,&chain,&mut book,&vault,PASSWORD,&approval,
+            |stage|{ensure!(stage!=stop,"injected recovery interruption");Ok(())});
+        assert!(result.is_err());
+        if stop==Stage::Context {assert_eq!(fs::read(addresses.0.join("litecoin-address-book.json"))?,before);}
+        let saved_backup=fs::read(destination.0.join("litecoin-wallet.backup")).ok();
+        drop(book);drop(vault);drop(coverage);drop(observation);
+        let vault=MnemonicVault::open(&source.0,network,wallet)?;
+        let mut book=AddressBook::open(&addresses.0,account()?)?;
+        let other=Directory::new()?;
+        assert!(resume_mnemonic_recovery(&Destinations {journal:&journal.0,backup:&other.0},
+            &chain,&mut book,&vault,PASSWORD,&approval).is_err());
+        let receipt=if stop==Stage::Context {
+            // No allocation intent was published yet; a new observation must
+            // reproduce the separately approved coverage before continuation.
+            assert!(resume_mnemonic_recovery(&destinations,&chain,&mut book,&vault,PASSWORD,&approval).is_err());
+            let (chain,observed)=scan(network,&account()?).await?;
+            let coverage=observed.review_recovery_coverage(&chain,&book,[2,1])?;
+            coverage.retain_mnemonic_recovery(&destinations,&chain,&mut book,&vault,PASSWORD,&approval)?
+        } else {resume_mnemonic_recovery(&destinations,&chain,&mut book,&vault,PASSWORD,&approval)?};
+        assert_eq!(receipt["backupVerified"],true);assert_eq!(receipt["activated"],false);
+        assert_eq!(receipt["allocated"],json!([4,3]));
+        assert_eq!(book.reserved(request,Branch::Receive)?.unwrap().address().to_string(),first);
+        let recovered=fs::read(destination.0.join("litecoin-wallet.backup"))?;
+        if let Some(saved)=saved_backup {assert_eq!(recovered,saved);}
+        assert_eq!(fs::read(initial.0.join("litecoin-wallet.backup"))?,original);
+        assert_eq!(backup::verify_current(&recovered,&vault,&book,PASSWORD)?.digest().to_string(),receipt["backupDigest"]);
+        assert_eq!(resume_mnemonic_recovery(&destinations,&chain,&mut book,&vault,PASSWORD,&approval)?,receipt);
+        // Historical completion cannot bypass authentication or backup integrity.
+        assert!(resume_mnemonic_recovery(&destinations,&chain,&mut book,&vault,b"wrong",&approval).is_err());
+        let mut damaged=recovered.clone();let end=damaged.len()-1;damaged[end]^=1;
+        fs::write(destination.0.join("litecoin-wallet.backup"),&damaged)?;
+        assert!(resume_mnemonic_recovery(&destinations,&chain,&mut book,&vault,PASSWORD,&approval).is_err());
+        assert_eq!(fs::read(destination.0.join("litecoin-wallet.backup"))?,damaged);
+        // Completion records and local context never contain recovery material.
+        for entry in fs::read_dir(&journal.0)? {
+            let bytes=fs::read(entry?.path())?;let public=String::from_utf8(bytes)?;
+            assert!(!public.contains(&*material.reveal()));assert!(!public.contains("optional recovery passphrase"));
+            assert!(!public.contains(std::str::from_utf8(PASSWORD)?));
+        }
+    }
+    Ok(())
+}
