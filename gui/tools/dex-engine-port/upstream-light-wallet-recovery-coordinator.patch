+    /// Bind a recovery intent to the exact retained encrypted vault record.
+    /// This is a public ciphertext digest, never key material or authentication.
+    pub fn record_commitment(&self)->Result<bitcoin::hashes::sha256::Hash> {
+        use bitcoin::hashes::Hash;
+        ensure!(self.journal.read(RECORD)?==self.bytes,"mnemonic vault changed; reopen required");
+        Ok(bitcoin::hashes::sha256::Hash::hash(&self.bytes))
     }
 
     pub fn unlock(&self,password:&[u8])->Result<UnlockedMnemonic> {
