+//! Password-authenticated recovery coordination; activation remains separate.
+use super::*;
+use crate::litecoin_light::vault::mnemonic::storage::{MnemonicVault,backup};
+const CONTEXT:&str="light-recovery-backup-context.json";
+const COMPLETE:&str="light-recovery-backup-complete.json";
+/// Existing, canonical, private directories. The backup destination must be
+/// separate from the initial wallet backup and is fixed for this operation.
+pub struct Destinations<'a> {pub journal:&'a Path,pub backup:&'a Path}
+/// Both hashes come from the caller's separately approved review, not journal
+/// contents. Configuration must include the selected account and local paths.
+pub struct Approval {pub coverage:sha256::Hash,pub configuration:sha256::Hash}
+
+impl RecoveryCoverage {
+    /// Authenticate before publishing recovery state or changing allocations;
+    /// then retain allocations, verify an exact encrypted backup and receipt.
+    pub fn retain_mnemonic_recovery(&self,destinations:&Destinations<'_>,chain:&HeaderSequence,
+        book:&mut AddressBook,vault:&MnemonicVault,password:&[u8],approval:&Approval)->Result<Value> {
+        coordinate(Some(self),destinations,chain,book,vault,password,approval,|_|Ok(()))
+    }
+}
+/// Reverify password, exact vault, address records and backup on every retry.
+/// A saved completion file alone is never fresh backup verification.
+pub fn resume_mnemonic_recovery(destinations:&Destinations<'_>,chain:&HeaderSequence,
+    book:&mut AddressBook,vault:&MnemonicVault,password:&[u8],approval:&Approval)->Result<Value> {
+    coordinate(None,destinations,chain,book,vault,password,approval,|_|Ok(()))
+}
+#[derive(Clone,Copy,PartialEq)]
+enum Stage {Context,Allocations,Backup,Complete}
+fn coordinate(coverage:Option<&RecoveryCoverage>,destinations:&Destinations<'_>,chain:&HeaderSequence,
+    book:&mut AddressBook,vault:&MnemonicVault,password:&[u8],approval:&Approval,
+    checkpoint:impl Fn(Stage)->Result<()>)->Result<Value> {
+    if let Some(coverage)=coverage {
+        ensure!(coverage.commitment()==approval.coverage,"recovery coverage differs from approval");
+    }
+    let (descriptor,_)=book.backup_parts()?;
+    drop(vault.unlock_for_account(password,&descriptor)?);
+    let vault_digest=vault.record_commitment()?;
+    ensure!(destinations.journal!=destinations.backup,"recovery directories must differ");
+    let journal=Journal::open(destinations.journal)?;
+    // Opening validates canonical ownership, privacy and exclusive access before
+    // publishing any context. Do not keep this lease across the backup writer.
+    let backup_journal=Journal::open(destinations.backup)?;
+    let context=serde_json::to_vec(&json!({"schema":"monzero-light-recovery-backup-context-v1",
+        "coverageCommitment":approval.coverage,"configurationDigest":approval.configuration,
+        "vaultDigest":vault_digest,"account":descriptor,"backupDirectory":destinations.backup}))?;
+    match journal.read(CONTEXT) {
+        Ok(existing)=>ensure!(existing==context,"recovery backup context changed"),
+        Err(error) if error.downcast_ref::<std::io::Error>()
+            .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{
+            ensure!(coverage.is_some(),"missing recovery backup context; begin recovery first");
+            // A fresh operation cannot adopt an old or unrelated backup. This
+            // rejects the initial backup directory before addresses are changed.
+            match backup_journal.read("litecoin-wallet.backup") {
+                Err(error) if error.downcast_ref::<std::io::Error>()
+                    .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{},
+                Err(error)=>return Err(error),
+                Ok(_)=>anyhow::bail!("recovery backup destination already contains a backup"),
+            }
+            match journal.read(COMPLETE) {
+                Err(error) if error.downcast_ref::<std::io::Error>()
+                    .is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>{},
+                Err(error)=>return Err(error),
+                Ok(_)=>anyhow::bail!("recovery completion has no matching context"),
+            }
+        },
+        Err(error)=>return Err(error),
+    }
+    drop(backup_journal);
+    journal.retain(CONTEXT,&context)?;checkpoint(Stage::Context)?;
+    let allocation=if let Some(coverage)=coverage {
+        coverage.retain_with_journal(&journal,chain,book,approval.coverage,approval.configuration)?
+    } else {super::resume(&journal,chain,book,approval.coverage,approval.configuration)?};
+    checkpoint(Stage::Allocations)?;
+    let backup=backup::retain_current(destinations.backup,vault,book,password)?;
+    checkpoint(Stage::Backup)?;
+    let (_,record)=book.backup_parts()?;
+    let allocation_digest=sha256::Hash::hash(&record);
+    ensure!(allocation["allocationDigest"]==serde_json::to_value(allocation_digest)?
+        && vault.record_commitment()?==vault_digest,"recovered wallet changed before completion");
+    let receipt=serde_json::to_vec(&json!({"schema":"monzero-light-recovery-backup-complete-v1",
+        "configurationDigest":approval.configuration,"coverageCommitment":approval.coverage,
+        "contextDigest":sha256::Hash::hash(&context),"vaultDigest":vault_digest,
+        "allocationDigest":allocation_digest,"backupDigest":backup.digest(),
+        "backupDirectory":destinations.backup,"walletId":backup.wallet_id(),
+        "allocated":backup.allocated(),"allocationsRetained":true,"backupVerified":true,
+        "activated":false,"historyCompleteness":"unproven","activeSwapRecovery":false}))?;
+    journal.retain(COMPLETE,&receipt)?;
+    ensure!(journal.read(COMPLETE)?==receipt,"recovery backup completion read-back mismatch");
+    checkpoint(Stage::Complete)?;
+    Ok(serde_json::from_slice(&receipt)?)
+}
