+//! Separate approval for advisory wallet locking of the exact saved candidate.
+//! Saved intent is historical; it never asserts that wallet locks still exist.
+use super::*;
+use crate::bch_rpc::FundingInputsObservation;
+
+const REVIEW: &str="monzero-bch-wallet-lock-review-v1";
+pub struct WalletLockReview {pub details: serde_json::Value,pub commitment: [u8;32]}
+pub struct SavedWalletLockIntent {pub commitment: [u8;32],pub recorded_at: u64}
+impl AdmittedExecution<'_> {
+    /// Offline, current-quote review. Approval applies only to the exact retained
+    /// candidate and configured wallet policy, not signing or broadcasting.
+    pub fn review_bch_wallet_lock(&self,deployment: &[u8;32],policy: &WalletPreparationPolicy,
+        now: u64) -> Result<WalletLockReview> {
+        self.quote.check_policy(self.policy,now)?;
+        let candidate=self.wallet_preparation_candidate()?.context("BCH wallet candidate is absent")?;
+        ensure!(now>=candidate.prepared_at,"BCH lock review predates preparation");
+        let preparation=self.saved_bch_wallet_preparation_review(deployment,policy)?;
+        let details=serde_json::json!({"schema":REVIEW,"action":"lock-retained-wallet-inputs",
+            "preparationReview":preparation.details,"preparationReviewCommitment":hex(&preparation.commitment)});
+        Ok(WalletLockReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+
+    /// This reports a validated historical intent, including after expiry.
+    /// Missing intent does not prove that the wallet has no advisory locks.
+    pub fn saved_bch_wallet_lock_intent(&self,deployment: &[u8;32],policy: &WalletPreparationPolicy)
+        -> Result<Option<SavedWalletLockIntent>> {
+        self.saved_bch_wallet_preparation_review(deployment,policy)?;
+        if optional(&self.metadata,&record_name(self.quote,"wallet-lock-intent"))?.is_none() {return Ok(None)}
+        let prepared=self.prepared_bch_funding()?.context("BCH preparation is absent")?;
+        let (intent,commitment)=self.funding_lock_intent(&prepared)?;
+        ensure!(&intent.deployment==deployment && intent.change_address==policy.change_address
+            && intent.minimum_confirmations==policy.minimum_confirmations,"saved BCH lock policy changed");
+        Ok(Some(SavedWalletLockIntent {commitment,recorded_at:intent.admitted_at}))
+    }
+
+    /// Explicit approval or reconciliation of original inputs only. Existing
+    /// wallet intent is retained before mutation; no unlock or reselection.
+    pub async fn lock_bch_wallet_preparation(&mut self,backend: &BchRpc,policy: &WalletPreparationPolicy,
+        approved: &[u8;32],now: u64) -> Result<FundingInputsObservation> {
+        let review=self.review_bch_wallet_lock(&backend.deployment_commitment()?,policy,now)?;
+        ensure!(&review.commitment==approved,"BCH wallet lock approval differs from exact preparation");
+        self.lock_bch_funding_inputs(backend,now,&policy.change_address,policy.minimum_confirmations).await
+    }
+}
