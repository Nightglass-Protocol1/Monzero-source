+    let intent=execution.saved_bch_wallet_lock_intent(&deployment,&policy)?.context("missing approved wallet lock intent")?;
+    assert_eq!(intent.recorded_at,now+1);assert_eq!(server.state.lock().unwrap().calls,1);
+    let records=contents(&metadata.0)?;
+    // A node restart can remove advisory locks without changing historical intent.
+    server.state.lock().unwrap().locked=false;
+    assert_eq!(execution.saved_bch_wallet_lock_intent(&deployment,&policy)?.unwrap().commitment,intent.commitment);
+    assert!(!server.state.lock().unwrap().locked);
