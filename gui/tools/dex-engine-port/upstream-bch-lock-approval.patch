+    assert_eq!(contents(&metadata.0)?,records);assert_eq!(contents(&snapshots.0)?,secrets);
+    {let state=server.state.lock().unwrap();assert_eq!(state.calls,2);assert!(state.locked);
+        assert_eq!(state.preparation_calls,1);assert_eq!(state.sign_calls,0);assert_eq!(state.relay_calls,0);}
