+//! Wallet-selected, independently validated unsigned funding. No locking,
+//! signing, journal retention or relay. The caller must retain the candidate
+//! through the admitted-execution controller before subsequent operations.
+use super::*;
+use bitcoin::{absolute,consensus::deserialize,transaction::Version,Amount,Script,Sequence,Transaction};
+use bitcoin::hex::FromHex;
+use swap_core::bch::covenant::{Covenant,supported_destination};
+
+pub struct FundingPreparationRequest<'a> {
+    pub covenant: &'a Covenant,
+    pub principal: u64,
+    pub change_address: &'a str,
+    pub change_script: &'a Script,
+    pub fee_rate_atoms_per_kb: u64,
+    pub maximum_fee: u64,
+    pub minimum_change: u64,
+    pub minimum_confirmations: u64,
+}
+pub struct WalletFundingCandidate {
+    unsigned: Vec<u8>, sources: Vec<Vec<u8>>, preview: FundingPreview,
+    observation: FundingInputsObservation,
+}
+impl WalletFundingCandidate {
+    pub fn unsigned(&self) -> &[u8] { &self.unsigned }
+    pub fn sources(&self) -> &[Vec<u8>] { &self.sources }
+    pub fn preview(&self) -> &FundingPreview { &self.preview }
+    pub fn observation(&self) -> &FundingInputsObservation { &self.observation }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Funded { hex: String, fee: Box<RawValue>, changepos: i32 }
+#[derive(Deserialize)]
+struct Parent { hex: String }
+
+// Rust Bitcoin intentionally uses witness framing for empty inputs. BCHN
+// requires the legacy template: version, zero inputs, outputs, lock time.
+fn template(covenant: &Covenant,principal: u64) -> Vec<u8> {
+    let mut bytes=2i32.to_le_bytes().to_vec();bytes.push(0);
+    bytes.extend(serialize(&vec![TxOut {value:Amount::from_sat(principal),script_pubkey:covenant.script_pubkey()}]));
+    bytes.extend(0u32.to_le_bytes());bytes
+}
+fn hex(bytes: &[u8]) -> String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+
+impl BchRpc {
+    pub async fn prepare_funding(&self,request: FundingPreparationRequest<'_>) -> Result<WalletFundingCandidate> {
+        const MAX_MONEY: u64=2_100_000_000_000_000;
+        ensure!([request.principal,request.maximum_fee,request.minimum_change,request.fee_rate_atoms_per_kb]
+            .iter().all(|v|*v>0 && *v<=MAX_MONEY) && request.minimum_confirmations>0,
+            "invalid BCH preparation policy");
+        ensure!(supported_destination(request.change_script)
+            && request.change_script!=request.covenant.script_pubkey().as_script(),"invalid BCH change script");
+        let tip=self.chain().await?;self.wallet_ready().await?;
+        self.owned_address(request.change_address,request.change_script).await?;
+        let fee_rate=format!("{}.{:08}",request.fee_rate_atoms_per_kb/100_000_000,request.fee_rate_atoms_per_kb%100_000_000);
+        let reply=self.rpc(true,"fundrawtransaction",json!([hex(&template(request.covenant,request.principal)),{
+            "changeAddress":request.change_address,"changePosition":1,"includeWatching":false,
+            "include_unsafe":false,"lockUnspents":false,"subtractFeeFromOutputs":[],"feeRate":fee_rate}])).await?;
+        let funded: Funded=serde_json::from_str(reply.get())?;
+        let fee=atoms(funded.fee.get())?;
+        ensure!(fee>0 && fee<=request.maximum_fee,"BCH wallet preparation fee exceeds policy");
+        let bytes=Vec::<u8>::from_hex(&funded.hex)?;
+        let mut transaction: Transaction=deserialize(&bytes)?;
+        ensure!(serialize(&transaction)==bytes && transaction.version==Version::TWO
+            && transaction.lock_time==absolute::LockTime::ZERO && !transaction.input.is_empty()
+            && transaction.input.len()<=128,"invalid BCH wallet preparation transaction");
+        ensure!((transaction.output.len()==1 && funded.changepos == -1)
+            || (transaction.output.len()==2 && funded.changepos==1),"unexpected BCH wallet change position");
+        for input in &mut transaction.input {
+            ensure!(input.script_sig.is_empty() && input.witness.is_empty()
+                && matches!(input.sequence.0,0xffff_ffff|0xffff_fffe),"unexpected BCH unsigned input");
+            // The pinned BCHN wallet selects MAX-1 for its own anti-fee-sniping
+            // header. Our original zero lock time stays unchanged; finalize only
+            // this unsigned sequence before preview, retention and any signature.
+            input.sequence=Sequence::MAX;
+        }
+        let unsigned=serialize(&transaction);
+        let mut sources=Vec::new();let mut total=0usize;
+        for input in &transaction.input {
+            let reply=self.rpc(true,"gettransaction",json!([input.previous_output.txid.to_string(),false])).await?;
+            let parent: Parent=serde_json::from_str(reply.get())?;
+            let bytes=Vec::<u8>::from_hex(&parent.hex)?;
+            total=total.checked_add(bytes.len()).context("BCH parent bundle overflow")?;
+            ensure!(total<=8_000_000,"BCH parent bundle exceeds preparation limit");
+            sources.push(bytes);
+        }
+        let refs: Vec<&[u8]>=sources.iter().map(Vec::as_slice).collect();
+        let preview=FundingPreview::verify(&unsigned,&refs,request.covenant,request.principal,
+            request.change_script,request.maximum_fee,request.minimum_change)?;
+        ensure!(preview.lock_vout()==0 && preview.fee().to_sat()==fee
+            && preview.previous_outputs().iter().all(|o|o.script_pubkey.is_p2pkh()),
+            "BCH wallet preparation differs from supported funding or reported fee");
+        let observation=self.observe_funding_inputs(&preview,request.change_address,request.minimum_confirmations).await?;
+        ensure!(observation.tip()==tip,"BCH tip changed during wallet preparation");
+        Ok(WalletFundingCandidate {unsigned,sources,preview,observation})
+    }
+}
