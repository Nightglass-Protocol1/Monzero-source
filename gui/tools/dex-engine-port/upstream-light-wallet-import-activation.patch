new file mode 100644
--- /dev/null
+++ b/swap-machine/src/bin/native-ltc-light/import_activation.rs
@@ -0,0 +1,31 @@
+// Explicit activation, authenticated against the pending wallet and reviewed
+// recovery receipt. The active configuration is separate; no live market opens.
+use super::*;
+use swap_machine::litecoin_light::{vault::setup::configuration::activation::{activate,ActivationApproval},
+    session::wallet::recovery::retention::mnemonic::Destinations};
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct ActivationRequest {schema:String,request_id:uuid::Uuid,approved_config_digest:String,
+    approved_coverage:String,approved_recovery_digest:String,activation_approved:bool,
+    journal_directory:PathBuf,backup_directory:PathBuf,password:Password}
+pub(super) fn run(path:&Path)->Result<()> {
+    let mut input=Zeroizing::new(Vec::with_capacity(8193));std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid wallet activation request size");
+    let request:ActivationRequest=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-wallet-import-activate-request-v1"))
+        .context("invalid import activation schema")?;
+    ensure!(!request.request_id.is_nil() && request.activation_approved,"missing wallet activation approval");
+    let (_lease,config,configuration)=discovery::pending_config(path,tag,&request.approved_config_digest)?;
+    let setup=path.parent().context("missing wallet configuration parent")?;
+    ensure!(path.file_name()==Some(std::ffi::OsStr::new("litecoin-wallet.json")),"unexpected pending configuration name");
+    let coverage:sha256::Hash=request.approved_coverage.parse()?;
+    let recovery:sha256::Hash=request.approved_recovery_digest.parse()?;
+    ensure!(coverage.to_string()==request.approved_coverage && recovery.to_string()==request.approved_recovery_digest,
+        "noncanonical activation commitments");
+    let receipt=activate(setup,network_for(tag,&config.network)?,
+        &Destinations {journal:&request.journal_directory,backup:&request.backup_directory},request.password.0.as_bytes(),
+        &ActivationApproval {configuration,coverage,recovery,approved:true},now()?)?;
+    output(&json!({"schema":format!("monzero-{tag}-light-wallet-import-activate-response-v1"),
+        "requestId":request.request_id,"activation":receipt,"tradingEnabled":false}))
+}
