 impl State3 {
+    /// Compare restored economic state with authenticated historical terms.
+    /// No expiry gate: this does not authorize new funding or replace chain,
+    /// checkpoint integrity, transcript and ownership validation.
+    pub fn check_recorded_quote(&self, quote: &crate::native_trade_quote::RecordedQuote) -> Result<()> {
+        let number = |field: &str| -> Result<u64> { Ok(quote.terms()[field].parse()?) };
+        anyhow::ensure!(self.tx_lock.lock_amount().to_sat() == number("btcSatoshis")?
+            && self.xmr.as_pico() == number("xmzAtoms")?, "negotiated principal differs from quote");
+        anyhow::ensure!(self.refund_address == quote.destinations().btc_refund
+            && self.redeem_address == quote.destinations().btc_payout,
+            "negotiated destination differs from quote");
+        anyhow::ensure!(u64::from(u32::from(self.cancel_timelock)) == number("cancelBlocks")?
+            && u64::from(u32::from(self.punish_timelock)) == number("punishBlocks")?
+            && self.min_monero_confirmations == number("xmzConfirmations")?,
+            "negotiated timing differs from quote");
+        anyhow::ensure!(self.btc_amnesty_amount == Some(bitcoin::Amount::ZERO)
+            && matches!(self.refund_signatures, RefundSignatures::Legacy { .. }),
+            "unsupported native refund profile");
+        let lock = u128::from(self.tx_lock.fee()?.to_sat());
+        let cancel = u128::from(self.tx_cancel_fee.to_sat());
+        let refund = u128::from(self.tx_refund_fee.to_sat());
+        let redeem = u128::from(self.tx_redeem_fee.to_sat());
+        let punish = u128::from(self.tx_punish_fee.to_sat());
+        let cap = u128::from(number("btcNativeFeeMaxSatoshis")?);
+        let principal = u128::from(self.tx_lock.lock_amount().to_sat());
+        // Bound each complete mutually exclusive path, not each fee in isolation.
+        // Early refund (lock + refund) is bounded by the cancel/refund path too.
+        for path in [redeem, cancel + refund, cancel + punish] {
+            anyhow::ensure!(path < principal && lock + path <= cap,
+                "negotiated Bitcoin path exceeds quote fee budget");
+        }
+        Ok(())
+    }
