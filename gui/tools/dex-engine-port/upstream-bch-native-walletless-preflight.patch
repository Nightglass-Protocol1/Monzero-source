+use super::*;
+use crate::bch_rpc::{observer::OwnedBchObserver,observation::FundingStatus};
+fn hashes(path:&std::path::Path)->Result<std::collections::BTreeMap<std::ffi::OsString,bitcoin::hashes::sha256::Hash>> {
+    let mut result=std::collections::BTreeMap::new();
+    for entry in std::fs::read_dir(path)? {
+        let entry=entry?;ensure!(entry.file_type()?.is_file(),"unexpected non-file journal entry");
+        result.insert(entry.file_name(),bitcoin::hashes::sha256::Hash::hash(&std::fs::read(entry.path())?));
+    }
+    Ok(result)
+}
+pub(super) async fn exercise(sender:&AdmittedExecution<'_>,native:&AdmittedExecution<'_>,setup:&Setup,
+    metadata:&PrivateStore,snapshots:&PrivateStore,rpc:&BchRpc,server:&Server,txid:Txid)->Result<()> {
+    let observer=OwnedBchObserver::new(server.port,"user".into(),"pass".into(),rpc.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+    let public=hashes(&metadata.0)?;let private=hashes(&snapshots.0)?;
+    let deployment=observer.deployment_commitment()?;
+    let seen=native.observe_received_light_bch_funding(&observer).await?;
+    assert_eq!(seen.for_deployment(&deployment)?.status(),FundingStatus::ConfirmedUnspent {confirmations:3});
+    assert!(seen.for_deployment(&rpc.deployment_commitment()?).is_err());
+    let checked=native.check_light_bch_lock_for_native_funding(&observer,1023,5).await?;
+    assert_eq!(checked.observation().for_deployment(&deployment)?.txid(),txid);
+    assert_eq!(checked.amount_atoms(),101_000);assert_eq!(checked.maximum_fee_atoms(),1000);
+    assert_eq!(checked.destination(),native.restore_agreement()?.owned().wallet().address());
+    assert!(sender.check_light_bch_lock_for_native_funding(&observer,1023,5).await.is_err());
+    assert!(sender.observe_received_light_bch_funding(&observer).await.is_err());
+    for at in [1021,2000] {assert!(native.check_light_bch_lock_for_native_funding(&observer,at,5).await.is_err());}
+    for margin in [0,u32::from(setup.policy.cancel_blocks),u32::MAX] {
+        assert!(native.check_light_bch_lock_for_native_funding(&observer,1023,margin).await.is_err());
+    }
+    let other=OwnedBchObserver::new(server.port,"user".into(),"pass".into(),crate::bch_rpc::BchNetwork::Mainnet,
+        "/Bitcoin Cash Node:29.0.0/".into())?;
+    assert!(native.observe_received_light_bch_funding(&other).await.is_err());
+    assert!(native.check_light_bch_lock_for_native_funding(&other,1023,5).await.is_err());
+    for mode in [1,2,3,11,21,22] {
+        {let mut state=server.state.lock().unwrap();state.observation_mode=mode;state.observation_chain_calls=0;}
+        assert!(native.check_light_bch_lock_for_native_funding(&observer,1023,5).await.is_err(),"unsafe walletless funding window {mode}");
+    }
+    server.state.lock().unwrap().observation_mode=0;
+    assert_eq!(hashes(&metadata.0)?,public);assert_eq!(hashes(&snapshots.0)?,private);Ok(())
+}
