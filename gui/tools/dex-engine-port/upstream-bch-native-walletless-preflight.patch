+//! Native payer's read-only BCH preflight through an authenticated owned node.
+//! No BCH wallet access, native wallet construction, consent or relay authority.
+use super::*;
+use crate::bch_rpc::{observer::OwnedBchObserver,observation::BoundFundingObservation};
+
+pub struct LightNativeFundingLockCheck {
+    observation:BoundFundingObservation,destination:XmzAddress,amount:u64,maximum_fee:u64,
+}
+impl LightNativeFundingLockCheck {
+    pub fn observation(&self)->&BoundFundingObservation {&self.observation}
+    pub fn destination(&self)->&XmzAddress {&self.destination}
+    pub fn amount_atoms(&self)->u64 {self.amount}
+    pub fn maximum_fee_atoms(&self)->u64 {self.maximum_fee}
+}
+impl AdmittedExecution<'_> {
+    /// Historical authenticated funding observation. No quote renewal and no
+    /// inference that an unobserved transaction was never sent.
+    pub async fn observe_received_light_bch_funding(&self,observer:&OwnedBchObserver)->Result<BoundFundingObservation> {
+        ensure!(observer.network().quote_name()==self.quote.terms()["bchNetwork"]
+            && observer.network().genesis()==self.quote.terms()["bchGenesis"],"BCH peer funding observer has another network");
+        let message=self.received_bch_funding_message()?.context("missing authenticated BCH funding receipt")?;
+        observer.observe_funding(message.signed()).await
+    }
+    /// Fresh payment preflight only. The caller authenticates the owned process;
+    /// this is trusted local RPC, not public SPV consensus verification.
+    pub async fn check_light_bch_lock_for_native_funding(&self,observer:&OwnedBchObserver,now:u64,safety_blocks:u32)
+        ->Result<LightNativeFundingLockCheck> {
+        let (deadline,destination,amount,maximum_fee)=self.native_funding_lock_terms(now)?;
+        ensure!(safety_blocks>0 && u64::from(self.policy.bch_confirmations)+u64::from(safety_blocks)
+            < u64::from(self.policy.cancel_blocks),"invalid BCH native preparation safety margin");
+        let deployment=observer.deployment_commitment()?;
+        let observation=self.observe_received_light_bch_funding(observer).await?;
+        observation.for_deployment(&deployment)?.require_funding_window(u64::from(self.policy.bch_confirmations),
+            u32::from(self.policy.cancel_blocks),safety_blocks)?;
+        ensure!(std::time::Instant::now()<deadline,"BCH quote expired during native funding check");
+        Ok(LightNativeFundingLockCheck {observation,destination,amount,maximum_fee})
+    }
+}
