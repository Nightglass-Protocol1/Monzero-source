+//! Transparent native-SegWit Litecoin destinations. No Bitcoin address wrapper.
+//! Network parameters: litecoin-project/litecoin v0.21.5.8 src/chainparams.cpp.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{ScriptBuf, WitnessProgram, WitnessVersion};
+use bitcoin::bech32::{Hrp, segwit};
+use std::fmt;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum LtcNetwork { Mainnet, Testnet, Regtest }
+
+impl LtcNetwork {
+    pub fn name(self) -> &'static str {
+        match self { Self::Mainnet => "main", Self::Testnet => "test", Self::Regtest => "regtest" }
+    }
+
+    pub fn hrp(self) -> &'static str {
+        match self { Self::Mainnet => "ltc", Self::Testnet => "tltc", Self::Regtest => "rltc" }
+    }
+
+    pub fn genesis(self) -> &'static str {
+        match self {
+            Self::Mainnet => "12a765e31ffd4059bada1e25190f6e98c99d9714d334efa41a195a7e7e04bfe2",
+            Self::Testnet => "4966625a4b2851d9fdee139e56211a0d88575f59ed816ff5e6a63deb4e3e29a0",
+            Self::Regtest => "530827f38f93b43ed12af0b3ad25a288dc02ed74d6d7857862df51fc56c416f9",
+        }
+    }
+
+    /// Compare independently obtained node identity with the configured deployment.
+    /// This does not authenticate the node or attest its consensus validation.
+    pub fn verify_chain(self, chain: &str, genesis: &str) -> Result<()> {
+        ensure!(chain == self.name() && genesis == self.genesis(), "wrong Litecoin chain identity");
+        Ok(())
+    }
+}
+
+/// Supports P2WPKH, P2WSH and P2TR only. Legacy and MWEB addresses are rejected.
+/// Parsing does not establish wallet ownership, chain activation or fee policy.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct LtcSegwitAddress {
+    network: LtcNetwork,
+    encoded: String,
+    script: ScriptBuf,
+}
+
+impl LtcSegwitAddress {
+    pub fn parse(network: LtcNetwork, value: &str) -> Result<Self> {
+        ensure!(value.len() <= 90, "Litecoin address too long");
+        let (hrp, version, program) = segwit::decode(value).context("invalid Litecoin SegWit address")?;
+        ensure!(hrp == Hrp::parse(network.hrp())?, "wrong Litecoin address network");
+        let version = match version.to_u8() {
+            0 => WitnessVersion::V0,
+            1 if program.len() == 32 => WitnessVersion::V1,
+            _ => anyhow::bail!("unsupported Litecoin witness program"),
+        };
+        let script = ScriptBuf::new_witness_program(&WitnessProgram::new(version, &program)?);
+        let address = Self::from_script(network, &script)?;
+        ensure!(address.encoded == value, "noncanonical Litecoin address");
+        Ok(address)
+    }
+
+    pub fn from_script(network: LtcNetwork, script: &ScriptBuf) -> Result<Self> {
+        ensure!(script.is_p2wpkh() || script.is_p2wsh() || script.is_p2tr(),
+            "unsupported Litecoin destination script");
+        let hrp = Hrp::parse(network.hrp())?;
+        let program = &script.as_bytes()[2..];
+        let encoded = if script.is_p2tr() { segwit::encode_v1(hrp, program)? }
+            else { segwit::encode_v0(hrp, program)? };
+        Ok(Self { network, encoded, script: script.clone() })
+    }
+
+    pub fn network(&self) -> LtcNetwork { self.network }
+    pub fn script_pubkey(&self) -> &ScriptBuf { &self.script }
+}
+
+impl fmt::Display for LtcSegwitAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str(&self.encoded) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn binds_every_supported_script_to_each_network() {
+        let networks = [LtcNetwork::Mainnet, LtcNetwork::Testnet, LtcNetwork::Regtest];
+        for network in networks {
+            for (version, size) in [(WitnessVersion::V0, 20), (WitnessVersion::V0, 32), (WitnessVersion::V1, 32)] {
+                let script = ScriptBuf::new_witness_program(&WitnessProgram::new(version, &vec![42; size]).unwrap());
+                let address = LtcSegwitAddress::from_script(network, &script).unwrap();
+                assert_eq!(address.script_pubkey(), &script);
+                assert_eq!(address.network(), network);
+                assert_eq!(LtcSegwitAddress::parse(network, &address.to_string()).unwrap(), address);
+                for other in networks {
+                    assert_eq!(LtcSegwitAddress::parse(other, &address.to_string()).is_ok(), network == other);
+                    assert_eq!(network.verify_chain(other.name(), other.genesis()).is_ok(), network == other);
+                    if network != other {
+                        assert!(network.verify_chain(network.name(), other.genesis()).is_err());
+                        assert!(network.verify_chain(other.name(), network.genesis()).is_err());
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn rejects_bad_checksum_wrong_chain_noncanonical_and_unsupported_programs() {
+        let network = LtcNetwork::Regtest;
+        let hrp = Hrp::parse("rltc").unwrap();
+        let good = segwit::encode_v0(hrp, &[42; 20]).unwrap();
+        let mut bad = good.clone().into_bytes();
+        let last = bad.len()-1;
+        bad[last] = if bad[last] == b'q' { b'p' } else { b'q' };
+        for value in [String::from_utf8(bad).unwrap(), good.to_uppercase(), format!(" {good}"),
+            format!("{good}\n"), "x".repeat(91), segwit::encode_v0(Hrp::parse("bcrt").unwrap(), &[42;20]).unwrap(),
+            segwit::encode_v0(Hrp::parse("ltcmweb").unwrap(), &[42;20]).unwrap(),
+            segwit::encode(hrp, bitcoin::bech32::Fe32::try_from(2u8).unwrap(), &[42;32]).unwrap(),
+            segwit::encode_v1(hrp, &[42;20]).unwrap()] {
+            assert!(LtcSegwitAddress::parse(network, &value).is_err());
+        }
+        for script in [ScriptBuf::new(), ScriptBuf::from_hex("51").unwrap(),
+            ScriptBuf::from_hex("001401").unwrap()] {
+            assert!(LtcSegwitAddress::from_script(network, &script).is_err());
+        }
+        assert!(network.verify_chain("regtest", "000000000933ea01ad0ee984209779baaec3ced90fa3f408719526f8d77f4943").is_err());
+    }
+}
