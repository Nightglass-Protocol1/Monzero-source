+//! Public review of the exact private refund payout. No broadcast or chain grant.
+use super::*;
+use serde_json::json;
+
+const REVIEW: &str="monzero-bch-native-refund-payout-relay-review-v1";
+pub struct NativeRefundPayoutRelayReview {pub details: Value,pub commitment: [u8;32]}
+impl AdmittedExecution<'_> {
+    fn native_refund_payout_relay_materials(&self) -> Result<(NativeRefundPayoutRelayReview,PreparedLockPayout,Intent,[u8;32])> {
+        let (intent,bytes)=self.refund_payout_intent()?.context("missing BCH native refund payout intent")?;
+        let prepared=self.load_bch_native_refund_payout()?;
+        let binding=hash(INTENT,&bytes);
+        let checkpoint: [u8;32]=Sha256::digest(&*prepared.encode(binding)?).into();
+        let funding=self.received_bch_funding_message()?.context("missing authenticated BCH funding")?;
+        let (deployment,_)=self.native_bch_observation_policy()?;
+        let accounting=prepared.terms();
+        let amount=|field: &str| -> Result<u64> {
+            Ok(accounting[field].as_str().context("missing refund payout accounting amount")?.parse()?)
+        };
+        let refund_atoms=amount("lockedAtoms")?.checked_sub(amount("feeAtoms")?).context("refund payout fee exceeds lock")?;
+        let details=json!({"schema":REVIEW,"action":"broadcast-bch-native-refund-payout",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),"admission":intent.admission,
+            "nativePayment":intent.payment,"walletIntent":intent.wallet_intent,
+            "payoutIntent":binding,"privateCheckpoint":checkpoint,"preparedAt":intent.at,
+            "refund":intent.refund,"bchFundingOutpoint":funding.signed().lock_outpoint(),
+            "bchDeployment":deployment,"bchNetwork":self.quote.terms()["bchNetwork"],
+            "bchGenesis":self.quote.terms()["bchGenesis"],"xmzNetwork":self.quote.terms()["xmzNetwork"],
+            "minimumBchConfirmations":self.policy.bch_confirmations,
+            "minimumXmzConfirmations":self.policy.xmz_confirmations,
+            "refundAtoms":refund_atoms.to_string(),"payout":accounting});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((NativeRefundPayoutRelayReview {details,commitment},prepared,intent,deployment))
+    }
+    /// Historical review does not renew commercial terms or establish confirmation.
+    pub fn review_bch_native_refund_payout_relay(&self,bch: &BchRpc,now: u64) -> Result<NativeRefundPayoutRelayReview> {
+        let (review,_,intent,deployment)=self.native_refund_payout_relay_materials()?;
+        ensure!(now>=intent.at,"BCH native refund payout review predates preparation");
+        ensure!(bch.deployment_commitment()?==deployment,"BCH native refund payout observer changed");
+        Ok(review)
+    }
+}
