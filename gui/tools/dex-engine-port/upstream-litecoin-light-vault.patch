@@ -0,0 +1,64 @@
+use super::*;
+use std::{fs,os::unix::fs::PermissionsExt,path::PathBuf};
+fn hex(text:&str)->Vec<u8> {(0..text.len()).step_by(2).map(|i|u8::from_str_radix(&text[i..i+2],16).unwrap()).collect()}
+fn fixture()->(SecretSeed,Vec<u8>,Vec<u8>,Uuid) {
+    let value:serde_json::Value=serde_json::from_str(include_str!("fixture.json")).unwrap();
+    let mut seed=Zeroizing::new([0u8;32]);seed.copy_from_slice(&hex(value["seed"].as_str().unwrap()));
+    (SecretSeed::from_bytes(seed),hex(value["vault"].as_str().unwrap()),value["password"].as_str().unwrap().as_bytes().to_vec(),value["wallet"].as_str().unwrap().parse().unwrap())
+}
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {
+    let path=std::env::temp_dir().join(format!("monzero-seed-vault-{}",Uuid::new_v4()));fs::create_dir(&path)?;
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))
+}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+#[test]
+fn vault_matches_independent_scrypt_libsodium_vector()->Result<()> {
+    let (seed,expected,password,wallet)=fixture();
+    let bytes=seal(&seed,&password,LtcNetwork::Regtest,wallet,std::array::from_fn(|i|i as u8),std::array::from_fn(|i|i as u8))?;
+    assert_eq!(bytes,expected);let restored=unlock(&expected,&password,LtcNetwork::Regtest,wallet)?;
+    assert_eq!(*restored.0,*seed.0);
+    assert_eq!(serde_json::to_vec(&restored.public_account(LtcNetwork::Regtest,0)?.descriptor())?,
+        serde_json::to_vec(&seed.public_account(LtcNetwork::Regtest,0)?.descriptor())?);
+    Ok(())
+}
+#[test]
+fn vault_rejects_wrong_password_context_and_tampering()->Result<()> {
+    let (_,bytes,password,wallet)=fixture();
+    assert!(unlock(&bytes,b"wrong password",LtcNetwork::Regtest,wallet).is_err());
+    for index in [0,8,72,88,104,128,175] {
+        let mut changed=bytes.clone();changed[index]^=1;
+        assert!(unlock(&changed,&password,LtcNetwork::Regtest,wallet).is_err());
+    }
+    assert!(unlock(&bytes,&password,LtcNetwork::Testnet,wallet).is_err());
+    assert!(unlock(&bytes,&password,LtcNetwork::Regtest,Uuid::new_v4()).is_err());
+    assert!(unlock(&bytes,&password,LtcNetwork::Regtest,Uuid::nil()).is_err());
+    for length in [0,8,127,128,175] {assert!(unlock(&bytes[..length],&password,LtcNetwork::Regtest,wallet).is_err());}
+    let mut appended=bytes;appended.push(0);assert!(unlock(&appended,&password,LtcNetwork::Regtest,wallet).is_err());Ok(())
+}
+#[test]
+fn vault_persists_ciphertext_reopens_and_never_overwrites()->Result<()> {
+    let dir=Directory::new()?;let (seed,_,password,wallet)=fixture();
+    assert!(SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet).is_err());
+    let vault=SeedVault::create(&dir.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+    let bytes=fs::read(dir.0.join(NAME))?;assert_eq!(bytes.len(),LENGTH);
+    assert!(!bytes.windows(32).any(|part|part==&*seed.0));
+    assert!(SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet).is_err());
+    assert_eq!(*vault.unlock(&password)?.0,*seed.0);drop(vault);
+    assert!(SeedVault::create(&dir.0,LtcNetwork::Regtest,wallet,&password,&seed).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,bytes);
+    let vault=SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet)?;
+    assert_eq!(*vault.unlock(&password)?.0,*seed.0);
+    fs::write(dir.0.join(NAME),b"changed")?;assert!(vault.unlock(&password).is_err());drop(vault);
+    assert!(SeedVault::open(&dir.0,LtcNetwork::Regtest,wallet).is_err());Ok(())
+}
+#[test]
+fn vault_password_limits_and_randomized_encryption()->Result<()> {
+    let (seed,_,password,wallet)=fixture();
+    for invalid in [vec![],vec![1;1025]] {assert!(seal(&seed,&invalid,LtcNetwork::Regtest,wallet,[0;16],[0;24]).is_err());}
+    let a=Directory::new()?;let b=Directory::new()?;
+    let first=SeedVault::create(&a.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+    let second=SeedVault::create(&b.0,LtcNetwork::Regtest,wallet,&password,&seed)?;
+    assert_ne!(first.bytes,second.bytes);assert_eq!(*first.unlock(&password)?.0,*second.unlock(&password)?.0);
+    let generated=SecretSeed::generate()?;assert!(generated.public_account(LtcNetwork::Regtest,0).is_ok());Ok(())
+}
