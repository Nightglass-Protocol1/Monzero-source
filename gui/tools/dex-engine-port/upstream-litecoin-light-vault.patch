+//! Password-encrypted fixed-size Litecoin seed storage. No mnemonic/backup UI,
+//! password recovery, signing, or secure-memory guarantee. Dependency internals
+//! may copy secrets; owned seed, derived key and plaintext buffers are erased.
+use anyhow::{Context,Result,ensure};
+use bitcoin::{bip32::Xpriv,NetworkKind};
+use chacha20poly1305::{XChaCha20Poly1305,XNonce,aead::{AeadInPlace,KeyInit}};
+use rand::{RngCore,rngs::OsRng};
+use std::path::Path;
+use swap_core::litecoin_address::LtcNetwork;
+use uuid::Uuid;
+use zeroize::Zeroizing;
+use super::account::PublicAccount;
+use crate::litecoin_rpc::reservation::Journal;
+const NAME:&str="litecoin-seed.vault";
+const HEADER:usize=128;
+const LENGTH:usize=HEADER+32+16;
+const MAGIC:&[u8;8]=b"MZLTCV01";
+
+/// Deliberately neither Clone, Debug nor serializable.
+pub struct SecretSeed(Zeroizing<[u8;32]>);
+pub struct SeedVault {journal:Journal,network:LtcNetwork,wallet:Uuid,bytes:Vec<u8>}
+impl SecretSeed {
+    pub fn generate()->Result<Self> {
+        let mut bytes=Zeroizing::new([0u8;32]);OsRng.try_fill_bytes(&mut *bytes).context("seed entropy unavailable")?;
+        Ok(Self(bytes))
+    }
+    /// Restore caller-owned entropy. The caller is responsible for its source
+    /// and for erasing any other copies; never use public fixture seeds.
+    pub fn from_bytes(bytes:Zeroizing<[u8;32]>)->Self {Self(bytes)}
+    pub fn public_account(&self,network:LtcNetwork,index:u32)->Result<PublicAccount> {
+        let mut root=Xpriv::new_master(if network==LtcNetwork::Mainnet {NetworkKind::Main}else{NetworkKind::Test},&*self.0)?;
+        let account=PublicAccount::from_master(&root,network,index);
+        root.private_key.non_secure_erase();root.chain_code=[0u8;32].into();account
+    }
+}
+impl SeedVault {
+    /// Explicit creation; never replaces another vault. Retain caller seed for
+    /// the required backup ceremony, which is not implemented by this API.
+    pub fn create(directory:&Path,network:LtcNetwork,wallet:Uuid,password:&[u8],seed:&SecretSeed)->Result<Self> {
+        let journal=Journal::open(directory)?;
+        let mut salt=[0u8;16];let mut nonce=[0u8;24];
+        OsRng.try_fill_bytes(&mut salt).context("vault entropy unavailable")?;
+        OsRng.try_fill_bytes(&mut nonce).context("vault entropy unavailable")?;
+        let bytes=seal(seed,password,network,wallet,salt,nonce)?;
+        journal.retain(NAME,&bytes)?;
+        Ok(Self {journal,network,wallet,bytes})
+    }
+    /// Missing/invalid state is an error. Recover a potentially uncertain
+    /// publication by syncing the existing record before it can be unlocked.
+    pub fn open(directory:&Path,network:LtcNetwork,wallet:Uuid)->Result<Self> {
+        let journal=Journal::open(directory)?;let bytes=journal.read(NAME)?;
+        check(&bytes,network,wallet)?;journal.retain(NAME,&bytes)?;
+        Ok(Self {journal,network,wallet,bytes})
+    }
+    pub fn unlock(&self,password:&[u8])->Result<SecretSeed> {
+        ensure!(self.journal.read(NAME)?==self.bytes,"Litecoin seed vault changed outside its lease");
+        unlock(&self.bytes,password,self.network,self.wallet)
+    }
+}
+fn key(password:&[u8],salt:&[u8])->Result<Zeroizing<[u8;32]>> {
+    ensure!(!password.is_empty() && password.len()<=1024,"invalid vault password length");
+    // Fixed versioned cost: 128 MiB (N=2^17, r=8, p=1). Never accept KDF
+    // parameters from a file that could trigger unbounded work or a downgrade.
+    let params=scrypt::Params::new(17,8,1,32).map_err(|_|anyhow::anyhow!("invalid vault KDF"))?;
+    let mut result=Zeroizing::new([0u8;32]);
+    scrypt::scrypt(password,salt,&params,&mut *result).map_err(|_|anyhow::anyhow!("vault KDF failed"))?;Ok(result)
+}
+fn check(bytes:&[u8],network:LtcNetwork,wallet:Uuid)->Result<()> {
+    ensure!(!wallet.is_nil() && bytes.len()==LENGTH && &bytes[..8]==MAGIC
+        && &bytes[8..72]==network.genesis().as_bytes() && &bytes[72..88]==wallet.as_bytes(),
+        "invalid Litecoin seed vault context");Ok(())
+}
+fn seal(seed:&SecretSeed,password:&[u8],network:LtcNetwork,wallet:Uuid,salt:[u8;16],nonce:[u8;24])->Result<Vec<u8>> {
+    ensure!(!wallet.is_nil(),"missing Litecoin wallet identity");
+    let mut header=Vec::with_capacity(LENGTH);header.extend_from_slice(MAGIC);
+    header.extend_from_slice(network.genesis().as_bytes());header.extend_from_slice(wallet.as_bytes());
+    header.extend_from_slice(&salt);header.extend_from_slice(&nonce);ensure!(header.len()==HEADER,"invalid vault header");
+    let key=key(password,&salt)?;let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid vault key"))?;
+    let mut payload=Zeroizing::new(Vec::with_capacity(48));payload.extend_from_slice(&*seed.0);
+    cipher.encrypt_in_place(XNonce::from_slice(&nonce),&header,&mut *payload).map_err(|_|anyhow::anyhow!("vault encryption failed"))?;
+    header.extend_from_slice(&payload);Ok(header)
+}
+fn unlock(bytes:&[u8],password:&[u8],network:LtcNetwork,wallet:Uuid)->Result<SecretSeed> {
+    check(bytes,network,wallet)?;let key=key(password,&bytes[88..104])?;
+    let cipher=XChaCha20Poly1305::new_from_slice(&*key).map_err(|_|anyhow::anyhow!("invalid vault key"))?;
+    let mut payload=Zeroizing::new(bytes[HEADER..].to_vec());
+    cipher.decrypt_in_place(XNonce::from_slice(&bytes[104..128]),&bytes[..HEADER],&mut *payload)
+        .map_err(|_|anyhow::anyhow!("vault authentication failed"))?;
+    ensure!(payload.len()==32,"invalid vault seed length");
+    let mut seed=Zeroizing::new([0u8;32]);seed.copy_from_slice(&payload);Ok(SecretSeed(seed))
+}
