+//! BCH CHECKDATASIG ECDSA messages, distinct from Bitcoin transaction sighashes.
+//! Specification: https://upgradespecs.bitcoincashnode.org/op_checkdatasig/
+//!
+//! A verified signature alone binds no chain, amount, fee or trade identity.
+//! Covenant validation and authenticated per-trade keys must supply that context.
+//! This module neither constructs transactions nor authorizes settlement.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{hashes::{Hash, sha256}, secp256k1::ecdsa};
+use ecdsa_fun::{ECDSA, Signature, adaptor::{Adaptor, EncryptedSignature, HashTranscript},
+    fun::{Point, Scalar}, nonce::Deterministic};
+use sha2::Sha256;
+
+type DataAdaptor = Adaptor<HashTranscript<Sha256, rand_chacha::ChaCha20Rng>, Deterministic<Sha256>>;
+
+/// Single SHA-256 of the exact message consumed by CHECKDATASIG. No transaction
+/// sighash suffix, Bitcoin sighash preimage, or implicit double hashing is used.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DataMessage([u8; 32]);
+
+impl DataMessage {
+    pub fn new(message: &[u8]) -> Self {
+        Self(sha256::Hash::hash(message).to_byte_array())
+    }
+
+    pub fn encrypted_sign(&self, signing_key: &Scalar, encryption_key: &Point) -> EncryptedSignature {
+        DataAdaptor::default().encrypted_sign(signing_key, encryption_key, &self.0)
+    }
+
+    pub fn verify_encrypted(&self, signing_key: &Point, encryption_key: &Point,
+        encrypted: &EncryptedSignature) -> Result<()> {
+        ensure!(DataAdaptor::default().verify_encrypted_signature(signing_key, encryption_key,
+            &self.0, encrypted), "invalid BCH encrypted data signature");
+        Ok(())
+    }
+
+    pub fn verify_der(&self, signing_key: &Point, der: &[u8]) -> Result<()> {
+        let signature = parse_der(der)?;
+        ensure!(ECDSA::verify_only().verify(signing_key, &self.0, &signature),
+            "invalid BCH data signature");
+        Ok(())
+    }
+
+    /// Publishing the result reveals the decryption key to a holder of the
+    /// encrypted signature. Callers must enforce their protocol release gate.
+    pub fn decrypt(&self, signing_key: &Point, decryption_key: &Scalar,
+        encrypted: EncryptedSignature) -> Result<Vec<u8>> {
+        let encryption_key = ECDSA::verify_only().verification_key_for(decryption_key);
+        self.verify_encrypted(signing_key, &encryption_key, &encrypted)?;
+        let signature = DataAdaptor::default().decrypt_signature(decryption_key, encrypted);
+        let der = ecdsa::Signature::from_compact(&signature.to_bytes())?
+            .serialize_der().to_vec();
+        self.verify_der(signing_key, &der)?;
+        Ok(der)
+    }
+
+    pub fn recover(&self, signing_key: &Point, encryption_key: &Point,
+        encrypted: &EncryptedSignature, der: &[u8]) -> Result<Scalar> {
+        self.verify_encrypted(signing_key, encryption_key, encrypted)?;
+        self.verify_der(signing_key, der)?;
+        DataAdaptor::default().recover_decryption_key(encryption_key, &parse_der(der)?, encrypted)
+            .context("BCH data signature does not reveal the expected decryption key")
+    }
+}
+
+fn parse_der(der: &[u8]) -> Result<Signature> {
+    let signature = ecdsa::Signature::from_der(der).context("invalid BCH DER data signature")?;
+    ensure!(signature.serialize_der().as_ref() == der, "noncanonical BCH DER data signature");
+    let mut normalized = signature;
+    normalized.normalize_s();
+    ensure!(normalized == signature, "BCH data signature must have low S");
+    Signature::from_bytes(signature.serialize_compact()).context("invalid BCH ECDSA scalars")
+}
