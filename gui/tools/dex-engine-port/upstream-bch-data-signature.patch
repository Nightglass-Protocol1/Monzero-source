+use super::*;
+
+fn key() -> Scalar { Scalar::random(&mut rand::thread_rng()) }
+fn public(key: &Scalar) -> Point { ECDSA::verify_only().verification_key_for(key) }
+
+#[test]
+fn reference_signature_uses_exact_single_hash_message() -> Result<()> {
+    // Fixture provenance and MIT notice are retained alongside the vector.
+    let vector: serde_json::Value = serde_json::from_str(include_str!("reference-signature.json"))?;
+    let bytes = |name: &str| -> Result<Vec<u8>> {
+        Ok(hex::decode(vector[name].as_str().context("missing reference field")?)?)
+    };
+    let message = bytes("message")?;
+    let signer = Point::from_bytes(bytes("publicKey")?.try_into().unwrap()).unwrap();
+    let signature = bytes("signature")?;
+    let data = DataMessage::new(&message);
+    assert_eq!(hex::encode(data.0), vector["sha256"].as_str().unwrap());
+    data.verify_der(&signer, &signature)?;
+    assert!(DataMessage::new(&data.0).verify_der(&signer, &signature).is_err());
+    let mut changed = message; changed[0] ^= 1;
+    assert!(DataMessage::new(&changed).verify_der(&signer, &signature).is_err());
+    assert!(data.verify_der(&public(&key()), &signature).is_err());
+    assert!(data.verify_der(&signer, &bytes("highSSignature")?).is_err());
+    for length in 0..signature.len() {
+        assert!(data.verify_der(&signer, &signature[..length]).is_err());
+    }
+    let mut with_sighash = signature; with_sighash.push(1);
+    assert!(data.verify_der(&signer, &with_sighash).is_err());
+    Ok(())
+}
+
+#[test]
+fn adaptor_roundtrip_and_recovery_bind_message_and_both_keys() -> Result<()> {
+    let signing = key(); let decryption = key(); let other = key();
+    let signer = public(&signing); let encryption = public(&decryption);
+    let data = DataMessage::new(b"exact covenant destination bytes");
+    let changed = DataMessage::new(b"different covenant destination bytes");
+    let encrypted = data.encrypted_sign(&signing, &encryption);
+    data.verify_encrypted(&signer, &encryption, &encrypted)?;
+    assert!(changed.verify_encrypted(&signer, &encryption, &encrypted).is_err());
+    assert!(data.verify_encrypted(&public(&other), &encryption, &encrypted).is_err());
+    assert!(data.verify_encrypted(&signer, &public(&other), &encrypted).is_err());
+    assert!(data.decrypt(&signer, &other, encrypted.clone()).is_err());
+    assert!(changed.decrypt(&signer, &decryption, encrypted.clone()).is_err());
+    let der = data.decrypt(&signer, &decryption, encrypted.clone())?;
+    data.verify_der(&signer, &der)?;
+    assert_eq!(data.recover(&signer, &encryption, &encrypted, &der)?.to_bytes(), decryption.to_bytes());
+    assert!(changed.recover(&signer, &encryption, &encrypted, &der).is_err());
+    assert!(data.recover(&public(&other), &encryption, &encrypted, &der).is_err());
+    assert!(data.recover(&signer, &public(&other), &encrypted, &der).is_err());
+    // Verify independently through libsecp256k1, not just the adaptor library.
+    let secp = bitcoin::secp256k1::Secp256k1::verification_only();
+    secp.verify_ecdsa(&bitcoin::secp256k1::Message::from_digest(data.0),
+        &ecdsa::Signature::from_der(&der)?,
+        &bitcoin::secp256k1::PublicKey::from_slice(&signer.to_bytes())?)?;
+    Ok(())
+}
