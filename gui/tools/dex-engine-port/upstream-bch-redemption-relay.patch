+use super::*;
+use agreement::execution::funding::success::receipt::redemption::relay::RedemptionRelayState;
+
+pub(super) async fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    fixture: &Fixture,rpc: &BchRpc,server: &Server,transaction: &Transaction) -> Result<()> {
+    let original_intent = server.state.lock().unwrap().relay_intent.clone();
+    server.state.lock().unwrap().redemption = Some(transaction.clone());
+    let txid = transaction.compute_txid();let observer = fixture.funding_client()?;
+    for mode in [0,1,2] {
+        let metadata = copy_store(metadata)?;
+        let mut execution = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let intent = metadata.0.join(format!("{}.bch-redemption-relay-intent",setup.quote.terms()["swapId"]));
+        let ack = metadata.0.join(format!("{}.bch-redemption-relay-ack",setup.quote.terms()["swapId"]));
+        server.state.lock().unwrap().relay_intent = Some(intent.clone());
+        server.state.lock().unwrap().relay_mode = mode;
+        let before = server.state.lock().unwrap().redemption_relay_calls;
+        let review = execution.review_bch_redemption_relay(rpc,2038)?;
+        assert!(execution.bch_redemption_relay_state()?.is_none());
+        if mode==0 {
+            assert!(execution.relay_bch_redemption(&observer,rpc,&[0;32],2038).await.is_err());
+            assert!(execution.relay_bch_redemption(&observer,rpc,&review.commitment,2034).await.is_err());
+            fixture.confirmed.store(false,Ordering::SeqCst);
+            assert!(execution.relay_bch_redemption(&observer,rpc,&review.commitment,2038).await.is_err());
+            fixture.confirmed.store(true,Ordering::SeqCst);
+            for unsafe_mode in [1,3,21,22] {
+                server.state.lock().unwrap().observation_mode = unsafe_mode;
+                assert!(execution.relay_bch_redemption(&observer,rpc,&review.commitment,2038).await.is_err());
+                assert!(!intent.exists());
+            }
+            server.state.lock().unwrap().observation_mode = 0;
+            assert_eq!(server.state.lock().unwrap().redemption_relay_calls,before);
+        }
+        let result = execution.relay_bch_redemption(&observer,rpc,&review.commitment,2038).await;
+        assert!(intent.exists());
+        assert_eq!(server.state.lock().unwrap().redemption_relay_calls,before+1);
+        let expected = if mode==0 {
+            assert_eq!(result?,txid);assert!(ack.exists());RedemptionRelayState::Acknowledged {txid}
+        } else {assert!(result.is_err());assert!(!ack.exists());RedemptionRelayState::Attempted {txid}};
+        assert_eq!(execution.bch_redemption_relay_state()?,Some(expected));
+        drop(execution);
+        let mut restored = AdmittedExecution::resume(&metadata.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        assert_eq!(restored.bch_redemption_relay_state()?,Some(expected));
+        let again = restored.relay_bch_redemption(&observer,rpc,&review.commitment,2039).await;
+        if mode==0 {assert_eq!(again?,txid);} else {assert!(again.is_err());}
+        assert_eq!(server.state.lock().unwrap().redemption_relay_calls,before+1);
+        if mode==0 {
+            let saved = std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;
+            assert!(restored.bch_redemption_relay_state().is_err());
+            assert!(restored.relay_bch_redemption(&observer,rpc,&review.commitment,2039).await.is_err());
+            std::fs::write(&ack,saved)?;
+            let saved_intent = metadata.0.join("saved-redemption-intent");std::fs::rename(&intent,&saved_intent)?;
+            assert!(restored.bch_redemption_relay_state().is_err());
+            assert!(restored.relay_bch_redemption(&observer,rpc,&review.commitment,2039).await.is_err());
+            std::fs::rename(&saved_intent,&intent)?;
+        }
+        assert_eq!(server.state.lock().unwrap().redemption_relay_calls,before+1);
+    }
+    let mut state = server.state.lock().unwrap();
+    state.redemption = None;state.relay_intent = original_intent;state.relay_mode = 0;
+    Ok(())
+}
