+impl BchRpc {
+    /// Executor-only: exact authenticated redemption, explicit approval, fresh
+    /// both-chain observations and durable attempt must precede this call.
+    /// A timeout or invalid reply may follow publication; never retry implicitly.
+    pub(crate) async fn relay_redemption(&self,transaction: &bitcoin::Transaction,
+        deadline: std::time::Instant) -> Result<Txid> {
+        ensure!(std::time::Instant::now() < deadline,"BCH redemption observations expired before dispatch");
+        let raw = zeroize::Zeroizing::new(serialize(transaction).to_lower_hex_string());
+        let request = json!([raw.as_str(),false]);
+        let reply = tokio::time::timeout_at(deadline.into(),self.rpc(false,"sendrawtransaction",request))
+            .await.context("BCH redemption dispatch deadline exceeded; result is uncertain")??;
+        let txid: Txid = serde_json::from_str(reply.get())?;
+        ensure!(txid == transaction.compute_txid(),"BCH redemption relay returned another transaction ID");
+        Ok(txid)
+    }
+}
