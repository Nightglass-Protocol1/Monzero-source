+
+const ATTEMPT: &str = "monzero-bch-redemption-relay-intent-v1";
+const ACK: &str = "monzero-bch-redemption-relay-ack-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt {schema: String,review: [u8;32],approved_at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack {schema: String,attempt: [u8;32],txid: Txid}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum RedemptionRelayState {
+    /// May include interruption before dispatch. Never automatic retry authority.
+    Attempted {txid: Txid},
+    /// Exact node acknowledgement, not confirmation or settlement finality.
+    Acknowledged {txid: Txid},
+}
+fn slot(quote: &VerifiedBchQuote,suffix: &str) -> String {
+    format!("{}.bch-redemption-relay-{suffix}",quote.terms()["swapId"])
+}
+impl AdmittedExecution<'_> {
+    fn redemption_attempt(&self,review: &RedemptionRelayReview,record: &Record)
+        -> Result<Option<(Attempt,[u8;32])>> {
+        let Some(bytes) = optional(&self.metadata,&slot(self.quote,"intent"))? else {return Ok(None)};
+        ensure!(bytes.len() <= 4096,"oversized BCH redemption attempt");
+        let attempt: Attempt = serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema == ATTEMPT && attempt.review == review.commitment
+            && attempt.approved_at >= record.prepared_at && serde_json::to_vec(&attempt)? == bytes,
+            "BCH redemption attempt differs from approval");
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+    fn redemption_state(&self,review: &RedemptionRelayReview,record: &Record)
+        -> Result<Option<RedemptionRelayState>> {
+        let ack = optional(&self.metadata,&slot(self.quote,"ack"))?;
+        let Some((_,attempt)) = self.redemption_attempt(review,record)? else {
+            ensure!(ack.is_none(),"BCH redemption acknowledgement lacks original attempt");return Ok(None)
+        };
+        let txid = summary(record)?.txid();
+        let Some(bytes) = ack else {return Ok(Some(RedemptionRelayState::Attempted {txid}))};
+        ensure!(bytes.len() <= 4096,"oversized BCH redemption acknowledgement");
+        let ack: Ack = serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema == ACK && ack.attempt == attempt && ack.txid == txid
+            && serde_json::to_vec(&ack)? == bytes,"BCH redemption acknowledgement changed");
+        Ok(Some(RedemptionRelayState::Acknowledged {txid}))
+    }
+    pub fn bch_redemption_relay_state(&self) -> Result<Option<RedemptionRelayState>> {
+        let (review,record,_,_) = self.redemption_relay_materials()?;
+        self.redemption_state(&review,&record)
+    }
+    /// Broadcast the saved redemption once. Publication reveals the native share.
+    /// Historical quote expiry does not block settlement; current chain safety does.
+    pub async fn relay_bch_redemption(&mut self,native: &impl crate::xmz_funding::FundingObserver,
+        bch: &BchRpc,approved: &[u8;32],now: u64) -> Result<Txid> {
+        let (review,record,deployment,margin) = self.redemption_relay_materials()?;
+        ensure!(review.commitment == *approved,"BCH redemption approval is stale or mismatched");
+        ensure!(now >= record.prepared_at && bch.deployment_commitment()? == deployment,
+            "BCH redemption predates preparation or changes observer");
+        if let Some((attempt,_)) = self.redemption_attempt(&review,&record)? {
+            ensure!(now >= attempt.approved_at,"BCH redemption time moved backwards");
+        }
+        match self.redemption_state(&review,&record)? {
+            Some(RedemptionRelayState::Acknowledged {txid}) => return Ok(txid),
+            Some(RedemptionRelayState::Attempted {..}) => anyhow::bail!("BCH redemption result is uncertain; reconcile without retransmitting"),
+            None => (),
+        }
+        // Finish expensive historical validation before the final live checks.
+        let request = self.outgoing_native_funding_request()?;
+        let funding = self.received_bch_funding_message()?.context("missing BCH funding receipt")?;
+        let transaction: Transaction = deserialize(&record.transaction)?;
+        ensure!(transaction.input[0].previous_output == funding.signed().lock_outpoint(),"BCH redemption funding changed");
+        // Bound observation age independently of the expired commercial quote.
+        let deadline = std::time::Instant::now().checked_add(std::time::Duration::from_secs(30))
+            .context("BCH redemption observation deadline overflow")?;
+        let evidence = crate::xmz_funding::verify(native,request,&self.policy.xmz_genesis,
+            u64::from(self.policy.xmz_confirmations)).await?;
+        let live = bch.observe_funding(funding.signed()).await?;
+        live.require_funding_window(u64::from(self.policy.bch_confirmations),u32::from(self.policy.cancel_blocks),margin)?;
+        ensure!(native.snapshot().await? == *evidence.snapshot(),"native chain changed before BCH redemption");
+        ensure!(std::time::Instant::now() < deadline,"BCH redemption observations expired");
+        let attempt = Attempt {schema:ATTEMPT.into(),review:*approved,approved_at:now};
+        let bytes = serde_json::to_vec(&attempt)?;
+        self.metadata.retain(&slot(self.quote,"intent"),&bytes)?;
+        let txid = bch.relay_redemption(&transaction,deadline).await?;
+        let ack = Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid};
+        self.metadata.retain(&slot(self.quote,"ack"),&serde_json::to_vec(&ack)?)?;
+        Ok(txid)
+    }
+}
