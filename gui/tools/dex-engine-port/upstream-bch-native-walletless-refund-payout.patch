+use super::*;
+use crate::native_funding_rpc::{full_proceeds::{ExactNetRequest,FullProceedsRequest},wallet_session::fixture::Payout};
+use swap_core::xmz::XmzAmount;
+
+fn copy_store(source: &std::path::Path) -> Result<PrivateStore> {
+    let target=PrivateStore::new()?;
+    for entry in std::fs::read_dir(source)? {
+        let entry=entry?;ensure!(entry.file_type()?.is_file(),"unexpected fixture directory entry");
+        std::fs::copy(entry.path(),target.0.join(entry.file_name()))?;
+    }
+    Ok(target)
+}
+
+pub(super) async fn exercise(metadata: &std::path::Path,setup: &Setup,snapshots: &PrivateStore,
+    observer_fixture: &Fixture,rpc: &OwnedBchObserver,refund: Txid,address: &XmzAddress,wallet: &WalletFixture) -> Result<()> {
+    let observer=observer_fixture.funding_client()?;let block=Some(BlockHash::from_byte_array([6;32]));
+    let amount=|field:&str| -> Result<XmzAmount> {Ok(XmzAmount::from_atoms(setup.quote.terms()[field].parse()?))};
+    let request=ExactNetRequest {source:FullProceedsRequest {wallet:address.clone(),destination:setup.quote.xmz_refund().clone(),
+        lock_txid:"ab".repeat(32),locked:amount("xmzAtoms")?,maximum_fee:amount("xmzRefundFeeMaxAtoms")?,account:0,priority:1},
+        principal:XmzAmount::from_atoms(amount("xmzAtoms")?.atoms()-amount("xmzRefundFeeMaxAtoms")?.atoms()),reserve_return:setup.quote.xmz_refund().clone()};
+    for lost in [true,false] {
+        let copied=copy_store(metadata)?;let private=copy_store(&snapshots.0)?;
+        let slot=|part:&str|format!("{}.bch-native-refund-payout-{part}",setup.quote.terms()["swapId"]);
+        let intent=copied.0.join(slot("intent"));let pin=copied.0.join(slot("pin"));let prepared=private.0.join(slot("prepared"));
+        {
+            let mut state=wallet.state.lock().unwrap();state.payout=Some(Payout {request:request.clone(),intent:intent.clone(),fee:900});
+            state.lose_payout=lost;
+        }
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let mut session=wallet.payout_session(&observer)?;
+        let transfers=wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="transfer").count();
+        assert!(execution.prepare_light_bch_native_refund_payout(&observer,rpc,refund,block,2048,&mut session,0).await.is_err());
+        assert!(!intent.exists());
+        let result=execution.prepare_light_bch_native_refund_payout(&observer,rpc,refund,block,2048,&mut session,1).await;
+        assert!(intent.exists());
+        assert_eq!(wallet.state.lock().unwrap().calls.iter().filter(|s|s.as_str()=="transfer").count(),transfers+1);
+        let expected=if lost {assert!(result.is_err());assert!(!pin.exists() && !prepared.exists());None}
+            else {
+                let terms=result?;assert!(pin.exists() && prepared.exists());
+                assert_eq!(terms["payoutAtoms"],"100000");assert_eq!(terms["reserveReturnAtoms"],"100");
+                assert_eq!(terms["feeAtoms"],"900");assert_eq!(terms["destination"],setup.quote.xmz_refund().to_string());
+                assert_eq!(terms["reserveReturn"],setup.quote.xmz_refund().to_string());
+                for secret in ["tx_metadata","tx_key","spendKey","viewKey"] {assert!(terms.get(secret).is_none());}
+                Some(terms)
+            };
+        let calls=wallet.state.lock().unwrap().calls.len();let observations=observer_fixture.calls.lock().unwrap().len();
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let mut restarted=wallet.payout_session(&observer)?;
+        let changed=OwnedBchObserver::new(1,"user".into(),"pass".into(),rpc.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+        assert!(execution.prepare_light_bch_native_refund_payout(&observer,&changed,refund,block,2049,&mut restarted,1).await.is_err());
+        let restored=execution.prepare_light_bch_native_refund_payout(&observer,rpc,refund,block,2049,&mut restarted,1).await;
+        if let Some(expected)=expected {
+            assert_eq!(restored?,expected);assert_eq!(execution.recover_prepared_bch_native_refund_payout()?,expected);
+            let review=execution.review_light_bch_native_refund_payout_relay(rpc,2049)?;
+            assert_eq!(review.details["action"],"broadcast-bch-native-refund-payout");
+            assert_eq!(review.details["refundAtoms"],"100100");
+            assert_eq!(review.details["payout"],expected);
+            assert_eq!(review.details["refund"],serde_json::to_value(refund)?);
+            for secret in ["tx_metadata","tx_key","spendKey","viewKey"] {assert!(review.details.get(secret).is_none());}
+            assert!(execution.review_light_bch_native_refund_payout_relay(rpc,2047).is_err());
+            assert_eq!(execution.review_light_bch_native_refund_payout_relay(rpc,2050)?.commitment,review.commitment);
+            assert!(execution.prepare_light_bch_native_refund_payout(&observer,rpc,refund,block,2049,&mut restarted,2).await.is_err());
+            // Every incomplete/corrupt checkpoint must reject offline recovery.
+            let saved=std::fs::read(&prepared)?;std::fs::write(&prepared,b"{}")?;
+            assert!(execution.recover_prepared_bch_native_refund_payout().is_err());
+            assert!(execution.review_light_bch_native_refund_payout_relay(rpc,2049).is_err());
+            std::fs::write(&prepared,&saved)?;
+            let held=copied.0.join("held-payout-pin");std::fs::rename(&pin,&held)?;
+            assert!(execution.recover_prepared_bch_native_refund_payout().is_err());std::fs::rename(&held,&pin)?;
+            let held=copied.0.join("held-payout-intent");std::fs::rename(&intent,&held)?;
+            assert!(execution.recover_prepared_bch_native_refund_payout().is_err());std::fs::rename(&held,&intent)?;
+            assert_eq!(execution.recover_prepared_bch_native_refund_payout()?,expected);
+            assert_eq!(std::fs::read(&prepared)?,saved);
+        } else {
+            assert!(restored.is_err());assert!(execution.recover_prepared_bch_native_refund_payout().is_err());
+            assert!(execution.review_light_bch_native_refund_payout_relay(rpc,2049).is_err());
+        }
+        assert_eq!(wallet.state.lock().unwrap().calls.len(),calls,"saved or uncertain payout performed another wallet operation");
+        assert_eq!(observer_fixture.calls.lock().unwrap().len(),observations,"offline recovery performed chain observations");
+        assert!(!wallet.state.lock().unwrap().calls.iter().any(|s|s=="relay_tx"));
+        if lost {continue;}
+        relay::exercise(&copied.0,setup,&private,observer_fixture,rpc,wallet).await?;
+
+
+    }
+    Ok(())
