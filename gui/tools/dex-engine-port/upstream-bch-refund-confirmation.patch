+//! Fresh confirmation resolves chain outcome without rewriting dispatch history.
+use super::*;
+use crate::bch_rpc::confirmed::ConfirmedTransaction;
+
+pub struct ConfirmedRefund {
+    quote: [u8;32],admission: [u8;32],review: [u8;32],confirmation: ConfirmedTransaction,
+}
+impl ConfirmedRefund {
+    pub fn quote(&self) -> &[u8;32] {&self.quote}
+    pub fn admission(&self) -> &[u8;32] {&self.admission}
+    pub fn review(&self) -> &[u8;32] {&self.review}
+    pub fn confirmation(&self) -> &ConfirmedTransaction {&self.confirmation}
+}
+impl AdmittedExecution<'_> {
+    /// Observe the exact refund associated with our retained dispatch intent.
+    /// Acknowledgement is unnecessary; every call checks current chain evidence.
+    /// This neither retransmits the refund nor authorizes a native wallet action.
+    pub async fn observe_bch_refund(&self,bch: &BchRpc,block: Option<BlockHash>) -> Result<ConfirmedRefund> {
+        let (attempt,_)=self.refund_attempt()?.context("missing BCH refund relay intent")?;
+        let (review,recovery,deployment)=self.refund_relay_materials(attempt.safety_blocks)?;
+        self.refund_state(&review,&recovery,attempt.safety_blocks)?.context("missing BCH refund relay state")?;
+        ensure!(bch.deployment_commitment()?==deployment,"BCH refund confirmation observer changed");
+        let admission=self.admission_digest()?;
+        let txid=recovery.refund_txid()?;let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmation=match block {
+            Some(block)=>bch.confirmed_transaction(txid,block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(txid,minimum).await?,
+        };
+        ensure!(confirmation.deployment()==&deployment && serialize(confirmation.transaction())==recovery.refund_bytes(),
+            "confirmed BCH refund differs from retained recovery");
+        Ok(ConfirmedRefund {quote:*self.quote.commitment(),admission,review:review.commitment,confirmation})
+    }
+}
