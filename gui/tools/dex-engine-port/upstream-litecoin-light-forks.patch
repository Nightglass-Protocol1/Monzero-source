+#[test]
+fn forks_select_validated_work_and_report_disconnected_evidence() -> Result<()> {
+    let mut selected = HeaderSequence::new(LtcNetwork::Regtest)?;
+    selected.append(&serialize(&child()),1296688902)?;
+    let old = child().block_hash();
+    let mut candidate = selected.fork(0)?;
+    let mut alternative = child(); alternative.nonce=0;
+    candidate.append(&serialize(&alternative),1296688902)?;
+    assert!(selected.adopt(candidate.fork(1)?)?.is_none()); // equal work retains first branch
+    assert!(selected.contains(1,old));
+    let descendant = bytes("000000209d08f789f2afaf053878d9b21add2f847fff4a9c32fb58b8c5c79ca166f94a9d111111111111111111111111111111111111111111111111111111111111111106e7494dffff7f2000000000");
+    // Fixed fixture independently checked using Python hashlib.scrypt; no nonce search in tests.
+    assert_eq!(scrypt_hash(&descendant)?.as_slice(),bytes("4ffb10ab764015ff681677358d849316f894e6295b53d86b4afde1b5f9abd60d"));
+    let tip = candidate.append(&descendant,1296688902)?;
+    let change = selected.adopt(candidate)?.unwrap();
+    assert_eq!(change,ChainChange {common_ancestor:0,old_tip:(1,old),new_tip:(2,tip)});
+    assert!(!selected.contains(1,old)); assert!(selected.contains(1,alternative.block_hash()));
+    assert!(selected.contains(2,tip)); assert!(!selected.contains(3,tip));
+    assert_eq!(selected.chain_work(),&BigUint::from(6u8));
+    let prefix = selected.fork(1)?;
+    assert_eq!(prefix.chain_work(),&BigUint::from(4u8));
+    assert!(selected.adopt(prefix)?.is_none());
+    assert!(selected.fork(3).is_err());
+    assert_eq!(selected.height(),2);
+    Ok(())
+}
+#[test]
+fn forks_extension_and_wrong_network_are_distinct() -> Result<()> {
+    let mut selected = HeaderSequence::new(LtcNetwork::Regtest)?;
+    let genesis = selected.header(0).unwrap().block_hash();
+    let mut candidate = selected.fork(0)?;
+    candidate.append(&serialize(&child()),1296688752)?;
+    assert_eq!(selected.height(),0); // fork mutation is isolated
+    assert_eq!(selected.adopt(candidate)?.unwrap(),ChainChange {
+        common_ancestor:0,old_tip:(0,genesis),new_tip:(1,child().block_hash())});
+    let work = selected.chain_work().clone();
+    assert!(selected.adopt(HeaderSequence::new(LtcNetwork::Mainnet)?).is_err());
+    assert_eq!(selected.chain_work(),&work); assert!(selected.contains(1,child().block_hash()));
+    Ok(())
+}
