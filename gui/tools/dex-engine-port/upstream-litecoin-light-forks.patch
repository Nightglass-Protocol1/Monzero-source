+
+    /// Independently extend a previously validated prefix when investigating a fork.
+    pub fn fork(&self,height: u32) -> Result<Self> {
+        ensure!(height<=self.height(), "Litecoin fork height outside retained chain");
+        let headers = self.headers[..=height as usize].to_vec();
+        let mut work = BigUint::from(0u8);
+        for header in &headers { work += block_work(&target(header.bits.to_consensus(),self.network)?); }
+        Ok(Self {network:self.network,headers,work})
+    }
+
+    /// Ties retain the current branch. Candidates cannot bypass header validation:
+    /// their fields are private and construction starts at the pinned genesis.
+    /// This chooses among supplied branches, not necessarily the network's best tip.
+    pub fn adopt(&mut self,candidate: Self) -> Result<Option<ChainChange>> {
+        ensure!(candidate.network==self.network, "Litecoin candidate network mismatch");
+        if candidate.work<=self.work {return Ok(None)}
+        let common = self.headers.iter().zip(&candidate.headers)
+            .take_while(|(left,right)|left.block_hash()==right.block_hash()).count();
+        ensure!(common>0, "Litecoin candidate genesis mismatch");
+        let old_height = self.height(); let new_height = candidate.height();
+        let change = ChainChange {
+            common_ancestor:(common-1) as u32,
+            old_tip:(old_height,self.headers[old_height as usize].block_hash()),
+            new_tip:(new_height,candidate.headers[new_height as usize].block_hash()),
+        };
+        *self = candidate;
+        Ok(Some(change))
+    }
+
