diff --git a/swap-machine/src/native_funding_rpc/sensitive.rs b/swap-machine/src/native_funding_rpc/sensitive.rs
new file mode 100644
--- /dev/null
+++ b/swap-machine/src/native_funding_rpc/sensitive.rs
@@ -0,0 +1,83 @@
+//! Owned RPC buffers only. Socket/library buffers and returned result values
+//! have separate lifetimes; this module does not promise complete memory erasure.
+use super::*;
+use std::io::{self,Write};
+use zeroize::Zeroize;
+
+pub(super) struct SecretJson(pub(super) Value);
+impl Drop for SecretJson {fn drop(&mut self){clear(&mut self.0);}}
+fn clear(value:&mut Value) {
+    match value {
+        Value::String(text)=>wipe_string(text),
+        Value::Array(values)=>{for value in values {clear(value);}},
+        Value::Object(values)=>{
+            for (mut key,mut value) in std::mem::take(values) {wipe_string(&mut key);clear(&mut value);}
+        },
+        _=>(),
+    }
+    *value=Value::Null;
+}
+fn wipe_string(text:&mut String) {
+    text.zeroize();
+    #[cfg(test)]
+    WIPES.with(|count|{assert!(text.is_empty());count.set(count.get()+1);});
+}
+#[cfg(test)]
+std::thread_local! {static WIPES:std::cell::Cell<usize>=const {std::cell::Cell::new(0)};}
+struct SensitiveBytes(Zeroizing<Vec<u8>>);
+impl AsRef<[u8]> for SensitiveBytes {fn as_ref(&self)->&[u8]{self.0.as_slice()}}
+struct Size(usize);
+impl Write for Size {
+    fn write(&mut self,bytes:&[u8])->io::Result<usize> {
+        self.0=self.0.checked_add(bytes.len()).ok_or_else(||io::Error::other("native RPC request size overflow"))?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self)->io::Result<()> {Ok(())}
+}
+pub(super) fn request_body(method:&str,params:&Value)->Result<bytes::Bytes> {
+    #[derive(serde::Serialize)]
+    struct Request<'a> {jsonrpc:&'static str,id:&'static str,method:&'a str,params:&'a Value}
+    let request=Request {jsonrpc:"2.0",id:"native-funding",method,params};
+    // Count without storing secrets, then serialize without reallocating.
+    let mut size=Size(0);serde_json::to_writer(&mut size,&request)?;
+    let mut body=Zeroizing::new(Vec::with_capacity(size.0));
+    serde_json::to_writer(&mut *body,&request)?;
+    ensure!(body.len()==size.0,"native RPC request size changed during serialization");
+    // Clones for Digest retry share this owner; the last drop wipes its buffer.
+    Ok(bytes::Bytes::from_owner(SensitiveBytes(body)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn request_preserves_escaped_secrets_and_shares_retry_storage()->Result<()> {
+        let params=SecretJson(json!({"password":"fixture\"\n秘密","nested":[{"spendkey":"0123"},null,42]}));
+        let body=request_body("generate_from_keys",&params.0)?;
+        let retry=body.clone();assert_eq!(body.as_ptr(),retry.as_ptr());
+        let parsed:Value=serde_json::from_slice(&body)?;
+        assert_eq!(parsed,json!({"jsonrpc":"2.0","id":"native-funding","method":"generate_from_keys","params":params.0}));
+        drop(params);drop(body);
+        assert_eq!(serde_json::from_slice::<Value>(&retry)?,parsed);
+        Ok(())
+    }
+    #[test]
+    fn clear_visits_nested_strings_and_object_keys() {
+        let mut value=json!({"fixture-secret-key":["secret",{"password":"value"},false,123,null]});
+        let before=WIPES.with(|count|count.get());
+        clear(&mut value);assert!(value.is_null());
+        assert_eq!(WIPES.with(|count|count.get())-before,4);
+    }
+    #[test]
+    fn unpolled_rpc_futures_drop_their_parameter_guards()->Result<()> {
+        let client=NativeFundingRpc::new(1,2,"fixture".into(),"fixture".into())?;
+        let before=WIPES.with(|count|count.get());
+        drop(client.rpc(2,"open_wallet",json!({"password":"fixture-secret"})));
+        assert_eq!(WIPES.with(|count|count.get())-before,2);
+        let before=WIPES.with(|count|count.get());
+        drop(client.rpc_response(2,"open_wallet",json!({"password":"fixture-secret"})));
+        assert_eq!(WIPES.with(|count|count.get())-before,2);
+        Ok(())
+    }
+
+}
