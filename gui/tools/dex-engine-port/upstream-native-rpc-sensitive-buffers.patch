new file mode 100644
--- /dev/null
+++ b/swap-machine/src/native_funding_rpc/transport_tests.rs
@@ -0,0 +1,60 @@
+use super::*;
+use std::{io::{BufRead,BufReader,Read,Write},net::{TcpListener,TcpStream}};
+fn request(reader:&mut BufReader<TcpStream>)->Result<(Vec<u8>,bool)> {
+    let mut line=String::new();reader.read_line(&mut line)?;
+    ensure!(line.starts_with("POST /json_rpc HTTP/1.1"),"unexpected request");
+    let mut length=None;let mut authenticated=false;
+    loop {
+        line.clear();ensure!(reader.read_line(&mut line)?>0,"missing headers");
+        if line=="\r\n" {break}
+        let lower=line.to_ascii_lowercase();
+        if let Some(value)=lower.strip_prefix("content-length:"){length=Some(value.trim().parse::<usize>()?);}
+        if lower.starts_with("authorization:") {ensure!(lower.contains("digest ") && lower.contains("auth-int"),"missing auth-int");authenticated=true;}
+    }
+    let length=length.context("missing length")?;ensure!(length<4096,"unexpected request size");
+    let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;Ok((bytes,authenticated))
+}
+#[tokio::test]
+async fn digest_retry_preserves_body_and_drains_challenge()->Result<()> {
+    for reject in [false,true] {
+        let server=TcpListener::bind(("127.0.0.1",0))?;let port=server.local_addr()?.port();
+        let thread=std::thread::spawn(move ||->Result<()> {
+            let (mut socket,_)=server.accept()?;socket.set_read_timeout(Some(std::time::Duration::from_secs(5)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);
+            let (first,auth)=request(&mut reader)?;ensure!(!auth,"unexpected initial credentials");
+            socket.write_all(b"HTTP/1.1 401 Unauthorized\r\nWWW-Authenticate: Digest realm=\"fixture\", nonce=\"fixed-nonce\", algorithm=MD5, qop=\"auth-int\"\r\nContent-Length: 9\r\nConnection: keep-alive\r\n\r\nchallenge")?;
+            let (second,auth)=request(&mut reader)?;ensure!(auth && first==second,"retry body or authorization changed");
+            let parsed:Value=serde_json::from_slice(&second)?;ensure!(parsed["params"]["password"]=="fixture-secret","wrong parameters");
+            if reject {socket.write_all(b"HTTP/1.1 401 Unauthorized\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")?;}
+            else {
+                let body=br#"{"id":"native-funding","result":{"accepted":true}}"#;
+                write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;socket.write_all(body)?;
+            }
+            Ok(())
+        });
+        let client=NativeFundingRpc::new(if port==1 {2}else{1},port,"fixture".into(),"fixture".into())?;
+        let result=client.rpc(port,"open_wallet",json!({"password":"fixture-secret"})).await;
+        thread.join().map_err(|_|anyhow::anyhow!("server thread failed"))??;
+        if reject {assert!(result.is_err());}else{assert_eq!(result?,json!({"accepted":true}));}
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn rejects_malformed_wrong_id_and_oversized_responses()->Result<()> {
+    for body in [b"not-json".to_vec(),br#"{"id":"wrong","result":{"secret":"fixture"}}"#.to_vec(),vec![b' ';1_048_577]] {
+        let server=TcpListener::bind(("127.0.0.1",0))?;let port=server.local_addr()?.port();
+        let thread=std::thread::spawn(move ||->Result<()> {
+            let (mut socket,_)=server.accept()?;socket.set_read_timeout(Some(std::time::Duration::from_secs(5)))?;
+            let mut reader=BufReader::new(socket.try_clone()?);request(&mut reader)?;
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",body.len())?;
+            // The client may close immediately on exceeding its response bound.
+            let _=socket.write_all(&body);Ok(())
+        });
+        let client=NativeFundingRpc::new(port,if port==1 {2}else{1},"fixture".into(),"fixture".into())?;
+        let result=client.rpc(port,"get_version",json!({})).await;
+        thread.join().map_err(|_|anyhow::anyhow!("server thread failed"))??;
+        let error=result.err().context("invalid response accepted")?.to_string();
+        assert!(error.contains("native RPC JSON") || error.contains("response identity mismatch") || error.contains("oversized native RPC response"));
+    }
+    Ok(())
+}
