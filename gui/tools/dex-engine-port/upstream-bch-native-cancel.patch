+use super::*;
+use agreement::execution::funding::recovery::cancel::CancelRelayState;
+
+pub(super) async fn exercise(metadata: &PrivateStore,snapshots: &PrivateStore,setup: &Setup,
+    rpc: &BchRpc,server: &Server,cancel: &Transaction) -> Result<()> {
+    let block=Some(BlockHash::from_byte_array([6;32]));let txid=cancel.compute_txid();
+    let private=PrivateStore::new()?;
+    for entry in std::fs::read_dir(&snapshots.0)? {
+        let entry=entry?;
+        if entry.file_type()?.is_file() && !entry.file_name().to_string_lossy().ends_with(".bch-funding-private-recovery") {
+            std::fs::copy(entry.path(),private.0.join(entry.file_name()))?;
+        }
+    }
+    for mode in [0,1,2] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}}
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        let intent=copied.0.join(format!("{}.bch-cancel-relay-intent",setup.quote.terms()["swapId"]));
+        let ack=copied.0.join(format!("{}.bch-cancel-relay-ack",setup.quote.terms()["swapId"]));
+        {let mut state=server.state.lock().unwrap();state.cancel=Some(cancel.clone());state.relay_intent=Some(intent.clone());state.relay_mode=mode;state.observation_mode=23;}
+        let calls=server.state.lock().unwrap().cancel_relay_calls;
+        let review=execution.review_bch_cancel_relay(rpc,2030)?;
+        assert_eq!(review.details["schema"],"monzero-bch-native-cancel-relay-review-v1");
+        assert_eq!(review.details["txid"],txid.to_string());assert_eq!(review.details["recoveryAtoms"],"99000");
+        assert_eq!(review.details["feeAtoms"],"1000");assert_eq!(review.details["cancelDelayBlocks"],20);
+        assert!(review.details.get("privateRecovery").is_none());
+        assert!(execution.review_bch_cancel_relay(rpc,1000).is_err());
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_bch_cancel(rpc,&bad,2031).await.is_err());assert!(!intent.exists());
+        if mode==0 {
+            server.state.lock().unwrap().observation_mode=24;
+            assert!(execution.relay_bch_cancel(rpc,&review.commitment,2031).await.is_err());
+            assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls);
+            server.state.lock().unwrap().observation_mode=23;
+        }
+        let result=execution.relay_bch_cancel(rpc,&review.commitment,2031).await;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        let expected=if mode==0 {assert_eq!(result?,txid);assert!(ack.exists());CancelRelayState::Acknowledged {txid}}
+            else {assert!(result.is_err());assert!(!ack.exists());CancelRelayState::Attempted {txid}};
+        drop(execution);
+        let mut restored=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+        assert_eq!(restored.bch_cancel_relay_state()?,Some(expected));
+        let result=restored.relay_bch_cancel(rpc,&review.commitment,2032).await;
+        if mode==0 {assert_eq!(result?,txid);} else {assert!(result.is_err());}
+        assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        assert_eq!(restored.observe_bch_cancel(rpc,block).await?.confirmation().transaction(),cancel);
+        assert_eq!(restored.observe_bch_recovery_output(rpc,None).await?.output().output(),&cancel.output[0]);
+        assert_eq!(restored.bch_cancel_relay_state()?,Some(expected));
+    }
+    let mut state=server.state.lock().unwrap();state.cancel=None;state.relay_intent=None;state.relay_mode=0;state.observation_mode=0;
+    Ok(())
+}
