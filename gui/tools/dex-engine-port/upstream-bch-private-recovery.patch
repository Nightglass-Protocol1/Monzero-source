+//! Private recovery transactions bound to exact retained signed funding and
+//! authenticated refund protection. No chain maturity, release or relay grant.
+use super::*;
+use bitcoin::{consensus::{serialize,deserialize},OutPoint,Transaction,Txid};
+use ecdsa_fun::fun::{Point,Scalar};
+use zeroize::{Zeroize,Zeroizing};
+
+const RECORD: &str = "monzero-bch-private-recovery-v1";
+const PIN: &str = "monzero-bch-private-recovery-pin-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    schema: String, admission: [u8;32], funding: [u8;32], receipt: [u8;32], prepared_at: u64,
+    cancel: Vec<u8>, refund: Vec<u8>, punish: Vec<u8>,
+}
+impl Drop for Record { fn drop(&mut self) { self.refund.zeroize(); } }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin { schema: String, admission: [u8;32], record: [u8;32] }
+
+/// No Debug/Serialize: publishing the refund reveals the BCH funder's native
+/// spend share to its peer. Keep it private until an explicit refund release
+/// decision backed by both-chain observations and confirmation policy.
+pub struct PrivateRecovery {
+    cancel: Transaction, refund: Zeroizing<Vec<u8>>, punish: Transaction,
+    commitment: [u8;32], prepared_at: u64,
+}
+impl PrivateRecovery {
+    pub fn cancel(&self) -> &Transaction { &self.cancel }
+    pub fn punish(&self) -> &Transaction { &self.punish }
+    pub fn commitment(&self) -> &[u8;32] { &self.commitment }
+    pub fn prepared_at(&self) -> u64 { self.prepared_at }
+    pub fn refund_txid(&self) -> Result<Txid> {
+        Ok(deserialize::<Transaction>(self.refund_bytes())?.compute_txid())
+    }
+    pub(crate) fn refund_bytes(&self) -> &[u8] { &self.refund }
+}
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+impl AdmittedExecution<'_> {
+    fn recovery_record(&self,now: u64) -> Result<Record> {
+        ensure!(self.role == Role::BchFunder,"only BCH funder prepares private BCH refund");
+        self.quote.check_policy(self.policy,now)?;
+        let (signed,signed_at) = self.restore_signed_bch_funding()?.context("missing exact signed BCH funding")?;
+        let (encrypted,receipt,received_at) = self.received_bch_refund_record()?.context("missing authenticated BCH refund protection")?;
+        ensure!(now >= signed_at && now >= received_at,"BCH recovery preparation predates funding or refund receipt");
+        let agreed = self.restore_agreement()?;
+        let plan = self.quote.recovery_plan();
+        let funding = serialize(signed.transaction());
+        let cancel = plan.lock().prepare_timeout(&funding,&plan.lock_spend_terms(signed.lock_outpoint()))?;
+        let cancel_raw = serialize(&cancel);
+        let outpoint = OutPoint {txid:cancel.compute_txid(),vout:0};
+        let terms = plan.recovery_spend_terms(outpoint);
+        let mut secret = Zeroizing::new(agreed.owned().native_spend_share().as_bytes()); secret.reverse();
+        let decrypt = Scalar::from_bytes(*secret).context("invalid owned BCH adaptor scalar")?
+            .non_zero().context("zero owned BCH adaptor scalar")?;
+        let signer = Point::from_bytes(plan.recovery().terms().signing_key.serialize()).context("invalid BCH refund signer")?;
+        let signature = Zeroizing::new(plan.recovery().data_message().decrypt(&signer,&decrypt,encrypted)?);
+        let refund = plan.recovery().prepare_redemption(&cancel_raw,&terms,&signature)?;
+        let punish = plan.recovery().prepare_timeout(&cancel_raw,&terms)?;
+        Ok(Record {schema:RECORD.into(),admission:self.admission_digest()?,
+            funding:hash("monzero-bch-exact-signed-funding-v1",&funding),receipt,prepared_at:now,
+            cancel:cancel_raw,refund:serialize(&refund),punish:serialize(&punish)})
+    }
+
+    fn check_recovery_record(&self,bytes: &[u8]) -> Result<PrivateRecovery> {
+        ensure!(bytes.len() <= 100_000,"oversized private BCH recovery record");
+        let record: Record = serde_json::from_slice(bytes)?;
+        let expected = self.recovery_record(record.prepared_at)?;
+        ensure!(Zeroizing::new(serde_json::to_vec(&expected)?).as_slice() == bytes,
+            "private BCH recovery differs from retained funding, refund or admission");
+        Ok(PrivateRecovery {cancel:deserialize(&record.cancel)?,refund:Zeroizing::new(record.refund.clone()),
+            punish:deserialize(&record.punish)?,commitment:hash(RECORD,bytes),prepared_at:record.prepared_at})
+    }
+
+    /// Persist secret-bearing recovery bytes before publishing their trusted
+    /// metadata pin. An orphan snapshot can only finish its identical original
+    /// publication; it never selects a new funding transaction or refund proof.
+    pub fn retain_bch_recovery(&mut self,now: u64) -> Result<PrivateRecovery> {
+        self.quote.check_policy(self.policy,now)?;
+        if let Some(existing) = self.retained_bch_recovery()? {
+            ensure!(now >= existing.prepared_at,"BCH recovery time moved backwards");
+            return Ok(existing)
+        }
+        let slot = record_name(self.quote,"private-recovery");
+        let existing = optional(&Journal::open(&self.snapshots)?,&slot)?;
+        let bytes = match existing {
+            Some(bytes) => Zeroizing::new(bytes),
+            None => Zeroizing::new(serde_json::to_vec(&self.recovery_record(now)?)?),
+        };
+        let recovery = self.check_recovery_record(&bytes)?;
+        ensure!(now >= recovery.prepared_at,"BCH recovery publication predates preparation");
+        Journal::open(&self.snapshots)?.retain(&slot,&bytes)?;
+        let pin = Pin {schema:PIN.into(),admission:self.admission_digest()?,record:recovery.commitment};
+        self.metadata.retain(&record_name(self.quote,"recovery-pin"),&serde_json::to_vec(&pin)?)?;
+        Ok(recovery)
+    }
+
+    /// Restore historical protection after expiry without granting new funding
+    /// or releasing the private refund. A missing pin is not input-retry or
+    /// re-signing permission; a retained orphan still occupies its fixed slot.
+    pub fn retained_bch_recovery(&self) -> Result<Option<PrivateRecovery>> {
+        let Some(bytes) = optional(&self.metadata,&record_name(self.quote,"recovery-pin"))? else {return Ok(None)};
+        ensure!(bytes.len() <= 4096,"oversized BCH recovery pin");
+        let pin: Pin = serde_json::from_slice(&bytes)?;
+        ensure!(pin.schema == PIN && pin.admission == self.admission_digest()?
+            && serde_json::to_vec(&pin)? == bytes,"BCH recovery pin changed");
+        let bytes = Zeroizing::new(Journal::open(&self.snapshots)?.read(&record_name(self.quote,"private-recovery"))?);
+        ensure!(hash(RECORD,&bytes) == pin.record,"BCH private recovery digest mismatch");
+        Ok(Some(self.check_recovery_record(&bytes)?))
+    }
+}
