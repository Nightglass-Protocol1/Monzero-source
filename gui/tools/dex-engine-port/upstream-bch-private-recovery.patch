+use super::*;
+use swap_core::bch::funding::SignedFunding;
+
+pub(super) fn exercise(execution: &mut AdmittedExecution<'_>,setup: &Setup,metadata: &PrivateStore,
+    snapshots: &PrivateStore,signed: &SignedFunding) -> Result<[u8;32]> {
+    assert!(execution.retain_bch_recovery(1013).is_err()); // No refund protection yet.
+    assert!(execution.retained_bch_recovery()?.is_none());
+    let (n,nv,initial) = selected_with_outgoing(setup,&snapshots.0,1)?;
+    let (_,bv,_) = selected_with_outgoing(setup,&snapshots.0,0)?;
+    let (wallet,received) = n.retain_received_view(&snapshots.0,&setup.quote,&setup.policy,
+        1003,nv.commitment(),bv.frame(),bv.signature())?;
+    let ack = wallet.acknowledgement(&setup.quote)?;
+    let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+        &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    let agreement = agreement::storage::persist(&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder,&agreed)?;
+    let pins = NegotiationPins {initial,selection:*n.commitment(),outgoing:*nv.commitment(),received,agreement};
+    let nmeta = PrivateStore::new()?;
+    let mut native = AdmittedExecution::admit(&nmeta.0,&snapshots.0,&setup.quote,&setup.policy,
+        Role::NativeFunder,setup.quote.commitment(),pins,1005)?;
+    let frame = native.prepare_bch_refund_adaptor(1006)?;
+    let key = SigningKey::from_bytes(&[2;32]);
+    let signature = key.sign(&agreement::refund::signing_bytes(&frame)?).to_bytes();
+    let outgoing = native.retain_outgoing_bch_refund(1007,&signature)?;
+    let encrypted = execution.accept_bch_refund_adaptor(1014,outgoing.frame(),outgoing.signature())?;
+    assert!(execution.retain_bch_recovery(1013).is_err());
+    assert!(native.retain_bch_recovery(1015).is_err());
+    let recovery = execution.retain_bch_recovery(1015)?;
+    assert_eq!(recovery.cancel().input[0].previous_output,signed.lock_outpoint());
+    assert_ne!(recovery.cancel().input[0].previous_output.txid,
+        execution.prepared_bch_funding()?.unwrap().preview().transaction().compute_txid());
+    let plan = setup.quote.recovery_plan();
+    assert_eq!(recovery.cancel().input[0].sequence,Sequence(20));
+    assert_eq!(recovery.cancel().output[0].value.to_sat(),99_000);
+    assert_eq!(recovery.punish().input[0].sequence,Sequence(30));
+    assert_eq!(recovery.punish().output[0].value.to_sat(),97_000);
+    let refund: Transaction = deserialize(recovery.refund_bytes())?;
+    assert_eq!(refund.compute_txid(),recovery.refund_txid()?);
+    assert_eq!(refund.input[0].previous_output,recovery.punish().input[0].previous_output);
+    assert_eq!(refund.output[0].script_pubkey,plan.terms().bch_funder_refund);
+    assert_eq!(refund.output[0].value.to_sat(),97_000);
+    // The private refund really reveals the BCH share to its native peer once
+    // published. This is why the production bundle has no public refund bytes.
+    let recovered = native.restore_agreement()?.owned().recover_spend_key(&setup.quote,
+        &serialize(recovery.cancel()),refund.input[0].previous_output,recovery.refund_bytes(),&encrypted)?;
+    assert_eq!(recovered.as_bytes(),(setup.spend[0]+setup.spend[1]).as_bytes());
+    let digest = *recovery.commitment();
+    assert_eq!(execution.retain_bch_recovery(1016)?.commitment(),&digest);
+    assert!(execution.retain_bch_recovery(1014).is_err());
+    assert!(execution.retain_bch_recovery(2000).is_err());
+    assert_eq!(execution.retained_bch_recovery()?.unwrap().commitment(),&digest);
+    let record = snapshots.0.join(format!("{}.bch-funding-private-recovery",setup.quote.terms()["swapId"]));
+    let pin = metadata.0.join(format!("{}.bch-funding-recovery-pin",setup.quote.terms()["swapId"]));
+    let original = zeroize::Zeroizing::new(std::fs::read(&record)?);
+    // Simulate private-snapshot-written/metadata-pin-not-published interruption.
+    std::fs::remove_file(&pin)?;
+    assert!(execution.retained_bch_recovery()?.is_none());
+    let restored = execution.retain_bch_recovery(1017)?;
+    assert_eq!(restored.commitment(),&digest); assert_eq!(restored.prepared_at(),1015);
+    std::fs::write(&record,b"{}")?;
+    assert!(execution.retained_bch_recovery().is_err());
+    assert!(execution.retain_bch_recovery(1018).is_err());
+    std::fs::write(&record,&original)?;
+    assert_eq!(execution.retained_bch_recovery()?.unwrap().commitment(),&digest);
+    let receipt = metadata.0.join(format!("{}.bch-refund-bch-funder-authenticated",setup.quote.terms()["swapId"]));
+    let original = std::fs::read(&receipt)?; std::fs::remove_file(&receipt)?;
+    assert!(execution.retained_bch_recovery().is_err());
+    std::fs::write(&receipt,original)?; std::fs::set_permissions(&receipt,std::fs::Permissions::from_mode(0o600))?;
+    assert_eq!(execution.retained_bch_recovery()?.unwrap().commitment(),&digest);
+    Ok(digest)
+}
