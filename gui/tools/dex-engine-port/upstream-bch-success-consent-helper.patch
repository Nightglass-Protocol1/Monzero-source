@@ -0,0 +1,24 @@
+//! Actual Qt identity-store signer for a disposable controller-produced frame.
+use super::*;
+pub(super) fn sign(frame: &[u8]) -> Result<Vec<u8>> {
+    let program=PathBuf::from(std::env::var("MONZERO_BCH_QT_SUCCESS_IDENTITY_PROBE")?);
+    let expected=std::env::var("MONZERO_BCH_QT_SUCCESS_IDENTITY_PROBE_SHA256")?;
+    ensure!(program.is_absolute() && program.canonicalize()?==program
+        && hex(&Sha256::digest(std::fs::read(&program)?))==expected,"Qt identity probe changed");
+    let config=PathBuf::from(std::env::var("MONZERO_BCH_QT_SUCCESS_IDENTITY_CONFIG")?);
+    ensure!(config.is_absolute() && config.canonicalize()?==config
+        && hex(&Sha256::digest(std::fs::read(&config)?))==std::env::var("MONZERO_BCH_QT_SUCCESS_IDENTITY_CONFIG_SHA256")?,"Qt identity fixture changed");
+    let id=uuid::Uuid::new_v4();
+    let request=json!({"schema":"monzero-bch-success-sign-fixture-request-v1","requestId":id,"frameHex":hex(frame)});
+    let mut child=Command::new(&program).arg("--success-sign-fixture-v1").arg(&config)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    child.stdin.take().context("identity fixture stdin")?.write_all(&serde_json::to_vec(&request)?)?;
+    let output=child.wait_with_output()?;
+    ensure!(output.status.success() && output.stderr.is_empty() && output.stdout.len()<=512,"Qt identity fixture failed");
+    let response: Value=serde_json::from_slice(&output.stdout)?;
+    ensure!(response.as_object().is_some_and(|v|v.len()==3)
+        && response["schema"]=="monzero-bch-success-sign-fixture-response-v1" && response["requestId"]==id.to_string(),"Qt identity response changed");
+    let signature=response["signatureHex"].as_str().context("identity signature")?;
+    ensure!(signature.len()==128 && signature.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),"invalid identity signature");
+    Ok((0..64).map(|i|u8::from_str_radix(&signature[i*2..i*2+2],16)).collect::<std::result::Result<Vec<_>,_>>()?)
+}
