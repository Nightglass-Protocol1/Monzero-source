+    /// Preparation approval is not approval to retain a signature or send a
+    /// signed release. Each operation has its own public review commitment.
+    pub fn review_bch_success_signature_retention(&self,deployment: &[u8;32],safety_blocks: u32,now: u64)
+        -> Result<SuccessReleaseReview> {
+        let saved=self.saved_bch_success_preparation(deployment,safety_blocks,now)?;
+        ensure!(saved.prepared_at.is_some(),"missing BCH success signing preparation");
+        success_action_review(saved.review,"retain-bch-success-signature")
+    }
+    pub fn review_signed_bch_success_release(&self,deployment: &[u8;32],safety_blocks: u32,now: u64)
+        -> Result<SuccessReleaseReview> {
+        let saved=self.saved_bch_success_preparation(deployment,safety_blocks,now)?;
+        ensure!(saved.signature_retained,"missing signed BCH success release");
+        success_action_review(saved.review,"release-signed-bch-success")
+    }
+    pub async fn retain_reviewed_bch_success_signature(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64,frame: &[u8],signature: &[u8],approved: &[u8;32]) -> Result<SignedSuccess> {
+        let review=self.review_bch_success_signature_retention(&bch.deployment_commitment()?,safety_blocks,now)?;
+        ensure!(review.commitment==*approved,"BCH success signature consent changed");
+        self.retain_bch_success_signature(native,bch,safety_blocks,now,frame,signature).await
+    }
+    /// Every retry still observes both chains; retained state is not permission
+    /// to expose a previously signed adaptor to the peer.
+    pub async fn recover_reviewed_bch_success_release(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        safety_blocks: u32,now: u64,approved: &[u8;32]) -> Result<SignedSuccess> {
+        let review=self.review_signed_bch_success_release(&bch.deployment_commitment()?,safety_blocks,now)?;
+        ensure!(review.commitment==*approved,"signed BCH success release consent changed");
+        self.recover_bch_success_release(native,bch,safety_blocks,now).await
+    }
+
 }
+
+fn success_action_review(mut review: SuccessReleaseReview,action: &str) -> Result<SuccessReleaseReview> {
+    review.details["action"]=json!(action);
+    review.commitment=hash(REVIEW,&serde_json::to_vec(&review.details)?);
+    Ok(review)
+}
