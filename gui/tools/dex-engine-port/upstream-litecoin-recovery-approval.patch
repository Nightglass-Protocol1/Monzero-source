+    /// Read-only reconciliation of an exact retained contract spend. Absence
+    /// grants no send authority; callers must still run timelock preflight.
+    pub(crate) async fn contract_spend_in_mempool(&self,transaction:&Transaction)->Result<bool> {
+        let before=self.chain().await?;
+        let txid=transaction.compute_txid();
+        let entry=self.rpc_lookup(false,"getmempoolentry",json!([txid.to_string()]),true).await?;
+        let found=if let Some(entry)=entry {
+            let entry:Value=serde_json::from_str(entry.get())?;
+            ensure!(entry["vsize"].as_u64()==Some(transaction.vsize() as u64)
+                && entry["weight"].as_u64()==Some(transaction.weight().to_wu()),"recovery mempool size differs");
+            let raw:String=serde_json::from_str(self.rpc(false,"getrawtransaction",json!([txid.to_string(),false])).await?.get())?;
+            ensure!(raw==serialize_hex(transaction),"mempool recovery differs from retained signed bytes");
+            true
+        } else {false};
+        ensure!(self.chain().await?==before,"Litecoin chain changed during recovery reconciliation");
+        Ok(found)
+    }
