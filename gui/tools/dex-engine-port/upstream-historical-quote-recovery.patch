+/// Historical signed terms for recovery inspection, deliberately not a
+/// VerifiedQuote accepted by new-negotiation entry points. Does not prove user
+/// approval, checkpoint integrity, chain state, or permission to spend.
+///
+/// ```compile_fail
+/// use swap_machine::{native_trade_quote::{RecordedQuote, DeploymentPolicy}, native_negotiation::Transcript};
+/// fn cannot_start(terms: &RecordedQuote, policy: &DeploymentPolicy) {
+///     let _ = Transcript::new(terms, policy, 0);
+/// }
+/// ```
+pub struct RecordedQuote { quote: VerifiedQuote }
+
+impl RecordedQuote {
+    /// Pins, policy and expected commitment must come from trusted retained swap
+    /// context, not from this record. acceptedAt is local metadata, not a signed
+    /// timestamp; checking it does not establish that GUI approval succeeded.
+    pub fn from_gui_reservation(
+        bytes: &[u8], now: u64, btc_key: &[u8;32], xmz_key: &[u8;32],
+        btc_network: Network, xmz_network: XmzNetwork,
+        policy: &DeploymentPolicy, expected_commitment: &[u8;32],
+    ) -> Result<Self> {
+        let (quote,accepted)=VerifiedQuote::decode_reservation(bytes,now,btc_key,xmz_key,btc_network,xmz_network)?;
+        ensure!(quote.commitment()==expected_commitment,"unexpected historical quote commitment");
+        quote.check_deployment(policy,accepted)?;
+        Ok(Self {quote})
+    }
+    pub fn terms(&self) -> &BTreeMap<String,String> { self.quote.terms() }
+    pub fn commitment(&self) -> &[u8;32] { self.quote.commitment() }
+    pub fn destinations(&self) -> &QuoteDestinations { self.quote.destinations() }
+}
