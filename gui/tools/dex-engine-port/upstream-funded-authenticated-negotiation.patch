diff --git a/swap-machine/tests/quote_fixture.rs b/swap-machine/tests/quote_fixture.rs
index caa5dea59..872d6c2f0 100644
--- a/swap-machine/tests/quote_fixture.rs
+++ b/swap-machine/tests/quote_fixture.rs
@@ -7,6 +7,50 @@ use std::{io::Write, os::unix::fs::DirBuilderExt, path::PathBuf, process::{Comma
 use swap_machine::native_trade_quote::{DeploymentPolicy, VerifiedQuote};
 use swap_env::env::{GetConfig, Regtest};
 use uuid::Uuid;
+pub use swap_machine::native_negotiation::Message;
+
+/// Private test transport adapter; transcript state is deliberately not a
+/// production restart record. Never expose frames containing view-key shares.
+pub struct Negotiation {
+    transcript: Option<swap_machine::native_negotiation::Transcript>,
+    btc_sender: bool,
+}
+impl Negotiation {
+    pub fn new(context: Option<&Value>, swap: Uuid, btc_sender: bool) -> Result<Self> {
+        let transcript=match context {
+            Some(context)=>Some(swap_machine::native_negotiation::Transcript::new(&read(context,swap)?,&policy(),now()?)?),
+            None=>None,
+        };
+        Ok(Self {transcript,btc_sender})
+    }
+    pub fn encode(&mut self, message: Message) -> Result<Value> {
+        let Some(transcript)=&mut self.transcript else { return Ok(serde_json::to_value(message)?); };
+        let frame=transcript.prepare(message)?;
+        let key=SigningKey::from_bytes(&[if self.btc_sender {1} else {2};32]);
+        let signature=key.sign(&swap_machine::native_negotiation::signing_bytes(&frame)?).to_bytes();
+        transcript.accept(&frame,&signature)?;
+        Ok(json!({"frame":frame,"signature":signature.to_vec()}))
+    }
+    pub fn decode(&mut self, value: Value) -> Result<Message> {
+        let Some(transcript)=&mut self.transcript else { return Ok(serde_json::from_value(value)?); };
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Signed { frame: Vec<u8>, signature: Vec<u8> }
+        let signed:Signed=serde_json::from_value(value)?;
+        // Exercise rejection without advancing the cursor on each received
+        // frame in the funded fixture, then accept the original signature.
+        ensure!(signed.signature.len()==64,"invalid fixture signature length");
+        let mut damaged=signed.signature.clone(); damaged[0]^=1;
+        ensure!(transcript.accept(&signed.frame,&damaged).is_err(),"accepted damaged fixture signature");
+        transcript.accept(&signed.frame,&signed.signature)
+    }
+    pub fn completed(&self) -> Result<Option<[u8;32]>> {
+        match &self.transcript {
+            Some(t)=>Ok(Some(t.completed_commitment().context("incomplete fixture transcript")?)),
+            None=>Ok(None),
+        }
+    }
+}
 
 pub fn now() -> Result<u64> {
     Ok(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs())
