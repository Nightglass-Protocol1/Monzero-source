+//! Unsigned native-BCH funding review. Previous transaction bytes bind input
+//! amounts/scripts, but are not proof of chain membership, maturity, wallet
+//! ownership or availability. No signature, reservation or relay is performed.
+use anyhow::{Context,Result,ensure};
+use bitcoin::{absolute,consensus::{deserialize,serialize},transaction::Version,
+    Amount,Script,Transaction,TxOut,Sequence};
+use std::collections::HashSet;
+use super::covenant::{Covenant,supported_destination};
+
+const MAX_MONEY: u64 = 2_100_000_000_000_000;
+const MAX_BYTES: usize = 2_000_000;
+
+/// Immutable reviewed template. Its transaction ID is provisional: BCH legacy
+/// input signatures change it. Never use the unsigned ID for a recovery spend.
+pub struct FundingPreview { transaction: Transaction, previous_outputs: Vec<TxOut>, fee: Amount, lock_vout: u32 }
+impl FundingPreview {
+    pub fn transaction(&self) -> &Transaction { &self.transaction }
+    pub fn previous_outputs(&self) -> &[TxOut] { &self.previous_outputs }
+    pub fn fee(&self) -> Amount { self.fee }
+    pub fn lock_vout(&self) -> u32 { self.lock_vout }
+
+    /// Sources must be full canonical previous transactions in input order.
+    /// The caller supplies a wallet-owned change script and explicit fee/dust
+    /// policy; source bytes alone cannot prove ownership or live spendability.
+    pub fn verify(raw: &[u8], sources: &[&[u8]], covenant: &Covenant, locked_atoms: u64,
+        change: &Script, maximum_fee: u64, minimum_change: u64) -> Result<Self> {
+        ensure!(locked_atoms > 0 && locked_atoms <= MAX_MONEY && maximum_fee > 0
+            && maximum_fee <= MAX_MONEY && minimum_change > 0 && minimum_change <= MAX_MONEY,
+            "invalid BCH funding amount policy");
+        let lock = covenant.script_pubkey();
+        ensure!(supported_destination(change) && change != lock.as_script(),"invalid BCH funding change destination");
+        let transaction = decode(raw)?;
+        ensure!(transaction.version == Version::TWO && transaction.lock_time == absolute::LockTime::ZERO
+            && !transaction.input.is_empty() && transaction.input.len() <= 128
+            && sources.len() == transaction.input.len() && (1..=2).contains(&transaction.output.len()),
+            "unexpected BCH funding template shape");
+        let source_bytes = sources.iter().try_fold(0usize,|sum,source|sum.checked_add(source.len()))
+            .context("BCH funding source size overflow")?;
+        ensure!(source_bytes <= 8_000_000,"oversized BCH funding source bundle");
+        let mut seen = HashSet::new(); let mut previous_outputs = Vec::new(); let mut input_total = 0u64;
+        for (input,source) in transaction.input.iter().zip(sources) {
+            ensure!(!input.previous_output.is_null() && seen.insert(input.previous_output)
+                && input.sequence == Sequence::MAX && input.script_sig.is_empty() && input.witness.is_empty(),
+                "duplicate, nonfinal or signed BCH funding input");
+            let parent = decode(source)?;
+            ensure!(parent.compute_txid() == input.previous_output.txid,"BCH input source transaction mismatch");
+            let output = parent.output.get(input.previous_output.vout as usize).context("missing BCH funding source output")?;
+            ensure!(output.value > Amount::ZERO && supported_destination(&output.script_pubkey),
+                "unsupported BCH funding source output");
+            input_total = input_total.checked_add(output.value.to_sat()).context("BCH funding input total overflow")?;
+            ensure!(input_total <= MAX_MONEY,"BCH funding inputs exceed monetary range");
+            previous_outputs.push(output.clone());
+        }
+        let locks: Vec<_> = transaction.output.iter().enumerate().filter(|(_,o)|o.script_pubkey == lock).collect();
+        ensure!(locks.len() == 1 && locks[0].1.value.to_sat() == locked_atoms,"BCH funding contract or principal mismatch");
+        let lock_vout = locks[0].0 as u32;
+        for (index,output) in transaction.output.iter().enumerate() {
+            if index != lock_vout as usize {
+                ensure!(output.script_pubkey.as_script() == change && output.value.to_sat() >= minimum_change,
+                    "BCH funding change differs from wallet policy");
+            }
+        }
+        let output_total = total(&transaction)?;
+        let fee = input_total.checked_sub(output_total).context("BCH funding creates value")?;
+        ensure!(fee > 0 && fee <= maximum_fee,"BCH funding fee exceeds reviewed cap or is zero");
+        Ok(Self {transaction,previous_outputs,fee:Amount::from_sat(fee),lock_vout})
+    }
+}
+fn total(tx: &Transaction) -> Result<u64> {
+    let sum = tx.output.iter().try_fold(0u64,|sum,o|sum.checked_add(o.value.to_sat()))
+        .context("BCH transaction output total overflow")?;
+    ensure!(sum <= MAX_MONEY,"BCH transaction exceeds monetary range");
+    Ok(sum)
+}
+fn decode(raw: &[u8]) -> Result<Transaction> {
+    ensure!(!raw.is_empty() && raw.len() <= MAX_BYTES,"invalid BCH funding transaction size");
+    let tx: Transaction = deserialize(raw).context("invalid BCH funding transaction encoding")?;
+    ensure!(serialize(&tx) == raw && !tx.input.is_empty() && !tx.output.is_empty()
+        && tx.input.iter().all(|i|i.witness.is_empty()),"noncanonical or witness BCH transaction");
+    ensure!(tx.output.iter().all(|o|o.script_pubkey.as_bytes().first() != Some(&0xef)),
+        "CashToken-bearing sources/funding are unsupported for native BCH swaps");
+    total(&tx)?;
+    Ok(tx)
+}
+
