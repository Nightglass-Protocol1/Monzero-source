+#[test]
+fn retained_peer_views_restore_and_finish_both_roles() -> Result<()> {
+    use super::super::local_keys::{RetainedLocalKeys,peer::RetainedPeer};
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let mut pins = Vec::new();
+    for (index,role) in [(0,Role::BchFunder),(1,Role::NativeFunder)] {
+        let local = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,role,
+            bitcoin::secp256k1::SecretKey::from_slice(&[3+index as u8;32])?,setup.spend[index],setup.view[index],
+            &setup.frames[index],&setup.signatures[index])?;
+        let local_pin = *local.commitment();
+        let selected = local.select_peer(&directory.0,&setup.quote,&setup.policy,1001,
+            &setup.frames[1-index],&setup.signatures[1-index])?;
+        let signer = SigningKey::from_bytes(&[1+index as u8;32]);
+        let signature = signer.sign(&selected.view_signing_bytes(&setup.quote,&setup.policy,1002)?).to_bytes();
+        let message = selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,&signature)?;
+        assert_eq!(selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,&signature)?.commitment(),message.commitment());
+        assert!(selected.view_signing_bytes(&setup.quote,&setup.policy,1000).is_err());
+        assert!(selected.view_signing_bytes(&setup.quote,&setup.policy,2000).is_err());
+        assert!(selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,2000,&signature).is_err());
+        pins.push((local_pin,*selected.commitment(),*message.commitment()));
+    }
+    let restore = |index: usize,role| -> Result<RetainedPeer> {
+        let local = RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,role,&pins[index].0)?;
+        RetainedPeer::restore(&directory.0,&setup.quote,&setup.policy,local,&pins[index].1)
+    };
+    let b = restore(0,Role::BchFunder)?; let n = restore(1,Role::NativeFunder)?;
+    let bv = b.restore_signed_view(&directory.0,&setup.quote,&setup.policy,&pins[0].2)?;
+    let nv = n.restore_signed_view(&directory.0,&setup.quote,&setup.policy,&pins[1].2)?;
+    assert!(restore(0,Role::BchFunder)?.finish(&setup.quote,&setup.policy,1001,&bv,nv.frame(),nv.signature()).is_err());
+    let b = b.finish(&setup.quote,&setup.policy,1003,&bv,nv.frame(),nv.signature())?;
+    let n = n.finish(&setup.quote,&setup.policy,1003,&nv,bv.frame(),bv.signature())?;
+    assert_eq!(b.wallet().address(),n.wallet().address());
+    assert_eq!(b.acknowledgement(&setup.quote)?,n.acknowledgement(&setup.quote)?);
+    for owned in [b,n] {
+        let ack = owned.acknowledgement(&setup.quote)?;
+        owned.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+    }
+    Ok(())
+}
