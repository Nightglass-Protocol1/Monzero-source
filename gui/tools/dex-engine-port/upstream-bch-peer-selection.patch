+fn retained_peer_rejects_switches_wrong_signers_and_missing_records() -> Result<()> {
+    use super::super::local_keys::{RetainedLocalKeys,peer::RetainedPeer};
+    let mut setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let local = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,Role::BchFunder,
+        bitcoin::secp256k1::SecretKey::from_slice(&[3;32])?,setup.spend[0],setup.view[0],&setup.frames[0],&setup.signatures[0])?;
+    let local_pin = *local.commitment();
+    let load = || RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&local_pin);
+    let other_directory = PrivateStore::new()?;
+    assert!(load()?.select_peer(&other_directory.0,&setup.quote,&setup.policy,1001,&setup.frames[1],&setup.signatures[1]).is_err());
+    assert!(load()?.select_peer(&directory.0,&setup.quote,&setup.policy,999,&setup.frames[1],&setup.signatures[1]).is_err());
+    assert!(load()?.select_peer(&directory.0,&setup.quote,&setup.policy,1001,&setup.frames[0],&setup.signatures[0]).is_err());
+    let selected = local.select_peer(&directory.0,&setup.quote,&setup.policy,1001,&setup.frames[1],&setup.signatures[1])?;
+    let pin = *selected.commitment();
+    let signing = selected.view_signing_bytes(&setup.quote,&setup.policy,1002)?;
+    assert!(selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,
+        &SigningKey::from_bytes(&[2;32]).sign(&signing).to_bytes()).is_err());
+    let signature = SigningKey::from_bytes(&[1;32]).sign(&signing).to_bytes();
+    let message = selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,&signature)?;
+    let mut wrong = *message.commitment(); wrong[0] ^= 1;
+    assert!(selected.restore_signed_view(&directory.0,&setup.quote,&setup.policy,&wrong).is_err());
+    // A new valid proof by the same peer cannot replace the selected proof.
+    let scalar = curve25519_dalek_ng::scalar::Scalar::from_canonical_bytes(setup.spend[1].as_bytes()).unwrap();
+    let (proof,(secp,edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&scalar,&mut rand::thread_rng());
+    setup.frames[1] = super::super::frame(&setup.quote,Role::NativeFunder,secp.into(),edwards.compress().to_bytes(),proof)?;
+    setup.signatures[1] = sign(&setup.frames[1],Role::NativeFunder,false);
+    assert!(load()?.select_peer(&directory.0,&setup.quote,&setup.policy,1001,&setup.frames[1],&setup.signatures[1]).is_err());
+    let restored = RetainedPeer::restore(&directory.0,&setup.quote,&setup.policy,load()?,&pin)?;
+    assert_eq!(restored.restore_signed_view(&directory.0,&setup.quote,&setup.policy,message.commitment())?.frame(),message.frame());
+    let path = std::fs::read_dir(&directory.0)?.map(|e|e.unwrap().path())
+        .find(|p|p.file_name().unwrap().to_string_lossy().contains("peer-selection")).unwrap();
+    std::fs::write(&path,b"{")?;
+    assert!(RetainedPeer::restore(&directory.0,&setup.quote,&setup.policy,load()?,&pin).is_err());
+    assert!(selected.retain_signed_view(&directory.0,&setup.quote,&setup.policy,1002,&signature).is_err());
+    std::fs::remove_file(path)?;
+    assert!(RetainedPeer::restore(&directory.0,&setup.quote,&setup.policy,load()?,&pin).is_err());
+    Ok(())
+}
