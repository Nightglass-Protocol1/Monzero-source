+//! Actual native wallet preparation and approved retained relay after BCH handoff.
+use super::*;
+use crate::native_funding_rpc::{NativeFundingRpc,relay::NativeTransferRelay};
+use agreement::execution::funding::{native::{NativeFundingSource,relay::NativeRelayState,proof}};
+pub(super) async fn exercise(config: &Value,setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    bch: &BchRpc,native: &mut AdmittedExecution<'_>,sender: &mut AdmittedExecution<'_>,
+    event: &std::path::Path,gate: &std::path::Path,bch_txid: Txid,now: u64) -> Result<()> {
+    let field=|name: &str| -> Result<&str> {config[name].as_str().context("missing native fixture field")};
+    let backend=||NativeFundingRpc::new(u16::try_from(config["daemonPort"].as_u64().context("daemon port")?)?,
+        u16::try_from(config["walletPort"].as_u64().context("wallet port")?)?,field("username")?.into(),field("password")?.into());
+    let observer_backend=||NativeFundingRpc::new(u16::try_from(config["daemonPort"].as_u64().context("daemon port")?)?,
+        u16::try_from(config["observerPort"].as_u64().context("observer port")?)?,field("observerUsername")?.into(),field("observerPassword")?.into());
+    let agreement=native.restore_agreement()?;let keys=agreement.owned().wallet();
+    let mut session=crate::native_funding_rpc::wallet_session::NativeWalletSession::new(observer_backend()?,setup.policy.xmz_network);
+    session.restore_view(&crate::native_funding_rpc::wallet_session::SwapWalletId::new(setup.quote.terms()["swapId"].parse()?)?,
+        hex(&keys.private_view_key().0.as_bytes()),0,"owned-fixture-watch-wallet".into(),keys.address()).await?;
+    drop(session);drop(agreement);
+    let mut relay=NativeTransferRelay::new(backend()?);
+    let source=NativeFundingSource {wallet:XmzAddress::parse(setup.policy.xmz_network,field("source")?)?,account:0,priority:1};
+    let prepared=native.prepare_bch_native_funding(&mut relay,bch,source,5,now).await?;
+    ensure!(prepared.fee.atoms()>0 && prepared.fee.atoms()<=10_000_000_000,"native fee exceeds quote");
+    let review=native.review_bch_native_relay(bch,now+1)?;
+    assert!(native.relay_bch_native_funding(&mut relay,bch,&[0;32],now+2).await.is_err());
+    let sent=native.relay_bch_native_funding(&mut relay,bch,&review.commitment,now+2).await?;
+    assert_eq!(sent.txid,prepared.txid);assert_eq!(sent.fee,prepared.fee);
+    let before=contents(&metadata.0)?;
+    assert_eq!(native.relay_bch_native_funding(&mut relay,bch,&review.commitment,now+3).await?.txid,sent.txid);
+    assert_eq!(contents(&metadata.0)?,before);
+    let frame=native.prepare_bch_native_proof(now+4)?;
+    let signature=SigningKey::from_bytes(&[2;32]).sign(&proof::signing_bytes(&frame)?).to_bytes();
+    native.retain_outgoing_bch_native_proof(now+5,&signature)?;
+    sender.accept_bch_native_proof(now+6,&frame,&signature)?;
+    let observer=observer_backend()?;
+    assert!(sender.observe_bch_native_payment(&observer).await.is_err());
+    let pending=event.with_extension("pending");
+    save(&pending,&serde_json::to_vec(&json!({"phase":"native-funded","txid":bch_txid.to_string(),
+        "nativeTxid":sent.txid,"nativeFeeAtoms":sent.fee.atoms(),"nativeAmountAtoms":200_000_000_000u64}))?)?;
+    std::fs::rename(&pending,event)?;
+    tokio::time::timeout(std::time::Duration::from_secs(120),async {
+        loop {
+            if std::fs::read(gate).is_ok_and(|v|v==b"native-confirmed") {return;}
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+    }).await.context("native confirmation fixture timed out")?;
+    let confirmed=sender.observe_bch_native_payment(&observer).await?;
+    assert_eq!(confirmed.quote(),setup.quote.commitment());
+    assert!(matches!(native.bch_native_relay_state()?,Some(NativeRelayState::Acknowledged {..})));
+    assert!(native.recover_bch_native_funding()?.txid==prepared.txid);
+    // Keep the private snapshot directory live through the final observation.
+    assert!(!contents(&snapshots.0)?.is_empty());
+    Ok(())
+}
