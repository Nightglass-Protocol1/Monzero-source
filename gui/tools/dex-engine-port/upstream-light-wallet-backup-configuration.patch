+use super::*;
+use crate::litecoin_light::{account::{Branch,allocation::AddressBook},network::{BtcNetwork,BchNetwork,DogeNetwork},
+    vault::mnemonic::{MnemonicMaterial,storage::MnemonicVault}};
+use std::{fs,path::PathBuf,os::unix::fs::PermissionsExt};
+const PASSWORD:&[u8]=b"disposable configured restore password";
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {
+    let p=std::env::temp_dir().join(format!("monzero-configured-restore-{}",Uuid::new_v4()));
+    fs::create_dir(&p)?;fs::set_permissions(&p,fs::Permissions::from_mode(0o700))?;Ok(Self(p.canonicalize()?))
+}}
+impl Drop for Directory {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
+#[test]
+fn restored_configuration_is_review_bound_and_resumes_each_publication_stage()->Result<()> {
+    for (index,network) in [LightNetwork::from(LtcNetwork::Regtest),BtcNetwork::Regtest.into(),BchNetwork::Regtest.into(),DogeNetwork::Regtest.into()].into_iter().enumerate() {
+        for mnemonic in [false,true] {
+            let original_vault=Directory::new()?;let original_book=Directory::new()?;
+            let wallet=Uuid::new_v4();
+            let bundle=if mnemonic {
+                let material=MnemonicMaterial::from_entropy(&[19;32])?;
+                let vault=MnemonicVault::create(&original_vault.0,network,wallet,PASSWORD,&material,"separate passphrase")?;
+                let mut book=AddressBook::create(&original_book.0,vault.unlock(PASSWORD)?.public_account(network,2)?)?;
+                book.reserve(Uuid::new_v4(),Branch::Receive)?;mnemonic_backup::export(&vault,&book,PASSWORD)?
+            } else {
+                let seed=SecretSeed::from_bytes(Zeroizing::new([20;32]));
+                let vault=SeedVault::create(&original_vault.0,network,wallet,PASSWORD,&seed)?;
+                let mut book=AddressBook::create(&original_book.0,seed.public_account(network,2)?)?;
+                book.reserve(Uuid::new_v4(),Branch::Receive)?;super::super::super::export(&vault,&book,PASSWORD)?
+            };
+            let backup=inspect(&bundle,PASSWORD,network)?;
+            let setup=Directory::new()?;let vault=Directory::new()?;let addresses=Directory::new()?;let cache=Directory::new()?;let spends=Directory::new()?;
+            let endpoint=TlsEndpoint::new("localhost".into(),50002,network)?;
+            let mut options=RestoreOptions {setup:&setup.0,vault:&vault.0,addresses:&addresses.0,cache:&cache.0,
+                spends:&spends.0,maximum_height:1000,endpoint:Some(&endpoint)};
+            let review=backup.configuration_review(&options)?;
+            let approved=sha256::Hash::hash(&serde_json::to_vec(&review)?);
+            assert!(!setup.0.join(INTENT).exists());
+            assert!(backup.restore_configuration(&options,b"wrong",approved).is_err());
+            assert!(backup.restore_configuration(&options,PASSWORD,sha256::Hash::hash(b"wrong")).is_err());
+            options.maximum_height=999;assert!(backup.restore_configuration(&options,PASSWORD,approved).is_err());options.maximum_height=1000;
+            assert!(!setup.0.join(INTENT).exists());assert!(!vault.0.join("litecoin-seed.vault").exists());
+            fs::write(spends.0.join("occupied"),b"retained trade data")?;
+            assert!(backup.restore_configuration(&options,PASSWORD,approved).is_err());fs::remove_file(spends.0.join("occupied"))?;
+            let stage=[Stage::Intent,Stage::Records,Stage::Configuration,Stage::Complete][index];
+            assert!(backup.restore_configuration_with(&options,PASSWORD,approved,|seen| {
+                ensure!(seen!=stage,"injected restore interruption");Ok(())
+            }).is_err());
+            let completed=backup.restore_configuration(&options,PASSWORD,approved)?;
+            assert_eq!(completed["allocated"],json!([1,0]));assert_eq!(completed["activeSwapRecovery"],false);
+            assert_eq!(completed["tradingEnabled"],false);
+            let encrypted=fs::read(vault.0.join("litecoin-seed.vault"))?;
+            let config=fs::read(setup.0.join(CONFIG))?;
+            assert_eq!(serde_json::from_slice::<Value>(&config)?,review["configuration"]);
+            assert_eq!(backup.restore_configuration(&options,PASSWORD,approved)?,completed);
+            assert_eq!(fs::read(vault.0.join("litecoin-seed.vault"))?,encrypted);
+            let mut book=AddressBook::open(&addresses.0,PublicAccount::from_descriptor(backup.account(),network)?)?;
+            book.reserve(Uuid::new_v4(),Branch::Change)?;drop(book);
+            let advanced=fs::read(addresses.0.join("litecoin-address-book.json"))?;
+            assert!(backup.restore_configuration(&options,PASSWORD,approved).is_err());
+            assert_eq!(fs::read(addresses.0.join("litecoin-address-book.json"))?,advanced);
+            assert_eq!(fs::read(setup.0.join(CONFIG))?,config);
+            assert_eq!(fs::read(original_vault.0.join("litecoin-seed.vault"))?,encrypted);
+        }
+    }
+    Ok(())
+}
