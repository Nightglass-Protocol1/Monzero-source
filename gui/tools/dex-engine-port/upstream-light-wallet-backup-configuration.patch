+// Authenticated encrypted-backup recovery into explicitly selected local folders.
+use super::*;
+use swap_machine::litecoin_light::vault::backup::discovery::{load,configuration::RestoreOptions};
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct Settings {
+    schema:String,network:String,backup_directory:PathBuf,setup_directory:PathBuf,
+    vault_directory:PathBuf,address_book_directory:PathBuf,cache_directory:PathBuf,spend_directory:PathBuf,
+    maximum_height:u32,endpoint:Option<Endpoint>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields,rename_all="camelCase")]
+struct Import {
+    schema:String,request_id:uuid::Uuid,approved_config_digest:String,password:Password,
+    approved_review:Option<String>,restore_approved:Option<bool>,
+}
+pub(super) fn run(path:&Path,commit:bool)->Result<()> {
+    let mode=if commit {"wallet-backup-import"} else {"wallet-backup-preview"};
+    let mut input=Zeroizing::new(Vec::with_capacity(8193));
+    std::io::stdin().take(8193).read_to_end(&mut input)?;
+    ensure!(!input.is_empty() && input.len()<=8192,"invalid backup import request size");
+    let request:Import=serde_json::from_slice(&input)?;
+    let tag=["ltc","btc","bch","doge"].into_iter()
+        .find(|tag|request.schema==format!("monzero-{tag}-light-{mode}-request-v1"))
+        .context("invalid backup import schema")?;
+    ensure!(!request.request_id.is_nil(),"invalid backup import request identity");
+    if commit {ensure!(request.restore_approved==Some(true) && request.approved_review.is_some(),"missing restore approval");}
+    else {ensure!(request.restore_approved.is_none() && request.approved_review.is_none(),"unexpected restore approval in preview");}
+    let (_lease,bytes)=private_config(path)?;
+    let approved:sha256::Hash=request.approved_config_digest.parse()?;
+    ensure!(approved.to_string()==request.approved_config_digest && sha256::Hash::hash(&bytes)==approved,
+        "backup recovery settings differ from approval");
+    let settings:Settings=serde_json::from_slice(&bytes)?;
+    ensure!(settings.schema==format!("monzero-private-{tag}-backup-setup-v1"),"invalid backup recovery settings schema");
+    let network=network_for(tag,&settings.network)?;
+    let endpoint=settings.endpoint.map(|e|TlsEndpoint::new(e.host,e.port,network)).transpose()?;
+    let options=RestoreOptions {setup:&settings.setup_directory,vault:&settings.vault_directory,
+        addresses:&settings.address_book_directory,cache:&settings.cache_directory,spends:&settings.spend_directory,
+        maximum_height:settings.maximum_height,endpoint:endpoint.as_ref()};
+    let backup=load(&settings.backup_directory,request.password.0.as_bytes(),network)?;
+    let review=backup.configuration_review(&options)?;
+    let commitment=sha256::Hash::hash(&serde_json::to_vec(&review)?);
+    if commit {
+        let expected=request.approved_review.context("missing reviewed backup")?;
+        ensure!(expected==commitment.to_string(),"backup review differs from restore approval");
+        let restored=backup.restore_configuration(&options,request.password.0.as_bytes(),commitment)?;
+        output(&json!({"schema":format!("monzero-{tag}-light-{mode}-response-v1"),"requestId":request.request_id,
+            "restoration":restored,"executable":false}))
+    } else {
+        output(&json!({"schema":format!("monzero-{tag}-light-{mode}-response-v1"),"requestId":request.request_id,
+            "configurationDigest":approved,"review":review,"reviewDigest":commitment,"executable":false}))
+    }
+}
