+//! Reviewed, resumable publication of settings for a restored local wallet.
+//! No server contact, key generation, backup replacement or trade activation.
+use super::*;
+use crate::litecoin_light::tls::TlsEndpoint;
+use serde_json::{Value,json};
+const INTENT:&str="litecoin-backup-restore-intent.json";
+const CONFIG:&str="litecoin-wallet-restored.json";
+const COMPLETE:&str="litecoin-backup-restore-complete.json";
+
+pub struct RestoreOptions<'a> {
+    pub setup:&'a Path,
+    pub vault:&'a Path,
+    pub addresses:&'a Path,
+    pub cache:&'a Path,
+    pub spends:&'a Path,
+    pub maximum_height:u32,
+    pub endpoint:Option<&'a TlsEndpoint>,
+}
+impl RestoreOptions<'_> {
+    fn validate(&self,network:LightNetwork)->Result<()> {
+        ensure!(self.maximum_height<=10_000_000 && self.endpoint.is_none_or(|e|e.network()==network),
+            "invalid backup restoration network settings");
+        let directories=[self.setup,self.vault,self.addresses,self.cache,self.spends];
+        for (i,path) in directories.iter().enumerate() {
+            ensure!(directories[..i].iter().all(|other|!path.starts_with(other) && !other.starts_with(path)),
+                "backup restoration directories must be separate");
+            drop(Journal::open(path)?);
+        }
+        Ok(())
+    }
+}
+impl InspectedBackup {
+    /// Public review only. Directory validation takes temporary leases but does
+    /// not write records. The commitment includes the complete future config.
+    pub fn configuration_review(&self,options:&RestoreOptions<'_>)->Result<Value> {
+        options.validate(self.network)?;
+        let mut config=json!({"schema":format!("monzero-private-{}-light-v1",self.network.tag()),
+            "network":self.network.name(),"cacheDirectory":options.cache,"maximumHeight":options.maximum_height,
+            "wallet":{"account":self.account,"addressBookDirectory":options.addresses,"spendDirectory":options.spends,
+                "vault":{"directory":options.vault,"walletId":self.wallet,"seedEncoding":self.format.encoding()}}});
+        if let Some(endpoint)=options.endpoint {
+            config["endpoint"]=json!({"host":endpoint.host(),"port":endpoint.port()});
+        }
+        let review=json!({"schema":"monzero-light-backup-restore-review-v1","coin":self.network.tag(),
+            "network":self.network.name(),"walletId":self.wallet,"backupDigest":self.digest,
+            "seedEncoding":self.format.encoding(),"allocated":self.allocated,
+            "configurationFile":options.setup.join(CONFIG),"configuration":config,
+            "scope":"seed-and-address-allocations","allocationFreshness":"unassessed",
+            "historyCompleteness":"unproven","activeSwapRecovery":false,"tradingEnabled":false});
+        ensure!(serde_json::to_vec(&review)?.len()<=8192,"oversized backup restoration review");
+        Ok(review)
+    }
+    /// Fresh password and explicit review commitment are required even on retry.
+    /// Consumers must require the completion receipt before automatic reopening.
+    /// An old receipt is historical, not proof that today's allocations are backed up.
+    pub fn restore_configuration(&self,options:&RestoreOptions<'_>,password:&[u8],approved:sha256::Hash)->Result<Value> {
+        self.restore_configuration_with(options,password,approved,|_|Ok(()))
+    }
+    fn restore_configuration_with(&self,options:&RestoreOptions<'_>,password:&[u8],approved:sha256::Hash,
+        checkpoint:impl Fn(Stage)->Result<()>)->Result<Value> {
+        let review=self.configuration_review(options)?;
+        let intent=serde_json::to_vec(&review)?;
+        ensure!(sha256::Hash::hash(&intent)==approved,"backup restoration review differs from approval");
+        // Authenticate before retaining even the public intent.
+        drop(inspect(&self.encrypted,password,self.network)?);
+        let journal=Journal::open(options.setup)?;
+        let resume=match journal.read(INTENT) {
+            Ok(existing)=>{ensure!(existing==intent,"backup restoration intent differs");true},
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>false,
+            Err(error)=>return Err(error),
+        };
+        if !resume {
+            ensure!(std::fs::read_dir(options.setup)?.next().is_none(),"restore setup directory is occupied");
+            for path in [options.vault,options.addresses] {
+                let _lease=Journal::open(path)?;
+                ensure!(std::fs::read_dir(path)?.next().is_none(),"restore wallet directory is occupied");
+            }
+        }
+        // These backups contain neither cached observations nor spend journals.
+        let _cache=Journal::open(options.cache)?;let _spends=Journal::open(options.spends)?;
+        for path in [options.cache,options.spends] {
+            ensure!(std::fs::read_dir(path)?.next().is_none(),"restore auxiliary directory is occupied");
+        }
+        let config=serde_json::to_vec(&review["configuration"])?;
+        let completed=json!({"schema":"monzero-light-backup-restore-complete-v1","reviewDigest":approved,
+            "backupDigest":self.digest,"configurationFile":options.setup.join(CONFIG),
+            "configurationDigest":sha256::Hash::hash(&config),"walletId":self.wallet,"coin":self.network.tag(),
+            "network":self.network.name(),"allocated":self.allocated,"restored":true,
+            "allocationFreshness":"unassessed","historyCompleteness":"unproven",
+            "activeSwapRecovery":false,"tradingEnabled":false});
+        let receipt=serde_json::to_vec(&completed)?;
+        journal.compatible(CONFIG,&config)?;journal.compatible(COMPLETE,&receipt)?;
+        journal.retain(INTENT,&intent)?;checkpoint(Stage::Intent)?;
+        self.restore_into(options.vault,options.addresses,password)?;checkpoint(Stage::Records)?;
+        journal.retain(CONFIG,&config)?;checkpoint(Stage::Configuration)?;
+        journal.retain(COMPLETE,&receipt)?;checkpoint(Stage::Complete)?;
+        ensure!(journal.read(CONFIG)?==config && journal.read(COMPLETE)?==receipt,"restore configuration read-back mismatch");
+        Ok(completed)
+    }
+}
+#[derive(Clone,Copy,PartialEq,Eq)]
+enum Stage {Intent,Records,Configuration,Complete}
+#[cfg(test)]
+mod tests;
