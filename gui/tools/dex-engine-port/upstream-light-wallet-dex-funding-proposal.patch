+use anyhow::Result;
+use crate::litecoin_negotiation::{execution::Execution,LocalRole};
+use crate::litecoin_light::{headers::HeaderSequence,accounting::ObservedWallet};
+use bitcoin::hashes::{Hash,sha256};
+use std::path::Path;
+use crate::litecoin_light::{MerkleMatch,transaction::IncludedTransaction,account::Branch,
+    vault::{SecretSeed,signing::review::confirmed::{ConfirmedSpendReview,IncludedInput}}};
+use bitcoin::{Amount,Transaction,TxIn,TxOut,OutPoint,Txid,Sequence,absolute::LockTime,transaction::Version};
+use ed25519_dalek::{SigningKey,Signer};
+use rand::SeedableRng;
+use std::{fs,path::PathBuf,os::unix::fs::DirBuilderExt};
+struct Root(PathBuf);
+impl Root {
+    fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("light-swap-{}",uuid::Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}
+    fn child(&self,name:&str)->Result<PathBuf> {let path=self.0.join(name);fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(path)}
+}
+impl Drop for Root {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
+#[test]
+fn light_claims_bind_the_trade_before_recovery_and_never_sign_funding()->Result<()> {
+    let root=Root::new()?;let bm=root.child("bob-meta")?;let bs=root.child("bob-secrets")?;
+    let am=root.child("alice-meta")?;let als=root.child("alice-secrets")?;
+    let (policy,terms)=crate::litecoin_quote::tests::fixture();
+    let quote=crate::litecoin_quote::tests::signed(&terms,&policy,1000)?;
+    let trade=quote.terms()["swapId"].parse()?;
+    let bi=SigningKey::from_bytes(&[1;32]);let ai=SigningKey::from_bytes(&[2;32]);
+    let pins=[bi.verifying_key().to_bytes(),ai.verifying_key().to_bytes()];
+    let mut rng=rand::rngs::StdRng::seed_from_u64(7812);
+    let mut bob=Execution::begin(&bm,&bs,&quote,&policy,LocalRole::LitecoinFunder,quote.commitment(),1000,&mut rng)?;
+    let mut alice=Execution::begin(&am,&als,&quote,&policy,LocalRole::NativeFunder,quote.commitment(),1000,&mut rng)?;
+    let first=bob.outgoing(&bi,1000)?;alice.accept_peer(first.bytes(),first.signature(),1000)?;
+    let second=alice.outgoing(&ai,1001)?;bob.accept_peer(second.bytes(),second.signature(),1001)?;
+    let keys=bob.completed_keys()?;
+    let seed=SecretSeed::from_bytes(zeroize::Zeroizing::new([42;32]));
+    let account=seed.public_account(policy.ltc_network,0)?;let owned=account.derive(Branch::Receive,0)?;
+    let prevout=TxOut {value:Amount::from_sat(100_001_000),script_pubkey:owned.address().script_pubkey().clone()};
+    let chain=HeaderSequence::new(policy.ltc_network)?;
+    let credit=Transaction {version:Version::TWO,lock_time:LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint::new(Txid::from_byte_array([7;32]),0),script_sig:Default::default(),sequence:Sequence::MAX,witness:Default::default()}],output:vec![prevout.clone()]};
+    // Injected genesis inclusion for policy tests, not Merkle/consensus evidence.
+    let included=IncludedTransaction::new(MerkleMatch {txid:credit.compute_txid(),claimed_height:0,
+        block_hash:chain.header(0).unwrap().block_hash()},&credit)?;
+    let payment=TxOut {value:Amount::from_sat(100_000_000),script_pubkey:keys.contract_address().script_pubkey().clone()};
+    let mut transaction=credit.clone();transaction.input[0].previous_output=OutPoint::new(credit.compute_txid(),0);transaction.output=vec![payment.clone()];
+    let inputs=[IncludedInput {transaction:&included,vout:0,branch:Branch::Receive,index:0}];
+    let observed=ObservedWallet::reconcile(&chain,&[prevout.script_pubkey.clone()],std::slice::from_ref(&included))?;
+    let spent=ObservedWallet::reconcile_with_pending(&chain,&[prevout.script_pubkey.clone()],std::slice::from_ref(&included),&[transaction.clone()])?;
+    let prepare=|tx:Transaction,pay:&TxOut,path:&Path,operation| {
+        ConfirmedSpendReview::new(&chain,&account,tx,&inputs,pay,None,Amount::from_sat(1000),1)?
+            .retain_observed(&chain,&observed,path,operation)
+    };
+    let claims=root.child("claims")?;
+    let spend=prepare(transaction.clone(),&payment,&claims,trade)?;let commitment=spend.signing_commitment();
+    let psbt=spend.funding_psbt_on(&chain,&observed,trade,commitment)?;
+    assert_eq!(psbt.unsigned_tx,transaction);assert_eq!(psbt.inputs[0].witness_utxo,Some(prevout));
+    assert!(spend.funding_psbt_on(&chain,&spent,trade,commitment).is_err());
+    assert!(spend.funding_psbt_on(&chain,&observed,uuid::Uuid::new_v4(),commitment).is_err());
+    assert!(bob.light_recovery_signing_frame(&spend,&chain,&observed,sha256::Hash::hash(b"wrong"),1002).is_err());
+    assert!(bob.light_recovery_signing_frame(&spend,&chain,&spent,commitment,1002).is_err());
+    assert!(alice.light_recovery_signing_frame(&spend,&chain,&observed,commitment,1002).is_err());
+    let other=root.child("other-claims")?;let wrong_id=prepare(transaction.clone(),&payment,&other,uuid::Uuid::new_v4())?;
+    assert!(bob.light_recovery_signing_frame(&wrong_id,&chain,&observed,wrong_id.signing_commitment(),1002).is_err());
+    assert!(!bm.join(format!("{trade}.ltc-light-funding")).exists());
+    let mut wrong_tx=transaction.clone();wrong_tx.output[0].script_pubkey=owned.address().script_pubkey().clone();
+    let bad=root.child("wrong-contract")?;let wrong=prepare(wrong_tx.clone(),&wrong_tx.output[0],&bad,trade)?;
+    assert!(bob.light_recovery_signing_frame(&wrong,&chain,&observed,wrong.signing_commitment(),1002).is_err());
+    assert!(!bm.join(format!("{trade}.ltc-light-funding")).exists());
+    let mut replaceable=transaction.clone();replaceable.input[0].sequence=Sequence::ENABLE_RBF_NO_LOCKTIME;
+    let rbf_dir=root.child("replaceable")?;
+    let rbf=prepare(replaceable,&payment,&rbf_dir,trade)?;
+    assert!(rbf.funding_psbt_on(&chain,&observed,trade,rbf.signing_commitment()).is_err());
+    let stale=ObservedWallet::reconcile(&chain,&[payment.script_pubkey.clone()],&[])?;
+    assert!(spend.funding_psbt_on(&chain,&stale,trade,commitment).is_err());
+    let before=fs::read_dir(&claims)?.count();
+    let frame=bob.light_recovery_signing_frame(&spend,&chain,&observed,commitment,1002)?;
+    assert_eq!(fs::read_dir(&claims)?.count(),before);assert!(spend.retained_signed().is_err());
+    let binding=fs::read(bm.join(format!("{trade}.ltc-light-funding")))?;
+    drop(bob);
+    let mut bob=Execution::resume(&bm,&bs,trade,&policy,LocalRole::LitecoinFunder,pins)?;
+    assert_eq!(bob.light_recovery_signing_frame(&spend,&chain,&observed,commitment,1003)?,frame);
+    assert_eq!(fs::read(bm.join(format!("{trade}.ltc-light-funding")))?,binding);
+    let signed=bi.sign(&crate::litecoin_negotiation::recovery::signing_bytes(&frame)?).to_bytes();
+    let bob_message=bob.submit_recovery_signature(&frame,&signed,1003)?;
+    let alice_message=alice.prepare_recovery(&psbt,&ai,1002)?;
+    let recovery=bob.accept_recovery(alice_message.bytes(),alice_message.signature())?;
+    alice.accept_recovery(bob_message.bytes(),bob_message.signature())?;
+    assert_eq!(recovery.cancel.input[0].previous_output.txid,transaction.compute_txid());
+    assert!(recovery.refund.is_some());assert!(spend.retained_signed().is_err());
+    assert_eq!(fs::read_dir(&claims)?.count(),before);
+    // A changed input claim must fail before producing further recovery output.
+    let entry=fs::read_dir(&claims)?.collect::<std::io::Result<Vec<_>>>()?.into_iter()
+        .find(|entry|entry.path().extension().is_some_and(|e|e=="claim")).unwrap();
+    fs::write(entry.path(),b"altered")?;
+    assert!(bob.light_recovery_signing_frame(&spend,&chain,&observed,commitment,1003).is_err());
+    Ok(())
+}
