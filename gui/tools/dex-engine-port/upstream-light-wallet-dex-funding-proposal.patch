+    /// Export the exact retained unsigned transaction and owned prevouts for a
+    /// swap recovery agreement. The caller still validates quote/contract/fees,
+    /// obtains peer recovery, and requests signing and broadcasting separately.
+    pub fn funding_psbt_on(&self,chain:&HeaderSequence,observed:&ObservedWallet,
+        operation:Uuid,expected:sha256::Hash)->Result<bitcoin::psbt::Psbt> {
+        require_observed(chain,observed,self.network,self.height,self.tip,&self.inputs)?;
+        self.claimed.recovery_psbt(operation,expected)
+    }
     pub fn transaction(&self)->&Transaction {self.claimed.transaction()}
