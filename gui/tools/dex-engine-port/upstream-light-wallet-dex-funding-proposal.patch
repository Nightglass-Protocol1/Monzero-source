+//! Light-wallet input claims enter the existing negotiated recovery protocol.
+//! This prepares recovery signatures, never signs or broadcasts the funding lock.
+use super::*;
+use crate::litecoin_light::{accounting::ObservedWallet,headers::HeaderSequence,
+    network::LightNetwork,vault::signing::review::confirmed::claimed::ObservedClaimedSpend};
+use crate::litecoin_negotiation::recovery::RecoveryPlan;
+use bitcoin::hashes::{Hash,sha256};
+impl Execution {
+    /// Require the wallet's retained operation to be this trade. The shared
+    /// input journal remains leased by `spend` throughout preparation. Quote
+    /// admission and contract/recovery validation precede any binding writes.
+    pub fn light_recovery_signing_frame(&mut self,spend:&ObservedClaimedSpend,
+        chain:&HeaderSequence,observed:&ObservedWallet,approved_claim:sha256::Hash,now:u64)->Result<Vec<u8>> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong light funding role");
+        ensure!(chain.network()==LightNetwork::from(self.policy.ltc_network),"wrong light funding network");
+        let (head,_,quote,_,exchange)=self.load()?;
+        let keys=exchange.finish()?;
+        let psbt=spend.funding_psbt_on(chain,observed,self.claim.trade,approved_claim)?;
+        RecoveryPlan::new(&quote,&self.policy,now,&keys,psbt.clone())?;
+        let binding=serde_json::to_vec(&serde_json::json!({"schema":"monzero-ltc-light-funding-binding-v1",
+            "trade":self.claim.trade,"quote":self.claim.quote,"checkpoint":head.checkpoint,
+            "claimCommitment":approved_claim,"psbtDigest":sha256::Hash::hash(&psbt.serialize()),
+            "network":chain.network().storage_identity()}))?;
+        let name=format!("{}.ltc-light-funding",self.claim.trade);
+        self.metadata.compatible(&name,&binding)?;
+        let frame=self.recovery_signing_frame(&psbt,now)?;
+        self.metadata.retain(&name,&binding)?;
+        ensure!(self.metadata.read(&name)?==binding,"light funding binding read-back mismatch");
+        Ok(frame)
+    }
+}
