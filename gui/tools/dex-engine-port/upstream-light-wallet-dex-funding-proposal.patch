+        let tx=self.transaction();
+        ensure!(tx.input.iter().all(|i|i.script_sig.is_empty() && i.witness.is_empty() && !i.sequence.is_rbf()),
+            "unstable recovery funding transaction");
+        let mut psbt=bitcoin::psbt::Psbt::from_unsigned_tx(tx.clone())?;
+        for (input,owned) in psbt.inputs.iter_mut().zip(&self.review.inputs) {
+            ensure!(owned.prevout.script_pubkey.is_p2wpkh(),"unsupported recovery funding prevout");
