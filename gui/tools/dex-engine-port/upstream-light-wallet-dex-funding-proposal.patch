+    pub(in crate::litecoin_light::vault::signing::review) fn recovery_psbt(&self,operation:Uuid,expected:sha256::Hash)->Result<bitcoin::psbt::Psbt> {
+        self.check_signing_review(expected)?;self.ensure_not_submitted()?;
+        ensure!(!operation.is_nil() && self.records[0].0==format!("ltc-spend-{operation}.json"),"funding claim belongs to another operation");
+        ensure!(self.review.account.network().script_kind()==crate::litecoin_light::network::ScriptKind::WitnessV0,
