+//! Genesis-rooted Litecoin header sequence, pinned to Core v0.21.5.8 rules.
+//! This validates one branch, not best-chain selection, freshness, checkpoints,
+//! block bodies, MWEB consensus or current UTXO state. No spending authority.
+use anyhow::{Context, Result, ensure};
+use bitcoin::{BlockHash, TxMerkleNode, block::{Header, Version}, CompactTarget,
+    consensus::{serialize, deserialize}, hashes::Hash};
+use num_bigint::BigUint;
+use swap_core::litecoin_address::LtcNetwork;
+
+pub struct HeaderSequence {
+    network: LtcNetwork,
+    headers: Vec<Header>,
+    work: BigUint,
+}
+impl HeaderSequence {
+    pub fn new(network: LtcNetwork) -> Result<Self> {
+        let (time, nonce, bits) = match network {
+            LtcNetwork::Mainnet => (1317972665,2084524493,0x1e0ffff0),
+            LtcNetwork::Testnet => (1486949366,293345,0x1e0ffff0),
+            LtcNetwork::Regtest => (1296688602,0,0x207fffff),
+        };
+        let genesis = Header { version: Version::from_consensus(1), prev_blockhash: BlockHash::all_zeros(),
+            merkle_root: "97ddfbbae6be97fd6cdf3e7ca13232a3afff2353e29badfab7f73011edd4ced9".parse::<TxMerkleNode>()?,
+            time, bits: CompactTarget::from_consensus(bits), nonce };
+        ensure!(genesis.block_hash().to_string()==network.genesis(), "Litecoin genesis constants changed");
+        // Core special-cases the independently pinned genesis identity.
+        let work = block_work(&target(bits,network)?);
+        Ok(Self {network, headers:vec![genesis], work})
+    }
+    pub fn network(&self) -> LtcNetwork { self.network }
+    pub fn height(&self) -> u32 { (self.headers.len()-1) as u32 }
+    pub fn header(&self,height: u32) -> Option<Header> { self.headers.get(height as usize).copied() }
+    pub fn chain_work(&self) -> &BigUint { &self.work }
+
+    /// `now` must be supplied by the caller's clock, not a server timestamp.
+    /// Validation is completed before either headers or cumulative work change.
+    pub fn append(&mut self,bytes: &[u8],now: u64) -> Result<BlockHash> {
+        ensure!(bytes.len()==80, "invalid Litecoin header size");
+        let header: Header = deserialize(bytes)?;
+        let height = u32::try_from(self.headers.len()).context("Litecoin header height exhausted")?;
+        let previous = self.headers.last().context("missing Litecoin genesis")?;
+        ensure!(header.prev_blockhash==previous.block_hash(), "disconnected Litecoin header");
+        ensure!(header.bits.to_consensus()==next_bits(self.network,&self.headers,header.time)?,
+            "incorrect Litecoin difficulty");
+        let mut times: Vec<_> = self.headers.iter().rev().take(11).map(|h|h.time).collect();
+        times.sort_unstable();
+        ensure!(header.time>times[times.len()/2], "Litecoin timestamp does not exceed median past time");
+        ensure!(u64::from(header.time)<=now.checked_add(7200).context("invalid local header clock")?,
+            "Litecoin header timestamp too far in future");
+        check_version(self.network,height,header.version.to_consensus())?;
+        let target = target(header.bits.to_consensus(),self.network)?;
+        ensure!(BigUint::from_bytes_le(&scrypt_hash(bytes)?)<=target, "insufficient Litecoin Scrypt work");
+        let hash = header.block_hash();
+        self.work += block_work(&target);
+        self.headers.push(header);
+        Ok(hash)
+    }
+}
+
+/// Fixed Litecoin N=1024, r=1, p=1, 32-byte output. Never Bitcoin SHA256d work.
+fn scrypt_hash(header: &[u8]) -> Result<[u8;32]> {
+    ensure!(header.len()==80, "invalid Scrypt header length");
+    let params = scrypt::Params::new(10,1,1,32).map_err(|_|anyhow::anyhow!("invalid Litecoin Scrypt parameters"))?;
+    let mut output = [0;32];
+    scrypt::scrypt(header,header,&params,&mut output).map_err(|_|anyhow::anyhow!("Litecoin Scrypt failed"))?;
+    Ok(output)
+}
+fn limit(network: LtcNetwork) -> BigUint {
+    let bits = if network==LtcNetwork::Regtest {255} else {236};
+    (BigUint::from(1u8)<<bits)-BigUint::from(1u8)
+}
+fn target(bits: u32,network: LtcNetwork) -> Result<BigUint> {
+    let size = bits>>24; let word = bits&0x007fffff;
+    ensure!(bits&0x00800000==0 && word!=0 && size<=34
+        && !(word>0xff && size>33) && !(word>0xffff && size>32), "invalid Litecoin compact target");
+    let value = if size<=3 {BigUint::from(word>>(8*(3-size)))}
+        else {BigUint::from(word)<<(8*(size-3)) as usize};
+    ensure!(value!=BigUint::from(0u8) && value<=limit(network), "Litecoin target outside network limit");
+    Ok(value)
+}
+fn compact(value: &BigUint) -> u32 {
+    let mut size = value.bits().div_ceil(8) as u32;
+    let shifted = if size<=3 {value<<(8*(3-size)) as usize} else {value>>(8*(size-3)) as usize};
+    let mut word = shifted.to_bytes_be().iter().fold(0u32, |word,byte| (word<<8)|u32::from(*byte));
+    if word&0x00800000!=0 {word>>=8;size+=1;}
+    word | (size<<24)
+}
+fn block_work(target: &BigUint) -> BigUint {
+    (BigUint::from(1u8)<<256usize)/(target+BigUint::from(1u8))
+}
+fn next_bits(network: LtcNetwork,headers: &[Header],time: u32) -> Result<u32> {
+    let previous = headers.last().context("missing difficulty history")?;
+    let height = headers.len();
+    let easiest = compact(&limit(network));
+    if height%2016!=0 {
+        if network!=LtcNetwork::Mainnet {
+            if u64::from(time)>u64::from(previous.time)+300 {return Ok(easiest)}
+            let mut index = height-1;
+            while index>0 && index%2016!=0 && headers[index].bits.to_consensus()==easiest {index-=1;}
+            return Ok(headers[index].bits.to_consensus())
+        }
+        return Ok(previous.bits.to_consensus())
+    }
+    if network==LtcNetwork::Regtest {return Ok(previous.bits.to_consensus())}
+    // Litecoin uses an extra ancestor after the first adjustment interval.
+    let first = if height==2016 {0} else {height-2017};
+    retarget(network,previous.bits.to_consensus(),i64::from(previous.time)-i64::from(headers[first].time))
+}
+fn retarget(network: LtcNetwork,bits: u32,elapsed: i64) -> Result<u32> {
+    let mut value = target(bits,network)?;
+    let limit = limit(network);
+    let shift = value.bits()>limit.bits()-1;
+    if shift {value>>=1usize;}
+    value *= elapsed.clamp(302400/4,302400*4) as u64;
+    value /= 302400u64;
+    if shift {value<<=1usize;}
+    Ok(compact(&value.min(limit)))
+}
+fn check_version(network: LtcNetwork,height: u32,version: i32) -> Result<()> {
+    let (bip34,bip66,bip65,segwit) = match network {
+        LtcNetwork::Mainnet => (710000,811879,918684,1201536),
+        LtcNetwork::Testnet => (76,76,76,6048),
+        LtcNetwork::Regtest => (500,1251,1351,0),
+    };
+    ensure!(!(height>=bip34 && version<2) && !(height>=bip66 && version<3)
+        && !(height>=bip65 && version<4) && !(height>=segwit && version<0x20000000),
+        "outdated Litecoin header version");
+    Ok(())
+}
