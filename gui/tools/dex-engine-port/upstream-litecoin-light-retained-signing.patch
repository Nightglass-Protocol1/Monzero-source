+#[test]
+fn signing_requires_exact_commitment_and_retains_bytes_across_restart()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();
+    let (seed,prepared)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,operation,prepared)?;
+    let commitment=claim.signing_commitment();let count=fs::read_dir(&directory.0)?.count();
+    let error=claim.approve_and_sign(&seed,sha256::Hash::hash(b"different review")).unwrap_err();
+    assert!(error.to_string().contains("commitment mismatch"));
+    assert_eq!(fs::read_dir(&directory.0)?.count(),count);
+    let signed=claim.approve_and_sign(&seed,commitment)?;
+    let path=directory.0.join(format!("ltc-signed-{commitment}.tx"));
+    assert_eq!(fs::read(&path)?,serialize(&signed));
+    assert_eq!(signed.compute_txid(),claim.transaction().compute_txid());
+    assert_eq!(claim.approve_and_sign(&seed,commitment)?,signed);drop(claim);
+    let reopened=ClaimedSpend::retain(&directory.0,operation,review(&[0])?.1)?;
+    assert_eq!(reopened.signing_commitment(),commitment);
+    assert_eq!(reopened.approve_and_sign(&seed,commitment)?,signed);
+    fs::write(&path,b"conflicting signed bytes")?;
+    assert!(reopened.approve_and_sign(&seed,commitment).is_err());
+    assert_eq!(fs::read(&path)?,b"conflicting signed bytes");Ok(())
+}
+#[test]
+fn signing_resumes_retained_intent_and_rejects_conflicting_intent()->Result<()> {
+    let directory=Directory::new()?;let operation=Uuid::new_v4();
+    let (seed,prepared)=review(&[0])?;
+    let claim=ClaimedSpend::retain(&directory.0,operation,prepared)?;
+    let commitment=claim.signing_commitment();
+    let approval=directory.0.join(format!("ltc-signing-{commitment}.json"));
+    let signed=directory.0.join(format!("ltc-signed-{commitment}.tx"));
+    // A failed unlock/signing attempt retains intent but cannot publish a tx.
+    let wrong=SecretSeed::from_bytes(Zeroizing::new([43;32]));
+    assert!(claim.approve_and_sign(&wrong,commitment).is_err());
+    assert!(approval.exists());assert!(!signed.exists());drop(claim);
+    let reopened=ClaimedSpend::retain(&directory.0,operation,review(&[0])?.1)?;
+    assert_eq!(reopened.approve_and_sign(&seed,commitment)?.input[0].witness.len(),2);
+    fs::write(&approval,b"conflicting intent")?;
+    assert!(reopened.approve_and_sign(&seed,commitment).is_err());
+    assert_eq!(fs::read(&approval)?,b"conflicting intent");Ok(())
+}
