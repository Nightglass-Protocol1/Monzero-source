+            "schema":"monzero-ltc-signing-intent-v1","commitment":commitment.to_string()
+        }))?;
+        self.journal.retain(&approval_name,&approval)?;
+        let signed=self.review.sign(seed)?;
+        let bytes=serialize(&signed);
+        let signed_name=format!("ltc-signed-{commitment}.tx");
