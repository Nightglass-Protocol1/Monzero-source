diff --git a/swap-machine/tests/quote_fixture.rs b/swap-machine/tests/quote_fixture.rs
new file mode 100644
index 000000000..caa5dea59
--- /dev/null
+++ b/swap-machine/tests/quote_fixture.rs
@@ -0,0 +1,97 @@
+//! Disposable signed-quote/Qt bridge for funded tests, not production approval.
+#![cfg(unix)]
+use anyhow::{Context, Result, ensure};
+use ed25519_dalek::{Signer, SigningKey};
+use serde_json::{Value, json};
+use std::{io::Write, os::unix::fs::DirBuilderExt, path::PathBuf, process::{Command, Stdio}};
+use swap_machine::native_trade_quote::{DeploymentPolicy, VerifiedQuote};
+use swap_env::env::{GetConfig, Regtest};
+use uuid::Uuid;
+
+pub fn now() -> Result<u64> {
+    Ok(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs())
+}
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b|format!("{b:02x}")).collect() }
+pub fn policy() -> DeploymentPolicy {
+    let config=Regtest::get_config();
+    DeploymentPolicy {
+        btc_genesis:bitcoin::blockdata::constants::genesis_block(bitcoin::Network::Regtest).block_hash().to_string(),
+        xmz_genesis:"84f9ebdac8924806f037482ec16fd59b271e954d3e00363dd6c7e4ce9dd659e4".into(),
+        btc_network:"btc-regtest".into(), xmz_network:"xmz-fakechain".into(),
+        btc_confirmations:config.bitcoin_finality_confirmations, xmz_confirmations:10,
+        cancel_blocks:config.bitcoin_cancel_timelock, punish_blocks:config.bitcoin_punish_timelock,
+        maximum_btc_principal:500000, maximum_xmz_principal:200000000000,
+        maximum_btc_native_fee:10000, maximum_xmz_native_fee:1000000000,
+    }
+}
+pub struct QuoteFixture { directory: PathBuf, context: Value }
+impl Drop for QuoteFixture {
+    fn drop(&mut self) { let _=std::fs::remove_dir_all(&self.directory); }
+}
+impl QuoteFixture {
+    pub fn create(driver: std::ffi::OsString, swap_id: Uuid, btc: u64, xmz: u64,
+        payout: &bitcoin::Address, refund: &bitcoin::Address) -> Result<Self> {
+        let directory=std::env::temp_dir().canonicalize()?.join(format!("xmz-funded-quote-{}",Uuid::new_v4()));
+        std::fs::DirBuilder::new().mode(0o700).create(&directory)?;
+        let mut owner=Self {directory,context:Value::Null};
+        let policy=policy(); let accepted=now()?; let quote_id=Uuid::new_v4();
+        let b=SigningKey::from_bytes(&[1;32]); let x=SigningKey::from_bytes(&[2;32]);
+        let xmz_payout=std::env::var("MONZERO_TEST_XMZ_PAYOUT")?;
+        let xmz_refund=std::env::var("MONZERO_TEST_XMZ_REFUND")?;
+        ensure!(xmz_payout!=xmz_refund,"fixture destinations must differ");
+        let terms=json!({"schema":"monzero-native-btc-xmz-quote-v1",
+            "quoteId":quote_id.to_string(),"swapId":swap_id.to_string(),
+            "btcFunder":hex(&b.verifying_key().to_bytes()),"xmzFunder":hex(&x.verifying_key().to_bytes()),
+            "btcGenesis":policy.btc_genesis,"xmzGenesis":policy.xmz_genesis,
+            "btcNetwork":policy.btc_network,"xmzNetwork":policy.xmz_network,
+            "btcSatoshis":btc.to_string(),"xmzAtoms":xmz.to_string(),"appFeeXmzAtoms":"0",
+            "btcNativeFeeMaxSatoshis":"10000","xmzNativeFeeMaxAtoms":"1000000000",
+            "btcPayout":payout.to_string(),"btcRefund":refund.to_string(),
+            "xmzPayout":xmz_payout,"xmzRefund":xmz_refund,
+            "btcConfirmations":policy.btc_confirmations.to_string(),"xmzConfirmations":policy.xmz_confirmations.to_string(),
+            "cancelBlocks":policy.cancel_blocks.to_string(),"punishBlocks":policy.punish_blocks.to_string(),
+            "expiresAt":(accepted+3600).to_string()});
+        let payload=serde_json::to_vec(&terms)?;
+        let sign=|key: &SigningKey,role: &str| {
+            let domain=format!("monzero-native-btc-xmz-quote-v1-{role}");
+            let mut bytes=format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",domain.len(),domain,payload.len()).into_bytes();
+            bytes.extend_from_slice(&payload); key.sign(&bytes).to_bytes()
+        };
+        let bs=sign(&b,"btc-funder"); let xs=sign(&x,"xmz-funder");
+        let quote=VerifiedQuote::verify(&payload,accepted,&b.verifying_key().to_bytes(),&x.verifying_key().to_bytes(),
+            &bs,&xs,bitcoin::Network::Regtest,swap_core::xmz_address::XmzNetwork::Mainnet)?;
+        quote.check_deployment(&policy,accepted)?;
+        let record=serde_json::to_vec(&json!({"acceptedAt":accepted.to_string(),"terms":terms,
+            "btcSignature":hex(&bs),"xmzSignature":hex(&xs)}))?;
+        let mut child=Command::new(driver).arg("--reserve-signed-fixture").arg(&owner.directory)
+            .arg(hex(&b.verifying_key().to_bytes())).arg(hex(&x.verifying_key().to_bytes()))
+            .stdin(Stdio::piped()).stdout(Stdio::null()).stderr(Stdio::null()).spawn()?;
+        let written=child.stdin.take().context("missing Qt input")?.write_all(&record);
+        let status=child.wait()?; written?;
+        ensure!(status.success(),"Qt reservation was not acknowledged");
+        owner.context=json!({"directory":owner.directory,"quoteId":quote_id.to_string(),
+            "swapId":swap_id.to_string(),"commitment":hex(quote.commitment())});
+        let _=read(owner.context(),swap_id)?;
+        Ok(owner)
+    }
+    pub fn context(&self) -> &Value { &self.context }
+}
+
+/// Caller is the trusted test parent over its private fixture socket.
+/// Pins/policy are fixed fixture configuration, never supplied in this context.
+pub fn read(context: &Value, expected_swap: Uuid) -> Result<VerifiedQuote> {
+    ensure!(context.as_object().is_some_and(|o|o.len()==4),"invalid fixture quote context");
+    let text=|key|context[key].as_str().context("missing fixture quote context field");
+    let swap:Uuid=text("swapId")?.parse()?;
+    ensure!(swap==expected_swap,"fixture quote swap mismatch");
+    let commitment=text("commitment")?;
+    ensure!(commitment.len()==64 && commitment.bytes().all(|b|b.is_ascii_digit()||(b'a'..=b'f').contains(&b)),
+        "invalid fixture quote commitment");
+    let mut digest=[0;32];
+    for (i,b) in digest.iter_mut().enumerate() { *b=u8::from_str_radix(&commitment[i*2..i*2+2],16)?; }
+    swap_machine::native_quote_reservation::read_verified_quote(&PathBuf::from(text("directory")?),
+        text("quoteId")?.parse()?,swap,&digest,now()?,
+        &SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes(),
+        &SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes(),
+        bitcoin::Network::Regtest,swap_core::xmz_address::XmzNetwork::Mainnet,&policy())
+}
