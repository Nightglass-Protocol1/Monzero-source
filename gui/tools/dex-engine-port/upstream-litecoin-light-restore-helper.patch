+    fn restore_wallet(config:&Config,network:LtcNetwork,approval:&RestoreApproval)->Result<Value> {
+        let wallet=config.wallet.as_ref().context("missing wallet configuration")?;
+        let vault_config=wallet.vault.as_ref().context("missing vault identity")?;
+        let digest:sha256::Hash=approval.approved_digest.parse()?;
+        ensure!(digest.to_string()==approval.approved_digest,"noncanonical approved backup digest");
+        ensure!(approval.directory.is_absolute() && approval.directory.canonicalize()?==approval.directory,
+            "invalid backup source");
+        let password=approval.password.0.as_bytes();
+        let (encrypted,info)=backup::storage::load_verified(&approval.directory,password,network,vault_config.wallet_id)?;
+        // Bind approval and configured account before either destination is opened for publication.
+        ensure!(info.digest()==digest && serde_json::to_vec(&info.account().descriptor())?==serde_json::to_vec(&wallet.account)?,
+            "backup differs from approved wallet context");
+        let (vault,book)=backup::restore(&vault_config.directory,&wallet.address_book_directory,network,
+            vault_config.wallet_id,password,&encrypted)?;
+        drop(vault.unlock_for_account(password,&wallet.account)?);
+        let allocated=info.allocated();
+        ensure!(book.allocated_count(Branch::Receive)?==allocated[0]
+            && book.allocated_count(Branch::Change)?==allocated[1],"restored allocation counts differ");
+        Ok(json!({"watchOnly":true,"spendable":false,"restored":true,"backupDigest":info.digest().to_string(),
+            "walletId":info.wallet_id(),"receivingAllocated":allocated[0],"changeAllocated":allocated[1],
+            "scope":"seed-and-address-allocations","allocationFreshness":"unassessed","activeSwapRecovery":false}))
+    }
