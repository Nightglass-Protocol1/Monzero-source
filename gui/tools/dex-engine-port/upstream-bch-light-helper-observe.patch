+async fn observe(config:&Config,network:LightNetwork,dex:&DexConfig,execution:&AdmittedExecution<'_>,
+    request:&ObservationRequest)->Result<Value> {
+    let expected=digest(&request.retained_review.signing_commitment)?;
+    let (claim,mut result)=recovered_payment(config,network,&request.payment,dex.trade_id,&request.retained_review)?;
+    let mut state=ChainState::open(&config.cache_directory,network,config.maximum_height,now()?)?;
+    let sync=synchronize(config,network,&mut state,request.maximum_download_headers).await?;
+    ensure!(sync["reportedTipOnSelectedChain"]==json!(true)
+        && sync["reportedHeight"].as_u64()==Some(u64::from(state.chain()?.height())),"BCH observation peer tip differs from selected chain");
+    let endpoint=config.endpoint.as_ref().context("missing BCH observation endpoint")?;
+    let target=TlsEndpoint::new(endpoint.host.clone(),endpoint.port,network)?;
+    let mut session=target.connect().await?;
+    let observation=execution.observe_light_bch_funding_on(&claim,state.chain()?,expected,&mut session,request.maximum_history_entries).await?;
+    drop(session);
+    apply_broadcast_status(&mut result,&claim,endpoint,&target,expected)?;
+    result["observation"]=match observation.position_on(state.chain()?)? {
+        PaymentPosition::NotReported=>json!({"position":"not-reported"}),
+        PaymentPosition::ReportedPending=>json!({"position":"reported-pending"}),
+        PaymentPosition::Included {height,block_hash,confirmations}=>json!({"position":"included",
+            "height":height,"blockHash":block_hash,"confirmations":confirmations}),
+    };
+    result["selectedHeight"]=json!(observation.selected_height());result["selectedTip"]=json!(observation.selected_tip());
+    result["confirmationStatus"]=json!(if result["observation"]["position"]=="included" {"included"}else{"not-confirmed"});
+    result["broadcastAuthorized"]=json!(false);result["tradeFundingRetained"]=json!(true);
+    Ok(result)
