diff --git a/swap/examples/headless_buy_xmr.rs b/swap/examples/headless_buy_xmr.rs
new file mode 100644
index 000000000..04a80d0e8
--- /dev/null
+++ b/swap/examples/headless_buy_xmr.rs
@@ -0,0 +1,120 @@
+//! Monzero test driver (not upstream): buy stagenet XMR with signet BTC from one known
+//! maker, without the GUI. Runs the same `buy_xmr` request the desktop app uses.
+//!
+//!   headless_buy_xmr --data-dir D (--monero-node URL | --monero-pool) --electrum URL... address
+//!       print the internal Bitcoin wallet balance and a deposit address, then exit
+//!   MONZERO_TEST_AUTO_SELECT_MAKER=1 headless_buy_xmr --data-dir D --monero-node URL \
+//!       --electrum URL... buy --seller /ip4/.../p2p/<peer> --xmr-address 5...
+//!       swap the whole wallet balance (up to the maker's maximum) and wait until it ends
+use anyhow::{bail, Context as _, Result};
+use libp2p::{multiaddr::Protocol, Multiaddr, PeerId};
+use rust_decimal::Decimal;
+use std::{path::PathBuf, str::FromStr, sync::Arc, time::Duration};
+use swap::cli::api::request::{BuyXmrArgs, Request};
+use swap::cli::api::tauri_bindings::MoneroNodeConfig;
+use swap::cli::api::{Context, ContextBuilder};
+use swap::cli::command::Bitcoin;
+use swap::monero::{LabeledMoneroAddress, MoneroAddressPool};
+
+fn value(args: &[String], flag: &str) -> Result<String> {
+    let at = args.iter().position(|a| a == flag).with_context(|| format!("{flag} is required"))?;
+    args.get(at + 1).cloned().with_context(|| format!("{flag} needs a value"))
+}
+
+fn values(args: &[String], flag: &str) -> Vec<String> {
+    args.windows(2).filter(|w| w[0] == flag).map(|w| w[1].clone()).collect()
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    // As swap's own binary: rustls needs one process-wide crypto provider
+    rustls::crypto::ring::default_provider()
+        .install_default()
+        .expect("failed to install default rustls provider");
+
+    let args: Vec<String> = std::env::args().collect();
+    let command = args.last().context("missing command")?.clone();
+    let command = if args.iter().any(|a| a == "buy") { "buy".to_string() } else { command };
+
+    let context = Arc::new(Context::new_without_tauri_handle());
+    ContextBuilder::new(true)
+        .with_bitcoin(Bitcoin {
+            bitcoin_electrum_rpc_urls: values(&args, "--electrum"),
+            bitcoin_target_block: None,
+        })
+        // --monero-pool: upstream's rotating node pool instead of one fixed node
+        .with_monero(if args.iter().any(|a| a == "--monero-pool") {
+            MoneroNodeConfig::Pool
+        } else {
+            MoneroNodeConfig::SingleNode { url: value(&args, "--monero-node")? }
+        })
+        .with_data_dir(PathBuf::from(value(&args, "--data-dir")?))
+        .with_json(false)
+        .with_tor(false)
+        .with_enable_monero_tor(false)
+        .build(context.clone())
+        .await
+        .context("Failed to build the swap context")?;
+
+    let wallet = context.try_get_bitcoin_wallet().await?;
+    wallet.sync().await.context("Failed to sync the Bitcoin wallet")?;
+    println!("bitcoin balance: {}", wallet.balance().await?);
+
+    match command.as_str() {
+        "address" => {
+            println!("deposit address: {}", wallet.new_address().await?);
+            let monero = context.try_get_monero_manager().await?;
+            println!("internal monero address: {}", monero.main_wallet().await.main_address().await?);
+            Ok(())
+        }
+        "rpc-check" => {
+            // The same daemon RPC health check the swap runs before locking any funds
+            let monero = context.try_get_monero_manager().await?;
+            monero.rpc_health_check().await?;
+            println!("monero daemon rpc: ok, height {}", monero.direct_rpc_block_height().await?);
+            Ok(())
+        }
+        "buy" => buy(&args, context).await,
+        other => bail!("unknown command {other}: use address or buy"),
+    }
+}
+
+async fn buy(args: &[String], context: Arc<Context>) -> Result<()> {
+    if std::env::var_os("MONZERO_TEST_AUTO_SELECT_MAKER").is_none() {
+        bail!("set MONZERO_TEST_AUTO_SELECT_MAKER=1: it approves the first matching maker quote");
+    }
+    let seller = Multiaddr::from_str(&value(args, "--seller")?).context("Invalid --seller")?;
+    let Some(Protocol::P2p(peer_id)) = seller.iter().last() else {
+        bail!("--seller must end in /p2p/<peer id>");
+    };
+    let peer_id: PeerId = peer_id;
+    let address = swap::monero::Address::from_str(
+        swap::monero::Network::Stagenet,
+        &value(args, "--xmr-address")?,
+    )
+    .context("Invalid --xmr-address (must be a stagenet address)")?;
+
+    let mut event_loop = context.try_get_event_loop_handle().await?;
+    event_loop.queue_peer_address(peer_id, seller.clone()).await?;
+
+    let receive = LabeledMoneroAddress::with_address(address, Decimal::ONE, "test receive".into())?;
+    BuyXmrArgs {
+        bitcoin_change_address: None,
+        monero_receive_pool: MoneroAddressPool::new(vec![receive]),
+    }
+    .request(context.clone())
+    .await?;
+
+    // buy_xmr hands the running swap to a background task; wait until it releases the lock.
+    loop {
+        tokio::time::sleep(Duration::from_secs(15)).await;
+        if context.swap_lock.get_current_swap_id().await.is_none() {
+            break;
+        }
+    }
+    let db = context.try_get_db().await?;
+    for (peer, swap_id, state) in db.all().await? {
+        println!("swap {swap_id} with {peer}: {state:?}");
+    }
+    Ok(())
+}
