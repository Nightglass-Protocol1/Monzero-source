+/// Keep pinned pre-C23 depends packages (libiconv, readline) buildable on newer GCC.
+/// Patch the copied recipe, so its content hash selects a new dependency cache
+/// entry without deleting or changing previously built artifacts.
+fn patch_depends_recipe(
+    source: &Path,
+    destination: &Path,
+    relative: &str,
+    patch: &str,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let original = fs::read_to_string(source.join(relative))?;
+    let patch = diffy::Patch::from_str(patch)?;
+    let expected = diffy::apply(&original, &patch)?;
+    let target = destination.join(relative);
+    let current = fs::read_to_string(&target)?;
+    if current == expected {
+        return Ok(());
+    }
+    if current != original {
+        return Err("Copied libiconv recipe differs from the pinned source and expected patch".into());
+    }
+    fs::write(target, expected)?;
+    Ok(())
+}
