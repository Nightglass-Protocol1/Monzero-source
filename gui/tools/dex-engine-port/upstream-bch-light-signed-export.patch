+impl AdmittedExecution<'_> {
+    /// Verify locally retained signed funding against the admitted BCH exchange.
+    /// No journal publication, chain observation, signing or relay occurs here.
+    pub fn verify_light_signed_funding(&self,claim:&crate::litecoin_light::vault::signing::review::claims::ClaimedSpend,
+        network:crate::litecoin_light::network::LightNetwork,expected:bitcoin::hashes::sha256::Hash,
+        sources:&[&[u8]],now:u64)->Result<swap_core::bch::funding::SignedFunding> {
+        use crate::litecoin_light::network::{LightNetwork,BchNetwork};
+        let quote_network=match network {
+            LightNetwork::BitcoinCash(BchNetwork::Mainnet)=>"bch-mainnet",
+            LightNetwork::BitcoinCash(BchNetwork::Testnet)=>"bch-testnet",
+            LightNetwork::BitcoinCash(BchNetwork::Regtest)=>"bch-regtest",
+            _=>anyhow::bail!("wrong local BCH funding chain"),
+        };
+        ensure!(quote_network==self.quote.terms()["bchNetwork"]
+            && network.genesis()==self.quote.terms()["bchGenesis"],"BCH local funding chain differs from quote");
+        let retained=claim.retained_bch_funding(network,self.quote.terms()["swapId"].parse()?,expected)?;
+        let unsigned=retained.unsigned();
+        let payment=unsigned.output.first().context("missing BCH local payment")?;
+        let minimum=self.quote.terms()["bchMinimumOutputAtoms"].parse::<u64>()?;
+        self.check_light_funding_payment(payment,claim.fee(),Amount::from_sat(minimum),now)?;
+        // SpendReview already established ownership of any second (change) output.
+        let change=unsigned.output.get(1).or_else(||retained.previous_outputs().first())
+            .context("missing BCH local change policy")?;
+        let preview=self.validate_bch_funding_preview(now,&bitcoin::consensus::serialize(unsigned),sources,
+            &change.script_pubkey,claim.fee().to_sat(),minimum)?;
+        ensure!(preview.previous_outputs()==retained.previous_outputs(),"BCH local funding prevouts differ from wallet claims");
+        preview.verify_signed(&bitcoin::consensus::serialize(retained.signed()))
+    }
+}
