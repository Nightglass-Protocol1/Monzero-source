+    let unsigned=Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:OutPoint {txid:Txid::from_byte_array([9;32]),vout:0},
+            script_sig:Default::default(),sequence:Sequence::MAX,witness:Default::default()}],output:vec![payment.clone()]};
+    let review=||SpendReview::new(&account,unsigned.clone(),vec![OwnedInput {
