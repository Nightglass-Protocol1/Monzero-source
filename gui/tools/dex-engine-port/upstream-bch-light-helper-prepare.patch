+    let mut book=AddressBook::open(&wallet.address_book_directory,PublicAccount::from_descriptor(&wallet.account,network)?)?;
+    let terms=execution.light_funding_terms(now()?)?;
+    let refund=bitcoin::ScriptBuf::from_hex(terms["refundScript"].as_str().context("missing BCH refund script")?)?;
