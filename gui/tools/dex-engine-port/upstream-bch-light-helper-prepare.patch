+    let target=TlsEndpoint::new(endpoint.host.clone(),endpoint.port,network)?;
+    let mut session=target.connect().await?;
+    let observation=session.refresh_wallet(state.chain()?,&account,
+        [book.allocated_count(Branch::Receive)?,book.allocated_count(Branch::Change)?],
