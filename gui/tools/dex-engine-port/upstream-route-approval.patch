+//! In-memory consent requests for individual legs of a sequential route.
+//!
+//! This service does not validate quote economics, authorize a transaction, or
+//! persist consent across restart. Callers must invalidate requests when their
+//! reviewed state changes and revalidate that state before acting on a reply.
+//! Dropping the waiter or disconnecting its session revokes unconsumed consent.
+
+use anyhow::{Context, Result, ensure};
+use serde::Serialize;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+use tokio::sync::oneshot;
+use tokio::time::Instant;
+use uuid::Uuid;
+
+const MAX_PENDING: usize = 64;
+const MAX_DETAILS_BYTES: usize = 32 * 1024;
+const MAX_LIFETIME: Duration = Duration::from_secs(300);
+
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum ApprovalPurpose {
+    SelectMaker,
+    LockBitcoin,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ApprovalContext {
+    pub route_id: Uuid,
+    pub leg_id: Uuid,
+    pub swap_id: Uuid,
+    pub purpose: ApprovalPurpose,
+}
+
+/// Immutable envelope sent to the reviewing client. The commitment covers every
+/// field in the request, including the purpose, details, ID and expiry.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ApprovalReview {
+    request: ReviewRequest,
+    commitment: String,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ReviewRequest {
+    schema: &'static str,
+    request_id: Uuid,
+    context: ApprovalContext,
+    expires_at_ms: u64,
+    details: Value,
+}
+
+/// One instance belongs to one client connection. On disconnect the transport
+/// must drop this session or call `invalidate_all`. Waiters do not keep the
+/// session alive; reconnecting must create fresh reviews.
+#[derive(Default)]
+pub struct ApprovalSession {
+    pending: Arc<Mutex<HashMap<Uuid, Pending>>>,
+}
+
+struct Pending {
+    review: ApprovalReview,
+    deadline: Instant,
+    responder: Option<oneshot::Sender<bool>>,
+}
+
+#[must_use = "dropping the waiter cancels the approval request"]
+pub struct ApprovalWaiter {
+    pending: Arc<Mutex<HashMap<Uuid, Pending>>>,
+    request_id: Uuid,
+    deadline: Instant,
+    receiver: Option<oneshot::Receiver<bool>>,
+}
+
+impl ApprovalReview {
+    pub fn request_id(&self) -> Uuid {
+        self.request.request_id
+    }
+
+    pub fn commitment(&self) -> &str {
+        &self.commitment
+    }
+}
+
+impl ApprovalSession {
+    /// Register before emitting the review so even an immediate reply can be
+    /// resolved. The caller must drop the waiter if delivery fails.
+    pub fn begin(
+        &self,
+        context: ApprovalContext,
+        details: Value,
+        lifetime: Duration,
+    ) -> Result<(ApprovalReview, ApprovalWaiter)> {
+        ensure!(
+            !context.route_id.is_nil() && !context.leg_id.is_nil() && !context.swap_id.is_nil(),
+            "approval requires route, leg and swap identities"
+        );
+        ensure!(
+            !lifetime.is_zero() && lifetime <= MAX_LIFETIME,
+            "approval lifetime must be positive and at most five minutes"
+        );
+        ensure!(details.is_object(), "approval details must be an object");
+        ensure!(
+            serde_json::to_vec(&details)?.len() <= MAX_DETAILS_BYTES,
+            "approval details exceed size limit"
+        );
+        let expires_at_ms = SystemTime::now()
+            .checked_add(lifetime)
+            .context("approval expiration overflow")?
+            .duration_since(UNIX_EPOCH)?
+            .as_millis()
+            .try_into()?;
+        let deadline = Instant::now() + lifetime;
+        let request_id = Uuid::new_v4();
+        let request = ReviewRequest {
+            schema: "monzero-route-approval-v1",
+            request_id,
+            context,
+            expires_at_ms,
+            details,
+        };
+        let commitment = format!("{:x}", Sha256::digest(serde_json::to_vec(&request)?));
+        let review = ApprovalReview { request, commitment };
+        let (responder, receiver) = oneshot::channel();
+        let mut pending = self.pending.lock().map_err(|_| anyhow::anyhow!("approval lock poisoned"))?;
+        pending.retain(|_, entry| entry.deadline > Instant::now());
+        ensure!(pending.len() < MAX_PENDING, "too many pending approvals");
+        pending.insert(request_id, Pending {
+            review: review.clone(),
+            deadline,
+            responder: Some(responder),
+        });
+        Ok((review, ApprovalWaiter {
+            pending: self.pending.clone(), request_id, deadline, receiver: Some(receiver),
+        }))
+    }
+
+    /// A reply is accepted once, only for the precise envelope still pending.
+    /// It remains revocable until the waiting execution consumes it.
+    pub fn resolve(&self, request_id: Uuid, commitment: &str, approve: bool) -> Result<()> {
+        let mut pending = self.pending.lock().map_err(|_| anyhow::anyhow!("approval lock poisoned"))?;
+        pending.retain(|_, entry| entry.deadline > Instant::now());
+        let entry = pending.get_mut(&request_id).context("approval is no longer pending")?;
+        ensure!(entry.review.commitment == commitment, "approval commitment differs from review");
+        entry.responder.take().context("approval already answered")?
+            .send(approve).map_err(|_| anyhow::anyhow!("approval waiter disconnected"))
+    }
+
+    pub fn pending_reviews(&self) -> Result<Vec<ApprovalReview>> {
+        let mut pending = self.pending.lock().map_err(|_| anyhow::anyhow!("approval lock poisoned"))?;
+        pending.retain(|_, entry| entry.deadline > Instant::now());
+        Ok(pending.values().filter(|entry| entry.responder.is_some())
+            .map(|entry| entry.review.clone()).collect())
+    }
+
+    /// Cancel all unconsumed replies, including replies already queued for a
+    /// waiter. Use on disconnect, quote/balance change or route abandonment.
+    pub fn invalidate_all(&self) -> Result<()> {
+        self.pending.lock().map_err(|_| anyhow::anyhow!("approval lock poisoned"))?.clear();
+        Ok(())
+    }
+}
+
+impl Drop for ApprovalSession {
+    fn drop(&mut self) {
+        if let Ok(mut pending) = self.pending.lock() {
+            pending.clear();
+        }
+    }
+}
+
+impl ApprovalWaiter {
+    pub async fn wait(mut self) -> Result<bool> {
+        let receiver = self.receiver.take().context("approval already awaited")?;
+        let answer = tokio::time::timeout_at(self.deadline, receiver).await
+            .context("approval expired")?.context("approval cancelled")?;
+        let mut pending = self.pending.lock()
+            .map_err(|_| anyhow::anyhow!("approval lock poisoned"))?;
+        let entry = pending.remove(&self.request_id).context("approval invalidated before consumption")?;
+        ensure!(entry.deadline > Instant::now(), "approval expired before consumption");
+        Ok(answer)
+    }
+}
+
+impl Drop for ApprovalWaiter {
+    fn drop(&mut self) {
+        if let Ok(mut pending) = self.pending.lock() {
+            pending.remove(&self.request_id);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
