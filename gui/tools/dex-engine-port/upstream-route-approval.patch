@@ -0,0 +1,142 @@
+use super::*;
+use serde_json::json;
+
+fn context(purpose: ApprovalPurpose) -> ApprovalContext {
+    ApprovalContext { route_id: Uuid::new_v4(), leg_id: Uuid::new_v4(), swap_id: Uuid::new_v4(), purpose }
+}
+
+fn begin(session: &ApprovalSession) -> (ApprovalReview, ApprovalWaiter) {
+    session.begin(context(ApprovalPurpose::SelectMaker), json!({"btcAtoms": "12345"}), Duration::from_secs(30)).unwrap()
+}
+
+#[tokio::test]
+async fn exact_review_required_and_reply_is_single_use() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = begin(&session);
+    assert_eq!(session.pending_reviews().unwrap().len(), 1);
+    assert!(session.resolve(review.request_id(), &"0".repeat(64), true).is_err());
+    session.resolve(review.request_id(), review.commitment(), true).unwrap();
+    assert!(session.pending_reviews().unwrap().is_empty());
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+    assert!(waiter.wait().await.unwrap());
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+}
+
+#[tokio::test]
+async fn cancellation_revokes_even_an_already_queued_yes() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = begin(&session);
+    session.resolve(review.request_id(), review.commitment(), true).unwrap();
+    session.invalidate_all().unwrap();
+    assert!(waiter.wait().await.is_err());
+    let (replacement, replacement_waiter) = begin(&session);
+    assert!(session.resolve(replacement.request_id(), review.commitment(), true).is_err());
+    session.resolve(replacement.request_id(), replacement.commitment(), false).unwrap();
+    assert!(!replacement_waiter.wait().await.unwrap());
+}
+
+#[tokio::test]
+async fn dropped_waiter_and_disconnected_session_reject_replies() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = begin(&session);
+    drop(waiter);
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+    let (review, waiter) = begin(&session);
+    session.invalidate_all().unwrap();
+    assert!(waiter.wait().await.is_err());
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+}
+
+#[tokio::test]
+async fn dropping_session_revokes_queued_and_unanswered_requests() {
+    let session = ApprovalSession::default();
+    let (review, answered) = begin(&session);
+    let (_, unanswered) = begin(&session);
+    session.resolve(review.request_id(), review.commitment(), true).unwrap();
+    drop(session);
+    assert!(answered.wait().await.is_err());
+    assert!(unanswered.wait().await.is_err());
+}
+
+#[tokio::test]
+async fn timeout_removes_request_and_late_reply_fails() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = session.begin(context(ApprovalPurpose::LockBitcoin), json!({}), Duration::from_millis(1)).unwrap();
+    assert!(waiter.wait().await.is_err());
+    assert!(session.pending_reviews().unwrap().is_empty());
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+}
+
+#[tokio::test]
+async fn expiry_revokes_a_reply_waiting_to_be_consumed() {
+    let session = ApprovalSession::default();
+    let (review, mut waiter) = begin(&session);
+    session.resolve(review.request_id(), review.commitment(), true).unwrap();
+    let expired = Instant::now() - Duration::from_secs(1);
+    session.pending.lock().unwrap().get_mut(&review.request_id()).unwrap().deadline = expired;
+    waiter.deadline = expired;
+    assert!(waiter.wait().await.is_err());
+}
+
+#[tokio::test]
+async fn aborting_waiting_execution_invalidates_its_request() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = begin(&session);
+    let task = tokio::spawn(waiter.wait());
+    tokio::task::yield_now().await;
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert!(session.pending_reviews().unwrap().is_empty());
+    assert!(session.resolve(review.request_id(), review.commitment(), true).is_err());
+}
+
+#[tokio::test]
+async fn another_session_cannot_resolve_request() {
+    let session = ApprovalSession::default();
+    let (review, waiter) = begin(&session);
+    assert!(ApprovalSession::default().resolve(review.request_id(), review.commitment(), true).is_err());
+    session.resolve(review.request_id(), review.commitment(), false).unwrap();
+    assert!(!waiter.wait().await.unwrap());
+}
+
+#[test]
+fn commitment_covers_identity_purpose_expiry_and_terms() {
+    let session = ApprovalSession::default();
+    let (review, _waiter) = begin(&session);
+    let changes: [fn(&mut ReviewRequest); 8] = [
+        |request| request.request_id = Uuid::new_v4(),
+        |request| request.context.route_id = Uuid::new_v4(),
+        |request| request.context.leg_id = Uuid::new_v4(),
+        |request| request.context.swap_id = Uuid::new_v4(),
+        |request| request.context.purpose = ApprovalPurpose::LockBitcoin,
+        |request| request.expires_at_ms += 1,
+        |request| request.details["btcAtoms"] = json!("12346"),
+        |request| request.schema = "different-schema",
+    ];
+    for change in changes {
+        let mut altered = review.request.clone();
+        change(&mut altered);
+        let altered_commitment = format!("{:x}", Sha256::digest(serde_json::to_vec(&altered).unwrap()));
+        assert_ne!(review.commitment(), altered_commitment);
+    }
+    assert_eq!(review.commitment(), format!("{:x}", Sha256::digest(serde_json::to_vec(&review.request).unwrap())));
+}
+
+#[test]
+fn requests_are_bounded_and_require_explicit_identity() {
+    let session = ApprovalSession::default();
+    let mut invalid = context(ApprovalPurpose::SelectMaker);
+    invalid.swap_id = Uuid::nil();
+    assert!(session.begin(invalid, json!({}), Duration::from_secs(1)).is_err());
+    for duration in [Duration::ZERO, MAX_LIFETIME + Duration::from_secs(1)] {
+        assert!(session.begin(context(ApprovalPurpose::SelectMaker), json!({}), duration).is_err());
+    }
+    for details in [Value::Null, json!({"large": "x".repeat(MAX_DETAILS_BYTES)})] {
+        assert!(session.begin(context(ApprovalPurpose::SelectMaker), details, Duration::from_secs(1)).is_err());
+    }
+    let mut waiters = Vec::new();
+    for _ in 0..MAX_PENDING { waiters.push(begin(&session).1); }
+    assert!(session.begin(context(ApprovalPurpose::SelectMaker), json!({}), Duration::from_secs(1)).is_err());
+    waiters.pop();
+    let _replacement = begin(&session);
+}
