+/// Trusted fixture pins, not identities or policy adopted from a checkpoint.
+pub fn reserve_fixture_execution(directory:&std::path::Path,swap:Uuid,quote:VerifiedQuote,record:&[u8])
+    -> Result<swap_machine::native_execution_claim::ExecutionClaim> {
+    let commitment=*quote.commitment();
+    let b=SigningKey::from_bytes(&[1;32]).verifying_key().to_bytes();
+    let x=SigningKey::from_bytes(&[2;32]).verifying_key().to_bytes();
+    let policy=policy();
+    let context=swap_machine::native_execution_claim::RecoveryContext {
+        swap_id:swap,commitment:&commitment,policy:&policy,btc_key:&b,xmz_key:&x,
+        btc_network:bitcoin::Network::Regtest,xmz_network:swap_core::xmz_address::XmzNetwork::Mainnet,
+    };
+    swap_machine::native_execution_claim::ExecutionClaim::reserve_recoverable(directory,quote,&context,now()?,record)
+}
