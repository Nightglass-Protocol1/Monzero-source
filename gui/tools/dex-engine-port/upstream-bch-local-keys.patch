+//! Initial local keys must be retained before sending the signed public proof.
+//! Plaintext private storage, not an execution owner or permission to fund.
+use super::*;
+use crate::litecoin_rpc::reservation::Journal;
+use native_wallet::{NativeWalletKeys,OwnedNativeWallet};
+use sha2::{Digest,Sha256};
+use std::path::Path;
+use zeroize::{Zeroize,Zeroizing};
+
+const SCHEMA: &str = "monzero-bch-local-keys-v1";
+
+/// No Debug or implicit serialization. The digest must be pinned independently
+/// before sending; restoring this object does not restore transport authority.
+pub struct RetainedLocalKeys { state: State, proof: AuthenticatedNativeAdaptor, digest: [u8;32] }
+
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    schema: String, quote_record: Vec<u8>, role: Role, admitted_at: u64,
+    contract: [u8;32], spend: [u8;32], view: [u8;32],
+    proof: Vec<u8>, signature: Vec<u8>,
+}
+impl Drop for State {
+    fn drop(&mut self) { self.contract.zeroize(); self.spend.zeroize(); self.view.zeroize(); }
+}
+
+fn name(quote: &VerifiedBchQuote, role: Role) -> String {
+    format!("{}.bch-local-keys-{}",quote.terms()["swapId"],role.domain())
+}
+fn digest(bytes: &[u8]) -> Result<[u8;32]> {
+    ensure!(!bytes.is_empty() && bytes.len() <= 2_000_000,"invalid BCH local key record size");
+    let mut hash = Sha256::new(); hash.update(SCHEMA); hash.update([0]); hash.update(bytes);
+    Ok(hash.finalize().into())
+}
+fn native_key(bytes: &[u8;32]) -> Result<monero::PrivateKey> {
+    let key = monero::PrivateKey::from_slice(bytes)
+        .map_err(|_|anyhow::anyhow!("invalid retained BCH native scalar"))?;
+    ensure!(key.as_bytes() == *bytes && *bytes != [0;32],"noncanonical or zero BCH native scalar");
+    Ok(key)
+}
+fn validate(state: &State, quote: &VerifiedBchQuote, policy: &Policy, role: Role)
+    -> Result<AuthenticatedNativeAdaptor> {
+    ensure!(state.schema == SCHEMA && state.role == role && state.quote_record == quote.record()?,
+        "BCH local keys belong to another admission");
+    let proof = AuthenticatedNativeAdaptor::verify(&state.proof,&state.signature,quote,policy,state.admitted_at,role)?;
+    let contract = bitcoin::secp256k1::SecretKey::from_slice(&state.contract)?;
+    let public = bitcoin::secp256k1::PublicKey::from_secret_key(&bitcoin::secp256k1::Secp256k1::new(),&contract);
+    let signer = match role {Role::BchFunder=>quote.recovery_plan().terms().bch_funder_signing_key,
+        Role::NativeFunder=>quote.recovery_plan().terms().native_funder_signing_key};
+    ensure!(public == signer,"retained BCH contract secret differs from quote");
+    let spend = native_key(&state.spend)?;
+    native_key(&state.view)?;
+    ensure!(monero::PublicKey::from_private_key(&spend).decompress().compress().to_bytes() == proof.binding.native,
+        "retained BCH spend share differs from proof");
+    let mut bytes = Zeroizing::new(state.spend); bytes.reverse();
+    let scalar = ecdsa_fun::fun::Scalar::from_bytes(*bytes).context("invalid retained BCH adaptor scalar")?
+        .non_zero().context("zero retained BCH adaptor scalar")?;
+    ensure!(ecdsa_fun::ECDSA::verify_only().verification_key_for(&scalar) == proof.binding.adaptor,
+        "retained BCH scalar differs from proven adaptor");
+    Ok(proof)
+}
+
+impl RetainedLocalKeys {
+    /// The caller supplies the already quoted contract key and signed local
+    /// proof. A conflicting record never causes replacement or key regeneration.
+    /// Retry with identical original admission data, or restore using its pin.
+    pub fn persist(directory: &Path, quote: &VerifiedBchQuote, policy: &Policy, now: u64,
+        role: Role, contract: bitcoin::secp256k1::SecretKey, spend: monero::PrivateKey,
+        view: monero::PrivateViewKey, proof: &[u8], signature: &[u8]) -> Result<Self> {
+        let state = State {schema:SCHEMA.into(),quote_record:quote.record()?,role,admitted_at:now,
+            contract:contract.secret_bytes(),spend:spend.as_bytes(),view:view.0.as_bytes(),
+            proof:proof.to_vec(),signature:signature.to_vec()};
+        let proof = validate(&state,quote,policy,role)?;
+        let bytes = Zeroizing::new(serde_json::to_vec(&state)?);
+        let digest = digest(&bytes)?;
+        Journal::open(directory)?.retain(&name(quote,role),&bytes)?;
+        Ok(Self {state,proof,digest})
+    }
+
+    /// Original quote/policy/role and expected digest are independently trusted.
+    /// Historical restore is allowed after expiry; outgoing proofs are not.
+    pub fn restore(directory: &Path, quote: &VerifiedBchQuote, policy: &Policy,
+        role: Role, expected: &[u8;32]) -> Result<Self> {
+        let bytes = Zeroizing::new(Journal::open(directory)?.read(&name(quote,role))?);
+        ensure!(&digest(&bytes)? == expected,"BCH local key digest mismatch");
+        let state: State = serde_json::from_slice(&bytes)
+            .map_err(|_|anyhow::anyhow!("invalid BCH local key encoding"))?;
+        ensure!(Zeroizing::new(serde_json::to_vec(&state)?).as_slice() == bytes.as_slice(),
+            "noncanonical BCH local key record");
+        let proof = validate(&state,quote,policy,role)?;
+        Ok(Self {state,proof,digest:*expected})
+    }
+
+    pub fn commitment(&self) -> &[u8;32] { &self.digest }
+
+    /// Exact originally signed proof, never regenerated on retry. The driver
+    /// must still enforce its durable outgoing cursor and private peer session.
+    pub fn outgoing_proof(&self, quote: &VerifiedBchQuote, policy: &Policy, now: u64)
+        -> Result<(&[u8],&[u8])> {
+        quote.check_policy(policy,now)?;
+        ensure!(now >= self.state.admitted_at && self.proof.quote_commitment == *quote.commitment(),
+            "BCH retained proof admission mismatch");
+        Ok((&self.state.proof,&self.state.signature))
+    }
+
+    /// Retain the same local proof and keys through completed wallet binding.
+    /// A re-signed/re-proven exchange using the same spend key is not equivalent.
+    pub fn bind_wallet(&self, quote: &VerifiedBchQuote, wallet: NativeWalletKeys) -> Result<OwnedNativeWallet> {
+        ensure!(self.proof.quote_commitment == *quote.commitment()
+            && wallet.local_proof_commitment(self.state.role) == &self.proof.proof_commitment,
+            "BCH wallet differs from retained local proof");
+        wallet.bind_local(quote,self.state.role,bitcoin::secp256k1::SecretKey::from_slice(&self.state.contract)?,
+            native_key(&self.state.spend)?,monero::PrivateViewKey(native_key(&self.state.view)?))
+    }
+}
