+#[test]
+fn initial_keys_reject_reproof_replacement_and_corrupt_records() -> Result<()> {
+    use super::super::local_keys::RetainedLocalKeys;
+    let mut setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let contract = bitcoin::secp256k1::SecretKey::from_slice(&[3;32])?;
+    let retained = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,Role::BchFunder,
+        contract,setup.spend[0],setup.view[0],&setup.frames[0],&setup.signatures[0])?;
+    let pin = *retained.commitment();
+    let original_view = setup.view[0];
+    setup.view[0] = monero::PrivateViewKey::new_random(&mut rand::thread_rng());
+    assert!(retained.bind_wallet(&setup.quote,setup.wallet()?).is_err());
+    assert!(RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,Role::BchFunder,
+        contract,setup.spend[0],setup.view[0],&setup.frames[0],&setup.signatures[0]).is_err());
+    setup.view[0] = original_view;
+    // Fresh valid proof for the SAME scalar changes the exchange transcript.
+    let scalar = curve25519_dalek_ng::scalar::Scalar::from_canonical_bytes(setup.spend[0].as_bytes()).unwrap();
+    let (proof,(secp,edwards)) = CROSS_CURVE_PROOF_SYSTEM.prove(&scalar,&mut rand::thread_rng());
+    setup.frames[0] = super::super::frame(&setup.quote,Role::BchFunder,secp.into(),edwards.compress().to_bytes(),proof)?;
+    setup.signatures[0] = sign(&setup.frames[0],Role::BchFunder,false);
+    assert!(retained.bind_wallet(&setup.quote,setup.wallet()?).is_err());
+    assert!(RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,Role::BchFunder,
+        contract,setup.spend[0],setup.view[0],&setup.frames[0],&setup.signatures[0]).is_err());
+    let restored = RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&pin)?;
+    assert_ne!(restored.outgoing_proof(&setup.quote,&setup.policy,1000)?.0,setup.frames[0].as_slice());
+    let path = std::fs::read_dir(&directory.0)?.next().unwrap()?.path();
+    std::fs::write(&path,b"{")?;
+    assert!(RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&pin).is_err());
+    assert!(RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,Role::BchFunder,
+        contract,setup.spend[0],setup.view[0],&setup.frames[0],&setup.signatures[0]).is_err());
+    assert_eq!(std::fs::read(&path)?,b"{");
+    std::fs::remove_file(&path)?;
+    assert!(RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,Role::BchFunder,&pin).is_err());
+    Ok(())
+}
