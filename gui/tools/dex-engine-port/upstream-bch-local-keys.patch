+#[cfg(target_os="linux")]
+#[test]
+fn retained_initial_keys_complete_the_same_exchange_after_restore() -> Result<()> {
+    use super::super::local_keys::RetainedLocalKeys;
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    for (index,role) in [(0,Role::BchFunder),(1,Role::NativeFunder)] {
+        let contract = bitcoin::secp256k1::SecretKey::from_slice(&[3+index as u8;32])?;
+        let retained = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,role,
+            contract,setup.spend[index],setup.view[index],&setup.frames[index],&setup.signatures[index])?;
+        let pin = *retained.commitment();
+        assert_eq!(retained.outgoing_proof(&setup.quote,&setup.policy,1001)?,
+            (setup.frames[index].as_slice(),setup.signatures[index].as_slice()));
+        let retry = RetainedLocalKeys::persist(&directory.0,&setup.quote,&setup.policy,1000,role,
+            contract,setup.spend[index],setup.view[index],&setup.frames[index],&setup.signatures[index])?;
+        assert_eq!(*retry.commitment(),pin);
+        drop(retained); drop(retry);
+        let restored = RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,role,&pin)?;
+        assert!(restored.outgoing_proof(&setup.quote,&setup.policy,999).is_err());
+        assert!(restored.outgoing_proof(&setup.quote,&setup.policy,2000).is_err());
+        let owned = restored.bind_wallet(&setup.quote,setup.wallet()?)?;
+        let ack = owned.acknowledgement(&setup.quote)?;
+        let context = owned.accept_agreement(&setup.quote,&setup.policy,1001,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+        let complete_pin = agreement::storage::persist(&directory.0,&setup.quote,&setup.policy,role,&context)?;
+        let complete = agreement::storage::restore(&directory.0,&setup.quote,&setup.policy,role,&complete_pin)?;
+        assert_eq!(complete.owned().native_spend_share().as_bytes(),setup.spend[index].as_bytes());
+        assert_eq!(complete.owned().private_view_share().0.as_bytes(),setup.view[index].0.as_bytes());
+        let mut wrong_pin = pin; wrong_pin[0] ^= 1;
+        assert!(RetainedLocalKeys::restore(&directory.0,&setup.quote,&setup.policy,role,&wrong_pin).is_err());
+    }
+    Ok(())
+}
