+#[test]
+fn initial_keys_reject_invalid_secrets_before_publication() -> Result<()> {
+    use super::super::local_keys::RetainedLocalKeys;
+    let setup = Setup::new()?; let directory = PrivateStore::new()?;
+    let contract = bitcoin::secp256k1::SecretKey::from_slice(&[3;32])?;
+    let persist = |role,now,contract,spend,view| RetainedLocalKeys::persist(&directory.0,&setup.quote,
+        &setup.policy,now,role,contract,spend,view,&setup.frames[0],&setup.signatures[0]);
+    assert!(persist(Role::NativeFunder,1000,contract,setup.spend[0],setup.view[0]).is_err());
+    assert!(persist(Role::BchFunder,1000,bitcoin::secp256k1::SecretKey::from_slice(&[4;32])?,setup.spend[0],setup.view[0]).is_err());
+    assert!(persist(Role::BchFunder,1000,contract,setup.spend[1],setup.view[0]).is_err());
+    let zero = monero::PrivateViewKey(monero::PrivateKey::from_scalar(monero::Scalar::ZERO));
+    assert!(persist(Role::BchFunder,1000,contract,setup.spend[0],zero).is_err());
+    assert!(persist(Role::BchFunder,2000,contract,setup.spend[0],setup.view[0]).is_err());
+    assert_eq!(std::fs::read_dir(&directory.0)?.count(),0);
+    Ok(())
