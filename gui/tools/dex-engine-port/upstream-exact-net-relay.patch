+            json!({"transfer_type":"available","account_index":request.source.account})).await?;
+        super::full_proceeds::top_up_inputs(&incoming,&request,&string(&terms,"topUpTxid")?)?;
+        self.check_wallet(&policy).await?;
+        ensure!(self.client.snapshot().await?==before,"exact-net relay chain changed");
+        self.dispatched=true;
+        classify_prepared_broadcast(self.client.rpc(self.client.wallet,"relay_tx",
+            json!({"hex":metadata.as_str()})).await, summary)
     }
 
