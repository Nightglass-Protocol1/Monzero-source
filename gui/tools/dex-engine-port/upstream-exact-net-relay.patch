+/// One-shot in-memory capability; constructed only after durable preparation.
+/// No decode, clone or restoration API. Retained files still require reconciliation.
+/// ```compile_fail
+/// use swap_machine::native_funding_rpc::{relay::NativeTransferRelay, full_proceeds::PreparedExactNet};
+/// async fn bypass_journal(relay: &mut NativeTransferRelay, prepared: PreparedExactNet) {
+///     relay.relay_exact_net(prepared).await.unwrap();
+/// }
+/// ```
+pub struct JournaledExactNet {
+    journal: ExactNetJournal,
+    prepared: PreparedExactNet,
+}
+impl JournaledExactNet {
+    pub(super) fn into_parts(self) -> (PreparedExactNet,ExactNetJournal) {
+        (self.prepared,self.journal)
+    }
+}
+
 impl ExactNetJournal {
