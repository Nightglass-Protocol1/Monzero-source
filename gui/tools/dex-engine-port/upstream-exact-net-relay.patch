+    /// Even a preflight failure consumes the capability; it does not clear intent.
+    pub async fn relay_exact_net(&mut self,
+        journaled: super::exact_net_journal::JournaledExactNet) -> Result<RelayedTransfer> {
+        ensure!(!self.dispatched,"relay instance already dispatched; reconcile before retrying");
+        let (prepared,_journal)=journaled.into_parts();
+        let summary=RelayedTransfer { txid:string(prepared.terms(),"txid")?,
+            fee:prepared.preview().network_fee,weight:number(prepared.terms(),"weight")? };
+        let (request,terms,metadata)=prepared.into_relay_parts();
+        let genesis=string(&terms,"genesis")?;
+        let before=self.client.snapshot().await?;
+        ensure!(before.genesis==genesis && canonical_hash(&before.tip_hash),"unexpected exact-net relay chain");
+        let policy=RelayRequest { wallet:request.source.wallet.clone(),destination:request.source.destination.clone(),
+            amount:request.source.locked,account:request.source.account,priority:request.source.priority };
