+    fn retained_context(book:&AddressBook,retained:&RetainedReview,operation:uuid::Uuid)->Result<(sha256::Hash,Option<u32>)> {
+        let commitment:sha256::Hash=retained.signing_commitment.parse()?;
+        ensure!(commitment.to_string()==retained.signing_commitment,"noncanonical Litecoin signing commitment");
+        let change_index=if let Some(address)=&retained.change_address {
+            let saved=book.reserved(operation,Branch::Change)?.context("missing retained Litecoin change allocation")?;
+            ensure!(saved.address().to_string()==*address,"retained Litecoin change address mismatch");
+            match saved.path().into_iter().last() {
+                Some(ChildNumber::Normal {index})=>Some(*index),
+                _=>anyhow::bail!("invalid retained Litecoin change path"),
+            }
+        } else {None};
+        Ok((commitment,change_index))
+    }
+    fn payment_view(network:LtcNetwork,address:&str,output:&TxOut,tx:&Transaction,fee:Amount,commitment:sha256::Hash)->Result<Value> {
+        let change=tx.output.get(1);
+        let change_address=change.map(|out|LtcSegwitAddress::from_script(network,&out.script_pubkey).map(|a|a.to_string())).transpose()?;
+        Ok(json!({"watchOnly":true,"spendable":false,"prepared":true,"signed":false,
+            "paymentAddress":address,"paymentAtomic":output.value.to_sat().to_string(),
+            "feeAtomic":fee.to_sat().to_string(),"changeAddress":change_address,
+            "changeAtomic":change.map(|out|out.value.to_sat()).unwrap_or(0).to_string(),
+            "inputCount":tx.input.len(),"txid":tx.compute_txid().to_string(),"signingCommitment":commitment.to_string()}))
+    }
+    // Offline signature recovery is not a fresh unspentness, broadcast or
+    // confirmation assessment. No seed is unlocked and no bytes are re-signed.
+    fn recover_signed(config:&Config,network:LtcNetwork,payment:&Payment,operation:uuid::Uuid,retained:&RetainedReview)->Result<Value> {
+        let address=LtcSegwitAddress::parse(network,&payment.address)?;
+        let output=TxOut {value:atomic(&payment.amount_atomic)?,script_pubkey:address.script_pubkey().clone()};
+        let fee=atomic(&payment.fee_atomic)?;let minimum_change=atomic(&payment.minimum_change_atomic)?;
+        ensure!(output.value.to_sat()>0 && minimum_change.to_sat()>0 && payment.minimum_confirmations>0,"invalid Litecoin recovery policy");
+        let wallet=config.wallet.as_ref().context("missing Litecoin wallet configuration")?;
+        let directory=wallet.spend_directory.as_ref().context("missing explicit Litecoin spend directory")?;
+        let account=PublicAccount::from_descriptor(&wallet.account,network)?;
+        let book=AddressBook::open(&wallet.address_book_directory,PublicAccount::from_descriptor(&wallet.account,network)?)?;
+        let (commitment,change_index)=retained_context(&book,retained,operation)?;
+        let claimed=ClaimedSpend::open(directory,operation,&account,&output,change_index,fee,commitment)?;
+        ensure!(claimed.fee()==fee && claimed.transaction().output.get(1).is_none_or(|out|out.value>=minimum_change),
+            "retained Litecoin payment policy mismatch");
+        let signed=claimed.load_signed()?;
+        let mut response=payment_view(network,&address.to_string(),&output,&signed,claimed.fee(),commitment)?;
+        response["signed"]=json!(true);response["recovered"]=json!(true);response["broadcastStatus"]=json!("unassessed");
+        Ok(response)
+    }
