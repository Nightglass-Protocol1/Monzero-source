+use super::*;
+use agreement::execution::funding::recovery::cancel::CancelRelayState;
+
+pub(super) async fn exercise(setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,
+    server: &Server,rpc: &BchRpc,signed: &SignedFunding) -> Result<()> {
+    for mode in [0,1,2] {
+        let copied=PrivateStore::new()?;
+        for entry in std::fs::read_dir(&metadata.0)? {
+            let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),copied.0.join(entry.file_name()))?;}
+        }
+        let mut execution=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let recovery=execution.retained_bch_recovery()?.context("missing fixture recovery")?;
+        let cancel=recovery.cancel();let txid=cancel.compute_txid();
+        let intent=copied.0.join(format!("{}.bch-cancel-relay-intent",setup.quote.terms()["swapId"]));
+        let ack=copied.0.join(format!("{}.bch-cancel-relay-ack",setup.quote.terms()["swapId"]));
+        {
+            let mut state=server.state.lock().unwrap();state.cancel=Some(cancel.clone());state.relay_mode=mode;
+            state.observed=Some(signed.transaction().clone());state.observed_vout=signed.lock_outpoint().vout;
+            state.observation_mode=23;state.observation_chain_calls=0;state.relay_intent=Some(intent.clone());state.locked=true;
+        }
+        let calls=server.state.lock().unwrap().cancel_relay_calls;
+        let review=execution.review_bch_cancel_relay(rpc,2040)?;
+        assert_eq!(review.details["action"],"broadcast-bch-cancellation");assert_eq!(review.details["txid"],txid.to_string());
+        assert_eq!(review.details["recoveryAtoms"],"99000");assert_eq!(review.details["feeAtoms"],"1000");
+        assert_eq!(review.details["cancelDelayBlocks"],20);
+        for private in ["refund","refundBytes","signature","nativeSpendShare"] {assert!(review.details.get(private).is_none());}
+        assert!(execution.bch_cancel_relay_state()?.is_none());
+        let mut bad=review.commitment;bad[0]^=1;
+        assert!(execution.relay_bch_cancel(rpc,&bad,2041).await.is_err());assert!(!intent.exists());
+        if mode==0 {
+            assert!(rpc.relay_cancellation(cancel,std::time::Instant::now()).await.is_err());
+            for observed in [0,1,2,3,24] {
+                server.state.lock().unwrap().observation_mode=observed;
+                assert!(execution.relay_bch_cancel(rpc,&review.commitment,2041).await.is_err());
+                assert!(!intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls);
+            }
+            server.state.lock().unwrap().observation_mode=23;
+        }
+        let result=execution.relay_bch_cancel(rpc,&review.commitment,2041).await;
+        assert!(intent.exists());assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        let expected=if mode==0 {
+            assert_eq!(result?,txid);assert!(ack.exists());CancelRelayState::Acknowledged {txid}
+        } else {assert!(result.is_err());assert!(!ack.exists());CancelRelayState::Attempted {txid}};
+        assert_eq!(execution.bch_cancel_relay_state()?,Some(expected));drop(execution);
+        let mut restored=AdmittedExecution::resume(&copied.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        assert_eq!(restored.bch_cancel_relay_state()?,Some(expected));
+        assert!(restored.relay_bch_cancel(rpc,&review.commitment,2040).await.is_err());
+        let result=restored.relay_bch_cancel(rpc,&review.commitment,2042).await;
+        if mode==0 {assert_eq!(result?,txid);} else {assert!(result.is_err());}
+        assert_eq!(server.state.lock().unwrap().cancel_relay_calls,calls+1);
+        if mode==0 {
+            let saved=std::fs::read(&ack)?;std::fs::write(&ack,b"{}")?;
+            assert!(restored.bch_cancel_relay_state().is_err());std::fs::write(&ack,saved)?;
+            let held=copied.0.join("held-cancel-intent");std::fs::rename(&intent,&held)?;
+            assert!(restored.bch_cancel_relay_state().is_err());std::fs::rename(&held,&intent)?;
+        }
+    }
+    let mut state=server.state.lock().unwrap();state.cancel=None;state.observed=None;
+    state.observation_mode=0;state.relay_mode=0;state.relay_intent=None;
+    Ok(())
+}
