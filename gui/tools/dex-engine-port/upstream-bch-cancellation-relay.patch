+//! Explicit cancellation forwards BCH into the retained recovery covenant.
+//! It reveals no native spend share and never releases the private refund.
+use super::*;
+use crate::bch_rpc::BchRpc;
+use swap_core::bch::funding::SignedFunding;
+use serde_json::{Value,json};
+
+const REVIEW: &str="monzero-bch-cancel-relay-review-v1";
+const ATTEMPT: &str="monzero-bch-cancel-relay-intent-v1";
+const ACK: &str="monzero-bch-cancel-relay-ack-v1";
+pub struct CancelRelayReview {pub details: Value,pub commitment: [u8;32]}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum CancelRelayState {Attempted {txid: Txid},Acknowledged {txid: Txid}}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Attempt {schema: String,review: [u8;32],approved_at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ack {schema: String,attempt: [u8;32],txid: Txid}
+fn slot(quote: &VerifiedBchQuote,part: &str) -> String {format!("{}.bch-cancel-relay-{part}",quote.terms()["swapId"])}
+
+impl AdmittedExecution<'_> {
+    fn cancel_relay_materials(&self) -> Result<(CancelRelayReview,Transaction,SignedFunding,u64,[u8;32])> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH cancellation role");
+        let recovery=self.retained_bch_recovery()?.context("missing private BCH recovery")?;
+        let funding=self.signed_bch_funding()?.context("missing signed BCH funding")?;
+        let prepared=self.prepared_bch_funding()?.context("missing BCH funding preparation")?;
+        let (locked,_)=self.funding_lock_intent(&prepared)?;
+        let cancel=recovery.cancel().clone();let plan=self.quote.recovery_plan();
+        ensure!(cancel.input.len()==1 && cancel.output.len()==1 && cancel.input[0].previous_output==funding.lock_outpoint()
+            && cancel.input[0].sequence.to_consensus_u32()==u32::from(plan.terms().cancel_delay_blocks),"BCH cancellation shape or sequence changed");
+        let output=&cancel.output[0];let fee=plan.terms().locked_atoms.checked_sub(output.value.to_sat()).context("invalid BCH cancellation fee")?;
+        ensure!(fee==plan.terms().lock_fee_atoms && output.script_pubkey==plan.recovery().script_pubkey(),"BCH cancellation recovery output changed");
+        let details=json!({"schema":REVIEW,"action":"broadcast-bch-cancellation",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),"admission":self.admission_digest()?,
+            "privateRecovery":recovery.commitment(),"bchDeployment":locked.deployment,"bchNetwork":self.quote.terms()["bchNetwork"],
+            "bchGenesis":self.quote.terms()["bchGenesis"],"fundingOutpoint":funding.lock_outpoint(),"txid":cancel.compute_txid(),
+            "recoveryScript":output.script_pubkey.to_hex_string(),"recoveryAtoms":output.value.to_sat().to_string(),"feeAtoms":fee.to_string(),
+            "cancelDelayBlocks":plan.terms().cancel_delay_blocks,"minimumBchConfirmations":self.policy.bch_confirmations,
+            "preparedAt":recovery.prepared_at()});
+        let commitment=hash(REVIEW,&serde_json::to_vec(&details)?);
+        Ok((CancelRelayReview {details,commitment},cancel,funding,recovery.prepared_at(),locked.deployment))
+    }
+    /// Offline review is not maturity evidence or refund release authority.
+    pub fn review_bch_cancel_relay(&self,bch: &BchRpc,now: u64) -> Result<CancelRelayReview> {
+        let (review,_,_,prepared_at,deployment)=self.cancel_relay_materials()?;
+        ensure!(now>=prepared_at && bch.deployment_commitment()?==deployment,"BCH cancellation review predates preparation or changes observer");
+        Ok(review)
+    }
+    fn cancel_attempt(&self,review: &CancelRelayReview,prepared_at: u64) -> Result<Option<(Attempt,[u8;32])>> {
+        let Some(bytes)=optional(&self.metadata,&slot(self.quote,"intent"))? else {return Ok(None)};
+        ensure!(bytes.len()<=4096,"oversized BCH cancellation intent");let attempt: Attempt=serde_json::from_slice(&bytes)?;
+        ensure!(attempt.schema==ATTEMPT && attempt.review==review.commitment && attempt.approved_at>=prepared_at
+            && serde_json::to_vec(&attempt)?==bytes,"BCH cancellation intent changed");
+        Ok(Some((attempt,hash(ATTEMPT,&bytes))))
+    }
+    fn cancel_state(&self,review: &CancelRelayReview,prepared_at: u64,txid: Txid) -> Result<Option<CancelRelayState>> {
+        let ack=optional(&self.metadata,&slot(self.quote,"ack"))?;
+        let Some((_,attempt))=self.cancel_attempt(review,prepared_at)? else {
+            ensure!(ack.is_none(),"BCH cancellation acknowledgement lacks intent");return Ok(None)
+        };
+        let Some(bytes)=ack else {return Ok(Some(CancelRelayState::Attempted {txid}))};
+        ensure!(bytes.len()<=4096,"oversized BCH cancellation acknowledgement");let ack: Ack=serde_json::from_slice(&bytes)?;
+        ensure!(ack.schema==ACK && ack.attempt==attempt && ack.txid==txid && serde_json::to_vec(&ack)?==bytes,"BCH cancellation acknowledgement changed");
+        Ok(Some(CancelRelayState::Acknowledged {txid}))
+    }
+    pub fn bch_cancel_relay_state(&self) -> Result<Option<CancelRelayState>> {
+        let (review,cancel,_,at,_)=self.cancel_relay_materials()?;self.cancel_state(&review,at,cancel.compute_txid())
+    }
+    /// No native payment is required to cancel a mature abandoned BCH lock.
+    /// Secret-bearing refund release remains a separate two-chain decision.
+    pub async fn relay_bch_cancel(&mut self,bch: &BchRpc,approved: &[u8;32],now: u64) -> Result<Txid> {
+        let (review,cancel,funding,prepared_at,deployment)=self.cancel_relay_materials()?;
+        ensure!(*approved==review.commitment,"BCH cancellation approval is stale or mismatched");
+        ensure!(now>=prepared_at && bch.deployment_commitment()?==deployment,"BCH cancellation predates preparation or changes observer");
+        if let Some((attempt,_))=self.cancel_attempt(&review,prepared_at)? {ensure!(now>=attempt.approved_at,"BCH cancellation time moved backwards");}
+        match self.cancel_state(&review,prepared_at,cancel.compute_txid())? {
+            Some(CancelRelayState::Acknowledged {txid})=>return Ok(txid),
+            Some(CancelRelayState::Attempted {..})=>anyhow::bail!("BCH cancellation result is uncertain; reconcile without retransmitting"),
+            None=>(),
+        }
+        let deadline=std::time::Instant::now().checked_add(std::time::Duration::from_secs(30)).context("BCH cancellation deadline overflow")?;
+        let live=tokio::time::timeout_at(deadline.into(),bch.observe_funding(&funding)).await.context("BCH cancellation observation timed out")??;
+        live.require_cancel_maturity(u64::from(self.policy.bch_confirmations),u32::from(self.policy.cancel_blocks))?;
+        ensure!(std::time::Instant::now()<deadline,"BCH cancellation evidence expired before intent");
+        let bytes=serde_json::to_vec(&Attempt {schema:ATTEMPT.into(),review:*approved,approved_at:now})?;
+        self.metadata.retain(&slot(self.quote,"intent"),&bytes)?;
+        let txid=bch.relay_cancellation(&cancel,deadline).await?;
+        self.metadata.retain(&slot(self.quote,"ack"),&serde_json::to_vec(&Ack {schema:ACK.into(),attempt:hash(ATTEMPT,&bytes),txid})?)?;
+        Ok(txid)
+    }
+}
