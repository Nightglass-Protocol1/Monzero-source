+//! Bounded fork discovery and incremental candidate download. Selection happens
+//! only after the entire candidate connects to its reported tip. Reaching that
+//! tip does not establish freshness, checkpoints or the network's best chain.
+use super::*;
+use crate::litecoin_light::headers::{HeaderSequence, ChainChange};
+
+/// A peer claim, never a validated chain tip or a spendability capability.
+pub struct ReportedTip { network: LtcNetwork, height: u32, hash: BlockHash }
+impl ReportedTip {
+    pub fn height(&self) -> u32 {self.height}
+    pub fn hash(&self) -> BlockHash {self.hash}
+}
+
+/// The selected chain remains unchanged while this candidate downloads.
+/// Errors/cancellation invalidate this attempt; use a fresh connection and tip.
+pub struct SyncCandidate { chain: HeaderSequence, tip: ReportedTip, usable: bool }
+impl SyncCandidate {
+    pub fn height(&self) -> u32 {self.chain.height()}
+    pub fn target_height(&self) -> u32 {self.tip.height}
+    pub fn complete(&self) -> bool {
+        self.usable && self.height()==self.tip.height && self.chain.contains(self.tip.height,self.tip.hash)
+    }
+    /// At most 2016 headers per call. Empty data before the advertised tip is
+    /// inconsistent, not evidence of completion. No partial candidate is selected.
+    pub async fn advance<S: AsyncRead+AsyncWrite+Unpin>(&mut self,session: &mut ReadSession<S>,
+        count: u32,now: u64) -> Result<u32> {
+        ensure!(self.usable,"Litecoin synchronization candidate is invalid");
+        ensure!(session.network==self.tip.network && (1..=2016).contains(&count),
+            "invalid Litecoin candidate request");
+        if self.complete() {return Ok(0)}
+        let count=count.min(self.tip.height-self.height());
+        self.usable=false;
+        let outcome=async {
+            let received=session.advance(&mut self.chain,count,now).await?;
+            ensure!(received>0,"Electrum stopped before reported tip");
+            if self.height()==self.tip.height {
+                ensure!(self.chain.contains(self.tip.height,self.tip.hash),"Electrum reported tip changed during synchronization");
+            }
+            Ok::<_,anyhow::Error>(received)
+        }.await;
+        if outcome.is_ok() {self.usable=true;} else {session.usable=false;}
+        outcome
+    }
+    /// Even a complete candidate is adopted only if it has more validated work.
+    /// Callers must then invalidate orphaned evidence and persist the selection.
+    pub fn finish(self,selected: &mut HeaderSequence) -> Result<Option<ChainChange>> {
+        ensure!(self.complete(),"Litecoin synchronization candidate is incomplete");
+        selected.adopt(self.chain)
+    }
+}
+
+impl<S: AsyncRead+AsyncWrite+Unpin> ReadSession<S> {
+    /// Consumes this connection: subscription notifications cannot interfere
+    /// with later request/response exchanges. Use a fresh connection to download.
+    pub async fn reported_tip(mut self) -> Result<ReportedTip> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Tip {height:u32,hex:String}
+        let (_,bytes)=self.exchange("blockchain.headers.subscribe",json!([]),1024).await?;
+        let tip: Tip=result(&bytes)?;
+        let raw=decode_hex(&tip.hex,80)?;
+        ensure!(raw.len()==80,"invalid Electrum reported header length");
+        let header: Header=deserialize(&raw)?;
+        Ok(ReportedTip {network:self.network,height:tip.height,hash:header.block_hash()})
+    }
+    /// Binary-search the last shared header in at most 32 bounded requests.
+    /// Peer search replies are only hints: candidate ancestry and work are
+    /// subsequently validated from the retained prefix, ending at the claimed tip.
+    pub async fn begin_sync(&mut self,selected: &HeaderSequence,tip: ReportedTip) -> Result<SyncCandidate> {
+        ensure!(selected.network()==self.network && tip.network==self.network,
+            "Litecoin synchronization network mismatch");
+        let outcome=self.begin_sync_inner(selected,tip).await;
+        if outcome.is_err() {self.usable=false;}
+        outcome
+    }
+    async fn begin_sync_inner(&mut self,selected: &HeaderSequence,tip: ReportedTip) -> Result<SyncCandidate> {
+        ensure!(self.usable,"Electrum session requires a new connection");
+        let mut low=0u32;let mut high=selected.height().min(tip.height);
+        while low<high {
+            let middle=low+((u64::from(high)-u64::from(low)+1)/2) as u32;
+            let (_,bytes)=self.exchange("blockchain.block.header",json!([middle]),1024).await?;
+            let raw=decode_hex(&result::<String>(&bytes)?,80)?;
+            ensure!(raw.len()==80,"invalid Electrum fork header length");
+            let header: Header=deserialize(&raw)?;
+            if selected.contains(middle,header.block_hash()) {low=middle;} else {high=middle-1;}
+        }
+        let chain=selected.fork(low)?;
+        if low==tip.height {ensure!(chain.contains(low,tip.hash),"Electrum reported tip contradicts shared chain");}
+        Ok(SyncCandidate {chain,tip,usable:true})
+    }
+}
