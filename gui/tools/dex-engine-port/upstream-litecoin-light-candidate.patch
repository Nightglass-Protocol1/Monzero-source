+use super::*;
+use crate::litecoin_light::{headers::tests::child, session::tests::{server,reply,hex,regtest_handshake}};
+fn alternative() -> Header {let mut header=child();header.nonce=0;header}
+fn descendant() -> Header {
+    deserialize(&decode_hex("000000209d08f789f2afaf053878d9b21add2f847fff4a9c32fb58b8c5c79ca166f94a9d111111111111111111111111111111111111111111111111111111111111111106e7494dffff7f2000000000",80).unwrap()).unwrap()
+}
+fn tip(height: u32,header: Header) -> ReportedTip {
+    ReportedTip {network:LtcNetwork::Regtest,height,hash:header.block_hash()}
+}
+fn batch(id: u64,headers: &[Header]) -> Vec<u8> {
+    reply(id,json!({"count":headers.len(),"hex":hex(&headers.iter().flat_map(serialize).collect::<Vec<_>>()),"max":2016}))
+}
+#[tokio::test]
+async fn sync_tip_uses_disposable_subscription_and_strict_shape() -> Result<()> {
+    let mut responses=regtest_handshake();responses.push(reply(3,json!({"height":2,"hex":hex(&serialize(&descendant()))})));
+    let (stream,task)=server(responses);
+    let reported=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.reported_tip().await?;
+    assert_eq!(reported.height(),2);assert_eq!(reported.hash(),descendant().block_hash());
+    let requests=task.await?;assert_eq!(requests.len(),3);
+    assert_eq!(requests[2]["method"],"blockchain.headers.subscribe");assert_eq!(requests[2]["params"],json!([]));
+    for value in [json!({"height":-1,"hex":hex(&serialize(&child()))}),json!({"height":1,"hex":"00"}),
+        json!({"height":1,"hex":hex(&serialize(&child())),"work":"untrusted"})] {
+        let mut responses=regtest_handshake();responses.push(reply(3,value));let (stream,task)=server(responses);
+        assert!(ReadSession::negotiate(stream,LtcNetwork::Regtest).await?.reported_tip().await.is_err());
+        assert_eq!(task.await?.len(),3);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn sync_downloads_in_bounded_steps_before_selection() -> Result<()> {
+    let mut responses=regtest_handshake();responses.push(batch(3,&[alternative()]));responses.push(batch(4,&[descendant()]));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut candidate=session.begin_sync(&selected,tip(2,descendant())).await?;
+    assert_eq!(candidate.height(),0);assert_eq!(candidate.target_height(),2);assert!(!candidate.complete());
+    assert_eq!(candidate.advance(&mut session,1,1296688902).await?,1);
+    assert_eq!(candidate.height(),1);assert!(!candidate.complete());assert_eq!(selected.height(),0);
+    assert_eq!(candidate.advance(&mut session,2016,1296688902).await?,1);assert!(candidate.complete());
+    assert_eq!(candidate.advance(&mut session,1,1296688902).await?,0);
+    assert_eq!(candidate.finish(&mut selected)?.unwrap().new_tip,(2,descendant().block_hash()));
+    drop(session);let requests=task.await?;assert_eq!(requests.len(),4);
+    assert_eq!(requests[2]["params"],json!([1,1]));assert_eq!(requests[3]["params"],json!([2,1]));Ok(())
+}
+#[tokio::test]
+async fn sync_discovers_fork_and_selects_only_more_work() -> Result<()> {
+    let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;selected.append(&serialize(&child()),1296688902)?;
+    let mut responses=regtest_handshake();responses.push(reply(3,json!(hex(&serialize(&alternative())))));
+    responses.push(batch(4,&[alternative(),descendant()]));let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut candidate=session.begin_sync(&selected,tip(2,descendant())).await?;assert_eq!(candidate.height(),0);
+    candidate.advance(&mut session,2,1296688902).await?;assert!(selected.contains(1,child().block_hash()));
+    assert_eq!(candidate.finish(&mut selected)?.unwrap().common_ancestor,0);
+    assert!(selected.contains(1,alternative().block_hash()));drop(session);assert_eq!(task.await?.len(),4);
+    // The server can also advertise a shorter competing branch. It cannot replace more work.
+    let mut responses=regtest_handshake();responses.push(reply(3,json!(hex(&serialize(&child())))));responses.push(batch(4,&[child()]));
+    let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let mut candidate=session.begin_sync(&selected,tip(1,child())).await?;
+    candidate.advance(&mut session,1,1296688902).await?;assert!(candidate.finish(&mut selected)?.is_none());
+    assert_eq!(selected.height(),2);drop(session);assert_eq!(task.await?.len(),4);Ok(())
+}
+#[tokio::test]
+async fn sync_matching_tip_requires_no_download_and_never_claims_freshness() -> Result<()> {
+    let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;selected.append(&serialize(&child()),1296688902)?;
+    let mut responses=regtest_handshake();responses.push(reply(3,json!(hex(&serialize(&child())))));let (stream,task)=server(responses);
+    let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let candidate=session.begin_sync(&selected,tip(1,child())).await?;
+    assert!(candidate.complete());assert!(candidate.finish(&mut selected)?.is_none());
+    drop(session);assert_eq!(task.await?.len(),3);Ok(())
+}
+#[tokio::test]
+async fn sync_refuses_empty_or_changed_tip_and_keeps_selected_chain() -> Result<()> {
+    for changed in [false,true] {
+        let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;
+        let mut advertised=child();if changed {advertised.nonce=0;}
+        let mut responses=regtest_handshake();responses.push(if changed {batch(3,&[child()])} else {batch(3,&[])});
+        let (stream,task)=server(responses);let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+        let mut candidate=session.begin_sync(&selected,tip(1,advertised)).await?;
+        assert!(candidate.advance(&mut session,1,1296688902).await.is_err());assert!(!candidate.complete());
+        assert!(!session.usable);assert!(candidate.advance(&mut session,1,1296688902).await.is_err());
+        assert!(candidate.finish(&mut selected).is_err());assert_eq!(selected.height(),0);
+        drop(session);assert_eq!(task.await?.len(),3);
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn sync_rejects_network_budget_and_incomplete_selection_without_io() -> Result<()> {
+    let (stream,task)=server(regtest_handshake());let mut session=ReadSession::negotiate(stream,LtcNetwork::Regtest).await?;
+    let other=HeaderSequence::new(LtcNetwork::Mainnet)?;
+    assert!(session.begin_sync(&other,tip(1,child())).await.is_err());
+    let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut candidate=session.begin_sync(&selected,tip(1,child())).await?;
+    for count in [0,2017,u32::MAX] {assert!(candidate.advance(&mut session,count,1296688902).await.is_err());}
+    assert!(candidate.finish(&mut selected).is_err());assert_eq!(selected.height(),0);
+    assert!(session.usable);drop(session);assert_eq!(task.await?.len(),2);Ok(())
+}
+#[tokio::test]
+async fn sync_cancelled_candidate_cannot_be_finished_or_reused() -> Result<()> {
+    let (stream,_peer)=tokio::io::duplex(4096);
+    let mut session=ReadSession {stream:BufReader::new(stream),network:LtcNetwork::Regtest,next_id:1,usable:true,timeout:Duration::from_secs(1)};
+    let mut selected=HeaderSequence::new(LtcNetwork::Regtest)?;
+    let mut candidate=session.begin_sync(&selected,tip(1,child())).await?;
+    assert!(tokio::time::timeout(Duration::from_millis(20),candidate.advance(&mut session,1,1296688902)).await.is_err());
+    assert!(!candidate.complete());assert!(candidate.advance(&mut session,1,1296688902).await.is_err());
+    assert!(candidate.finish(&mut selected).is_err());assert_eq!(selected.height(),0);assert!(!session.usable);Ok(())
+}
