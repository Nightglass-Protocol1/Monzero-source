+    /// Bind an expected output to confirmed legacy bytes and the current UTXO
+    /// view, including pending spends. Reobserve before any subsequent action.
+    /// This does not establish CLTV activation, coinbase maturity or refund safety.
+    pub async fn confirmed_unspent_output(&self, outpoint: OutPoint, block: BlockHash,
+        minimum: u64, expected: &TxOut) -> Result<ConfirmedUnspentOutput> {
+        ensure!(!outpoint.is_null() && expected.value > Amount::ZERO
+            && expected.value.to_sat() <= 1_000_000_000_000_000_000,
+            "invalid Dogecoin output expectation");
+        let funding = self.confirmed_transaction(outpoint.txid, block, minimum).await?;
+        ensure!(funding.transaction.output.get(outpoint.vout as usize) == Some(expected),
+            "Dogecoin funding output differs from expected terms");
+        let observed: Option<UnspentOutput> = self.rpc("gettxout",
+            json!([outpoint.txid.to_string(), outpoint.vout, true])).await?;
+        let observed = observed.context("Dogecoin output absent or spent, including pending spends")?;
+        ensure!(observed.bestblock == funding.tip && observed.confirmations == funding.confirmations,
+            "Dogecoin output observation differs from confirmed funding");
+        // Parse the original decimal JSON token without converting through f64.
+        let amount = Amount::from_str_in(observed.value.get(), Denomination::Bitcoin)
+            .context("invalid exact Dogecoin output amount")?;
+        ensure!(amount == expected.value && ScriptBuf::from_hex(&observed.script.hex)? == expected.script_pubkey,
+            "Dogecoin unspent output differs from confirmed funding");
+        let after = self.chain().await?;
+        ensure!(after.bestblockhash == funding.tip, "Dogecoin tip changed during output observation");
+        Ok(ConfirmedUnspentOutput { funding, outpoint })
     }
 
