+//! Intersect candidates with a same-tip observation snapshot. Omitted history
+//! remains possible; the result is still not a spending capability.
+use super::*;
+use crate::litecoin_light::accounting::ObservedWallet;
+/// Exclude outputs absent from the observed unspent set (including observed
+/// confirmed/pending spends). A stale snapshot fails; it is never refreshed
+/// implicitly. The caller remains responsible for completeness and freshness.
+pub fn retain_observed_candidates(chain:&HeaderSequence,observed:&ObservedWallet,
+    candidates:Vec<IncludedCandidate>)->Result<Vec<IncludedCandidate>> {
+    ensure!(observed.height()==chain.height() && chain.contains(observed.height(),observed.tip()),
+        "Litecoin observation tip differs from selected chain");
+    ensure!(candidates.len()<=1000,"Litecoin candidate reconciliation limit exceeded");
+    let coins=observed.coins().iter().map(|coin|(coin.outpoint(),coin)).collect::<BTreeMap<_,_>>();
+    let mut seen=BTreeSet::new();let mut retained=Vec::new();
+    for candidate in candidates {
+        ensure!(seen.insert(candidate.outpoint()),"duplicate Litecoin reconciliation candidate");
+        let depth=candidate.transaction().confirmations_on(chain).context("orphaned Litecoin reconciliation candidate")?;
+        let Some(coin)=coins.get(&candidate.outpoint()) else {continue};
+        ensure!(coin.amount()==candidate.value() && coin.confirmations()==depth
+            && coin.is_coinbase()==candidate.transaction().is_coinbase(),"Litecoin candidate observation mismatch");
+        if coin.maturity_satisfied() {retained.push(candidate);}
+    }
+    Ok(retained)
+}
