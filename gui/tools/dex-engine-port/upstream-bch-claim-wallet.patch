+//! Dedicated wallet lifecycle for recovered native keys. No transaction
+//! construction or payout authority. Restore attempt is durable before RPC.
+use super::*;
+use crate::native_funding_rpc::wallet_session::{NativeWalletSession,SwapWalletId};
+
+const INTENT: &str = "monzero-bch-native-claim-wallet-intent-v1";
+const READY: &str = "monzero-bch-native-claim-wallet-ready-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {schema: String,binding: [u8;32],at: u64}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ready {schema: String,intent: [u8;32]}
+fn name(quote: &VerifiedBchQuote,suffix: &str) -> String {
+    format!("{}.bch-native-claim-wallet-{suffix}",quote.terms()["swapId"])
+}
+fn key_hex(bytes: &[u8;32]) -> String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+impl NativeClaim {
+    async fn check_wallet(&self,session: &mut NativeWalletSession) -> Result<()> {
+        session.verify_spend_key(&self.spend,&self.address).await?;
+        session.import_transaction(&self.native_txid,&self.address).await
+    }
+}
+impl AdmittedExecution<'_> {
+    fn claim_wallet_binding(&self,claim: &NativeClaim,id: &SwapWalletId) -> Result<[u8;32]> {
+        // Stable across a reorganization that reconfirms the same exact spend
+        // in another block. Fresh chain evidence is required separately below.
+        Ok(hash(INTENT,&serde_json::to_vec(&json!({"quote":self.quote.commitment(),
+            "admission":self.admission_digest()?,"wallet":id.filename(),"address":claim.address.to_string(),
+            "nativePayment":claim.native_txid,"redemption":claim.redemption}))?))
+    }
+    fn claim_wallet_intent(&self,binding: &[u8;32],now: u64) -> Result<Option<[u8;32]>> {
+        let Some(bytes)=optional(&self.metadata,&name(self.quote,"intent"))? else {
+            ensure!(optional(&self.metadata,&name(self.quote,"ready"))?.is_none(),
+                "BCH claim wallet readiness lacks original intent");return Ok(None)
+        };
+        ensure!(bytes.len()<=4096,"oversized BCH claim wallet intent");
+        let intent: Intent=serde_json::from_slice(&bytes)?;
+        ensure!(intent.schema==INTENT && intent.binding==*binding && now>=intent.at
+            && serde_json::to_vec(&intent)?==bytes,"BCH claim wallet intent changed or time moved backwards");
+        let digest=hash(INTENT,&bytes);
+        if let Some(bytes)=optional(&self.metadata,&name(self.quote,"ready"))? {
+            ensure!(bytes.len()<=4096,"oversized BCH claim wallet readiness");
+            let ready: Ready=serde_json::from_slice(&bytes)?;
+            ensure!(ready.schema==READY && ready.intent==digest && serde_json::to_vec(&ready)?==bytes,
+                "BCH claim wallet readiness changed");
+        }
+        Ok(Some(digest))
+    }
+    fn retain_claim_wallet_ready(&self,intent: [u8;32]) -> Result<()> {
+        self.metadata.retain(&name(self.quote,"ready"),&serde_json::to_vec(&Ready {schema:READY.into(),intent})?)
+    }
+    /// One restore attempt only. Errors may have created/opened the wallet.
+    /// Reconcile through explicit open/check; never fall back to restoration.
+    pub async fn restore_bch_claim_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        redemption: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession,password: String) -> Result<()> {
+        let password=Zeroizing::new(password);
+        let claim=self.recover_bch_native_claim(native,bch,redemption,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.claim_wallet_binding(&claim,&id)?;
+        ensure!(self.claim_wallet_intent(&binding,now)?.is_none(),"BCH claim wallet restore was already attempted; open/check explicitly");
+        session.preflight_restore(&password,&claim.address).await?;
+        let bytes=serde_json::to_vec(&Intent {schema:INTENT.into(),binding,at:now})?;
+        self.metadata.retain(&name(self.quote,"intent"),&bytes)?;
+        session.restore(&id,key_hex(&claim.spend),key_hex(&claim.view),0,password.to_string(),&claim.address).await?;
+        claim.check_wallet(session).await?;
+        self.retain_claim_wallet_ready(hash(INTENT,&bytes))
+    }
+    /// Caller supplies an exclusively owned empty session. A failed open is not
+    /// permission to generate a replacement wallet or change recovered keys.
+    pub async fn open_bch_claim_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        redemption: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession,password: String) -> Result<()> {
+        let password=Zeroizing::new(password);
+        let claim=self.recover_bch_native_claim(native,bch,redemption,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.claim_wallet_binding(&claim,&id)?;
+        let intent=self.claim_wallet_intent(&binding,now)?.context("missing original BCH claim wallet intent")?;
+        session.open(&id,password.to_string(),&claim.address).await?;
+        claim.check_wallet(session).await?;self.retain_claim_wallet_ready(intent)
+    }
+    /// Reconcile an already-open wallet using an explicitly re-established
+    /// exclusive session. Same-session uncertainty remains an error in adapter.
+    pub async fn check_bch_claim_wallet(&mut self,native: &impl FundingObserver,bch: &BchRpc,
+        redemption: Txid,block: Option<BlockHash>,now: u64,session: &mut NativeWalletSession) -> Result<()> {
+        let claim=self.recover_bch_native_claim(native,bch,redemption,block,now).await?;
+        let id=SwapWalletId::new(self.quote.terms()["swapId"].parse()?)?;
+        let binding=self.claim_wallet_binding(&claim,&id)?;
+        let intent=self.claim_wallet_intent(&binding,now)?.context("missing original BCH claim wallet intent")?;
+        claim.check_wallet(session).await?;self.retain_claim_wallet_ready(intent)
+    }
+}
