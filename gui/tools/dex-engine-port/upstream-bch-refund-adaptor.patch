+//! Write-once refund adaptor preparation, outgoing signature and peer receipt.
+//! No funding publication, success-signature release, decryption or relay.
+use super::*;
+use crate::bch_key_recovery::authenticated::SignedFrame;
+use ecdsa_fun::adaptor::EncryptedSignature;
+
+const PREPARED: &str = "monzero-bch-refund-preparation-v1";
+const SIGNED: &str = "monzero-bch-refund-authenticated-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Preparation { schema: String, admission: [u8;32], prepared_at: u64, frame: Vec<u8> }
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Receipt { schema: String, admission: [u8;32], signed: SignedFrame }
+
+pub struct OutgoingRefund { frame: Vec<u8>, signature: Vec<u8> }
+impl OutgoingRefund {
+    pub fn frame(&self) -> &[u8] { &self.frame }
+    pub fn signature(&self) -> &[u8] { &self.signature }
+}
+fn name(quote: &VerifiedBchQuote,role: Role,stage: &str) -> String {
+    format!("{}.bch-refund-{}-{stage}",quote.terms()["swapId"],role.domain())
+}
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+impl AdmittedExecution<'_> {
+    fn refund_context(&self, now: u64) -> Result<([u8;32],AgreedNativeWallet)> {
+        let admission = self.read_admission()?;
+        self.quote.check_policy(self.policy,now)?;
+        ensure!(now >= admission.admitted_at,"BCH refund stage predates execution admission");
+        let mut hash = Sha256::new(); hash.update(b"monzero-bch-refund-admission-v1\0");
+        hash.update(serde_json::to_vec(&admission)?);
+        Ok((hash.finalize().into(),self.restore_agreement()?))
+    }
+    fn refund_preparation(&self,bytes: &[u8]) -> Result<Preparation> {
+        ensure!(self.role == Role::NativeFunder && bytes.len() <= 16384,"invalid BCH refund preparation owner or size");
+        let state: Preparation = serde_json::from_slice(bytes)?;
+        let (admission,agreed) = self.refund_context(state.prepared_at)?;
+        ensure!(state.schema == PREPARED && state.admission == admission
+            && serde_json::to_vec(&state)? == bytes,"BCH refund preparation changed");
+        agreed.check_refund_frame(self.quote,&state.frame)?;
+        Ok(state)
+    }
+    fn refund_receipt(&self,bytes: &[u8]) -> Result<(Receipt,EncryptedSignature)> {
+        ensure!(bytes.len() <= 16384,"oversized BCH refund receipt");
+        let state: Receipt = serde_json::from_slice(bytes)?;
+        let (admission,agreed) = self.refund_context(state.signed.admitted_at)?;
+        ensure!(state.schema == SIGNED && state.admission == admission
+            && serde_json::to_vec(&state)? == bytes,"BCH refund receipt changed");
+        let encrypted = agreed.check_signed_refund(self.quote,&state.signed.bytes,&state.signed.signature)?;
+        if self.role == Role::NativeFunder {
+            let prepared = self.refund_preparation(&self.metadata.read(&name(self.quote,self.role,"prepared"))?)?;
+            ensure!(state.signed.admitted_at >= prepared.prepared_at && state.signed.bytes == prepared.frame,
+                "BCH outgoing refund differs from retained preparation");
+        }
+        Ok((state,encrypted))
+    }
+
+    /// Retain the encrypted refund frame before exposing bytes for identity
+    /// signing. This does not produce a BCH success signature or funding offer.
+    pub fn prepare_bch_refund_adaptor(&mut self,now: u64) -> Result<Vec<u8>> {
+        ensure!(self.role == Role::NativeFunder,"only native funder prepares BCH refund protection");
+        let (admission,agreed) = self.refund_context(now)?;
+        let slot = name(self.quote,self.role,"prepared");
+        if let Some(bytes) = optional(&self.metadata,&slot)? {
+            let state = self.refund_preparation(&bytes)?;
+            ensure!(now >= state.prepared_at,"BCH refund preparation time moved backwards");
+            return Ok(state.frame)
+        }
+        let frame = agreed.refund_frame(self.quote)?;
+        let state = Preparation {schema:PREPARED.into(),admission,prepared_at:now,frame:frame.clone()};
+        self.metadata.retain(&slot,&serde_json::to_vec(&state)?)?;
+        Ok(frame)
+    }
+
+    /// Retain the identity signature before exposing an outgoing refund frame.
+    /// Repeated calls return the original message only, never a replacement.
+    pub fn retain_outgoing_bch_refund(&mut self,now: u64,signature: &[u8]) -> Result<OutgoingRefund> {
+        ensure!(self.role == Role::NativeFunder,"only native funder sends BCH refund protection");
+        let (admission,agreed) = self.refund_context(now)?;
+        let prepared = self.refund_preparation(&self.metadata.read(&name(self.quote,self.role,"prepared"))?)?;
+        ensure!(now >= prepared.prepared_at,"BCH refund signature predates preparation");
+        agreed.check_signed_refund(self.quote,&prepared.frame,signature)?;
+        let slot = name(self.quote,self.role,"authenticated");
+        if let Some(bytes) = optional(&self.metadata,&slot)? {
+            let (old,_) = self.refund_receipt(&bytes)?;
+            ensure!(now >= old.signed.admitted_at && old.signed.signature == signature,"BCH outgoing refund already retained differently");
+            return Ok(OutgoingRefund {frame:old.signed.bytes.clone(),signature:old.signed.signature.clone()})
+        }
+        let state = Receipt {schema:SIGNED.into(),admission,
+            signed:SignedFrame {bytes:prepared.frame.clone(),signature:signature.to_vec(),admitted_at:now}};
+        self.metadata.retain(&slot,&serde_json::to_vec(&state)?)?;
+        Ok(OutgoingRefund {frame:prepared.frame,signature:signature.to_vec()})
+    }
+
+    /// Accept only the native funder's authenticated refund adaptor for this
+    /// exact agreement. Persist before returning protection to funding logic.
+    pub fn accept_bch_refund_adaptor(&mut self,now: u64,frame: &[u8],signature: &[u8]) -> Result<EncryptedSignature> {
+        ensure!(self.role == Role::BchFunder,"only BCH funder accepts peer refund protection");
+        let (admission,agreed) = self.refund_context(now)?;
+        let encrypted = agreed.check_signed_refund(self.quote,frame,signature)?;
+        let slot = name(self.quote,self.role,"authenticated");
+        if let Some(bytes) = optional(&self.metadata,&slot)? {
+            let (old,encrypted) = self.refund_receipt(&bytes)?;
+            ensure!(now >= old.signed.admitted_at && old.signed.bytes == frame && old.signed.signature == signature,
+                "BCH received refund already retained differently");
+            return Ok(encrypted)
+        }
+        let state = Receipt {schema:SIGNED.into(),admission,
+            signed:SignedFrame {bytes:frame.to_vec(),signature:signature.to_vec(),admitted_at:now}};
+        self.metadata.retain(&slot,&serde_json::to_vec(&state)?)?;
+        Ok(encrypted)
+    }
+
+    /// Historical restoration revalidates the original admission time, never
+    /// renews quote expiry and never publishes a signature or funding bytes.
+    pub fn received_bch_refund_adaptor(&self) -> Result<Option<EncryptedSignature>> {
+        ensure!(self.role == Role::BchFunder,"wrong BCH refund receipt owner");
+        optional(&self.metadata,&name(self.quote,self.role,"authenticated"))?
+            .map(|bytes|self.refund_receipt(&bytes).map(|(_,encrypted)|encrypted)).transpose()
+    }
+}
