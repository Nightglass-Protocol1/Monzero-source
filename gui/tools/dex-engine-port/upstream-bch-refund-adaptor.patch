+//! Native-funder encrypted refund protection, before BCH funding publication.
+//! This frame contains no success signature, private key or signed funding bytes.
+use super::*;
+const DOMAIN: &str = "monzero-bch-refund-adaptor-v1";
+const MAX: usize = 8192;
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    schema: String, quote: [u8;32], agreement: [u8;32], swap: String,
+    encrypted: EncryptedSignature,
+}
+pub fn signing_bytes(frame: &[u8]) -> Result<Vec<u8>> {
+    ensure!(!frame.is_empty() && frame.len() <= MAX,"invalid BCH refund frame size");
+    let mut message = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:",DOMAIN.len(),DOMAIN,frame.len()).into_bytes();
+    message.extend_from_slice(frame); Ok(message)
+}
+impl AgreedNativeWallet {
+    pub(super) fn refund_frame(&self, quote: &VerifiedBchQuote) -> Result<Vec<u8>> {
+        ensure!(self.owned.role == Role::NativeFunder,"only native funder prepares BCH refund protection");
+        let frame = Frame {schema:DOMAIN.into(),quote:*quote.commitment(),agreement:self.commitment,
+            swap:quote.terms()["swapId"].clone(),encrypted:self.owned.prepare_encrypted_signature(quote)?};
+        let bytes = serde_json::to_vec(&serde_json::to_value(frame)?)?;
+        self.check_refund_frame(quote,&bytes)?;
+        Ok(bytes)
+    }
+    pub(super) fn check_refund_frame(&self, quote: &VerifiedBchQuote, bytes: &[u8]) -> Result<EncryptedSignature> {
+        ensure!(!bytes.is_empty() && bytes.len() <= MAX,"invalid BCH refund frame size");
+        let frame: Frame = serde_json::from_slice(bytes)?;
+        ensure!(frame.schema == DOMAIN && frame.quote == *quote.commitment()
+            && self.owned.wallet.pair.bch.quote_commitment == *quote.commitment()
+            && frame.agreement == self.commitment && frame.swap == quote.terms()["swapId"]
+            && serde_json::to_vec(&serde_json::to_value(&frame)?)? == bytes,"BCH refund frame context mismatch");
+        let covenant = quote.recovery_plan().recovery();
+        let signer = Point::from_bytes(covenant.terms().signing_key.serialize()).context("invalid BCH refund signing key")?;
+        covenant.data_message().verify_encrypted(&signer,&self.owned.wallet.pair.bch.binding.adaptor,&frame.encrypted)?;
+        Ok(frame.encrypted)
+    }
+    pub(super) fn check_signed_refund(&self, quote: &VerifiedBchQuote, bytes: &[u8], signature: &[u8])
+        -> Result<EncryptedSignature> {
+        let encrypted = self.check_refund_frame(quote,bytes)?;
+        let identity = &quote.terms()[Role::NativeFunder.identity()];
+        let mut pin = [0;32];
+        for (i,byte) in pin.iter_mut().enumerate() { *byte = u8::from_str_radix(&identity[i*2..i*2+2],16)?; }
+        VerifyingKey::from_bytes(&pin)?.verify_strict(&signing_bytes(bytes)?,&Signature::from_slice(signature)?)?;
+        Ok(encrypted)
+    }
+}
