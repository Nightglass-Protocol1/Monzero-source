+use super::*;
+use agreement::execution::{AdmittedExecution,NegotiationPins};
+
+fn identity_signature(frame: &[u8],role: Role) -> Vec<u8> {
+    let key = SigningKey::from_bytes(&[if role == Role::NativeFunder {2} else {1};32]);
+    key.sign(&agreement::refund::signing_bytes(frame).unwrap()).to_bytes().to_vec()
+}
+fn admit_pair<'a>(setup: &'a Setup,snapshots: &std::path::Path,bmeta: &std::path::Path,nmeta: &std::path::Path)
+    -> Result<(AdmittedExecution<'a>,AdmittedExecution<'a>)> {
+    let (b,bv,bpin) = selected_with_outgoing(setup,snapshots,0)?;
+    let (n,nv,npin) = selected_with_outgoing(setup,snapshots,1)?;
+    let mut admitted = Vec::new();
+    for (role,selected,own,peer,initial,metadata) in [
+        (Role::BchFunder,&b,&bv,&nv,bpin,bmeta),(Role::NativeFunder,&n,&nv,&bv,npin,nmeta)] {
+        let (wallet,received) = selected.retain_received_view(snapshots,&setup.quote,&setup.policy,
+            1003,own.commitment(),peer.frame(),peer.signature())?;
+        let ack = wallet.acknowledgement(&setup.quote)?;
+        let agreed = wallet.accept_agreement(&setup.quote,&setup.policy,1004,&ack,
+            &ack_sign(&ack,Role::BchFunder),&ack_sign(&ack,Role::NativeFunder))?;
+        let agreement = agreement::storage::persist(snapshots,&setup.quote,&setup.policy,role,&agreed)?;
+        let pins = NegotiationPins {initial,selection:*selected.commitment(),outgoing:*own.commitment(),received,agreement};
+        admitted.push(AdmittedExecution::admit(metadata,snapshots,&setup.quote,&setup.policy,
+            role,setup.quote.commitment(),pins,1005)?);
+    }
+    let native = admitted.pop().unwrap(); let bch = admitted.pop().unwrap(); Ok((bch,native))
+}
+
+#[test]
+fn refund_adaptor_exchange_is_authenticated_retained_and_restored_without_success_release() -> Result<()> {
+    let setup = Setup::new()?; let snapshots = PrivateStore::new()?;
+    let bmeta = PrivateStore::new()?; let nmeta = PrivateStore::new()?;
+    let (mut b,mut n) = admit_pair(&setup,&snapshots.0,&bmeta.0,&nmeta.0)?;
+    assert!(b.received_bch_refund_adaptor()?.is_none());
+    assert!(b.prepare_bch_refund_adaptor(1006).is_err());
+    assert!(n.received_bch_refund_adaptor().is_err());
+    assert!(n.prepare_bch_refund_adaptor(1004).is_err());
+    assert!(n.prepare_bch_refund_adaptor(2000).is_err());
+    let frame = n.prepare_bch_refund_adaptor(1006)?;
+    let value: serde_json::Value = serde_json::from_slice(&frame)?;
+    assert_eq!(value.as_object().unwrap().len(),5); // Only public context and encrypted refund.
+    assert!(value.get("funding").is_none()); assert!(value.get("success").is_none());
+    assert_eq!(n.prepare_bch_refund_adaptor(1007)?,frame);
+    let signature = identity_signature(&frame,Role::NativeFunder);
+    let wrong = identity_signature(&frame,Role::BchFunder);
+    assert!(n.retain_outgoing_bch_refund(1007,&wrong).is_err());
+    assert!(n.retain_outgoing_bch_refund(1005,&signature).is_err());
+    assert!(b.accept_bch_refund_adaptor(1007,&frame,&wrong).is_err());
+    assert!(n.accept_bch_refund_adaptor(1007,&frame,&signature).is_err());
+    for field in ["quote","agreement","swap","schema"] {
+        let mut changed = value.clone();
+        changed[field] = if field=="quote" || field=="agreement" {serde_json::to_value([0u8;32])?} else {serde_json::json!("other")};
+        let changed = serde_json::to_vec(&changed)?;
+        assert!(b.accept_bch_refund_adaptor(1007,&changed,&identity_signature(&changed,Role::NativeFunder)).is_err());
+    }
+    let mut success = value.clone();
+    success["encrypted"] = serde_json::to_value(b.restore_agreement()?.owned().prepare_encrypted_signature(&setup.quote)?)?;
+    let success = serde_json::to_vec(&success)?;
+    assert!(b.accept_bch_refund_adaptor(1007,&success,&identity_signature(&success,Role::NativeFunder)).is_err());
+    let mut noncanonical = frame.clone(); noncanonical.push(b' ');
+    assert!(b.accept_bch_refund_adaptor(1007,&noncanonical,&identity_signature(&noncanonical,Role::NativeFunder)).is_err());
+    assert!(b.received_bch_refund_adaptor()?.is_none());
+    let outgoing = n.retain_outgoing_bch_refund(1007,&signature)?;
+    assert_eq!(outgoing.frame(),frame); assert_eq!(outgoing.signature(),signature);
+    let encrypted = b.accept_bch_refund_adaptor(1008,outgoing.frame(),outgoing.signature())?;
+    let expected = serde_json::to_vec(&encrypted)?;
+    assert_eq!(serde_json::to_vec(&b.accept_bch_refund_adaptor(1009,&frame,&signature)?)?,expected);
+    assert!(b.accept_bch_refund_adaptor(1007,&frame,&signature).is_err());
+    assert!(b.accept_bch_refund_adaptor(2000,&frame,&signature).is_err());
+    assert!(n.retain_outgoing_bch_refund(2000,&signature).is_err());
+    drop(b); drop(n);
+    let b = AdmittedExecution::resume(&bmeta.0,&snapshots.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+    let mut n = AdmittedExecution::resume(&nmeta.0,&snapshots.0,&setup.quote,&setup.policy,Role::NativeFunder)?;
+    assert_eq!(serde_json::to_vec(&b.received_bch_refund_adaptor()?.unwrap())?,expected);
+    assert_eq!(n.prepare_bch_refund_adaptor(1010)?,frame);
+    assert_eq!(n.retain_outgoing_bch_refund(1010,&signature)?.frame(),frame);
+    let receipt = bmeta.0.join(format!("{}.bch-refund-bch-funder-authenticated",setup.quote.terms()["swapId"]));
+    let original = std::fs::read(&receipt)?;
+    std::fs::write(&receipt,b"{}")?; assert!(b.received_bch_refund_adaptor().is_err());
+    std::fs::write(&receipt,&original)?;
+    let prepared = nmeta.0.join(format!("{}.bch-refund-xmz-funder-prepared",setup.quote.terms()["swapId"]));
+    let original = std::fs::read(&prepared)?;
+    std::fs::write(&prepared,b"{}")?;
+    assert!(n.prepare_bch_refund_adaptor(1010).is_err());
+    assert!(n.retain_outgoing_bch_refund(1010,&signature).is_err());
+    std::fs::write(&prepared,&original)?;
+    assert_eq!(n.prepare_bch_refund_adaptor(1010)?,frame);
+    Ok(())
+}
