+        Ok(review)
+    }
+
+    /// Saved public payment terms after expiry; never new broadcast authority.
+    /// Dispatch state is obtained separately through bch_native_relay_state.
+    pub fn saved_bch_native_relay_review(&self,deployment: &[u8;32]) -> Result<NativeRelayReview> {
+        let (review,intent,_) = self.native_relay_materials()?;
+        ensure!(*deployment == intent.deployment,"saved native relay BCH observer changed");
         Ok(review)
