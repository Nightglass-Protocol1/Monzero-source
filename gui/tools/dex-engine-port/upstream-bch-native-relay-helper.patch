+    /// Offline review under current quote validity. This does not establish BCH
+    /// confirmation; relay still rechecks the actual chain and source wallet.
+    pub fn review_bch_native_relay_for_deployment(&self,deployment: &[u8;32],now: u64) -> Result<NativeRelayReview> {
