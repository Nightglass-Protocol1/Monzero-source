+//! Explicit immutable chain-observer selection for exact local-wallet funding.
+//! No RPC during review/bind; historical observation is never release authority.
+use super::*;
+use crate::bch_rpc::{observer::OwnedBchObserver,observation::BoundFundingObservation};
+use bitcoin::{consensus::serialize,hashes::{Hash,sha256}};
+use swap_core::bch::funding::SignedFunding;
+const RECORD:&str="monzero-bch-light-observer-binding-v1";
+const REVIEW:&str="monzero-bch-light-observer-review-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    schema:String,admission:[u8;32],source:[u8;32],claim:[u8;32],signed:[u8;32],observer:[u8;32],bound_at:u64,
+}
+pub struct LightObserverReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+impl AdmittedExecution<'_> {
+    pub(super) fn light_observer_bytes(&self)->Result<Option<Vec<u8>>> {
+        match self.metadata.read(&record_name(self.quote,"local-observer")) {
+            Ok(bytes)=>{ensure!(bytes.len()<=4096,"oversized BCH observer binding");Ok(Some(bytes))},
+            Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>Ok(None),
+            Err(e)=>Err(e),
+        }
+    }
+    fn light_observer_materials(&self,observer:&OwnedBchObserver,now:u64)->Result<(Binding,SignedFunding,bool)> {
+        ensure!(self.role==Role::BchFunder,"wrong BCH light observer role");
+        let (source,selected_at)=self.selected_light_source_binding()?;
+        ensure!(source==self.retained_light_source_binding()?,"BCH signed funding selected source changed");
+        let (network,claim)=self.local_funding_identity()?.context("missing BCH local funding identity")?;
+        let (signed,signed_at)=self.restore_local_signed_funding()?.context("missing exact local BCH funding")?;
+        ensure!(selected_at<=signed_at && now>=signed_at,"BCH observer binding predates selected funding");
+        ensure!(observer.network().quote_name()==self.quote.terms()["bchNetwork"]
+            && observer.network().genesis()==network.genesis(),"BCH observer differs from selected chain");
+        let mut expected=Binding {schema:RECORD.into(),admission:self.admission_digest()?,source,
+            claim:claim.to_byte_array(),signed:sha256::Hash::hash(&serialize(signed.transaction())).to_byte_array(),
+            observer:observer.deployment_commitment()?,bound_at:now};
+        let existing=match self.light_observer_bytes()? {
+            Some(bytes)=>{
+                let saved:Binding=serde_json::from_slice(&bytes)?;
+                ensure!(saved.bound_at>=signed_at && now>=saved.bound_at,"BCH observer binding time changed");
+                expected.bound_at=saved.bound_at;
+                ensure!(serde_json::to_vec(&expected)?==bytes,"BCH observer or local funding binding changed");true
+            },
+            None=>false,
+        };
+        Ok((expected,signed,existing))
+    }
+    /// Review exact source and public observer configuration, including after
+    /// commercial expiry. Caller authenticates the owned process independently.
+    pub fn review_light_bch_observer(&self,observer:&OwnedBchObserver,now:u64)->Result<LightObserverReview> {
+        let (binding,signed,_)=self.light_observer_materials(observer,now)?;
+        let details=serde_json::json!({"schema":REVIEW,"action":"bind-local-funding-observer",
+            "tradeId":self.quote.terms()["swapId"],"quoteCommitment":self.quote.commitment(),
+            "admission":binding.admission,"source":binding.source,"claim":binding.claim,
+            "fundingTxid":signed.lock_outpoint().txid,"signedDigest":binding.signed,
+            "observerCommitment":binding.observer,"observer":observer.deployment_context()?,
+            "chainObserved":false,"broadcastAuthorized":false});
+        Ok(LightObserverReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+    /// Retain one observer identity under the execution's metadata lease. Exact
+    /// retry keeps the original time; no replacement or implicit migration.
+    pub fn bind_reviewed_light_bch_observer(&self,observer:&OwnedBchObserver,now:u64,approved:&[u8;32])->Result<()> {
+        ensure!(self.review_light_bch_observer(observer,now)?.commitment==*approved,"BCH observer approval changed");
+        let (binding,_,_)=self.light_observer_materials(observer,now)?;
+        self.metadata.retain(&record_name(self.quote,"local-observer"),&serde_json::to_vec(&binding)?)
+    }
+    /// Read the exact signed funding through the retained chain observer. No
+    /// node-wallet lock records, signing, relay or inference from absence.
+    pub async fn observe_light_bch_funding(&self,observer:&OwnedBchObserver,now:u64)->Result<BoundFundingObservation> {
+        let (binding,signed,existing)=self.light_observer_materials(observer,now)?;
+        ensure!(existing,"approve and retain the BCH chain observer first");
+        let observed=observer.observe_funding(&signed).await?;
+        ensure!(observed.for_deployment(&binding.observer)?.txid()==signed.lock_outpoint().txid,
+            "BCH observer returned a different funding transaction");
+        Ok(observed)
+    }
+}
