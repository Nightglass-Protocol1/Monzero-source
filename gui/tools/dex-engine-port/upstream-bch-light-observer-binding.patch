@@ -0,0 +1,126 @@
+use super::*;
+use agreement::execution::AdmittedExecution;
+use crate::bch_rpc::{observer::OwnedBchObserver,BchRpc,BchNetwork,observation::FundingStatus};
+use bitcoin::hashes::sha256;
+use serde_json::{Value,json};
+use std::{net::TcpListener,io::{BufRead,BufReader,Read,Write},sync::{Arc,atomic::{AtomicBool,AtomicUsize,Ordering}}};
+
+pub(super) async fn exercise(execution:&mut AdmittedExecution<'_>,metadata:&std::path::Path,
+    signed:&Transaction,network:BchNetwork,wallet:sha256::Hash,trade:uuid::Uuid)->Result<OwnedBchObserver> {
+    let listener=TcpListener::bind("127.0.0.1:0")?;listener.set_nonblocking(true)?;let port=listener.local_addr()?.port();
+    let make=|port,network,password:&str|OwnedBchObserver::new(port,"user".into(),password.into(),network,"/Bitcoin Cash Node:29.0.0/".into());
+    let observer=make(port,network,"pass")?;
+    let other=make(if port==65535 {port-1}else{port+1},network,"pass")?;
+    let main=make(port,BchNetwork::Mainnet,"pass")?;
+    let slot=metadata.join(format!("{trade}.bch-funding-local-observer"));
+    assert!(!slot.exists());
+    assert!(execution.observe_light_bch_funding(&observer,2001).await.is_err());
+    assert!(execution.review_light_bch_observer(&main,2001).is_err());
+    // Before the first binding, changed selection and legacy unbound signatures
+    // must not silently acquire observation authority.
+    let selected_path=metadata.join(format!("{trade}.bch-funding-light-source"));
+    let selected_bytes=std::fs::read(&selected_path)?;
+    let changed=std::str::from_utf8(&selected_bytes)?.replace(&wallet.to_string(),&sha256::Hash::hash(b"another wallet").to_string());
+    ensure!(changed.as_bytes()!=selected_bytes,"fixture must change selected wallet");
+    std::fs::write(&selected_path,changed)?;
+    assert!(execution.review_light_bch_observer(&observer,2001).err().context("changed source must fail")?
+        .to_string().contains("selected source changed"));
+    std::fs::write(&selected_path,&selected_bytes)?;
+    let signed_path=metadata.join(format!("{trade}.bch-funding-local-signed"));
+    let signed_bytes=std::fs::read(&signed_path)?;
+    let original=std::str::from_utf8(&signed_bytes)?;
+    let (legacy,_)=original.rsplit_once(",\"source\":").context("missing final source field")?;
+    std::fs::write(&signed_path,format!("{legacy}}}"))?;
+    assert!(execution.review_light_bch_observer(&observer,2001).err().context("legacy source must fail")?
+        .to_string().contains("lack retained wallet selection"));
+    std::fs::write(&signed_path,&signed_bytes)?;
+    // First explicit binding after commercial expiry is safe for observation;
+    // it does not grant fresh signing, funding, retransmission or secret release.
+    let review=execution.review_light_bch_observer(&observer,2001)?;
+    assert_eq!(review.details["chainObserved"],false);assert_eq!(review.details["broadcastAuthorized"],false);
+    assert_eq!(review.details["fundingTxid"],signed.compute_txid().to_string());
+    assert_eq!(review.details["observer"]["port"],port);assert!(!slot.exists());
+    assert!(execution.bind_reviewed_light_bch_observer(&observer,2001,&[0;32]).is_err());assert!(!slot.exists());
+    assert!(execution.bind_reviewed_light_bch_observer(&other,2001,&review.commitment).is_err());assert!(!slot.exists());
+    execution.bind_reviewed_light_bch_observer(&observer,2001,&review.commitment)?;
+    let saved=std::fs::read(&slot)?;
+    execution.bind_reviewed_light_bch_observer(&make(port,network,"rotated")?,2002,&review.commitment)?;
+    assert_eq!(std::fs::read(&slot)?,saved);
+    assert!(execution.review_light_bch_observer(&observer,2000).is_err());
+    assert!(execution.review_light_bch_observer(&other,2002).is_err());
+    assert!(execution.observe_light_bch_funding(&other,2002).await.is_err());
+    assert!(listener.accept().is_err()); // All failures above occur before RPC.
+    std::fs::write(&slot,b"invalid binding")?;assert!(execution.review_light_bch_observer(&observer,2002).is_err());
+    std::fs::write(&slot,&saved)?;
+    let local=metadata.join(format!("{trade}.bch-funding-local-signed"));let source=metadata.join(format!("{trade}.bch-funding-light-source"));
+    let local_bytes=std::fs::read(&local)?;let source_bytes=std::fs::read(&source)?;
+    std::fs::remove_file(&local)?;
+    assert!(execution.review_light_bch_observer(&observer,2002).is_err());
+    assert!(execution.require_light_funding_source(crate::litecoin_light::network::BchNetwork::Regtest.into(),wallet,1010).is_err());
+    std::fs::remove_file(&source)?;
+    assert!(execution.select_light_funding_source(crate::litecoin_light::network::BchNetwork::Regtest.into(),wallet,1010).is_err());
+    let node=BchRpc::new(port,"user".into(),"pass".into(),network,"test".into(),"bchreg:qanchor".into(),
+        bitcoin::ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+    assert!(execution.lock_bch_funding_inputs(&node,1010,"bchreg:qchange",2).await.err().context("node locking must reject the local observer")?.to_string().contains("local funding observer"));
+    assert!(listener.accept().is_err());
+    // Even if the source, signatures and observer are lost, a local relay
+    // record must not permit a new node-wallet funding operation.
+    std::fs::remove_file(&slot)?;
+    let mut original_relay=Vec::new();
+    for suffix in ["local-relay-intent","local-relay-ack"] {
+        let path=metadata.join(format!("{trade}.bch-funding-{suffix}"));
+        match std::fs::read(&path) {
+            Ok(bytes)=>{std::fs::remove_file(&path)?;original_relay.push((path,bytes));},
+            Err(e) if e.kind()==std::io::ErrorKind::NotFound=>(),
+            Err(e)=>return Err(e.into()),
+        }
+    }
+    for suffix in ["local-relay-intent","local-relay-ack"] {
+        let orphan=metadata.join(format!("{trade}.bch-funding-{suffix}"));
+        use std::os::unix::fs::OpenOptionsExt;
+        std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&orphan)?.write_all(b"orphan")?;
+        assert!(execution.lock_bch_funding_inputs(&node,1010,"bchreg:qchange",2).await.err()
+            .context("node locking must reject orphan local relay records")?.to_string().contains("local funding relay record"));
+        assert!(listener.accept().is_err());std::fs::remove_file(orphan)?;
+    }
+    for (path,bytes) in original_relay {
+        use std::os::unix::fs::OpenOptionsExt;
+        std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(path)?.write_all(&bytes)?;
+    }
+    std::fs::write(&slot,&saved)?;
+    std::fs::write(&source,&source_bytes)?;std::fs::write(&local,&local_bytes)?;
+    use std::os::unix::fs::PermissionsExt;
+    for path in [&source,&local,&slot] {std::fs::set_permissions(path,std::fs::Permissions::from_mode(0o600))?;}
+    let stop=Arc::new(AtomicBool::new(false));let signal=stop.clone();let calls=Arc::new(AtomicUsize::new(0));let counted=calls.clone();
+    let txid=signed.compute_txid();let script=signed.output[0].script_pubkey.to_hex_string();
+    let server=std::thread::spawn(move ||->Result<()> {
+        while !signal.load(Ordering::Relaxed) {
+            let (mut socket,_)=match listener.accept(){Ok(v)=>v,Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>{std::thread::sleep(std::time::Duration::from_millis(1));continue},Err(e)=>return Err(e.into())};
+            let mut reader=BufReader::new(socket.try_clone()?);let mut line=String::new();reader.read_line(&mut line)?;
+            ensure!(line.split_whitespace().nth(1)==Some("/"),"wallet route forbidden");let mut length=None;let mut auth=false;
+            loop {line.clear();ensure!(reader.read_line(&mut line)?>0,"missing headers");if line=="\r\n"{break}
+                let lower=line.to_ascii_lowercase();if let Some(v)=lower.strip_prefix("content-length:"){length=Some(v.trim().parse::<usize>()?);}
+                if lower.starts_with("authorization:"){auth=line.trim().ends_with("Basic dXNlcjpwYXNz");}
+            }
+            ensure!(auth,"missing observer authentication");let length=length.context("missing length")?;ensure!(length<4096,"oversized request");
+            let mut bytes=vec![0;length];reader.read_exact(&mut bytes)?;let request:Value=serde_json::from_slice(&bytes)?;
+            let result=match request["method"].as_str().context("missing method")? {
+                "getnetworkinfo"=>json!({"subversion":"/Bitcoin Cash Node:29.0.0/","networkactive":true}),
+                "getblockchaininfo"=>json!({"chain":"regtest","blocks":200,"headers":200,"initialblockdownload":false,"bestblockhash":"08".repeat(32)}),
+                "getblockhash"=>json!(if request["params"][0]==0 {network.genesis().to_owned()}else{"07".repeat(32)}),
+                "gettxout"=>{ensure!(request["params"]==json!([txid,0,true]),"wrong exact funding output");json!({"bestblock":"08".repeat(32),"confirmations":3,
+                    "value":0.001,"coinbase":false,"scriptPubKey":{"hex":script,"addresses":[]}})},
+                _=>anyhow::bail!("wallet or mutating RPC forbidden"),
+            };
+            counted.fetch_add(1,Ordering::Relaxed);let bytes=serde_json::to_vec(&json!({"id":request["id"],"error":null,"result":result}))?;
+            write!(socket,"HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",bytes.len())?;socket.write_all(&bytes)?;
+        }
+        Ok(())
+    });
+    let observed=execution.observe_light_bch_funding(&observer,2002).await;
+    stop.store(true,Ordering::Relaxed);server.join().unwrap()?;
+    let observed=observed?;let exact=observed.for_deployment(&observer.deployment_commitment()?)?;
+    assert_eq!(exact.txid(),signed.compute_txid());assert_eq!(exact.status(),FundingStatus::ConfirmedUnspent {confirmations:3});
+    assert!(calls.load(Ordering::Relaxed)>0);assert_eq!(std::fs::read(&slot)?,saved);
+    Ok(observer)
