+//! Explicit, durable public address allocation. No secret material is stored.
+//! Requires separate wallet backup/discovery/gap policy before user exposure.
+//! The journal is not authenticated against rollback of an older valid backup.
+use super::*;
+use crate::litecoin_rpc::reservation::Journal;
+use bitcoin::hashes::{Hash,sha256};
+use serde::{Deserialize,Serialize};
+use std::{collections::BTreeSet,path::Path};
+use uuid::Uuid;
+const NAME:&str="litecoin-address-book.json";
+const MAX_ENTRIES:usize=10_000;
+#[derive(Clone,Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+struct Record {schema:String,account:String,entries:Vec<Entry>}
+#[derive(Clone,Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+struct Entry {request:Uuid,branch:u8,index:u32}
+
+pub struct AddressBook {
+    journal:Journal,
+    account:PublicAccount,
+    record:Record,
+    bytes:Vec<u8>,
+    usable:bool,
+}
+impl AddressBook {
+    /// Explicit initialization only. Existing allocations cannot be reset.
+    pub fn create(directory:&Path,account:PublicAccount)->Result<Self> {
+        let journal=Journal::open(directory)?;
+        let record=Record {schema:"monzero-ltc-address-book-v1".into(),account:identity(&account),entries:vec![]};
+        let bytes=serde_json::to_vec(&record)?;journal.retain(NAME,&bytes)?;
+        Ok(Self {journal,account,record,bytes,usable:true})
+    }
+    /// Missing or invalid state is an error, never implicit initialization.
+    pub fn open(directory:&Path,account:PublicAccount)->Result<Self> {
+        let journal=Journal::open(directory)?;let bytes=journal.read(NAME)?;
+        let record:Record=serde_json::from_slice(&bytes)?;
+        ensure!(record.schema=="monzero-ltc-address-book-v1" && record.account==identity(&account)
+            && record.entries.len()<=MAX_ENTRIES,"Litecoin address book identity or limit mismatch");
+        let mut next=[0u32;2];let mut requests=BTreeSet::new();
+        for entry in &record.entries {
+            ensure!(entry.branch<=1 && !entry.request.is_nil() && requests.insert(entry.request),"invalid Litecoin address allocation identity");
+            ensure!(entry.index==next[entry.branch as usize],"nonsequential Litecoin address allocation");
+            next[entry.branch as usize]+=1;
+        }
+        // Reconcile a rename whose directory sync may previously have failed.
+        // The identical-record path syncs both the existing file and directory.
+        journal.retain(NAME,&bytes)?;
+        Ok(Self {journal,account,record,bytes,usable:true})
+    }
+    /// Request IDs are retry identities and must be retained by the caller.
+    /// Same ID/branch returns the original address without allocating another.
+    pub fn reserve(&mut self,request:Uuid,branch:Branch)->Result<DerivedAddress> {
+        self.reserve_with(request,branch,|journal,before,after|journal.replace_record(NAME,before,after))
+    }
+    fn reserve_with(&mut self,request:Uuid,branch:Branch,
+        publish:impl FnOnce(&Journal,&[u8],&[u8])->Result<()>)->Result<DerivedAddress> {
+        ensure!(self.usable,"Litecoin address book requires reopen after publication failure");
+        ensure!(!request.is_nil(),"missing Litecoin address request identity");
+        if self.journal.read(NAME)?!=self.bytes {
+            self.usable=false;anyhow::bail!("Litecoin address book changed outside its lease")
+        }
+        let branch_number=branch.index() as u8;
+        if let Some(entry)=self.record.entries.iter().find(|entry|entry.request==request) {
+            ensure!(entry.branch==branch_number,"Litecoin address request reused for another branch");
+            return self.account.derive(branch,entry.index)
+        }
+        ensure!(self.record.entries.len()<MAX_ENTRIES,"Litecoin address journal capacity reached");
+        let index=self.record.entries.iter().filter(|entry|entry.branch==branch_number).count() as u32;
+        let address=self.account.derive(branch,index)?;
+        let mut record=self.record.clone();record.entries.push(Entry {request,branch:branch_number,index});
+        let bytes=serde_json::to_vec(&record)?;
+        self.usable=false;publish(&self.journal,&self.bytes,&bytes)?;
+        self.record=record;self.bytes=bytes;self.usable=true;Ok(address)
+    }
+}
+fn identity(account:&PublicAccount)->String {
+    let mut bytes=b"monzero-ltc-public-account-v1\0".to_vec();
+    bytes.extend_from_slice(account.network.genesis().as_bytes());
+    bytes.extend_from_slice(&account.account.to_be_bytes());
+    bytes.extend_from_slice(account.fingerprint.as_bytes());
+    bytes.extend_from_slice(&account.public.encode());
+    sha256::Hash::hash(&bytes).to_string()
+}
