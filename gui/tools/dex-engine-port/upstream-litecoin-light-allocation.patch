+use super::*;
+use std::{fs,os::unix::fs::PermissionsExt,path::PathBuf};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {
+    let path=std::env::temp_dir().join(format!("monzero-address-book-{}",Uuid::new_v4()));
+    fs::create_dir(&path)?;fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;Ok(Self(path.canonicalize()?))
+}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn account(network:LtcNetwork,index:u32,seed:u8)->PublicAccount {
+    let master=Xpriv::new_master(if network==LtcNetwork::Mainnet {NetworkKind::Main} else {NetworkKind::Test},&[seed;32]).unwrap();
+    PublicAccount::from_master(&master,network,index).unwrap()
+}
+fn standard()->PublicAccount {account(LtcNetwork::Regtest,0,1)}
+#[test]
+fn allocation_persists_retries_and_separate_branch_indices()->Result<()> {
+    let dir=Directory::new()?;assert!(AddressBook::open(&dir.0,standard()).is_err());
+    let mut book=AddressBook::create(&dir.0,standard())?;let receive=Uuid::new_v4();let change=Uuid::new_v4();
+    let first=book.reserve(receive,Branch::Receive)?;let before=fs::read(dir.0.join(NAME))?;
+    assert_eq!(book.reserve(receive,Branch::Receive)?.address().to_string(),first.address().to_string());
+    assert_eq!(fs::read(dir.0.join(NAME))?,before);
+    assert!(book.reserve(receive,Branch::Change).is_err());assert!(book.reserve(Uuid::nil(),Branch::Receive).is_err());
+    assert_eq!(book.reserve(change,Branch::Change)?.path().to_string(),"84'/1'/0'/1/0");
+    assert!(AddressBook::open(&dir.0,standard()).is_err());drop(book);
+    assert!(AddressBook::create(&dir.0,standard()).is_err());
+    let mut book=AddressBook::open(&dir.0,standard())?;
+    assert_eq!(book.reserve(receive,Branch::Receive)?.address().to_string(),first.address().to_string());
+    assert_eq!(book.reserve(Uuid::new_v4(),Branch::Receive)?.path().to_string(),"84'/1'/0'/0/1");
+    assert_eq!(book.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string(),"84'/1'/0'/1/1");Ok(())
+}
+#[test]
+fn allocation_rejects_other_accounts_networks_and_malformed_state()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    book.reserve(Uuid::new_v4(),Branch::Receive)?;drop(book);
+    for other in [account(LtcNetwork::Testnet,0,1),account(LtcNetwork::Regtest,1,1),account(LtcNetwork::Regtest,0,2)] {
+        assert!(AddressBook::open(&dir.0,other).is_err());
+    }
+    let path=dir.0.join(NAME);let original=fs::read(&path)?;
+    for case in 0..5 {
+        let mut value:serde_json::Value=serde_json::from_slice(&original)?;
+        match case {0=>value["entries"][0]["index"]=serde_json::json!(1),
+            1=>value["entries"][0]["branch"]=serde_json::json!(2),
+            2=>{let entry=value["entries"][0].clone();value["entries"].as_array_mut().unwrap().push(entry);},
+            3=>value["extra"]=serde_json::json!(true),
+            4=>value["entries"][0]["request"]=serde_json::json!(Uuid::nil()),_=>unreachable!()}
+        fs::write(&path,serde_json::to_vec(&value)?)?;assert!(AddressBook::open(&dir.0,standard()).is_err());
+    }
+    fs::write(&path,b"{")?;assert!(AddressBook::open(&dir.0,standard()).is_err());Ok(())
+}
+#[test]
+fn allocation_ambiguous_publication_reopens_same_request_without_reuse()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;let request=Uuid::new_v4();
+    assert!(book.reserve_with(request,Branch::Receive,|journal,before,after| {
+        journal.replace_record(NAME,before,after)?;anyhow::bail!("simulated lost result after durable publication")
+    }).is_err());
+    assert!(book.reserve(request,Branch::Receive).is_err());drop(book);
+    let mut book=AddressBook::open(&dir.0,standard())?;
+    assert_eq!(book.reserve(request,Branch::Receive)?.path().to_string(),"84'/1'/0'/0/0");
+    assert_eq!(book.reserve(Uuid::new_v4(),Branch::Receive)?.path().to_string(),"84'/1'/0'/0/1");Ok(())
+}
+#[test]
+fn allocation_failed_publication_and_changed_record_cannot_return_an_address()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    let before=fs::read(dir.0.join(NAME))?;
+    assert!(book.reserve_with(Uuid::new_v4(),Branch::Change,|_,_,_|anyhow::bail!("injected write failure")).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,before);assert!(book.reserve(Uuid::new_v4(),Branch::Change).is_err());drop(book);
+    let mut book=AddressBook::open(&dir.0,standard())?;
+    fs::write(dir.0.join(NAME),b"changed")?;assert!(book.reserve(Uuid::new_v4(),Branch::Receive).is_err());
+    fs::write(dir.0.join(NAME),&before)?;assert!(book.reserve(Uuid::new_v4(),Branch::Receive).is_err());Ok(())
+}
