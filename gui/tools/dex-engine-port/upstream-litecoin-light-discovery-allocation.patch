+#[test]
+fn discovered_allocations_advance_monotonically_and_preserve_request_ids()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    let request=Uuid::new_v4();let original=book.reserve(request,Branch::Receive)?.address().to_string();
+    book.retain_discovered([3,2])?;let bytes=fs::read(dir.0.join(NAME))?;
+    book.retain_discovered([1,1])?;assert_eq!(fs::read(dir.0.join(NAME))?,bytes);
+    assert_eq!(book.reserve(request,Branch::Receive)?.address().to_string(),original);drop(book);
+    let mut book=AddressBook::open(&dir.0,standard())?;
+    assert_eq!(book.allocated_count(Branch::Receive)?,3);assert_eq!(book.allocated_count(Branch::Change)?,2);
+    assert_eq!(book.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string(),"84'/1'/0'/1/2");
+    let before=fs::read(dir.0.join(NAME))?;assert!(book.retain_discovered([10000,10000]).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,before);Ok(())
+}
+#[test]
+fn discovered_allocation_uncertain_publication_requires_reopen()->Result<()> {
+    let dir=Directory::new()?;let mut book=AddressBook::create(&dir.0,standard())?;
+    assert!(book.retain_discovered_with([2,3],|journal,before,after| {
+        journal.replace_record(NAME,before,after)?;anyhow::bail!("simulated lost discovery publication result")
+    }).is_err());
+    assert!(book.allocated_count(Branch::Change).is_err());
+    assert!(book.reserve(Uuid::new_v4(),Branch::Change).is_err());drop(book);
+    let mut book=AddressBook::open(&dir.0,standard())?;book.retain_discovered([2,3])?;
+    assert_eq!(book.allocated_count(Branch::Receive)?,2);assert_eq!(book.allocated_count(Branch::Change)?,3);
+    assert_eq!(book.reserve(Uuid::new_v4(),Branch::Change)?.path().to_string(),"84'/1'/0'/1/3");Ok(())
+}
