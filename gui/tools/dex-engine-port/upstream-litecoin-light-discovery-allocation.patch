+    /// Persist inclusive discovery coverage as exclusive branch counts. Missing
+    /// indices get internal allocation IDs; existing request identities never
+    /// change. Counts only increase. This does not authenticate history or stop
+    /// rollback of an older valid backup. One atomic record replaces both branches.
+    pub fn retain_discovered(&mut self,minimum:[u32;2])->Result<()> {
+        self.retain_discovered_with(minimum,|journal,before,after|journal.replace_record(NAME,before,after))
+    }
+    fn retain_discovered_with(&mut self,minimum:[u32;2],
+        publish:impl FnOnce(&Journal,&[u8],&[u8])->Result<()>)->Result<()> {
+        ensure!(minimum.iter().all(|count|*count<=MAX_ENTRIES as u32),"Litecoin discovered allocation limit exceeded");
+        let current=[self.allocated_count(Branch::Receive)?,self.allocated_count(Branch::Change)?];
+        let target=[current[0].max(minimum[0]),current[1].max(minimum[1])];
+        ensure!(target[0] as usize+target[1] as usize<=MAX_ENTRIES,"Litecoin address journal capacity reached");
+        if target==current {return Ok(())}
+        let mut record=self.record.clone();
+        let mut requests=record.entries.iter().map(|entry|entry.request).collect::<BTreeSet<_>>();
+        for branch in 0..2 {
+            for index in current[branch]..target[branch] {
+                let request=Uuid::new_v4();
+                ensure!(!request.is_nil() && requests.insert(request),"Litecoin discovery allocation identity collision");
+                record.entries.push(Entry {request,branch:branch as u8,index});
+            }
+        }
+        let bytes=serde_json::to_vec(&record)?;
+        self.usable=false;publish(&self.journal,&self.bytes,&bytes)?;
+        self.record=record;self.bytes=bytes;self.usable=true;Ok(())
+    }
