--- /dev/null
+++ b/swap-machine/src/litecoin_light/accounting/tests.rs
@@ -0,0 +1,60 @@
+use super::*;
+use bitcoin::{TxIn,TxOut,absolute,transaction::Version};
+use swap_core::litecoin_address::LtcNetwork;
+fn script()->ScriptBuf {ScriptBuf::from_bytes(vec![0x51])}
+fn chain()->Result<headers::HeaderSequence> {
+    let mut chain=headers::HeaderSequence::new(LtcNetwork::Regtest)?;
+    let header=crate::litecoin_light::headers::tests::child();
+    chain.append(&serialize(&header),header.time as u64)?;Ok(chain)
+}
+// Accounting-only fixture injection: these transactions are NOT proven to be
+// committed by the fixed header. Merkle verification has separate tests.
+fn included(chain:&headers::HeaderSequence,height:u32,input:OutPoint,amount:u64)->IncludedTransaction {
+    let tx=Transaction {version:Version::TWO,lock_time:absolute::LockTime::ZERO,
+        input:vec![TxIn {previous_output:input,..Default::default()}],
+        output:vec![TxOut {value:Amount::from_sat(amount),script_pubkey:script()}]};
+    IncludedTransaction::new(MerkleMatch {txid:tx.compute_txid(),block_hash:chain.header(height).unwrap().block_hash(),claimed_height:height},&tx).unwrap()
+}
+fn external()->OutPoint {OutPoint {txid:Txid::from_byte_array([9;32]),vout:0}}
+#[test]
+fn accounting_subtracts_spends_independent_of_order_and_deduplicates_scripts()->Result<()> {
+    let chain=chain()?;let receipt=included(&chain,0,external(),100);
+    let spend=included(&chain,1,OutPoint {txid:receipt.txid(),vout:0},60);
+    let observed=ObservedWallet::reconcile(&chain,&[script(),script()],&[spend,receipt])?;
+    assert_eq!(observed.observed_mature().to_sat(),60);assert_eq!(observed.coins().len(),1);
+    assert_eq!(observed.height(),1);assert_eq!(observed.tip(),chain.header(1).unwrap().block_hash());
+    Ok(())
+}
+#[test]
+fn accounting_recomputes_after_orphaning_spend()->Result<()> {
+    let chain=chain()?;let receipt=included(&chain,0,external(),100);
+    let spend=included(&chain,1,OutPoint {txid:receipt.txid(),vout:0},60);let transactions=[receipt,spend];
+    let old=ObservedWallet::reconcile(&chain,&[script()],&transactions)?;
+    let selected=headers::HeaderSequence::new(LtcNetwork::Regtest)?;
+    let new=ObservedWallet::reconcile(&selected,&[script()],&transactions)?;
+    assert_eq!(old.observed_mature().to_sat(),60);assert_eq!(new.observed_mature().to_sat(),100);
+    assert_eq!(new.coins()[0].confirmations(),1);Ok(())
+}
+#[test]
+fn accounting_rejects_conflicts_duplicates_and_amount_overflow()->Result<()> {
+    let chain=chain()?;
+    assert!(ObservedWallet::reconcile(&chain,&[script()],&[included(&chain,1,external(),100),included(&chain,1,external(),90)]).is_err());
+    assert!(ObservedWallet::reconcile(&chain,&[script()],&[included(&chain,1,external(),100),included(&chain,1,external(),100)]).is_err());
+    let other=OutPoint {vout:1,..external()};
+    assert!(ObservedWallet::reconcile(&chain,&[script()],&[included(&chain,1,external(),u64::MAX),included(&chain,1,other,1)]).is_err());
+    Ok(())
+}
+#[test]
+fn accounting_separates_coinbase_maturity_and_rejects_early_spend()->Result<()> {
+    let chain=chain()?;let receipt=included(&chain,0,OutPoint::null(),100);
+    let spend=included(&chain,1,OutPoint {txid:receipt.txid(),vout:0},60);
+    let observed=ObservedWallet::reconcile(&chain,&[script()],&[receipt])?;
+    assert_eq!(observed.observed_mature().to_sat(),0);assert_eq!(observed.observed_immature().to_sat(),100);
+    assert!(!observed.coins()[0].maturity_satisfied());
+    assert!(ObservedWallet::reconcile(&chain,&[script()],&[included(&chain,0,OutPoint::null(),100),spend]).is_err());
+    for (depth,expected) in [(99,false),(100,true),(101,true)] {
+        let coin=ObservedCoin {outpoint:external(),amount:Amount::from_sat(1),confirmations:depth,coinbase:true};
+        assert_eq!(coin.maturity_satisfied(),expected);
+    }
+    Ok(())
+}
