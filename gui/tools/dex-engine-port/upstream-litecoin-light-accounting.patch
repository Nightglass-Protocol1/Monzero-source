+//! Recomputed accounting for an explicitly supplied observation set.
+//! Omitted spends can inflate this snapshot. It is neither a complete balance
+//! nor a capability to fund/sign a swap. No persistent unspentness is asserted.
+use super::*;
+use super::transaction::IncludedTransaction;
+use bitcoin::{Amount,OutPoint,ScriptBuf};
+use std::collections::{BTreeMap,BTreeSet};
+
+pub struct ObservedCoin {
+    outpoint:OutPoint,
+    amount:Amount,
+    confirmations:u64,
+    coinbase:bool,
+}
+impl ObservedCoin {
+    pub fn outpoint(&self)->OutPoint {self.outpoint}
+    pub fn amount(&self)->Amount {self.amount}
+    pub fn confirmations(&self)->u64 {self.confirmations}
+    pub fn is_coinbase(&self)->bool {self.coinbase}
+    /// Maturity for a spend in the next block, not general spendability.
+    pub fn maturity_satisfied(&self)->bool {!self.coinbase || self.confirmations>=100}
+}
+pub struct ObservedWallet {
+    tip:BlockHash,
+    height:u32,
+    coins:Vec<ObservedCoin>,
+    mature:Amount,
+    immature:Amount,
+}
+impl ObservedWallet {
+    /// Recompute after every chain/observation change; old snapshots stay old.
+    /// Duplicate identities and conflicting observed spends are errors.
+    pub fn reconcile(chain:&headers::HeaderSequence,scripts:&[ScriptBuf],
+        transactions:&[IncludedTransaction])->Result<Self> {
+        ensure!(!scripts.is_empty() && scripts.len()<=1000 && transactions.len()<=10_000,
+            "Litecoin accounting input limit exceeded");
+        ensure!(scripts.iter().all(|script|!script.is_empty() && script.len()<=10_000),
+            "invalid Litecoin accounting script");
+        let scripts:BTreeSet<_>=scripts.iter().collect();
+        let mut active=BTreeMap::new();
+        for transaction in transactions {
+            if let Some(depth)=transaction.confirmations_on(chain) {
+                ensure!(active.insert(transaction.txid(),(transaction,depth)).is_none(),
+                    "duplicate Litecoin transaction observation");
+            }
+        }
+        let mut spends=BTreeSet::new();
+        let mut output_count=0usize;
+        for (transaction,_) in active.values() {
+            output_count=output_count.checked_add(transaction.outputs().len()).context("Litecoin output count overflow")?;
+            ensure!(output_count<=100_000,"Litecoin accounting output limit exceeded");
+            if transaction.is_coinbase() {continue}
+            for input in transaction.inputs() {
+                ensure!(!input.is_null() && spends.insert(*input),"conflicting Litecoin observed spend");
+                if let Some((parent,_))=active.get(&input.txid) {
+                    ensure!(parent.txid()!=transaction.txid() && parent.height()<=transaction.height()
+                        && (input.vout as usize)<parent.outputs().len(),"invalid Litecoin observed dependency");
+                    ensure!(!parent.is_coinbase() || transaction.height()-parent.height()>=100,
+                        "observed immature Litecoin coinbase spend");
+                }
+            }
+        }
+        let mut coins=Vec::new();let mut mature=0u64;let mut immature=0u64;
+        for (transaction,depth) in active.values() {
+            for (index,output) in transaction.outputs().iter().enumerate() {
+                let outpoint=OutPoint {txid:transaction.txid(),vout:index as u32};
+                if !scripts.contains(&output.script_pubkey) || spends.contains(&outpoint) {continue}
+                let coin=ObservedCoin {outpoint,amount:output.value,confirmations:*depth,coinbase:transaction.is_coinbase()};
+                let total=if coin.maturity_satisfied() {&mut mature} else {&mut immature};
+                *total=total.checked_add(output.value.to_sat()).context("Litecoin observed amount overflow")?;
+                coins.push(coin);
+            }
+        }
+        mature.checked_add(immature).context("Litecoin combined observed amount overflow")?;
+        Ok(Self {tip:chain.header(chain.height()).context("missing Litecoin selected tip")?.block_hash(),
+            height:chain.height(),coins,mature:Amount::from_sat(mature),immature:Amount::from_sat(immature)})
+    }
+    pub fn tip(&self)->BlockHash {self.tip}
+    pub fn height(&self)->u32 {self.height}
+    pub fn coins(&self)->&[ObservedCoin] {&self.coins}
+    pub fn observed_mature(&self)->Amount {self.mature}
+    pub fn observed_immature(&self)->Amount {self.immature}
+}
