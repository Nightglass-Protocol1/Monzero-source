+fn verify_lock_inputs(incoming: &Value, selected: &Value, lock: &str, account: u32,
+    amount: XmzAmount, fee: XmzAmount) -> Result<()> {
+    let outputs = incoming["transfers"].as_array().context("missing recovery source outputs")?;
+    let keys = selected.as_array().context("missing prepared input key images")?;
+    ensure!(!keys.is_empty(), "empty prepared input set");
+    let mut seen = std::collections::BTreeSet::new();
+    let mut total = 0u128;
+    for key in keys {
+        let key = key.as_str().context("invalid prepared input key image")?;
+        ensure!(canonical_hash(key) && key != "0".repeat(64) && seen.insert(key),
+            "invalid or duplicate prepared input key image");
+        let matches: Vec<_> = outputs.iter().filter(|output| output["key_image"] == key).collect();
+        ensure!(matches.len() == 1, "prepared input is absent or ambiguous");
+        let output = matches[0];
+        ensure!(output["tx_hash"] == lock && output["spent"] == false
+            && output["unlocked"] == true && output["frozen"] == false
+            && number(&output["subaddr_index"], "major")? == u64::from(account),
+            "prepared input does not belong to the available recovery lock");
+        let value = number(output, "amount")?;
+        ensure!(value > 0, "zero recovery source amount");
+        total = total.checked_add(u128::from(value)).context("recovery input sum overflow")?;
+    }
+    ensure!(total >= u128::from(amount.atoms()) + u128::from(fee.atoms()),
+        "recovery lock inputs do not cover payment and fee");
+    Ok(())
+}
