+// Target: tests/wallet_locks/signing/relay/message/native/relay/proof/success/receipt.rs
+use super::*;
+
+pub(super) fn exercise(bch: &mut AdmittedExecution<'_>,native: &mut AdmittedExecution<'_>,
+    setup: &Setup,metadata: &PrivateStore,snapshots: &PrivateStore,fixture: &Fixture,
+    frame: &[u8],signature: &[u8]) -> Result<()> {
+    let before = fixture.calls.lock().unwrap().len();
+    assert!(bch.accept_bch_success(2033,frame,signature).is_err());
+    assert!(bch.has_received_bch_success().is_err());
+    assert!(!native.has_received_bch_success()?);
+    // The original outgoing proof was retained at 2026.
+    assert!(native.accept_bch_success(2025,frame,signature).is_err());
+    let wrong = SigningKey::from_bytes(&[2;32]);
+    assert!(native.accept_bch_success(2033,frame,&wrong.sign(&signing_bytes(frame)?).to_bytes()).is_err());
+    let key = SigningKey::from_bytes(&[1;32]);
+    let original: Value = serde_json::from_slice(frame)?;
+    for (field,value) in [("schema",json!("changed")),("swap",json!("changed")),
+        ("native_txid",json!("cd".repeat(32))),
+        ("bch_outpoint",serde_json::to_value(bitcoin::OutPoint::null())?),
+        ("quote",serde_json::to_value([0u8;32])?),
+        ("agreement",serde_json::to_value([0u8;32])?)] {
+        let old = format!("\"{field}\":{}",serde_json::to_string(&original[field])?);
+        let new = format!("\"{field}\":{}",serde_json::to_string(&value)?);
+        let changed = zeroize::Zeroizing::new(std::str::from_utf8(frame)?.replacen(&old,&new,1).into_bytes());
+        assert_ne!(&*changed,frame);
+        let sig = key.sign(&signing_bytes(&changed)?).to_bytes();
+        assert!(native.accept_bch_success(2033,&changed,&sig).is_err(),"changed {field}");
+    }
+    let mut spaced = zeroize::Zeroizing::new(frame.to_vec());spaced.push(b' ');
+    assert!(native.accept_bch_success(2033,&spaced,&key.sign(&signing_bytes(&spaced)?).to_bytes()).is_err());
+    native.accept_bch_success(2033,frame,signature)?;
+    native.accept_bch_success(2034,frame,signature)?;
+    assert!(native.has_received_bch_success()?);
+    assert!(native.accept_bch_success(2032,frame,signature).is_err());
+    let restored_metadata = copy_store(metadata)?;
+    let restored = AdmittedExecution::resume(&restored_metadata.0,&snapshots.0,
+        &setup.quote,&setup.policy,Role::NativeFunder)?;
+    assert!(restored.has_received_bch_success()?);
+    let slot = format!("{}.bch-success-received",setup.quote.terms()["swapId"]);
+    let private = snapshots.0.join(&slot);
+    let bytes = zeroize::Zeroizing::new(std::fs::read(&private)?);
+    std::fs::write(&private,b"{}")?;
+    assert!(native.has_received_bch_success().is_err());
+    assert!(native.accept_bch_success(2034,frame,signature).is_err());
+    std::fs::write(&private,&*bytes)?;
+    let missing = snapshots.0.join("saved-success-receipt");
+    std::fs::rename(&private,&missing)?;
+    assert!(native.has_received_bch_success().is_err());
+    assert!(native.accept_bch_success(2034,frame,signature).is_err());
+    std::fs::rename(&missing,&private)?;
+    let pin = metadata.0.join(format!("{slot}-pin"));
+    let missing_pin = metadata.0.join("saved-success-receipt-pin");
+    std::fs::rename(&pin,&missing_pin)?;
+    assert!(native.has_received_bch_success().is_err());
+    assert!(native.accept_bch_success(2034,frame,signature).is_err());
+    std::fs::rename(&missing_pin,&pin)?;
+    assert!(native.has_received_bch_success()?);
+    assert_eq!(fixture.calls.lock().unwrap().len(),before);
+    Ok(())
+}
