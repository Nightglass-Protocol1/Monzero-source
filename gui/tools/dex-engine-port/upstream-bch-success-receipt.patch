@@ -0,0 +1,87 @@
+//! Native-funder receipt of an authenticated success adaptor. Receipt alone is
+//! neither confirmation, permission to reveal the native share, nor relay.
+use super::*;
+use zeroize::{Zeroize,Zeroizing};
+
+const RECORD: &str = "monzero-bch-success-receipt-v1";
+const PIN: &str = "monzero-bch-success-receipt-pin-v1";
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    schema: String, admission: [u8;32], payment: [u8;32], at: u64,
+    frame: Vec<u8>, signature: Vec<u8>,
+}
+impl Drop for Record {fn drop(&mut self) {self.frame.zeroize();}}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pin {schema: String, admission: [u8;32], record: [u8;32]}
+struct ReceiptContext {
+    agreement: AgreedNativeWallet, outpoint: bitcoin::OutPoint,
+    native_txid: String, payment: [u8;32], sent_at: u64, admission: [u8;32],
+}
+fn name(quote: &VerifiedBchQuote) -> String {format!("{}.bch-success-received",quote.terms()["swapId"])}
+fn optional(journal: &Journal,name: &str) -> Result<Option<Vec<u8>>> {
+    match journal.read(name) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(e) if e.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+fn encode(record: &Record) -> Result<Zeroizing<Vec<u8>>> {
+    let mut bytes = Zeroizing::new(Vec::with_capacity(65536));
+    serde_json::to_writer(&mut *bytes,record)?;
+    ensure!(bytes.len() <= 65536,"oversized BCH success receipt");Ok(bytes)
+}
+impl AdmittedExecution<'_> {
+    fn success_receipt_context(&self) -> Result<ReceiptContext> {
+        ensure!(self.role == Role::NativeFunder,"wrong BCH success receiver");
+        // Accessor must validate the original outgoing payment-proof record,
+        // acknowledged relay and exact prepared payment, returning no secrets.
+        let (native_txid,payment,sent_at) = self.outgoing_native_payment_binding()?;
+        let agreement = self.restore_agreement()?;
+        let funding = self.received_bch_funding_message()?.context("missing authenticated BCH funding")?;
+        Ok(ReceiptContext {agreement,outpoint:funding.signed().lock_outpoint(),native_txid,
+            payment,sent_at,admission:self.admission_digest()?})
+    }
+    fn load_success_receipt(&self,context: &ReceiptContext) -> Result<Option<Record>> {
+        let slot = name(self.quote);
+        let private = optional(&Journal::open(&self.snapshots)?,&slot)?.map(Zeroizing::new);
+        let Some(pin_bytes) = optional(&self.metadata,&format!("{slot}-pin"))? else {
+            ensure!(private.is_none(),"BCH success receipt lacks trusted pin");return Ok(None)
+        };
+        ensure!(pin_bytes.len() <= 4096,"oversized BCH success receipt pin");
+        let pin: Pin = serde_json::from_slice(&pin_bytes)?;
+        let bytes = private.context("BCH success receipt private record missing")?;
+        ensure!(bytes.len() <= 65536 && pin.schema == PIN && pin.admission == context.admission
+            && pin.record == hash(RECORD,&bytes) && serde_json::to_vec(&pin)? == pin_bytes,
+            "BCH success receipt pin changed");
+        let record: Record = serde_json::from_slice(&bytes)?;
+        ensure!(*encode(&record)? == *bytes && record.schema == RECORD
+            && record.admission == context.admission && record.payment == context.payment
+            && record.at >= context.sent_at,"BCH success receipt context changed");
+        context.agreement.check_signed_success(self.quote,context.outpoint,&context.native_txid,
+            &record.frame,&record.signature)?;
+        Ok(Some(record))
+    }
+    /// Retain exact peer evidence after authenticating both funding bindings.
+    /// Settlement may finish after quote expiry; this grants no funding rights.
+    pub fn accept_bch_success(&mut self,now: u64,frame: &[u8],signature: &[u8]) -> Result<()> {
+        let context = self.success_receipt_context()?;
+        ensure!(now >= context.sent_at,"BCH success predates outgoing payment proof");
+        context.agreement.check_signed_success(self.quote,context.outpoint,&context.native_txid,frame,signature)?;
+        if let Some(record) = self.load_success_receipt(&context)? {
+            ensure!(now >= record.at && record.frame == frame && record.signature == signature,
+                "BCH success receipt already retained differently");return Ok(())
+        }
+        let record = Record {schema:RECORD.into(),admission:context.admission,payment:context.payment,
+            at:now,frame:frame.to_vec(),signature:signature.to_vec()};
+        let bytes = encode(&record)?;let slot = name(self.quote);
+        let pin = Pin {schema:PIN.into(),admission:context.admission,record:hash(RECORD,&bytes)};
+        self.metadata.retain(&format!("{slot}-pin"),&serde_json::to_vec(&pin)?)?;
+        Journal::open(&self.snapshots)?.retain(&slot,&bytes)?;Ok(())
+    }
+    /// Validate retained receipt without returning adaptor or redemption bytes.
+    pub fn has_received_bch_success(&self) -> Result<bool> {
+        Ok(self.load_success_receipt(&self.success_receipt_context()?)?.is_some())
+    }
+}
