diff --git a/swap-machine/src/litecoin_negotiation/execution/lock_approval.rs b/swap-machine/src/litecoin_negotiation/execution/lock_approval.rs
new file mode 100644
index 000000000..3b6a7d837
--- /dev/null
+++ b/swap-machine/src/litecoin_negotiation/execution/lock_approval.rs
@@ -0,0 +1,36 @@
+//! Explicit approval of one retained Litecoin funding transaction/action.
+use super::*;
+use crate::litecoin_rpc::{LitecoinRpc,reservation::RelayOutcome};
+
+pub struct LockFundingReview {pub details:serde_json::Value,pub commitment:[u8;32]}
+impl Execution {
+    pub fn review_litecoin_funding(&mut self,rpc:&LitecoinRpc,directory:&Path)->Result<LockFundingReview> {
+        ensure!(matches!(self.role,LocalRole::LitecoinFunder),"wrong Litecoin funding role");
+        let (head,_,quote,_,exchange)=self.load()?;
+        let (_,admitted)=self.recovery_admission(&head)?;
+        let keys=exchange.finish()?;
+        let recovery=self.recover_recovery()?;
+        let refund=recovery.refund.context("missing retained Litecoin refund")?;
+        let details=rpc.review_reserved_funding(directory,self.claim.trade,&quote,&self.policy,admitted,
+            &keys,&recovery.cancel,&refund)?;
+        let mut hash=Sha256::new();hash.update(b"MONZERO-LTC-LOCK-FUNDING-APPROVAL-V1\0");
+        hash.update(serde_json::to_vec(&details)?);
+        Ok(LockFundingReview {details,commitment:hash.finalize().into()})
+    }
+
+    /// Verify approval before signing or relay. A prior attempt uses only exact
+    /// persisted bytes through chain reconciliation; it cannot sign a new lock.
+    pub async fn submit_litecoin_funding(&mut self,rpc:&LitecoinRpc,directory:&Path,
+        approved:&[u8;32],now:u64)->Result<RelayOutcome> {
+        let review=self.review_litecoin_funding(rpc,directory)?;
+        ensure!(review.commitment==*approved,"Litecoin funding approval is stale or differs from retained action");
+        let txid=review.details["txid"].as_str().context("missing reviewed lock")?.parse()?;
+        if review.details["action"]=="retransmit" {
+            return rpc.resume_reserved_relay(directory,self.claim.trade,txid).await;
+        }
+        ensure!(review.details["action"]=="send","invalid funding action");
+        let signed=self.sign_recovered_lock(rpc,directory,now).await?;
+        ensure!(signed.transaction().compute_txid()==txid,"signing changed approved funding transaction");
+        rpc.relay_reserved_lock(directory,self.claim.trade,txid).await
+    }
+}
diff --git a/swap-machine/src/litecoin_rpc/reservation_signing.rs b/swap-machine/src/litecoin_rpc/reservation_signing.rs
index 14b8c7948..a1bfaa1f9 100644
--- a/swap-machine/src/litecoin_rpc/reservation_signing.rs
+++ b/swap-machine/src/litecoin_rpc/reservation_signing.rs
@@ -47,6 +47,63 @@ struct SigningRecord {
 struct SignedRecord { schema: String, txid: bitcoin::Txid, hex: String }
 
 impl LitecoinRpc {
+    /// Offline funding review. Validate the exact owned reservation, negotiated
+    /// recovery and any prior dispatch without signing or changing wallet locks.
+    pub(crate) fn review_reserved_funding(&self,directory:&Path,trade:uuid::Uuid,
+        quote:&crate::litecoin_quote::VerifiedLtcQuote,policy:&crate::litecoin_quote::Policy,
+        admitted:u64,keys:&crate::litecoin_negotiation::VerifiedKeys,
+        cancel:&Transaction,refund:&Transaction)->Result<Value> {
+        keys.require_ltc_funder()?;
+        let recovery=keys.recovery_policy(quote,policy,admitted)?;
+        let journal=Journal::open(directory)?;
+        let bytes=journal.read(&format!("{trade}.intent"))?;
+        let intent:Intent=serde_json::from_slice(&bytes)?;
+        ensure!(intent.trade==trade && intent.contract==keys.contract_address().to_string()
+            && self.network==policy.ltc_network,"funding review differs from negotiated deployment");
+        let preview=self.validate_intent(&intent)?;
+        quote.check_funding(policy,admitted,trade,intent.amount,intent.maximum_fee)?;
+        verify_recovery(&intent,&preview.psbt,self.network,&recovery,cancel,refund)?;
+        let txid=preview.psbt.unsigned_tx.compute_txid();
+        let owner=format!("{trade}:{txid}");
+        for input in &preview.psbt.unsigned_tx.input {
+            let key=format!("{}:{}",intent.genesis,input.previous_output);
+            ensure!(journal.read(&format!("{:x}.input",Sha256::digest(key)))?==owner.as_bytes(),"funding review input claim mismatch");
+        }
+        let quote_hash=Some(format!("{:x}",Sha256::digest(quote.record()?)));
+        let exchange_hash=Some(format!("{:x}",Sha256::digest(keys.public_record(quote)?)));
+        check_signing_context(&journal,trade,&recovery,cancel,refund,txid,quote_hash.clone(),exchange_hash.clone())?;
+        let signed_hash=retained_record_hash(&journal,trade,"signed")?;
+        let transaction=if signed_hash.is_some() {
+            journal.read(&format!("{trade}.signing"))?;
+            ensure!(retained_quote_hash(&journal,trade)?==quote_hash
+                && retained_record_hash(&journal,trade,"exchange")?==exchange_hash,"signed funding lost quote/exchange binding");
+            let signed:SignedRecord=serde_json::from_slice(&journal.read(&format!("{trade}.signed"))?)?;
+            ensure!(signed.schema=="monzero-ltc-signed-v1" && signed.txid==txid,"invalid signed funding review");
+            Some(checked_signed(&signed.hex,&preview.psbt)?)
+        } else {None};
+        let dispatch_hash=retained_record_hash(&journal,trade,"relay")?;
+        if dispatch_hash.is_some() {
+            let transaction=transaction.context("funding dispatch lacks signed bytes")?;
+            let expected=serde_json::to_vec(&json!({"schema":"monzero-ltc-relay-intent-v1","trade":trade,
+                "genesis":intent.genesis,"wallet":intent.wallet,"txid":txid,"wtxid":transaction.compute_wtxid()}))?;
+            ensure!(journal.read(&format!("{trade}.relay"))?==expected,"funding dispatch differs from signed transaction");
+        }
+        let change=LtcSegwitAddress::parse(self.network,&intent.change)?;
+        let change_atoms=preview.psbt.unsigned_tx.output.iter().filter(|o|o.script_pubkey==*change.script_pubkey())
+            .try_fold(0u64,|sum,o|sum.checked_add(o.value.to_sat())).context("funding change overflow")?;
+        let debit=intent.amount.checked_add(intent.fee).context("funding debit overflow")?;
+        let recovery_hash=Sha256::digest([bitcoin::consensus::serialize(cancel),bitcoin::consensus::serialize(refund)].concat());
+        Ok(json!({"schema":"monzero-ltc-lock-funding-review-v1","tradeId":trade,
+            "quoteCommitment":quote.commitment().iter().map(|b|format!("{b:02x}")).collect::<String>(),
+            "reservationCommitment":format!("{:x}",Sha256::digest(&bytes)),"recoveryCommitment":format!("{recovery_hash:x}"),
+            "signedCommitment":signed_hash,"dispatchCommitment":dispatch_hash,
+            "action":if dispatch_hash.is_some(){"retransmit"}else{"send"},"txid":txid,"wallet":intent.wallet,
+            "anchor":intent.anchor,"contract":intent.contract,"change":intent.change,"changeAtoms":change_atoms.to_string(),
+            "amountAtoms":intent.amount.to_string(),"feeAtoms":intent.fee.to_string(),"maximumFeeAtoms":intent.maximum_fee.to_string(),
+            "totalDebitAtoms":debit.to_string(),"inputCount":preview.psbt.inputs.len().to_string(),
+            "refundAddress":recovery.refund_address,"expiresAt":quote.terms()["expiresAt"],"chainObserved":false}))
+    }
+
     /// Trusted caller must already have authenticated/approved the negotiated
     /// trade and persisted peer recovery state. This API does not grant approval.
     /// At most one automatic send attempt per trade, with intent synced first.
