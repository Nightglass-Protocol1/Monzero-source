+    fn bitcoin_address_and_script_constructors_preserve_wire_transactions() {
+        use bitcoin::{Address, Network};
+        use bitcoin_wallet::primitives::Watchable;
+
+        let keys = FixtureKeys::new();
+        let lock = TxLock::from_psbt(
+            funded_psbt(vec![lock_output(AMOUNT), change_output()]),
+            keys.a.public(), keys.b.public(), Amount::from_sat(AMOUNT),
+        ).unwrap();
+        let fee = Amount::from_sat(2000);
+        let cancel = TxCancel::new(&lock, CancelTimelock::new(12),
+            keys.a.public(), keys.b.public(), fee).unwrap();
+        // Different witness versions and script sizes must preserve the signed
+        // transaction, sighash and observer destination on the legacy BTC path.
+        for script in [p2wpkh(3), shared_script(), ScriptBuf::from_hex(
+            "512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"
+        ).unwrap()] {
+            let address = Address::from_script(&script, Network::Regtest).unwrap();
+            for sequence in [None, Some(0), Some(12), Some(u32::MAX)] {
+                assert_eq!(lock.build_spend_transaction(&address, sequence, fee),
+                    lock.build_spend_transaction_to_script(&script, sequence, fee));
+            }
+            assert_eq!(cancel.build_spend_transaction(&address, None, fee),
+                cancel.build_spend_transaction_to_script(&script, None, fee));
+            let legacy = TxRedeem::new(&lock, &address, fee);
+            let direct = TxRedeem::new_to_script(&lock, &script, fee);
+            assert_eq!(legacy.txid(), direct.txid());
+            assert_eq!(legacy.digest(), direct.digest());
+            assert_eq!(legacy.script(), direct.script());
+            let encrypted = keys.b.encsign(keys.s_a.public(), direct.digest());
+            assert_eq!(legacy.complete(encrypted.clone(), keys.a.clone(),
+                keys.s_a.clone().into(), keys.b.public()).unwrap(),
+                direct.complete(encrypted, keys.a.clone(),
+                keys.s_a.clone().into(), keys.b.public()).unwrap());
+            let legacy = TxFullRefund::new(&cancel, &address, fee);
+            let direct = TxFullRefund::new_to_script(&cancel, &script, fee);
+            assert_eq!(legacy.txid(), direct.txid());
+            assert_eq!(legacy.digest(), direct.digest());
+            assert_eq!(legacy.script(), direct.script());
+            let sign = |tx: TxFullRefund| {
+                let a = keys.a.sign(tx.digest());
+                let b = keys.b.sign(tx.digest());
+                tx.add_signatures((keys.a.public(), a), (keys.b.public(), b)).unwrap()
+            };
