+use super::*;
+use crate::litecoin_light::session::tests::{server, reply, regtest_handshake};
+fn script() -> bitcoin::ScriptBuf { bitcoin::ScriptBuf::from_bytes(vec![0x51]) }
+
+#[tokio::test]
+async fn history_reports_positions_and_queries_exact_script_hash() -> Result<()> {
+    let ids = ["11".repeat(32), "22".repeat(32), "33".repeat(32)];
+    let mut responses = regtest_handshake();
+    responses.push(reply(3, json!([
+        {"tx_hash":ids[0],"height":12},
+        {"tx_hash":ids[1],"height":0,"fee":100},
+        {"tx_hash":ids[2],"height":-1,"fee":200}])));
+    responses.push(reply(4, json!([])));
+    let (stream, task) = server(responses);
+    let mut session = ReadSession::negotiate(stream, LtcNetwork::Regtest).await?;
+    let history = session.reported_history(&script(), 3).await?;
+    assert_eq!(history.iter().map(|entry| entry.txid().to_string()).collect::<Vec<_>>(), ids);
+    assert_eq!(history.iter().map(|entry| entry.position()).collect::<Vec<_>>(),
+        [ReportedPosition::Block(12), ReportedPosition::Mempool, ReportedPosition::MempoolWithUnconfirmedParents]);
+    assert!(session.reported_history(&script(), 1).await?.is_empty());
+    drop(session);
+    let requests = task.await?;
+    assert_eq!(requests[2]["method"], "blockchain.scripthash.get_history");
+    assert_eq!(requests[2]["params"], json!([script_hash(&script())]));
+    Ok(())
+}
+
+#[tokio::test]
+async fn history_invalid_reports_poison_session_without_partial_results() -> Result<()> {
+    let id = "11".repeat(32);
+    for value in [
+        json!([{"tx_hash":id,"height":-2}]),
+        json!([{"tx_hash":id,"height":4294967296u64}]),
+        json!([{"tx_hash":"invalid","height":1}]),
+        json!([{"tx_hash":id,"height":1},{"tx_hash":id,"height":0}]),
+        json!([{"tx_hash":id,"height":0,"fee":-1}]),
+        json!([{"tx_hash":id,"height":1,"extra":true}]),
+        json!([{"tx_hash":id,"height":1.5}]),
+        json!([{"tx_hash":id,"height":1},{"tx_hash":"22".repeat(32),"height":2},{"tx_hash":"33".repeat(32),"height":3}]),
+        json!(null),
+    ] {
+        let mut responses = regtest_handshake(); responses.push(reply(3, value));
+        let (stream, task) = server(responses);
+        let mut session = ReadSession::negotiate(stream, LtcNetwork::Regtest).await?;
+        assert!(session.reported_history(&script(), 2).await.is_err());
+        assert!(session.reported_history(&script(), 2).await.is_err());
+        drop(session); assert_eq!(task.await?.len(), 3);
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn history_local_limits_fail_before_network_io() -> Result<()> {
+    let (stream, task) = server(regtest_handshake());
+    let mut session = ReadSession::negotiate(stream, LtcNetwork::Regtest).await?;
+    for maximum in [0,1001,usize::MAX] {
+        assert!(session.reported_history(&script(), maximum).await.is_err());
+    }
+    assert!(session.reported_history(bitcoin::Script::new(), 1).await.is_err());
+    assert!(session.reported_history(&bitcoin::ScriptBuf::from_bytes(vec![0;10001]), 1).await.is_err());
+    assert!(session.usable);
+    drop(session); assert_eq!(task.await?.len(), 2); Ok(())
+}
