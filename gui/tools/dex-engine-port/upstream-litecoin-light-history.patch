+//! Server-reported script history, used only as discovery hints.
+//! A server can omit transactions or invent entries. Empty history is not
+//! proof that an address was never used, and these entries authorize no spend.
+use super::*;
+use std::collections::BTreeSet;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReportedPosition {
+    Block(u32),
+    Mempool,
+    MempoolWithUnconfirmedParents,
+}
+
+pub struct ReportedTransaction {
+    txid: Txid,
+    position: ReportedPosition,
+}
+impl ReportedTransaction {
+    pub fn txid(&self) -> Txid { self.txid }
+    pub fn position(&self) -> ReportedPosition { self.position }
+}
+
+impl<S: AsyncRead + AsyncWrite + Unpin> ReadSession<S> {
+    /// Query one script with an explicit entry budget (1..=1000).
+    /// Sends its script hash to the configured peer, disclosing wallet interest.
+    /// No balances, confirmations, completeness or unspentness are inferred.
+    pub async fn reported_history(&mut self, script: &Script, maximum: usize)
+        -> Result<Vec<ReportedTransaction>> {
+        ensure!(!script.is_empty() && script.len() <= 10_000 && (1..=1000).contains(&maximum),
+            "invalid Litecoin script history request");
+        let outcome = self.history_inner(script, maximum).await;
+        if outcome.is_err() { self.usable = false; }
+        outcome
+    }
+
+    async fn history_inner(&mut self, script: &Script, maximum: usize)
+        -> Result<Vec<ReportedTransaction>> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Entry { tx_hash: String, height: i64, fee: Option<u64> }
+        let (_, bytes) = self.exchange("blockchain.scripthash.get_history",
+            json!([script_hash(script)]), maximum * 160 + 1024).await?;
+        let entries: Vec<Entry> = result(&bytes)?;
+        ensure!(entries.len() <= maximum, "Litecoin history exceeds entry budget");
+        let mut seen = BTreeSet::new();
+        let mut history = Vec::with_capacity(entries.len());
+        for entry in entries {
+            let txid: Txid = entry.tx_hash.parse().context("invalid Litecoin history transaction ID")?;
+            ensure!(seen.insert(txid), "duplicate Litecoin history transaction");
+            let position = match entry.height {
+                -1 => ReportedPosition::MempoolWithUnconfirmedParents,
+                0 => ReportedPosition::Mempool,
+                height if height > 0 && height <= u32::MAX as i64 => ReportedPosition::Block(height as u32),
+                _ => anyhow::bail!("invalid Litecoin history height"),
+            };
+            // Fee is checked for integer shape, but remains an unused peer claim.
+            let _ = entry.fee;
+            history.push(ReportedTransaction { txid, position });
+        }
+        Ok(history)
+    }
+}
