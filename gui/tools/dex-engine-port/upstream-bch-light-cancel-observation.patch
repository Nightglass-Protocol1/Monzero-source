+use super::*;
+use agreement::execution::AdmittedExecution;
+use bitcoin::BlockHash;
+use std::sync::atomic::Ordering;
+use sha2::{Digest,Sha256};
+fn hashes(path:&std::path::Path)->Result<std::collections::BTreeMap<std::ffi::OsString,[u8;32]>> {
+    let mut result=std::collections::BTreeMap::new();
+    for entry in std::fs::read_dir(path)? {
+        let entry=entry?;if entry.file_type()?.is_file() {result.insert(entry.file_name(),Sha256::digest(std::fs::read(entry.path())?).into());}
+    }
+    Ok(result)
+}
+pub(super) async fn exercise(execution:&AdmittedExecution<'_>,setup:&Setup,fixture:&super::light_observer::Fixture,
+    metadata:&std::path::Path,snapshots:&std::path::Path)->Result<[u8;32]> {
+    let observer=&fixture.observer;let block=Some(BlockHash::from_byte_array([6;32]));
+    let recovery=execution.retained_bch_recovery()?.context("missing fixture recovery")?;
+    *fixture.redemption.lock().unwrap()=Some(recovery.cancel().clone());
+    fixture.recovery_outputs.store(true,Ordering::SeqCst);
+    let public=hashes(metadata)?;let private=hashes(snapshots)?;
+    let review=execution.review_light_bch_cancel_relay(observer,2010)?;
+    assert_eq!(review.details["schema"],"monzero-bch-light-cancel-relay-review-v1");
+    assert_eq!(review.details["fundingSource"],"local-wallet");
+    assert_eq!(review.details["txid"],recovery.cancel().compute_txid().to_string());
+    let fields:std::collections::BTreeSet<_>=review.details.as_object().context("review must be an object")?.keys().map(String::as_str).collect();
+    let expected:std::collections::BTreeSet<_>=["schema","action","swapId","quote","admission","privateRecovery","bchDeployment",
+        "bchNetwork","bchGenesis","fundingOutpoint","txid","recoveryScript","recoveryAtoms","feeAtoms","cancelDelayBlocks",
+        "minimumBchConfirmations","preparedAt","fundingSource"].into_iter().collect();
+    assert_eq!(fields,expected);
+    assert!(execution.light_bch_cancel_relay_state(observer,2010)?.is_none());
+    let calls=fixture.calls.load(Ordering::Relaxed);
+    let port=u16::try_from(observer.deployment_context()?["port"].as_u64().context("missing fixture port")?)?;
+    let changed=crate::bch_rpc::observer::OwnedBchObserver::new(if port==65535 {port-1}else{port+1},
+        "user".into(),"pass".into(),observer.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+    let node=crate::bch_rpc::BchRpc::new(port,"user".into(),"pass".into(),observer.network(),"test".into(),
+        "bchreg:qanchor".into(),bitcoin::ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+    assert!(execution.review_light_bch_cancel_relay(&changed,2010).is_err());
+    assert!(execution.review_light_bch_cancel_relay(observer,2000).err().context("early binding must fail")?
+        .to_string().contains("binding time changed"));
+    assert!(execution.observe_light_bch_cancel(&changed,block,2010).await.is_err());
+    assert!(execution.review_bch_cancel_relay(&node,2010).is_err());
+    assert!(execution.bch_cancel_relay_state().is_err());
+    assert!(execution.observe_bch_cancel(&node,block).await.is_err());
+    // An acknowledgement without a dispatch intent cannot become confirmed history.
+    let orphan=metadata.join(format!("{}.bch-cancel-relay-ack",setup.quote.terms()["swapId"]));
+    {use std::{io::Write,os::unix::fs::OpenOptionsExt};
+        std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&orphan)?.write_all(b"{}")?;}
+    let rejected=execution.review_light_bch_cancel_relay(observer,2010);
+    std::fs::remove_file(orphan)?;
+    assert!(rejected.err().context("orphan acknowledgement must fail")?.to_string().contains("acknowledgement lacks intent"));
+    assert_eq!(fixture.calls.load(Ordering::Relaxed),calls);
+    // Commercial expiry does not prevent recovery of already retained funding.
+    let late=setup.quote.terms()["expiresAt"].parse::<u64>()?.checked_add(10000).context("fixture time overflow")?;
+    assert_eq!(execution.review_light_bch_cancel_relay(observer,late)?.commitment,review.commitment);
+    for hint in [block,None] {
+        let cancellation=execution.observe_light_bch_cancel(observer,hint,late).await?;
+        assert_eq!(cancellation.quote(),setup.quote.commitment());assert_eq!(cancellation.review(),&review.commitment);
+        assert_eq!(cancellation.confirmation().transaction(),recovery.cancel());
+        assert_eq!(cancellation.confirmation().deployment(),&observer.deployment_commitment()?);
+    }
+    for mode in [1,2,3] {
+        fixture.redemption_mode.store(mode,Ordering::SeqCst);
+        let before=fixture.calls.load(Ordering::Relaxed);
+        let rejected=execution.observe_light_bch_cancel(observer,block,late).await;
+        let expected=if mode==2 {"bytes differ"}else{"not confirmed"};
+        assert!(rejected.err().context("invalid cancellation must fail")?.to_string().contains(expected));
+        assert!(fixture.calls.load(Ordering::Relaxed)>before);
+    }
+    fixture.redemption_mode.store(0,Ordering::SeqCst);
+    for mode in [1,2,3] {
+        fixture.recovery_output_mode.store(mode,Ordering::SeqCst);
+        let before=fixture.calls.load(Ordering::Relaxed);
+        let rejected=execution.observe_light_bch_recovery_output(observer,block,late).await;
+        let expected=if mode==1 {"spent or unavailable"}else{"differs from exact parent"};
+        assert!(rejected.err().context("invalid recovery output must fail")?.to_string().contains(expected));
+        assert!(fixture.calls.load(Ordering::Relaxed)>before);
+    }
+    fixture.recovery_output_mode.store(0,Ordering::SeqCst);
+    let confirmed=execution.observe_light_bch_recovery_output(observer,block,late).await?;
+    assert_eq!(confirmed.cancellation().review(),&review.commitment);
+    assert_eq!(confirmed.output().outpoint(),bitcoin::OutPoint {txid:recovery.cancel().compute_txid(),vout:0});
+    assert_eq!(confirmed.output().output(),&recovery.cancel().output[0]);
+    confirmed.output().require_refund_window(u64::from(setup.policy.bch_confirmations),u32::from(setup.policy.punish_blocks),5)?;
+    let unsafe_margin=u32::from(setup.policy.punish_blocks)-3;
+    assert!(confirmed.output().require_refund_window(u64::from(setup.policy.bch_confirmations),u32::from(setup.policy.punish_blocks),unsafe_margin)
+        .err().context("punishment boundary must fail")?.to_string().contains("too close to punishment"));
+    assert!(execution.light_bch_cancel_relay_state(observer,late)?.is_none());
+    assert_eq!(hashes(metadata)?,public);assert_eq!(hashes(snapshots)?,private);
+    Ok(review.commitment)
+}
