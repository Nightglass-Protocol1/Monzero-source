+impl AdmittedExecution<'_> {
+    /// A peer may publish cancellation without a local relay attempt. Validate
+    /// exact retained recovery and any existing history; do not invent an ack.
+    pub async fn observe_light_bch_cancel(&self,bch:&OwnedBchObserver,block:Option<BlockHash>,now:u64)
+        ->Result<ConfirmedCancellation> {
+        let (review,cancel,_,at,deployment)=self.funder_cancel_relay_materials(Some((bch,now)))?;
+        self.cancel_state(&review,at,cancel.compute_txid())?;
+        let admission=self.admission_digest()?;let minimum=u64::from(self.policy.bch_confirmations);
+        let confirmation=match block {
+            Some(block)=>bch.confirmed_transaction(cancel.compute_txid(),block,minimum).await?,
+            None=>bch.indexed_confirmed_transaction(cancel.compute_txid(),minimum).await?,
+        };
+        ensure!(confirmation.deployment()==&deployment && serialize(confirmation.transaction())==serialize(&cancel),
+            "confirmed BCH cancellation differs from retained recovery");
+        Ok(ConfirmedCancellation {quote:*self.quote.commitment(),admission,review:review.commitment,confirmation})
+    }
+    /// Same-tip read-only evidence, not refund release or relay permission.
+    pub async fn observe_light_bch_recovery_output(&self,bch:&OwnedBchObserver,block:Option<BlockHash>,now:u64)
+        ->Result<ConfirmedRecoveryOutput> {
+        let cancellation=self.observe_light_bch_cancel(bch,block,now).await?;
+        let output=bch.confirmed_unspent_output(cancellation.confirmation(),0).await?;
+        Ok(ConfirmedRecoveryOutput {cancellation,output})
+    }
+}
