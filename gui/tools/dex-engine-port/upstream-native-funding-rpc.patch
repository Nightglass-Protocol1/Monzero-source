+    #[test]
+    fn display_payload_preserves_large_integers_and_excludes_signing_material() -> Result<()> {
+        let mut estimate = estimate_fixture()?;
+        estimate.request.amount = XmzAmount::from_atoms(9007199254740993);
+        estimate.fee = XmzAmount::from_atoms(9007199254740995);
+        estimate.weight = u64::MAX;
+        estimate.snapshot.tip_height = u64::MAX;
+        let id = uuid::Uuid::from_u128(1);
+        let payload = display_payload(id, &estimate);
+        let roundtrip: Value = serde_json::from_slice(&serde_json::to_vec(&payload)?)?;
+        assert_eq!(roundtrip["amountAtoms"], json!("9007199254740993"));
+        assert_eq!(roundtrip["feeAtoms"], json!("9007199254740995"));
+        assert_eq!(roundtrip["weight"], json!(u64::MAX.to_string()));
+        assert_eq!(roundtrip["tipHeight"], json!(u64::MAX.to_string()));
+        assert_eq!(roundtrip["requestId"], json!(id.to_string()));
+        assert_eq!(roundtrip["executable"], json!(false));
+        assert_eq!(roundtrip.as_object().unwrap().len(), 14);
+        for field in ["password","tx_key","tx_blob","tx_metadata","signature","spendkey","viewkey"] {
+            assert!(roundtrip.get(field).is_none());
+        }
+        Ok(())
+    }
+    #[tokio::test]
+    async fn rejects_changed_context_and_missing_observations() -> Result<()> {
+        let estimate = estimate_fixture()?;
