+    }
+    fn estimate_fixture() -> Result<FeeEstimate> {
+        let address = XmzAddress::parse(swap_core::xmz_address::XmzNetwork::Mainnet,
+            "FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H")?;
+        Ok(FeeEstimate {
