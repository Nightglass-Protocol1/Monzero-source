@@ -0,0 +1,96 @@
+//! Experimental Linux pipe helper. Never accepts session secrets in request JSON.
+//! The launcher must own the wallet service exclusively; the session-file lock
+//! only serializes helpers sharing that file, not arbitrary RPC clients.
+#[cfg(target_os = "linux")]
+mod linux {
+    use anyhow::{Result, ensure};
+    use std::{fs::{File, OpenOptions}, io::Read, os::{fd::AsFd, unix::fs::{MetadataExt, OpenOptionsExt}}, path::Path};
+    use swap_core::xmz_address::XmzNetwork;
+    use swap_machine::native_funding_rpc::{NativeFundingRpc, fee_estimation::NativeFeeEstimator};
+    use zeroize::{Zeroize, Zeroizing};
+
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields, rename_all = "camelCase")]
+    struct Session {
+        schema: String, network: String, genesis: String,
+        daemon_port: u16, wallet_port: u16, username: String, password: String,
+    }
+
+    impl Drop for Session {
+        fn drop(&mut self) { self.username.zeroize(); self.password.zeroize(); }
+    }
+
+    fn load(path: &Path) -> Result<(File, Session)> {
+        ensure!(path.is_absolute(), "session path must be absolute");
+        let file = OpenOptions::new().read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC).open(path)?;
+        let metadata = file.metadata()?;
+        // SAFETY: geteuid takes no arguments and has no memory-safety preconditions.
+        let uid = unsafe { libc::geteuid() };
+        ensure!(metadata.is_file() && metadata.uid() == uid && metadata.mode() & 0o7777 == 0o600
+            && metadata.nlink() == 1 && metadata.len() <= 2048, "unsafe session file");
+        file.try_lock()?;
+        let mut bytes = Zeroizing::new(Vec::new());
+        (&file).take(2049).read_to_end(&mut bytes)?;
+        ensure!(bytes.len() <= 2048, "oversized session file");
+        let session: Session = serde_json::from_slice(&bytes)?;
+        ensure!(session.schema == "monzero-native-fee-session-v1", "unsupported session schema");
+        Ok((file, session))
+    }
+
+    pub async fn run() -> Result<()> {
+        let args: Vec<_> = std::env::args_os().collect();
+        ensure!(args.len() == 4 && (args[1] == "--fee-preview-stdio-v1" || args[1] == "--wallet-control-stdio-v1") && args[2] == "--session-file",
+            "invalid helper arguments");
+        let (_session_lock, mut session) = load(Path::new(&args[3]))?;
+        let network = match session.network.as_str() {
+            "mainnet" => XmzNetwork::Mainnet, "testnet" => XmzNetwork::Testnet,
+            "stagenet" => XmzNetwork::Stagenet, _ => anyhow::bail!("invalid session network"),
+        };
+        let client = NativeFundingRpc::new(session.daemon_port, session.wallet_port,
+            std::mem::take(&mut session.username), std::mem::take(&mut session.password))?;
+        // Real nonblocking pipes: unlike blocking stdin tasks these can time out
+        // without leaving runtime shutdown waiting for a sender to close stdin.
+        let reader = tokio::net::unix::pipe::Receiver::from_owned_fd(std::io::stdin().as_fd().try_clone_to_owned()?)?;
+        let mut writer = tokio::net::unix::pipe::Sender::from_owned_fd(std::io::stdout().as_fd().try_clone_to_owned()?)?;
+        if args[1] == "--wallet-control-stdio-v1" {
+            use tokio::io::{AsyncReadExt, AsyncWriteExt};
+            use swap_machine::native_funding_rpc::wallet_session::NativeWalletSession;
+            // The process owner must record operation-pending before launch and
+            // require reconciliation on failure, timeout or an unverified reply.
+            return tokio::time::timeout(std::time::Duration::from_secs(30), async {
+                let mut bytes = Zeroizing::new(Vec::new());
+                reader.take(4097).read_to_end(&mut bytes).await?;
+                ensure!(bytes.len() <= 4096, "oversized private command");
+                let reply = NativeWalletSession::new(client, network).execute_control(&bytes,
+                    std::time::Duration::from_secs(30)).await?;
+                let output = serde_json::to_vec(&reply)?;
+                ensure!(output.len() <= 2048, "oversized wallet control reply");
+                writer.write_all(&output).await?;
+                writer.flush().await?;
+                Ok(())
+            }).await?;
+        }
+        NativeFeeEstimator::new(client).serve_preview(reader, writer, network, &session.genesis,
+            std::time::Duration::from_secs(30)).await
+    }
+}
+
+fn main() {
+    #[cfg(target_os = "linux")]
+    let success = match tokio::runtime::Builder::new_current_thread().enable_all().build() {
+        Ok(runtime) => runtime.block_on(linux::run()).is_ok(),
+        Err(_) => false,
+    };
+    #[cfg(not(target_os = "linux"))]
+    let success = false;
+    if !success {
+        // Never expose credentials, raw RPC responses or session contents.
+        if std::env::args_os().nth(1).is_some_and(|arg| arg == "--wallet-control-stdio-v1") {
+            eprintln!("Native wallet control failed");
+        } else {
+            eprintln!("Native fee preview failed");
+        }
+        std::process::exit(1);
+    }
+}
