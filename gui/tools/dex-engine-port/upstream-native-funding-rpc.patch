+        for balance in [(1001,900),(1000,899)] {
+            let source = make(unchanged(), balance, true);
+            let error = revalidate(&source, &estimate, Duration::from_secs(30)).await.unwrap_err();
+            assert_eq!(error.to_string(), "fee estimate balance is stale");
+            assert_eq!(source.snapshots.lock().unwrap().len(), 1);
+        }
+        for (source, expected) in [
+            (make(unchanged(),estimate.balance,false), "unexpected estimation wallet"),
+            (make(vec![],estimate.balance,true), "snapshot unavailable"),
+            (make(vec![estimate.snapshot.clone()],estimate.balance,true), "snapshot unavailable"),
+        ] {
+            assert_eq!(revalidate(&source,&estimate,Duration::from_secs(30)).await.unwrap_err().to_string(), expected);
+        }
+        Ok(())
+    }
+    #[tokio::test]
+    async fn rejects_chain_changes_before_and_during_revalidation() -> Result<()> {
+        let estimate = estimate_fixture()?;
+        for field in 0..3 {
+            let mut changed = estimate.snapshot.clone();
+            match field {
+                0 => changed.genesis = "3".repeat(64),
+                1 => changed.tip_hash = "4".repeat(64),
+                _ => changed.tip_height += 1,
+            }
+            for snapshots in [vec![changed.clone()], vec![estimate.snapshot.clone(),changed]] {
+                let source = ContextFixture { snapshots:std::sync::Mutex::new(snapshots.into()),
+                    balance:estimate.balance, wallet_ok:true };
+                assert_eq!(revalidate(&source,&estimate,Duration::from_secs(30)).await.unwrap_err().to_string(),
+                    "fee estimate chain is stale");
+            }
+        }
+        Ok(())
+    }
+    #[test]
+    fn freshness_expires_at_boundary_without_sleeping() {
+        let start = Instant::now();
+        let maximum = Duration::from_secs(30);
+        assert!(check_age(start, start, maximum).is_ok());
+        assert!(check_age(start, start + maximum - Duration::from_nanos(1), maximum).is_ok());
+        assert!(check_age(start, start + maximum, maximum).is_err());
+        assert!(check_age(start, start + maximum + Duration::from_nanos(1), maximum).is_err());
+        assert!(check_age(start, start, Duration::ZERO).is_err());
+        assert!(check_age(start + Duration::from_secs(1), start, maximum).is_err());
+    }
+    fn response() -> Value {
+        json!({"amount":200000000000u64,"fee":250000000u64,"weight":2000,
+            "tx_key":"","tx_blob":"","tx_metadata":"","multisig_txset":"","unsigned_txset":""})
+    }
+    #[test]
+    fn construction_explicitly_disables_relay_and_artifact_export() -> Result<()> {
+        let address = XmzAddress::parse(swap_core::xmz_address::XmzNetwork::Mainnet,
+            "FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H")?;
+        let request = FeeRequest { wallet: address.clone(), destination: address,
+            amount: XmzAmount::from_atoms(200000000001), account: 2, priority: 1 };
+        let params = construction_params(&request);
+        assert_eq!(params["do_not_relay"], json!(true));
+        for field in ["get_tx_key", "get_tx_hex", "get_tx_metadata"] {
+            assert_eq!(params[field], json!(false));
+        }
+        assert_eq!(params["destinations"][0]["amount"], json!(200000000001u64));
+        assert_eq!(params["destinations"][0]["address"], json!(request.destination.to_string()));
+        assert_eq!(params["account_index"], json!(2));
+        assert_eq!(params["priority"], json!(1));
+        assert_eq!(params["unlock_time"], json!(0));
+        assert_eq!(params["subtract_fee_from_outputs"], json!([]));
+        Ok(())
+    }
+    #[test]
+    fn validates_exact_fee_construction() -> Result<()> {
+        let (fee, weight) = parse_construction(&response(), XmzAmount::from_atoms(200000000000))?;
+        assert_eq!(fee.atoms(), 250000000);
+        assert_eq!(weight, 2000);
+        Ok(())
+    }
+    #[test]
+    fn rejects_bad_fee_evidence() {
+        let amount = XmzAmount::from_atoms(200000000000);
+        for (field, value) in [
+            ("amount", json!(1)), ("fee", json!(0)), ("fee", json!("250000000")),
+            ("fee", json!(-1)), ("fee", json!(u64::MAX)), ("weight", json!(0)),
+            ("weight", json!(true)), ("tx_key", json!("private")), ("tx_blob", json!("signed")),
+            ("tx_metadata", json!("relay")), ("multisig_txset", json!("set")),
+            ("unsigned_txset", json!("set")),
