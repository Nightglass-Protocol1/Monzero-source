@@ -0,0 +1,445 @@
+//! Explicit transaction construction, separate from the read-only observer.
+//! Requires exclusive caller ownership of the wallet service, not just this object.
+//! No relay or exported signing artifacts; not an executable quote.
+use super::{NativeFundingRpc, number, string};
+use crate::xmz_funding::{ChainSnapshot, FundingObserver};
+use anyhow::{Context, Result, ensure};
+use serde_json::{Value, json};
+use swap_core::{xmz::XmzAmount, xmz_address::{XmzAddress, XmzNetwork}};
+use std::time::{Duration, Instant};
+
+pub struct FeeRequest {
+    pub wallet: XmzAddress,
+    pub destination: XmzAddress,
+    pub amount: XmzAmount,
+    pub account: u32,
+    pub priority: u32,
+}
+
+/// Decode public request data only. Network/genesis policy comes from the caller's
+/// trusted session, never from an endpoint or credential embedded in this input.
+pub fn decode_preview_request(bytes: &[u8], network: XmzNetwork, expected_genesis: &str)
+    -> Result<(uuid::Uuid, FeeRequest)> {
+    ensure!(bytes.len() <= 2048, "oversized fee preview request");
+    ensure!(canonical_hash(expected_genesis), "invalid fee preview session chain");
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields, rename_all = "camelCase")]
+    struct Wire {
+        schema: String, request_id: String, wallet: String, destination: String,
+        amount_atoms: String, account: String, priority: String, genesis: String,
+    }
+    // Deserialize directly into a struct: duplicate fields must not be overwritten.
+    let wire: Wire = serde_json::from_slice(bytes).context("invalid fee preview request JSON")?;
+    ensure!(wire.schema == "monzero-native-fee-request-v1" && wire.genesis == expected_genesis,
+        "fee preview request policy mismatch");
+    let id: uuid::Uuid = wire.request_id.parse()?;
+    ensure!(!id.is_nil() && id.to_string() == wire.request_id, "noncanonical fee request identity");
+    let atoms = |text: &str| XmzAmount::from_atom_string(text)
+        .map_err(|_| anyhow::anyhow!("invalid fee request integer"));
+    let amount = atoms(&wire.amount_atoms)?;
+    let account = u32::try_from(atoms(&wire.account)?.atoms())?;
+    let priority = u32::try_from(atoms(&wire.priority)?.atoms())?;
+    ensure!(amount.atoms() > 0 && (1..=4).contains(&priority), "invalid fee request amount or priority");
+    Ok((id, FeeRequest {
+        wallet: XmzAddress::parse(network, &wire.wallet)?,
+        destination: XmzAddress::parse(network, &wire.destination)?,
+        amount, account, priority,
+    }))
+}
+
+pub struct FeeEstimate {
+    request: FeeRequest,
+    fee: XmzAmount,
+    weight: u64,
+    snapshot: ChainSnapshot,
+    balance: (u64, u64),
+    started: Instant,
+}
+
+impl FeeEstimate {
+    pub fn request(&self) -> &FeeRequest { &self.request }
+    pub fn fee(&self) -> XmzAmount { self.fee }
+    pub fn weight(&self) -> u64 { self.weight }
+    pub fn snapshot(&self) -> &ChainSnapshot { &self.snapshot }
+}
+
+pub struct NativeFeeEstimator {
+    client: NativeFundingRpc,
+}
+
+impl NativeFeeEstimator {
+    /// Consumes the client; caller must prevent other users of the wallet service.
+    pub fn new(client: NativeFundingRpc) -> Self { Self { client } }
+
+    /// One EOF-framed request on caller-owned pipes; session secrets never enter
+    /// the request. Failure may leave partial output, so consumers require a
+    /// successful process exit as well as a complete, validated response.
+    pub async fn serve_preview<R, W>(&mut self, reader: R, mut writer: W,
+        network: XmzNetwork, expected_genesis: &str, budget: Duration) -> Result<()>
+    where R: tokio::io::AsyncRead + Unpin, W: tokio::io::AsyncWrite + Unpin {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        ensure!(!budget.is_zero() && budget <= Duration::from_secs(30), "invalid fee request time budget");
+        tokio::time::timeout(budget, async {
+            let mut bytes = Vec::new();
+            reader.take(2049).read_to_end(&mut bytes).await.context("fee request pipe read")?;
+            ensure!(bytes.len() <= 2048, "oversized fee preview request");
+            let response = self.preview_request(&bytes, network, expected_genesis, budget).await?;
+            let output = serde_json::to_vec(&response)?;
+            ensure!(output.len() <= 2048, "oversized fee preview response");
+            writer.write_all(&output).await.context("fee response pipe write")?;
+            writer.flush().await.context("fee response pipe flush")?;
+            Ok(())
+        }).await.context("fee preview pipe operation timed out")?
+    }
+
+    /// One bounded operation for a trusted stdio/session wrapper. A timeout drops
+    /// the client future; it cannot roll back server-side construction already begun.
+    pub async fn preview_request(&mut self, bytes: &[u8], network: XmzNetwork,
+        expected_genesis: &str, budget: Duration) -> Result<Value> {
+        ensure!(!budget.is_zero() && budget <= Duration::from_secs(30), "invalid fee request time budget");
+        let (id, request) = decode_preview_request(bytes, network, expected_genesis)?;
+        tokio::time::timeout(budget, async {
+            let estimate = self.estimate(request, expected_genesis).await?;
+            self.preview_for_display(id, &estimate, budget).await
+        }).await.context("fee preview request timed out")?
+    }
+
+    pub async fn estimate(&mut self, request: FeeRequest, expected_genesis: &str) -> Result<FeeEstimate> {
+        let started = Instant::now();
+        ensure!(canonical_hash(expected_genesis), "invalid fee-estimation chain policy");
+        ensure!(request.amount.atoms() > 0 && (1..=4).contains(&request.priority),
+            "invalid fee construction request");
+        ensure!(request.wallet.network() == request.destination.network(), "fee address network mismatch");
+        let before = self.client.snapshot().await?;
+        ensure!(before.genesis == expected_genesis && canonical_hash(&before.tip_hash),
+            "unexpected fee-estimation chain");
+        self.check_wallet(&request).await?;
+        let balance = self.balance(request.account).await?;
+        ensure!(balance.1 >= request.amount.atoms(), "insufficient unlocked principal");
+        let response = self.client.rpc(self.client.wallet, "transfer", construction_params(&request)).await?;
+        let (fee, weight) = parse_construction(&response, request.amount)?;
+        let debit = request.amount.checked_add(fee).context("fee debit overflow")?;
+        ensure!(balance.1 >= debit.atoms(), "insufficient unlocked funds for fee");
+        self.check_wallet(&request).await?;
+        ensure!(self.balance(request.account).await? == balance, "wallet changed during fee construction");
+        ensure!(self.client.snapshot().await? == before, "chain changed during fee construction");
+        Ok(FeeEstimate { request, fee, weight, snapshot: before, balance, started })
+    }
+
+    /// Recheck display freshness only. Equal balances do not prove identical inputs.
+    /// Never use this as signing, reservation or broadcast authorization.
+    pub async fn revalidate_for_display(&mut self, estimate: &FeeEstimate, maximum_age: Duration) -> Result<()> {
+        revalidate(self, estimate, maximum_age).await
+    }
+
+    /// Caller must correlate this request ID and enforce its own receive deadline.
+    /// Export is display-only; transport, persistence or replay never grants authority.
+    pub async fn preview_for_display(&mut self, request_id: uuid::Uuid,
+        estimate: &FeeEstimate, maximum_age: Duration) -> Result<Value> {
+        ensure!(!request_id.is_nil(), "missing fee preview request identity");
+        self.revalidate_for_display(estimate, maximum_age).await?;
+        Ok(display_payload(request_id, estimate))
+    }
+
+    async fn check_wallet(&self, request: &FeeRequest) -> Result<()> {
+        // Primary address binds wallet identity; account selection is separately explicit.
+        let response = self.client.rpc(self.client.wallet, "get_address", json!({"account_index":0})).await?;
+        ensure!(string(&response, "address")? == request.wallet.to_string(), "unexpected estimation wallet");
+        Ok(())
+    }
+
+    async fn balance(&self, account: u32) -> Result<(u64, u64)> {
+        let response = self.client.rpc(self.client.wallet, "get_balance", json!({"account_index":account})).await?;
+        Ok((number(&response, "balance")?, number(&response, "unlocked_balance")?))
+    }
+}
+
+fn display_payload(request_id: uuid::Uuid, estimate: &FeeEstimate) -> Value {
+    json!({
+        "schema":"monzero-native-fee-preview-v1",
+        "requestId":request_id.to_string(),
+        "source":"native-nonrelayed-construction",
+        "executable":false,
+        "wallet":estimate.request.wallet.to_string(),
+        "destination":estimate.request.destination.to_string(),
+        "amountAtoms":estimate.request.amount.atom_string(),
+        "feeAtoms":estimate.fee.atom_string(),
+        "weight":estimate.weight.to_string(),
+        "account":estimate.request.account.to_string(),
+        "priority":estimate.request.priority.to_string(),
+        "genesis":estimate.snapshot.genesis,
+        "tipHash":estimate.snapshot.tip_hash,
+        "tipHeight":estimate.snapshot.tip_height.to_string()
+    })
+}
+
+// Private testing seam: peer data cannot supply an implementation to the public API.
+#[async_trait::async_trait]
+trait DisplayContext: Sync {
+    async fn snapshot(&self) -> Result<ChainSnapshot>;
+    async fn wallet(&self, request: &FeeRequest) -> Result<()>;
+    async fn balance(&self, account: u32) -> Result<(u64, u64)>;
+}
+
+#[async_trait::async_trait]
+impl DisplayContext for NativeFeeEstimator {
+    async fn snapshot(&self) -> Result<ChainSnapshot> { self.client.snapshot().await }
+    async fn wallet(&self, request: &FeeRequest) -> Result<()> { self.check_wallet(request).await }
+    async fn balance(&self, account: u32) -> Result<(u64, u64)> { NativeFeeEstimator::balance(self, account).await }
+}
+
+async fn revalidate(source: &impl DisplayContext, estimate: &FeeEstimate, maximum_age: Duration) -> Result<()> {
+    check_age(estimate.started, Instant::now(), maximum_age)?;
+    ensure!(source.snapshot().await? == estimate.snapshot, "fee estimate chain is stale");
+    source.wallet(&estimate.request).await?;
+    ensure!(source.balance(estimate.request.account).await? == estimate.balance, "fee estimate balance is stale");
+    ensure!(source.snapshot().await? == estimate.snapshot, "fee estimate chain is stale");
+    check_age(estimate.started, Instant::now(), maximum_age)
+}
+
+fn canonical_hash(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn check_age(started: Instant, now: Instant, maximum: Duration) -> Result<()> {
+    ensure!(!maximum.is_zero(), "fee estimate age limit must be positive");
+    let age = now.checked_duration_since(started).context("fee estimate clock mismatch")?;
+    ensure!(age < maximum, "fee estimate expired");
+    Ok(())
+}
+
+fn construction_params(request: &FeeRequest) -> Value {
+    json!({
+        "destinations":[{"address":request.destination.to_string(), "amount":request.amount.atoms()}],
+        "account_index":request.account, "priority":request.priority,
+        "do_not_relay":true, "get_tx_key":false, "get_tx_hex":false, "get_tx_metadata":false,
+        "unlock_time":0, "subtract_fee_from_outputs":[]
+    })
+}
+
+fn parse_construction(response: &Value, amount: XmzAmount) -> Result<(XmzAmount, u64)> {
+    ensure!(number(response, "amount")? == amount.atoms(), "fee construction principal mismatch");
+    let fee = number(response, "fee")?;
+    let weight = number(response, "weight")?;
+    ensure!(fee > 0 && weight > 0, "invalid constructed fee or weight");
+    for field in ["tx_key", "tx_blob", "tx_metadata", "multisig_txset", "unsigned_txset"] {
+        ensure!(response.get(field).and_then(Value::as_str) == Some(""),
+            "unexpected signing artifacts in fee response");
+    }
+    ensure!(amount.checked_add(XmzAmount::from_atoms(fee)).is_some(), "fee debit overflow");
+    Ok((XmzAmount::from_atoms(fee), weight))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn pipe_rejects_invalid_oversized_and_stalled_input_without_output() -> Result<()> {
+        let mut estimator = NativeFeeEstimator::new(NativeFundingRpc::new(1, 2, "test".into(), "test".into())?);
+        for input in [b"{}".to_vec(), vec![b' ';2049]] {
+            let mut output = Vec::new();
+            assert!(estimator.serve_preview(input.as_slice(), &mut output, XmzNetwork::Mainnet,
+                &"1".repeat(64), Duration::from_secs(1)).await.is_err());
+            assert!(output.is_empty());
+        }
+        let (reader, _held_open) = tokio::io::duplex(64);
+        let mut output = Vec::new();
+        let error = estimator.serve_preview(reader, &mut output, XmzNetwork::Mainnet,
+            &"1".repeat(64), Duration::from_millis(10)).await.unwrap_err();
+        assert_eq!(error.to_string(), "fee preview pipe operation timed out");
+        assert!(output.is_empty());
+        Ok(())
+    }
+    fn wire_fixture() -> Value {
+        let address = "FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H";
+        json!({"schema":"monzero-native-fee-request-v1","requestId":uuid::Uuid::from_u128(1).to_string(),
+            "wallet":address,"destination":address,"amountAtoms":"9007199254740993",
+            "account":"0","priority":"1","genesis":"1".repeat(64)})
+    }
+    #[test]
+    fn decodes_exact_request_under_local_policy() -> Result<()> {
+        let bytes = serde_json::to_vec(&wire_fixture())?;
+        let (id,request) = decode_preview_request(&bytes,XmzNetwork::Mainnet,&"1".repeat(64))?;
+        assert_eq!(id,uuid::Uuid::from_u128(1));
+        assert_eq!(request.amount.atoms(),9007199254740993);
+        assert_eq!(request.account,0);
+        assert_eq!(request.priority,1);
+        assert!(decode_preview_request(&bytes,XmzNetwork::Testnet,&"1".repeat(64)).is_err());
+        assert!(decode_preview_request(&bytes,XmzNetwork::Mainnet,&"2".repeat(64)).is_err());
+        Ok(())
+    }
+    #[test]
+    fn rejects_untrusted_request_fields_and_encodings() -> Result<()> {
+        for (field,value) in [
+            ("amountAtoms",json!(1)),("amountAtoms",json!("0")),("amountAtoms",json!("01")),
+            ("account",json!("4294967296")),("priority",json!("0")),("priority",json!("5")),
+            ("requestId",json!(uuid::Uuid::nil().to_string())),("requestId",json!("bad")),
+            ("wallet",json!("bad")),("destination",json!("bad")),("schema",json!("other")),
+            ("rpcUrl",json!("http://example.invalid")),("password",json!("not-allowed")),
+        ] {
+            let mut wire = wire_fixture();
+            wire[field] = value;
+            assert!(decode_preview_request(&serde_json::to_vec(&wire)?,XmzNetwork::Mainnet,&"1".repeat(64)).is_err());
+        }
+        let mut duplicate = serde_json::to_vec(&wire_fixture())?;
+        duplicate.pop();
+        duplicate.extend_from_slice(b",\"priority\":\"1\"}");
+        assert!(decode_preview_request(&duplicate,XmzNetwork::Mainnet,&"1".repeat(64)).is_err());
+        assert!(decode_preview_request(&vec![b' ';2049],XmzNetwork::Mainnet,&"1".repeat(64)).is_err());
+        Ok(())
+    }
+    struct ContextFixture {
+        snapshots: std::sync::Mutex<std::collections::VecDeque<ChainSnapshot>>,
+        balance: (u64, u64),
+        wallet_ok: bool,
+    }
+    #[async_trait::async_trait]
+    impl DisplayContext for ContextFixture {
+        async fn snapshot(&self) -> Result<ChainSnapshot> {
+            self.snapshots.lock().map_err(|_| anyhow::anyhow!("fixture lock"))?
+                .pop_front().context("snapshot unavailable")
+        }
+        async fn wallet(&self, _: &FeeRequest) -> Result<()> {
+            ensure!(self.wallet_ok, "unexpected estimation wallet");
+            Ok(())
+        }
+        async fn balance(&self, account: u32) -> Result<(u64,u64)> {
