new file mode 100644
index 0000000..4bdcb67
--- /dev/null
+++ b/swap-machine/src/native_funding_rpc/wallet_session.rs
@@ -0,0 +1,177 @@
+//! Wallet lifecycle operations, separate from funding observation and fee preview.
+//! Caller must exclusively own a dedicated RPC service and serialize all users.
+//! No transaction creation, signing or broadcast. No automatic error retry.
+use super::NativeFundingRpc;
+use anyhow::{Context, Result, ensure};
+use serde_json::json;
+use swap_core::xmz_address::{XmzAddress, XmzNetwork};
+use zeroize::{Zeroize, Zeroizing};
+
+pub struct SwapWalletId(uuid::Uuid);
+
+impl SwapWalletId {
+    pub fn new(id: uuid::Uuid) -> Result<Self> {
+        ensure!(!id.is_nil(), "nil swap wallet identity");
+        Ok(Self(id))
+    }
+    pub fn filename(&self) -> String { format!("swap-{}", self.0.simple()) }
+}
+
+pub struct NativeWalletSession {
+    client: NativeFundingRpc,
+    network: XmzNetwork,
+    uncertain: bool,
+}
+
+impl NativeWalletSession {
+    pub fn new(client: NativeFundingRpc, network: XmzNetwork) -> Self {
+        Self { client, network, uncertain: false }
+    }
+
+    /// Private local command data, NOT peer/offer JSON. The caller owns and must
+    /// clear its input buffer. Timeout cannot undo server-side wallet operations.
+    pub async fn execute_control(&mut self, bytes: &[u8], budget: std::time::Duration) -> Result<serde_json::Value> {
+        ensure!(!budget.is_zero() && budget <= std::time::Duration::from_secs(30), "invalid wallet command budget");
+        let (request_id, command) = decode_control(bytes, self.network)?;
+        tokio::time::timeout(budget, async {
+            let (operation, address) = match command {
+                Control::Create(id, mut password) => ("create", self.create(&id, std::mem::take(&mut *password)).await?),
+                Control::Open(id, mut password, address) => {
+                    self.open(&id, std::mem::take(&mut *password), &address).await?;
+                    ("open", address)
+                }
+                Control::Close(address) => { self.close(&address).await?; ("close", address) }
+            };
+            Ok(json!({"schema":"monzero-wallet-control-result-v1","requestId":request_id.to_string(),
+                "operation":operation,"address":address.to_string(),"readyForTrading":false}))
+        }).await.context("wallet command timed out")?
+    }
+
+    async fn require_empty(&self) -> Result<()> {
+        ensure!(!self.uncertain, "wallet session requires reconciliation");
+        ensure!(self.client.opened_wallet(self.network).await?.is_none(), "wallet already open");
+        Ok(())
+    }
+
+    pub async fn create(&mut self, id: &SwapWalletId, password: String) -> Result<XmzAddress> {
+        let password = checked_password(password)?;
+        self.require_empty().await?;
+        self.uncertain = true; // Cancellation/error after dispatch must not permit blind retry.
+        self.client.rpc(self.client.wallet, "create_wallet", json!({
+            "filename":id.filename(), "password":password.as_str(), "language":"English"})).await?;
+        let address = self.client.opened_wallet(self.network).await?.context("created wallet not open")?;
+        self.uncertain = false;
+        Ok(address)
+    }
+
+    pub async fn open(&mut self, id: &SwapWalletId, password: String, expected: &XmzAddress) -> Result<()> {
+        let password = checked_password(password)?;
+        ensure!(expected.network() == self.network, "wallet network mismatch");
+        self.require_empty().await?;
+        self.uncertain = true;
+        self.client.rpc(self.client.wallet, "open_wallet", json!({
+            "filename":id.filename(), "password":password.as_str(), "autosave_current":true})).await?;
+        ensure!(self.client.opened_wallet(self.network).await?.as_ref() == Some(expected), "opened wallet identity mismatch");
+        self.uncertain = false;
+        Ok(())
+    }
+
+    pub async fn close(&mut self, expected: &XmzAddress) -> Result<()> {
+        ensure!(!self.uncertain, "wallet session requires reconciliation");
+        ensure!(self.client.opened_wallet(self.network).await?.as_ref() == Some(expected), "unexpected wallet before close");
+        self.uncertain = true;
+        self.client.rpc(self.client.wallet, "close_wallet", json!({"autosave_current":true})).await?;
+        ensure!(self.client.opened_wallet(self.network).await?.is_none(), "wallet still open after close");
+        self.uncertain = false;
+        Ok(())
+    }
+}
+
+enum Control {
+    Create(SwapWalletId, Zeroizing<String>),
+    Open(SwapWalletId, Zeroizing<String>, XmzAddress),
+    Close(XmzAddress),
+}
+
+fn decode_control(bytes: &[u8], network: XmzNetwork) -> Result<(uuid::Uuid, Control)> {
+    ensure!(bytes.len() <= 4096, "oversized wallet command");
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields, rename_all="camelCase")]
+    struct Wire { schema:String, request_id:String, operation:String, wallet_id:String, password:String, expected_address:String }
+    impl Drop for Wire { fn drop(&mut self) { self.password.zeroize(); } }
+    // Parser diagnostics may quote an unknown field supplied in private input.
+    // Do not retain them as an anyhow source that callers might log.
+    let mut wire: Wire = serde_json::from_slice(bytes).map_err(|_| anyhow::anyhow!("invalid wallet command"))?;
+    ensure!(wire.schema == "monzero-wallet-control-v1", "unsupported wallet command");
+    let canonical_id = |text: &str| -> Result<uuid::Uuid> {
+        let id: uuid::Uuid = text.parse()?;
+        ensure!(!id.is_nil() && id.to_string() == text, "noncanonical wallet command identity");
+        Ok(id)
+    };
+    let request_id = canonical_id(&wire.request_id)?;
+    let command = match wire.operation.as_str() {
+        "create" => {
+            ensure!(wire.expected_address.is_empty(), "create must not supply an address");
+            Control::Create(SwapWalletId::new(canonical_id(&wire.wallet_id)?)?, checked_password(std::mem::take(&mut wire.password))?)
+        }
+        "open" => Control::Open(SwapWalletId::new(canonical_id(&wire.wallet_id)?)?,
+            checked_password(std::mem::take(&mut wire.password))?, XmzAddress::parse(network, &wire.expected_address)?),
+        "close" => {
+            ensure!(wire.wallet_id.is_empty() && wire.password.is_empty(), "unexpected close credentials");
+            Control::Close(XmzAddress::parse(network, &wire.expected_address)?)
+        }
+        _ => anyhow::bail!("unsupported wallet operation"),
+    };
+    Ok((request_id, command))
+}
+
+fn checked_password(value: String) -> Result<Zeroizing<String>> {
+    let value = Zeroizing::new(value);
+    ensure!(!value.is_empty() && value.len() <= 1024 && !value.contains('\0'), "invalid wallet password");
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn malformed_control_diagnostics_do_not_echo_private_input() {
+        let marker = "private-password-marker";
+        let bytes = format!("{{\"{marker}\":\"{marker}\"}}");
+        let error = match decode_control(bytes.as_bytes(),XmzNetwork::Mainnet) {
+            Err(error) => error,
+            Ok(_) => panic!("accepted malformed private command"),
+        };
+        assert_eq!(error.to_string(), "invalid wallet command");
+        assert_eq!(error.chain().count(),1);
+        assert!(!format!("{error:?}").contains(marker));
+    }
+    #[test]
+    fn control_schema_rejects_ambiguous_and_external_inputs() -> Result<()> {
+        let valid = json!({"schema":"monzero-wallet-control-v1","requestId":"12345678-1234-1234-1234-123456789abc",
+            "operation":"create","walletId":"23456789-1234-1234-1234-123456789abc","password":"fixture","expectedAddress":""});
+        assert!(decode_control(&serde_json::to_vec(&valid)?,XmzNetwork::Mainnet).is_ok());
+        for (key,value) in [("rpcUrl","http://example.invalid"),("operation","transfer"),
+            ("walletId","../wallet"),("password",""),("expectedAddress","unexpected"),("requestId","")] {
+            let mut changed = valid.clone();
+            changed[key] = json!(value);
+            assert!(decode_control(&serde_json::to_vec(&changed)?,XmzNetwork::Mainnet).is_err());
+        }
+        let text = serde_json::to_string(&valid)?;
+        let duplicate = format!("{},\"operation\":\"create\"}}", &text[..text.len()-1]);
+        assert!(decode_control(duplicate.as_bytes(),XmzNetwork::Mainnet).is_err());
+        assert!(decode_control(&vec![b' ';4097],XmzNetwork::Mainnet).is_err());
+        Ok(())
+    }
+    #[test]
+    fn lifecycle_inputs_are_bounded_and_path_free() -> Result<()> {
+        assert!(SwapWalletId::new(uuid::Uuid::nil()).is_err());
+        let id = SwapWalletId::new(uuid::Uuid::parse_str("12345678-1234-1234-1234-123456789abc")?)?;
+        assert_eq!(id.filename(), "swap-12345678123412341234123456789abc");
+        for password in [String::new(), "x".repeat(1025), "a\0b".into()] {
+            assert!(checked_password(password).is_err());
+        }
+        assert!(checked_password("fixture-password".into()).is_ok());
+        Ok(())
+    }
+}
