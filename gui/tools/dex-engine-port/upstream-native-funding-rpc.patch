+//! Experimental read-only XMZ funding observer for caller-owned loopback services.
+//! This does not create wallets, sign, broadcast, or authorize live execution.
+//! Credentials are required and intentionally have no Debug or serialization API.
+pub mod fee_estimation;
+pub mod wallet_session;
+use anyhow::{Context, Result, ensure};
+use serde_json::{Value, json};
+use zeroize::Zeroizing;
+use crate::xmz_funding::{ChainSnapshot, FundingObserver, FundingObservation, FundingRequest};
+
+pub struct NativeFundingRpc {
+    client: reqwest::Client,
+    daemon: u16,
+    wallet: u16,
+    credentials: (Zeroizing<String>, Zeroizing<String>),
+    auth_lock: tokio::sync::Mutex<()>,
+}
+
+impl NativeFundingRpc {
+    pub fn new(daemon: u16, wallet: u16, username: String, password: String) -> Result<Self> {
+        // Take ownership before validation so rejection also clears these buffers.
+        let username = Zeroizing::new(username);
+        let password = Zeroizing::new(password);
+        ensure!(!username.is_empty() && !password.is_empty() && username.len() + password.len() <= 1024,
+            "invalid native RPC credentials");
+        ensure!(daemon != 0 && wallet != 0 && daemon != wallet, "invalid local RPC ports");
+        Ok(Self {
+            client: reqwest::Client::builder().no_proxy()
+                .redirect(reqwest::redirect::Policy::none())
+                .timeout(std::time::Duration::from_secs(15)).build()?,
+            daemon, wallet, credentials: (username, password), auth_lock: tokio::sync::Mutex::new(()),
+        })
+    }
+
+    pub async fn wallet_version(&self) -> Result<u64> {
+        number(&self.rpc(self.wallet, "get_version", json!({})).await?, "version")
+    }
+
+    /// Read-only observation, not a lease or permission to switch wallets.
+    /// Only the native NOT_OPEN error means empty; other failures propagate.
+    pub async fn opened_wallet(&self, network: swap_core::xmz_address::XmzNetwork)
+        -> Result<Option<swap_core::xmz_address::XmzAddress>> {
+        opened_wallet_response(&self.rpc_response(self.wallet, "get_address", json!({"account_index":0})).await?, network)
+    }
+
+    /// Replace caller-owned credentials and discard the old connection pool.
+    /// Exclusive access prevents a request from racing this replacement.
+    /// Invalid replacement leaves the existing client intact.
+    pub fn replace_credentials(&mut self, username: String, password: String) -> Result<()> {
+        let replacement = Self::new(self.daemon, self.wallet, username, password)?;
+        *self = replacement;
+        Ok(())
+    }
+
+    async fn rpc(&self, port: u16, method: &str, params: Value) -> Result<Value> {
+        let response = self.rpc_response(port, method, params).await?;
+        ensure!(response.get("error").is_none(), "native RPC rejected request");
+        response.get("result").cloned().context("missing native RPC result")
+    }
+
+    async fn rpc_response(&self, port: u16, method: &str, params: Value) -> Result<Value> {
+        // Keep challenge and response on an uncontended pooled connection.
+        let _guard = self.auth_lock.lock().await;
+        let url = format!("http://127.0.0.1:{port}/json_rpc");
+        let body = serde_json::to_vec(&json!({"jsonrpc":"2.0", "id":"native-funding", "method":method, "params":params}))?;
+        let send = || self.client.post(&url).header("Content-Type", "application/json").body(body.clone());
+        let mut response = send().send().await.context("native local RPC transport")?;
+        ensure!(port != self.wallet || response.status() == reqwest::StatusCode::UNAUTHORIZED,
+            "wallet RPC did not require authentication");
+        if response.status() == reqwest::StatusCode::UNAUTHORIZED && port == self.wallet {
+            {
+                let (username, password) = &self.credentials;
+                let challenge = response.headers().get(reqwest::header::WWW_AUTHENTICATE)
+                    .context("missing Digest challenge")?.to_str()?.to_owned();
+                ensure!(challenge.len() <= 8192, "oversized Digest challenge");
+                let mut prompt = digest_auth::parse(&challenge).context("unsupported Digest challenge")?;
+                let mut drained = 0usize;
+                while let Some(chunk) = response.chunk().await? {
+                    drained += chunk.len();
+                    ensure!(drained <= 65536, "oversized Digest challenge body");
+                }
+                let context = digest_auth::AuthContext::new_post(username.as_str(), password.as_str(),
+                    "/json_rpc", Some(body.as_slice()));
+                let authorization = sensitive_authorization(
+                    prompt.respond(&context).context("Digest response construction")?.to_string())?;
+                response = send().header(reqwest::header::AUTHORIZATION, authorization).send().await?;
+            }
+        }
+        response = response.error_for_status()?;
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await? {
+            ensure!(bytes.len() + chunk.len() <= 1_048_576, "oversized native RPC response");
+            bytes.extend_from_slice(&chunk);
+        }
+        let result: Value = serde_json::from_slice(&bytes).context("native RPC JSON")?;
+        ensure!(result["id"] == "native-funding", "native RPC response identity mismatch");
+        Ok(result)
+    }
+}
+
+fn opened_wallet_response(response: &Value, network: swap_core::xmz_address::XmzNetwork)
+    -> Result<Option<swap_core::xmz_address::XmzAddress>> {
+    if let Some(error) = response.get("error") {
+        ensure!(response.get("result").is_none() && error.get("code").and_then(Value::as_i64) == Some(-13),
+            "native wallet status failed");
+        return Ok(None);
+    }
+    let address = response.get("result").and_then(|result| result.get("address"))
+        .and_then(Value::as_str).context("missing native wallet address")?;
+    Ok(Some(swap_core::xmz_address::XmzAddress::parse(network, address)?))
+}
+
+fn sensitive_authorization(value: String) -> Result<reqwest::header::HeaderValue> {
+    let value = Zeroizing::new(value);
+    let mut header = reqwest::header::HeaderValue::from_str(value.as_str())?;
+    header.set_sensitive(true);
+    Ok(header)
+}
+
+fn number(value: &Value, field: &str) -> Result<u64> { value[field].as_u64().context("missing native integer") }
+fn string(value: &Value, field: &str) -> Result<String> { value[field].as_str().map(str::to_owned).context("missing native string") }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn wallet_status_does_not_treat_errors_as_empty() -> Result<()> {
+        use swap_core::xmz_address::XmzNetwork;
+        assert!(opened_wallet_response(&json!({"error":{"code":-13}}),XmzNetwork::Mainnet)?.is_none());
+        for response in [json!({}),json!({"error":null}),json!({"error":{"code":-1}}),
+            json!({"error":{"code":"-13"}}),json!({"error":{"code":-13},"result":{}}),
+            json!({"result":{"address":"not-an-address"}})] {
+            assert!(opened_wallet_response(&response,XmzNetwork::Mainnet).is_err());
+        }
+        let address = "FSf9UZS3uZwJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmJ7suhUXwdrDJ8QgRfFWTzmJ8QgRfFWTzmJ8QgRfFWTzmCYGLw3H";
+        let response = json!({"result":{"address":address}});
+        assert_eq!(opened_wallet_response(&response,XmzNetwork::Mainnet)?.unwrap().to_string(),address);
+        assert!(opened_wallet_response(&response,XmzNetwork::Testnet).is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn authorization_header_is_redacted() -> Result<()> {
+        let header = sensitive_authorization("Digest private-fixture-marker".into())?;
+        assert!(header.is_sensitive());
+        assert!(!format!("{header:?}").contains("private-fixture-marker"));
+        Ok(())
+    }
+
+    #[test]
+    fn rejects_invalid_ports_and_credentials() {
+        for (daemon, wallet, username, password) in [
+            (0, 2, "user".into(), "password".into()),
+            (1, 0, "user".into(), "password".into()),
+            (1, 1, "user".into(), "password".into()),
+            (1, 2, String::new(), "password".into()),
+            (1, 2, "user".into(), String::new()),
+            (1, 2, "user".into(), "x".repeat(1025)),
+        ] {
+            assert!(NativeFundingRpc::new(daemon, wallet, username, password).is_err());
+        }
+    }
+
+    #[tokio::test]
+    async fn refuses_wallet_with_authentication_disabled() -> Result<()> {
+        use std::io::{Read, Write};
+        let server = std::net::TcpListener::bind(("127.0.0.1", 0))?;
+        let port = server.local_addr()?.port();
+        let thread = std::thread::spawn(move || -> std::io::Result<()> {
+            let (mut stream, _) = server.accept()?;
+            stream.set_read_timeout(Some(std::time::Duration::from_secs(5)))?;
+            let mut request = [0u8; 4096];
+            stream.read(&mut request)?;
+            stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
+        });
+        let client = NativeFundingRpc::new(if port == 1 { 2 } else { 1 }, port,
+            "fixture-user".into(), "fixture-password".into())?;
+        let result = client.wallet_version().await;
+        thread.join().map_err(|_| anyhow::anyhow!("fixture thread failed"))??;
+        assert_eq!(result.err().context("accepted unauthenticated wallet")?.to_string(),
+            "wallet RPC did not require authentication");
+        Ok(())
+    }
+}
+
+#[async_trait::async_trait]
+impl FundingObserver for NativeFundingRpc {
+    async fn snapshot(&self) -> Result<ChainSnapshot> {
+        let genesis = self.rpc(self.daemon, "get_block_header_by_height", json!({"height":0})).await?;
+        let tip = self.rpc(self.daemon, "get_last_block_header", json!({})).await?;
+        Ok(ChainSnapshot { genesis: string(&genesis["block_header"], "hash")?,
+            tip_hash: string(&tip["block_header"], "hash")?, tip_height: number(&tip["block_header"], "height")? })
+    }
+
+    async fn observe(&self, request: &FundingRequest) -> Result<FundingObservation> {
+        let address = self.rpc(self.wallet, "get_address", json!({})).await?;
+        let checked = self.rpc(self.wallet, "check_tx_key", json!({
+            "txid": request.proof.tx_hash.0, "tx_key": request.proof.tx_key.to_string(),
+            "address": request.address.to_string(),
+        })).await?;
+        let result = self.rpc(self.wallet, "get_transfer_by_txid", json!({"txid":request.proof.tx_hash.0})).await?;
+        let transfer = &result["transfer"];
+        ensure!(transfer["type"] == "in", "native transfer is not incoming");
+        let received = number(&checked, "received")?;
+        let confirmations = number(&checked, "confirmations")?;
+        ensure!(number(transfer, "amount")? == received && number(transfer, "confirmations")? == confirmations,
+            "native wallet observations disagree");
+        Ok(FundingObservation { txid: string(transfer, "txid")?, address: string(&address, "address")?,
+            received_atoms: received, in_pool: checked["in_pool"].as_bool().context("missing native pool status")?,
+            height: number(transfer, "height")?, confirmations })
+    }
+}
