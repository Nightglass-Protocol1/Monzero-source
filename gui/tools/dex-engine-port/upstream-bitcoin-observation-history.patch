diff --git a/swap-machine/src/native_execution_claim/checkpoint/submission/history.rs b/swap-machine/src/native_execution_claim/checkpoint/submission/history.rs
new file mode 100644
index 000000000..b97c1c64d
--- /dev/null
+++ b/swap-machine/src/native_execution_claim/checkpoint/submission/history.rs
@@ -0,0 +1,78 @@
+//! Append-only historical observations, NOT cached execution authority.
+use super::*;
+const HISTORY_DOMAIN: &[u8]=b"monzero-bitcoin-observation-v1\0";
+
+#[derive(serde::Serialize,serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    id:uuid::Uuid,
+    txid:bitcoin::Txid,
+    wtxid:bitcoin::Wtxid,
+    snapshot:BitcoinSubmissionSnapshot,
+    observation:BitcoinSubmissionObservation,
+}
+
+/// A past node observation. Never proves current presence, confirmation,
+/// spendability, finality or permission to retry. Fresh reconciliation is required.
+pub struct HistoricalBitcoinObservation { record:Record }
+impl HistoricalBitcoinObservation {
+    pub fn id(&self) -> uuid::Uuid { self.record.id }
+    pub fn observation(&self) -> BitcoinSubmissionObservation { self.record.observation }
+    pub fn snapshot(&self) -> &BitcoinSubmissionSnapshot { &self.record.snapshot }
+}
+
+fn suffix(id:uuid::Uuid) -> Result<String> {
+    ensure!(!id.is_nil(),"missing Bitcoin observation identity");
+    Ok(format!("bitcoin-observation-{id}"))
+}
+
+impl RecoveryLease {
+    /// Fresh read-only observation followed by exclusive pin-first persistence.
+    /// IDs are caller-retained audit identities, not a monotonic state sequence.
+    /// Failure may leave occupied records; do not delete or overwrite to retry.
+    #[cfg(target_os = "linux")]
+    pub async fn record_bitcoin_observation(&self,store:&CheckpointPinStore,lock:bitcoin::Txid,
+        id:uuid::Uuid,observer:&impl BitcoinSubmissionObserver) -> Result<HistoricalBitcoinObservation> {
+        let suffix=suffix(id)?;
+        let submission=self.load_bitcoin_submission(store,lock)?;
+        let quote=self.record.quote();
+        let (observation,snapshot)=observe_snapshot(&submission,quote.terms()["btcGenesis"].parse()?,observer).await?;
+        let record=Record {id,txid:lock,wtxid:submission.transaction.compute_wtxid(),snapshot,observation};
+        let payload=serde_json::to_vec(&record)?;
+        let bytes=[HISTORY_DOMAIN,quote.commitment(),payload.as_slice()].concat();
+        let digest:[u8;32]=Sha256::digest(&bytes).into();
+        let name=format!("{}.{suffix}",filename(quote)?);
+        write_once(&store.directory,&format!("{name}.pin"),
+            &pin_record(quote.terms()["swapId"].parse()?,quote.commitment(),&digest))?;
+        write_once(&self.directory,&name,&bytes)?;
+        Ok(HistoricalBitcoinObservation {record})
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub async fn record_bitcoin_observation(&self,_:&CheckpointPinStore,_:bitcoin::Txid,
+        _:uuid::Uuid,_:&impl BitcoinSubmissionObserver) -> Result<HistoricalBitcoinObservation> {
+        anyhow::bail!("Bitcoin observation persistence is not implemented on this platform")
+    }
+
+    /// Load and bind a historical record; this performs NO fresh node query.
+    #[cfg(target_os = "linux")]
+    pub fn load_bitcoin_observation(&self,store:&CheckpointPinStore,lock:bitcoin::Txid,
+        id:uuid::Uuid) -> Result<HistoricalBitcoinObservation> {
+        let suffix=suffix(id)?;
+        let submission=self.load_bitcoin_submission(store,lock)?;
+        let quote=self.record.quote();
+        let bytes=read_record(&self.directory,store,quote,&suffix,HISTORY_DOMAIN)?;
+        let record:Record=serde_json::from_slice(&bytes[HISTORY_DOMAIN.len()+32..])
+            .map_err(|_|anyhow::anyhow!("invalid historical Bitcoin observation"))?;
+        ensure!(record.id==id && record.txid==lock && record.wtxid==submission.transaction.compute_wtxid()
+            && record.snapshot.genesis.to_string()==quote.terms()["btcGenesis"],
+            "historical Bitcoin observation identity mismatch");
+        Ok(HistoricalBitcoinObservation {record})
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn load_bitcoin_observation(&self,_:&CheckpointPinStore,_:bitcoin::Txid,
+        _:uuid::Uuid) -> Result<HistoricalBitcoinObservation> {
+        anyhow::bail!("Bitcoin observation recovery is not implemented on this platform")
+    }
+}
