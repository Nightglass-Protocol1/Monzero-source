+//! Offline consent to retain an authenticated funding handoff, never payment authority.
+use super::*;
+use serde_json::json;
+
+const REVIEW: &str="monzero-bch-funding-receipt-review-v1";
+pub struct FundingReceiptReview {pub details: Value,pub commitment: [u8;32]}
+pub struct SavedFundingReceipt {
+    pub review: FundingReceiptReview,pub receipt: [u8;32],pub received_at: u64,
+}
+impl AdmittedExecution<'_> {
+    fn funding_receipt_details(&self,frame: &[u8],signature: &[u8],signed: &SignedFunding) -> Result<FundingReceiptReview> {
+        let message=hash("monzero-bch-authenticated-funding-v1",&[frame,signature].concat());
+        let outpoint=signed.lock_outpoint();let output=&signed.transaction().output[outpoint.vout as usize];
+        let details=json!({"schema":REVIEW,"action":"accept-bch-funding-message",
+            "swapId":self.quote.terms()["swapId"],"quote":self.quote.commitment(),
+            "admission":self.admission_digest()?,"messageCommitment":message,
+            "bchNetwork":self.quote.terms()["bchNetwork"],"bchGenesis":self.quote.terms()["bchGenesis"],
+            "fundingOutpoint":outpoint,"contractScript":output.script_pubkey.to_hex_string(),
+            "principalAtoms":output.value.to_sat().to_string(),"feeAtoms":signed.fee().to_sat().to_string()});
+        Ok(FundingReceiptReview {commitment:hash(REVIEW,&serde_json::to_vec(&details)?),details})
+    }
+    pub fn review_bch_funding_receipt(&self,now: u64,frame: &[u8],signature: &[u8]) -> Result<FundingReceiptReview> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH funding receipt role");
+        self.message_context(now)?;
+        let (_,sent_at)=self.outgoing_bch_refund_record()?.context("missing outgoing BCH refund protection")?;
+        ensure!(now>=sent_at,"BCH funding receipt predates outgoing refund");
+        let signed=self.authenticate_funding_message(frame,signature)?;
+        if let Some((record,old,_))=self.message_record("message-received")? {
+            ensure!(now>=record.at && old==frame && record.signature.as_deref()==Some(signature),
+                "BCH funding receipt already retained differently");
+        }
+        self.funding_receipt_details(frame,signature,&signed)
+    }
+    pub fn accept_reviewed_bch_funding_receipt(&mut self,now: u64,frame: &[u8],signature: &[u8],approved: &[u8;32])
+        -> Result<AuthenticatedFunding> {
+        let review=self.review_bch_funding_receipt(now,frame,signature)?;
+        ensure!(*approved==review.commitment,"BCH funding receipt approval changed");
+        self.accept_bch_funding_message(now,frame,signature)
+    }
+    /// Historical signed receipt only. Does not read the chain or renew the quote.
+    pub fn saved_bch_funding_receipt(&self) -> Result<Option<SavedFundingReceipt>> {
+        ensure!(self.role==Role::NativeFunder,"wrong BCH funding receipt role");
+        let Some((record,frame,signed))=self.message_record("message-received")? else {return Ok(None)};
+        let signature=record.signature.as_deref().context("missing BCH receipt signature")?;
+        let review=self.funding_receipt_details(&frame,signature,&signed)?;
+        Ok(Some(SavedFundingReceipt {review,receipt:hash(RECORD,&serde_json::to_vec(&record)?),received_at:record.at}))
+    }
+}
