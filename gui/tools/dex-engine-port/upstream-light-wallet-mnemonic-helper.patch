diff --git a/swap-machine/src/bin/native-ltc-light/vault_format.rs b/swap-machine/src/bin/native-ltc-light/vault_format.rs
new file mode 100644
--- /dev/null
+++ b/swap-machine/src/bin/native-ltc-light/vault_format.rs
@@ -0,0 +1,78 @@
+// Explicit format dispatch. Missing format preserves existing raw-seed configs;
+// unknown encodings fail deserialization, never fall back to another vault.
+use super::*;
+use swap_machine::litecoin_light::vault::mnemonic::storage::{MnemonicVault,backup as mnemonic_backup};
+#[derive(Clone,Copy,Default,Deserialize)]
+pub(super) enum VaultFormat {
+    #[default]
+    #[serde(rename="raw-bip32-seed-hex-v1")]
+    Raw,
+    #[serde(rename="bip39-english-v1")]
+    Mnemonic,
+}
+pub(super) struct BackupDetails {
+    pub digest:sha256::Hash,
+    pub account:PublicAccountDescriptor,
+    pub wallet:uuid::Uuid,
+    pub allocated:[u32;2],
+}
+impl From<backup::storage::BackupInfo> for BackupDetails {
+    fn from(info:backup::storage::BackupInfo)->Self {
+        Self {digest:info.digest(),account:info.account().descriptor(),wallet:info.wallet_id(),allocated:info.allocated()}
+    }
+}
+impl From<mnemonic_backup::BackupInfo> for BackupDetails {
+    fn from(info:mnemonic_backup::BackupInfo)->Self {
+        Self {digest:info.digest(),account:info.account().descriptor(),wallet:info.wallet_id(),allocated:info.allocated()}
+    }
+}
+pub(super) fn save(config:&VaultConfig,network:LightNetwork,book:&AddressBook,password:&[u8],destination:&Path)->Result<BackupDetails> {
+    match config.seed_encoding {
+        VaultFormat::Raw=>{
+            let vault=SeedVault::open(&config.directory,network,config.wallet_id)?;
+            let bundle=backup::export(&vault,book,password)?;
+            Ok(backup::storage::save_verified(destination,&bundle,password,network,config.wallet_id)?.into())
+        },
+        VaultFormat::Mnemonic=>{
+            let vault=MnemonicVault::open(&config.directory,network,config.wallet_id)?;
+            let bundle=mnemonic_backup::export(&vault,book,password)?;
+            Ok(mnemonic_backup::save_verified(destination,&bundle,password,network,config.wallet_id)?.into())
+        },
+    }
+}
+pub(super) fn load(config:&VaultConfig,network:LightNetwork,password:&[u8],source:&Path)->Result<(Vec<u8>,BackupDetails)> {
+    match config.seed_encoding {
+        VaultFormat::Raw=>{let (bytes,info)=backup::storage::load_verified(source,password,network,config.wallet_id)?;Ok((bytes,info.into()))},
+        VaultFormat::Mnemonic=>{let (bytes,info)=mnemonic_backup::load_verified(source,password,network,config.wallet_id)?;Ok((bytes,info.into()))},
+    }
+}
+pub(super) fn restore(config:&VaultConfig,network:LightNetwork,password:&[u8],encrypted:&[u8],wallet:&WalletConfig)->Result<[u32;2]> {
+    let book=match config.seed_encoding {
+        VaultFormat::Raw=>{
+            let (vault,book)=backup::restore(&config.directory,&wallet.address_book_directory,network,config.wallet_id,password,encrypted)?;
+            drop(vault.unlock_for_account(password,&wallet.account)?);book
+        },
+        VaultFormat::Mnemonic=>{
+            let (vault,book)=mnemonic_backup::restore(&config.directory,&wallet.address_book_directory,network,config.wallet_id,password,encrypted)?;
+            drop(vault.unlock_for_account(password,&wallet.account)?);book
+        },
+    };
+    Ok([book.allocated_count(Branch::Receive)?,book.allocated_count(Branch::Change)?])
+}
+pub(super) fn sign(config:&VaultConfig,network:LightNetwork,password:&[u8],expected:sha256::Hash,
+    prepared:&swap_machine::litecoin_light::vault::signing::review::confirmed::claimed::ObservedClaimedSpend,
+    chain:&swap_machine::litecoin_light::headers::HeaderSequence,observed:&swap_machine::litecoin_light::accounting::ObservedWallet)->Result<Transaction> {
+    match config.seed_encoding {
+        VaultFormat::Raw=>{
+            let vault=SeedVault::open(&config.directory,network,config.wallet_id)?;
+            prepared.approve_with_vault_on(chain,observed,&vault,password,expected)
+        },
+        VaultFormat::Mnemonic=>{
+            let vault=MnemonicVault::open(&config.directory,network,config.wallet_id)?;
+            prepared.approve_with_mnemonic_on(chain,observed,&vault,password,expected)
+        },
+    }
+}
