@@ -0,0 +1,54 @@
+use super::*;
+use swap_machine::litecoin_light::vault::mnemonic::MnemonicMaterial;
+use std::{fs,os::unix::fs::DirBuilderExt};
+struct Directory(PathBuf);
+impl Directory {fn new()->Result<Self> {let path=std::env::temp_dir().canonicalize()?.join(format!("mnemonic-helper-{}",uuid::Uuid::new_v4()));fs::DirBuilder::new().mode(0o700).create(&path)?;Ok(Self(path))}}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+
+#[test]
+fn helper_backup_restore_dispatches_both_formats_for_each_coin()->Result<()> {
+    for network in [LightNetwork::Litecoin(LtcNetwork::Regtest),LightNetwork::Bitcoin(BtcNetwork::Regtest),
+        LightNetwork::BitcoinCash(BchNetwork::Regtest),LightNetwork::Dogecoin(DogeNetwork::Regtest)] {
+        for mnemonic in [false,true] {
+            let source=Directory::new()?;let addresses=Directory::new()?;let destination=Directory::new()?;
+            let restore_vault=Directory::new()?;let restore_book=Directory::new()?;
+            let wallet=uuid::Uuid::new_v4();let password="disposable helper password";
+            let account=if mnemonic {
+                let material=MnemonicMaterial::from_entropy(&[7;32])?;
+                drop(MnemonicVault::create(&source.0,network,wallet,password.as_bytes(),&material,"fixture passphrase")?);
+                material.public_account(network,3,"fixture passphrase")?
+            } else {
+                let seed=swap_machine::litecoin_light::vault::SecretSeed::from_bytes(Zeroizing::new([7;32]));
+                drop(SeedVault::create(&source.0,network,wallet,password.as_bytes(),&seed)?);
+                seed.public_account(network,3)?
+            };
+            let mut book=AddressBook::create(&addresses.0,PublicAccount::from_descriptor(&account.descriptor(),network)?)?;
+            book.reserve(uuid::Uuid::new_v4(),Branch::Receive)?;drop(book);
+            let encoding=if mnemonic {"bip39-english-v1"} else {"raw-bip32-seed-hex-v1"};
+            let mut value=json!({"schema":format!("monzero-private-{}-light-v1",network.tag()),"network":"regtest",
+                "cacheDirectory":source.0,"maximumHeight":1000,"wallet":{"account":account.descriptor(),
+                    "addressBookDirectory":addresses.0,"vault":{"directory":source.0,"walletId":wallet,"seedEncoding":encoding}}});
+            if !mnemonic {value["wallet"]["vault"].as_object_mut().unwrap().remove("seedEncoding");}
+            let config:Config=serde_json::from_value(value.clone())?;
+            let approval=BackupApproval {directory:destination.0.clone(),password:Password(Zeroizing::new(password.to_owned()))};
+            let saved=wallet_backup(&config,network,&approval,true)?;
+            assert_eq!(saved["receivingAllocated"],1);assert_eq!(saved["backupVerified"],true);
+            assert_eq!(wallet_backup(&config,network,&approval,false)?["backupDigest"],saved["backupDigest"]);
+            value["wallet"]["vault"]["directory"]=json!(restore_vault.0);
+            value["wallet"]["addressBookDirectory"]=json!(restore_book.0);
+            let restore_config:Config=serde_json::from_value(value.clone())?;
+            let mut restore=RestoreApproval {directory:destination.0.clone(),password:Password(Zeroizing::new(password.to_owned())),approved_digest:"00".repeat(32)};
+            assert!(restore_wallet(&restore_config,network,&restore).is_err());
+            assert_eq!(fs::read_dir(&restore_vault.0)?.count(),0);
+            restore.approved_digest=saved["backupDigest"].as_str().unwrap().to_owned();
+            assert_eq!(restore_wallet(&restore_config,network,&restore)?["restored"],true);
+            assert_eq!(restore_wallet(&restore_config,network,&restore)?["receivingAllocated"],1);
+            value["wallet"]["vault"]["seedEncoding"]=json!(if mnemonic {"raw-bip32-seed-hex-v1"} else {"bip39-english-v1"});
+            let wrong:Config=serde_json::from_value(value.clone())?;
+            assert!(wallet_backup(&wrong,network,&approval,false).is_err());
+            value["wallet"]["vault"]["seedEncoding"]=json!("unknown");
+            assert!(serde_json::from_value::<Config>(value).is_err());
+        }
+    }
+    Ok(())
+}
