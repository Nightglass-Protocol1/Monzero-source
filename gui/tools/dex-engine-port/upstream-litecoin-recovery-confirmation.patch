+    pub async fn check_recovery_spend(&mut self,ltc:&LitecoinRpc,kind:RecoverySpend)->Result<serde_json::Value> {
+        let transaction=self.recovery_transaction(kind)?;
+        let (head,_,quote,_,_)=self.load()?;
+        ensure!(ltc.network()==self.policy.ltc_network,"wrong recovery observation network");
+        let minimum=quote.terms()["ltcConfirmations"].parse::<u64>()?.max(u64::from(self.policy.ltc_confirmations));
+        let observed=ltc.indexed_confirmed_transaction(transaction.compute_txid(),minimum).await?;
+        ensure!(super::redeem::same_redemption_effect(&transaction,observed.transaction()),"observed recovery differs from agreement");
+        Ok(serde_json::json!({"schema":"monzero-ltc-recovery-confirmation-v1","tradeId":head.trade,
+            "quoteCommitment":hex(&head.quote),"operation":kind.label(),"txid":transaction.compute_txid(),
+            "wtxid":observed.transaction().compute_wtxid(),"block":observed.block(),"tip":observed.tip(),
+            "confirmations":observed.confirmations().to_string(),"requiredConfirmations":minimum.to_string(),"chainObserved":true}))
+    }
