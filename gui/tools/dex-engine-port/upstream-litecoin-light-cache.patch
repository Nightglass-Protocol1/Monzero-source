+//! Raw-header restart cache. Every load replays validation from pinned genesis.
+//! No cached work, validation flags, wallet keys or confirmation authority.
+//! Blocking disk/Scrypt work belongs on a caller-owned blocking worker.
+use super::*;
+use std::{ffi::CString, fs::{File, OpenOptions}, io::{BufReader, BufWriter, Read, Write},
+    os::{fd::{AsRawFd, FromRawFd}, unix::fs::{MetadataExt, OpenOptionsExt}}, path::Path};
+
+const MAGIC: &[u8;8] = b"MZLTC001";
+const PREFIX: u64 = 44; // magic, genesis identity, post-genesis header count
+const NAME: &str = "headers.bin";
+
+/// Exclusive cooperative-process lease, following the wallet journal pattern.
+/// Directory must already exist, be canonical, owned and private. One network
+/// per directory. A missing cache is explicit; corruption never becomes genesis.
+pub struct HeaderCache { directory: File, network: LtcNetwork }
+impl HeaderCache {
+    pub fn open(path: &Path,network: LtcNetwork) -> Result<Self> {
+        ensure!(path.is_absolute() && path.canonicalize()?==path, "noncanonical Litecoin header cache");
+        let directory=OpenOptions::new().read(true)
+            .custom_flags(libc::O_DIRECTORY|libc::O_NOFOLLOW|libc::O_CLOEXEC).open(path)?;
+        let metadata=directory.metadata()?;
+        ensure!(metadata.uid()==unsafe {libc::geteuid()} && metadata.mode()&0o077==0,
+            "Litecoin header cache must be private and owned");
+        ensure!(unsafe {libc::flock(directory.as_raw_fd(),libc::LOCK_EX|libc::LOCK_NB)}==0,
+            "Litecoin header cache is busy");
+        Ok(Self {directory,network})
+    }
+    fn file(&self,name: &str,flags: i32) -> Result<File> {
+        let name=CString::new(name)?;
+        let fd=unsafe {libc::openat(self.directory.as_raw_fd(),name.as_ptr(),
+            flags|libc::O_NOFOLLOW|libc::O_CLOEXEC|libc::O_NONBLOCK,0o600)};
+        if fd<0 {return Err(std::io::Error::last_os_error().into())}
+        Ok(unsafe {File::from_raw_fd(fd)})
+    }
+    fn record(&self) -> Result<Option<File>> {
+        let file=match self.file(NAME,libc::O_RDONLY) {
+            Ok(file)=>file,
+            Err(error) if error.downcast_ref::<std::io::Error>().is_some_and(|e|e.kind()==std::io::ErrorKind::NotFound)=>return Ok(None),
+            Err(error)=>return Err(error),
+        };
+        let metadata=file.metadata()?;
+        ensure!(metadata.is_file() && metadata.uid()==unsafe {libc::geteuid()}
+            && metadata.mode()&0o077==0 && metadata.nlink()==1,"invalid Litecoin header cache record");
+        Ok(Some(file))
+    }
+    fn prefix(&self,file: &mut File) -> Result<u32> {
+        let mut prefix=[0u8;44]; file.read_exact(&mut prefix)?;
+        ensure!(&prefix[..8]==MAGIC,"unknown Litecoin header cache format");
+        let genesis: BlockHash=self.network.genesis().parse()?;
+        ensure!(prefix[8..40]==genesis.to_byte_array(),"Litecoin header cache network mismatch");
+        let count=u32::from_le_bytes(prefix[40..44].try_into()?);
+        ensure!(file.metadata()?.len()==PREFIX+u64::from(count)*80,"invalid Litecoin header cache length");
+        Ok(count)
+    }
+    /// Caller supplies a resource ceiling and its own clock, never server time.
+    /// No trusted state escapes if any cached header or trailing byte is invalid.
+    pub fn load(&self,maximum_height: u32,now: u64) -> Result<Option<HeaderSequence>> {
+        let Some(mut file)=self.record()? else {return Ok(None)};
+        ensure!(file.metadata()?.len()<=PREFIX+u64::from(maximum_height)*80,"Litecoin header cache exceeds limit");
+        let count=self.prefix(&mut file)?;
+        ensure!(count<=maximum_height,"Litecoin header cache height exceeds limit");
+        let mut reader=BufReader::new(file);
+        let mut sequence=HeaderSequence::new(self.network)?;
+        for _ in 0..count {
+            let mut bytes=[0u8;80];reader.read_exact(&mut bytes)?;
+            sequence.append(&bytes,now)?;
+        }
+        let mut extra=[0u8;1];ensure!(reader.read(&mut extra)?==0,"trailing Litecoin header cache data");
+        Ok(Some(sequence))
+    }
+    /// Complete, synced temporary file then atomic replacement and directory sync.
+    /// A failed final directory sync is reported even if replacement took effect.
+    /// This is a cache, not an anti-rollback journal or a freshness assertion.
+    pub fn save(&self,sequence: &HeaderSequence) -> Result<()> {
+        ensure!(sequence.network()==self.network,"Litecoin cache save network mismatch");
+        if let Some(mut existing)=self.record()? {self.prefix(&mut existing)?;}
+        let temporary=CString::new(format!("{}.headers.tmp",uuid::Uuid::new_v4()))?;
+        let target=CString::new(NAME)?;
+        let file=self.file(temporary.to_str()?,libc::O_WRONLY|libc::O_CREAT|libc::O_EXCL)?;
+        let outcome=(|| -> Result<()> {
+            let mut writer=BufWriter::new(file);
+            writer.write_all(MAGIC)?;
+            writer.write_all(&sequence.headers[0].block_hash().to_byte_array())?;
+            writer.write_all(&sequence.height().to_le_bytes())?;
+            for header in sequence.headers.iter().skip(1) {writer.write_all(&serialize(header))?;}
+            writer.flush()?;writer.get_ref().sync_all()?;
+            if unsafe {libc::renameat(self.directory.as_raw_fd(),temporary.as_ptr(),
+                self.directory.as_raw_fd(),target.as_ptr())}!=0 {
+                return Err(std::io::Error::last_os_error().into())
+            }
+            self.directory.sync_all()?;
+            Ok(())
+        })();
+        if outcome.is_err() {unsafe {libc::unlinkat(self.directory.as_raw_fd(),temporary.as_ptr(),0);}}
+        outcome
+    }
+}
