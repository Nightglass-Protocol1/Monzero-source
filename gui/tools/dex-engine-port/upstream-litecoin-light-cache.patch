+use super::*;
+use std::{fs, os::unix::fs::{PermissionsExt, symlink}, path::PathBuf};
+struct Directory(PathBuf);
+impl Directory {
+    fn new() -> Result<Self> {
+        let path=std::env::temp_dir().join(format!("monzero-header-cache-{}",uuid::Uuid::new_v4()));
+        fs::create_dir(&path)?;fs::set_permissions(&path,fs::Permissions::from_mode(0o700))?;
+        Ok(Self(path.canonicalize()?))
+    }
+}
+impl Drop for Directory {fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);}}
+fn chain() -> Result<HeaderSequence> {
+    let mut sequence=HeaderSequence::new(LtcNetwork::Regtest)?;
+    sequence.append(&serialize(&super::super::tests::child()),1296688902)?;
+    Ok(sequence)
+}
+#[test]
+fn cache_restart_revalidates_identity_and_work() -> Result<()> {
+    for network in [LtcNetwork::Mainnet,LtcNetwork::Testnet,LtcNetwork::Regtest] {
+        let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,network)?;
+        assert!(cache.load(0,1296688902)?.is_none());
+        let sequence=if network==LtcNetwork::Regtest {chain()?} else {HeaderSequence::new(network)?};
+        cache.save(&sequence)?;drop(cache);
+        let cache=HeaderCache::open(&dir.0,network)?;
+        let restored=cache.load(sequence.height(),1296688902)?.unwrap();
+        assert_eq!(restored.network(),network);assert_eq!(restored.height(),sequence.height());
+        assert_eq!(restored.chain_work(),sequence.chain_work());
+        for height in 0..=sequence.height() {assert_eq!(restored.header(height),sequence.header(height));}
+    }
+    Ok(())
+}
+#[test]
+fn cache_rejects_corruption_bounds_and_wrong_clock_without_mutating_selected_chain() -> Result<()> {
+    let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,LtcNetwork::Regtest)?;
+    let selected=chain()?;cache.save(&selected)?;let path=dir.0.join(NAME);let original=fs::read(&path)?;
+    assert!(cache.load(0,1296688902).is_err());
+    assert!(cache.load(1,0).is_err());
+    for case in 0..7 {
+        let mut bytes=original.clone();
+        match case {
+            0=>bytes[0]^=1,
+            1=>bytes[8]^=1,
+            2=>bytes[40..44].copy_from_slice(&u32::MAX.to_le_bytes()),
+            3=>{bytes.pop();},
+            4=>bytes.push(0),
+            5=>bytes[48]^=1, // disconnected parent, same framing
+            6=>bytes.truncate(20),
+            _=>unreachable!(),
+        }
+        fs::write(&path,&bytes)?;
+        assert!(cache.load(1,1296688902).is_err(),"case {case}");
+        assert_eq!(selected.height(),1);assert_eq!(selected.chain_work(),&BigUint::from(4u8));
+    }
+    fs::write(&path,&original)?;assert!(cache.load(1,1296688902)?.is_some());
+    Ok(())
+}
+#[test]
+fn cache_atomic_replacement_and_abandoned_temporary_are_distinct() -> Result<()> {
+    let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,LtcNetwork::Regtest)?;
+    let mut sequence=chain()?;cache.save(&sequence)?;
+    let mut old=File::open(dir.0.join(NAME))?;let before=fs::read(dir.0.join(NAME))?;
+    fs::write(dir.0.join("abandoned.headers.tmp"),b"incomplete")?;
+    let mut candidate=sequence.fork(0)?;
+    let mut alternate=super::super::tests::child();alternate.nonce=0;
+    candidate.append(&serialize(&alternate),1296688902)?;
+    let raw="000000209d08f789f2afaf053878d9b21add2f847fff4a9c32fb58b8c5c79ca166f94a9d111111111111111111111111111111111111111111111111111111111111111106e7494dffff7f2000000000";
+    let bytes: Vec<u8>=(0..raw.len()).step_by(2).map(|i|u8::from_str_radix(&raw[i..i+2],16).unwrap()).collect();
+    candidate.append(&bytes,1296688902)?;sequence.adopt(candidate)?;cache.save(&sequence)?;
+    let mut retained=Vec::new();old.read_to_end(&mut retained)?;assert_eq!(retained,before);
+    let restored=cache.load(2,1296688902)?.unwrap();
+    assert_eq!(restored.header(1),Some(alternate));assert_eq!(restored.header(2),sequence.header(2));
+    assert_eq!(restored.chain_work(),sequence.chain_work());
+    let stable=fs::read(dir.0.join(NAME))?;
+    assert!(cache.save(&HeaderSequence::new(LtcNetwork::Mainnet)?).is_err());
+    assert_eq!(fs::read(dir.0.join(NAME))?,stable);
+    Ok(())
+}
+#[test]
+fn cache_lease_permissions_links_and_network_are_enforced() -> Result<()> {
+    let dir=Directory::new()?;let cache=HeaderCache::open(&dir.0,LtcNetwork::Regtest)?;
+    assert!(HeaderCache::open(&dir.0,LtcNetwork::Regtest).is_err());
+    cache.save(&chain()?)?;drop(cache);
+    let wrong=HeaderCache::open(&dir.0,LtcNetwork::Mainnet)?;
+    assert!(wrong.load(1,1296688902).is_err());
+    assert!(wrong.save(&HeaderSequence::new(LtcNetwork::Mainnet)?).is_err());drop(wrong);
+    let cache=HeaderCache::open(&dir.0,LtcNetwork::Regtest)?;let path=dir.0.join(NAME);
+    fs::set_permissions(&path,fs::Permissions::from_mode(0o644))?;
+    assert!(cache.load(1,1296688902).is_err());fs::set_permissions(&path,fs::Permissions::from_mode(0o600))?;
+    fs::hard_link(&path,dir.0.join("linked"))?;assert!(cache.load(1,1296688902).is_err());
+    fs::remove_file(dir.0.join("linked"))?;
+    fs::rename(&path,dir.0.join("real"))?;symlink("real",&path)?;
+    assert!(cache.load(1,1296688902).is_err());assert!(cache.save(&chain()?).is_err());
+    fs::remove_file(&path)?;fs::create_dir(&path)?;assert!(cache.load(1,1296688902).is_err());
+    drop(cache);fs::set_permissions(&dir.0,fs::Permissions::from_mode(0o755))?;
+    assert!(HeaderCache::open(&dir.0,LtcNetwork::Regtest).is_err());
+    Ok(())
+}
