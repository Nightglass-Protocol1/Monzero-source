@@ -0,0 +1,125 @@
+//! Synthetic vectors computed independently with Python hashlib, not a mined
+//! Litecoin block. Matching them explicitly makes no chain-validity claim.
+use super::*;
+use serde_json::{Value, json};
+
+fn bytes(hex: &str) -> Vec<u8> {
+    (0..hex.len()).step_by(2).map(|i|u8::from_str_radix(&hex[i..i+2],16).unwrap()).collect()
+}
+fn fixture() -> (InclusionRequest, Vec<u8>, Vec<u8>, Value) {
+    let request = InclusionRequest { id: 7, height: 123,
+        block_hash: "fb6f54079ea63c4c7cf866ea10086c9bf31b34b681fcdf261f7b8e77f53e8260".parse().unwrap(),
+        txid: "c7446fb712e90d850729417cc8004058d45d479dd3b12a571d7d00fb3c04cf36".parse().unwrap() };
+    let response = json!({"jsonrpc":"2.0","id":7,"result":{
+        "block_height":123,"pos":1,"merkle":["1f1e1d1c1b1a191817161514131211100f0e0d0c0b0a09080706050403020100","3f3e3d3c3b3a393837363534333231302f2e2d2c2b2a29282726252423222120"]}});
+    (request, bytes("020000003333333333333333333333333333333333333333333333333333333333333333a3c12fc762f95f226e93318d8d50326b90a0cc97ab8ab3fd9112d3803d3fa66400f15365f0ff0f1e01000000"), bytes("020000000122222222222222222222222222222222222222222222222222222222222222220000000000feffffff01a086010000000000160014111111111111111111111111111111111111111100000000"), response)
+}
+fn check(request: &InclusionRequest, header: &[u8], raw: &[u8], response: &Value) -> Result<MerkleMatch> {
+    match_merkle_proof(request, header, raw, &serde_json::to_vec(response)?)
+}
+#[test]
+fn light_proof_matches_independent_vector_and_script_hash() -> Result<()> {
+    let (request, header, raw, response) = fixture();
+    let matched = check(&request, &header, &raw, &response)?;
+    assert_eq!(matched.txid(), request.txid);
+    assert_eq!(matched.block_hash(), request.block_hash);
+    assert_eq!(matched.claimed_height(), 123);
+    let tx: Transaction = deserialize(&raw)?;
+    assert_eq!(script_hash(&tx.output[0].script_pubkey), "5b977c73e66bf91562beb8b84d89a4e12130e7ab1bfe4b02f342d5deb9c7d282");
+    Ok(())
+}
+#[test]
+fn light_proof_rejects_wrong_request_header_and_transaction() {
+    let (mut request, header, raw, response) = fixture();
+    request.id += 1; assert!(check(&request, &header, &raw, &response).is_err()); request.id -= 1;
+    request.height += 1; assert!(check(&request, &header, &raw, &response).is_err()); request.height -= 1;
+    request.txid = Txid::all_zeros(); assert!(check(&request, &header, &raw, &response).is_err());
+    let (request, mut header, raw, response) = fixture();
+    header[76] ^= 1; assert!(check(&request, &header, &raw, &response).is_err()); header[76] ^= 1;
+    let mut changed = raw.clone(); changed[0] ^= 1;
+    assert!(check(&request, &header, &changed, &response).is_err());
+    let mut trailing = raw; trailing.push(0);
+    assert!(check(&request, &header, &trailing, &response).is_err());
+}
+#[test]
+fn light_proof_rejects_wrong_endianness_order_position_and_depth() {
+    let (request, header, raw, original) = fixture();
+    let mut altered = original.clone();
+    let first = altered["result"]["merkle"][0].as_str().unwrap();
+    let mut reversed = bytes(first); reversed.reverse();
+    altered["result"]["merkle"][0] = json!(reversed.iter().map(|b|format!("{b:02x}")).collect::<String>());
+    assert!(check(&request, &header, &raw, &altered).is_err());
+    for pos in [0,2,5,u32::MAX] {
+        let mut altered = original.clone(); altered["result"]["pos"] = json!(pos);
+        assert!(check(&request, &header, &raw, &altered).is_err());
+    }
+    let mut altered = original.clone(); altered["result"]["merkle"].as_array_mut().unwrap().reverse();
+    assert!(check(&request, &header, &raw, &altered).is_err());
+    for hashes in [vec![],vec!["00".repeat(32);33],vec!["gg".repeat(32)],vec!["0".repeat(63)]] {
+        let mut altered = original.clone(); altered["result"]["merkle"] = json!(hashes);
+        assert!(check(&request, &header, &raw, &altered).is_err());
+    }
+}
+#[test]
+fn light_proof_rejects_ambiguous_envelopes_and_server_errors() -> Result<()> {
+    let (request, header, raw, original) = fixture();
+    for (field,value) in [("jsonrpc",json!("1.0")),("id",json!("7")),("id",json!(7.0)),
+        ("id",json!(-1)),("error",json!({"code":-1,"message":"missing"})),
+        ("unexpected",json!(true)),("result",Value::Null)] {
+        let mut altered = original.clone(); altered[field] = value;
+        assert!(check(&request, &header, &raw, &altered).is_err());
+    }
+    for (field,value) in [("block_height",json!(-1)),("pos",json!(1.0)),("pos",json!(4294967296u64)),
+        ("confirmed",json!(true))] {
+        let mut altered = original.clone(); altered["result"][field] = value;
+        assert!(check(&request, &header, &raw, &altered).is_err());
+    }
+    let encoded = serde_json::to_string(&original)?.replacen("{", "{\"id\":7,", 1);
+    assert!(match_merkle_proof(&request, &header, &raw, encoded.as_bytes()).is_err());
+    let mut null_error = original; null_error["error"] = Value::Null;
+    check(&request, &header, &raw, &null_error)?;
+    Ok(())
+}
+#[test]
+fn light_proof_bounds_payloads_before_parsing() -> Result<()> {
+    let (request, header, raw, response) = fixture();
+    let response = serde_json::to_vec(&response)?;
+    for header in [vec![],vec![0;79],vec![0;81]] {
+        assert!(match_merkle_proof(&request,&header,&raw,&response).is_err());
+    }
+    for raw in [vec![],vec![0;MAX_TRANSACTION+1]] {
+        assert!(match_merkle_proof(&request,&header,&raw,&response).is_err());
+    }
+    for response in [vec![],vec![b' ';MAX_RESPONSE+1]] {
+        assert!(match_merkle_proof(&request,&header,&raw,&response).is_err());
+    }
+    Ok(())
+}
+#[test]
+fn light_proof_handles_single_leaf_but_rejects_64_byte_leaf() -> Result<()> {
+    let (mut request, header, raw, _) = fixture();
+    let mut header: Header = deserialize(&header)?;
+    header.merkle_root = bitcoin::TxMerkleNode::from_byte_array(request.txid.to_byte_array());
+    request.block_hash = header.block_hash();
+    let response = json!({"jsonrpc":"2.0","id":7,"result":{"block_height":123,"pos":0,"merkle":[]}});
+    check(&request, &serialize(&header), &raw, &response)?;
+    let mut tx: Transaction = deserialize(&raw)?;
+    tx.output[0].script_pubkey = bitcoin::ScriptBuf::from_bytes(vec![0;4]);
+    assert_eq!(tx.base_size(),64);
+    request.txid = tx.compute_txid();
+    header.merkle_root = bitcoin::TxMerkleNode::from_byte_array(request.txid.to_byte_array());
+    request.block_hash = header.block_hash();
+    assert!(check(&request,&serialize(&header),&serialize(&tx),&response).is_err());
+    Ok(())
+}
+#[test]
+fn light_proof_does_not_claim_to_authenticate_witness() -> Result<()> {
+    let (request, header, raw, response) = fixture();
+    let mut tx: Transaction = deserialize(&raw)?;
+    tx.input[0].witness.push([1,2,3]);
+    assert_eq!(tx.compute_txid(),request.txid);
+    check(&request,&header,&serialize(&tx),&response)?;
+    tx.input[0].witness.clear(); tx.input[0].witness.push([9]);
+    check(&request,&header,&serialize(&tx),&response)?;
+    Ok(())
+}
