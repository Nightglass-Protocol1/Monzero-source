+//! Offline building blocks for a future Litecoin light-wallet backend.
+//!
+//! Electrum data is untrusted. A matching Merkle branch establishes only that
+//! a transaction ID is committed by the supplied header. It does NOT validate
+//! Litecoin Scrypt work, difficulty, chain selection, header height, witness,
+//! confirmations, current unspentness, or transaction consensus validity.
+//! Nothing here creates `litecoin_rpc::VerifiedLiveLock` or grants signing.
+//!
+//! Wire format: ElectrumX protocol 1.4 `blockchain.transaction.get_merkle`.
+//! https://electrumx.readthedocs.io/en/latest/protocol-methods.html
+use anyhow::{Context, Result, ensure};
+use bitcoin::{BlockHash, Script, Transaction, Txid, block::Header,
+    consensus::{deserialize, serialize}, hashes::{Hash, sha256, sha256d}};
+use serde::Deserialize;
+
+const MAX_RESPONSE: usize = 16_384;
+const MAX_TRANSACTION: usize = 1_000_000;
+const MAX_BRANCH: usize = 32;
+
+/// Caller-selected identity, never learned from the same proof response.
+/// The caller must independently establish the header's network, height and
+/// active-chain membership before using this match in any chain observation.
+pub struct InclusionRequest {
+    pub id: u64,
+    pub height: u32,
+    pub block_hash: BlockHash,
+    pub txid: Txid,
+}
+
+/// Deliberately not Serialize/Deserialize and not a spendability capability.
+/// Does not authenticate witness data or establish a confirmation count.
+pub struct MerkleMatch {
+    txid: Txid,
+    block_hash: BlockHash,
+    claimed_height: u32,
+}
+impl MerkleMatch {
+    pub fn txid(&self) -> Txid { self.txid }
+    pub fn block_hash(&self) -> BlockHash { self.block_hash }
+    pub fn claimed_height(&self) -> u32 { self.claimed_height }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    jsonrpc: String,
+    id: u64,
+    result: Branch,
+    error: Option<serde_json::Value>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Branch {
+    block_height: u32,
+    pos: u32,
+    merkle: Vec<String>,
+}
+
+/// Electrum uses reversed SHA256(scriptPubKey), not an address hash.
+pub fn script_hash(script: &Script) -> String {
+    let mut digest = sha256::Hash::hash(script.as_bytes()).to_byte_array();
+    digest.reverse();
+    digest.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// Match exact requested non-witness transaction identity and header identity.
+/// All payloads are bounded before deserialization. The supplied block hash is
+/// SHA256d header identity, NOT Litecoin's Scrypt proof-of-work hash.
+pub fn match_merkle_proof(request: &InclusionRequest, header_bytes: &[u8],
+    transaction_bytes: &[u8], response: &[u8]) -> Result<MerkleMatch> {
+    ensure!(header_bytes.len() == 80, "invalid Litecoin header length");
+    ensure!(!transaction_bytes.is_empty() && transaction_bytes.len() <= MAX_TRANSACTION,
+        "invalid Litecoin transaction size");
+    ensure!(!response.is_empty() && response.len() <= MAX_RESPONSE,
+        "invalid Electrum proof response size");
+    let header: Header = deserialize(header_bytes).context("invalid Litecoin header")?;
+    ensure!(header.block_hash() == request.block_hash, "Litecoin proof header changed");
+    let transaction: Transaction = deserialize(transaction_bytes).context("unsupported or invalid Litecoin transaction")?;
+    ensure!(serialize(&transaction) == transaction_bytes && transaction.compute_txid() == request.txid,
+        "Litecoin proof transaction changed");
+    // A 64-byte non-witness transaction can be confused with a Merkle internal
+    // node. Reject it even if a server supplies an otherwise matching branch.
+    ensure!(transaction.base_size() != 64, "ambiguous 64-byte Merkle leaf");
+    let envelope: Envelope = serde_json::from_slice(response).context("invalid Electrum proof response")?;
+    ensure!(envelope.jsonrpc == "2.0" && envelope.id == request.id && envelope.error.is_none(),
+        "Electrum proof request mismatch or error");
+    let proof = envelope.result;
+    ensure!(proof.block_height == request.height && proof.merkle.len() <= MAX_BRANCH,
+        "Electrum proof height or depth mismatch");
+    let mut position = u64::from(proof.pos);
+    let mut current = request.txid.to_byte_array();
+    for sibling in proof.merkle {
+        ensure!(sibling.len() == 64 && sibling.bytes().all(|b| b.is_ascii_hexdigit()),
+            "invalid Electrum Merkle hash");
+        let sibling: Txid = sibling.parse().context("invalid Electrum Merkle hash")?;
+        let sibling = sibling.to_byte_array();
+        let mut pair = [0; 64];
+        let (left, right) = if position & 1 == 0 { (current, sibling) } else { (sibling, current) };
+        pair[..32].copy_from_slice(&left);
+        pair[32..].copy_from_slice(&right);
+        current = sha256d::Hash::hash(&pair).to_byte_array();
+        position >>= 1;
+    }
+    ensure!(position == 0 && current == header.merkle_root.to_byte_array(),
+        "Electrum Merkle root or position mismatch");
+    Ok(MerkleMatch { txid: request.txid, block_hash: request.block_hash,
+        claimed_height: proof.block_height })
+}
