+        assert!(execution.observe_light_bch_native_payout(&native,observer,block,2043,wallet.payout_session(&native)?).await.is_err());
+        {let mut state=wallet.state.lock().unwrap();state.relay_intent=Some(intent.clone());state.lose_relay=lost;}
+        let relays=wallet.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="relay_tx").count();
+        assert!(execution.relay_light_bch_native_payout(&native,observer,block,&[0;32],2044,wallet.payout_session(&native)?).await.is_err());
+        assert!(!intent.exists());
+        // Source and clock errors must fail before either native wallet or daemon RPC.
+        let calls=wallet.state.lock().unwrap().calls.len();let observations=fixture.calls.lock().unwrap().len();
+        let port=u16::try_from(observer.deployment_context()?["port"].as_u64().context("missing fixture port")?)?;
+        let changed=crate::bch_rpc::observer::OwnedBchObserver::new(if port==65535 {port-1}else{port+1},
+            "user".into(),"pass".into(),observer.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+        let node=crate::bch_rpc::BchRpc::new(port,"user".into(),"pass".into(),observer.network(),"test".into(),
+            "bchreg:qanchor".into(),bitcoin::ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+        assert!(execution.review_light_bch_native_payout_relay(&changed,2044).is_err());
+        assert!(execution.light_bch_native_payout_relay_state(&changed,2044).is_err());
