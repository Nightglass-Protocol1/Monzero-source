+mod relay;
+fn copy_store(path:&std::path::Path)->Result<PrivateStore> {
+    let target=PrivateStore::new()?;
+    for entry in std::fs::read_dir(path)? {
+        let entry=entry?;if entry.file_type()?.is_file() {std::fs::copy(entry.path(),target.0.join(entry.file_name()))?;}
+    }
+    Ok(target)
+}
+pub(super) async fn exercise(metadata:&std::path::Path,snapshots:&std::path::Path,setup:&Setup,
+    bch:&super::super::super::super::light_observer::Fixture,redemption:Txid,wallet:&WalletFixture,address:&XmzAddress)->Result<()> {
+    let amount=|field:&str|->Result<XmzAmount>{Ok(XmzAmount::from_atoms(setup.quote.terms()[field].parse()?))};
+    let fixture=NativeFixture::new(setup.quote.xmz_payout().clone(),address.clone(),setup.policy.xmz_genesis.clone(),amount("xmzAtoms")?.atoms(),900).await?;
+    fixture.incoming.store(true,Ordering::SeqCst);fixture.confirmed.store(true,Ordering::SeqCst);
+    let native=fixture.funding_client()?;let observer=&bch.observer;
+    let request=ExactNetRequest {source:FullProceedsRequest {wallet:address.clone(),destination:setup.quote.xmz_payout().clone(),
+        lock_txid:"ab".repeat(32),locked:amount("xmzAtoms")?,maximum_fee:amount("xmzClaimFeeMaxAtoms")?,account:0,priority:1},
+        principal:amount("xmzPayoutAtoms")?,reserve_return:setup.quote.xmz_refund().clone()};
+    let block=Some(BlockHash::from_byte_array([6;32]));
+    for lost in [true,false] {
+        let copied=copy_store(metadata)?;let private=copy_store(snapshots)?;
+        let slot=|part:&str|format!("{}.bch-native-payout-{part}",setup.quote.terms()["swapId"]);
+        let intent=copied.0.join(slot("intent"));let pin=copied.0.join(slot("pin"));let saved=private.0.join(slot("prepared"));
+        {let mut state=wallet.state.lock().unwrap();state.payout=Some(Payout {request:request.clone(),intent:intent.clone(),fee:900});state.lose_payout=lost;}
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let mut session=wallet.payout_session(&native)?;
+        let transfers=wallet.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="transfer").count();
+        assert!(execution.prepare_light_bch_native_payout(&native,observer,redemption,block,2040,&mut session,0).await.is_err());
+        assert!(!intent.exists());
+        let prepared=execution.prepare_light_bch_native_payout(&native,observer,redemption,block,2040,&mut session,1).await;
+        assert!(intent.exists());
+        assert_eq!(wallet.state.lock().unwrap().calls.iter().filter(|m|m.as_str()=="transfer").count(),transfers+1);
+        let expected=if lost {assert!(prepared.is_err());assert!(!pin.exists() && !saved.exists());None}else{
+            let terms=prepared?;assert_eq!(terms["payoutAtoms"],"100000");assert_eq!(terms["reserveReturnAtoms"],"100");assert_eq!(terms["feeAtoms"],"900");
+            assert_eq!(terms["destination"],setup.quote.xmz_payout().to_string());assert_eq!(terms["reserveReturn"],setup.quote.xmz_refund().to_string());
+            for secret in ["tx_metadata","tx_key","spendKey","viewKey"] {assert!(terms.get(secret).is_none());}
+            Some(terms)
+        };
+        drop(execution);
+        let mut execution=AdmittedExecution::resume(&copied.0,&private.0,&setup.quote,&setup.policy,Role::BchFunder)?;
+        let calls=wallet.state.lock().unwrap().calls.len();let observations=fixture.calls.lock().unwrap().len();
+        let restored=execution.prepare_light_bch_native_payout(&native,observer,redemption,block,2041,&mut wallet.payout_session(&native)?,1).await;
+        if let Some(expected)=expected {
+            assert_eq!(restored?,expected);assert_eq!(execution.recover_prepared_bch_native_payout()?,expected);
+            let review=execution.review_light_bch_native_payout_relay(observer,2041)?;
+            assert_eq!(review.details["fundingSource"],"local-wallet");assert_eq!(review.details["payout"],expected);
+            assert_eq!(review.details["schema"],"monzero-bch-light-native-payout-relay-review-v1");
+            assert_eq!(execution.review_light_bch_native_payout_relay(observer,2042)?.commitment,review.commitment);
+            assert!(execution.prepare_light_bch_native_payout(&native,observer,redemption,block,2041,&mut wallet.payout_session(&native)?,2).await.is_err());
+        } else {
+            assert!(restored.is_err());assert!(execution.recover_prepared_bch_native_payout().is_err());
+            assert!(execution.review_light_bch_native_payout_relay(observer,2041).is_err());
+        }
+        assert_eq!(wallet.state.lock().unwrap().calls.len(),calls);
+        assert_eq!(fixture.calls.lock().unwrap().len(),observations);
+        assert!(!wallet.state.lock().unwrap().calls.iter().any(|m|m=="relay_tx"));
+        if !lost {relay::exercise(&copied.0,&private.0,setup,bch,wallet,&fixture).await?;}
+    }
+    Ok(())
+}
