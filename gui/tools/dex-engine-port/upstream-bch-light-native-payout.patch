+        if lost {assert!(retry.is_err());}else{assert_eq!(retry?,"dd".repeat(32));}
+        assert_eq!(wallet.state.lock().unwrap().calls.len(),calls);assert_eq!(fixture.calls.lock().unwrap().len(),observations);
+        let public=hashes(&copied.0)?;let secrets=hashes(&private.0)?;
+        wallet.state.lock().unwrap().payout_confirmations=10;
+        let observed=execution.observe_light_bch_native_payout(&native,observer,block,late,wallet.payout_session(&native)?).await?;
+        assert_eq!(observed.txid(),"dd".repeat(32));assert_eq!(observed.confirmations(),10);assert_eq!(observed.review(),&review.commitment);
+        assert_eq!(observed.bch_confirmation().deployment(),&observer.deployment_commitment()?);
+        assert_eq!(execution.light_bch_native_payout_relay_state(observer,2046)?,Some(expected));
+        assert_eq!(hashes(&copied.0)?,public);assert_eq!(hashes(&private.0)?,secrets);
+        let methods=wallet.state.lock().unwrap().calls[calls..].to_vec();
+        assert!(methods.iter().all(|m|matches!(m.as_str(),"get_address"|"query_key"|"check_tx_key")));
+    }
+    Ok(())
+}
