@@ -0,0 +1,69 @@
+use super::*;
+use bitcoin::{OutPoint,BlockHash};
+
+pub(in crate::bch_key_recovery::authenticated::native_wallet::tests)
+async fn exercise(execution:&AdmittedExecution<'_>,setup:&Setup,fixture:&super::super::light_observer::Fixture,
+    release:&SignedSuccess,funding:&Transaction,metadata:&std::path::Path)->Result<()> {
+    // Use the native funder's actual fixture share to decrypt the released
+    // adaptor and construct the covenant redemption, not an invented spend.
+    let frame:serde_json::Value=serde_json::from_slice(release.frame())?;
+    let encrypted=serde_json::from_value(frame["encrypted"].clone())?;
+    let mut bytes=Zeroizing::new(setup.spend[1].as_bytes());bytes.reverse();
+    let decrypt=ecdsa_fun::fun::Scalar::from_bytes(*bytes).context("invalid native fixture share")?
+        .non_zero().context("zero fixture share")?;
+    let plan=setup.quote.recovery_plan();
+    let signer=ecdsa_fun::fun::Point::from_bytes(plan.lock().terms().signing_key.serialize()).context("invalid fixture signer")?;
+    let signature=Zeroizing::new(plan.lock().data_message().decrypt(&signer,&decrypt,encrypted)?);
+    let outpoint=OutPoint {txid:funding.compute_txid(),vout:0};
+    let transaction=plan.lock().prepare_redemption(&serialize(funding),&plan.lock_spend_terms(outpoint),&signature)?;
+    let id=transaction.compute_txid();let block=Some(BlockHash::from_byte_array([6;32]));
+    *fixture.redemption.lock().unwrap()=Some(transaction.clone());
+    let native=Native::new(execution,setup)?;let observer=&fixture.observer;
+    assert!(execution.recover_light_bch_native_claim(&native,observer,id,block,2009).await.err()
+        .context("early claim must fail")?.to_string().contains("predates success preparation"));
+    let port=u16::try_from(observer.deployment_context()?["port"].as_u64().context("missing fixture port")?)?;
+    let changed=crate::bch_rpc::observer::OwnedBchObserver::new(if port==65535 {port-1}else{port+1},
+        "user".into(),"pass".into(),observer.network(),"/Bitcoin Cash Node:29.0.0/".into())?;
+    assert!(execution.recover_light_bch_native_claim(&native,&changed,id,block,2021).await.err()
+        .context("changed observer must fail")?.to_string().contains("binding changed"));
+    let node=crate::bch_rpc::BchRpc::new(port,"user".into(),"pass".into(),observer.network(),"test".into(),
+        "bchreg:qanchor".into(),bitcoin::ScriptBuf::from_bytes(vec![0x51]),"/Bitcoin Cash Node:29.0.0/".into())?;
+    assert!(execution.recover_bch_native_claim(&native,&node,id,block,2021).await.err()
+        .context("node claim must reject local source")?.to_string().contains("local funding observer"));
+    let trade=&setup.quote.terms()["swapId"];
+    for (name,error) in [
+        (format!("{trade}.bch-funding-local-observer"),"approve and retain"),
+        (format!("{trade}.bch-success-prepared-pin"),"lacks trusted pin"),
+    ] {
+        let path=metadata.join(name);let held=metadata.join("held-claim-test-record");
+        std::fs::rename(&path,&held)?;
+        let result=execution.recover_light_bch_native_claim(&native,observer,id,block,2021).await;
+        std::fs::rename(&held,&path)?;
+        assert!(result.err().context("missing claim record must fail")?.to_string().contains(error));
+    }
+    assert_eq!(native.snapshots.load(Ordering::SeqCst),0);
+    let claim=execution.recover_light_bch_native_claim(&native,observer,id,block,2021).await?;
+    ensure!(claim.spend_key()==&(setup.spend[0]+setup.spend[1]).as_bytes(),"recovered native spend key differs");
+    ensure!(claim.view_key()==&(setup.view[0].0+setup.view[1].0).as_bytes(),"recovered native view key differs");
+    assert_eq!(claim.native_txid(),"ab".repeat(32));assert_eq!(claim.redemption_txid(),id);
+    assert_eq!(claim.address(),execution.restore_agreement()?.owned().wallet().address());
+    for mode in [1,2,3] {
+        native.mode(mode);
+        assert!(execution.recover_light_bch_native_claim(&native,observer,id,block,2021).await.is_err(),"unsafe native mode {mode}");
+    }
+    native.mode(0);
+    for mode in [1,2,3] {
+        fixture.redemption_mode.store(mode,Ordering::SeqCst);
+        assert!(execution.recover_light_bch_native_claim(&native,observer,id,block,2021).await.is_err(),"unsafe redemption mode {mode}");
+    }
+    fixture.redemption_mode.store(0,Ordering::SeqCst);
+    // A confirmed transaction must still redeem this exact covenant/outpoint.
+    let mut wrong=transaction.clone();wrong.input[0].previous_output.vout=1;
+    let wrong_id=wrong.compute_txid();*fixture.redemption.lock().unwrap()=Some(wrong);
+    assert!(execution.recover_light_bch_native_claim(&native,observer,wrong_id,block,2021).await.is_err());
+    *fixture.redemption.lock().unwrap()=Some(transaction);
+    let indexed=execution.recover_light_bch_native_claim(&native,observer,id,None,2022).await?;
+    ensure!(indexed.spend_key()==claim.spend_key() && indexed.view_key()==claim.view_key(),"indexed native claim differs");
+    assert_eq!(indexed.commitment(),claim.commitment());
+    Ok(())
+}
