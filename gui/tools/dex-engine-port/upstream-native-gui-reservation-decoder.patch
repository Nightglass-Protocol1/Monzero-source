+    #[test]
+    fn gui_reservation_decoder_rechecks_signed_terms_and_freshness() -> Result<()> {
+        let terms = fixture();
+        let payload = serde_json::to_vec(&terms)?;
+        let btc = SigningKey::from_bytes(&[1; 32]);
+        let xmz = SigningKey::from_bytes(&[2; 32]);
+        let sign = |key: &SigningKey, role: &str| {
+            let domain = format!("monzero-native-btc-xmz-quote-v1-{role}");
+            let mut message = format!("MONZERO-DEX-OFFER-V1\n{}:{}{}:", domain.len(), domain, payload.len()).into_bytes();
+            message.extend_from_slice(&payload);
+            key.sign(&message).to_bytes().iter().map(|b| format!("{b:02x}")).collect::<String>()
+        };
+        let record = serde_json::json!({"schema":"monzero-native-quote-reservation-v1",
+            "acceptedAt":"1000", "terms":terms,
+            "btcSignature":sign(&btc,"btc-funder"), "xmzSignature":sign(&xmz,"xmz-funder")});
+        let b = btc.verifying_key().to_bytes();
+        let x = xmz.verifying_key().to_bytes();
+        let decode = |value: &serde_json::Value, now| VerifiedQuote::from_gui_reservation(
+            &serde_json::to_vec(value).unwrap(), now, &b, &x, Network::Regtest, XmzNetwork::Mainnet);
+        let decoded = decode(&record, 1001)?;
+        assert_eq!(decoded.commitment(), verify(&fixture(), 1000)?.commitment());
+        assert!(decode(&record, 999).is_err());
+        assert!(decode(&record, 1100).is_err());
+        for timestamp in ["01000", "-1", "1002", "9223372036854775808"] {
+            let mut changed = record.clone(); changed["acceptedAt"] = timestamp.into();
+            assert!(decode(&changed, 1001).is_err());
+        }
+        let mut altered = record.clone(); altered["terms"]["xmzAtoms"] = "1".into();
+        assert!(decode(&altered, 1001).is_err());
+        altered = record.clone(); altered["btcSignature"] = record["xmzSignature"].clone();
+        assert!(decode(&altered, 1001).is_err());
+        altered = record.clone(); altered["extra"] = true.into();
+        assert!(decode(&altered, 1001).is_err());
+        let bytes = serde_json::to_vec(&record)?;
+        assert!(VerifiedQuote::from_gui_reservation(&bytes, 1001, &x, &b,
+            Network::Regtest, XmzNetwork::Mainnet).is_err());
