 impl VerifiedQuote {
+    /// Decode the GUI reservation schema. Bytes alone do not prove a durable
+    /// reservation or user approval: the driver must validate trusted storage,
+    /// expected quote/swap identity and its single-use ownership separately.
+    /// This fresh-quote entry point must not be used to gate historical recovery.
+    pub fn from_gui_reservation(
+        bytes: &[u8], now: u64, btc_key: &[u8; 32], xmz_key: &[u8; 32],
+        btc_network: Network, xmz_network: XmzNetwork,
+    ) -> Result<Self> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields, rename_all = "camelCase")]
+        struct Record {
+            schema: String, accepted_at: String, terms: serde_json::Value,
+            btc_signature: String, xmz_signature: String,
+        }
+        ensure!(!bytes.is_empty() && bytes.len() <= 16384, "invalid reservation record size");
+        let value: serde_json::Value = serde_json::from_slice(bytes)?;
+        ensure!(serde_json::to_vec(&value)? == bytes, "noncanonical reservation record");
+        let record: Record = serde_json::from_value(value)?;
+        ensure!(record.schema == "monzero-native-quote-reservation-v1", "wrong reservation schema");
+        let accepted_at: u64 = record.accepted_at.parse()?;
+        ensure!(accepted_at <= i64::MAX as u64 && accepted_at <= now
+            && accepted_at.to_string() == record.accepted_at, "invalid reservation timestamp");
+        let signature = |text: &str| -> Result<[u8; 64]> {
+            ensure!(text.len() == 128 && text.bytes().all(|b| b.is_ascii_digit()
+                || (b'a'..=b'f').contains(&b)), "invalid reservation signature encoding");
+            let mut result = [0; 64];
+            for (i, byte) in result.iter_mut().enumerate() {
+                *byte = u8::from_str_radix(&text[i * 2..i * 2 + 2], 16)?;
+            }
+            Ok(result)
+        };
+        let payload = serde_json::to_vec(&record.terms)?;
+        let quote = Self::verify(&payload, accepted_at, btc_key, xmz_key,
+            &signature(&record.btc_signature)?, &signature(&record.xmz_signature)?,
+            btc_network, xmz_network)?;
+        let expiry: u64 = quote.terms["expiresAt"].parse()?;
+        ensure!(expiry > now && expiry - now <= 3600, "reservation quote is no longer fresh");
+        Ok(quote)
+    }
